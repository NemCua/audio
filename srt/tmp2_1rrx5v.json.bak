    "start": "00:05:53,586",
    "end": "00:05:55,006",
    "start_sec": 353.586,
    "end_sec": 355.006,
    "zh": "罐头喷出白色光柱",
    "vi": "Hộp sữa phun ra một cột sáng màu trắng."
  },
  {
    "idx": 257,
    "start": "00:05:55,006",
    "end": "00:05:56,526",
    "start_sec": 355.006,
    "end_sec": 356.526,
    "zh": "高能蛋白喷射剂",
    "vi": "Chất phun protein năng lượng cao."
  },
  {
    "idx": 258,
    "start": "00:05:56,526",
    "end": "00:05:58,706",
    "start_sec": 356.526,
    "end_sec": 358.706,
    "zh": "蕴含高浓度能量和蛋白质",
    "vi": "Chứa năng lượng và protein nồng độ cao."
  },
  {
    "idx": 259,
    "start": "00:05:58,706",
    "end": "00:06:01,366",
    "start_sec": 358.706,
    "end_sec": 361.366,
    "zh": "具有极强的冲击力和黏着性",
    "vi": "Có lực va đập và độ bám dính cực mạnh."
  },
  {
    "idx": 260,
    "start": "00:06:01,366",
    "end": "00:06:03,006",
    "start_sec": 361.366,
    "end_sec": 363.006,
    "zh": "接着狗圣将奶粉罐扔给我",
    "vi": "Sau đó Cẩu Thánh ném hộp sữa bột cho tôi."
  },
  {
    "idx": 261,
    "start": "00:06:03,006",
    "end": "00:06:04,246",
    "start_sec": 363.006,
    "end_sec": 364.246,
    "zh": "我接触的瞬间",
    "vi": "Ngay khoảnh khắc tôi chạm vào nó."
  },
  {
    "idx": 262,
    "start": "00:06:04,246",
    "end": "00:06:06,566",
    "start_sec": 364.246,
    "end_sec": 366.566,
    "zh": "一股强大的能量从罐体传来",
    "vi": "Một luồng năng lượng mạnh mẽ truyền ra từ thân hộp."
  },
  {
    "idx": 263,
    "start": "00:06:06,566",
    "end": "00:06:07,446",
    "start_sec": 366.566,
    "end_sec": 367.446,
    "zh": "对准它们",
    "vi": "Nhắm thẳng vào chúng."
  },
  {
    "idx": 264,
    "start": "00:06:07,446",
    "end": "00:06:08,306",
    "start_sec": 367.446,
    "end_sec": 368.306,
    "zh": "按盖子",
    "vi": "Ấn nắp hộp đi."
  },
  {
    "idx": 265,
    "start": "00:06:08,306",
    "end": "00:06:09,186",
    "start_sec": 368.306,
    "end_sec": 369.186,
    "zh": "我立刻照做",
    "vi": "Tôi lập tức làm theo."
  },
  {
    "idx": 266,
    "start": "00:06:09,186",
    "end": "00:06:12,306",
    "start_sec": 369.186,
    "end_sec": 372.306,
    "zh": "一道在奶上的浓稠白色液体高压喷出",
    "vi": "Một dòng chất lỏng màu trắng đặc quánh phun ra dưới áp suất cao."
  },
  {
    "idx": 267,
    "start": "00:06:12,306",
    "end": "00:06:13,906",
    "start_sec": 372.306,
    "end_sec": 373.906,
    "zh": "最前面的活石被喷得正常",
    "vi": "Con thây ma đi đầu tiên bị phun trúng trực diện."
  },
  {
    "idx": 268,
    "start": "00:06:13,906",
    "end": "00:06:15,406",
    "start_sec": 373.906,
    "end_sec": 375.406,
    "zh": "那狐狸党实际把他昏飞",
    "vi": "Lực đẩy đó trực tiếp thổi bay nó."
  },
  {
    "idx": 269,
    "start": "00:06:15,406",
    "end": "00:06:17,046",
    "start_sec": 375.406,
    "end_sec": 377.046,
    "zh": "放在后面的同伴身上",
    "vi": "Đè lên những đồng bọn ở phía sau."
  },
  {
    "idx": 270,
    "start": "00:06:17,046",
    "end": "00:06:18,466",
    "start_sec": 377.046,
    "end_sec": 378.466,
    "zh": "那白色液体粘性极强",
    "vi": "Chất lỏng màu trắng đó có độ bám dính cực mạnh."
  },
  {
    "idx": 271,
    "start": "00:06:18,466",
    "end": "00:06:20,086",
    "start_sec": 378.466,
    "end_sec": 380.086,
    "zh": "一下将两只活石糊在一起",
    "vi": "Chất lỏng đó dính chặt hai con zombie lại với nhau."
  },
  {
    "idx": 272,
    "start": "00:06:20,086",
    "end": "00:06:21,966",
    "start_sec": 380.086,
    "end_sec": 381.966,
    "zh": "他们拼命挣扎却分不开",
    "vi": "Chúng giãy giụa điên cuồng nhưng không thể tách ra."
  },
  {
    "idx": 273,
    "start": "00:06:21,966",
    "end": "00:06:22,566",
    "start_sec": 381.966,
    "end_sec": 382.566,
    "zh": "漂亮",
    "vi": "Tuyệt vời."
  },
  {
    "idx": 274,
    "start": "00:06:22,566",
    "end": "00:06:24,006",
    "start_sec": 382.566,
    "end_sec": 384.006,
    "zh": "这玩意儿比枪还好用",
    "vi": "Thứ này còn hiệu quả hơn cả súng."
  },
  {
    "idx": 275,
    "start": "00:06:24,006",
    "end": "00:06:25,026",
    "start_sec": 384.006,
    "end_sec": 385.026,
    "zh": "我用同样的方法",
    "vi": "Tôi dùng cách tương tự"
  },
  {
    "idx": 276,
    "start": "00:06:25,026",
    "end": "00:06:26,506",
    "start_sec": 385.026,
    "end_sec": 386.506,
    "zh": "把剩下几只冲下来的活石",
    "vi": "để dính chặt những con zombie còn lại"
  },
  {
    "idx": 277,
    "start": "00:06:26,506",
    "end": "00:06:28,146",
    "start_sec": 386.506,
    "end_sec": 388.146,
    "zh": "全都粘在了墙上和地上",
    "vi": "lên tường và sàn nhà."
  },
  {
    "idx": 278,
    "start": "00:06:28,146",
    "end": "00:06:29,366",
    "start_sec": 388.146,
    "end_sec": 389.366,
    "zh": "整个二楼一片狼藉",
    "vi": "Cả tầng hai giờ ngổn ngang."
  },
  {
    "idx": 279,
    "start": "00:06:29,366",
    "end": "00:06:30,786",
    "start_sec": 389.366,
    "end_sec": 390.786,
    "zh": "空气里全是奶香",
    "vi": "Không khí đặc quánh mùi sữa."
  },
  {
    "idx": 280,
    "start": "00:06:30,786",
    "end": "00:06:31,646",
    "start_sec": 390.786,
    "end_sec": 391.646,
    "zh": "柳如烟看傻",
    "vi": "Liễu Như Yên chết lặng."
  },
  {
    "idx": 281,
    "start": "00:06:31,646",
    "end": "00:06:33,046",
    "start_sec": 391.646,
    "end_sec": 393.046,
    "zh": "狗圣走到他面前",
    "vi": "Cẩu Thánh đi tới trước mặt cô."
  },
  {
    "idx": 282,
    "start": "00:06:33,046",
    "end": "00:06:33,906",
    "start_sec": 393.046,
    "end_sec": 393.906,
    "zh": "低头看着他",
    "vi": "Cúi đầu nhìn cô."
  },
  {
    "idx": 283,
    "start": "00:06:33,906",
    "end": "00:06:34,486",
    "start_sec": 393.906,
    "end_sec": 394.486,
    "zh": "女人",
    "vi": "Này cô gái."
  },
  {
    "idx": 284,
    "start": "00:06:34,486",
    "end": "00:06:36,086",
    "start_sec": 394.486,
    "end_sec": 396.086,
    "zh": "你差点害死我们",
    "vi": "Cô suýt nữa đã hại chết chúng tôi."
  },
  {
    "idx": 285,
    "start": "00:06:36,086",
    "end": "00:06:37,246",
    "start_sec": 396.086,
    "end_sec": 397.246,
    "zh": "柳如烟浑身一战",
    "vi": "Liễu Như Yên run lên."
  },
  {
    "idx": 286,
    "start": "00:06:37,246",
    "end": "00:06:38,986",
    "start_sec": 397.246,
    "end_sec": 398.986,
    "zh": "回过神又要哭了",
    "vi": "Tỉnh táo lại, cô lại sắp khóc."
  },
  {
    "idx": 287,
    "start": "00:06:38,986",
    "end": "00:06:40,786",
    "start_sec": 398.986,
    "end_sec": 400.786,
    "zh": "我 我其实太害怕了",
    "vi": "Tôi... tôi thực sự rất sợ."
  },
  {
    "idx": 288,
    "start": "00:06:40,786",
    "end": "00:06:42,566",
    "start_sec": 400.786,
    "end_sec": 402.566,
    "zh": "害怕就能拖别人下水",
    "vi": "Sợ hãi có thể kéo người khác vào vũng lầy sao."
  },
  {
    "idx": 289,
    "start": "00:06:42,566",
    "end": "00:06:44,126",
    "start_sec": 402.566,
    "end_sec": 404.126,
    "zh": "我们义务带上一个围坠",
    "vi": "Chúng tôi có nghĩa vụ mang theo một người bạn đồng hành."
  },
  {
    "idx": 290,
    "start": "00:06:44,126",
    "end": "00:06:44,526",
    "start_sec": 404.126,
    "end_sec": 404.526,
    "zh": "别",
    "vi": "Đừng."
  },
  {
    "idx": 291,
    "start": "00:06:44,526",
    "end": "00:06:46,486",
    "start_sec": 404.526,
    "end_sec": 406.486,
    "zh": "柳如燕连滚带爬跟上来",
    "vi": "Liễu Như Yên bò theo sau."
  },
  {
    "idx": 292,
    "start": "00:06:46,486",
    "end": "00:06:47,826",
    "start_sec": 406.486,
    "end_sec": 407.826,
    "zh": "这次她不敢再碰我",
    "vi": "Lần này cô ta không dám chạm vào tôi nữa."
  },
  {
    "idx": 293,
    "start": "00:06:47,826",
    "end": "00:06:49,226",
    "start_sec": 407.826,
    "end_sec": 409.226,
    "zh": "只是跟在我身后哭着求",
    "vi": "Chỉ đi theo phía sau tôi, vừa khóc vừa cầu xin."
  },
  {
    "idx": 294,
    "start": "00:06:49,226",
    "end": "00:06:49,846",
    "start_sec": 409.226,
    "end_sec": 409.846,
    "zh": "李叔叔",
    "vi": "Chú Lý ơi."
  },
  {
    "idx": 295,
    "start": "00:06:49,846",
    "end": "00:06:50,626",
    "start_sec": 409.846,
    "end_sec": 410.626,
    "zh": "我错了",
    "vi": "Cháu sai rồi."
  },
  {
    "idx": 296,
    "start": "00:06:50,626",
    "end": "00:06:51,826",
    "start_sec": 410.626,
    "end_sec": 411.826,
    "zh": "我真的错了",
    "vi": "Cháu thực sự sai rồi."
  },
  {
    "idx": 297,
    "start": "00:06:51,826",
    "end": "00:06:52,846",
    "start_sec": 411.826,
    "end_sec": 412.846,
    "zh": "所以别丢下我",
    "vi": "Vậy nên đừng bỏ cháu lại."
  },
  {
    "idx": 298,
    "start": "00:06:52,846",
    "end": "00:06:53,746",
    "start_sec": 412.846,
    "end_sec": 413.746,
    "zh": "我还有用的",
    "vi": "Cháu vẫn còn hữu dụng."
  },
  {
    "idx": 299,
    "start": "00:06:53,746",
    "end": "00:06:54,926",
    "start_sec": 413.746,
    "end_sec": 414.926,
    "zh": "我会洗衣服",
    "vi": "Cháu biết giặt quần áo."
  },
  {
    "idx": 300,
    "start": "00:06:54,926",
    "end": "00:06:55,766",
    "start_sec": 414.926,
    "end_sec": 415.766,
    "zh": "会做饭",
    "vi": "Biết nấu ăn."
  },
  {
    "idx": 301,
    "start": "00:06:55,766",
    "end": "00:06:56,566",
    "start_sec": 415.766,
    "end_sec": 416.566,
    "zh": "闭嘴",
    "vi": "Im miệng đi."
  },
  {
    "idx": 302,
    "start": "00:06:56,566",
    "end": "00:06:57,926",
    "start_sec": 416.566,
    "end_sec": 417.926,
    "zh": "你会合场炸药吗",
    "vi": "Cô biết chế tạo thuốc nổ không."
  },
  {
    "idx": 303,
    "start": "00:06:57,926",
    "end": "00:06:59,666",
    "start_sec": 417.926,
    "end_sec": 419.666,
    "zh": "你会算我失了路线吗",
    "vi": "Cô biết tính toán lộ trình không."
  },
  {
    "idx": 304,
    "start": "00:06:59,666",
    "end": "00:07:01,186",
    "start_sec": 419.666,
    "end_sec": 421.186,
    "zh": "你连自己都保不住",
    "vi": "Ngay cả bản thân cô còn không bảo vệ nổi."
  },
  {
    "idx": 305,
    "start": "00:07:01,186",
    "end": "00:07:02,946",
    "start_sec": 421.186,
    "end_sec": 422.946,
    "zh": "只会尖叫和拖后腿",
    "vi": "Chỉ biết la hét và làm vướng chân vướng tay."
  },
  {
    "idx": 306,
    "start": "00:07:02,946",
    "end": "00:07:04,066",
    "start_sec": 422.946,
    "end_sec": 424.066,
    "zh": "她哭声醒了",
    "vi": "Tiếng khóc của cô ấy đã dứt."
  },
  {
    "idx": 307,
    "start": "00:07:04,066",
    "end": "00:07:04,706",
    "start_sec": 424.066,
    "end_sec": 424.706,
    "zh": "脸色煞白",
    "vi": "Gương mặt tái mét."
  },
  {
    "idx": 308,
    "start": "00:07:04,706",
    "end": "00:07:05,926",
    "start_sec": 424.706,
    "end_sec": 425.926,
    "zh": "我们走到超市门口",
    "vi": "Chúng tôi đi đến cửa siêu thị."
  },
  {
    "idx": 309,
    "start": "00:07:05,926",
    "end": "00:07:07,526",
    "start_sec": 425.926,
    "end_sec": 427.526,
    "zh": "外面的天色已经暗下来",
    "vi": "Trời bên ngoài đã bắt đầu tối."
  },
  {
    "idx": 310,
    "start": "00:07:07,526",
    "end": "00:07:09,226",
    "start_sec": 427.526,
    "end_sec": 429.226,
    "zh": "夜晚的城市比白天更危险",
    "vi": "Thành phố ban đêm còn nguy hiểm hơn ban ngày."
  },
  {
    "idx": 311,
    "start": "00:07:09,226",
    "end": "00:07:10,726",
    "start_sec": 429.226,
    "end_sec": 430.726,
    "zh": "我们得找个地方过夜",
    "vi": "Chúng ta phải tìm một nơi để qua đêm."
  },
  {
    "idx": 312,
    "start": "00:07:10,726",
    "end": "00:07:11,606",
    "start_sec": 430.726,
    "end_sec": 431.606,
    "zh": "回你家",
    "vi": "Về nhà tôi đi."
  },
  {
    "idx": 313,
    "start": "00:07:11,606",
    "end": "00:07:12,606",
    "start_sec": 431.606,
    "end_sec": 432.606,
    "zh": "那儿地质高",
    "vi": "Nơi đó địa thế cao."
  },
  {
    "idx": 314,
    "start": "00:07:12,606",
    "end": "00:07:13,146",
    "start_sec": 432.606,
    "end_sec": 433.146,
    "zh": "好手",
    "vi": "Dễ phòng thủ."
  },
  {
    "idx": 315,
    "start": "00:07:13,146",
    "end": "00:07:15,106",
    "start_sec": 433.146,
    "end_sec": 435.106,
    "zh": "而且我们经过楼道",
    "vi": "Hơn nữa chúng ta đi qua lối cầu thang."
  },
  {
    "idx": 316,
    "start": "00:07:15,106",
    "end": "00:07:16,006",
    "start_sec": 435.106,
    "end_sec": 436.006,
    "zh": "相对安全",
    "vi": "Sẽ tương đối an toàn."
  },
  {
    "idx": 317,
    "start": "00:07:16,006",
    "end": "00:07:16,686",
    "start_sec": 436.006,
    "end_sec": 436.686,
    "zh": "那我呢",
    "vi": "Còn tôi thì sao."
  },
  {
    "idx": 318,
    "start": "00:07:16,686",
    "end": "00:07:18,006",
    "start_sec": 436.686,
    "end_sec": 438.006,
    "zh": "柳如烟小声问",
    "vi": "Liễu Như Yên nhỏ giọng hỏi."
  },
  {
    "idx": 319,
    "start": "00:07:18,006",
    "end": "00:07:18,986",
    "start_sec": 438.006,
    "end_sec": 438.986,
    "zh": "我回头看她",
    "vi": "Tôi quay đầu lại nhìn cô ấy."
  },
  {
    "idx": 320,
    "start": "00:07:18,986",
    "end": "00:07:20,186",
    "start_sec": 438.986,
    "end_sec": 440.186,
    "zh": "话里没什么温度",
    "vi": "Giọng nói không chút ấm áp."
  },
  {
    "idx": 321,
    "start": "00:07:20,186",
    "end": "00:07:21,366",
    "start_sec": 440.186,
    "end_sec": 441.366,
    "zh": "你想跟就跟着",
    "vi": "Cô muốn đi theo thì cứ đi theo."
  },
  {
    "idx": 322,
    "start": "00:07:21,366",
    "end": "00:07:23,026",
    "start_sec": 441.366,
    "end_sec": 443.026,
    "zh": "但别指望我保护你",
    "vi": "Nhưng đừng mong tôi sẽ bảo vệ cô."
  },
  {
    "idx": 323,
    "start": "00:07:23,026",
    "end": "00:07:24,386",
    "start_sec": 443.026,
    "end_sec": 444.386,
    "zh": "你要是再敢拖后腿",
    "vi": "Nếu cô còn dám làm vướng chân tôi nữa."
  },
  {
    "idx": 324,
    "start": "00:07:24,386",
    "end": "00:07:26,006",
    "start_sec": 444.386,
    "end_sec": 446.006,
    "zh": "我亲手把你扔进石头",
    "vi": "Tôi sẽ tự tay ném cô vào bầy xác sống."
  },
  {
    "idx": 325,
    "start": "00:07:26,006",
    "end": "00:07:27,406",
    "start_sec": 446.006,
    "end_sec": 447.406,
    "zh": "柳如烟身体抖了一下",
    "vi": "Cơ thể Liễu Như Yên run lên một cái."
  },
  {
    "idx": 326,
    "start": "00:07:27,406",
    "end": "00:07:28,686",
    "start_sec": 447.406,
    "end_sec": 448.686,
    "zh": "但还是用力点头",
    "vi": "Nhưng vẫn gật đầu thật mạnh."
  },
  {
    "idx": 327,
    "start": "00:07:28,686",
    "end": "00:07:30,026",
    "start_sec": 448.686,
    "end_sec": 450.026,
    "zh": "我不足会的",
    "vi": "Tôi sẽ không thế đâu."
  },
  {
    "idx": 328,
    "start": "00:07:30,026",
    "end": "00:07:30,946",
    "start_sec": 450.026,
    "end_sec": 450.946,
    "zh": "回到家中",
    "vi": "Về đến nhà."
  },
  {
    "idx": 329,
    "start": "00:07:30,946",
    "end": "00:07:32,286",
    "start_sec": 450.946,
    "end_sec": 452.286,
    "zh": "我立刻反锁门",
    "vi": "Tôi lập tức khóa trái cửa lại."
  },
  {
    "idx": 330,
    "start": "00:07:32,286",
    "end": "00:07:33,966",
    "start_sec": 452.286,
    "end_sec": 453.966,
    "zh": "利用一个合成的虾骨金属门",
    "vi": "Sử dụng một cánh cửa kim loại gia cố được chế tạo."
  },
  {
    "idx": 331,
    "start": "00:07:33,966",
    "end": "00:07:35,006",
    "start_sec": 453.966,
    "end_sec": 455.006,
    "zh": "摔向门彻底无死",
    "vi": "Đóng chặt cửa phòng lại."
  },
  {
    "idx": 332,
    "start": "00:07:35,006",
    "end": "00:07:36,266",
    "start_sec": 455.006,
    "end_sec": 456.266,
    "zh": "狗圣则跳上窗台",
    "vi": "Cẩu Thánh nhảy lên bậu cửa sổ."
  },
  {
    "idx": 333,
    "start": "00:07:36,266",
    "end": "00:07:37,526",
    "start_sec": 456.266,
    "end_sec": 457.526,
    "zh": "警惕地看着外面",
    "vi": "Cảnh giác nhìn ra bên ngoài."
  },
  {
    "idx": 334,
    "start": "00:07:37,526",
    "end": "00:07:38,986",
    "start_sec": 457.526,
    "end_sec": 458.986,
    "zh": "柳如烟站在客厅中间",
    "vi": "Liễu Như Yên đứng ở giữa phòng khách."
  },
  {
    "idx": 335,
    "start": "00:07:38,986",
    "end": "00:07:40,526",
    "start_sec": 458.986,
    "end_sec": 460.526,
    "zh": "手脚不是往哪放",
    "vi": "Tay chân luống cuống không biết để đâu."
  },
  {
    "idx": 336,
    "start": "00:07:40,526",
    "end": "00:07:41,126",
    "start_sec": 460.526,
    "end_sec": 461.126,
    "zh": "我没理他",
    "vi": "Tôi không thèm để ý đến cô ta."
  },
  {
    "idx": 337,
    "start": "00:07:41,126",
    "end": "00:07:42,506",
    "start_sec": 461.126,
    "end_sec": 462.506,
    "zh": "开始点今天的收获",
    "vi": "Bắt đầu kiểm kê chiến lợi phẩm hôm nay."
  },
  {
    "idx": 338,
    "start": "00:07:42,506",
    "end": "00:07:43,946",
    "start_sec": 462.506,
    "end_sec": 463.946,
    "zh": "吃了喝的够我们充半个月",
    "vi": "Đồ ăn thức uống đủ cho chúng tôi dùng trong nửa tháng."
  },
  {
    "idx": 339,
    "start": "00:07:43,946",
    "end": "00:07:46,886",
    "start_sec": 463.946,
    "end_sec": 466.886,
    "zh": "还有十几颗丧尸金和劣质和三颗能量金和微弱",
    "vi": "Còn có mười mấy tinh thể thây ma kém chất lượng và ba tinh thể năng lượng yếu."
  },
  {
    "idx": 340,
    "start": "00:07:46,886",
    "end": "00:07:49,266",
    "start_sec": 466.886,
    "end_sec": 469.266,
    "zh": "以及那罐还剩大半的高能蛋白喷射剂",
    "vi": "Cùng với lon xịt protein năng lượng cao còn lại hơn một nửa."
  },
  {
    "idx": 341,
    "start": "00:07:49,266",
    "end": "00:07:50,666",
    "start_sec": 469.266,
    "end_sec": 470.666,
    "zh": "我拿出两个馒头",
    "vi": "Tôi lấy ra hai chiếc màn thầu."
  },
  {
    "idx": 342,
    "start": "00:07:50,666",
    "end": "00:07:52,326",
    "start_sec": 470.666,
    "end_sec": 472.326,
    "zh": "馒头下馒头等于大馒头",
    "vi": "Màn thầu cộng màn thầu bằng màn thầu siêu to."
  },
  {
    "idx": 343,
    "start": "00:07:52,326",
    "end": "00:07:54,486",
    "start_sec": 472.326,
    "end_sec": 474.486,
    "zh": "一个比我脸还大的馒头出现在手里",
    "vi": "Một chiếc màn thầu to hơn cả mặt tôi xuất hiện trên tay."
  },
  {
    "idx": 344,
    "start": "00:07:54,486",
    "end": "00:07:55,226",
    "start_sec": 474.486,
    "end_sec": 475.226,
    "zh": "脉相扑鼻",
    "vi": "Mùi thơm lúa mạch tỏa ra ngào ngạt."
  },
  {
    "idx": 345,
    "start": "00:07:55,226",
    "end": "00:07:57,366",
    "start_sec": 475.226,
    "end_sec": 477.366,
    "zh": "我又拿出一瓶矿泉水和一根火腿肠",
    "vi": "Tôi lại lấy ra một chai nước khoáng và một cây xúc xích."
  },
  {
    "idx": 346,
    "start": "00:07:57,366",
    "end": "00:07:59,666",
    "start_sec": 477.366,
    "end_sec": 479.666,
    "zh": "矿泉水加火腿肠等于肉味营养液",
    "vi": "Nước khoáng cộng xúc xích bằng dung dịch dinh dưỡng vị thịt."
  },
  {
    "idx": 347,
    "start": "00:07:59,666",
    "end": "00:08:00,806",
    "start_sec": 479.666,
    "end_sec": 480.806,
    "zh": "一瓶粉色的叶子",
    "vi": "Một chai chất lỏng màu hồng."
  },
  {
    "idx": 348,
    "start": "00:08:00,806",
    "end": "00:08:01,786",
    "start_sec": 480.806,
    "end_sec": 481.786,
    "zh": "闻起来味道还行",
    "vi": "Ngửi thử thấy mùi vị cũng được."
  },
  {
    "idx": 349,
    "start": "00:08:01,786",
    "end": "00:08:02,986",
    "start_sec": 481.786,
    "end_sec": 482.986,
    "zh": "我把大馒头掰了一半",
    "vi": "Tôi bẻ đôi chiếc màn thầu lớn."
  },
  {
    "idx": 350,
    "start": "00:08:02,986",
    "end": "00:08:04,006",
    "start_sec": 482.986,
    "end_sec": 484.006,
    "zh": "连同那些营养液",
    "vi": "Cùng với chai dung dịch dinh dưỡng đó."
  },
  {
    "idx": 351,
    "start": "00:08:04,006",
    "end": "00:08:05,046",
    "start_sec": 484.006,
    "end_sec": 485.046,
    "zh": "一起地贼狗手",
    "vi": "Đưa hết cho Cẩu Thánh."
  },
  {
    "idx": 352,
    "start": "00:08:05,046",
    "end": "00:08:05,806",
    "start_sec": 485.046,
    "end_sec": 485.806,
    "zh": "他接过去",
    "vi": "Nó đón lấy."
  },
  {
    "idx": 353,
    "start": "00:08:05,806",
    "end": "00:08:06,986",
    "start_sec": 485.806,
    "end_sec": 486.986,
    "zh": "大口吃了起来",
    "vi": "Rồi ăn ngấu nghiến."
  },
  {
    "idx": 354,
    "start": "00:08:06,986",
    "end": "00:08:08,306",
    "start_sec": 486.986,
    "end_sec": 488.306,
    "zh": "柳如烟在旁边看着",
    "vi": "Liễu Như Yên đứng bên cạnh nhìn."
  },
  {
    "idx": 355,
    "start": "00:08:08,306",
    "end": "00:08:09,106",
    "start_sec": 488.306,
    "end_sec": 489.106,
    "zh": "呼吸不争气",
    "vi": "Hơi thở dồn dập không tự chủ được."
  },
  {
    "idx": 356,
    "start": "00:08:09,106",
    "end": "00:08:09,626",
    "start_sec": 489.106,
    "end_sec": 489.626,
    "zh": "叫了一声",
    "vi": "Bụng kêu lên một tiếng."
  },
  {
    "idx": 357,
    "start": "00:08:09,626",
    "end": "00:08:10,406",
    "start_sec": 489.626,
    "end_sec": 490.406,
    "zh": "他咽得口唾沫",
    "vi": "Cô ta nuốt nước bọt."
  },
  {
    "idx": 358,
    "start": "00:08:10,406",
    "end": "00:08:11,326",
    "start_sec": 490.406,
    "end_sec": 491.326,
    "zh": "我贴了他一眼",
    "vi": "Tôi liếc nhìn cô ta một cái."
  },
  {
    "idx": 359,
    "start": "00:08:11,326",
    "end": "00:08:13,146",
    "start_sec": 491.326,
    "end_sec": 493.146,
    "zh": "从包里拿出一包压缩饼干",
    "vi": "Lấy từ trong túi ra một gói lương khô."
  },
  {
    "idx": 360,
    "start": "00:08:13,146",
    "end": "00:08:13,846",
    "start_sec": 493.146,
    "end_sec": 493.846,
    "zh": "扔在地上",
    "vi": "Ném xuống đất."
  },
  {
    "idx": 361,
    "start": "00:08:13,846",
    "end": "00:08:14,206",
    "start_sec": 493.846,
    "end_sec": 494.206,
    "zh": "你看",
    "vi": "Nhìn xem."
  },
  {
    "idx": 362,
    "start": "00:08:14,206",
    "end": "00:08:15,426",
    "start_sec": 494.206,
    "end_sec": 495.426,
    "zh": "柳如烟脸色炸红",
    "vi": "Mặt Liễu Như Yên đỏ bừng lên."
  },
  {
    "idx": 363,
    "start": "00:08:15,426",
    "end": "00:08:16,486",
    "start_sec": 495.426,
    "end_sec": 496.486,
    "zh": "看着地上的饼干",
    "vi": "Nhìn gói bánh quy trên mặt đất."
  },
  {
    "idx": 364,
    "start": "00:08:16,486",
    "end": "00:08:17,326",
    "start_sec": 496.486,
    "end_sec": 497.326,
    "zh": "全是屈辱",
    "vi": "Trong mắt đầy vẻ nhục nhã."
  },
  {
    "idx": 365,
    "start": "00:08:17,326",
    "end": "00:08:18,126",
    "start_sec": 497.326,
    "end_sec": 498.126,
    "zh": "末日前",
    "vi": "Trước ngày tận thế."
  },
  {
    "idx": 366,
    "start": "00:08:18,126",
    "end": "00:08:19,406",
    "start_sec": 498.126,
    "end_sec": 499.406,
    "zh": "他是被人捧着的笑话",
    "vi": "Cô ta là hoa khôi được người ta tâng bốc."
  },
  {
    "idx": 367,
    "start": "00:08:19,406",
    "end": "00:08:19,966",
    "start_sec": 499.406,
    "end_sec": 499.966,
    "zh": "现在",
    "vi": "Còn bây giờ."
  },
  {
    "idx": 368,
    "start": "00:08:19,966",
    "end": "00:08:21,086",
    "start_sec": 499.966,
    "end_sec": 501.086,
    "zh": "他只犹豫了三秒",
    "vi": "Cô ta chỉ do dự ba giây."
  },
  {
    "idx": 369,
    "start": "00:08:21,086",
    "end": "00:08:22,206",
    "start_sec": 501.086,
    "end_sec": 502.206,
    "zh": "就捡起地上的饼干",
    "vi": "Liền nhặt gói bánh quy dưới đất lên."
  },
  {
    "idx": 370,
    "start": "00:08:22,206",
    "end": "00:08:22,846",
    "start_sec": 502.206,
    "end_sec": 502.846,
    "zh": "狼狂苦咽",
    "vi": "Rồi ăn ngấu nghiến."
  },
  {
    "idx": 371,
    "start": "00:08:22,846",
    "end": "00:08:24,266",
    "start_sec": 502.846,
    "end_sec": 504.266,
    "zh": "我看着他的样子",
    "vi": "Tôi nhìn dáng vẻ của cô ta."
  },
  {
    "idx": 372,
    "start": "00:08:24,266",
    "end": "00:08:25,706",
    "start_sec": 504.266,
    "end_sec": 505.706,
    "zh": "末日会改变一切",
    "vi": "Tận thế sẽ thay đổi tất cả."
  },
  {
    "idx": 373,
    "start": "00:08:25,706",
    "end": "00:08:26,446",
    "start_sec": 505.706,
    "end_sec": 506.446,
    "zh": "深夜",
    "vi": "Nửa đêm."
  },
  {
    "idx": 374,
    "start": "00:08:26,446",
    "end": "00:08:28,046",
    "start_sec": 506.446,
    "end_sec": 508.046,
    "zh": "我被柳如烟的哭声吵醒",
    "vi": "Tôi bị tiếng khóc của Liễu Như Yên làm thức giấc."
  },
  {
    "idx": 375,
    "start": "00:08:28,046",
    "end": "00:08:29,406",
    "start_sec": 508.046,
    "end_sec": 509.406,
    "zh": "他全在沙发角落",
    "vi": "Cô ta co rúm ở góc ghế sofa."
  },
  {
    "idx": 376,
    "start": "00:08:29,406",
    "end": "00:08:30,766",
    "start_sec": 509.406,
    "end_sec": 510.766,
    "zh": "肩膀一抽一抽的",
    "vi": "Bờ vai run lên bần bật."
  },
  {
    "idx": 377,
    "start": "00:08:30,766",
    "end": "00:08:31,446",
    "start_sec": 510.766,
    "end_sec": 511.446,
    "zh": "在做噩梦",
    "vi": "Hình như đang gặp ác mộng."
  },
  {
    "idx": 378,
    "start": "00:08:31,446",
    "end": "00:08:32,386",
    "start_sec": 511.446,
    "end_sec": 512.386,
    "zh": "我翻了个身",
    "vi": "Tôi xoay người một cái."
  },
  {
    "idx": 379,
    "start": "00:08:32,386",
    "end": "00:08:32,946",
    "start_sec": 512.386,
    "end_sec": 512.946,
    "zh": "懒得管",
    "vi": "Không thèm quan tâm."
  },
  {
    "idx": 380,
    "start": "00:08:32,946",
    "end": "00:08:34,146",
    "start_sec": 512.946,
    "end_sec": 514.146,
    "zh": "狗圣趴在我床边",
    "vi": "Cẩu Thánh nằm bên giường tôi."
  },
  {
    "idx": 381,
    "start": "00:08:34,146",
    "end": "00:08:35,066",
    "start_sec": 514.146,
    "end_sec": 515.066,
    "zh": "耳朵动了动",
    "vi": "Tai nó khẽ động đậy."
  },
  {
    "idx": 382,
    "start": "00:08:35,066",
    "end": "00:08:36,266",
    "start_sec": 515.066,
    "end_sec": 516.266,
    "zh": "睁眼贴了沙发一眼",
    "vi": "Mở mắt liếc nhìn về phía sofa một cái."
  },
  {
    "idx": 383,
    "start": "00:08:36,266",
    "end": "00:08:37,146",
    "start_sec": 516.266,
    "end_sec": 517.146,
    "zh": "又闭上了",
    "vi": "Rồi lại nhắm mắt lại."
  },
  {
    "idx": 384,
    "start": "00:08:37,146",
    "end": "00:08:37,826",
    "start_sec": 517.146,
    "end_sec": 517.826,
    "zh": "第二天一早",
    "vi": "Sáng sớm hôm sau."
  },
  {
    "idx": 385,
    "start": "00:08:37,826",
    "end": "00:08:39,306",
    "start_sec": 517.826,
    "end_sec": 519.306,
    "zh": "我是被狗圣叫醒的",
    "vi": "Tôi bị Cẩu Thánh gọi dậy."
  },
  {
    "idx": 386,
    "start": "00:08:39,306",
    "end": "00:08:39,686",
    "start_sec": 519.306,
    "end_sec": 519.686,
    "zh": "主人",
    "vi": "Chủ nhân."
  },
  {
    "idx": 387,
    "start": "00:08:39,686",
    "end": "00:08:40,706",
    "start_sec": 519.686,
    "end_sec": 520.706,
    "zh": "有麻烦了",
    "vi": "Có rắc rối rồi."
  },
  {
    "idx": 388,
    "start": "00:08:40,706",
    "end": "00:08:41,526",
    "start_sec": 520.706,
    "end_sec": 521.526,
    "zh": "他的声音很沉",
    "vi": "Giọng của nó rất trầm."
  },
  {
    "idx": 389,
    "start": "00:08:41,526",
    "end": "00:08:42,706",
    "start_sec": 521.526,
    "end_sec": 522.706,
    "zh": "我立刻坐起身",
    "vi": "Tôi lập tức ngồi dậy."
  },
  {
    "idx": 390,
    "start": "00:08:42,706",
    "end": "00:08:43,246",
    "start_sec": 522.706,
    "end_sec": 523.246,
    "zh": "怎么了",
    "vi": "Có chuyện gì vậy."
  },
  {
    "idx": 391,
    "start": "00:08:43,246",
    "end": "00:08:44,766",
    "start_sec": 523.246,
    "end_sec": 524.766,
    "zh": "楼下来了很多人",
    "vi": "Dưới lầu có rất nhiều người kéo đến."
  },
  {
    "idx": 392,
    "start": "00:08:44,766",
    "end": "00:08:45,506",
    "start_sec": 524.766,
    "end_sec": 525.506,
    "zh": "我走到窗边",
    "vi": "Tôi đi đến bên cửa sổ."
  },
  {
    "idx": 393,
    "start": "00:08:45,506",
    "end": "00:08:47,106",
    "start_sec": 525.506,
    "end_sec": 527.106,
    "zh": "摇开窗帘一脚往下看",
    "vi": "Hé mở một góc rèm cửa nhìn xuống dưới."
  },
  {
    "idx": 394,
    "start": "00:08:47,106",
    "end": "00:08:48,906",
    "start_sec": 527.106,
    "end_sec": 528.906,
    "zh": "楼下停着三辆改装越野车",
    "vi": "Dưới lầu đang đỗ ba chiếc xe địa hình cải tiến."
  },
  {
    "idx": 395,
    "start": "00:08:48,906",
    "end": "00:08:50,346",
    "start_sec": 528.906,
    "end_sec": 530.346,
    "zh": "十几个男人拿着砍刀",
    "vi": "Hơn mười gã đàn ông cầm dao rựa."
  },
  {
    "idx": 396,
    "start": "00:08:50,346",
    "end": "00:08:51,206",
    "start_sec": 530.346,
    "end_sec": 531.206,
    "zh": "刚管在商量什么",
    "vi": "Và ống tuýp sắt đang bàn bạc gì đó."
  },
  {
    "idx": 397,
    "start": "00:08:51,206",
    "end": "00:08:52,386",
    "start_sec": 531.206,
    "end_sec": 532.386,
    "zh": "围守的是个光头",
    "vi": "Kẻ cầm đầu là một gã đầu trọc."
  },
  {
    "idx": 398,
    "start": "00:08:52,386",
    "end": "00:08:53,466",
    "start_sec": 532.386,
    "end_sec": 533.466,
    "zh": "脖子上有道刀疤",
    "vi": "Trên cổ hắn có một vết sẹo dài."
  },
  {
    "idx": 399,
    "start": "00:08:53,466",
    "end": "00:08:54,186",
    "start_sec": 533.466,
    "end_sec": 534.186,
    "zh": "看着就凶",
    "vi": "Trông rất hung tợn."
  },
  {
    "idx": 400,
    "start": "00:08:54,186",
    "end": "00:08:55,246",
    "start_sec": 534.186,
    "end_sec": 535.246,
    "zh": "冲我们来的",
    "vi": "Chúng nhắm vào chúng ta rồi."
  },
  {
    "idx": 401,
    "start": "00:08:55,246",
    "end": "00:08:56,166",
    "start_sec": 535.246,
    "end_sec": 536.166,
    "zh": "可能性有差",
    "vi": "Khả năng cao là như vậy."
  },
  {
    "idx": 402,
    "start": "00:08:56,166",
    "end": "00:08:57,426",
    "start_sec": 536.166,
    "end_sec": 537.426,
    "zh": "我们昨天在超市",
    "vi": "Hôm qua chúng ta ở siêu thị."
  },
  {
    "idx": 403,
    "start": "00:08:57,426",
    "end": "00:08:58,346",
    "start_sec": 537.426,
    "end_sec": 538.346,
    "zh": "动静太大了",
    "vi": "Gây ra tiếng động lớn quá."
  },
  {
    "idx": 404,
    "start": "00:08:58,346",
    "end": "00:08:59,526",
    "start_sec": 538.346,
    "end_sec": 539.526,
    "zh": "这伙人应该是个",
    "vi": "Bọn người này chắc là."
  },
  {
    "idx": 405,
    "start": "00:08:59,526",
    "end": "00:09:00,526",
    "start_sec": 539.526,
    "end_sec": 540.526,
    "zh": "引来的幸福者",
    "vi": "Những kẻ sống sót bị thu hút đến đây."
  },
  {
    "idx": 406,
    "start": "00:09:00,526",
    "end": "00:09:01,486",
    "start_sec": 540.526,
    "end_sec": 541.486,
    "zh": "他们看到我们",
    "vi": "Chúng nhìn thấy chúng ta."
  },
  {
    "idx": 407,
    "start": "00:09:01,486",
    "end": "00:09:02,906",
    "start_sec": 541.486,
    "end_sec": 542.906,
    "zh": "装了一堆东西回来",
    "vi": "Chở một đống đồ về."
  },
  {
    "idx": 408,
    "start": "00:09:02,906",
    "end": "00:09:04,026",
    "start_sec": 542.906,
    "end_sec": 544.026,
    "zh": "起了坏心思",
    "vi": "Nên đã nảy sinh ý đồ xấu."
  },
  {
    "idx": 409,
    "start": "00:09:04,026",
    "end": "00:09:05,566",
    "start_sec": 544.026,
    "end_sec": 545.566,
    "zh": "果然那伙人开始清理路上",
    "vi": "Quả nhiên bọn chúng bắt đầu dọn dẹp lối đi."
  },
  {
    "idx": 410,
    "start": "00:09:05,566",
    "end": "00:09:06,306",
    "start_sec": 545.566,
    "end_sec": 546.306,
    "zh": "准备上楼",
    "vi": "Chuẩn bị lên lầu."
  },
  {
    "idx": 411,
    "start": "00:09:06,306",
    "end": "00:09:07,326",
    "start_sec": 546.306,
    "end_sec": 547.326,
    "zh": "刘如燕被惊醒",
    "vi": "Lưu Như Yến bị đánh thức."
  },
  {
    "idx": 412,
    "start": "00:09:07,326",
    "end": "00:09:08,166",
    "start_sec": 547.326,
    "end_sec": 548.166,
    "zh": "跑到窗边一看",
    "vi": "Cô ấy chạy đến bên cửa sổ nhìn xuống."
  },
  {
    "idx": 413,
    "start": "00:09:08,166",
    "end": "00:09:09,266",
    "start_sec": 548.166,
    "end_sec": 549.266,
    "zh": "脸都白了",
    "vi": "Mặt cắt không còn giọt máu."
  },
  {
    "idx": 414,
    "start": "00:09:09,266",
    "end": "00:09:10,386",
    "start_sec": 549.266,
    "end_sec": 550.386,
    "zh": "是 师教官",
    "vi": "Đó là huấn luyện viên Shi."
  },
  {
    "idx": 415,
    "start": "00:09:10,386",
    "end": "00:09:11,886",
    "start_sec": 550.386,
    "end_sec": 551.886,
    "zh": "他是我们学校旁边",
    "vi": "Gã đó là chủ phòng gym."
  },
  {
    "idx": 416,
    "start": "00:09:11,886",
    "end": "00:09:12,706",
    "start_sec": 551.886,
    "end_sec": 552.706,
    "zh": "健身房的老板",
    "vi": "Ở ngay cạnh trường học của chúng tôi."
  },
  {
    "idx": 417,
    "start": "00:09:12,706",
    "end": "00:09:13,566",
    "start_sec": 552.706,
    "end_sec": 553.566,
    "zh": "末日之前",
    "vi": "Trước ngày tận thế."
  },
  {
    "idx": 418,
    "start": "00:09:13,566",
    "end": "00:09:14,846",
    "start_sec": 553.566,
    "end_sec": 554.846,
    "zh": "是因为打架经过决策",
    "vi": "Hắn từng đi tù vì tội đánh nhau."
  },
  {
    "idx": 419,
    "start": "00:09:14,846",
    "end": "00:09:16,266",
    "start_sec": 554.846,
    "end_sec": 556.266,
    "zh": "他们有多少人",
    "vi": "Bọn họ có bao nhiêu người."
  },
  {
    "idx": 420,
    "start": "00:09:16,266",
    "end": "00:09:17,766",
    "start_sec": 556.266,
    "end_sec": 557.766,
    "zh": "十三个都在了家",
    "vi": "Mười ba người đều ở dưới đó."
  },
  {
    "idx": 421,
    "start": "00:09:17,766",
    "end": "00:09:18,846",
    "start_sec": 557.766,
    "end_sec": 558.846,
    "zh": "狗生的爪子",
    "vi": "Móng vuốt của lũ chó"
  },
  {
    "idx": 422,
    "start": "00:09:18,846",
    "end": "00:09:19,846",
    "start_sec": 558.846,
    "end_sec": 559.846,
    "zh": "在村台上滑拉着",
    "vi": "đang cào sột soạt trên thềm nhà."
  },
  {
    "idx": 423,
    "start": "00:09:19,846",
    "end": "00:09:21,046",
    "start_sec": 559.846,
    "end_sec": 561.046,
    "zh": "我们有地形优势",
    "vi": "Chúng ta có lợi thế địa hình."
  },
  {
    "idx": 424,
    "start": "00:09:21,046",
    "end": "00:09:21,966",
    "start_sec": 561.046,
    "end_sec": 561.966,
    "zh": "但人少",
    "vi": "Nhưng lại ít người."
  },
  {
    "idx": 425,
    "start": "00:09:21,966",
    "end": "00:09:22,646",
    "start_sec": 561.966,
    "end_sec": 562.646,
    "zh": "你听",
    "vi": "Bạn nghe kìa."
  },
  {
    "idx": 426,
    "start": "00:09:22,646",
    "end": "00:09:23,966",
    "start_sec": 562.646,
    "end_sec": 563.966,
    "zh": "胜算不到两成",
    "vi": "Cơ hội thắng chưa tới hai phần mười."
  },
  {
    "idx": 427,
    "start": "00:09:23,966",
    "end": "00:09:24,866",
    "start_sec": 563.966,
    "end_sec": 564.866,
    "zh": "那就用脑子",
    "vi": "Vậy thì phải dùng não thôi."
  },
  {
    "idx": 428,
    "start": "00:09:24,866",
    "end": "00:09:25,746",
    "start_sec": 564.866,
    "end_sec": 565.746,
    "zh": "我扫过房间",
    "vi": "Tôi nhìn quanh căn phòng."
  },
  {
    "idx": 429,
    "start": "00:09:25,746",
    "end": "00:09:26,726",
    "start_sec": 565.746,
    "end_sec": 566.726,
    "zh": "找可以用的东西",
    "vi": "Tìm những thứ có thể dùng được."
  },
  {
    "idx": 430,
    "start": "00:09:26,726",
    "end": "00:09:27,386",
    "start_sec": 566.726,
    "end_sec": 567.386,
    "zh": "最后",
    "vi": "Cuối cùng."
  },
  {
    "idx": 431,
    "start": "00:09:27,386",
    "end": "00:09:28,566",
    "start_sec": 567.386,
    "end_sec": 568.566,
    "zh": "我的目光落在那罐",
    "vi": "Ánh mắt của tôi dừng lại ở lon"
  },
  {
    "idx": 432,
    "start": "00:09:28,566",
    "end": "00:09:29,526",
    "start_sec": 568.566,
    "end_sec": 569.526,
    "zh": "高能蛋白喷射器",
    "vi": "bình xịt protein năng lượng cao"
  },
  {
    "idx": 433,
    "start": "00:09:29,526",
    "end": "00:09:30,766",
    "start_sec": 569.526,
    "end_sec": 570.766,
    "zh": "和几颗能量金盒上",
    "vi": "và vài hộp năng lượng vàng."
  },
  {
    "idx": 434,
    "start": "00:09:30,766",
    "end": "00:09:31,906",
    "start_sec": 570.766,
    "end_sec": 571.906,
    "zh": "我心里有主意了",
    "vi": "Tôi đã nảy ra một ý hay."
  },
  {
    "idx": 435,
    "start": "00:09:31,906",
    "end": "00:09:33,106",
    "start_sec": 571.906,
    "end_sec": 573.106,
    "zh": "走进帮我干嘛",
    "vi": "Vào đây giúp tôi một tay nào."
  },
  {
    "idx": 436,
    "start": "00:09:33,106",
    "end": "00:09:35,106",
    "start_sec": 573.106,
    "end_sec": 575.106,
    "zh": "楼到底传来脚步声和叫马声",
    "vi": "Dưới lầu truyền đến tiếng bước chân và tiếng chửi bới."
  },
  {
    "idx": 437,
    "start": "00:09:35,106",
    "end": "00:09:35,846",
    "start_sec": 575.106,
    "end_sec": 575.846,
    "zh": "妈的",
    "vi": "Mẹ kiếp."
  },
  {
    "idx": 438,
    "start": "00:09:35,846",
    "end": "00:09:37,306",
    "start_sec": 575.846,
    "end_sec": 577.306,
    "zh": "这楼里咋这么干净",
    "vi": "Sao trong tòa nhà này lại sạch sẽ thế nhỉ."
  },
  {
    "idx": 439,
    "start": "00:09:37,306",
    "end": "00:09:38,826",
    "start_sec": 577.306,
    "end_sec": 578.826,
    "zh": "肯定是昨天那两个人干的",
    "vi": "Chắc chắn là do hai đứa hôm qua làm rồi."
  },
  {
    "idx": 440,
    "start": "00:09:38,826",
    "end": "00:09:40,506",
    "start_sec": 578.826,
    "end_sec": 580.506,
    "zh": "他们肯定说了不少好东西",
    "vi": "Chắc chắn chúng đã gom được không ít đồ tốt."
  },
  {
    "idx": 441,
    "start": "00:09:40,506",
    "end": "00:09:40,926",
    "start_sec": 580.506,
    "end_sec": 580.926,
    "zh": "老大",
    "vi": "Đại ca."
  },
  {
    "idx": 442,
    "start": "00:09:40,926",
    "end": "00:09:41,686",
    "start_sec": 580.926,
    "end_sec": 581.686,
    "zh": "他们在三楼",
    "vi": "Chúng đang ở tầng ba."
  },
  {
    "idx": 443,
    "start": "00:09:41,686",
    "end": "00:09:42,906",
    "start_sec": 581.686,
    "end_sec": 582.906,
    "zh": "我看到灯光了",
    "vi": "Em thấy ánh đèn rồi."
  },
  {
    "idx": 444,
    "start": "00:09:42,906",
    "end": "00:09:43,286",
    "start_sec": 582.906,
    "end_sec": 583.286,
    "zh": "很快",
    "vi": "Rất nhanh."
  },
  {
    "idx": 445,
    "start": "00:09:43,286",
    "end": "00:09:45,206",
    "start_sec": 583.286,
    "end_sec": 585.206,
    "zh": "脚步声停在我家门口",
    "vi": "Tiếng bước chân dừng lại trước cửa nhà tôi."
  },
  {
    "idx": 446,
    "start": "00:09:45,206",
    "end": "00:09:47,126",
    "start_sec": 585.206,
    "end_sec": 587.126,
    "zh": "敲门声很响",
    "vi": "Tiếng gõ cửa vang lên dồn dập."
  },
  {
    "idx": 447,
    "start": "00:09:47,126",
    "end": "00:09:48,166",
    "start_sec": 587.126,
    "end_sec": 588.166,
    "zh": "是光头找风在",
    "vi": "Đó là tên đầu trọc Triệu Phong."
  },
  {
    "idx": 448,
    "start": "00:09:48,166",
    "end": "00:09:49,486",
    "start_sec": 588.166,
    "end_sec": 589.486,
    "zh": "里面的烟瓶呢",
    "vi": "Lũ nhóc bên trong nghe đây."
  },
  {
    "idx": 449,
    "start": "00:09:49,486",
    "end": "00:09:51,186",
    "start_sec": 589.486,
    "end_sec": 591.186,
    "zh": "老子知道你们在里面",
    "vi": "Tao biết tụi mày đang ở bên trong."
  },
  {
    "idx": 450,
    "start": "00:09:51,186",
    "end": "00:09:51,766",
    "start_sec": 591.186,
    "end_sec": 591.766,
    "zh": "直向你",
    "vi": "Biết điều chút đi."
  },
  {
    "idx": 451,
    "start": "00:09:51,766",
    "end": "00:09:52,626",
    "start_sec": 591.766,
    "end_sec": 592.626,
    "zh": "把门打开",
    "vi": "Mở cửa ra."
  },
  {
    "idx": 452,
    "start": "00:09:52,626",
    "end": "00:09:53,946",
    "start_sec": 592.626,
    "end_sec": 593.946,
    "zh": "交出所有物资",
    "vi": "Giao nộp tất cả vật tư."
  },
  {
    "idx": 453,
    "start": "00:09:53,946",
    "end": "00:10:06,232",
    "start_sec": 593.946,
    "end_sec": 606.232,
    "zh": "老子可以咬你们一命有如烟吓得躲在我身后抖个不停我施以他弟子对着门脉喊东西以给你们,但你们要保证我们的安全门脉传来一声哄笑小子,你现在没资格跟我们谈条件",
    "vi": "Tao có thể cho tụi mày một mạng sống, nhưng tụi mày phải đảm bảo an toàn cho bọn tao."
  },
  {
    "idx": 454,
    "start": "00:10:06,232",
    "end": "00:10:07,532",
    "start_sec": 606.232,
    "end_sec": 607.532,
    "zh": "赵峰的声音很不耐烦",
    "vi": "Giọng Triệu Phong đầy vẻ thiếu kiên nhẫn."
  },
  {
    "idx": 455,
    "start": "00:10:07,532",
    "end": "00:10:10,692",
    "start_sec": 607.532,
    "end_sec": 610.692,
    "zh": "我速散声,再不开门,我们就撞进去了",
    "vi": "Tao cho tụi mày thêm chút nữa, không mở cửa tao sẽ xông vào."
  },
  {
    "idx": 456,
    "start": "00:10:10,692",
    "end": "00:10:11,892",
    "start_sec": 610.692,
    "end_sec": 611.892,
    "zh": "三,二",
    "vi": "Ba, hai."
  },
  {
    "idx": 457,
    "start": "00:10:11,892",
    "end": "00:10:14,452",
    "start_sec": 611.892,
    "end_sec": 614.452,
    "zh": "就在他要喊一的时候,我低声对狗声说",
    "vi": "Ngay khi hắn sắp đếm đến một, tôi đã thấp giọng nói với Cẩu Thắng."
  },
  {
    "idx": 458,
    "start": "00:10:14,452",
    "end": "00:10:15,432",
    "start_sec": 614.452,
    "end_sec": 615.432,
    "zh": "就是现在",
    "vi": "Chính là bây giờ."
  },
  {
    "idx": 459,
    "start": "00:10:15,432",
    "end": "00:10:18,052",
    "start_sec": 615.432,
    "end_sec": 618.052,
    "zh": "狗声回忆,窜进厨房,打开了煤气总阀",
    "vi": "Cẩu Thắng lao vào bếp, mở van chính của bình gas."
  },
  {
    "idx": 460,
    "start": "00:10:18,052",
    "end": "00:10:21,072",
    "start_sec": 618.052,
    "end_sec": 621.072,
    "zh": "煤气泄漏的声音很清楚",
    "vi": "Tiếng gas rò rỉ rất rõ ràng."
  },
  {
    "idx": 461,
    "start": "00:10:21,072",
    "end": "00:10:22,452",
    "start_sec": 621.072,
    "end_sec": 622.452,
    "zh": "老大,里面有动静",
    "vi": "Đại ca, bên trong có động tĩnh."
  },
  {
    "idx": 462,
    "start": "00:10:22,452",
    "end": "00:10:24,592",
    "start_sec": 622.452,
    "end_sec": 624.592,
    "zh": "门脉的小弟喊道,赵峰冷笑一声",
    "vi": "Một tên đàn em của Triệu Phong hô lên, Triệu Phong cười khẩy."
  },
  {
    "idx": 463,
    "start": "00:10:24,592",
    "end": "00:10:26,232",
    "start_sec": 624.592,
    "end_sec": 626.232,
    "zh": "想耍花样给我做",
    "vi": "Muốn giở trò gì thì cứ làm đi."
  },
  {
    "idx": 464,
    "start": "00:10:26,232",
    "end": "00:10:30,052",
    "start_sec": 626.232,
    "end_sec": 630.052,
    "zh": "几个放汉开始用身体撞门",
    "vi": "Vài tên đàn ông bắt đầu dùng thân mình húc vào cửa."
  },
  {
    "idx": 465,
    "start": "00:10:30,052",
    "end": "00:10:32,452",
    "start_sec": 630.052,
    "end_sec": 632.452,
    "zh": "我用加固金属门栓堵住的门剧烈晃动",
    "vi": "Cánh cửa tôi đã chốt bằng thanh kim loại gia cố rung chuyển dữ dội."
  },
  {
    "idx": 466,
    "start": "00:10:32,452",
    "end": "00:10:33,352",
    "start_sec": 632.452,
    "end_sec": 633.352,
    "zh": "目泄万贼",
    "vi": "Khí gas tràn ra ngoài."
  },
  {
    "idx": 467,
    "start": "00:10:33,352",
    "end": "00:10:34,772",
    "start_sec": 633.352,
    "end_sec": 634.772,
    "zh": "柳如烟的脸惨白",
    "vi": "Mặt Liễu Như Yên tái mét."
  },
  {
    "idx": 468,
    "start": "00:10:34,772",
    "end": "00:10:35,632",
    "start_sec": 634.772,
    "end_sec": 635.632,
    "zh": "李冲久",
    "vi": "Lý Xung Cửu."
  },
  {
    "idx": 469,
    "start": "00:10:35,632",
    "end": "00:10:36,132",
    "start_sec": 635.632,
    "end_sec": 636.132,
    "zh": "我们",
    "vi": "Chúng ta."
  },
  {
    "idx": 470,
    "start": "00:10:36,132",
    "end": "00:10:37,172",
    "start_sec": 636.132,
    "end_sec": 637.172,
    "zh": "我们会死吗",
    "vi": "Chúng ta sẽ chết sao."
  },
  {
    "idx": 471,
    "start": "00:10:37,172",
    "end": "00:10:38,312",
    "start_sec": 637.172,
    "end_sec": 638.312,
    "zh": "他的声音都在这",
    "vi": "Giọng anh ta run rẩy."
  },
  {
    "idx": 472,
    "start": "00:10:38,312",
    "end": "00:10:39,392",
    "start_sec": 638.312,
    "end_sec": 639.392,
    "zh": "我没回答他",
    "vi": "Tôi không trả lời anh ta."
  },
  {
    "idx": 473,
    "start": "00:10:39,392",
    "end": "00:10:40,292",
    "start_sec": 639.392,
    "end_sec": 640.292,
    "zh": "只是盯着门口",
    "vi": "Chỉ nhìn chằm chằm vào cửa."
  },
  {
    "idx": 474,
    "start": "00:10:40,292",
    "end": "00:10:42,332",
    "start_sec": 640.292,
    "end_sec": 642.332,
    "zh": "手里拿着一个刚合成出来的东西",
    "vi": "Tay cầm một thứ vừa chế tạo xong."
  },
  {
    "idx": 475,
    "start": "00:10:42,332",
    "end": "00:10:43,612",
    "start_sec": 642.332,
    "end_sec": 643.612,
    "zh": "能量金盒加打火机",
    "vi": "Hộp năng lượng vàng và bật lửa."
  },
  {
    "idx": 476,
    "start": "00:10:43,612",
    "end": "00:10:44,792",
    "start_sec": 643.612,
    "end_sec": 644.792,
    "zh": "和遥控引爆器",
    "vi": "Và bộ kích nổ từ xa."
  },
  {
    "idx": 477,
    "start": "00:10:44,792",
    "end": "00:10:46,432",
    "start_sec": 644.792,
    "end_sec": 646.432,
    "zh": "煤气的味道越来越浓",
    "vi": "Mùi gas ngày càng nồng nặc."
  },
  {
    "idx": 478,
    "start": "00:10:46,432",
    "end": "00:10:48,772",
    "start_sec": 646.432,
    "end_sec": 648.772,
    "zh": "狗圣已经从厨房的仓库跳了出去",
    "vi": "Cẩu Thắng đã nhảy ra khỏi kho bếp."
  },
  {
    "idx": 479,
    "start": "00:10:48,772",
    "end": "00:10:50,652",
    "start_sec": 648.772,
    "end_sec": 650.652,
    "zh": "在三楼外墙的空桥外机上",
    "vi": "Ra ngoài cầu thang máy bên ngoài tường tầng ba."
  },
  {
    "idx": 480,
    "start": "00:10:50,652",
    "end": "00:10:52,112",
    "start_sec": 650.652,
    "end_sec": 652.112,
    "zh": "对我打了个欧铁的手势",
    "vi": "Và ra hiệu OK với tôi."
  },
  {
    "idx": 481,
    "start": "00:10:52,112",
    "end": "00:10:53,552",
    "start_sec": 652.112,
    "end_sec": 653.552,
    "zh": "房道门很逆称的状态",
    "vi": "Cánh cửa phòng bị phá tung."
  },
  {
    "idx": 482,
    "start": "00:10:53,552",
    "end": "00:10:54,972",
    "start_sec": 653.552,
    "end_sec": 654.972,
    "zh": "赵峰带着他的人冲进来",
    "vi": "Triệu Phong dẫn theo đám người xông vào."
  },
  {
    "idx": 483,
    "start": "00:10:54,972",
    "end": "00:10:55,672",
    "start_sec": 654.972,
    "end_sec": 655.672,
    "zh": "一脸横肉",
    "vi": "Gương mặt đầy sát khí."
  },
  {
    "idx": 484,
    "start": "00:10:55,672",
    "end": "00:10:56,312",
    "start_sec": 655.672,
    "end_sec": 656.312,
    "zh": "小子",
    "vi": "Thằng nhóc kia."
  },
  {
    "idx": 485,
    "start": "00:10:56,312",
    "end": "00:10:57,752",
    "start_sec": 656.312,
    "end_sec": 657.752,
    "zh": "我看你这次往哪跑",
    "vi": "Để xem lần này mày chạy đi đâu."
  },
  {
    "idx": 486,
    "start": "00:10:57,752",
    "end": "00:10:59,652",
    "start_sec": 657.752,
    "end_sec": 659.652,
    "zh": "他一眼就看到说在墙角的苏群",
    "vi": "Hắn nhìn thấy Tô Quần đang đứng ở góc tường."
  },
  {
    "idx": 487,
    "start": "00:10:59,652",
    "end": "00:11:01,092",
    "start_sec": 659.652,
    "end_sec": 661.092,
    "zh": "眼睛都直了",
    "vi": "Mắt hắn sáng rực lên."
  },
  {
    "idx": 488,
    "start": "00:11:01,092",
    "end": "00:11:01,372",
    "start_sec": 661.092,
    "end_sec": 661.372,
    "zh": "哇",
    "vi": "Chà."
  },
  {
    "idx": 489,
    "start": "00:11:01,372",
    "end": "00:11:03,112",
    "start_sec": 661.372,
    "end_sec": 663.112,
    "zh": "还有个这么水灵的女人",
    "vi": "Lại còn có một cô nàng xinh đẹp thế này."
  },
  {
    "idx": 490,
    "start": "00:11:03,112",
    "end": "00:11:04,192",
    "start_sec": 663.112,
    "end_sec": 664.192,
    "zh": "今天收获不错",
    "vi": "Hôm nay thu hoạch khá đấy."
  },
  {
    "idx": 491,
    "start": "00:11:04,192",
    "end": "00:11:06,372",
    "start_sec": 664.192,
    "end_sec": 666.372,
    "zh": "他的小弟们也跟着发出一阵脏笑",
    "vi": "Đám đàn em của hắn cũng cười cợt đầy bỉ ổi."
  },
  {
    "idx": 492,
    "start": "00:11:06,372",
    "end": "00:11:07,732",
    "start_sec": 666.372,
    "end_sec": 667.732,
    "zh": "赵峰没有立刻动手",
    "vi": "Triệu Phong không vội ra tay."
  },
  {
    "idx": 493,
    "start": "00:11:07,732",
    "end": "00:11:08,832",
    "start_sec": 667.732,
    "end_sec": 668.832,
    "zh": "他一步步走过来",
    "vi": "Hắn bước từng bước lại gần."
  },
  {
    "idx": 494,
    "start": "00:11:08,832",
    "end": "00:11:09,892",
    "start_sec": 668.832,
    "end_sec": 669.892,
    "zh": "很享受过的空气",
    "vi": "Tận hưởng không khí nơi này."
  },
  {
    "idx": 495,
    "start": "00:11:09,892",
    "end": "00:11:11,952",
    "start_sec": 669.892,
    "end_sec": 671.952,
    "zh": "把你身上所有东西都交出来",
    "vi": "Giao hết mọi thứ trên người mày ra đây."
  },
  {
    "idx": 496,
    "start": "00:11:11,952",
    "end": "00:11:13,632",
    "start_sec": 671.952,
    "end_sec": 673.632,
    "zh": "还有你那个会说话的狗",
    "vi": "Cả con chó biết nói của mày nữa."
  },
  {
    "idx": 497,
    "start": "00:11:13,632",
    "end": "00:11:14,332",
    "start_sec": 673.632,
    "end_sec": 674.332,
    "zh": "也归我",
    "vi": "Cũng là của tao."
  },
  {
    "idx": 498,
    "start": "00:11:14,332",
    "end": "00:11:16,172",
    "start_sec": 674.332,
    "end_sec": 676.172,
    "zh": "他闻到了空气里浓浓的霉气味",
    "vi": "Hắn ngửi thấy mùi thuốc nổ nồng nặc trong không khí."
  },
  {
    "idx": 499,
    "start": "00:11:16,172",
    "end": "00:11:16,872",
    "start_sec": 676.172,
    "end_sec": 676.872,
    "zh": "但没在意",
    "vi": "Nhưng chẳng hề bận tâm."
  },
  {
    "idx": 500,
    "start": "00:11:16,872",
    "end": "00:11:18,632",
    "start_sec": 676.872,
    "end_sec": 678.632,
    "zh": "只当我们想用这个吓唬他",
    "vi": "Chỉ nghĩ chúng tôi dùng nó để dọa hắn."
  },
  {
    "idx": 501,
    "start": "00:11:18,632",
    "end": "00:11:19,032",
    "start_sec": 678.632,
    "end_sec": 679.032,
    "zh": "怎么",
    "vi": "Sao nào."
  },
  {
    "idx": 502,
    "start": "00:11:19,032",
    "end": "00:11:20,872",
    "start_sec": 679.032,
    "end_sec": 680.872,
    "zh": "想跟老子同归于尽",
    "vi": "Muốn cùng tao chết chung à."
  },
  {
    "idx": 503,
    "start": "00:11:20,872",
    "end": "00:11:21,692",
    "start_sec": 680.872,
    "end_sec": 681.692,
    "zh": "你说的吗",
    "vi": "Mày nói gì cơ."
  },
  {
    "idx": 504,
    "start": "00:11:21,692",
    "end": "00:11:23,252",
    "start_sec": 681.692,
    "end_sec": 683.252,
    "zh": "你说的是一个小美人吗",
    "vi": "Mày đang nói đến cô nàng xinh đẹp này sao."
  },
  {
    "idx": 505,
    "start": "00:11:23,252",
    "end": "00:11:24,512",
    "start_sec": 683.252,
    "end_sec": 684.512,
    "zh": "我看着他笑了",
    "vi": "Tôi nhìn hắn rồi mỉm cười."
  },
  {
    "idx": 506,
    "start": "00:11:24,512",
    "end": "00:11:25,312",
    "start_sec": 684.512,
    "end_sec": 685.312,
    "zh": "你说的对",
    "vi": "Mày nói đúng đấy."
  },
  {
    "idx": 507,
    "start": "00:11:25,312",
    "end": "00:11:26,232",
    "start_sec": 685.312,
    "end_sec": 686.232,
    "zh": "我舍不得",
    "vi": "Tao không nỡ đâu."
  },
  {
    "idx": 508,
    "start": "00:11:26,232",
    "end": "00:11:27,532",
    "start_sec": 686.232,
    "end_sec": 687.532,
    "zh": "然后我当着他的面",
    "vi": "Sau đó ngay trước mặt hắn."
  },
  {
    "idx": 509,
    "start": "00:11:27,532",
    "end": "00:11:28,812",
    "start_sec": 687.532,
    "end_sec": 688.812,
    "zh": "按下了手里的遥控器",
    "vi": "Tôi nhấn nút điều khiển trong tay."
  },
  {
    "idx": 510,
    "start": "00:11:28,812",
    "end": "00:11:29,932",
    "start_sec": 688.812,
    "end_sec": 689.932,
    "zh": "再下了蠢货",
    "vi": "Tạm biệt đồ ngu ngốc."
  },
  {
    "idx": 511,
    "start": "00:11:29,932",
    "end": "00:11:31,532",
    "start_sec": 689.932,
    "end_sec": 691.532,
    "zh": "赵峰脸上的笑僵住了",
    "vi": "Nụ cười trên mặt Triệu Phong bỗng cứng đờ."
  },
  {
    "idx": 512,
    "start": "00:11:31,532",
    "end": "00:11:32,272",
    "start_sec": 691.532,
    "end_sec": 692.272,
    "zh": "他张嘴想喊",
    "vi": "Hắn há miệng định hét lên."
  },
  {
    "idx": 513,
    "start": "00:11:32,272",
    "end": "00:11:32,952",
    "start_sec": 692.272,
    "end_sec": 692.952,
    "zh": "但晚了",
    "vi": "Nhưng đã quá muộn."
  },
  {
    "idx": 514,
    "start": "00:11:32,952",
    "end": "00:11:33,972",
    "start_sec": 692.952,
    "end_sec": 693.972,
    "zh": "满屋的没气",
    "vi": "Căn phòng đầy khí gas."
  },
  {
    "idx": 515,
    "start": "00:11:33,972",
    "end": "00:11:35,312",
    "start_sec": 693.972,
    "end_sec": 695.312,
    "zh": "一点火星就是地狱",
    "vi": "Chỉ một tia lửa nhỏ cũng biến nơi này thành địa ngục."
  },
  {
    "idx": 516,
    "start": "00:11:35,312",
    "end": "00:11:36,152",
    "start_sec": 695.312,
    "end_sec": 696.152,
    "zh": "轰隆一声",
    "vi": "Một tiếng nổ lớn vang lên."
  },
  {
    "idx": 517,
    "start": "00:11:36,152",
    "end": "00:11:37,472",
    "start_sec": 696.152,
    "end_sec": 697.472,
    "zh": "三楼窗户全熄",
    "vi": "Cửa sổ tầng ba vỡ vụn hoàn toàn."
  },
  {
    "idx": 518,
    "start": "00:11:37,472",
    "end": "00:11:38,552",
    "start_sec": 697.472,
    "end_sec": 698.552,
    "zh": "火浪从我家炸裂",
    "vi": "Lửa đỏ bùng nổ từ nhà tôi."
  },
  {
    "idx": 519,
    "start": "00:11:38,552",
    "end": "00:11:39,332",
    "start_sec": 698.552,
    "end_sec": 699.332,
    "zh": "相伴席卷",
    "vi": "Cuồn cuộn quét sạch mọi thứ."
  },
  {
    "idx": 520,
    "start": "00:11:39,332",
    "end": "00:11:41,072",
    "start_sec": 699.332,
    "end_sec": 701.072,
    "zh": "赵峰和冲在最前面的小弟",
    "vi": "Triệu Phong và tên đàn em xông lên đi đầu."
  },
  {
    "idx": 521,
    "start": "00:11:41,072",
    "end": "00:11:42,212",
    "start_sec": 701.072,
    "end_sec": 702.212,
    "zh": "惨叫都来不及发",
    "vi": "Còn chưa kịp hét lên thảm thiết."
  },
  {
    "idx": 522,
    "start": "00:11:42,212",
    "end": "00:11:43,192",
    "start_sec": 702.212,
    "end_sec": 703.192,
    "zh": "直接烧成了焦炭",
    "vi": "Đã bị thiêu cháy thành than."
  },
  {
    "idx": 523,
    "start": "00:11:43,192",
    "end": "00:11:44,932",
    "start_sec": 703.192,
    "end_sec": 704.932,
    "zh": "后面几个人也被火浪喷抹",
    "vi": "Mấy người phía sau cũng bị ngọn lửa nuốt chửng."
  },
  {
    "idx": 524,
    "start": "00:11:44,932",
    "end": "00:11:46,112",
    "start_sec": 704.932,
    "end_sec": 706.112,
    "zh": "变成燃烧的火人",
    "vi": "Biến thành những người lửa đang bốc cháy."
  },
  {
    "idx": 525,
    "start": "00:11:46,112",
    "end": "00:11:47,732",
    "start_sec": 706.112,
    "end_sec": 707.732,
    "zh": "惨叫着从楼道滚下去",
    "vi": "Gào thét thảm thiết rồi lăn xuống cầu thang."
  },
  {
    "idx": 526,
    "start": "00:11:47,732",
    "end": "00:11:48,632",
    "start_sec": 707.732,
    "end_sec": 708.632,
    "zh": "爆炸前一秒",
    "vi": "Một giây trước khi vụ nổ xảy ra."
  },
  {
    "idx": 527,
    "start": "00:11:48,632",
    "end": "00:11:49,912",
    "start_sec": 708.632,
    "end_sec": 709.912,
    "zh": "火爆至下闪的柳如烟",
    "vi": "Liễu Như Yên nhanh chóng né tránh."
  },
  {
    "idx": 528,
    "start": "00:11:49,912",
    "end": "00:11:51,612",
    "start_sec": 709.912,
    "end_sec": 711.612,
    "zh": "撞碎窗户从三楼跳下",
    "vi": "Lao qua cửa kính vỡ và nhảy xuống từ tầng ba."
  },
  {
    "idx": 529,
    "start": "00:11:51,612",
    "end": "00:11:54,232",
    "start_sec": 711.612,
    "end_sec": 714.232,
    "zh": "我们落在提前合成的超后缓冲气垫上",
    "vi": "Chúng tôi rơi xuống tấm đệm khí giảm chấn siêu dày đã chuẩn bị sẵn."
  },
  {
    "idx": 530,
    "start": "00:11:54,232",
    "end": "00:11:56,012",
    "start_sec": 714.232,
    "end_sec": 716.012,
    "zh": "巨大的冲击力让我气血翻涌",
    "vi": "Lực va đập cực lớn khiến lồng ngực tôi thắt lại."
  },
  {
    "idx": 531,
    "start": "00:11:56,012",
    "end": "00:11:57,252",
    "start_sec": 716.012,
    "end_sec": 717.252,
    "zh": "好在没受伤",
    "vi": "May mà không bị thương."
  },
  {
    "idx": 532,
    "start": "00:11:57,252",
    "end": "00:11:59,052",
    "start_sec": 717.252,
    "end_sec": 719.052,
    "zh": "狗自己从空调外机上跳下来",

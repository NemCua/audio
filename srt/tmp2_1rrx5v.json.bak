    "start": "05:11:46,492",
    "end": "05:11:48,532",
    "start_sec": 18706.492,
    "end_sec": 18708.532,
    "zh": "看来026开始发地了",
    "vi": "Xem ra số 026 bắt đầu ra tay rồi."
  },
  {
    "idx": 11180,
    "start": "05:11:48,532",
    "end": "05:11:49,612",
    "start_sec": 18708.532,
    "end_sec": 18709.612,
    "zh": "至于玉鬼者总部",
    "vi": "Còn về trụ sở Ngự Quỷ Giả."
  },
  {
    "idx": 11181,
    "start": "05:11:49,612",
    "end": "05:11:52,112",
    "start_sec": 18709.612,
    "end_sec": 18712.112,
    "zh": "那里应该不至于也未及四伏吧",
    "vi": "Nơi đó chắc không đến mức cũng đầy rẫy hiểm nguy chứ."
  },
  {
    "idx": 11182,
    "start": "05:11:52,112",
    "end": "05:11:54,472",
    "start_sec": 18712.112,
    "end_sec": 18714.472,
    "zh": "长者皮坐在角落沙发上",
    "vi": "Trình Tử Bì ngồi trên ghế sofa ở góc phòng."
  },
  {
    "idx": 11183,
    "start": "05:11:54,472",
    "end": "05:11:55,672",
    "start_sec": 18714.472,
    "end_sec": 18715.672,
    "zh": "翻页着周扬的手机",
    "vi": "Lướt xem điện thoại của Chu Dương."
  },
  {
    "idx": 11184,
    "start": "05:11:55,672",
    "end": "05:11:57,872",
    "start_sec": 18715.672,
    "end_sec": 18717.872,
    "zh": "打到玉鬼者网站点击登录",
    "vi": "Mở trang web Ngự Quỷ Giả rồi nhấn đăng nhập."
  },
  {
    "idx": 11185,
    "start": "05:11:57,872",
    "end": "05:12:00,112",
    "start_sec": 18717.872,
    "end_sec": 18720.112,
    "zh": "周鹤山特殊型玉鬼者",
    "vi": "Chu Hạc Sơn, Ngự Quỷ Giả loại đặc biệt."
  },
  {
    "idx": 11186,
    "start": "05:12:00,112",
    "end": "05:12:01,252",
    "start_sec": 18720.112,
    "end_sec": 18721.252,
    "zh": "编号054",
    "vi": "Mã số 054."
  },
  {
    "idx": 11187,
    "start": "05:12:01,252",
    "end": "05:12:02,212",
    "start_sec": 18721.252,
    "end_sec": 18722.212,
    "zh": "还有特殊型",
    "vi": "Còn có cả loại đặc biệt nữa sao."
  },
  {
    "idx": 11188,
    "start": "05:12:02,212",
    "end": "05:12:04,052",
    "start_sec": 18722.212,
    "end_sec": 18724.052,
    "zh": "上次只是粗略浏览了网页",
    "vi": "Lần trước chỉ mới xem lướt qua trang web."
  },
  {
    "idx": 11189,
    "start": "05:12:04,052",
    "end": "05:12:06,412",
    "start_sec": 18724.052,
    "end_sec": 18726.412,
    "zh": "刚好趁这两天有时间多了解了解",
    "vi": "Nhân lúc hai ngày này có thời gian phải tìm hiểu thêm mới được."
  },
  {
    "idx": 11190,
    "start": "05:12:06,412",
    "end": "05:12:08,812",
    "start_sec": 18726.412,
    "end_sec": 18728.812,
    "zh": "这个玉鬼者总部到底是个怎样的组织",
    "vi": "Trụ sở Ngự Quỷ Giả này rốt cuộc là một tổ chức như thế nào."
  },
  {
    "idx": 11191,
    "start": "05:12:08,812",
    "end": "05:12:11,272",
    "start_sec": 18728.812,
    "end_sec": 18731.272,
    "zh": "基地内大致分为三类人",
    "vi": "Trong căn cứ chia làm ba loại người chính."
  },
  {
    "idx": 11192,
    "start": "05:12:11,272",
    "end": "05:12:12,132",
    "start_sec": 18731.272,
    "end_sec": 18732.132,
    "zh": "普通人",
    "vi": "Người bình thường."
  },
  {
    "idx": 11193,
    "start": "05:12:12,132",
    "end": "05:12:14,072",
    "start_sec": 18732.132,
    "end_sec": 18734.072,
    "zh": "特殊型御鬼者",
    "vi": "Người điều khiển quỷ hệ đặc biệt."
  },
  {
    "idx": 11194,
    "start": "05:12:14,072",
    "end": "05:12:16,432",
    "start_sec": 18734.072,
    "end_sec": 18736.432,
    "zh": "编号型御鬼者",
    "vi": "Người điều khiển quỷ hệ đánh số."
  },
  {
    "idx": 11195,
    "start": "05:12:16,432",
    "end": "05:12:18,212",
    "start_sec": 18736.432,
    "end_sec": 18738.212,
    "zh": "这御鬼者福利算是顶尖了",
    "vi": "Phúc lợi cho người điều khiển quỷ đúng là đỉnh nhất rồi."
  },
  {
    "idx": 11196,
    "start": "05:12:18,212",
    "end": "05:12:19,132",
    "start_sec": 18738.212,
    "end_sec": 18739.132,
    "zh": "不过这也说明",
    "vi": "Nhưng điều này cũng cho thấy."
  },
  {
    "idx": 11197,
    "start": "05:12:19,132",
    "end": "05:12:21,012",
    "start_sec": 18739.132,
    "end_sec": 18741.012,
    "zh": "能长期驾驭诡异的战斗人员",
    "vi": "Số lượng chiến binh có thể điều khiển quỷ lâu dài."
  },
  {
    "idx": 11198,
    "start": "05:12:21,012",
    "end": "05:12:22,212",
    "start_sec": 18741.012,
    "end_sec": 18742.212,
    "zh": "确实辽辽无几了",
    "vi": "Thực sự chỉ đếm trên đầu ngón tay."
  },
  {
    "idx": 11199,
    "start": "05:12:22,212",
    "end": "05:12:23,952",
    "start_sec": 18742.212,
    "end_sec": 18743.952,
    "zh": "难怪编号最多只有52",
    "vi": "Thảo nào số thứ tự cao nhất chỉ là 52."
  },
  {
    "idx": 11200,
    "start": "05:12:23,952",
    "end": "05:12:25,472",
    "start_sec": 18743.952,
    "end_sec": 18745.472,
    "zh": "也不知道我去鉴定完后",
    "vi": "Không biết sau khi tôi đi giám định xong."
  },
  {
    "idx": 11201,
    "start": "05:12:25,472",
    "end": "05:12:27,412",
    "start_sec": 18745.472,
    "end_sec": 18747.412,
    "zh": "序列号还是不是027了",
    "vi": "Số thứ tự còn là 027 nữa hay không."
  },
  {
    "idx": 11202,
    "start": "05:12:27,412",
    "end": "05:12:29,272",
    "start_sec": 18747.412,
    "end_sec": 18749.272,
    "zh": "一个月三十点公讯点",
    "vi": "Ba mươi điểm công vụ mỗi tháng."
  },
  {
    "idx": 11203,
    "start": "05:12:29,272",
    "end": "05:12:30,172",
    "start_sec": 18749.272,
    "end_sec": 18750.172,

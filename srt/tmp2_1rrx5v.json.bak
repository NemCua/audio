    "start": "00:19:53,658",
    "end": "00:19:54,578",
    "start_sec": 1193.658,
    "end_sec": 1194.578,
    "zh": "狗圣有些担忧",
    "vi": "Cẩu Thánh có chút lo lắng."
  },

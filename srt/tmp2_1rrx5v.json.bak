  },
  {
    "idx": 533,
    "start": "00:11:59,052",
    "end": "00:12:00,072",
    "start_sec": 719.052,
    "end_sec": 720.072,
    "zh": "稳稳落在我身边",
    "vi": "Rơi xuống vững vàng ngay bên cạnh tôi."
  },

    "end_sec": 13825.934,
    "zh": "长子皮瞄了眼任务栏",
    "vi": "Trình Tử Bì liếc nhìn thanh nhiệm vụ."
  },
  {
    "idx": 8209,
    "start": "03:50:25,934",
    "end": "03:50:28,214",
    "start_sec": 13825.934,
    "end_sec": 13828.214,
    "zh": "上面有个任务计算中的符号",
    "vi": "Trên đó có một biểu tượng hiển thị nhiệm vụ đang được tính toán."
  },
  {
    "idx": 8210,
    "start": "03:50:28,214",
    "end": "03:50:28,894",
    "start_sec": 13828.214,
    "end_sec": 13828.894,
    "zh": "点开来一看",
    "vi": "Nhấp vào xem thử"
  },
  {
    "idx": 8211,
    "start": "03:50:28,894",
    "end": "03:50:30,294",
    "start_sec": 13828.894,
    "end_sec": 13830.294,
    "zh": "赫然是一级任务",
    "vi": "thì ra là một nhiệm vụ cấp một."
  },
  {
    "idx": 8212,
    "start": "03:50:30,294",
    "end": "03:50:31,074",
    "start_sec": 13830.294,
    "end_sec": 13831.074,
    "zh": "护送服务件",
    "vi": "Hộ tống kiện hàng."
  },
  {
    "idx": 8213,
    "start": "03:50:31,074",
    "end": "03:50:31,974",
    "start_sec": 13831.074,
    "end_sec": 13831.974,
    "zh": "任务奖励",
    "vi": "Phần thưởng nhiệm vụ"
  },
  {
    "idx": 8214,
    "start": "03:50:31,974",
    "end": "03:50:33,194",
    "start_sec": 13831.974,
    "end_sec": 13833.194,
    "zh": "三万公顷点",
    "vi": "ba mươi nghìn điểm cống hiến."
  },
  {
    "idx": 8215,
    "start": "03:50:33,194",
    "end": "03:50:33,814",
    "start_sec": 13833.194,
    "end_sec": 13833.814,
    "zh": "我操",
    "vi": "Chết tiệt."
  },
  {
    "idx": 8216,
    "start": "03:50:33,814",
    "end": "03:50:35,534",
    "start_sec": 13833.814,
    "end_sec": 13835.534,
    "zh": "连任务都给我刷新了",
    "vi": "Đến cả nhiệm vụ cũng tự cập nhật cho mình rồi."
  },
  {
    "idx": 8217,
    "start": "03:50:35,534",
    "end": "03:50:36,794",
    "start_sec": 13835.534,
    "end_sec": 13836.794,
    "zh": "不愧是官方的东西",
    "vi": "Không hổ là đồ của chính phủ."
  },
  {
    "idx": 8218,
    "start": "03:50:36,794",
    "end": "03:50:37,694",
    "start_sec": 13836.794,
    "end_sec": 13837.694,
    "zh": "的确智能",
    "vi": "Đúng là thông minh thật."
  },
  {
    "idx": 8219,
    "start": "03:50:37,694",
    "end": "03:50:40,394",
    "start_sec": 13837.694,
    "end_sec": 13840.394,
    "zh": "长子皮早有兴趣的坐在沙发上",
    "vi": "Trình Tử Bì đầy hứng thú ngồi trên ghế sofa"
  },
  {
    "idx": 8220,
    "start": "03:50:40,394",
    "end": "03:50:41,514",
    "start_sec": 13840.394,
    "end_sec": 13841.514,
    "zh": "随意翻动着网页",
    "vi": "và lướt xem trang web."
  },
  {
    "idx": 8221,
    "start": "03:50:41,514",
    "end": "03:50:43,334",
    "start_sec": 13841.514,
    "end_sec": 13843.334,
    "zh": "在遇鬼者大全的专栏中",
    "vi": "Trong chuyên mục về những người ngự quỷ"
  },
  {
    "idx": 8222,
    "start": "03:50:43,334",
    "end": "03:50:44,654",
    "start_sec": 13843.334,
    "end_sec": 13844.654,
    "zh": "找到了自己的信息",
    "vi": "tôi đã tìm thấy thông tin của mình"
  },
  {
    "idx": 8223,
    "start": "03:50:44,654",
    "end": "03:50:46,774",
    "start_sec": 13844.654,
    "end_sec": 13846.774,
    "zh": "只有编号20到52的遇鬼者",
    "vi": "Chỉ có người ngự quỷ từ số thứ tự 20 đến 52"
  },
  {
    "idx": 8224,
    "start": "03:50:46,774",
    "end": "03:50:48,034",
    "start_sec": 13846.774,
    "end_sec": 13848.034,
    "zh": "才会有信息公布",
    "vi": "mới được công khai thông tin"
  },
  {
    "idx": 8225,
    "start": "03:50:48,034",
    "end": "03:50:50,214",
    "start_sec": 13848.034,
    "end_sec": 13850.214,
    "zh": "20到1的遇鬼者信息完全保密",
    "vi": "Thông tin từ số 20 đến 1 đều được bảo mật tuyệt đối"
  },
  {
    "idx": 8226,
    "start": "03:50:50,214",
    "end": "03:50:51,634",
    "start_sec": 13850.214,
    "end_sec": 13851.634,
    "zh": "从序列20开始",
    "vi": "Bắt đầu từ thứ tự 20"
  },
  {
    "idx": 8227,
    "start": "03:50:51,634",
    "end": "03:50:53,934",
    "start_sec": 13851.634,
    "end_sec": 13853.934,
    "zh": "既然都驾驭了两只精力上的鬼子",
    "vi": "vì họ đều đã ngự được hai con quỷ tinh anh"
  },
  {
    "idx": 8228,
    "start": "03:50:53,934",
    "end": "03:50:55,474",
    "start_sec": 13853.934,
    "end_sec": 13855.474,
    "zh": "也就是说前二十的遇鬼者",
    "vi": "Điều đó có nghĩa là top 20 người ngự quỷ"
  },
  {
    "idx": 8229,
    "start": "03:50:55,474",
    "end": "03:50:57,474",
    "start_sec": 13855.474,
    "end_sec": 13857.474,
    "zh": "和后面的都不是一个水平啊",
    "vi": "không cùng đẳng cấp với những người phía sau"
  },
  {
    "idx": 8230,
    "start": "03:50:57,474",
    "end": "03:50:59,874",
    "start_sec": 13857.474,
    "end_sec": 13859.874,
    "zh": "那要是前十的该有多么恐怖",
    "vi": "Vậy thì top 10 sẽ đáng sợ đến mức nào đây"
  },
  {
    "idx": 8231,
    "start": "03:50:59,874",
    "end": "03:51:00,754",
    "start_sec": 13859.874,
    "end_sec": 13860.754,
    "zh": "案子在讲着",
    "vi": "Khi tôi đang nói"
  },
  {
    "idx": 8232,
    "start": "03:51:00,754",
    "end": "03:51:02,014",
    "start_sec": 13860.754,
    "end_sec": 13862.014,
    "zh": "方文突然被推开",
    "vi": "cửa phòng đột nhiên bị đẩy ra"
  },
  {
    "idx": 8233,
    "start": "03:51:02,014",
    "end": "03:51:03,454",
    "start_sec": 13862.014,
    "end_sec": 13863.454,
    "zh": "橙子皮你回来了",
    "vi": "Trần Tử Bì bạn về rồi à"
  },
  {
    "idx": 8234,
    "start": "03:51:03,454",
    "end": "03:51:04,114",
    "start_sec": 13863.454,
    "end_sec": 13864.114,
    "zh": "这么快",
    "vi": "Sao nhanh thế"
  },
  {
    "idx": 8235,
    "start": "03:51:04,114",
    "end": "03:51:05,654",
    "start_sec": 13864.114,
    "end_sec": 13865.654,
    "zh": "周扬显得有些惊讶",
    "vi": "Chu Dương tỏ vẻ ngạc nhiên"
  },
  {
    "idx": 8236,
    "start": "03:51:05,654",
    "end": "03:51:07,414",
    "start_sec": 13865.654,
    "end_sec": 13867.414,
    "zh": "橙子皮目光也有些警惕",
    "vi": "Ánh mắt Trần Tử Bì cũng đầy cảnh giác"
  },
  {
    "idx": 8237,
    "start": "03:51:07,414",
    "end": "03:51:09,674",
    "start_sec": 13867.414,
    "end_sec": 13869.674,
    "zh": "直到脖梗上的鬼面窗给出反应",
    "vi": "Cho đến khi mặt quỷ trên cổ đưa ra phản ứng"
  },
  {
    "idx": 8238,
    "start": "03:51:09,674",
    "end": "03:51:11,294",
    "start_sec": 13869.674,
    "end_sec": 13871.294,
    "zh": "确认周扬是真人后",
    "vi": "xác nhận Chu Dương là người thật"
  },
  {
    "idx": 8239,
    "start": "03:51:11,294",
    "end": "03:51:12,754",
    "start_sec": 13871.294,
    "end_sec": 13872.754,
    "zh": "橙子皮才松了口气",
    "vi": "Trần Tử Bì mới thở phào nhẹ nhõm"
  },
  {
    "idx": 8240,
    "start": "03:51:12,754",
    "end": "03:51:13,774",
    "start_sec": 13872.754,
    "end_sec": 13873.774,
    "zh": "看什么呢",
    "vi": "Bạn nhìn gì thế"
  },
  {
    "idx": 8241,
    "start": "03:51:13,774",
    "end": "03:51:15,514",
    "start_sec": 13873.774,
    "end_sec": 13875.514,
    "zh": "怎么我的脸上有什么吗",
    "vi": "Trên mặt tôi có gì lạ sao"
  },
  {
    "idx": 8242,
    "start": "03:51:15,514",
    "end": "03:51:16,694",
    "start_sec": 13875.514,
    "end_sec": 13876.694,
    "zh": "没没什么",
    "vi": "Không không có gì"
  },
  {
    "idx": 8243,
    "start": "03:51:16,694",
    "end": "03:51:18,794",
    "start_sec": 13876.694,
    "end_sec": 13878.794,
    "zh": "话说你被023叫过去",
    "vi": "Mà này bạn bị số 023 gọi đi"
  },
  {
    "idx": 8244,
    "start": "03:51:18,794",
    "end": "03:51:21,094",
    "start_sec": 13878.794,
    "end_sec": 13881.094,
    "zh": "是不是要被邀请进入遇鬼者组织",
    "vi": "có phải là để mời gia nhập tổ chức ngự quỷ không"
  },
  {
    "idx": 8245,
    "start": "03:51:21,094",
    "end": "03:51:22,314",
    "start_sec": 13881.094,
    "end_sec": 13882.314,
    "zh": "这你都猜到了",
    "vi": "Bạn đoán ra rồi à"
  },
  {
    "idx": 8246,
    "start": "03:51:22,314",
    "end": "03:51:23,054",
    "start_sec": 13882.314,
    "end_sec": 13883.054,
    "zh": "正常",
    "vi": "Chuyện bình thường"
  },
  {
    "idx": 8247,
    "start": "03:51:23,054",
    "end": "03:51:24,314",
    "start_sec": 13883.054,
    "end_sec": 13884.314,
    "zh": "我这一路走过来",
    "vi": "Trên đường đi đến đây"
  },
  {
    "idx": 8248,
    "start": "03:51:24,314",
    "end": "03:51:26,154",
    "start_sec": 13884.314,
    "end_sec": 13886.154,
    "zh": "才知道御鬼者有多稀缺",
    "vi": "tôi mới biết người ngự quỷ khan hiếm thế nào"
  },
  {
    "idx": 8249,
    "start": "03:51:26,154",
    "end": "03:51:28,394",
    "start_sec": 13886.154,
    "end_sec": 13888.394,
    "zh": "并不是说能驾驭诡异的人数上",
    "vi": "Không phải nói về số lượng người có thể ngự quỷ"
  },
  {
    "idx": 8250,
    "start": "03:51:28,394",
    "end": "03:51:30,434",
    "start_sec": 13888.394,
    "end_sec": 13890.434,
    "zh": "而是很多人尝试驾驭诡异后",
    "vi": "mà là sau khi nhiều người thử ngự quỷ xong"
  },
  {
    "idx": 8251,
    "start": "03:51:30,434",
    "end": "03:51:31,614",
    "start_sec": 13890.434,
    "end_sec": 13891.614,
    "zh": "很快就被感知",
    "vi": "Sẽ nhanh chóng bị phát hiện thôi."
  },
  {
    "idx": 8252,
    "start": "03:51:31,614",
    "end": "03:51:33,514",
    "start_sec": 13891.614,
    "end_sec": 13893.514,
    "zh": "你能一路从林江市到这里",
    "vi": "Bạn có thể đi một mạch từ thành phố Lâm Giang đến tận đây."
  },
  {
    "idx": 8253,
    "start": "03:51:33,514",
    "end": "03:51:35,114",
    "start_sec": 13893.514,
    "end_sec": 13895.114,
    "zh": "肯定已经适应了自身诡异",
    "vi": "Chắc chắn là đã thích nghi với sự kỳ dị của bản thân rồi."
  },
  {
    "idx": 8254,
    "start": "03:51:35,114",
    "end": "03:51:35,994",
    "start_sec": 13895.114,
    "end_sec": 13895.994,
    "zh": "你这样的人",
    "vi": "Những người như bạn."
  },
  {
    "idx": 8255,
    "start": "03:51:35,994",
    "end": "03:51:37,514",
    "start_sec": 13895.994,
    "end_sec": 13897.514,
    "zh": "想来他们不可能不要",
    "vi": "Chắc chắn là họ không thể nào từ chối đâu."
  },
  {
    "idx": 8256,
    "start": "03:51:37,514",
    "end": "03:51:38,454",
    "start_sec": 13897.514,
    "end_sec": 13898.454,
    "zh": "让我猜猜",
    "vi": "Để tôi đoán xem."
  },
  {
    "idx": 8257,
    "start": "03:51:38,454",
    "end": "03:51:40,734",
    "start_sec": 13898.454,
    "end_sec": 13900.734,
    "zh": "你得被安排的前四十名的序号吧",
    "vi": "Bạn chắc phải được xếp vào nhóm bốn mươi số hiệu đầu tiên rồi."
  },
  {
    "idx": 8258,
    "start": "03:51:40,734",
    "end": "03:51:41,874",
    "start_sec": 13900.734,
    "end_sec": 13901.874,
    "zh": "长者皮笑了叫",
    "vi": "Trình Tử Bì cười trừ."
  },
  {
    "idx": 8259,
    "start": "03:51:41,874",
    "end": "03:51:43,514",
    "start_sec": 13901.874,
    "end_sec": 13903.514,
    "zh": "没打算说出自己的序号",
    "vi": "Cậu ấy không có ý định nói ra số hiệu của mình."
  },
  {
    "idx": 8260,
    "start": "03:51:43,514",
    "end": "03:51:44,094",
    "start_sec": 13903.514,
    "end_sec": 13904.094,
    "zh": "对了",
    "vi": "À đúng rồi."
  },
  {
    "idx": 8261,
    "start": "03:51:44,094",
    "end": "03:51:46,734",
    "start_sec": 13904.094,
    "end_sec": 13906.734,
    "zh": "我刚刚带着小墨迹去找我家老头了",
    "vi": "Tôi vừa dẫn chú chó Tiểu Mặc Tích đi gặp bố tôi rồi."
  },
  {
    "idx": 8262,
    "start": "03:51:46,734",
    "end": "03:51:47,874",
    "start_sec": 13906.734,
    "end_sec": 13907.874,
    "zh": "他也喜欢小墨迹",
    "vi": "Ông ấy cũng rất thích Tiểu Mặc Tích."
  },
  {
    "idx": 8263,
    "start": "03:51:47,874",
    "end": "03:51:49,614",
    "start_sec": 13907.874,
    "end_sec": 13909.614,
    "zh": "说什么也要把狗留下来了",
    "vi": "Nói thế nào cũng đòi giữ chú chó đó lại."
  },
  {
    "idx": 8264,
    "start": "03:51:49,614",
    "end": "03:51:50,634",
    "start_sec": 13909.614,
    "end_sec": 13910.634,
    "zh": "我这没办法",
    "vi": "Tôi cũng không còn cách nào khác."
  },
  {
    "idx": 8265,
    "start": "03:51:50,634",
    "end": "03:51:52,054",
    "start_sec": 13910.634,
    "end_sec": 13912.054,
    "zh": "只能下次再给你要回来了",
    "vi": "Đành phải đợi lần sau đòi lại cho bạn vậy."
  },
  {
    "idx": 8266,
    "start": "03:51:52,054",
    "end": "03:51:52,834",
    "start_sec": 13912.054,
    "end_sec": 13912.834,
    "zh": "你不介意吧",
    "vi": "Bạn không để ý chứ."
  },
  {
    "idx": 8267,
    "start": "03:51:52,834",
    "end": "03:51:53,334",
    "start_sec": 13912.834,
    "end_sec": 13913.334,
    "zh": "是啊",
    "vi": "Đúng vậy."
  },
  {
    "idx": 8268,
    "start": "03:51:53,334",
    "end": "03:51:54,494",
    "start_sec": 13913.334,
    "end_sec": 13914.494,
    "zh": "不 我不介意",
    "vi": "Không, tôi không để ý đâu."
  },
  {
    "idx": 8269,
    "start": "03:51:54,494",
    "end": "03:51:55,014",
    "start_sec": 13914.494,
    "end_sec": 13915.014,
    "zh": "我猜",
    "vi": "Tôi đoán."
  },
  {
    "idx": 8270,
    "start": "03:51:55,014",
    "end": "03:51:56,914",
    "start_sec": 13915.014,
    "end_sec": 13916.914,
    "zh": "023还跟你说让你保护",
    "vi": "Số không hai ba còn bảo bạn phải bảo vệ tôi nữa đúng không."
  },
  {
    "idx": 8271,
    "start": "03:51:56,914",
    "end": "03:51:58,634",
    "start_sec": 13916.914,
    "end_sec": 13918.634,
    "zh": "那你今晚你就住我这里吧",
    "vi": "Vậy tối nay bạn cứ ở lại chỗ tôi đi."
  },
  {
    "idx": 8272,
    "start": "03:51:58,634",
    "end": "03:51:59,694",
    "start_sec": 13918.634,
    "end_sec": 13919.694,
    "zh": "我这有两个卧室",
    "vi": "Chỗ tôi có hai phòng ngủ."
  },
  {
    "idx": 8273,
    "start": "03:51:59,694",
    "end": "03:52:01,434",
    "start_sec": 13919.694,
    "end_sec": 13921.434,
    "zh": "换洗衣服也给你准备好了",
    "vi": "Quần áo để thay cũng đã chuẩn bị sẵn cho bạn rồi."
  },
  {
    "idx": 8274,
    "start": "03:52:01,434",
    "end": "03:52:03,614",
    "start_sec": 13921.434,
    "end_sec": 13923.614,
    "zh": "程子皮有些惊讶地望着周扬",
    "vi": "Trình Tử Bì hơi ngạc nhiên nhìn Chu Dương."
  },
  {
    "idx": 8275,
    "start": "03:52:03,614",
    "end": "03:52:04,394",
    "start_sec": 13923.614,
    "end_sec": 13924.394,
    "zh": "这也能猜到",
    "vi": "Thế này mà cũng đoán ra được sao."
  },
  {
    "idx": 8276,
    "start": "03:52:04,394",
    "end": "03:52:05,254",
    "start_sec": 13924.394,
    "end_sec": 13925.254,
    "zh": "我说朱公子",
    "vi": "Tôi nói này Chu công tử."
  },
  {
    "idx": 8277,
    "start": "03:52:05,254",
    "end": "03:52:06,714",
    "start_sec": 13925.254,
    "end_sec": 13926.714,
    "zh": "你开的可真行啊",
    "vi": "Bạn đúng là giỏi thật đấy."
  },
  {
    "idx": 8278,
    "start": "03:52:06,714",
    "end": "03:52:09,974",
    "start_sec": 13926.714,
    "end_sec": 13929.974,
    "zh": "气氛难得惬意了一会儿",
    "vi": "Bầu không khí hiếm khi được thư thái một lúc."
  },
  {
    "idx": 8279,
    "start": "03:52:09,974",
    "end": "03:52:12,434",
    "start_sec": 13929.974,
    "end_sec": 13932.434,
    "zh": "程子皮和周扬有一句没意见地聊着",
    "vi": "Trình Tử Bì và Chu Dương trò chuyện câu được câu chăng."
  },
  {
    "idx": 8280,
    "start": "03:52:12,434",
    "end": "03:52:15,114",
    "start_sec": 13932.434,
    "end_sec": 13935.114,
    "zh": "仿佛回到了诡异将临前的相处日常",
    "vi": "Giống như quay trở lại những ngày thường trước khi sự kỳ dị ập đến."
  },
  {
    "idx": 8281,
    "start": "03:52:15,114",
    "end": "03:52:17,154",
    "start_sec": 13935.114,
    "end_sec": 13937.154,
    "zh": "突然周扬冷不丁地问了一声",
    "vi": "Đột nhiên Chu Dương bất ngờ hỏi một câu."
  },
  {
    "idx": 8282,
    "start": "03:52:17,154",
    "end": "03:52:17,894",
    "start_sec": 13937.154,
    "end_sec": 13937.894,
    "zh": "话说",
    "vi": "Mà này."
  },
  {
    "idx": 8283,
    "start": "03:52:17,894",
    "end": "03:52:18,654",
    "start_sec": 13937.894,
    "end_sec": 13938.654,
    "zh": "程子皮",
    "vi": "Trình Tử Bì."
  },
  {
    "idx": 8284,
    "start": "03:52:18,654",
    "end": "03:52:20,274",
    "start_sec": 13938.654,
    "end_sec": 13940.274,
    "zh": "如果你有能力执掌一方",
    "vi": "Nếu bạn có năng lực nắm quyền một phương."
  },
  {
    "idx": 8285,
    "start": "03:52:20,274",
    "end": "03:52:21,534",
    "start_sec": 13940.274,
    "end_sec": 13941.534,
    "zh": "你会想着去称霸吗",
    "vi": "Bạn có nghĩ đến việc xưng bá không."
  },
  {
    "idx": 8286,
    "start": "03:52:21,534",
    "end": "03:52:22,734",
    "start_sec": 13941.534,
    "end_sec": 13942.734,
    "zh": "你说这个干嘛",
    "vi": "Bạn nói chuyện này làm gì."
  },
  {
    "idx": 8287,
    "start": "03:52:22,734",
    "end": "03:52:23,654",
    "start_sec": 13942.734,
    "end_sec": 13943.654,
    "zh": "我有那能力",
    "vi": "Nếu tôi có năng lực đó."
  },
  {
    "idx": 8288,
    "start": "03:52:23,654",
    "end": "03:52:24,634",
    "start_sec": 13943.654,
    "end_sec": 13944.634,
    "zh": "不得当个大佬",
    "vi": "Chẳng phải sẽ làm một ông trùm sao."
  },
  {
    "idx": 8289,
    "start": "03:52:24,634",
    "end": "03:52:25,994",
    "start_sec": 13944.634,
    "end_sec": 13945.994,
    "zh": "让别人当祖宗供掌",
    "vi": "Để người khác tôn sùng như tổ tiên."
  },
  {
    "idx": 8290,
    "start": "03:52:25,994",
    "end": "03:52:27,654",
    "start_sec": 13945.994,
    "end_sec": 13947.654,
    "zh": "周扬摇头笑了笑",
    "vi": "Chu Dương lắc đầu cười cười."
  },
  {
    "idx": 8291,
    "start": "03:52:27,654",
    "end": "03:52:29,094",
    "start_sec": 13947.654,
    "end_sec": 13949.094,
    "zh": "无聊的翻阅着手机",
    "vi": "Chán nản lướt điện thoại."
  },
  {
    "idx": 8292,
    "start": "03:52:29,094",
    "end": "03:52:30,974",
    "start_sec": 13949.094,
    "end_sec": 13950.974,
    "zh": "你小子牛啊",
    "vi": "Bạn đỉnh thật đấy."
  },
  {
    "idx": 8293,
    "start": "03:52:30,974",
    "end": "03:52:31,734",
    "start_sec": 13950.974,
    "end_sec": 13951.734,
    "zh": "编号027",
    "vi": "Mã số 027."
  },
  {
    "idx": 8294,
    "start": "03:52:31,734",
    "end": "03:52:33,334",
    "start_sec": 13951.734,
    "end_sec": 13953.334,
    "zh": "都快追上026了",
    "vi": "Sắp đuổi kịp 026 rồi."
  },
  {
    "idx": 8295,
    "start": "03:52:33,334",
    "end": "03:52:35,054",
    "start_sec": 13953.334,
    "end_sec": 13955.054,
    "zh": "你的诡异能力是无效化",
    "vi": "Năng lực kỳ dị của bạn là vô hiệu hóa."
  },
  {
    "idx": 8296,
    "start": "03:52:35,054",
    "end": "03:52:36,314",
    "start_sec": 13955.054,
    "end_sec": 13956.314,
    "zh": "无效化",
    "vi": "Vô hiệu hóa."
  },
  {
    "idx": 8297,
    "start": "03:52:36,314",
    "end": "03:52:37,394",
    "start_sec": 13956.314,
    "end_sec": 13957.394,
    "zh": "怎么了",
    "vi": "Sao thế."
  },
  {
    "idx": 8298,
    "start": "03:52:37,394",
    "end": "03:52:38,734",
    "start_sec": 13957.394,
    "end_sec": 13958.734,
    "zh": "没什么",
    "vi": "Không có gì."
  },
  {
    "idx": 8299,
    "start": "03:52:38,734",
    "end": "03:52:40,034",
    "start_sec": 13958.734,
    "end_sec": 13960.034,
    "zh": "你这个能力挺好的",
    "vi": "Năng lực này của bạn khá tốt đấy."
  },
  {
    "idx": 8300,
    "start": "03:52:40,034",
    "end": "03:52:42,054",
    "start_sec": 13960.034,
    "end_sec": 13962.054,
    "zh": "你也能上玉鬼者组织的网站",
    "vi": "Bạn cũng có thể vào trang web của tổ chức Ngự Quỷ Giả sao."
  },
  {
    "idx": 8301,
    "start": "03:52:42,054",
    "end": "03:52:43,414",
    "start_sec": 13962.054,
    "end_sec": 13963.414,
    "zh": "我肯定不行啊",
    "vi": "Tôi chắc chắn không được rồi."
  },
  {
    "idx": 8302,
    "start": "03:52:43,414",
    "end": "03:52:44,414",
    "start_sec": 13963.414,
    "end_sec": 13964.414,
    "zh": "这是我爹的权限",
    "vi": "Đây là quyền hạn của bố tôi."
  },
  {
    "idx": 8303,
    "start": "03:52:44,414",
    "end": "03:52:45,934",
    "start_sec": 13964.414,
    "end_sec": 13965.934,
    "zh": "闲来无事我就看看",
    "vi": "Lúc rảnh rỗi tôi xem thử thôi."
  },
  {
    "idx": 8304,
    "start": "03:52:45,934",
    "end": "03:52:47,154",
    "start_sec": 13965.934,
    "end_sec": 13967.154,
    "zh": "对了",
    "vi": "Đúng rồi."
  },
  {
    "idx": 8305,
    "start": "03:52:47,154",
    "end": "03:52:48,234",
    "start_sec": 13967.154,
    "end_sec": 13968.234,
    "zh": "我今天有些累了",
    "vi": "Hôm nay tôi hơi mệt."
  },
  {
    "idx": 8306,
    "start": "03:52:48,234",
    "end": "03:52:48,994",
    "start_sec": 13968.234,
    "end_sec": 13968.994,
    "zh": "就先睡了",
    "vi": "Nên đi ngủ trước đây."
  },
  {
    "idx": 8307,
    "start": "03:52:48,994",
    "end": "03:52:50,914",
    "start_sec": 13968.994,
    "end_sec": 13970.914,
    "zh": "周扬搭了个脑袋",
    "vi": "Chu Dương cúi đầu."
  },
  {
    "idx": 8308,
    "start": "03:52:50,914",
    "end": "03:52:53,154",
    "start_sec": 13970.914,
    "end_sec": 13973.154,
    "zh": "不自口进卧室锁上了房门",
    "vi": "Lẳng lặng đi vào phòng ngủ rồi khóa cửa lại."
  },
  {
    "idx": 8309,
    "start": "03:52:53,154",
    "end": "03:52:55,414",
    "start_sec": 13973.154,
    "end_sec": 13975.414,
    "zh": "这家伙不会有什么事吧",
    "vi": "Cậu ta không có chuyện gì chứ."
  },
  {
    "idx": 8310,
    "start": "03:52:55,414",
    "end": "03:52:57,014",
    "start_sec": 13975.414,
    "end_sec": 13977.014,
    "zh": "长子提嘴里嘀咕了一句",
    "vi": "Trình Tử Bì lẩm bẩm một câu."
  },
  {
    "idx": 8311,
    "start": "03:52:57,014",
    "end": "03:52:58,834",
    "start_sec": 13977.014,
    "end_sec": 13978.834,
    "zh": "继续弯动起玉回轴网页",
    "vi": "Tiếp tục cuộn trang web."
  },
  {
    "idx": 8312,
    "start": "03:52:58,834",
    "end": "03:53:01,154",
    "start_sec": 13978.834,
    "end_sec": 13981.154,
    "zh": "他对商城一南很感兴趣",
    "vi": "Anh ấy rất hứng thú với cửa hàng."
  },
  {
    "idx": 8313,
    "start": "03:53:01,154",
    "end": "03:53:03,434",
    "start_sec": 13981.154,
    "end_sec": 13983.434,
    "zh": "这卖的东西千奇百怪的",
    "vi": "Những thứ bán ở đây thật kỳ lạ."
  },
  {
    "idx": 8314,
    "start": "03:53:03,434",
    "end": "03:53:06,374",
    "start_sec": 13983.434,
    "end_sec": 13986.374,
    "zh": "最畅销的是这个100公升点的鬼医遏制剂",
    "vi": "Món bán chạy nhất là thuốc ức chế Quỷ Y 100 lít."
  },
  {
    "idx": 8315,
    "start": "03:53:06,374",
    "end": "03:53:08,374",
    "start_sec": 13986.374,
    "end_sec": 13988.374,
    "zh": "拥有遏制鬼医的效果",
    "vi": "Có tác dụng ức chế Quỷ Y."
  },
  {
    "idx": 8316,
    "start": "03:53:08,374",
    "end": "03:53:10,774",
    "start_sec": 13988.374,
    "end_sec": 13990.774,
    "zh": "但长期服用身体会出现抗氧性",
    "vi": "Nhưng dùng lâu dài cơ thể sẽ kháng thuốc."
  },
  {
    "idx": 8317,
    "start": "03:53:10,774",
    "end": "03:53:11,974",
    "start_sec": 13990.774,
    "end_sec": 13991.974,
    "zh": "药效会越来越低",
    "vi": "Hiệu quả thuốc sẽ ngày càng giảm."
  },
  {
    "idx": 8318,
    "start": "03:53:11,974",
    "end": "03:53:15,314",
    "start_sec": 13991.974,
    "end_sec": 13995.314,
    "zh": "看来能对付鬼医的最好办法还是鬼医",
    "vi": "Có vẻ cách tốt nhất để đối phó Quỷ Y vẫn là Quỷ Y."
  },
  {
    "idx": 8319,
    "start": "03:53:15,314",
    "end": "03:53:17,814",
    "start_sec": 13995.314,
    "end_sec": 13997.814,
    "zh": "还有烧死鬼和雷电鬼诱体",
    "vi": "Còn có cả Bùa Hóa Quỷ và Bùa Sét."
  },
  {
    "idx": 8320,
    "start": "03:53:17,814",
    "end": "03:53:19,614",
    "start_sec": 13997.814,
    "end_sec": 13999.614,
    "zh": "售价都是三千公讯点",
    "vi": "Giá đều là ba nghìn điểm."
  },
  {
    "idx": 8321,
    "start": "03:53:19,614",
    "end": "03:53:22,474",
    "start_sec": 13999.614,
    "end_sec": 14002.474,
    "zh": "我草还有概念型轨迹",
    "vi": "Trời ạ, còn có cả Quỹ Đạo Khái Niệm."
  },
  {
    "idx": 8322,
    "start": "03:53:22,474",
    "end": "03:53:26,154",
    "start_sec": 14002.474,
    "end_sec": 14006.154,
    "zh": "能力发动时将会看到事情的成功率",
    "vi": "Khi kích hoạt năng lực sẽ thấy tỷ lệ thành công của sự việc."
  },
  {
    "idx": 8323,
    "start": "03:53:26,154",
    "end": "03:53:28,334",
    "start_sec": 14006.154,
    "end_sec": 14008.334,
    "zh": "售价竟然要十万点公讯",
    "vi": "Giá lại lên tới mười vạn điểm."
  },
  {
    "idx": 8324,
    "start": "03:53:28,334",
    "end": "03:53:29,414",
    "start_sec": 14008.334,
    "end_sec": 14009.414,
    "zh": "我出生入死",
    "vi": "Tôi liều mạng sống."
  },
  {
    "idx": 8325,
    "start": "03:53:29,414",
    "end": "03:53:31,774",
    "start_sec": 14009.414,
    "end_sec": 14011.774,
    "zh": "护送这个古镜也才三千公讯点",
    "vi": "Hộ tống cái gương cổ này cũng chỉ được ba nghìn điểm."
  },
  {
    "idx": 8326,
    "start": "03:53:31,774",
    "end": "03:53:33,234",
    "start_sec": 14011.774,
    "end_sec": 14013.234,
    "zh": "这个概念轨卖这么贵",
    "vi": "Cái Quỹ Đạo Khái Niệm này bán đắt vậy."
  },
  {
    "idx": 8327,
    "start": "03:53:33,234",
    "end": "03:53:35,434",
    "start_sec": 14013.234,
    "end_sec": 14015.434,
    "zh": "不过这个能力确实有点bug",
    "vi": "Nhưng năng lực này đúng là hơi bá đạo."
  },
  {
    "idx": 8328,
    "start": "03:53:35,434",
    "end": "03:53:36,434",
    "start_sec": 14015.434,
    "end_sec": 14016.434,
    "zh": "雷二三说",
    "vi": "Lôi Nhị Tam nói."
  },
  {
    "idx": 8329,
    "start": "03:53:36,434",
    "end": "03:53:38,774",
    "start_sec": 14016.434,
    "end_sec": 14018.774,
    "zh": "完成这个任务可以帮我申请轨迹",
    "vi": "Hoàn thành nhiệm vụ này có thể giúp tôi xin một cái Quỹ Đạo."
  },
  {
    "idx": 8330,
    "start": "03:53:38,774",
    "end": "03:53:42,114",
    "start_sec": 14018.774,
    "end_sec": 14022.114,
    "zh": "应该是那种售价三千公讯点的普通属性轨",
    "vi": "Chắc là loại Quỹ Đạo thuộc tính bình thường giá ba nghìn điểm."
  },
  {
    "idx": 8331,
    "start": "03:53:42,114",
    "end": "03:53:44,094",
    "start_sec": 14022.114,
    "end_sec": 14024.094,
    "zh": "但我的轨面窗也比较特殊",
    "vi": "Nhưng cửa sổ Quỹ Đạo của tôi cũng khá đặc biệt."
  },
  {
    "idx": 8332,
    "start": "03:53:44,094",
    "end": "03:53:45,974",
    "start_sec": 14024.094,
    "end_sec": 14025.974,
    "zh": "普通属性的轨迹没法融合",
    "vi": "Quỹ Đạo thuộc tính bình thường không thể dung hợp."
  },
  {
    "idx": 8333,
    "start": "03:53:45,974",
    "end": "03:53:47,454",
    "start_sec": 14025.974,
    "end_sec": 14027.454,
    "zh": "只会被无效化后吞噬",
    "vi": "Sẽ bị vô hiệu hóa và nuốt chửng."
  },
  {
    "idx": 8334,
    "start": "03:53:47,454",
    "end": "03:53:50,614",
    "start_sec": 14027.454,
    "end_sec": 14030.614,
    "zh": "一般的鬼异想要遏制鬼面窗几乎不太可能",
    "vi": "Quỷ Y thông thường muốn ức chế Quỷ Diện Cửa Sổ gần như không thể."
  },
  {
    "idx": 8335,
    "start": "03:53:50,614",
    "end": "03:53:53,854",
    "start_sec": 14030.614,
    "end_sec": 14033.854,
    "zh": "也就是说我的第二只鬼异得是那种偏概念性的",
    "vi": "Nói cách khác, Quỷ Y thứ hai của tôi phải là loại thiên về khái niệm."
  },
  {
    "idx": 8336,
    "start": "03:53:53,854",
    "end": "03:53:55,574",
    "start_sec": 14033.854,
    "end_sec": 14035.574,
    "zh": "那我得付出多少信息品啊",
    "vi": "Vậy tôi phải trả bao nhiêu điểm thông tin."
  },
  {
    "idx": 8337,
    "start": "03:53:55,574",
    "end": "03:53:56,754",
    "start_sec": 14035.574,
    "end_sec": 14036.754,
    "zh": "换上手机",
    "vi": "Đổi điện thoại."
  },
  {
    "idx": 8338,
    "start": "03:53:56,754",
    "end": "03:53:59,014",
    "start_sec": 14036.754,
    "end_sec": 14039.014,
    "zh": "橙子皮扫兴的走进另一间卧室",
    "vi": "Trần Tử Bì chán nản đi vào phòng ngủ khác."
  },
  {
    "idx": 8339,
    "start": "03:53:59,014",
    "end": "03:54:00,714",
    "start_sec": 14039.014,
    "end_sec": 14040.714,
    "zh": "接着转身走进浴室",
    "vi": "Rồi quay người đi vào phòng tắm."
  },
  {
    "idx": 8340,
    "start": "03:54:00,714",
    "end": "03:54:02,074",
    "start_sec": 14040.714,
    "end_sec": 14042.074,
    "zh": "简单的冲了个澡",
    "vi": "Tắm qua loa."
  },
  {
    "idx": 8341,
    "start": "03:54:02,074",
    "end": "03:54:05,674",
    "start_sec": 14042.074,
    "end_sec": 14045.674,
    "zh": "换上周阳式先给他准备好的衣服",
    "vi": "Thay bộ quần áo mà Chu Dương đã chuẩn bị sẵn cho mình"
  },
  {
    "idx": 8342,
    "start": "03:54:05,674",
    "end": "03:54:07,974",
    "start_sec": 14045.674,
    "end_sec": 14047.974,
    "zh": "橙子皮躺在床上小气了会儿",
    "vi": "Trần Tử Bì nằm trên giường chợp mắt một lát"
  },
  {
    "idx": 8343,
    "start": "03:54:07,974",
    "end": "03:54:10,574",
    "start_sec": 14047.974,
    "end_sec": 14050.574,
    "zh": "因为要时刻提防可能存在的鬼异来换人",
    "vi": "Vì phải luôn đề phòng thế lực quỷ dị có thể đến tráo người"
  },
  {
    "idx": 8344,
    "start": "03:54:10,574",
    "end": "03:54:12,814",
    "start_sec": 14050.574,
    "end_sec": 14052.814,
    "zh": "他基本是半睡半醒度过了一晚上",
    "vi": "Anh ta gần như đã trải qua một đêm trong trạng thái nửa tỉnh nửa mê"
  },
  {
    "idx": 8345,
    "start": "03:54:12,814",
    "end": "03:54:15,274",
    "start_sec": 14052.814,
    "end_sec": 14055.274,
    "zh": "怎么",
    "vi": "Sao thế"
  },
  {
    "idx": 8346,
    "start": "03:54:15,274",
    "end": "03:54:16,254",
    "start_sec": 14055.274,
    "end_sec": 14056.254,
    "zh": "猪公子",
    "vi": "Trư công tử"
  },
  {
    "idx": 8347,
    "start": "03:54:16,254",
    "end": "03:54:17,374",
    "start_sec": 14056.254,
    "end_sec": 14057.374,
    "zh": "给我保护你",
    "vi": "Có tôi bảo vệ bạn"
  },
  {
    "idx": 8348,
    "start": "03:54:17,374",
    "end": "03:54:18,774",
    "start_sec": 14057.374,
    "end_sec": 14058.774,
    "zh": "你晚上还睡不着啊",
    "vi": "Mà ban đêm bạn vẫn không ngủ được sao."
  },
  {
    "idx": 8349,
    "start": "03:54:18,774",
    "end": "03:54:19,274",
    "start_sec": 14058.774,
    "end_sec": 14059.274,
    "zh": "得了吧",
    "vi": "Thôi đi"
  },
  {
    "idx": 8350,
    "start": "03:54:19,274",
    "end": "03:54:21,554",
    "start_sec": 14059.274,
    "end_sec": 14061.554,
    "zh": "现如今哪还有什么安稳觉",
    "vi": "Thời buổi này làm gì còn giấc ngủ nào yên bình nữa"
  },
  {
    "idx": 8351,
    "start": "03:54:21,554",
    "end": "03:54:22,474",
    "start_sec": 14061.554,
    "end_sec": 14062.474,
    "zh": "走",
    "vi": "Đi thôi"
  },
  {
    "idx": 8352,
    "start": "03:54:22,474",
    "end": "03:54:23,754",
    "start_sec": 14062.474,
    "end_sec": 14063.754,
    "zh": "去一楼吃饭吧",
    "vi": "Xuống tầng một ăn cơm nào"
  },
  {
    "idx": 8353,
    "start": "03:54:23,754",
    "end": "03:54:25,934",
    "start_sec": 14063.754,
    "end_sec": 14065.934,
    "zh": "两人相继走出房门",
    "vi": "Hai người lần lượt bước ra khỏi phòng"
  },
  {
    "idx": 8354,
    "start": "03:54:25,934",
    "end": "03:54:27,534",
    "start_sec": 14065.934,
    "end_sec": 14067.534,
    "zh": "沿着电梯口位置走进",
    "vi": "Đi về phía cửa thang máy"
  },
  {
    "idx": 8355,
    "start": "03:54:27,534",
    "end": "03:54:30,294",
    "start_sec": 14067.534,
    "end_sec": 14070.294,
    "zh": "下脚在电梯里碰到026和徐天志",
    "vi": "Khi bước vào thang máy thì gặp 026 và Từ Thiên Chí"
  },
  {
    "idx": 8356,
    "start": "03:54:30,294",
    "end": "03:54:31,194",
    "start_sec": 14070.294,
    "end_sec": 14071.194,
    "zh": "出于警惕",
    "vi": "Để cảnh giác"
  },
  {
    "idx": 8357,
    "start": "03:54:31,194",
    "end": "03:54:33,754",
    "start_sec": 14071.194,
    "end_sec": 14073.754,
    "zh": "橙子皮也对二人使用了鬼面疮",
    "vi": "Trần Tử Bì cũng dùng Quỷ Diện Sang lên hai người họ"
  },
  {
    "idx": 8358,
    "start": "03:54:33,754",
    "end": "03:54:35,134",
    "start_sec": 14073.754,
    "end_sec": 14075.134,
    "zh": "好像没有任何反应",
    "vi": "Dường như không có bất kỳ phản ứng nào"
  },
  {
    "idx": 8359,
    "start": "03:54:35,134",
    "end": "03:54:37,354",
    "start_sec": 14075.134,
    "end_sec": 14077.354,
    "zh": "看来二楼的确要安全点",
    "vi": "Xem ra tầng hai thực sự an toàn hơn một chút"
  },
  {
    "idx": 8360,
    "start": "03:54:37,354",
    "end": "03:54:38,894",
    "start_sec": 14077.354,
    "end_sec": 14078.894,
    "zh": "023说的不错",
    "vi": "Những gì 023 nói không sai"
  },
  {
    "idx": 8361,
    "start": "03:54:38,894",
    "end": "03:54:41,714",
    "start_sec": 14078.894,
    "end_sec": 14081.714,
    "zh": "估计一楼的一大众人更难分辨",
    "vi": "Ước chừng đám đông ở tầng một sẽ càng khó phân biệt hơn"
  },
  {
    "idx": 8362,
    "start": "03:54:41,714",
    "end": "03:54:42,334",
    "start_sec": 14081.714,
    "end_sec": 14082.334,
    "zh": "喂",
    "vi": "Này"
  },
  {
    "idx": 8363,
    "start": "03:54:42,334",
    "end": "03:54:44,794",
    "start_sec": 14082.334,
    "end_sec": 14084.794,
    "zh": "你嫂子的诡异是不是没那么简单",
    "vi": "Quỷ dị của chị dâu bạn có phải không hề đơn giản như vậy không."
  },
  {
    "idx": 8364,
    "start": "03:54:44,794",
    "end": "03:54:45,354",
    "start_sec": 14084.794,
    "end_sec": 14085.354,
    "zh": "哦",
    "vi": "Ồ"
  },
  {
    "idx": 8365,
    "start": "03:54:45,354",
    "end": "03:54:46,394",
    "start_sec": 14085.354,
    "end_sec": 14086.394,
    "zh": "什么意思啊",
    "vi": "Ý bạn là sao."
  },
  {
    "idx": 8366,
    "start": "03:54:46,394",
    "end": "03:54:49,314",
    "start_sec": 14086.394,
    "end_sec": 14089.314,
    "zh": "我做了三次任务才从零四二晋升到零二六",
    "vi": "Tôi phải làm ba nhiệm vụ mới thăng từ 042 lên 026"
  },
  {
    "idx": 8367,
    "start": "03:54:49,314",
    "end": "03:54:51,254",
    "start_sec": 14089.314,
    "end_sec": 14091.254,
    "zh": "可你居然一开始就定位零二七",
    "vi": "Nhưng bạn lại được định vị là 027 ngay từ đầu"
  },
  {
    "idx": 8368,
    "start": "03:54:51,254",
    "end": "03:54:53,334",
    "start_sec": 14091.254,
    "end_sec": 14093.334,
    "zh": "你的诡异真的是惨死诡异",
    "vi": "Quỷ dị của bạn thực sự là quỷ dị thảm tử sao."
  },
  {
    "idx": 8369,
    "start": "03:54:53,334",
    "end": "03:54:54,274",
    "start_sec": 14093.334,
    "end_sec": 14094.274,
    "zh": "呵呵",
    "vi": "Ha ha"
  },
  {
    "idx": 8370,
    "start": "03:54:54,274",
    "end": "03:54:55,733",
    "start_sec": 14094.274,
    "end_sec": 14095.733,
    "zh": "没搞懂你在说什么电梯门打开四人不欢而散或许是因为早上用餐点对着活跃的人高达百分很多人都坐在一桌结成一小派临桌之间也没有交谈",
    "vi": "Tôi không hiểu bạn đang nói gì"
  },
  {
    "idx": 8370,
    "start": "03:54:55,733",
    "end": "03:54:58,233",
    "start_sec": 14095.733,
    "end_sec": 14098.233,
    "zh": "没搞懂你在说什么电梯门打开四人不欢而散或许是因为早上用餐点对着活跃的人高达百分很多人都坐在一桌结成一小派临桌之间也没有交谈",
    "vi": "Cửa thang máy mở ra, bốn người giải tán trong không vui"
  },
  {
    "idx": 8370,
    "start": "03:54:58,233",
    "end": "03:55:02,192",
    "start_sec": 14098.233,
    "end_sec": 14102.192,
    "zh": "没搞懂你在说什么电梯门打开四人不欢而散或许是因为早上用餐点对着活跃的人高达百分很多人都坐在一桌结成一小派临桌之间也没有交谈",
    "vi": "Có lẽ vì số người hoạt động vào giờ ăn sáng lên đến tối đa, nhiều người ngồi chung"
  },
  {
    "idx": 8370,
    "start": "03:55:02,192",
    "end": "03:55:06,151",
    "start_sec": 14102.192,
    "end_sec": 14106.151,
    "zh": "没搞懂你在说什么电梯门打开四人不欢而散或许是因为早上用餐点对着活跃的人高达百分很多人都坐在一桌结成一小派临桌之间也没有交谈",
    "vi": "một bàn tạo thành các nhóm nhỏ, giữa các bàn bên cạnh cũng không hề trò chuyện với nhau"
  },
  {
    "idx": 8371,
    "start": "03:55:06,151",
    "end": "03:55:08,511",
    "start_sec": 14106.151,
    "end_sec": 14108.511,
    "zh": "看来是船上有能变成人的诡异之事",
    "vi": "Có vẻ như chuyện quỷ dị có thể biến thành người trên tàu"
  },
  {
    "idx": 8372,
    "start": "03:55:08,511",
    "end": "03:55:09,611",
    "start_sec": 14108.511,
    "end_sec": 14109.611,
    "zh": "已经传开了",
    "vi": "đã lan truyền ra ngoài rồi."
  },
  {
    "idx": 8373,
    "start": "03:55:09,611",
    "end": "03:55:10,111",
    "start_sec": 14109.611,
    "end_sec": 14110.111,
    "zh": "对了",
    "vi": "Đúng rồi"
  },
  {
    "idx": 8374,
    "start": "03:55:10,111",
    "end": "03:55:10,711",
    "start_sec": 14110.111,
    "end_sec": 14110.711,
    "zh": "周公子",
    "vi": "công tử Chu"
  },
  {
    "idx": 8375,
    "start": "03:55:10,711",
    "end": "03:55:11,971",
    "start_sec": 14110.711,
    "end_sec": 14111.971,
    "zh": "这个统一用餐点",
    "vi": "ở khu ăn uống tập trung này"
  },
  {
    "idx": 8376,
    "start": "03:55:11,971",
    "end": "03:55:13,291",
    "start_sec": 14111.971,
    "end_sec": 14113.291,
    "zh": "你家老头不来吗",
    "vi": "ông già nhà bạn không đến sao."
  },
  {
    "idx": 8377,
    "start": "03:55:13,291",
    "end": "03:55:13,511",
    "start_sec": 14113.291,
    "end_sec": 14113.511,
    "zh": "他",
    "vi": "Ông ấy ư"
  },
  {
    "idx": 8378,
    "start": "03:55:13,511",
    "end": "03:55:15,291",
    "start_sec": 14113.511,
    "end_sec": 14115.291,
    "zh": "有人专门给他送饭",
    "vi": "có người mang cơm riêng cho ông ấy rồi."
  },
  {
    "idx": 8379,
    "start": "03:55:15,291",
    "end": "03:55:16,151",
    "start_sec": 14115.291,
    "end_sec": 14116.151,
    "zh": "周扬低着头",
    "vi": "Chu Dương cúi đầu"
  },
  {
    "idx": 8380,
    "start": "03:55:16,151",
    "end": "03:55:17,831",
    "start_sec": 14116.151,
    "end_sec": 14117.831,
    "zh": "手里拿着食物也不吃",
    "vi": "tay cầm đồ ăn nhưng không ăn"
  },
  {
    "idx": 8381,
    "start": "03:55:17,831",
    "end": "03:55:18,991",
    "start_sec": 14117.831,
    "end_sec": 14118.991,
    "zh": "似乎没有什么胃口",
    "vi": "dường như không có cảm giác thèm ăn."
  },
  {
    "idx": 8382,
    "start": "03:55:18,991",
    "end": "03:55:21,311",
    "start_sec": 14118.991,
    "end_sec": 14121.311,
    "zh": "床子里无需的打亮着其他餐桌",
    "vi": "Trần Tử Vô vô thức quan sát các bàn ăn khác"
  },
  {
    "idx": 8383,
    "start": "03:55:21,311",
    "end": "03:55:22,191",
    "start_sec": 14121.311,
    "end_sec": 14122.191,
    "zh": "在角落中",
    "vi": "ở trong góc"
  },
  {
    "idx": 8384,
    "start": "03:55:22,191",
    "end": "03:55:22,931",
    "start_sec": 14122.191,
    "end_sec": 14122.931,
    "zh": "一个少女",
    "vi": "một cô gái trẻ"
  },
  {
    "idx": 8385,
    "start": "03:55:22,931",
    "end": "03:55:24,191",
    "start_sec": 14122.931,
    "end_sec": 14124.191,
    "zh": "从无意的鸽章起网",
    "vi": "cũng đang vô tình nhìn sang đây."
  },
  {
    "idx": 8386,
    "start": "03:55:24,991",
    "end": "03:55:27,451",
    "start_sec": 14124.991,
    "end_sec": 14127.451,
    "zh": "这是电梯门再次打开",
    "vi": "Lúc này cửa thang máy lại mở ra"
  },
  {
    "idx": 8387,
    "start": "03:55:27,451",
    "end": "03:55:29,271",
    "start_sec": 14127.451,
    "end_sec": 14129.271,
    "zh": "023表着想先走出来",
    "vi": "số 023 tỏ vẻ sốt ruột bước ra trước"
  },
  {
    "idx": 8388,
    "start": "03:55:29,271",
    "end": "03:55:30,431",
    "start_sec": 14129.271,
    "end_sec": 14130.431,
    "zh": "看了从此第一眼",
    "vi": "liếc nhìn Trần Tử Vô một cái"
  },
  {
    "idx": 8389,
    "start": "03:55:30,431",
    "end": "03:55:32,071",
    "start_sec": 14130.431,
    "end_sec": 14132.071,
    "zh": "而后静止走向026",
    "vi": "sau đó đi thẳng về phía số 026."
  },
  {
    "idx": 8390,
    "start": "03:55:32,071",
    "end": "03:55:34,491",
    "start_sec": 14132.071,
    "end_sec": 14134.491,
    "zh": "我说026该走了",
    "vi": "Tôi nói này số 026, phải đi thôi"
  },
  {
    "idx": 8391,
    "start": "03:55:34,491",
    "end": "03:55:36,891",
    "start_sec": 14134.491,
    "end_sec": 14136.891,
    "zh": "曙光号已经停留一天了",
    "vi": "tàu Bình Minh đã dừng lại một ngày rồi."
  },
  {
    "idx": 8392,
    "start": "03:55:36,891",
    "end": "03:55:37,371",
    "start_sec": 14136.891,
    "end_sec": 14137.371,
    "zh": "再等等",
    "vi": "Đợi thêm chút nữa"
  },
  {
    "idx": 8393,
    "start": "03:55:37,371",
    "end": "03:55:38,511",
    "start_sec": 14137.371,
    "end_sec": 14138.511,
    "zh": "等你妈啊等",
    "vi": "Đợi cái gì mà đợi"
  },
  {
    "idx": 8394,
    "start": "03:55:38,511",
    "end": "03:55:40,931",
    "start_sec": 14138.511,
    "end_sec": 14140.931,
    "zh": "你那个堂弟徐东来死了就死了",
    "vi": "cậu em họ Từ Đông Lai của bạn chết thì cũng chết rồi"
  },
  {
    "idx": 8395,
    "start": "03:55:40,931",
    "end": "03:55:41,171",
    "start_sec": 14140.931,
    "end_sec": 14141.171,
    "zh": "等",
    "vi": "đợi"
  },
  {
    "idx": 8396,
    "start": "03:55:41,171",
    "end": "03:55:42,231",
    "start_sec": 14141.171,
    "end_sec": 14142.231,
    "zh": "能等到什么",
    "vi": "thì đợi được cái gì chứ."
  },
  {
    "idx": 8397,
    "start": "03:55:42,231",
    "end": "03:55:44,011",
    "start_sec": 14142.231,
    "end_sec": 14144.011,
    "zh": "我不相信027的话",
    "vi": "Tôi không tin lời của số 027"
  },
  {
    "idx": 8398,
    "start": "03:55:44,011",
    "end": "03:55:45,371",
    "start_sec": 14144.011,
    "end_sec": 14145.371,
    "zh": "不管你信不信",
    "vi": "bất kể bạn có tin hay không"
  },
  {
    "idx": 8399,
    "start": "03:55:45,371",
    "end": "03:55:46,791",
    "start_sec": 14145.371,
    "end_sec": 14146.791,
    "zh": "今天中午要开船",
    "vi": "trưa nay tàu sẽ chạy"
  },
  {
    "idx": 8400,
    "start": "03:55:46,791",
    "end": "03:55:47,771",
    "start_sec": 14146.791,
    "end_sec": 14147.771,
    "zh": "再不动身",
    "vi": "nếu còn không khởi hành"
  },
  {
    "idx": 8401,
    "start": "03:55:47,771",
    "end": "03:55:49,471",
    "start_sec": 14147.771,
    "end_sec": 14149.471,
    "zh": "你就等着被组织处罚",
    "vi": "Cứ đợi tổ chức kỷ luật bạn đi."
  },
  {
    "idx": 8402,
    "start": "03:55:49,471",
    "end": "03:55:51,451",
    "start_sec": 14149.471,
    "end_sec": 14151.451,
    "zh": "023骂完转身就走",
    "vi": "023 mắng xong liền quay lưng bỏ đi."
  },
  {
    "idx": 8403,
    "start": "03:55:51,451",
    "end": "03:55:53,091",
    "start_sec": 14151.451,
    "end_sec": 14153.091,
    "zh": "不给026留一点面子",
    "vi": "Không nể mặt 026 chút nào."
  },
  {
    "idx": 8404,
    "start": "03:55:53,091",
    "end": "03:55:53,691",
    "start_sec": 14153.091,
    "end_sec": 14153.691,
    "zh": "徐叔",
    "vi": "Chú Từ."
  },
  {
    "idx": 8405,
    "start": "03:55:53,691",
    "end": "03:55:54,671",
    "start_sec": 14153.691,
    "end_sec": 14154.671,
    "zh": "这怎么办",
    "vi": "Giờ phải làm sao đây."
  },
  {
    "idx": 8406,
    "start": "03:55:54,671",
    "end": "03:55:57,171",
    "start_sec": 14154.671,
    "end_sec": 14157.171,
    "zh": "哎 算了 东来那孩子",
    "vi": "Thôi bỏ đi, thằng bé Đông Lai đó."
  },
  {
    "idx": 8407,
    "start": "03:55:57,171",
    "end": "03:56:01,731",
    "start_sec": 14157.171,
    "end_sec": 14161.731,
    "zh": "你 你不是我弟弟",
    "vi": "Bạn không phải là em trai tôi."
  },
  {
    "idx": 8408,
    "start": "03:56:01,731",
    "end": "03:56:03,351",
    "start_sec": 14161.731,
    "end_sec": 14163.351,
    "zh": "我弟弟是用左手吃饭的",
    "vi": "Em trai tôi dùng tay trái để ăn cơm."
  },
  {
    "idx": 8409,
    "start": "03:56:03,351",
    "end": "03:56:04,291",
    "start_sec": 14163.351,
    "end_sec": 14164.291,
    "zh": "你到底是谁",
    "vi": "Rốt cuộc bạn là ai."
  },
  {
    "idx": 8410,
    "start": "03:56:04,291",
    "end": "03:56:06,751",
    "start_sec": 14164.291,
    "end_sec": 14166.751,
    "zh": "你说什么 谁是你弟弟",
    "vi": "Bạn nói gì vậy, ai là em trai bạn."
  },
  {
    "idx": 8411,
    "start": "03:56:06,751",
    "end": "03:56:08,131",
    "start_sec": 14166.751,
    "end_sec": 14168.131,
    "zh": "你绝对不是我弟弟",
    "vi": "Bạn chắc chắn không phải em trai tôi."
  },
  {
    "idx": 8412,
    "start": "03:56:08,131",
    "end": "03:56:09,171",
    "start_sec": 14168.131,
    "end_sec": 14169.171,
    "zh": "他吃饭用左手",
    "vi": "Nó ăn cơm bằng tay trái."
  },
  {
    "idx": 8413,
    "start": "03:56:09,171",
    "end": "03:56:11,331",
    "start_sec": 14169.171,
    "end_sec": 14171.331,
    "zh": "每次吃饭都会把青椒塞到我碗里",
    "vi": "Lần nào ăn cơm cũng gắp ớt chuông vào bát tôi."
  },
  {
    "idx": 8414,
    "start": "03:56:11,331",
    "end": "03:56:12,251",
    "start_sec": 14171.331,
    "end_sec": 14172.251,
    "zh": "然后喊我解释",
    "vi": "Rồi bắt tôi phải giải thích."
  },
  {
    "idx": 8415,
    "start": "03:56:12,251",
    "end": "03:56:13,711",
    "start_sec": 14172.251,
    "end_sec": 14173.711,
    "zh": "但是你 从刚刚过来",
    "vi": "Nhưng bạn, từ lúc tới đây."
  },
  {
    "idx": 8416,
    "start": "03:56:13,711",
    "end": "03:56:14,471",
    "start_sec": 14173.711,
    "end_sec": 14174.471,
    "zh": "就只是吃饭",
    "vi": "Chỉ biết ăn cơm thôi."
  },
  {
    "idx": 8417,
    "start": "03:56:14,471",
    "end": "03:56:15,331",
    "start_sec": 14174.471,
    "end_sec": 14175.331,
    "zh": "我感觉不到",
    "vi": "Tôi không cảm nhận được."
  },
  {
    "idx": 8418,
    "start": "03:56:15,331",
    "end": "03:56:16,811",
    "start_sec": 14175.331,
    "end_sec": 14176.811,
    "zh": "我们之间有任何的联系",
    "vi": "Giữa chúng ta có bất kỳ mối liên hệ nào."
  },
  {
    "idx": 8419,
    "start": "03:56:16,811",
    "end": "03:56:18,431",
    "start_sec": 14176.811,
    "end_sec": 14178.431,
    "zh": "不是 我都说了",
    "vi": "Không, tôi đã nói rồi."
  },
  {
    "idx": 8420,
    "start": "03:56:18,431",
    "end": "03:56:19,651",
    "start_sec": 14178.431,
    "end_sec": 14179.651,
    "zh": "我不是你弟弟",
    "vi": "Tôi không phải em trai bạn."
  },
  {
    "idx": 8421,
    "start": "03:56:19,651",
    "end": "03:56:21,571",
    "start_sec": 14179.651,
    "end_sec": 14181.571,
    "zh": "你才是有问题的人吧",
    "vi": "Bạn mới là người có vấn đề thì có."
  },
  {
    "idx": 8422,
    "start": "03:56:21,571",
    "end": "03:56:22,971",
    "start_sec": 14181.571,
    "end_sec": 14182.971,
    "zh": "零二三四的口音",
    "vi": "0234 cất giọng."
  },
  {
    "idx": 8423,
    "start": "03:56:22,971",
    "end": "03:56:24,211",
    "start_sec": 14182.971,
    "end_sec": 14184.211,
    "zh": "大步朝二人走进",
    "vi": "Bước những bước dài tiến về phía hai người."
  },
  {
    "idx": 8424,
    "start": "03:56:24,211",
    "end": "03:56:26,131",
    "start_sec": 14184.211,
    "end_sec": 14186.131,
    "zh": "有人认识这对姐弟吗",
    "vi": "Có ai quen cặp chị em này không."
  },
  {
    "idx": 8425,
    "start": "03:56:26,131",
    "end": "03:56:27,511",
    "start_sec": 14186.131,
    "end_sec": 14187.511,
    "zh": "最好出来澄清一下",
    "vi": "Tốt nhất nên ra làm rõ đi."
  },
  {
    "idx": 8426,
    "start": "03:56:27,511",
    "end": "03:56:28,451",
    "start_sec": 14187.511,
    "end_sec": 14188.451,
    "zh": "哪个说的对",
    "vi": "Ai nói đúng đây."
  },
  {
    "idx": 8427,
    "start": "03:56:28,451",
    "end": "03:56:29,191",
    "start_sec": 14188.451,
    "end_sec": 14189.191,
    "zh": "我知道",
    "vi": "Tôi biết."
  },
  {
    "idx": 8428,
    "start": "03:56:29,191",
    "end": "03:56:30,211",
    "start_sec": 14189.191,
    "end_sec": 14190.211,
    "zh": "这个小弟弟",
    "vi": "Cậu em trai này."
  },
  {
    "idx": 8429,
    "start": "03:56:30,211",
    "end": "03:56:31,851",
    "start_sec": 14190.211,
    "end_sec": 14191.851,
    "zh": "当时是自己一个人上船的",
    "vi": "Lúc đó là tự mình lên tàu một mình."
  },
  {
    "idx": 8430,
    "start": "03:56:31,851",
    "end": "03:56:33,651",
    "start_sec": 14191.851,
    "end_sec": 14193.651,
    "zh": "所以是这个女孩说谎了",
    "vi": "Vậy là cô gái này đã nói dối."
  },
  {
    "idx": 8431,
    "start": "03:56:33,651",
    "end": "03:56:34,231",
    "start_sec": 14193.651,
    "end_sec": 14194.231,
    "zh": "对",
    "vi": "Ừm"
  },
  {
    "idx": 8432,
    "start": "03:56:34,231",
    "end": "03:56:34,911",
    "start_sec": 14194.231,
    "end_sec": 14194.911,
    "zh": "我也看到",
    "vi": "Tôi cũng thấy rồi"
  },
  {
    "idx": 8433,
    "start": "03:56:34,911",
    "end": "03:56:35,591",
    "start_sec": 14194.911,
    "end_sec": 14195.591,
    "zh": "我也是",
    "vi": "Tôi cũng vậy"
  },
  {
    "idx": 8434,
    "start": "03:56:35,591",
    "end": "03:56:36,631",
    "start_sec": 14195.591,
    "end_sec": 14196.631,
    "zh": "一瞬间",
    "vi": "Trong khoảnh khắc"
  },
  {
    "idx": 8435,
    "start": "03:56:36,631",
    "end": "03:56:38,451",
    "start_sec": 14196.631,
    "end_sec": 14198.451,
    "zh": "所有人看向少女的眼神",
    "vi": "Ánh mắt mọi người nhìn cô gái"
  },
  {
    "idx": 8436,
    "start": "03:56:38,451",
    "end": "03:56:39,411",
    "start_sec": 14198.451,
    "end_sec": 14199.411,
    "zh": "都变得不友善",
    "vi": "Đều trở nên không thân thiện"
  },
  {
    "idx": 8437,
    "start": "03:56:39,411",
    "end": "03:56:40,031",
    "start_sec": 14199.411,
    "end_sec": 14200.031,
    "zh": "你",
    "vi": "Anh"
  },
  {
    "idx": 8438,
    "start": "03:56:40,031",
    "end": "03:56:41,511",
    "start_sec": 14200.031,
    "end_sec": 14201.511,
    "zh": "你们都是骗子",
    "vi": "Các người đều là kẻ lừa đảo"
  },
  {
    "idx": 8439,
    "start": "03:56:41,511",
    "end": "03:56:42,651",
    "start_sec": 14201.511,
    "end_sec": 14202.651,
    "zh": "我根本不认识你们",
    "vi": "Tôi hoàn toàn không quen biết các người"
  },
  {
    "idx": 8440,
    "start": "03:56:42,651",
    "end": "03:56:43,651",
    "start_sec": 14202.651,
    "end_sec": 14203.651,
    "zh": "顾叔叔",
    "vi": "Chú Cố"
  },
  {
    "idx": 8441,
    "start": "03:56:43,651",
    "end": "03:56:44,931",
    "start_sec": 14203.651,
    "end_sec": 14204.931,
    "zh": "我是夏桃红啊",
    "vi": "Tôi là Hạ Đào Hồng đây"
  },
  {
    "idx": 8442,
    "start": "03:56:44,931",
    "end": "03:56:45,711",
    "start_sec": 14204.931,
    "end_sec": 14205.711,
    "zh": "您认识我的吧",
    "vi": "Ngài nhớ tôi chứ"
  },
  {
    "idx": 8443,
    "start": "03:56:45,711",
    "end": "03:56:47,091",
    "start_sec": 14205.711,
    "end_sec": 14207.091,
    "zh": "我爸爸还给您做过法",
    "vi": "Bố tôi còn từng làm pháp sự cho ngài"
  },
  {
    "idx": 8444,
    "start": "03:56:47,091",
    "end": "03:56:48,571",
    "start_sec": 14207.091,
    "end_sec": 14208.571,
    "zh": "你瞎说什么呢",
    "vi": "Cô nói bậy gì vậy"
  },
  {
    "idx": 8445,
    "start": "03:56:48,571",
    "end": "03:56:49,871",
    "start_sec": 14208.571,
    "end_sec": 14209.871,
    "zh": "不认识不认识",
    "vi": "Không quen, không quen"
  },
  {
    "idx": 8446,
    "start": "03:56:49,871",
    "end": "03:56:50,511",
    "start_sec": 14209.871,
    "end_sec": 14210.511,
    "zh": "你看",
    "vi": "Nhìn xem"
  },
  {
    "idx": 8447,
    "start": "03:56:50,511",
    "end": "03:56:51,671",
    "start_sec": 14210.511,
    "end_sec": 14211.671,
    "zh": "我都说了",
    "vi": "Tôi đã nói rồi mà"
  },
  {
    "idx": 8448,
    "start": "03:56:51,671",
    "end": "03:56:52,911",
    "start_sec": 14211.671,
    "end_sec": 14212.911,
    "zh": "你才是骗子",
    "vi": "Anh mới là kẻ lừa đảo"
  },
  {
    "idx": 8449,
    "start": "03:56:52,911",
    "end": "03:56:53,671",
    "start_sec": 14212.911,
    "end_sec": 14213.671,
    "zh": "领导",
    "vi": "Lãnh đạo"
  },
  {
    "idx": 8450,
    "start": "03:56:53,671",
    "end": "03:56:55,791",
    "start_sec": 14213.671,
    "end_sec": 14215.791,
    "zh": "请立刻处置这个骗子",
    "vi": "Xin hãy xử lý kẻ lừa đảo này ngay lập tức"
  },
  {
    "idx": 8451,
    "start": "03:56:55,791",
    "end": "03:56:57,851",
    "start_sec": 14215.791,
    "end_sec": 14217.851,
    "zh": "我怀疑他不是人啊",
    "vi": "Tôi nghi ngờ hắn không phải người"
  },
  {
    "idx": 8452,
    "start": "03:56:57,851",
    "end": "03:56:59,651",
    "start_sec": 14217.851,
    "end_sec": 14219.651,
    "zh": "027你怎么看",
    "vi": "027, anh nghĩ sao"
  },
  {
    "idx": 8453,
    "start": "03:56:59,651",
    "end": "03:57:02,231",
    "start_sec": 14219.651,
    "end_sec": 14222.231,
    "zh": "我觉得谁的话都不能信",
    "vi": "Tôi nghĩ không thể tin lời ai cả"
  },
  {
    "idx": 8454,
    "start": "03:57:02,231",
    "end": "03:57:03,491",
    "start_sec": 14222.231,
    "end_sec": 14223.491,
    "zh": "都可能是假的",
    "vi": "Tất cả đều có thể là giả"
  },
  {
    "idx": 8455,
    "start": "03:57:03,491",
    "end": "03:57:05,391",
    "start_sec": 14223.491,
    "end_sec": 14225.391,
    "zh": "要不全都控制起来",
    "vi": "Hay là khống chế tất cả lại đi"
  },
  {
    "idx": 8456,
    "start": "03:57:05,391",
    "end": "03:57:06,331",
    "start_sec": 14225.391,
    "end_sec": 14226.331,
    "zh": "听到这句话",
    "vi": "Nghe thấy câu này"
  },
  {
    "idx": 8457,
    "start": "03:57:06,331",
    "end": "03:57:08,411",
    "start_sec": 14226.331,
    "end_sec": 14228.411,
    "zh": "所有人的声音顿时停歇下来",
    "vi": "Tất cả mọi người đột nhiên im bặt"
  },
  {
    "idx": 8458,
    "start": "03:57:08,411",
    "end": "03:57:10,151",
    "start_sec": 14228.411,
    "end_sec": 14230.151,
    "zh": "他们惊讶的太像橙子皮",
    "vi": "Họ ngạc nhiên vì quá giống Trần Tử Bì"
  },
  {
    "idx": 8459,
    "start": "03:57:10,151",
    "end": "03:57:12,191",
    "start_sec": 14230.151,
    "end_sec": 14232.191,
    "zh": "就连小女孩也有些意外",
    "vi": "Ngay cả cô bé cũng hơi bất ngờ"
  },
  {
    "idx": 8460,
    "start": "03:57:12,191",
    "end": "03:57:13,791",
    "start_sec": 14232.191,
    "end_sec": 14233.791,
    "zh": "他没想到还会有人帮自己",
    "vi": "Cô bé không ngờ còn có người giúp mình"
  },
  {
    "idx": 8461,
    "start": "03:57:13,791",
    "end": "03:57:15,771",
    "start_sec": 14233.791,
    "end_sec": 14235.771,
    "zh": "那好就按你说的办",
    "vi": "Được rồi, cứ làm theo lời anh đi."
  },
  {
    "idx": 8462,
    "start": "03:57:15,771",
    "end": "03:57:17,191",
    "start_sec": 14235.771,
    "end_sec": 14237.191,
    "zh": "全都抓起来",
    "vi": "Bắt hết tất cả lại."
  },
  {
    "idx": 8463,
    "start": "03:57:17,191",
    "end": "03:57:18,771",
    "start_sec": 14237.191,
    "end_sec": 14238.771,
    "zh": "一个不留",
    "vi": "Không chừa một ai."
  },
  {
    "idx": 8464,
    "start": "03:57:18,771",
    "end": "03:57:22,051",
    "start_sec": 14238.771,
    "end_sec": 14242.051,
    "zh": "那就全部控制起来",
    "vi": "Vậy thì khống chế toàn bộ bọn họ."
  },
  {
    "idx": 8465,
    "start": "03:57:22,051",
    "end": "03:57:25,131",
    "start_sec": 14242.051,
    "end_sec": 14245.131,
    "zh": "下一个白眼鬼一脸朝着小男孩",
    "vi": "Tiếp theo, một con quỷ mắt trắng hướng mặt về phía cậu bé."
  },
  {
    "idx": 8466,
    "start": "03:57:25,131",
    "end": "03:57:26,651",
    "start_sec": 14245.131,
    "end_sec": 14246.651,
    "zh": "一复合的三五规矩",
    "vi": "Phù hợp với quy tắc ba năm."
  },
  {
    "idx": 8467,
    "start": "03:57:26,651",
    "end": "03:57:27,771",
    "start_sec": 14246.651,
    "end_sec": 14247.771,
    "zh": "零二七",
    "vi": "Không hai bảy."
  },
  {
    "idx": 8468,
    "start": "03:57:27,771",
    "end": "03:57:28,431",
    "start_sec": 14247.771,
    "end_sec": 14248.431,
    "zh": "真上",
    "vi": "Lên thật sao."
  },
  {
    "idx": 8469,
    "start": "03:57:28,431",
    "end": "03:57:30,231",
    "start_sec": 14248.431,
    "end_sec": 14250.231,
    "zh": "长子皮看了一眼周扬",
    "vi": "Trần Tử Bì liếc nhìn Chu Dương một cái."
  },
  {
    "idx": 8470,
    "start": "03:57:30,231",
    "end": "03:57:31,991",
    "start_sec": 14250.231,
    "end_sec": 14251.991,
    "zh": "我马上来",
    "vi": "Tôi đến ngay đây."
  },
  {
    "idx": 8471,
    "start": "03:57:31,991",
    "end": "03:57:34,091",
    "start_sec": 14251.991,
    "end_sec": 14254.091,
    "zh": "一楼大厅又尽头",
    "vi": "Phía cuối sảnh tầng một."
  },
  {
    "idx": 8472,
    "start": "03:57:34,091",
    "end": "03:57:35,551",
    "start_sec": 14254.091,
    "end_sec": 14255.551,
    "zh": "是曙光捍卫家的家",
    "vi": "Là nhà của người bảo vệ bình minh."
  },
  {
    "idx": 8473,
    "start": "03:57:35,551",
    "end": "03:57:37,991",
    "start_sec": 14255.551,
    "end_sec": 14257.991,
    "zh": "晨时的天还带着血月的红色",
    "vi": "Bầu trời lúc bình minh vẫn còn mang sắc đỏ của trăng máu."
  },
  {
    "idx": 8474,
    "start": "03:57:37,991",
    "end": "03:57:40,031",
    "start_sec": 14257.991,
    "end_sec": 14260.031,
    "zh": "你们这群狗东西",
    "vi": "Lũ chó má các người."
  },
  {
    "idx": 8475,
    "start": "03:57:40,031",
    "end": "03:57:41,391",
    "start_sec": 14260.031,
    "end_sec": 14261.391,
    "zh": "以为学了点人话",
    "vi": "Tưởng học được vài tiếng người."
  },
  {
    "idx": 8476,
    "start": "03:57:41,391",
    "end": "03:57:42,631",
    "start_sec": 14261.391,
    "end_sec": 14262.631,
    "zh": "就能乱得了局面",
    "vi": "Là có thể làm loạn được tình thế."
  },
  {
    "idx": 8477,
    "start": "03:57:42,631",
    "end": "03:57:43,591",
    "start_sec": 14262.631,
    "end_sec": 14263.591,
    "zh": "零二七",
    "vi": "Không hai bảy."
  },
  {
    "idx": 8478,
    "start": "03:57:43,591",
    "end": "03:57:44,151",
    "start_sec": 14263.591,
    "end_sec": 14264.151,
    "zh": "说吧",
    "vi": "Nói đi."
  },
  {
    "idx": 8479,
    "start": "03:57:44,151",
    "end": "03:57:45,631",
    "start_sec": 14264.151,
    "end_sec": 14265.631,
    "zh": "这里面谁才是真的",
    "vi": "Trong số này ai mới là thật."
  },
  {
    "idx": 8480,
    "start": "03:57:45,631",
    "end": "03:57:47,051",
    "start_sec": 14265.631,
    "end_sec": 14267.051,
    "zh": "这个女孩",
    "vi": "Cô bé này."
  },
  {
    "idx": 8481,
    "start": "03:57:47,051",
    "end": "03:57:48,531",
    "start_sec": 14267.051,
    "end_sec": 14268.531,
    "zh": "其他的",
    "vi": "Những người khác."
  },
  {
    "idx": 8482,
    "start": "03:57:48,531",
    "end": "03:57:49,891",
    "start_sec": 14268.531,
    "end_sec": 14269.891,
    "zh": "好好好",
    "vi": "Tốt tốt tốt."
  },
  {
    "idx": 8483,
    "start": "03:57:49,891",
    "end": "03:57:53,671",
    "start_sec": 14269.891,
    "end_sec": 14273.671,
    "zh": "看来这群鬼异也在变化,竟然开始会栽赃人了。",
    "vi": "Xem ra lũ quỷ dị này cũng đang thay đổi, thậm chí bắt đầu biết đổ oan cho người khác rồi."
  },
  {
    "idx": 8484,
    "start": "03:57:54,091",
    "end": "03:57:57,811",
    "start_sec": 14274.091,
    "end_sec": 14277.811,
    "zh": "023朝小男孩赶紧,说吧,你们到底是什么东西?",
    "vi": "Không hai ba nhanh chóng tiến về phía cậu bé và nói, nói đi, các người rốt cuộc là thứ gì."
  },
  {
    "idx": 8485,
    "start": "03:57:58,171",
    "end": "03:58:02,371",
    "start_sec": 14278.171,
    "end_sec": 14282.371,
    "zh": "领导,你在说什么?那个女的还是假的啊?",
    "vi": "Lãnh đạo, ngài đang nói gì vậy. Cô gái kia mới là giả mà."
  },
  {
    "idx": 8486,
    "start": "03:58:02,651",
    "end": "03:58:05,551",
    "start_sec": 14282.651,
    "end_sec": 14285.551,
    "zh": "023瞪了个眼,抬手向小男孩脑袋打击,",
    "vi": "Không hai ba trợn mắt, giơ tay đánh vào đầu cậu bé."
  },
  {
    "idx": 8487,
    "start": "03:58:05,771",
    "end": "03:58:09,331",
    "start_sec": 14285.771,
    "end_sec": 14289.331,
    "zh": "瞬间,小男孩的脑袋以及身体被砸成水雾消散。",
    "vi": "Ngay lập tức, đầu và cơ thể của cậu bé bị đập tan thành sương nước rồi biến mất."
  },
  {
    "idx": 8488,
    "start": "03:58:09,931",
    "end": "03:58:10,571",
    "start_sec": 14289.931,
    "end_sec": 14290.571,
    "zh": "你们呢?",
    "vi": "Còn các người thì sao."
  },
  {
    "idx": 8489,
    "start": "03:58:11,771",
    "end": "03:58:12,791",
    "start_sec": 14291.771,
    "end_sec": 14292.791,
    "zh": "也不说是吧?",
    "vi": "Cũng không chịu nói đúng không."
  },
  {
    "idx": 8490,
    "start": "03:58:13,171",
    "end": "03:58:17,371",
    "start_sec": 14293.171,
    "end_sec": 14297.371,
    "zh": "随即,姐的身体却是开散,奉献出的并不是血肉,而是水雾。",
    "vi": "Ngay sau đó, cơ thể của cô gái cũng tan biến, thứ hiện ra không phải là máu thịt mà là sương nước."
  },
  {
    "idx": 8491,
    "start": "03:58:17,371",
    "end": "03:58:20,331",
    "start_sec": 14297.371,
    "end_sec": 14300.331,
    "zh": "看来他们虽然有了灵智",
    "vi": "Xem ra dù chúng đã có linh trí"
  },
  {
    "idx": 8492,
    "start": "03:58:20,331",
    "end": "03:58:21,891",
    "start_sec": 14300.331,
    "end_sec": 14301.891,
    "zh": "可这身体的掌控权",
    "vi": "Nhưng quyền kiểm soát cơ thể"
  },
  {
    "idx": 8493,
    "start": "03:58:21,891",
    "end": "03:58:23,051",
    "start_sec": 14301.891,
    "end_sec": 14303.051,
    "zh": "只在别人手里",
    "vi": "Vẫn nằm trong tay kẻ khác"
  },
  {
    "idx": 8494,
    "start": "03:58:23,051",
    "end": "03:58:24,931",
    "start_sec": 14303.051,
    "end_sec": 14304.931,
    "zh": "到底是谁在船上搞鬼",
    "vi": "Rốt cuộc ai đang giở trò trên tàu"
  },
  {
    "idx": 8495,
    "start": "03:58:24,931",
    "end": "03:58:26,771",
    "start_sec": 14304.931,
    "end_sec": 14306.771,
    "zh": "长子皮看了水雾好一会",
    "vi": "Trường Tử Bì nhìn màn sương nước hồi lâu"
  },
  {
    "idx": 8496,
    "start": "03:58:26,771",
    "end": "03:58:28,251",
    "start_sec": 14306.771,
    "end_sec": 14308.251,
    "zh": "全体像是想到了什么",
    "vi": "Toàn thân như chợt nhớ ra điều gì"
  },
  {
    "idx": 8497,
    "start": "03:58:28,251",
    "end": "03:58:28,951",
    "start_sec": 14308.251,
    "end_sec": 14308.951,
    "zh": "对了",
    "vi": "Đúng rồi"
  },
  {
    "idx": 8498,
    "start": "03:58:28,951",
    "end": "03:58:30,231",
    "start_sec": 14308.951,
    "end_sec": 14310.231,
    "zh": "我还要回去保护猪羊",
    "vi": "Tôi còn phải quay về bảo vệ Chu Dương"
  },
  {
    "idx": 8499,
    "start": "03:58:30,231",
    "end": "03:58:31,031",
    "start_sec": 14310.231,
    "end_sec": 14311.031,
    "zh": "我先走了",
    "vi": "Tôi đi trước đây"
  },
  {
    "idx": 8500,
    "start": "03:58:31,031",
    "end": "03:58:31,851",
    "start_sec": 14311.031,
    "end_sec": 14311.851,
    "zh": "行",
    "vi": "Được"
  },
  {
    "idx": 8501,
    "start": "03:58:31,851",
    "end": "03:58:33,771",
    "start_sec": 14311.851,
    "end_sec": 14313.771,
    "zh": "把这女孩带上吧",
    "vi": "Mang cô bé này theo đi"
  },
  {
    "idx": 8502,
    "start": "03:58:33,771",
    "end": "03:58:36,831",
    "start_sec": 14313.771,
    "end_sec": 14316.831,
    "zh": "领导",
    "vi": "Lãnh đạo"
  },
  {
    "idx": 8503,
    "start": "03:58:36,831",
    "end": "03:58:37,391",
    "start_sec": 14316.831,
    "end_sec": 14317.391,
    "zh": "领导",
    "vi": "Lãnh đạo"
  },
  {
    "idx": 8504,
    "start": "03:58:37,391",
    "end": "03:58:38,731",
    "start_sec": 14317.391,
    "end_sec": 14318.731,
    "zh": "你能不能救救我弟弟",
    "vi": "Anh có thể cứu em trai tôi không"
  },
  {
    "idx": 8505,
    "start": "03:58:38,731",
    "end": "03:58:39,411",
    "start_sec": 14318.731,
    "end_sec": 14319.411,
    "zh": "成立了",
    "vi": "Thành Đại"
  },
  {
    "idx": 8506,
    "start": "03:58:39,411",
    "end": "03:58:40,311",
    "start_sec": 14319.411,
    "end_sec": 14320.311,
    "zh": "我爸爸死了",
    "vi": "Bố tôi chết rồi"
  },
  {
    "idx": 8507,
    "start": "03:58:40,311",
    "end": "03:58:41,551",
    "start_sec": 14320.311,
    "end_sec": 14321.551,
    "zh": "我就他一个天人了",
    "vi": "Tôi chỉ còn mỗi nó là người thân thôi"
  },
  {
    "idx": 8508,
    "start": "03:58:41,551",
    "end": "03:58:42,871",
    "start_sec": 14321.551,
    "end_sec": 14322.871,
    "zh": "听着女孩的哀求",
    "vi": "Nghe tiếng cô bé cầu xin"
  },
  {
    "idx": 8509,
    "start": "03:58:42,871",
    "end": "03:58:44,191",
    "start_sec": 14322.871,
    "end_sec": 14324.191,
    "zh": "长子皮搅和一顿",
    "vi": "Trường Tử Bì khựng lại một chút"
  },
  {
    "idx": 8510,
    "start": "03:58:44,191",
    "end": "03:58:45,051",
    "start_sec": 14324.191,
    "end_sec": 14325.051,
    "zh": "也没有回应",
    "vi": "Cũng không đáp lời"
  },
  {
    "idx": 8511,
    "start": "03:58:45,051",
    "end": "03:58:45,551",
    "start_sec": 14325.051,
    "end_sec": 14325.551,
    "zh": "哎",
    "vi": "Này"
  },
  {
    "idx": 8512,
    "start": "03:58:45,551",
    "end": "03:58:47,431",
    "start_sec": 14325.551,
    "end_sec": 14327.431,
    "zh": "既然你弟弟已经被鬼冒充",
    "vi": "Vì em trai cô đã bị quỷ mạo danh"
  },
  {
    "idx": 8513,
    "start": "03:58:47,431",
    "end": "03:58:48,291",
    "start_sec": 14327.431,
    "end_sec": 14328.291,
    "zh": "那本人估计",
    "vi": "Thì bản thân nó chắc là"
  },
  {
    "idx": 8514,
    "start": "03:58:48,291",
    "end": "03:58:51,231",
    "start_sec": 14328.291,
    "end_sec": 14331.231,
    "zh": "回到大厅时",
    "vi": "Khi quay lại đại sảnh"
  },
  {
    "idx": 8515,
    "start": "03:58:51,231",
    "end": "03:58:53,791",
    "start_sec": 14331.231,
    "end_sec": 14333.791,
    "zh": "周扬还在座位上小口喝着红酒",
    "vi": "Chu Dương vẫn đang ngồi nhâm nhi rượu vang"
  },
  {
    "idx": 8516,
    "start": "03:58:53,791",
    "end": "03:58:56,231",
    "start_sec": 14333.791,
    "end_sec": 14336.231,
    "zh": "身边居然坐着026和徐坚志",
    "vi": "Bên cạnh lại có 026 và Từ Kiên Chí ngồi cùng"
  },
  {
    "idx": 8517,
    "start": "03:58:56,231",
    "end": "03:58:58,311",
    "start_sec": 14336.231,
    "end_sec": 14338.311,
    "zh": "这两人找周扬干什么",
    "vi": "Hai người này tìm Chu Dương làm gì"
  },
  {
    "idx": 8518,
    "start": "03:58:58,311",
    "end": "03:59:01,011",
    "start_sec": 14338.311,
    "end_sec": 14341.011,
    "zh": "是要拜托他延迟开船的时间吗",
    "vi": "Có phải muốn nhờ cậu ấy hoãn giờ tàu chạy không"
  },
  {
    "idx": 8519,
    "start": "03:59:01,011",
    "end": "03:59:04,031",
    "start_sec": 14341.011,
    "end_sec": 14344.031,
    "zh": "呦 城大领导 你回来了",
    "vi": "Ồ lãnh đạo Thành Đại anh về rồi à"
  },
  {
    "idx": 8520,
    "start": "03:59:04,031",
    "end": "03:59:11,491",
    "start_sec": 14344.031,
    "end_sec": 14351.491,
    "zh": "027 你他妈公子",
    "vi": "027 mày là đồ khốn nạn"
  },
  {
    "idx": 8521,
    "start": "03:59:11,491",
    "end": "03:59:12,631",
    "start_sec": 14351.491,
    "end_sec": 14352.631,
    "zh": "干对周公子公子",
    "vi": "Dám ra tay với cậu Chu sao."
  },
  {
    "idx": 8522,
    "start": "03:59:12,631",
    "end": "03:59:14,551",
    "start_sec": 14352.631,
    "end_sec": 14354.551,
    "zh": "你是不是以为你是组织成员",
    "vi": "Có phải anh nghĩ mình là thành viên tổ chức"
  },
  {
    "idx": 8523,
    "start": "03:59:14,551",
    "end": "03:59:15,831",
    "start_sec": 14354.551,
    "end_sec": 14355.831,
    "zh": "就可以肆意望为了",
    "vi": "thì có thể làm càn được đúng không."
  },
  {
    "idx": 8524,
    "start": "03:59:15,831",
    "end": "03:59:18,791",
    "start_sec": 14355.831,
    "end_sec": 14358.791,
    "zh": "看清楚了",
    "vi": "Nhìn cho kỹ đi."
  },
  {
    "idx": 8525,
    "start": "03:59:18,791",
    "end": "03:59:19,851",
    "start_sec": 14358.791,
    "end_sec": 14359.851,
    "zh": "他可不是周扬",
    "vi": "Hắn ta không phải là Chu Dương đâu."
  },
  {
    "idx": 8526,
    "start": "03:59:19,851",
    "end": "03:59:25,691",
    "start_sec": 14359.851,
    "end_sec": 14365.691,
    "zh": "好久不见了",
    "vi": "Đã lâu không gặp."
  },
  {
    "idx": 8527,
    "start": "03:59:25,691",
    "end": "03:59:27,691",
    "start_sec": 14365.691,
    "end_sec": 14367.691,
    "zh": "周扬刚刚干什么去了",
    "vi": "Chu Dương vừa nãy đi đâu thế."
  },
  {
    "idx": 8528,
    "start": "03:59:27,691",
    "end": "03:59:28,631",
    "start_sec": 14367.691,
    "end_sec": 14368.631,
    "zh": "怎么就这么话",
    "vi": "Sao chỉ mới một lát"
  },
  {
    "idx": 8529,
    "start": "03:59:28,631",
    "end": "03:59:29,751",
    "start_sec": 14368.631,
    "end_sec": 14369.751,
    "zh": "就被替换了",
    "vi": "đã bị tráo người rồi."
  },
  {
    "idx": 8530,
    "start": "03:59:29,751",
    "end": "03:59:32,251",
    "start_sec": 14369.751,
    "end_sec": 14372.251,
    "zh": "周公子刚刚好像回二楼了",
    "vi": "Cậu Chu vừa nãy hình như đã quay lại tầng hai."
  },
  {
    "idx": 8531,
    "start": "03:59:32,251",
    "end": "03:59:34,211",
    "start_sec": 14372.251,
    "end_sec": 14374.211,
    "zh": "但是他突然又回来了",
    "vi": "Nhưng đột nhiên anh ấy lại quay lại."
  },
  {
    "idx": 8532,
    "start": "03:59:34,211",
    "end": "03:59:36,331",
    "start_sec": 14374.211,
    "end_sec": 14376.331,
    "zh": "还喊我和小海过来聊天",
    "vi": "Còn gọi tôi và Tiểu Hải qua nói chuyện."
  },
  {
    "idx": 8533,
    "start": "03:59:36,331",
    "end": "03:59:37,891",
    "start_sec": 14376.331,
    "end_sec": 14377.891,
    "zh": "上次又下来了",
    "vi": "Sau đó lại đi xuống."
  },
  {
    "idx": 8534,
    "start": "03:59:37,891",
    "end": "03:59:39,191",
    "start_sec": 14377.891,
    "end_sec": 14379.191,
    "zh": "这么说",
    "vi": "Nói như vậy."
  },
  {
    "idx": 8535,
    "start": "03:59:39,191",
    "end": "03:59:40,391",
    "start_sec": 14379.191,
    "end_sec": 14380.391,
    "zh": "二楼也有问题",
    "vi": "Tầng hai cũng có vấn đề."
  },
  {
    "idx": 8536,
    "start": "03:59:40,391",
    "end": "03:59:42,291",
    "start_sec": 14380.391,
    "end_sec": 14382.291,
    "zh": "没有理会大厨你的慌乱",
    "vi": "Không thèm để ý đến sự hoảng loạn của đầu bếp."
  },
  {
    "idx": 8537,
    "start": "03:59:42,291",
    "end": "03:59:44,131",
    "start_sec": 14382.291,
    "end_sec": 14384.131,
    "zh": "橙子一快步朝电梯走去",
    "vi": "Trình Tử bước nhanh về phía thang máy."
  },
  {
    "idx": 8538,
    "start": "03:59:44,131",
    "end": "03:59:46,591",
    "start_sec": 14384.131,
    "end_sec": 14386.591,
    "zh": "身后的小女孩也快不跟了上来",
    "vi": "Cô bé phía sau cũng nhanh chóng đuổi theo."
  },
  {
    "idx": 8539,
    "start": "03:59:46,591",
    "end": "03:59:52,031",
    "start_sec": 14386.591,
    "end_sec": 14392.031,
    "zh": "不是",
    "vi": "Không phải chứ."
  },
  {
    "idx": 8540,
    "start": "03:59:52,031",
    "end": "03:59:52,951",
    "start_sec": 14392.031,
    "end_sec": 14392.951,
    "zh": "程子皮",
    "vi": "Trình Tử Bì."
  },
  {
    "idx": 8541,
    "start": "03:59:52,951",
    "end": "03:59:54,151",
    "start_sec": 14392.951,
    "end_sec": 14394.151,
    "zh": "你发什么疯了",
    "vi": "Anh điên rồi à."
  },
  {
    "idx": 8542,
    "start": "03:59:54,151",
    "end": "03:59:55,691",
    "start_sec": 14394.151,
    "end_sec": 14395.691,
    "zh": "程子皮用鬼面疮",
    "vi": "Trình Tử Bì dùng Quỷ Diện Sang."
  },
  {
    "idx": 8543,
    "start": "03:59:55,691",
    "end": "03:59:57,131",
    "start_sec": 14395.691,
    "end_sec": 14397.131,
    "zh": "试探着眼前的中阳",
    "vi": "Để thử Chu Dương trước mặt."
  },
  {
    "idx": 8544,
    "start": "03:59:57,131",
    "end": "03:59:59,151",
    "start_sec": 14397.131,
    "end_sec": 14399.151,
    "zh": "好在鬼面疮没有任何反应",
    "vi": "May mà Quỷ Diện Sang không có bất kỳ phản ứng nào."
  },
  {
    "idx": 8545,
    "start": "03:59:59,151",
    "end": "03:59:59,891",
    "start_sec": 14399.151,
    "end_sec": 14399.891,
    "zh": "这个中阳",
    "vi": "Chu Dương này."
  },
  {
    "idx": 8546,
    "start": "04:00:00,080",
    "end": "04:00:00,880",
    "start_sec": 14400.08,
    "end_sec": 14400.88,
    "zh": "居然是真的",
    "vi": "Hóa ra là thật."
  },
  {
    "idx": 8547,
    "start": "04:00:00,880",
    "end": "04:00:03,800",
    "start_sec": 14400.88,
    "end_sec": 14403.8,
    "zh": "难道鬼一扑之人不需要杀害本体吗",
    "vi": "Chẳng lẽ kẻ bị quỷ nhập không cần phải giết chết bản thể sao."
  },
  {
    "idx": 8548,
    "start": "04:00:03,800",
    "end": "04:00:04,560",
    "start_sec": 14403.8,
    "end_sec": 14404.56,
    "zh": "不好意思",
    "vi": "Xin lỗi nhé."
  },
  {
    "idx": 8549,
    "start": "04:00:04,560",
    "end": "04:00:07,520",
    "start_sec": 14404.56,
    "end_sec": 14407.52,
    "zh": "刚刚楼下有个一模一样的你被我宰了",
    "vi": "Vừa nãy ở dưới lầu có một kẻ giống hệt anh đã bị tôi xử lý rồi."
  },
  {
    "idx": 8550,
    "start": "04:00:07,520",
    "end": "04:00:10,320",
    "start_sec": 14407.52,
    "end_sec": 14410.32,
    "zh": "我回来后就没出去啊",
    "vi": "Tôi quay lại đây rồi thì có đi ra ngoài đâu."
  },
  {
    "idx": 8551,
    "start": "04:00:10,320",
    "end": "04:00:12,200",
    "start_sec": 14410.32,
    "end_sec": 14412.2,
    "zh": "总之现在就躲在屋里吧",
    "vi": "Tóm lại là bây giờ cứ trốn ở trong phòng đi."
  },
  {
    "idx": 8552,
    "start": "04:00:12,200",
    "end": "04:00:13,540",
    "start_sec": 14412.2,
    "end_sec": 14413.54,
    "zh": "没什么事也别出去了",
    "vi": "Không có việc gì thì đừng đi ra ngoài."
  },
  {
    "idx": 8553,
    "start": "04:00:13,540",
    "end": "04:00:14,520",
    "start_sec": 14413.54,
    "end_sec": 14414.52,
    "zh": "周扬点点头",
    "vi": "Chu Dương gật đầu."
  },
  {
    "idx": 8554,
    "start": "04:00:14,520",
    "end": "04:00:16,280",
    "start_sec": 14414.52,
    "end_sec": 14416.28,
    "zh": "十分配合的回到了我这",
    "vi": "Rất hợp tác quay trở lại chỗ tôi."
  },
  {
    "idx": 8555,
    "start": "04:00:16,280",
    "end": "04:00:17,800",
    "start_sec": 14416.28,
    "end_sec": 14417.8,
    "zh": "目送的回到我这",
    "vi": "Nhìn anh ta quay lại chỗ tôi."
  },
  {
    "idx": 8556,
    "start": "04:00:17,800",
    "end": "04:00:19,880",
    "start_sec": 14417.8,
    "end_sec": 14419.88,
    "zh": "庞子迪踩脑的沙发上送了回",
    "vi": "Bàng Tử Địch nằm bò ra ghế sofa thở phào nhẹ nhõm."
  },
  {
    "idx": 8557,
    "start": "04:00:19,880",
    "end": "04:00:23,000",
    "start_sec": 14419.88,
    "end_sec": 14423.0,
    "zh": "这护送古今的任务可没想象中简单啊",
    "vi": "Nhiệm vụ hộ tống chiếc gương cổ này không đơn giản như tưởng tượng."
  },
  {
    "idx": 8558,
    "start": "04:00:23,720",
    "end": "04:00:24,800",
    "start_sec": 14423.72,
    "end_sec": 14424.8,
    "zh": "领导我弟弟他",
    "vi": "Trưởng nhóm, em trai tôi."
  },
  {
    "idx": 8559,
    "start": "04:00:24,800",
    "end": "04:00:26,460",
    "start_sec": 14424.8,
    "end_sec": 14426.46,
    "zh": "如果你弟弟没死的话",
    "vi": "Nếu em trai cậu chưa chết."
  },
  {
    "idx": 8560,
    "start": "04:00:26,460",
    "end": "04:00:28,820",
    "start_sec": 14426.46,
    "end_sec": 14428.82,
    "zh": "我想到了终点站肯定能救出来",
    "vi": "Tôi nghĩ đến ga cuối chắc chắn sẽ cứu được."
  },
  {
    "idx": 8561,
    "start": "04:00:28,820",
    "end": "04:00:29,820",
    "start_sec": 14428.82,
    "end_sec": 14429.82,
    "zh": "哦好吧",
    "vi": "Ồ, được rồi."
  },
  {
    "idx": 8562,
    "start": "04:00:29,820",
    "end": "04:00:32,440",
    "start_sec": 14429.82,
    "end_sec": 14432.44,
    "zh": "长子皮给了他一个模棱两可的答案",
    "vi": "Trình Tử Bì đưa ra một câu trả lời mơ hồ."
  },
  {
    "idx": 8563,
    "start": "04:00:32,440",
    "end": "04:00:33,740",
    "start_sec": 14432.44,
    "end_sec": 14433.74,
    "zh": "毕竟这趟热乎下来",
    "vi": "Dù sao thì sau chuyến đi này."
  },
  {
    "idx": 8564,
    "start": "04:00:33,740",
    "end": "04:00:35,380",
    "start_sec": 14433.74,
    "end_sec": 14435.38,
    "zh": "自己能不能活过去都难说",
    "vi": "Bản thân có sống sót được hay không còn chưa biết."
  },
  {
    "idx": 8565,
    "start": "04:00:35,380",
    "end": "04:00:36,600",
    "start_sec": 14435.38,
    "end_sec": 14436.6,
    "zh": "更别紧言诺",
    "vi": "Nói chi đến việc hứa hẹn."
  },
  {
    "idx": 8566,
    "start": "04:00:36,600",
    "end": "04:00:38,600",
    "start_sec": 14436.6,
    "end_sec": 14438.6,
    "zh": "长子皮坐在沙发上",
    "vi": "Trình Tử Bì ngồi trên ghế sofa."
  },
  {
    "idx": 8567,
    "start": "04:00:38,600",
    "end": "04:00:39,340",
    "start_sec": 14438.6,
    "end_sec": 14439.34,
    "zh": "取出手机",
    "vi": "Lấy điện thoại ra."
  },
  {
    "idx": 8568,
    "start": "04:00:39,340",
    "end": "04:00:40,760",
    "start_sec": 14439.34,
    "end_sec": 14440.76,
    "zh": "刚打开玉鬼者网站",
    "vi": "Vừa mới mở trang web Ngự Quỷ Giả."
  },
  {
    "idx": 8569,
    "start": "04:00:40,760",
    "end": "04:00:42,080",
    "start_sec": 14440.76,
    "end_sec": 14442.08,
    "zh": "就弹出一条消息",
    "vi": "Thì một tin nhắn hiện lên."
  },
  {
    "idx": 8570,
    "start": "04:00:42,080",
    "end": "04:00:44,520",
    "start_sec": 14442.08,
    "end_sec": 14444.52,
    "zh": "程子皮",
    "vi": "Trình Tử Bì."
  },
  {
    "idx": 8571,
    "start": "04:00:44,520",
    "end": "04:00:46,200",
    "start_sec": 14444.52,
    "end_sec": 14446.2,
    "zh": "到底是不是你杀的东了",
    "vi": "Rốt cuộc có phải anh đã giết Đông Lai không."
  },
  {
    "idx": 8572,
    "start": "04:00:46,200",
    "end": "04:00:47,260",
    "start_sec": 14446.2,
    "end_sec": 14447.26,
    "zh": "你有病吧",
    "vi": "Anh bị điên à."
  },
  {
    "idx": 8573,
    "start": "04:00:47,260",
    "end": "04:00:48,200",
    "start_sec": 14447.26,
    "end_sec": 14448.2,
    "zh": "我都说了",
    "vi": "Tôi đã nói rồi."
  },
  {
    "idx": 8574,
    "start": "04:00:48,200",
    "end": "04:00:49,780",
    "start_sec": 14448.2,
    "end_sec": 14449.78,
    "zh": "徐东来是持枪鬼杀的",
    "vi": "Từ Đông Lai là do quỷ cầm súng giết."
  },
  {
    "idx": 8575,
    "start": "04:00:49,780",
    "end": "04:00:50,640",
    "start_sec": 14449.78,
    "end_sec": 14450.64,
    "zh": "你知道吗",
    "vi": "Anh có biết không."
  },
  {
    "idx": 8576,
    "start": "04:00:50,640",
    "end": "04:00:51,800",
    "start_sec": 14450.64,
    "end_sec": 14451.8,
    "zh": "刚刚在一楼大厅",
    "vi": "Vừa nãy ở sảnh tầng một."
  },
  {
    "idx": 8577,
    "start": "04:00:51,800",
    "end": "04:00:53,140",
    "start_sec": 14451.8,
    "end_sec": 14453.14,
    "zh": "那个假中央和我说",
    "vi": "Kẻ giả mạo Chu Dương đó đã nói với tôi."
  },
  {
    "idx": 8578,
    "start": "04:00:53,140",
    "end": "04:00:54,680",
    "start_sec": 14453.14,
    "end_sec": 14454.68,
    "zh": "是你设计杀害的徐东",
    "vi": "Chính anh đã thiết kế để sát hại Từ Đông Lai."
  },
  {
    "idx": 8579,
    "start": "04:00:54,680",
    "end": "04:00:55,680",
    "start_sec": 14454.68,
    "end_sec": 14455.68,
    "zh": "我操",
    "vi": "Chết tiệt."
  },
  {
    "idx": 8580,
    "start": "04:00:55,680",
    "end": "04:00:57,080",
    "start_sec": 14455.68,
    "end_sec": 14457.08,
    "zh": "你都知道他是假的了",
    "vi": "Anh đã biết hắn là giả rồi sao."
  },
  {
    "idx": 8581,
    "start": "04:00:57,080",
    "end": "04:00:57,720",
    "start_sec": 14457.08,
    "end_sec": 14457.72,
    "zh": "还要问我",
    "vi": "Còn phải hỏi tôi sao."
  },
  {
    "idx": 8582,
    "start": "04:00:57,720",
    "end": "04:00:59,040",
    "start_sec": 14457.72,
    "end_sec": 14459.04,
    "zh": "鬼话你都信啊",
    "vi": "Lời ma quỷ mà cháu cũng tin à."
  },
  {
    "idx": 8583,
    "start": "04:00:59,040",
    "end": "04:01:00,360",
    "start_sec": 14459.04,
    "end_sec": 14460.36,
    "zh": "挑拨离间不知道啊",
    "vi": "Trò ly gián chia rẽ mà cháu không biết sao."
  },
  {
    "idx": 8584,
    "start": "04:01:00,360",
    "end": "04:01:01,620",
    "start_sec": 14460.36,
    "end_sec": 14461.62,
    "zh": "对了零二六几句",
    "vi": "Đúng rồi, mấy câu của số 026 đó."
  },
  {
    "idx": 8585,
    "start": "04:01:01,620",
    "end": "04:01:02,940",
    "start_sec": 14461.62,
    "end_sec": 14462.94,
    "zh": "那边没再传来消息",
    "vi": "Bên kia không còn truyền tin tức gì về nữa sao."
  },
  {
    "idx": 8586,
    "start": "04:01:02,940",
    "end": "04:01:04,620",
    "start_sec": 14462.94,
    "end_sec": 14464.62,
    "zh": "船上的到底是什么诡异",
    "vi": "Thứ quái dị trên thuyền rốt cuộc là gì vậy."
  },
  {
    "idx": 8587,
    "start": "04:01:04,620",
    "end": "04:01:06,220",
    "start_sec": 14464.62,
    "end_sec": 14466.22,
    "zh": "还会玩心眼挑拨离间",
    "vi": "Lại còn biết dùng mưu kế để ly gián nữa."
  },
  {
    "idx": 8588,
    "start": "04:01:06,220",
    "end": "04:01:07,520",
    "start_sec": 14466.22,
    "end_sec": 14467.52,
    "zh": "领导",
    "vi": "Thưa lãnh đạo."
  },
  {
    "idx": 8589,
    "start": "04:01:07,520",
    "end": "04:01:09,620",
    "start_sec": 14467.52,
    "end_sec": 14469.62,
    "zh": "现在还能上论坛发消息的吗",
    "vi": "Bây giờ vẫn còn lên diễn đàn đăng tin được sao."
  },
  {
    "idx": 8590,
    "start": "04:01:09,620",
    "end": "04:01:10,940",
    "start_sec": 14469.62,
    "end_sec": 14470.94,
    "zh": "这不是一般论坛",
    "vi": "Đây không phải là diễn đàn bình thường."
  },
  {
    "idx": 8591,
    "start": "04:01:10,940",
    "end": "04:01:12,380",
    "start_sec": 14470.94,
    "end_sec": 14472.38,
    "zh": "小孩子别管那么多",
    "vi": "Trẻ con đừng quản nhiều chuyện như vậy."
  },
  {
    "idx": 8592,
    "start": "04:01:12,380",
    "end": "04:01:12,920",
    "start_sec": 14472.38,
    "end_sec": 14472.92,
    "zh": "好吧",
    "vi": "Dạ được rồi."
  },
  {
    "idx": 8593,
    "start": "04:01:12,920",
    "end": "04:01:13,560",
    "start_sec": 14472.92,
    "end_sec": 14473.56,
    "zh": "也不知道",
    "vi": "Cháu cũng không biết."
  },
  {
    "idx": 8594,
    "start": "04:01:13,560",
    "end": "04:01:15,520",
    "start_sec": 14473.56,
    "end_sec": 14475.52,
    "zh": "我之前发的帖子有没有用",
    "vi": "Bài đăng trước đó của cháu có ích gì không nữa."
  },
  {
    "idx": 8595,
    "start": "04:01:15,520",
    "end": "04:01:16,680",
    "start_sec": 14475.52,
    "end_sec": 14476.68,
    "zh": "你发了什么帖子",
    "vi": "Cháu đã đăng bài viết gì vậy."
  },
  {
    "idx": 8596,
    "start": "04:01:16,680",
    "end": "04:01:17,420",
    "start_sec": 14476.68,
    "end_sec": 14477.42,
    "zh": "就是",
    "vi": "Thì là."
  },
  {
    "idx": 8597,
    "start": "04:01:17,420",
    "end": "04:01:19,240",
    "start_sec": 14477.42,
    "end_sec": 14479.24,
    "zh": "就我在求生网站上写了",
    "vi": "Cháu đã viết trên trang web sinh tồn rằng."
  },
  {
    "idx": 8598,
    "start": "04:01:19,240",
    "end": "04:01:21,160",
    "start_sec": 14479.24,
    "end_sec": 14481.16,
    "zh": "我爸爸的道法对诡异有用",
    "vi": "Đạo pháp của bố cháu có tác dụng với thực thể quái dị."
  },
  {
    "idx": 8599,
    "start": "04:01:21,160",
    "end": "04:01:22,060",
    "start_sec": 14481.16,
    "end_sec": 14482.06,
    "zh": "但用处不大",
    "vi": "Nhưng tác dụng không lớn lắm."
  },
  {
    "idx": 8600,
    "start": "04:01:22,060",
    "end": "04:01:24,020",
    "start_sec": 14482.06,
    "end_sec": 14484.02,
    "zh": "长子提听的女孩的话",
    "vi": "Trần Tử Bì nghe lời cô bé nói."
  },
  {
    "idx": 8601,
    "start": "04:01:24,020",
    "end": "04:01:25,240",
    "start_sec": 14484.02,
    "end_sec": 14485.24,
    "zh": "越听越耳熟",
    "vi": "Càng nghe càng thấy quen tai."
  },
  {
    "idx": 8602,
    "start": "04:01:25,240",
    "end": "04:01:26,440",
    "start_sec": 14485.24,
    "end_sec": 14486.44,
    "zh": "随即反应过来",
    "vi": "Sau đó lập tức phản ứng lại."
  },
  {
    "idx": 8603,
    "start": "04:01:26,440",
    "end": "04:01:26,780",
    "start_sec": 14486.44,
    "end_sec": 14486.78,
    "zh": "你",
    "vi": "Cháu."
  },
  {
    "idx": 8604,
    "start": "04:01:26,780",
    "end": "04:01:28,220",
    "start_sec": 14486.78,
    "end_sec": 14488.22,
    "zh": "你就是那个不吃香菜",
    "vi": "Cháu chính là người có tên tài khoản không ăn rau mùi đó sao."
  },
  {
    "idx": 8605,
    "start": "04:01:28,220",
    "end": "04:01:29,380",
    "start_sec": 14488.22,
    "end_sec": 14489.38,
    "zh": "领导",
    "vi": "Thưa lãnh đạo."
  },
  {
    "idx": 8606,
    "start": "04:01:29,380",
    "end": "04:01:30,800",
    "start_sec": 14489.38,
    "end_sec": 14490.8,
    "zh": "你也看过那篇帖子吗",
    "vi": "Chú cũng từng đọc bài đăng đó rồi sao."
  },
  {
    "idx": 8607,
    "start": "04:01:30,800",
    "end": "04:01:32,120",
    "start_sec": 14490.8,
    "end_sec": 14492.12,
    "zh": "小女孩有点吃惊",
    "vi": "Cô bé hơi ngạc nhiên."
  },
  {
    "idx": 8608,
    "start": "04:01:32,120",
    "end": "04:01:32,900",
    "start_sec": 14492.12,
    "end_sec": 14492.9,
    "zh": "她没想到",
    "vi": "Cô không ngờ rằng."
  },
  {
    "idx": 8609,
    "start": "04:01:32,900",
    "end": "04:01:34,580",
    "start_sec": 14492.9,
    "end_sec": 14494.58,
    "zh": "像橙子皮这样的大人物",
    "vi": "Một nhân vật lớn như Trần Tử Bì."
  },
  {
    "idx": 8610,
    "start": "04:01:34,580",
    "end": "04:01:35,900",
    "start_sec": 14494.58,
    "end_sec": 14495.9,
    "zh": "也会看自己的帖子",
    "vi": "Cũng sẽ đọc bài đăng của mình."
  },
  {
    "idx": 8611,
    "start": "04:01:35,900",
    "end": "04:01:37,720",
    "start_sec": 14495.9,
    "end_sec": 14497.72,
    "zh": "橙子皮也有点惊讶",
    "vi": "Trần Tử Bì cũng có chút kinh ngạc."
  },
  {
    "idx": 8612,
    "start": "04:01:37,720",
    "end": "04:01:38,480",
    "start_sec": 14497.72,
    "end_sec": 14498.48,
    "zh": "她没想到",
    "vi": "Anh ấy không ngờ rằng."
  },
  {
    "idx": 8613,
    "start": "04:01:38,480",
    "end": "04:01:39,560",
    "start_sec": 14498.48,
    "end_sec": 14499.56,
    "zh": "最早诡异降临",
    "vi": "khi sự kiện kỳ dị mới bắt đầu xảy ra."
  },
  {
    "idx": 8614,
    "start": "04:01:39,560",
    "end": "04:01:41,600",
    "start_sec": 14499.56,
    "end_sec": 14501.6,
    "zh": "她在小区里看到的那篇帖子",
    "vi": "Bài đăng mà anh ấy nhìn thấy trong nhóm khu dân cư."
  },
  {
    "idx": 8615,
    "start": "04:01:41,600",
    "end": "04:01:43,380",
    "start_sec": 14501.6,
    "end_sec": 14503.38,
    "zh": "竟然是出自眼前的女孩",
    "vi": "lại là do cô bé trước mặt này viết."
  },
  {
    "idx": 8616,
    "start": "04:01:43,380",
    "end": "04:01:44,380",
    "start_sec": 14503.38,
    "end_sec": 14504.38,
    "zh": "对",
    "vi": "Đúng vậy."
  },
  {
    "idx": 8617,
    "start": "04:01:44,380",
    "end": "04:01:44,900",
    "start_sec": 14504.38,
    "end_sec": 14504.9,
    "zh": "看过",
    "vi": "Tôi đã đọc rồi."
  },
  {
    "idx": 8618,
    "start": "04:01:44,900",
    "end": "04:01:46,120",
    "start_sec": 14504.9,
    "end_sec": 14506.12,
    "zh": "你的帖子很有用",
    "vi": "Bài đăng của em rất có ích."
  },
  {
    "idx": 8619,
    "start": "04:01:46,120",
    "end": "04:01:47,160",
    "start_sec": 14506.12,
    "end_sec": 14507.16,
    "zh": "对了",
    "vi": "Đúng rồi."
  },
  {
    "idx": 8620,
    "start": "04:01:47,160",
    "end": "04:01:48,060",
    "start_sec": 14507.16,
    "end_sec": 14508.06,
    "zh": "你父亲呢",
    "vi": "Bố của em đâu rồi."
  },
  {
    "idx": 8621,
    "start": "04:01:48,060",
    "end": "04:01:49,800",
    "start_sec": 14508.06,
    "end_sec": 14509.8,
    "zh": "身为直男的橙子皮",
    "vi": "Là một thẳng nam thực thụ."
  },
  {
    "idx": 8622,
    "start": "04:01:49,800",
    "end": "04:01:51,740",
    "start_sec": 14509.8,
    "end_sec": 14511.74,
    "zh": "很不巧妙地聊到了这个问题",
    "vi": "Trần Tử Bì đã vô tình chạm vào nỗi đau này."
  },
  {
    "idx": 8623,
    "start": "04:01:51,740",
    "end": "04:01:52,800",
    "start_sec": 14511.74,
    "end_sec": 14512.8,
    "zh": "客厅里的气氛",
    "vi": "Bầu không khí trong phòng khách."
  },
  {
    "idx": 8624,
    "start": "04:01:52,800",
    "end": "04:01:54,060",
    "start_sec": 14512.8,
    "end_sec": 14514.06,
    "zh": "顿时沉默下来",
    "vi": "bỗng chốc trở nên im lặng."
  },
  {
    "idx": 8625,
    "start": "04:01:54,060",
    "end": "04:01:55,260",
    "start_sec": 14514.06,
    "end_sec": 14515.26,
    "zh": "许久",
    "vi": "Một lúc lâu sau."
  },
  {
    "idx": 8626,
    "start": "04:01:55,260",
    "end": "04:01:56,600",
    "start_sec": 14515.26,
    "end_sec": 14516.6,
    "zh": "小女孩才开口问道",
    "vi": "cô bé mới lên tiếng hỏi."
  },
  {
    "idx": 8627,
    "start": "04:01:56,600",
    "end": "04:01:57,220",
    "start_sec": 14516.6,
    "end_sec": 14517.22,
    "zh": "对了",
    "vi": "Đúng rồi."
  },
  {
    "idx": 8628,
    "start": "04:01:57,220",
    "end": "04:01:57,680",
    "start_sec": 14517.22,
    "end_sec": 14517.68,
    "zh": "领导",
    "vi": "thưa lãnh đạo."
  },
  {
    "idx": 8629,
    "start": "04:01:57,680",
    "end": "04:01:59,220",
    "start_sec": 14517.68,
    "end_sec": 14519.22,
    "zh": "我可以问你一个问题吗",
    "vi": "em có thể hỏi anh một câu được không."
  },
  {
    "idx": 8630,
    "start": "04:01:59,220",
    "end": "04:02:00,140",
    "start_sec": 14519.22,
    "end_sec": 14520.14,
    "zh": "你说",
    "vi": "Em nói đi."
  },
  {
    "idx": 8631,
    "start": "04:02:00,140",
    "end": "04:02:02,040",
    "start_sec": 14520.14,
    "end_sec": 14522.04,
    "zh": "你叫什么名字啊",
    "vi": "Anh tên là gì vậy."
  },
  {
    "idx": 8632,
    "start": "04:02:02,040",
    "end": "04:02:02,600",
    "start_sec": 14522.04,
    "end_sec": 14522.6,
    "zh": "橙子皮",
    "vi": "Trần Tử Bì."
  },
  {
    "idx": 8633,
    "start": "04:02:02,600",
    "end": "04:02:04,440",
    "start_sec": 14522.6,
    "end_sec": 14524.44,
    "zh": "我名叫世界没有后悔药",
    "vi": "Biệt danh của tôi là Thế giới không có thuốc hối hận."
  },
  {
    "idx": 8634,
    "start": "04:02:04,440",
    "end": "04:02:05,020",
    "start_sec": 14524.44,
    "end_sec": 14525.02,
    "zh": "哦",
    "vi": "Ồ."
  },
  {
    "idx": 8635,
    "start": "04:02:05,020",
    "end": "04:02:06,480",
    "start_sec": 14525.02,
    "end_sec": 14526.48,
    "zh": "我叫夏桃红",
    "vi": "Em tên là Hạ Đào Hồng."
  },
  {
    "idx": 8636,
    "start": "04:02:06,480",
    "end": "04:02:06,880",
    "start_sec": 14526.48,
    "end_sec": 14526.88,
    "zh": "领导",
    "vi": "Thưa lãnh đạo."
  },
  {
    "idx": 8637,
    "start": "04:02:06,880",
    "end": "04:02:08,260",
    "start_sec": 14526.88,
    "end_sec": 14528.26,
    "zh": "你这名字真有意思",
    "vi": "tên của anh thật là thú vị."
  },
  {
    "idx": 8638,
    "start": "04:02:08,260",
    "end": "04:02:09,480",
    "start_sec": 14528.26,
    "end_sec": 14529.48,
    "zh": "后悔药",
    "vi": "Thuốc hối hận."
  },
  {
    "idx": 8639,
    "start": "04:02:09,480",
    "end": "04:02:10,440",
    "start_sec": 14529.48,
    "end_sec": 14530.44,
    "zh": "后悔药",
    "vi": "Thuốc hối hận."
  },
  {
    "idx": 8640,
    "start": "04:02:10,440",
    "end": "04:02:12,140",
    "start_sec": 14530.44,
    "end_sec": 14532.14,
    "zh": "要是真有后悔药就好了",
    "vi": "Nếu như thực sự có thuốc hối hận thì tốt biết mấy."
  },
  {
    "idx": 8641,
    "start": "04:02:12,140",
    "end": "04:02:13,260",
    "start_sec": 14532.14,
    "end_sec": 14533.26,
    "zh": "我提醒我爸",
    "vi": "Tôi đã nhắc bố tôi"
  },
  {
    "idx": 8642,
    "start": "04:02:13,260",
    "end": "04:02:14,200",
    "start_sec": 14533.26,
    "end_sec": 14534.2,
    "zh": "不出门杀鬼",
    "vi": "Đừng ra ngoài để giết quỷ"
  },
  {
    "idx": 8643,
    "start": "04:02:14,200",
    "end": "04:02:15,400",
    "start_sec": 14534.2,
    "end_sec": 14535.4,
    "zh": "他是不是不会死了",
    "vi": "Ông ấy sẽ không chết chứ"
  },
  {
    "idx": 8644,
    "start": "04:02:15,400",
    "end": "04:02:17,420",
    "start_sec": 14535.4,
    "end_sec": 14537.42,
    "zh": "我弟弟也就不会消失了",
    "vi": "Em trai tôi cũng sẽ không biến mất"
  },
  {
    "idx": 8645,
    "start": "04:02:17,420",
    "end": "04:02:18,220",
    "start_sec": 14537.42,
    "end_sec": 14538.22,
    "zh": "不好意思",
    "vi": "Xin lỗi"
  },
  {
    "idx": 8646,
    "start": "04:02:18,220",
    "end": "04:02:20,100",
    "start_sec": 14538.22,
    "end_sec": 14540.1,
    "zh": "说到让你伤心的事情了",
    "vi": "Tôi đã nói điều khiến bạn buồn"
  },
  {
    "idx": 8647,
    "start": "04:02:20,100",
    "end": "04:02:20,440",
    "start_sec": 14540.1,
    "end_sec": 14540.44,
    "zh": "我想",
    "vi": "Tôi nghĩ"
  },
  {
    "idx": 8648,
    "start": "04:02:20,440",
    "end": "04:02:22,000",
    "start_sec": 14540.44,
    "end_sec": 14542.0,
    "zh": "你弟弟应该会没事的",
    "vi": "Em trai bạn sẽ ổn thôi"
  },
  {
    "idx": 8649,
    "start": "04:02:22,000",
    "end": "04:02:22,920",
    "start_sec": 14542.0,
    "end_sec": 14542.92,
    "zh": "你也不用太担心",
    "vi": "Bạn không cần phải lo lắng quá"
  },
  {
    "idx": 8650,
    "start": "04:02:22,920",
    "end": "04:02:24,460",
    "start_sec": 14542.92,
    "end_sec": 14544.46,
    "zh": "如果",
    "vi": "Nếu"
  },
  {
    "idx": 8651,
    "start": "04:02:24,460",
    "end": "04:02:25,880",
    "start_sec": 14544.46,
    "end_sec": 14545.88,
    "zh": "如果一个月前的我",
    "vi": "Nếu một tháng trước tôi"
  },
  {
    "idx": 8652,
    "start": "04:02:25,880",
    "end": "04:02:27,100",
    "start_sec": 14545.88,
    "end_sec": 14547.1,
    "zh": "率先找到夏桃红",
    "vi": "Tìm thấy Hạ Đào Hồng trước"
  },
  {
    "idx": 8653,
    "start": "04:02:27,100",
    "end": "04:02:28,220",
    "start_sec": 14547.1,
    "end_sec": 14548.22,
    "zh": "让他提醒他爸",
    "vi": "Để anh ấy nhắc nhở bố mình"
  },
  {
    "idx": 8654,
    "start": "04:02:28,220",
    "end": "04:02:29,140",
    "start_sec": 14548.22,
    "end_sec": 14549.14,
    "zh": "不要出门",
    "vi": "Đừng ra ngoài"
  },
  {
    "idx": 8655,
    "start": "04:02:29,140",
    "end": "04:02:30,820",
    "start_sec": 14549.14,
    "end_sec": 14550.82,
    "zh": "这样会不会就避开了此局呢",
    "vi": "Liệu như vậy có thể tránh được cục diện này không"
  },
  {
    "idx": 8656,
    "start": "04:02:30,820",
    "end": "04:02:31,640",
    "start_sec": 14550.82,
    "end_sec": 14551.64,
    "zh": "想着",
    "vi": "Nghĩ vậy"
  },
  {
    "idx": 8657,
    "start": "04:02:31,640",
    "end": "04:02:33,400",
    "start_sec": 14551.64,
    "end_sec": 14553.4,
    "zh": "滕子提刚要掏出手机",
    "vi": "Đằng Tử Đề vừa định lấy điện thoại ra"
  },
  {
    "idx": 8658,
    "start": "04:02:33,400",
    "end": "04:02:34,440",
    "start_sec": 14553.4,
    "end_sec": 14554.44,
    "zh": "屋内不是为何",
    "vi": "Trong nhà không hiểu sao"
  },
  {
    "idx": 8659,
    "start": "04:02:34,440",
    "end": "04:02:36,020",
    "start_sec": 14554.44,
    "end_sec": 14556.02,
    "zh": "从天花板掉下水水",
    "vi": "Nước từ trần nhà rơi xuống"
  },
  {
    "idx": 8660,
    "start": "04:02:36,020",
    "end": "04:02:36,980",
    "start_sec": 14556.02,
    "end_sec": 14556.98,
    "zh": "不对劲",
    "vi": "Không ổn"
  },
  {
    "idx": 8661,
    "start": "04:02:36,980",
    "end": "04:02:37,920",
    "start_sec": 14556.98,
    "end_sec": 14557.92,
    "zh": "什么情况",
    "vi": "Chuyện gì vậy"
  },
  {
    "idx": 8662,
    "start": "04:02:37,920",
    "end": "04:02:42,060",
    "start_sec": 14557.92,
    "end_sec": 14562.06,
    "zh": "滕子提",
    "vi": "Đằng Tử Đề"
  },
  {
    "idx": 8663,
    "start": "04:02:42,060",
    "end": "04:02:43,120",
    "start_sec": 14562.06,
    "end_sec": 14563.12,
    "zh": "滚出来说",
    "vi": "Cút ra đây nói"
  },
  {
    "idx": 8664,
    "start": "04:02:43,120",
    "end": "04:02:45,880",
    "start_sec": 14563.12,
    "end_sec": 14565.88,
    "zh": "026",
    "vi": "026"
  },
  {
    "idx": 8665,
    "start": "04:02:45,880",
    "end": "04:02:47,320",
    "start_sec": 14565.88,
    "end_sec": 14567.32,
    "zh": "你他妈不发神话",
    "vi": "Mày mẹ nó không nói gì à"
  },
  {
    "idx": 8666,
    "start": "04:02:47,320",
    "end": "04:02:49,080",
    "start_sec": 14567.32,
    "end_sec": 14569.08,
    "zh": "徐叔从小教我养到大",
    "vi": "Chú Từ nuôi tôi lớn từ nhỏ"
  },
  {
    "idx": 8667,
    "start": "04:02:49,080",
    "end": "04:02:49,960",
    "start_sec": 14569.08,
    "end_sec": 14569.96,
    "zh": "他不是我弟",
    "vi": "Ông ấy không phải em trai tôi"
  },
  {
    "idx": 8668,
    "start": "04:02:49,960",
    "end": "04:02:51,360",
    "start_sec": 14569.96,
    "end_sec": 14571.36,
    "zh": "却比我亲爹还亲",
    "vi": "Nhưng còn thân hơn cả bố ruột"
  },
  {
    "idx": 8669,
    "start": "04:02:51,360",
    "end": "04:02:52,580",
    "start_sec": 14571.36,
    "end_sec": 14572.58,
    "zh": "你可以动徐东来",
    "vi": "Bạn có thể động vào Từ Đông Lai"
  },
  {
    "idx": 8670,
    "start": "04:02:52,580",
    "end": "04:02:53,620",
    "start_sec": 14572.58,
    "end_sec": 14573.62,
    "zh": "但是你敢动他",
    "vi": "Nhưng nếu bạn dám động vào ông ấy"
  },
  {
    "idx": 8671,
    "start": "04:02:53,620",
    "end": "04:02:54,420",
    "start_sec": 14573.62,
    "end_sec": 14574.42,
    "zh": "026",
    "vi": "026"
  },
  {
    "idx": 8672,
    "start": "04:02:54,420",
    "end": "04:02:55,860",
    "start_sec": 14574.42,
    "end_sec": 14575.86,
    "zh": "你他妈脑子又坏了",
    "vi": "Đầu óc mày lại hỏng rồi sao."
  },
  {
    "idx": 8673,
    "start": "04:02:55,860",
    "end": "04:02:57,400",
    "start_sec": 14575.86,
    "end_sec": 14577.4,
    "zh": "我什么时候动许天志了",
    "vi": "Tao động vào Hứa Thiên Chí khi nào chứ."
  },
  {
    "idx": 8674,
    "start": "04:02:57,400",
    "end": "04:02:58,680",
    "start_sec": 14577.4,
    "end_sec": 14578.68,
    "zh": "你还狡辩",
    "vi": "Mày còn chối cãi sao."
  },
  {
    "idx": 8675,
    "start": "04:02:58,680",
    "end": "04:02:59,440",
    "start_sec": 14578.68,
    "end_sec": 14579.44,
    "zh": "我看到",
    "vi": "Tao đã thấy."
  },
  {
    "idx": 8676,
    "start": "04:02:59,440",
    "end": "04:03:00,500",
    "start_sec": 14579.44,
    "end_sec": 14580.5,
    "zh": "我亲眼看到",
    "vi": "Tao tận mắt nhìn thấy."
  },
  {
    "idx": 8677,
    "start": "04:03:00,500",
    "end": "04:03:01,720",
    "start_sec": 14580.5,
    "end_sec": 14581.72,
    "zh": "刚刚水屋起来后",
    "vi": "Ngay sau khi nhà nổi nổi lên."
  },
  {
    "idx": 8678,
    "start": "04:03:01,720",
    "end": "04:03:04,060",
    "start_sec": 14581.72,
    "end_sec": 14584.06,
    "zh": "徐叔在甲板上望远镜还在找人",
    "vi": "Chú Từ vẫn đang dùng ống nhòm tìm người trên boong tàu."
  },
  {
    "idx": 8679,
    "start": "04:03:04,060",
    "end": "04:03:05,060",
    "start_sec": 14584.06,
    "end_sec": 14585.06,
    "zh": "你趁我不在",
    "vi": "Mày nhân lúc tao không có ở đó."
  },
  {
    "idx": 8680,
    "start": "04:03:05,060",
    "end": "04:03:05,880",
    "start_sec": 14585.06,
    "end_sec": 14585.88,
    "zh": "居然找到他",
    "vi": "Lại dám tìm đến ông ấy."
  },
  {
    "idx": 8681,
    "start": "04:03:05,880",
    "end": "04:03:07,100",
    "start_sec": 14585.88,
    "end_sec": 14587.1,
    "zh": "亲手掐死了",
    "vi": "Tự tay bóp cổ chết ông ấy."
  },
  {
    "idx": 8682,
    "start": "04:03:07,100",
    "end": "04:03:08,160",
    "start_sec": 14587.1,
    "end_sec": 14588.16,
    "zh": "我一路追过来",
    "vi": "Tao đuổi theo suốt dọc đường."
  },
  {
    "idx": 8683,
    "start": "04:03:08,160",
    "end": "04:03:09,640",
    "start_sec": 14588.16,
    "end_sec": 14589.64,
    "zh": "你还敢躲在这房间",
    "vi": "Mày còn dám trốn trong căn phòng này."
  },
  {
    "idx": 8684,
    "start": "04:03:09,640",
    "end": "04:03:11,640",
    "start_sec": 14589.64,
    "end_sec": 14591.64,
    "zh": "你以为你躲着就能活命了吗",
    "vi": "Mày nghĩ mày trốn đi là có thể sống sót sao."
  },
  {
    "idx": 8685,
    "start": "04:03:11,640",
    "end": "04:03:12,920",
    "start_sec": 14591.64,
    "end_sec": 14592.92,
    "zh": "我从刚刚到现在",
    "vi": "Từ nãy đến giờ tao."
  },
  {
    "idx": 8686,
    "start": "04:03:12,920",
    "end": "04:03:13,880",
    "start_sec": 14592.92,
    "end_sec": 14593.88,
    "zh": "一直都在屋里",
    "vi": "Vẫn luôn ở trong phòng."
  },
  {
    "idx": 8687,
    "start": "04:03:13,880",
    "end": "04:03:14,860",
    "start_sec": 14593.88,
    "end_sec": 14594.86,
    "zh": "不信你问周扬",
    "vi": "Không tin mày cứ hỏi Chu Dương."
  },
  {
    "idx": 8688,
    "start": "04:03:14,860",
    "end": "04:03:15,780",
    "start_sec": 14594.86,
    "end_sec": 14595.78,
    "zh": "问你妈",
    "vi": "Hỏi cái đầu mày ấy."
  },
  {
    "idx": 8689,
    "start": "04:03:15,780",
    "end": "04:03:16,960",
    "start_sec": 14595.78,
    "end_sec": 14596.96,
    "zh": "他帮你打眼球",
    "vi": "Hắn bao che cho mày."
  },
  {
    "idx": 8690,
    "start": "04:03:16,960",
    "end": "04:03:17,980",
    "start_sec": 14596.96,
    "end_sec": 14597.98,
    "zh": "你怎么说都行",
    "vi": "Mày muốn nói thế nào chẳng được."
  },
  {
    "idx": 8691,
    "start": "04:03:17,980",
    "end": "04:03:18,980",
    "start_sec": 14597.98,
    "end_sec": 14598.98,
    "zh": "既然你下死手",
    "vi": "Đã thế mày còn ra tay tàn độc."
  },
  {
    "idx": 8692,
    "start": "04:03:18,980",
    "end": "04:03:20,060",
    "start_sec": 14598.98,
    "end_sec": 14600.06,
    "zh": "那你都别说了",
    "vi": "Vậy thì mày đừng nói gì nữa."
  },
  {
    "idx": 8693,
    "start": "04:03:20,620",
    "end": "04:03:23,200",
    "start_sec": 14600.62,
    "end_sec": 14603.2,
    "zh": "好巴掌",
    "vi": "Đánh hay lắm."
  },
  {
    "idx": 8694,
    "start": "04:03:23,200",
    "end": "04:03:24,260",
    "start_sec": 14603.2,
    "end_sec": 14604.26,
    "zh": "026这个傻逼",
    "vi": "Thằng ngu 026 này."
  },
  {
    "idx": 8695,
    "start": "04:03:24,260",
    "end": "04:03:25,900",
    "start_sec": 14604.26,
    "end_sec": 14605.9,
    "zh": "肯定是诡异冒充的我",
    "vi": "Chắc chắn là thế lực quỷ dị đã giả dạng tôi."
  },
  {
    "idx": 8696,
    "start": "04:03:25,900",
    "end": "04:03:26,840",
    "start_sec": 14605.9,
    "end_sec": 14606.84,
    "zh": "杀掉许天志",
    "vi": "Để giết Hứa Thiên Chí."
  },
  {
    "idx": 8697,
    "start": "04:03:26,840",
    "end": "04:03:28,140",
    "start_sec": 14606.84,
    "end_sec": 14608.14,
    "zh": "故意做给026看",
    "vi": "Cố tình làm cho 026 thấy."
  },
  {
    "idx": 8698,
    "start": "04:03:28,140",
    "end": "04:03:28,940",
    "start_sec": 14608.14,
    "end_sec": 14608.94,
    "zh": "如此一来",
    "vi": "Như vậy."
  },
  {
    "idx": 8699,
    "start": "04:03:28,940",
    "end": "04:03:30,100",
    "start_sec": 14608.94,
    "end_sec": 14610.1,
    "zh": "无需诡异动手",
    "vi": "Không cần thế lực quỷ dị ra tay."
  },
  {
    "idx": 8700,
    "start": "04:03:30,100",
    "end": "04:03:30,920",
    "start_sec": 14610.1,
    "end_sec": 14610.92,
    "zh": "遇鬼者之间",
    "vi": "Giữa những người gặp quỷ."
  },
  {
    "idx": 8701,
    "start": "04:03:30,920",
    "end": "04:03:32,240",
    "start_sec": 14610.92,
    "end_sec": 14612.24,
    "zh": "就开始内斗了",
    "vi": "đã bắt đầu nội chiến rồi."
  },
  {
    "idx": 8702,
    "start": "04:03:32,240",
    "end": "04:03:33,380",
    "start_sec": 14612.24,
    "end_sec": 14613.38,
    "zh": "船上那只诡异",
    "vi": "Con quỷ dị trên tàu kia"
  },
  {
    "idx": 8703,
    "start": "04:03:33,380",
    "end": "04:03:34,680",
    "start_sec": 14613.38,
    "end_sec": 14614.68,
    "zh": "激化我们之间的矛盾",
    "vi": "đang kích động mâu thuẫn giữa chúng ta."
  },
  {
    "idx": 8704,
    "start": "04:03:34,680",
    "end": "04:03:35,520",
    "start_sec": 14614.68,
    "end_sec": 14615.52,
    "zh": "你我一死",
    "vi": "Tôi và anh mà chết"
  },
  {
    "idx": 8705,
    "start": "04:03:35,520",
    "end": "04:03:36,420",
    "start_sec": 14615.52,
    "end_sec": 14616.42,
    "zh": "船开不了",
    "vi": "tàu sẽ không chạy được."
  },
  {
    "idx": 8706,
    "start": "04:03:36,420",
    "end": "04:03:38,760",
    "start_sec": 14616.42,
    "end_sec": 14618.76,
    "zh": "曙光号也就变成鬼船不远了",
    "vi": "Tàu Bình Minh cũng sẽ sớm biến thành tàu ma thôi."
  },
  {
    "idx": 8707,
    "start": "04:03:38,760",
    "end": "04:03:41,220",
    "start_sec": 14618.76,
    "end_sec": 14621.22,
    "zh": "无论程子皮再如何怒视026",
    "vi": "Dù cho Trình Tử Bì có giận dữ nhìn 026 thế nào"
  },
  {
    "idx": 8708,
    "start": "04:03:41,220",
    "end": "04:03:42,520",
    "start_sec": 14621.22,
    "end_sec": 14622.52,
    "zh": "但一声红眼的他",
    "vi": "nhưng với đôi mắt đỏ ngầu lúc này"
  },
  {
    "idx": 8709,
    "start": "04:03:42,520",
    "end": "04:03:44,020",
    "start_sec": 14622.52,
    "end_sec": 14624.02,
    "zh": "一句话也听不进去",
    "vi": "một câu anh ta cũng không lọt tai."
  },
  {
    "idx": 8710,
    "start": "04:03:44,020",
    "end": "04:03:44,840",
    "start_sec": 14624.02,
    "end_sec": 14624.84,
    "zh": "不怪是鬼",
    "vi": "Dù là quỷ"
  },
  {
    "idx": 8711,
    "start": "04:03:44,840",
    "end": "04:03:46,020",
    "start_sec": 14624.84,
    "end_sec": 14626.02,
    "zh": "只要感动徐叔",
    "vi": "chỉ cần dám động vào chú Từ"
  },
  {
    "idx": 8712,
    "start": "04:03:46,020",
    "end": "04:03:46,720",
    "start_sec": 14626.02,
    "end_sec": 14626.72,
    "zh": "都得死",
    "vi": "đều phải chết."
  },
  {
    "idx": 8713,
    "start": "04:03:46,720",
    "end": "04:03:47,580",
    "start_sec": 14626.72,
    "end_sec": 14627.58,
    "zh": "傻逼",
    "vi": "Đồ ngu."
  },
  {
    "idx": 8714,
    "start": "04:03:47,580",
    "end": "04:03:48,720",
    "start_sec": 14627.58,
    "end_sec": 14628.72,
    "zh": "既然你不清醒",
    "vi": "Đã thế nếu anh không tỉnh táo"
  },
  {
    "idx": 8715,
    "start": "04:03:48,720",
    "end": "04:03:49,880",
    "start_sec": 14628.72,
    "end_sec": 14629.88,
    "zh": "我就给你打清醒",
    "vi": "tôi sẽ đánh cho anh tỉnh ra."
  },
  {
    "idx": 8716,
    "start": "04:03:49,880",
    "end": "04:03:51,620",
    "start_sec": 14629.88,
    "end_sec": 14631.62,
    "zh": "无效化能力发动",
    "vi": "Kích hoạt năng lực vô hiệu hóa."
  },
  {
    "idx": 8717,
    "start": "04:03:51,620",
    "end": "04:03:53,380",
    "start_sec": 14631.62,
    "end_sec": 14633.38,
    "zh": "听见上和鬼线方通通",
    "vi": "Mất đi sự hỗ trợ của sợi chỉ quỷ"
  },
  {
    "idx": 8718,
    "start": "04:03:53,380",
    "end": "04:03:54,160",
    "start_sec": 14633.38,
    "end_sec": 14634.16,
    "zh": "没老数",
    "vi": "chỉ dựa vào"
  },
  {
    "idx": 8719,
    "start": "04:03:54,160",
    "end": "04:03:55,460",
    "start_sec": 14634.16,
    "end_sec": 14635.46,
    "zh": "发自给自身的力量",
    "vi": "sức mạnh tự thân của mình"
  },
  {
    "idx": 8720,
    "start": "04:03:55,460",
    "end": "04:03:56,760",
    "start_sec": 14635.46,
    "end_sec": 14636.76,
    "zh": "必须零二六",
    "vi": "thì 026"
  },
  {
    "idx": 8721,
    "start": "04:03:56,760",
    "end": "04:03:59,260",
    "start_sec": 14636.76,
    "end_sec": 14639.26,
    "zh": "更没有能与成者皮抗衡的资本",
    "vi": "càng không có vốn liếng để chống lại Trình Tử Bì."
  },
  {
    "idx": 8722,
    "start": "04:03:59,260",
    "end": "04:04:00,100",
    "start_sec": 14639.26,
    "end_sec": 14640.1,
    "zh": "成者皮",
    "vi": "Trình Tử Bì."
  },
  {
    "idx": 8723,
    "start": "04:04:00,100",
    "end": "04:04:00,400",
    "start_sec": 14640.1,
    "end_sec": 14640.4,
    "zh": "你",
    "vi": "Anh."
  },
  {
    "idx": 8724,
    "start": "04:04:00,400",
    "end": "04:04:01,400",
    "start_sec": 14640.4,
    "end_sec": 14641.4,
    "zh": "我什么王子",
    "vi": "Tôi cái gì mà tôi."
  },
  {
    "idx": 8725,
    "start": "04:04:01,400",
    "end": "04:04:02,320",
    "start_sec": 14641.4,
    "end_sec": 14642.32,
    "zh": "你脑子清醒了没有",
    "vi": "Đầu óc anh đã tỉnh táo lại chưa."
  },
  {
    "idx": 8726,
    "start": "04:04:02,320",
    "end": "04:04:03,700",
    "start_sec": 14642.32,
    "end_sec": 14643.7,
    "zh": "你觉得我真要看许天之",
    "vi": "Anh nghĩ nếu tôi thực sự muốn giết Hứa Thiên Chi"
  },
  {
    "idx": 8727,
    "start": "04:04:03,700",
    "end": "04:04:04,620",
    "start_sec": 14643.7,
    "end_sec": 14644.62,
    "zh": "需要绕过你吗",
    "vi": "thì cần phải né anh sao."
  },
  {
    "idx": 8728,
    "start": "04:04:04,620",
    "end": "04:04:06,360",
    "start_sec": 14644.62,
    "end_sec": 14646.36,
    "zh": "我大可以连他带你一起宰了",
    "vi": "Tôi hoàn toàn có thể giết cả anh lẫn ông ta."
  },
  {
    "idx": 8729,
    "start": "04:04:06,360",
    "end": "04:04:08,100",
    "start_sec": 14646.36,
    "end_sec": 14648.1,
    "zh": "你在这拼的身上诡异复苏",
    "vi": "Anh ở đây liều mạng để quỷ dị thức tỉnh"
  },
  {
    "idx": 8730,
    "start": "04:04:08,100",
    "end": "04:04:08,880",
    "start_sec": 14648.1,
    "end_sec": 14648.88,
    "zh": "也和我斗",
    "vi": "mà cũng đòi đấu với tôi sao."
  },
  {
    "idx": 8731,
    "start": "04:04:08,880",
    "end": "04:04:10,080",
    "start_sec": 14648.88,
    "end_sec": 14650.08,
    "zh": "你成谁的女人",
    "vi": "Anh nghĩ tôi là người phụ nữ của ai chứ."
  },
  {
    "idx": 8732,
    "start": "04:04:10,080",
    "end": "04:04:11,680",
    "start_sec": 14650.08,
    "end_sec": 14651.68,
    "zh": "成者皮虽然架了动手",
    "vi": "Trình Tử Bì tuy đã ra tay"
  },
  {
    "idx": 8733,
    "start": "04:04:11,680",
    "end": "04:04:13,300",
    "start_sec": 14651.68,
    "end_sec": 14653.3,
    "zh": "但也不可能杀了零二六",
    "vi": "nhưng cũng không thể giết 026."
  },
  {
    "idx": 8734,
    "start": "04:04:13,300",
    "end": "04:04:14,360",
    "start_sec": 14653.3,
    "end_sec": 14654.36,
    "zh": "毕竟船长没了",
    "vi": "Dù sao thì thuyền trưởng cũng mất rồi."
  },
  {
    "idx": 8735,
    "start": "04:04:14,360",
    "end": "04:04:16,540",
    "start_sec": 14654.36,
    "end_sec": 14656.54,
    "zh": "零二六充当了推进邮轮的角色",
    "vi": "026 đang đóng vai trò đẩy du thuyền đi tiếp."
  },
  {
    "idx": 8736,
    "start": "04:04:16,540",
    "end": "04:04:17,320",
    "start_sec": 14656.54,
    "end_sec": 14657.32,
    "zh": "把他杀了",
    "vi": "Nếu giết anh ta"
  },
  {
    "idx": 8737,
    "start": "04:04:17,320",
    "end": "04:04:19,400",
    "start_sec": 14657.32,
    "end_sec": 14659.4,
    "zh": "就意味着这次任务也直接结束了",
    "vi": "thì cũng đồng nghĩa với việc nhiệm vụ lần này sẽ kết thúc luôn."
  },
  {
    "idx": 8738,
    "start": "04:04:19,400",
    "end": "04:04:20,860",
    "start_sec": 14659.4,
    "end_sec": 14660.86,
    "zh": "你真的没杀许初",
    "vi": "Anh thực sự không giết Hứa Sơ sao."
  },
  {
    "idx": 8739,
    "start": "04:04:20,860",
    "end": "04:04:22,420",
    "start_sec": 14660.86,
    "end_sec": 14662.42,
    "zh": "我有病要招仇恨吗",
    "vi": "Tôi bị điên sao mà lại đi chuốc thêm hận thù."
  },
  {
    "idx": 8740,
    "start": "04:04:22,420",
    "end": "04:04:23,060",
    "start_sec": 14662.42,
    "end_sec": 14663.06,
    "zh": "026",
    "vi": "026."
  },
  {
    "idx": 8741,
    "start": "04:04:23,060",
    "end": "04:04:24,400",
    "start_sec": 14663.06,
    "end_sec": 14664.4,
    "zh": "你又犯什么病",
    "vi": "Anh lại phát điên cái gì thế."
  },
  {
    "idx": 8742,
    "start": "04:04:24,400",
    "end": "04:04:25,780",
    "start_sec": 14664.4,
    "end_sec": 14665.78,
    "zh": "船怎么又停了",
    "vi": "Sao thuyền lại dừng rồi."
  },
  {
    "idx": 8743,
    "start": "04:04:25,780",
    "end": "04:04:27,260",
    "start_sec": 14665.78,
    "end_sec": 14667.26,
    "zh": "你们俩搞什么呢",
    "vi": "Hai người đang làm cái gì thế."
  },
  {
    "idx": 8744,
    "start": "04:04:27,260",
    "end": "04:04:28,300",
    "start_sec": 14667.26,
    "end_sec": 14668.3,
    "zh": "是他自己犯病",
    "vi": "Là tự anh ta phát điên"
  },
  {
    "idx": 8745,
    "start": "04:04:28,300",
    "end": "04:04:29,300",
    "start_sec": 14668.3,
    "end_sec": 14669.3,
    "zh": "被鬼骗了",
    "vi": "bị quỷ lừa rồi."
  },
  {
    "idx": 8746,
    "start": "04:04:29,300",
    "end": "04:04:30,100",
    "start_sec": 14669.3,
    "end_sec": 14670.1,
    "zh": "行了",
    "vi": "Được rồi."
  },
  {
    "idx": 8747,
    "start": "04:04:30,100",
    "end": "04:04:30,860",
    "start_sec": 14670.1,
    "end_sec": 14670.86,
    "zh": "跟我走",
    "vi": "Đi theo tôi."
  },
  {
    "idx": 8748,
    "start": "04:04:30,860",
    "end": "04:04:33,340",
    "start_sec": 14670.86,
    "end_sec": 14673.34,
    "zh": "赶紧让曙光号驶离水雾区",
    "vi": "mau chóng để tàu Bình Minh rời khỏi vùng sương mù."
  },
  {
    "idx": 8749,
    "start": "04:04:33,340",
    "end": "04:04:35,460",
    "start_sec": 14673.34,
    "end_sec": 14675.46,
    "zh": "不",
    "vi": "Không."
  },
  {
    "idx": 8750,
    "start": "04:04:35,460",
    "end": "04:04:35,800",
    "start_sec": 14675.46,
    "end_sec": 14675.8,
    "zh": "不对",
    "vi": "Không đúng."
  },
  {
    "idx": 8751,
    "start": "04:04:35,800",
    "end": "04:04:36,740",
    "start_sec": 14675.8,
    "end_sec": 14676.74,
    "zh": "你不是023",
    "vi": "Anh không phải 023."
  },
  {
    "idx": 8752,
    "start": "04:04:36,740",
    "end": "04:04:38,840",
    "start_sec": 14676.74,
    "end_sec": 14678.84,
    "zh": "023怎么会亲手拉我呢",
    "vi": "023 sao có thể tự tay kéo tôi chứ."
  },
  {
    "idx": 8753,
    "start": "04:04:38,840",
    "end": "04:04:39,220",
    "start_sec": 14678.84,
    "end_sec": 14679.22,
    "zh": "文言",
    "vi": "Nghe vậy"
  },
  {
    "idx": 8754,
    "start": "04:04:39,220",
    "end": "04:04:41,120",
    "start_sec": 14679.22,
    "end_sec": 14681.12,
    "zh": "程子皮当即使用排面方",
    "vi": "Trình Tử Bì lập tức sử dụng lá bài của mình."
  },
  {
    "idx": 8755,
    "start": "04:04:41,120",
    "end": "04:04:41,820",
    "start_sec": 14681.12,
    "end_sec": 14681.82,
    "zh": "下一刻",
    "vi": "Ngay sau đó"
  },
  {
    "idx": 8756,
    "start": "04:04:41,820",
    "end": "04:04:43,900",
    "start_sec": 14681.82,
    "end_sec": 14683.9,
    "zh": "023的身体开始冒出水面",
    "vi": "cơ thể của 023 bắt đầu nổi lên mặt nước."
  },
  {
    "idx": 8757,
    "start": "04:04:43,900",
    "end": "04:04:45,300",
    "start_sec": 14683.9,
    "end_sec": 14685.3,
    "zh": "不愧是遇鬼者",
    "vi": "Không hổ danh là người ngự quỷ"
  },
  {
    "idx": 8758,
    "start": "04:04:45,300",
    "end": "04:04:46,560",
    "start_sec": 14685.3,
    "end_sec": 14686.56,
    "zh": "反应倒是挺快",
    "vi": "phản ứng nhanh đấy."
  },
  {
    "idx": 8759,
    "start": "04:04:46,560",
    "end": "04:04:47,160",
    "start_sec": 14686.56,
    "end_sec": 14687.16,
    "zh": "不过",
    "vi": "Nhưng mà"
  },
  {
    "idx": 8760,
    "start": "04:04:47,160",
    "end": "04:04:48,640",
    "start_sec": 14687.16,
    "end_sec": 14688.64,
    "zh": "退船下去后",
    "vi": "sau khi xuống thuyền"
  },
  {
    "idx": 8761,
    "start": "04:04:48,640",
    "end": "04:04:49,860",
    "start_sec": 14688.64,
    "end_sec": 14689.86,
    "zh": "026眼白一番",
    "vi": "026 trợn ngược mắt."
  },
  {
    "idx": 8762,
    "start": "04:04:49,860",
    "end": "04:04:50,700",
    "start_sec": 14689.86,
    "end_sec": 14690.7,
    "zh": "特地晕倒",
    "vi": "Ngất xỉu ngay lập tức."
  },
  {
    "idx": 8763,
    "start": "04:04:50,700",
    "end": "04:04:52,580",
    "start_sec": 14690.7,
    "end_sec": 14692.58,
    "zh": "在鬼面窗的凝视下",
    "vi": "Dưới ánh nhìn của cửa sổ mặt quỷ."
  },
  {
    "idx": 8764,
    "start": "04:04:52,580",
    "end": "04:04:54,880",
    "start_sec": 14692.58,
    "end_sec": 14694.88,
    "zh": "023的身体也蒸发消散",
    "vi": "Cơ thể của 023 cũng bốc hơi tan biến."
  },
  {
    "idx": 8765,
    "start": "04:04:54,880",
    "end": "04:04:59,150",
    "start_sec": 14694.88,
    "end_sec": 14699.15,
    "zh": "要不是你有开船的用处老子还真不想管你随手将026丢在地上,橙子皮把门又装了进去她现在要做的就是保证去见屋内安检刚刚那诡异将026击晕,难道是为了信住我",
    "vi": "Nếu không phải vì ngươi còn có ích trong việc lái tàu thì ta chẳng buồn quan tâm"
  },
  {
    "idx": 8765,
    "start": "04:04:59,150",
    "end": "04:05:01,285",
    "start_sec": 14699.15,
    "end_sec": 14701.285,
    "zh": "要不是你有开船的用处老子还真不想管你随手将026丢在地上,橙子皮把门又装了进去她现在要做的就是保证去见屋内安检刚刚那诡异将026击晕,难道是为了信住我",
    "vi": "Ta vứt 026 xuống đất rồi đóng cửa lại"
  },
  {
    "idx": 8765,
    "start": "04:05:01,285",
    "end": "04:05:04,131",
    "start_sec": 14701.285,
    "end_sec": 14704.131,
    "zh": "要不是你有开船的用处老子还真不想管你随手将026丢在地上,橙子皮把门又装了进去她现在要做的就是保证去见屋内安检刚刚那诡异将026击晕,难道是为了信住我",
    "vi": "Việc cần làm bây giờ là đảm bảo an toàn trong phòng"
  },
  {
    "idx": 8765,
    "start": "04:05:04,131",
    "end": "04:05:07,926",
    "start_sec": 14704.131,
    "end_sec": 14707.926,
    "zh": "要不是你有开船的用处老子还真不想管你随手将026丢在地上,橙子皮把门又装了进去她现在要做的就是保证去见屋内安检刚刚那诡异将026击晕,难道是为了信住我",
    "vi": "Vừa rồi thực thể kỳ quái đó đánh ngất 026, chẳng lẽ là để lừa ta"
  },
  {
    "idx": 8766,
    "start": "04:05:07,926",
    "end": "04:05:10,686",
    "start_sec": 14707.926,
    "end_sec": 14710.686,
    "zh": "思索着门外又传来敲门声,谁",
    "vi": "Đang suy nghĩ thì ngoài cửa có tiếng gõ. Ai đó."
  },
  {
    "idx": 8767,
    "start": "04:05:10,686",
    "end": "04:05:16,046",
    "start_sec": 14710.686,
    "end_sec": 14716.046,
    "zh": "我,023,你们搞什么鬼,我刚刚听到二楼有打斗声",
    "vi": "Là ta 023 đây. Các ngươi làm cái trò gì vậy. Ta vừa nghe thấy tiếng đánh nhau trên tầng hai."
  },
  {
    "idx": 8768,
    "start": "04:05:16,046",
    "end": "04:05:16,663",
    "start_sec": 14716.046,
    "end_sec": 14716.663,
    "zh": "026呢,是不是在你这,船怎么停了,快让他开船,这里不对劲",
    "vi": "026 đâu rồi"
  },
  {
    "idx": 8768,
    "start": "04:05:16,663",
    "end": "04:05:18,307",
    "start_sec": 14716.663,
    "end_sec": 14718.307,
    "zh": "026呢,是不是在你这,船怎么停了,快让他开船,这里不对劲",
    "vi": "Có phải đang ở chỗ các ngươi không"
  },
  {
    "idx": 8768,
    "start": "04:05:18,307",
    "end": "04:05:19,335",
    "start_sec": 14718.307,
    "end_sec": 14719.335,
    "zh": "026呢,是不是在你这,船怎么停了,快让他开船,这里不对劲",
    "vi": "Sao tàu dừng lại rồi"
  },
  {
    "idx": 8768,
    "start": "04:05:19,335",
    "end": "04:05:20,568",
    "start_sec": 14719.335,
    "end_sec": 14720.568,
    "zh": "026呢,是不是在你这,船怎么停了,快让他开船,这里不对劲",
    "vi": "Mau bảo hắn lái tàu đi"
  },
  {
    "idx": 8768,
    "start": "04:05:20,568",
    "end": "04:05:22,006",
    "start_sec": 14720.568,
    "end_sec": 14722.006,
    "zh": "026呢,是不是在你这,船怎么停了,快让他开船,这里不对劲",
    "vi": "Ở đây có gì đó không ổn"
  },
  {
    "idx": 8769,
    "start": "04:05:22,006",
    "end": "04:05:26,046",
    "start_sec": 14722.006,
    "end_sec": 14726.046,
    "zh": "你如何证明自己就是023呢",
    "vi": "Ngươi làm sao chứng minh mình chính là 023."
  },
  {
    "idx": 8770,
    "start": "04:05:26,046",
    "end": "04:05:27,146",
    "start_sec": 14726.046,
    "end_sec": 14727.146,
    "zh": "好好好",
    "vi": "Được được được."
  },
  {
    "idx": 8771,
    "start": "04:05:27,146",
    "end": "04:05:29,106",
    "start_sec": 14727.146,
    "end_sec": 14729.106,
    "zh": "你小子不愧是我看上的人",
    "vi": "Ngươi quả không hổ danh là người ta đã chọn."
  },
  {
    "idx": 8772,
    "start": "04:05:29,106",
    "end": "04:05:30,346",
    "start_sec": 14729.106,
    "end_sec": 14730.346,
    "zh": "我怎么证明自己",
    "vi": "Ta chứng minh thế nào đây."
  },
  {
    "idx": 8773,
    "start": "04:05:30,346",
    "end": "04:05:32,366",
    "start_sec": 14730.346,
    "end_sec": 14732.366,
    "zh": "那还不简单",
    "vi": "Chuyện đó thì có gì khó."
  },
  {
    "idx": 8774,
    "start": "04:05:32,366",
    "end": "04:05:33,026",
    "start_sec": 14732.366,
    "end_sec": 14733.026,
    "zh": "话一落下",
    "vi": "Dứt lời."
  },
  {
    "idx": 8775,
    "start": "04:05:33,026",
    "end": "04:05:34,586",
    "start_sec": 14733.026,
    "end_sec": 14734.586,
    "zh": "023化为一缕白烟",
    "vi": "023 hóa thành một làn khói trắng."
  },
  {
    "idx": 8776,
    "start": "04:05:34,586",
    "end": "04:05:36,306",
    "start_sec": 14734.586,
    "end_sec": 14736.306,
    "zh": "从门缝里飘进屋里",
    "vi": "Bay qua khe cửa vào trong phòng."
  },
  {
    "idx": 8777,
    "start": "04:05:36,306",
    "end": "04:05:38,286",
    "start_sec": 14736.306,
    "end_sec": 14738.286,
    "zh": "简直橙子皮才松了头巾",
    "vi": "Lúc này ta mới thở phào nhẹ nhõm."
  },
  {
    "idx": 8778,
    "start": "04:05:38,286",
    "end": "04:05:39,486",
    "start_sec": 14738.286,
    "end_sec": 14739.486,
    "zh": "刚刚有个假的你",
    "vi": "Vừa rồi có một kẻ giả mạo ngươi."
  },
  {
    "idx": 8779,
    "start": "04:05:39,486",
    "end": "04:05:40,226",
    "start_sec": 14739.486,
    "end_sec": 14740.226,
    "zh": "找到这里",
    "vi": "Tìm đến đây."
  },
  {
    "idx": 8780,
    "start": "04:05:40,226",
    "end": "04:05:41,506",
    "start_sec": 14740.226,
    "end_sec": 14741.506,
    "zh": "026敲晕了",
    "vi": "Đánh ngất 026 rồi."
  },
  {
    "idx": 8781,
    "start": "04:05:41,506",
    "end": "04:05:42,546",
    "start_sec": 14741.506,
    "end_sec": 14742.546,
    "zh": "现在他昏迷了",
    "vi": "Giờ hắn đang hôn mê."
  },
  {
    "idx": 8782,
    "start": "04:05:42,546",
    "end": "04:05:43,186",
    "start_sec": 14742.546,
    "end_sec": 14743.186,
    "zh": "我们怎么办",
    "vi": "Chúng ta phải làm sao."
  },
  {
    "idx": 8783,
    "start": "04:05:43,186",
    "end": "04:05:44,946",
    "start_sec": 14743.186,
    "end_sec": 14744.946,
    "zh": "是等他醒了再开船吗",
    "vi": "Có đợi hắn tỉnh lại rồi mới lái tàu không."
  },
  {
    "idx": 8784,
    "start": "04:05:44,946",
    "end": "04:05:45,666",
    "start_sec": 14744.946,
    "end_sec": 14745.666,
    "zh": "027",
    "vi": "027."
  },
  {
    "idx": 8785,
    "start": "04:05:45,666",
    "end": "04:05:46,826",
    "start_sec": 14745.666,
    "end_sec": 14746.826,
    "zh": "你有没有觉得",
    "vi": "Ngươi có thấy không."
  },
  {
    "idx": 8786,
    "start": "04:05:46,826",
    "end": "04:05:48,566",
    "start_sec": 14746.826,
    "end_sec": 14748.566,
    "zh": "这一切来的太突然了",
    "vi": "Mọi chuyện xảy ra quá đột ngột."
  },
  {
    "idx": 8787,
    "start": "04:05:48,566",
    "end": "04:05:49,306",
    "start_sec": 14748.566,
    "end_sec": 14749.306,
    "zh": "怎么说",
    "vi": "Sao lại nói vậy."
  },
  {
    "idx": 8788,
    "start": "04:05:49,306",
    "end": "04:05:51,066",
    "start_sec": 14749.306,
    "end_sec": 14751.066,
    "zh": "船上升起雾后",
    "vi": "Sau khi sương mù bao phủ con tàu."
  },
  {
    "idx": 8789,
    "start": "04:05:51,066",
    "end": "04:05:53,526",
    "start_sec": 14751.066,
    "end_sec": 14753.526,
    "zh": "那鬼异就直接找上和026",
    "vi": "Thực thể đó đã nhắm thẳng vào ngươi và 026."
  },
  {
    "idx": 8790,
    "start": "04:05:53,526",
    "end": "04:05:55,386",
    "start_sec": 14753.526,
    "end_sec": 14755.386,
    "zh": "你俩的作用不言而喻",
    "vi": "Vai trò của hai ngươi đã quá rõ ràng rồi."
  },
  {
    "idx": 8791,
    "start": "04:05:55,386",
    "end": "04:05:57,346",
    "start_sec": 14755.386,
    "end_sec": 14757.346,
    "zh": "他分明是想消灭你们",
    "vi": "Hắn rõ ràng là muốn tiêu diệt các anh."
  },
  {
    "idx": 8792,
    "start": "04:05:57,346",
    "end": "04:05:59,286",
    "start_sec": 14757.346,
    "end_sec": 14759.286,
    "zh": "相处光耗彻底掌控",
    "vi": "Để có thể kiểm soát hoàn toàn mọi thứ."
  },
  {
    "idx": 8793,
    "start": "04:05:59,286",
    "end": "04:06:00,226",
    "start_sec": 14759.286,
    "end_sec": 14760.226,
    "zh": "这点我知道",
    "vi": "Điều này tôi biết."
  },
  {
    "idx": 8794,
    "start": "04:06:00,226",
    "end": "04:06:01,646",
    "start_sec": 14760.226,
    "end_sec": 14761.646,
    "zh": "但是那个鬼异",
    "vi": "Nhưng mà thực thể kỳ dị đó."
  },
  {
    "idx": 8795,
    "start": "04:06:01,646",
    "end": "04:06:03,666",
    "start_sec": 14761.646,
    "end_sec": 14763.666,
    "zh": "为什么会知道我和026有矛盾",
    "vi": "Tại sao lại biết tôi và 026 có mâu thuẫn."
  },
  {
    "idx": 8796,
    "start": "04:06:03,666",
    "end": "04:06:04,706",
    "start_sec": 14763.666,
    "end_sec": 14764.706,
    "zh": "而从中作梗呢",
    "vi": "Mà đứng sau gây rối chứ."
  },
  {
    "idx": 8797,
    "start": "04:06:04,706",
    "end": "04:06:05,266",
    "start_sec": 14764.706,
    "end_sec": 14765.266,
    "zh": "不是",
    "vi": "Không phải."
  },
  {
    "idx": 8798,
    "start": "04:06:05,266",
    "end": "04:06:06,406",
    "start_sec": 14765.266,
    "end_sec": 14766.406,
    "zh": "你的意思是",
    "vi": "Ý của anh là."
  },
  {
    "idx": 8799,
    "start": "04:06:06,406",
    "end": "04:06:07,706",
    "start_sec": 14766.406,
    "end_sec": 14767.706,
    "zh": "刚才打斗的动静",
    "vi": "Tiếng động đánh nhau vừa rồi."
  },
  {
    "idx": 8800,
    "start": "04:06:07,706",
    "end": "04:06:09,546",
    "start_sec": 14767.706,
    "end_sec": 14769.546,
    "zh": "是你和026搞出来的",
    "vi": "Là do anh và 026 gây ra sao."
  },
  {
    "idx": 8801,
    "start": "04:06:09,546",
    "end": "04:06:11,066",
    "start_sec": 14769.546,
    "end_sec": 14771.066,
    "zh": "两人皆是陷入沉思",
    "vi": "Cả hai người đều chìm vào suy nghĩ."
  },
  {
    "idx": 8802,
    "start": "04:06:11,066",
    "end": "04:06:12,386",
    "start_sec": 14771.066,
    "end_sec": 14772.386,
    "zh": "屋内安静起来",
    "vi": "Căn phòng trở nên yên tĩnh."
  },
  {
    "idx": 8803,
    "start": "04:06:12,386",
    "end": "04:06:15,626",
    "start_sec": 14772.386,
    "end_sec": 14775.626,
    "zh": "好像我们的一切都在被无形的计划着",
    "vi": "Giống như mọi thứ của chúng ta đều đang bị lên kế hoạch một cách vô hình."
  },
  {
    "idx": 8804,
    "start": "04:06:15,626",
    "end": "04:06:17,186",
    "start_sec": 14775.626,
    "end_sec": 14777.186,
    "zh": "这个鬼异很聪明",
    "vi": "Thực thể kỳ dị này rất thông minh."
  },
  {
    "idx": 8805,
    "start": "04:06:17,186",
    "end": "04:06:18,346",
    "start_sec": 14777.186,
    "end_sec": 14778.346,
    "zh": "糟了",
    "vi": "Hỏng rồi."
  },
  {
    "idx": 8806,
    "start": "04:06:18,346",
    "end": "04:06:20,006",
    "start_sec": 14778.346,
    "end_sec": 14780.006,
    "zh": "我们都在这间屋子里",
    "vi": "Tất cả chúng ta đều đang ở trong căn phòng này."
  },
  {
    "idx": 8807,
    "start": "04:06:20,006",
    "end": "04:06:21,766",
    "start_sec": 14780.006,
    "end_sec": 14781.766,
    "zh": "橙子皮看了一下023",
    "vi": "Trần Tử Bì nhìn 023 một cái."
  },
  {
    "idx": 8808,
    "start": "04:06:21,766",
    "end": "04:06:23,266",
    "start_sec": 14781.766,
    "end_sec": 14783.266,
    "zh": "瞬间明白了他的意思",
    "vi": "Ngay lập tức hiểu được ý của anh ta."
  },
  {
    "idx": 8809,
    "start": "04:06:23,266",
    "end": "04:06:25,346",
    "start_sec": 14783.266,
    "end_sec": 14785.346,
    "zh": "修克山和古晋还在谈掌事",
    "vi": "Tu Khắc Sơn và Cổ Tấn vẫn đang bàn việc quản sự."
  },
  {
    "idx": 8810,
    "start": "04:06:25,346",
    "end": "04:06:26,626",
    "start_sec": 14785.346,
    "end_sec": 14786.626,
    "zh": "我去一趟吧",
    "vi": "Để tôi đi một chuyến."
  },
  {
    "idx": 8811,
    "start": "04:06:26,626",
    "end": "04:06:28,486",
    "start_sec": 14786.626,
    "end_sec": 14788.486,
    "zh": "023虽然能抵御诡异",
    "vi": "023 tuy có thể chống lại thực thể kỳ dị."
  },
  {
    "idx": 8812,
    "start": "04:06:28,486",
    "end": "04:06:29,766",
    "start_sec": 14788.486,
    "end_sec": 14789.766,
    "zh": "但不能分辨诡异",
    "vi": "Nhưng không thể phân biệt được thực thể kỳ dị."
  },
  {
    "idx": 8813,
    "start": "04:06:29,766",
    "end": "04:06:31,186",
    "start_sec": 14789.766,
    "end_sec": 14791.186,
    "zh": "只能橙子皮自己去",
    "vi": "Chỉ có thể để Trần Tử Bì tự đi."
  },
  {
    "idx": 8814,
    "start": "04:06:31,186",
    "end": "04:06:32,166",
    "start_sec": 14791.186,
    "end_sec": 14792.166,
    "zh": "留下023",
    "vi": "Để 023 ở lại."
  },
  {
    "idx": 8815,
    "start": "04:06:32,166",
    "end": "04:06:34,246",
    "start_sec": 14792.166,
    "end_sec": 14794.246,
    "zh": "看守着周扬和昏迷的026",
    "vi": "Canh giữ Chu Dương và 026 đang hôn mê."
  },
  {
    "idx": 8816,
    "start": "04:06:34,246",
    "end": "04:06:35,746",
    "start_sec": 14794.246,
    "end_sec": 14795.746,
    "zh": "才是最稳妥的办法",
    "vi": "Mới là cách an toàn nhất."
  },
  {
    "idx": 8817,
    "start": "04:06:35,746",
    "end": "04:06:38,626",
    "start_sec": 14795.746,
    "end_sec": 14798.626,
    "zh": "橙子皮现在穿上危机似服",
    "vi": "Trần Tử Bì bây giờ mặc vào bộ đồ bảo hộ."
  },
  {
    "idx": 8818,
    "start": "04:06:38,626",
    "end": "04:06:41,446",
    "start_sec": 14798.626,
    "end_sec": 14801.446,
    "zh": "能看清局势的只有你了",
    "vi": "Người có thể nhìn rõ cục diện lúc này chỉ có anh thôi."
  },
  {
    "idx": 8819,
    "start": "04:06:41,446",
    "end": "04:06:45,406",
    "start_sec": 14801.446,
    "end_sec": 14805.406,
    "zh": "走道里的水雾愈发浓厚",
    "vi": "Sương mù trong hành lang ngày càng dày đặc."
  },
  {
    "idx": 8820,
    "start": "04:06:45,406",
    "end": "04:06:47,726",
    "start_sec": 14805.406,
    "end_sec": 14807.726,
    "zh": "连空气中都是湿漉漉的水迹",
    "vi": "Đến cả trong không khí cũng đầy những vệt nước ẩm ướt."
  },
  {
    "idx": 8821,
    "start": "04:06:47,726",
    "end": "04:06:48,966",
    "start_sec": 14807.726,
    "end_sec": 14808.966,
    "zh": "可见度仅有两米",
    "vi": "Tầm nhìn chỉ còn hai mét."
  },
  {
    "idx": 8822,
    "start": "04:06:48,966",
    "end": "04:06:51,546",
    "start_sec": 14808.966,
    "end_sec": 14811.546,
    "zh": "橙子皮凭借着记忆找到船长室",
    "vi": "Trần Tử Bì dựa vào ký ức tìm đến phòng thuyền trưởng."
  },
  {
    "idx": 8823,
    "start": "04:06:51,546",
    "end": "04:06:52,926",
    "start_sec": 14811.546,
    "end_sec": 14812.926,
    "zh": "朱叔",
    "vi": "Chú Chu"
  },
  {
    "idx": 8824,
    "start": "04:06:52,926",
    "end": "04:06:53,626",
    "start_sec": 14812.926,
    "end_sec": 14813.626,
    "zh": "朱司长",
    "vi": "Trưởng phòng Chu"
  },
  {
    "idx": 8825,
    "start": "04:06:53,626",
    "end": "04:06:54,326",
    "start_sec": 14813.626,
    "end_sec": 14814.326,
    "zh": "在吗",
    "vi": "Ở đó không"
  },
  {
    "idx": 8826,
    "start": "04:06:54,326",
    "end": "04:06:56,826",
    "start_sec": 14814.326,
    "end_sec": 14816.826,
    "zh": "人呢",
    "vi": "Người đâu rồi"
  },
  {
    "idx": 8827,
    "start": "04:06:56,826",
    "end": "04:06:57,766",
    "start_sec": 14816.826,
    "end_sec": 14817.766,
    "zh": "不会出事了吧",
    "vi": "Không xảy ra chuyện gì chứ"
  },
  {
    "idx": 8828,
    "start": "04:06:57,766",
    "end": "04:06:59,406",
    "start_sec": 14817.766,
    "end_sec": 14819.406,
    "zh": "小墨记也应该在这里",
    "vi": "Tiểu Mặc Ký cũng nên ở đây."
  },
  {
    "idx": 8829,
    "start": "04:06:59,406",
    "end": "04:07:00,586",
    "start_sec": 14819.406,
    "end_sec": 14820.586,
    "zh": "小墨记",
    "vi": "Tiểu Mặc Ký"
  },
  {
    "idx": 8830,
    "start": "04:07:00,586",
    "end": "04:07:01,686",
    "start_sec": 14820.586,
    "end_sec": 14821.686,
    "zh": "小墨记",
    "vi": "Tiểu Mặc Ký"
  },
  {
    "idx": 8831,
    "start": "04:07:01,686",
    "end": "04:07:02,926",
    "start_sec": 14821.686,
    "end_sec": 14822.926,
    "zh": "忽化了几句",
    "vi": "Đã biến mất vài câu."
  },
  {
    "idx": 8832,
    "start": "04:07:02,926",
    "end": "04:07:05,046",
    "start_sec": 14822.926,
    "end_sec": 14825.046,
    "zh": "船长室内依旧毫无反应",
    "vi": "Trong phòng thuyền trưởng vẫn không có phản ứng gì."
  },
  {
    "idx": 8833,
    "start": "04:07:05,046",
    "end": "04:07:05,566",
    "start_sec": 14825.046,
    "end_sec": 14825.566,
    "zh": "更哪",
    "vi": "Còn đâu"
  },
  {
    "idx": 8834,
    "start": "04:07:05,566",
    "end": "04:07:07,046",
    "start_sec": 14825.566,
    "end_sec": 14827.046,
    "zh": "在一栋迷戚的角落里",
    "vi": "Trong một góc khuất của mê cung"
  },
  {
    "idx": 8835,
    "start": "04:07:07,046",
    "end": "04:07:09,346",
    "start_sec": 14827.046,
    "end_sec": 14829.346,
    "zh": "橙子皮看见了一面朴朴的镜子",
    "vi": "Trần Tử Bì nhìn thấy một chiếc gương cũ kỹ."
  },
  {
    "idx": 8836,
    "start": "04:07:09,346",
    "end": "04:07:11,006",
    "start_sec": 14829.346,
    "end_sec": 14831.006,
    "zh": "这就是周家的古镜",
    "vi": "Đây chính là cổ kính nhà họ Chu."
  },
  {
    "idx": 8837,
    "start": "04:07:11,006",
    "end": "04:07:13,486",
    "start_sec": 14831.006,
    "end_sec": 14833.486,
    "zh": "橙子皮伸手凑换了一下镜子",
    "vi": "Trần Tử Bì đưa tay chạm vào chiếc gương."
  },
  {
    "idx": 8838,
    "start": "04:07:13,486",
    "end": "04:07:15,666",
    "start_sec": 14833.486,
    "end_sec": 14835.666,
    "zh": "没想到竟然直接伸到镜子里",
    "vi": "Không ngờ tay lại xuyên thẳng vào gương."
  },
  {
    "idx": 8839,
    "start": "04:07:15,666",
    "end": "04:07:16,786",
    "start_sec": 14835.666,
    "end_sec": 14836.786,
    "zh": "什么情况",
    "vi": "Chuyện gì vậy"
  },
  {
    "idx": 8840,
    "start": "04:07:16,786",
    "end": "04:07:17,446",
    "start_sec": 14836.786,
    "end_sec": 14837.446,
    "zh": "该不会",
    "vi": "Chẳng lẽ"
  },
  {
    "idx": 8841,
    "start": "04:07:17,446",
    "end": "04:07:18,866",
    "start_sec": 14837.446,
    "end_sec": 14838.866,
    "zh": "周克山开启了古镜",
    "vi": "Chu Khắc Sơn đã kích hoạt cổ kính"
  },
  {
    "idx": 8842,
    "start": "04:07:18,866",
    "end": "04:07:21,186",
    "start_sec": 14838.866,
    "end_sec": 14841.186,
    "zh": "看着小木屐和小黑子进了鬼域吧",
    "vi": "Và nhìn Tiểu Mộc Ký, Tiểu Hắc Tử vào Quỷ Vực sao."
  },
  {
    "idx": 8843,
    "start": "04:07:21,186",
    "end": "04:07:22,686",
    "start_sec": 14841.186,
    "end_sec": 14842.686,
    "zh": "长子皮犹豫天地",
    "vi": "Trần Tử Bì do dự."
  },
  {
    "idx": 8844,
    "start": "04:07:22,686",
    "end": "04:07:24,186",
    "start_sec": 14842.686,
    "end_sec": 14844.186,
    "zh": "抬脚迈进主境中",
    "vi": "Bước chân vào trong gương."
  },
  {
    "idx": 8845,
    "start": "04:07:24,186",
    "end": "04:07:25,606",
    "start_sec": 14844.186,
    "end_sec": 14845.606,
    "zh": "随即视线一黑",
    "vi": "Sau đó tầm nhìn tối sầm lại."
  },
  {
    "idx": 8846,
    "start": "04:07:25,606",
    "end": "04:07:26,806",
    "start_sec": 14845.606,
    "end_sec": 14846.806,
    "zh": "再次睁开眼时",
    "vi": "Khi mở mắt ra lần nữa"
  },
  {
    "idx": 8847,
    "start": "04:07:26,806",
    "end": "04:07:29,766",
    "start_sec": 14846.806,
    "end_sec": 14849.766,
    "zh": "忽然发现自己已经出现在一处山洞中",
    "vi": "Bất ngờ phát hiện mình đã xuất hiện trong một hang động."
  },
  {
    "idx": 8848,
    "start": "04:07:29,766",
    "end": "04:07:32,086",
    "start_sec": 14849.766,
    "end_sec": 14852.086,
    "zh": "这就是连接曙光号上的古镜的焦点",
    "vi": "Đây chính là điểm kết nối của cổ kính trên tàu Thức Tỉnh."
  },
  {
    "idx": 8849,
    "start": "04:07:32,086",
    "end": "04:07:35,806",
    "start_sec": 14852.086,
    "end_sec": 14855.806,
    "zh": "长子皮在镜子两边来回穿梭了两三次",
    "vi": "Trần Tử Bì đi đi lại lại giữa hai bên gương vài lần."
  },
  {
    "idx": 8850,
    "start": "04:07:35,806",
    "end": "04:07:38,086",
    "start_sec": 14855.806,
    "end_sec": 14858.086,
    "zh": "一直到确定两界能稳定",
    "vi": "Cho đến khi xác định hai thế giới đã ổn định."
  },
  {
    "idx": 8851,
    "start": "04:07:38,086",
    "end": "04:07:39,466",
    "start_sec": 14858.086,
    "end_sec": 14859.466,
    "zh": "接下来返回山洞",
    "vi": "Tiếp theo quay lại hang động."
  },
  {
    "idx": 8852,
    "start": "04:07:39,466",
    "end": "04:07:40,466",
    "start_sec": 14859.466,
    "end_sec": 14860.466,
    "zh": "向中外走进",
    "vi": "Đi vào bên trong."
  },
  {
    "idx": 8853,
    "start": "04:07:40,466",
    "end": "04:07:41,806",
    "start_sec": 14860.466,
    "end_sec": 14861.806,
    "zh": "洞内的墙壁上",
    "vi": "Trên vách đá trong hang."
  },
  {
    "idx": 8854,
    "start": "04:07:41,806",
    "end": "04:07:43,086",
    "start_sec": 14861.806,
    "end_sec": 14863.086,
    "zh": "透过粘稠的水雾",
    "vi": "Xuyên qua làn sương nước đặc quánh."
  },
  {
    "idx": 8855,
    "start": "04:07:43,086",
    "end": "04:07:44,926",
    "start_sec": 14863.086,
    "end_sec": 14864.926,
    "zh": "能看到一些看不懂的东西",
    "vi": "Có thể nhìn thấy vài thứ không hiểu được."
  },
  {
    "idx": 8856,
    "start": "04:07:44,926",
    "end": "04:07:46,046",
    "start_sec": 14864.926,
    "end_sec": 14866.046,
    "zh": "鬼运窗",
    "vi": "Cửa sổ mặt quỷ."
  },
  {
    "idx": 8857,
    "start": "04:07:46,046",
    "end": "04:07:47,606",
    "start_sec": 14866.046,
    "end_sec": 14867.606,
    "zh": "嘿嘿嘿",
    "vi": "Hì hì hì."
  },
  {
    "idx": 8858,
    "start": "04:07:47,606",
    "end": "04:07:49,306",
    "start_sec": 14867.606,
    "end_sec": 14869.306,
    "zh": "小子,你怎么来鬼域了?",
    "vi": "Nhóc con, sao ngươi lại đến Quỷ Vực rồi."
  },
  {
    "idx": 8859,
    "start": "04:07:49,546",
    "end": "04:07:50,286",
    "start_sec": 14869.546,
    "end_sec": 14870.286,
    "zh": "来这里找人?",
    "vi": "Đến đây tìm người sao."
  },
  {
    "idx": 8860,
    "start": "04:07:50,846",
    "end": "04:07:51,226",
    "start_sec": 14870.846,
    "end_sec": 14871.226,
    "zh": "找人?",
    "vi": "Tìm người sao."
  },
  {
    "idx": 8861,
    "start": "04:07:51,686",
    "end": "04:07:53,986",
    "start_sec": 14871.686,
    "end_sec": 14873.986,
    "zh": "你在鬼域里找人,我没听错吧?",
    "vi": "Ngươi tìm người trong Quỷ Vực, ta không nghe lầm chứ."
  },
  {
    "idx": 8862,
    "start": "04:07:54,446",
    "end": "04:07:55,446",
    "start_sec": 14874.446,
    "end_sec": 14875.446,
    "zh": "什么?不行啊?",
    "vi": "Cái gì. Không được sao."
  },
  {
    "idx": 8863,
    "start": "04:07:55,886",
    "end": "04:07:57,986",
    "start_sec": 14875.886,
    "end_sec": 14877.986,
    "zh": "何止是不行,你这不是开玩笑吗?",
    "vi": "Đâu chỉ là không được, ngươi không phải đang đùa đấy chứ."
  },
  {
    "idx": 8864,
    "start": "04:07:58,166",
    "end": "04:08:02,046",
    "start_sec": 14878.166,
    "end_sec": 14882.046,
    "zh": "鬼域鬼域,那是鬼的领域,你说常人进了这里能有活路吗?",
    "vi": "Quỷ Vực là lãnh địa của quỷ, ngươi nói người thường vào đây thì có đường sống không."
  },
  {
    "idx": 8865,
    "start": "04:08:02,386",
    "end": "04:08:05,686",
    "start_sec": 14882.386,
    "end_sec": 14885.686,
    "zh": "听着鬼面窗的嘲讽,橙子皮牙口无言,不应该吧?",
    "vi": "Nghe lời chế giễu của Cửa sổ mặt quỷ, Trần Tử Bì không nói nên lời, không lẽ nào chứ."
  },
  {
    "idx": 8866,
    "start": "04:08:05,966",
    "end": "04:08:09,186",
    "start_sec": 14885.966,
    "end_sec": 14889.186,
    "zh": "如果是这样,古镜的使用者进入鬼域后不是必死了吗?",
    "vi": "Nếu đã như vậy, người sử dụng cổ kính sau khi vào Quỷ Vực không phải sẽ chết chắc sao."
  },
  {
    "idx": 8867,
    "start": "04:08:09,546",
    "end": "04:08:13,626",
    "start_sec": 14889.546,
    "end_sec": 14893.626,
    "zh": "古镜的使用者,什么古镜?那是禁鬼,禁鬼找的人类替身吧?",
    "vi": "Người sử dụng cổ kính, cổ kính gì chứ. Đó là Cấm Quỷ, là thế thân loài người mà Cấm Quỷ tìm kiếm đúng không."
  },
  {
    "idx": 8868,
    "start": "04:08:13,986",
    "end": "04:08:15,326",
    "start_sec": 14893.986,
    "end_sec": 14895.326,
    "zh": "啊,禁鬼,是什么?",
    "vi": "A, Cấm Quỷ là gì thế."
  },
  {
    "idx": 8869,
    "start": "04:08:15,326",
    "end": "04:08:16,626",
    "start_sec": 14895.326,
    "end_sec": 14896.626,
    "zh": "金鬼子玩意",
    "vi": "Cái thứ Cấm Quỷ đó."
  },
  {
    "idx": 8870,
    "start": "04:08:16,626",
    "end": "04:08:18,886",
    "start_sec": 14896.626,
    "end_sec": 14898.886,
    "zh": "能打通现实世界和鬼域的连接",
    "vi": "Có thể kết nối thế giới hiện thực và Quỷ Vực."
  },
  {
    "idx": 8871,
    "start": "04:08:18,886",
    "end": "04:08:20,826",
    "start_sec": 14898.886,
    "end_sec": 14900.826,
    "zh": "但是它们需要现实世界的违禁",
    "vi": "Nhưng chúng cần vật trung gian ở thế giới hiện thực."
  },
  {
    "idx": 8872,
    "start": "04:08:20,826",
    "end": "04:08:21,986",
    "start_sec": 14900.826,
    "end_sec": 14901.986,
    "zh": "也就是在级",
    "vi": "Nghĩa là vật chứa."
  },
  {
    "idx": 8873,
    "start": "04:08:21,986",
    "end": "04:08:23,706",
    "start_sec": 14901.986,
    "end_sec": 14903.706,
    "zh": "好比你们人类说的寄生体吧",
    "vi": "Giống như vật ký sinh mà loài người các ngươi hay gọi."
  },
  {
    "idx": 8874,
    "start": "04:08:23,706",
    "end": "04:08:25,066",
    "start_sec": 14903.706,
    "end_sec": 14905.066,
    "zh": "你说金子是鬼",
    "vi": "Ngươi nói Cấm Quỷ là quỷ."
  },
  {
    "idx": 8875,
    "start": "04:08:25,066",
    "end": "04:08:26,106",
    "start_sec": 14905.066,
    "end_sec": 14906.106,
    "zh": "那掌控了古镜",
    "vi": "Vậy khống chế được cổ kính."
  },
  {
    "idx": 8876,
    "start": "04:08:26,106",
    "end": "04:08:27,826",
    "start_sec": 14906.106,
    "end_sec": 14907.826,
    "zh": "也就是变相成为了御鬼者吗",
    "vi": "Cũng là biến tướng trở thành Ngự Quỷ Giả sao."
  },
  {
    "idx": 8877,
    "start": "04:08:27,826",
    "end": "04:08:28,506",
    "start_sec": 14907.826,
    "end_sec": 14908.506,
    "zh": "呵呵",
    "vi": "Hơ hơ."
  },
  {
    "idx": 8878,
    "start": "04:08:28,506",
    "end": "04:08:30,426",
    "start_sec": 14908.506,
    "end_sec": 14910.426,
    "zh": "微微的物品型鬼意罢了",
    "vi": "Chỉ là một món quỷ vật dạng đồ vật thấp kém mà thôi."
  },
  {
    "idx": 8879,
    "start": "04:08:30,426",
    "end": "04:08:31,986",
    "start_sec": 14910.426,
    "end_sec": 14911.986,
    "zh": "什么是物品型鬼意",
    "vi": "Quỷ vật dạng đồ vật là gì."
  },
  {
    "idx": 8880,
    "start": "04:08:31,986",
    "end": "04:08:34,286",
    "start_sec": 14911.986,
    "end_sec": 14914.286,
    "zh": "物品型鬼意可不像寻常鬼",
    "vi": "Quỷ vật dạng đồ vật không giống như quỷ thông thường."
  },
  {
    "idx": 8881,
    "start": "04:08:34,286",
    "end": "04:08:35,726",
    "start_sec": 14914.286,
    "end_sec": 14915.726,
    "zh": "不动用也会复兴",
    "vi": "Dù không sử dụng thì chúng cũng sẽ thức tỉnh."
  },
  {
    "idx": 8882,
    "start": "04:08:35,726",
    "end": "04:08:36,866",
    "start_sec": 14915.726,
    "end_sec": 14916.866,
    "zh": "它们需要供养",
    "vi": "Chúng cần được nuôi dưỡng."
  },
  {
    "idx": 8883,
    "start": "04:08:36,866",
    "end": "04:08:38,546",
    "start_sec": 14916.866,
    "end_sec": 14918.546,
    "zh": "一旦没有定期的食物供养",
    "vi": "Một khi không có thức ăn nuôi dưỡng định kỳ."
  },
  {
    "idx": 8884,
    "start": "04:08:38,546",
    "end": "04:08:40,046",
    "start_sec": 14918.546,
    "end_sec": 14920.046,
    "zh": "就无法维持它的形式",
    "vi": "Thì sẽ không thể duy trì được hình dạng của nó."
  },
  {
    "idx": 8885,
    "start": "04:08:40,046",
    "end": "04:08:42,386",
    "start_sec": 14920.046,
    "end_sec": 14922.386,
    "zh": "继而它们就会蚕食寄生的气血",
    "vi": "Tiếp đó chúng sẽ gặm nhấm khí huyết của vật chủ ký sinh."
  },
  {
    "idx": 8886,
    "start": "04:08:42,386",
    "end": "04:08:43,246",
    "start_sec": 14922.386,
    "end_sec": 14923.246,
    "zh": "寻奇鬼意",
    "vi": "Thật là quỷ dị kỳ lạ."
  },
  {
    "idx": 8887,
    "start": "04:08:43,246",
    "end": "04:08:44,886",
    "start_sec": 14923.246,
    "end_sec": 14924.886,
    "zh": "它们更像是吸血虫",
    "vi": "Chúng giống như lũ đỉa hút máu hơn."
  },
  {
    "idx": 8888,
    "start": "04:08:44,886",
    "end": "04:08:46,986",
    "start_sec": 14924.886,
    "end_sec": 14926.986,
    "zh": "这融合物品型诡异",
    "vi": "Loại quỷ dị dung hợp với vật phẩm này."
  },
  {
    "idx": 8889,
    "start": "04:08:46,986",
    "end": "04:08:49,066",
    "start_sec": 14926.986,
    "end_sec": 14929.066,
    "zh": "不是相当于给自己找了个定时炸弹吗",
    "vi": "Chẳng phải tương đương với việc tự tìm cho mình một quả bom hẹn giờ sao."
  },
  {
    "idx": 8890,
    "start": "04:08:49,066",
    "end": "04:08:52,546",
    "start_sec": 14929.066,
    "end_sec": 14932.546,
    "zh": "不过要是能稳定和物品型诡异达成供养关系",
    "vi": "Nhưng nếu có thể duy trì ổn định quan hệ nuôi dưỡng với quỷ dị vật phẩm."
  },
  {
    "idx": 8891,
    "start": "04:08:52,546",
    "end": "04:08:53,946",
    "start_sec": 14932.546,
    "end_sec": 14933.946,
    "zh": "也是一种不错的增益",
    "vi": "Thì đó cũng là một sự gia tăng sức mạnh không tồi."
  },
  {
    "idx": 8892,
    "start": "04:08:53,946",
    "end": "04:08:55,246",
    "start_sec": 14933.946,
    "end_sec": 14935.246,
    "zh": "算是有利的一把",
    "vi": "Coi như là có một mặt lợi."
  },
  {
    "idx": 8893,
    "start": "04:08:55,246",
    "end": "04:08:57,666",
    "start_sec": 14935.246,
    "end_sec": 14937.666,
    "zh": "还有这石碧上面写了什么",
    "vi": "Còn trên bức vách đá này viết cái gì thế."
  },
  {
    "idx": 8894,
    "start": "04:08:57,666",
    "end": "04:08:59,446",
    "start_sec": 14937.666,
    "end_sec": 14939.446,
    "zh": "无非是禁鬼的契约者",
    "vi": "Chẳng qua là người lập khế ước với cấm quỷ."
  },
  {
    "idx": 8895,
    "start": "04:08:59,446",
    "end": "04:09:00,366",
    "start_sec": 14939.446,
    "end_sec": 14940.366,
    "zh": "一旦契约",
    "vi": "Một khi đã lập khế ước."
  },
  {
    "idx": 8896,
    "start": "04:09:00,366",
    "end": "04:09:02,446",
    "start_sec": 14940.366,
    "end_sec": 14942.446,
    "zh": "就需要一家族血脉带带团成",
    "vi": "Thì cần huyết mạch của cả gia tộc truyền thừa đời đời."
  },
  {
    "idx": 8897,
    "start": "04:09:02,446",
    "end": "04:09:03,826",
    "start_sec": 14942.446,
    "end_sec": 14943.826,
    "zh": "看起来是个团家吧",
    "vi": "Trông có vẻ là một bảo vật gia truyền nhỉ."
  },
  {
    "idx": 8898,
    "start": "04:09:03,826",
    "end": "04:09:06,766",
    "start_sec": 14943.826,
    "end_sec": 14946.766,
    "zh": "不过是个不把这一家人弄死不罢休的诡异吧",
    "vi": "Nhưng thực chất chỉ là một thứ quỷ dị không hại chết cả nhà này thì không chịu dừng lại thôi."
  },
  {
    "idx": 8899,
    "start": "04:09:06,766",
    "end": "04:09:07,726",
    "start_sec": 14946.766,
    "end_sec": 14947.726,
    "zh": "还有呢",
    "vi": "Còn gì nữa không."
  },
  {
    "idx": 8900,
    "start": "04:09:07,726",
    "end": "04:09:09,266",
    "start_sec": 14947.726,
    "end_sec": 14949.266,
    "zh": "作为禁鬼的载体",
    "vi": "Với tư cách là vật chứa của cấm quỷ."
  },
  {
    "idx": 8901,
    "start": "04:09:09,266",
    "end": "04:09:10,486",
    "start_sec": 14949.266,
    "end_sec": 14950.486,
    "zh": "可以在鬼域游走",
    "vi": "Có thể đi lại trong quỷ vực."
  },
  {
    "idx": 8902,
    "start": "04:09:10,486",
    "end": "04:09:11,586",
    "start_sec": 14950.486,
    "end_sec": 14951.586,
    "zh": "与鬼打交道",
    "vi": "Giao thiệp với quỷ."
  },
  {
    "idx": 8903,
    "start": "04:09:11,586",
    "end": "04:09:12,946",
    "start_sec": 14951.586,
    "end_sec": 14952.946,
    "zh": "哦与鬼打交道",
    "vi": "Ồ giao thiệp với quỷ."
  },
  {
    "idx": 8904,
    "start": "04:09:12,946",
    "end": "04:09:13,686",
    "start_sec": 14952.946,
    "end_sec": 14953.686,
    "zh": "有点意思",
    "vi": "Thú vị đấy."
  },
  {
    "idx": 8905,
    "start": "04:09:13,686",
    "end": "04:09:14,486",
    "start_sec": 14953.686,
    "end_sec": 14954.486,
    "zh": "呵呵",
    "vi": "Ha ha."
  },
  {
    "idx": 8906,
    "start": "04:09:14,486",
    "end": "04:09:15,046",
    "start_sec": 14954.486,
    "end_sec": 14955.046,
    "zh": "小子",
    "vi": "Nhóc con."
  },
  {
    "idx": 8907,
    "start": "04:09:15,046",
    "end": "04:09:16,406",
    "start_sec": 14955.046,
    "end_sec": 14956.406,
    "zh": "我知道你在想什么",
    "vi": "Ta biết ngươi đang nghĩ gì."
  },
  {
    "idx": 8908,
    "start": "04:09:16,406",
    "end": "04:09:18,586",
    "start_sec": 14956.406,
    "end_sec": 14958.586,
    "zh": "但是我可以很负责的告诉你",
    "vi": "Nhưng ta có thể khẳng định chắc chắn với ngươi rằng."
  },
  {
    "idx": 8909,
    "start": "04:09:18,586",
    "end": "04:09:20,426",
    "start_sec": 14958.586,
    "end_sec": 14960.426,
    "zh": "如果你自身的诡异足够强大",
    "vi": "Nếu bản thân quỷ dị của ngươi đủ mạnh."
  },
  {
    "idx": 8910,
    "start": "04:09:20,426",
    "end": "04:09:21,706",
    "start_sec": 14960.426,
    "end_sec": 14961.706,
    "zh": "也能和鬼打交道",
    "vi": "Thì cũng có thể giao thiệp với quỷ."
  },
  {
    "idx": 8911,
    "start": "04:09:21,706",
    "end": "04:09:22,806",
    "start_sec": 14961.706,
    "end_sec": 14962.806,
    "zh": "行了行了",
    "vi": "Được rồi được rồi."
  },
  {
    "idx": 8912,
    "start": "04:09:22,806",
    "end": "04:09:24,006",
    "start_sec": 14962.806,
    "end_sec": 14964.006,
    "zh": "我知道你要说什么",
    "vi": "Ta biết ngươi muốn nói gì rồi."
  },
  {
    "idx": 8913,
    "start": "04:09:24,006",
    "end": "04:09:25,566",
    "start_sec": 14964.006,
    "end_sec": 14965.566,
    "zh": "我争取再找点诡异给你吃",
    "vi": "Ta sẽ cố gắng tìm thêm vài thứ quỷ dị cho ngươi ăn."
  },
  {
    "idx": 8914,
    "start": "04:09:25,566",
    "end": "04:09:28,806",
    "start_sec": 14965.566,
    "end_sec": 14968.806,
    "zh": "山洞之外",
    "vi": "Bên ngoài hang động."
  },
  {
    "idx": 8915,
    "start": "04:09:28,806",
    "end": "04:09:30,406",
    "start_sec": 14968.806,
    "end_sec": 14970.406,
    "zh": "是一片破败的树林",
    "vi": "Là một khu rừng hoang tàn."
  },
  {
    "idx": 8916,
    "start": "04:09:30,406",
    "end": "04:09:31,986",
    "start_sec": 14970.406,
    "end_sec": 14971.986,
    "zh": "兔兔弥漫着死性",
    "vi": "Khắp nơi tràn ngập tử khí."
  },
  {
    "idx": 8917,
    "start": "04:09:43,686",
    "end": "04:09:53,706",
    "start_sec": 14983.686,
    "end_sec": 14993.706,
    "zh": "树干之下的泥地",
    "vi": "Vùng đất bùn dưới những thân cây."
  },
  {
    "idx": 8918,
    "start": "04:09:53,706",
    "end": "04:09:54,706",
    "start_sec": 14993.706,
    "end_sec": 14994.706,
    "zh": "青苔重生",
    "vi": "Rêu xanh mọc đầy."
  },
  {
    "idx": 8919,
    "start": "04:09:54,706",
    "end": "04:09:59,917",
    "start_sec": 14994.706,
    "end_sec": 14999.917,
    "zh": "橙子皮走出底部就发现自己面下陷的泥不知走了多久橙子皮的眼皮的眼睛忽然一目,在一座浅显的青苔地上,几个狗爪印吸引了他的注意。",
    "vi": "Trần Tử Bì vừa bước ra ngoài liền phát hiện mình đang giẫm lên bùn lún, không biết đã đi bao lâu, mắt của hắn"
  },
  {
    "idx": 8919,
    "start": "04:09:59,917",
    "end": "04:10:04,712",
    "start_sec": 14999.917,
    "end_sec": 15004.712,
    "zh": "橙子皮走出底部就发现自己面下陷的泥不知走了多久橙子皮的眼皮的眼睛忽然一目,在一座浅显的青苔地上,几个狗爪印吸引了他的注意。",
    "vi": "bỗng nhiên nhìn thấy trên một bãi rêu xanh cạn, có vài dấu chân chó đã thu hút sự chú ý của hắn."
  },
  {
    "idx": 8920,
    "start": "04:10:05,212",
    "end": "04:10:06,553",
    "start_sec": 15005.212,
    "end_sec": 15006.553,
    "zh": "是小磨叽吗?可是,如果是小磨叽的话,为什么只有狗爪印,没有诸葛山的脚印呢?心里带着不解,橙子皮还是朝着狗爪印走去。",
    "vi": "Có phải là Tiểu Ma Kê không"
  },
  {
    "idx": 8920,
    "start": "04:10:06,553",
    "end": "04:10:10,959",
    "start_sec": 15006.553,
    "end_sec": 15010.959,
    "zh": "是小磨叽吗?可是,如果是小磨叽的话,为什么只有狗爪印,没有诸葛山的脚印呢?心里带着不解,橙子皮还是朝着狗爪印走去。",
    "vi": "Nhưng nếu là Tiểu Ma Kê thì tại sao chỉ có dấu chân chó mà không có dấu chân của Gia Cát Sơn"
  },
  {
    "idx": 8920,
    "start": "04:10:10,959",
    "end": "04:10:13,832",
    "start_sec": 15010.959,
    "end_sec": 15013.832,
    "zh": "是小磨叽吗?可是,如果是小磨叽的话,为什么只有狗爪印,没有诸葛山的脚印呢?心里带着不解,橙子皮还是朝着狗爪印走去。",
    "vi": "Trong lòng đầy nghi hoặc, Trần Tử Bì vẫn bước về phía dấu chân chó"
  },
  {
    "idx": 8921,
    "start": "04:10:13,832",
    "end": "04:10:16,292",
    "start_sec": 15013.832,
    "end_sec": 15016.292,
    "zh": "这别吵",
    "vi": "Đừng ồn ào."
  },
  {
    "idx": 8922,
    "start": "04:10:16,292",
    "end": "04:10:17,132",
    "start_sec": 15016.292,
    "end_sec": 15017.132,
    "zh": "小磨叽",
    "vi": "Tiểu Ma Kê."
  },
  {
    "idx": 8923,
    "start": "04:10:17,132",
    "end": "04:10:18,432",
    "start_sec": 15017.132,
    "end_sec": 15018.432,
    "zh": "他妈的",
    "vi": "Mẹ kiếp."
  },
  {
    "idx": 8924,
    "start": "04:10:18,432",
    "end": "04:10:19,472",
    "start_sec": 15018.432,
    "end_sec": 15019.472,
    "zh": "言不住怒骂一句",
    "vi": "Không kìm được chửi thề một tiếng."
  },
  {
    "idx": 8925,
    "start": "04:10:19,472",
    "end": "04:10:20,852",
    "start_sec": 15019.472,
    "end_sec": 15020.852,
    "zh": "橙子皮脚不加快",
    "vi": "Trần Tử Bì tăng nhanh bước chân."
  },
  {
    "idx": 8926,
    "start": "04:10:20,852",
    "end": "04:10:22,212",
    "start_sec": 15020.852,
    "end_sec": 15022.212,
    "zh": "就要冲向小磨叽",
    "vi": "Định lao về phía Tiểu Ma Kê."
  },
  {
    "idx": 8927,
    "start": "04:10:22,212",
    "end": "04:10:22,652",
    "start_sec": 15022.212,
    "end_sec": 15022.652,
    "zh": "不想",
    "vi": "Không ngờ."
  },
  {
    "idx": 8928,
    "start": "04:10:22,652",
    "end": "04:10:23,532",
    "start_sec": 15022.652,
    "end_sec": 15023.532,
    "zh": "当麦克衣服",
    "vi": "Khi vừa bước một bước."
  },
  {
    "idx": 8929,
    "start": "04:10:23,532",
    "end": "04:10:25,032",
    "start_sec": 15023.532,
    "end_sec": 15025.032,
    "zh": "眼前青苔的地面",
    "vi": "Mặt đất đầy rêu trước mắt."
  },
  {
    "idx": 8930,
    "start": "04:10:25,032",
    "end": "04:10:26,112",
    "start_sec": 15025.032,
    "end_sec": 15026.112,
    "zh": "瞬间他见到",
    "vi": "Lập tức lún xuống."
  },
  {
    "idx": 8931,
    "start": "04:10:26,112",
    "end": "04:10:27,712",
    "start_sec": 15026.112,
    "end_sec": 15027.712,
    "zh": "橙子皮本能的增长",
    "vi": "Trần Tử Bì giãy giụa theo bản năng."
  },
  {
    "idx": 8932,
    "start": "04:10:27,712",
    "end": "04:10:28,572",
    "start_sec": 15027.712,
    "end_sec": 15028.572,
    "zh": "和越增长",
    "vi": "Nhưng càng giãy giụa."
  },
  {
    "idx": 8933,
    "start": "04:10:28,572",
    "end": "04:10:29,572",
    "start_sec": 15028.572,
    "end_sec": 15029.572,
    "zh": "渐得却越厉害",
    "vi": "Thì lại càng lún sâu hơn."
  },
  {
    "idx": 8934,
    "start": "04:10:29,572",
    "end": "04:10:30,232",
    "start_sec": 15029.572,
    "end_sec": 15030.232,
    "zh": "看来",
    "vi": "Xem ra."
  },
  {
    "idx": 8935,
    "start": "04:10:30,232",
    "end": "04:10:32,252",
    "start_sec": 15030.232,
    "end_sec": 15032.252,
    "zh": "小磨叽尸体周围这一片都是沼泽",
    "vi": "Xung quanh xác của Tiểu Ma Kê đều là đầm lầy."
  },
  {
    "idx": 8936,
    "start": "04:10:32,252",
    "end": "04:10:33,072",
    "start_sec": 15032.252,
    "end_sec": 15033.072,
    "zh": "只要靠近",
    "vi": "Chỉ cần đến gần."
  },
  {
    "idx": 8937,
    "start": "04:10:33,072",
    "end": "04:10:33,892",
    "start_sec": 15033.072,
    "end_sec": 15033.892,
    "zh": "你就会陷下去",
    "vi": "Là sẽ bị lún xuống."
  },
  {
    "idx": 8938,
    "start": "04:10:33,892",
    "end": "04:10:34,612",
    "start_sec": 15033.892,
    "end_sec": 15034.612,
    "zh": "难以逃脱",
    "vi": "Rất khó thoát ra."
  },
  {
    "idx": 8939,
    "start": "04:10:34,612",
    "end": "04:10:35,272",
    "start_sec": 15034.612,
    "end_sec": 15035.272,
    "zh": "可是",
    "vi": "Nhưng mà."
  },
  {
    "idx": 8940,
    "start": "04:10:35,272",
    "end": "04:10:36,592",
    "start_sec": 15035.272,
    "end_sec": 15036.592,
    "zh": "既然周遭都是沼泽",
    "vi": "Nếu xung quanh đều là đầm lầy."
  },
  {
    "idx": 8941,
    "start": "04:10:36,592",
    "end": "04:10:37,992",
    "start_sec": 15036.592,
    "end_sec": 15037.992,
    "zh": "为什么小磨叽的尸体",
    "vi": "Tại sao xác của Tiểu Ma Ký"
  },
  {
    "idx": 8942,
    "start": "04:10:37,992",
    "end": "04:10:39,252",
    "start_sec": 15037.992,
    "end_sec": 15039.252,
    "zh": "偏偏会出现在这里呢",
    "vi": "lại xuất hiện ở đây vậy"
  },
  {
    "idx": 8943,
    "start": "04:10:39,252",
    "end": "04:10:39,952",
    "start_sec": 15039.252,
    "end_sec": 15039.952,
    "zh": "还是说",
    "vi": "Hay là"
  },
  {
    "idx": 8944,
    "start": "04:10:39,952",
    "end": "04:10:41,592",
    "start_sec": 15039.952,
    "end_sec": 15041.592,
    "zh": "这是一场唯一针对我的陷阱",
    "vi": "đây là cái bẫy duy nhất nhắm vào tôi"
  },
  {
    "idx": 8945,
    "start": "04:10:41,592",
    "end": "04:10:43,832",
    "start_sec": 15041.592,
    "end_sec": 15043.832,
    "zh": "藤子诸且量平躺身体",
    "vi": "Tằng Tử, nằm yên đi"
  },
  {
    "idx": 8946,
    "start": "04:10:43,832",
    "end": "04:10:45,092",
    "start_sec": 15043.832,
    "end_sec": 15045.092,
    "zh": "让自己陷得慢死",
    "vi": "cho mình bị lún từ từ"
  },
  {
    "idx": 8947,
    "start": "04:10:45,092",
    "end": "04:10:47,492",
    "start_sec": 15045.092,
    "end_sec": 15047.492,
    "zh": "你们没说",
    "vi": "Các người không nói"
  },
  {
    "idx": 8948,
    "start": "04:10:47,492",
    "end": "04:10:49,232",
    "start_sec": 15047.492,
    "end_sec": 15049.232,
    "zh": "他还真中招了",
    "vi": "là hắn ta đã mắc bẫy rồi"
  },
  {
    "idx": 8949,
    "start": "04:10:49,232",
    "end": "04:10:50,692",
    "start_sec": 15049.232,
    "end_sec": 15050.692,
    "zh": "头就是厉害",
    "vi": "Đầu óc đúng là lợi hại"
  },
  {
    "idx": 8950,
    "start": "04:10:50,692",
    "end": "04:10:53,112",
    "start_sec": 15050.692,
    "end_sec": 15053.112,
    "zh": "料定他一定会来看黑狗",
    "vi": "Đoán chắc hắn ta sẽ đến xem Hắc Cẩu"
  },
  {
    "idx": 8951,
    "start": "04:10:53,112",
    "end": "04:10:54,732",
    "start_sec": 15053.112,
    "end_sec": 15054.732,
    "zh": "谢谢",
    "vi": "Cảm ơn"
  },
  {
    "idx": 8952,
    "start": "04:10:54,732",
    "end": "04:10:56,032",
    "start_sec": 15054.732,
    "end_sec": 15056.032,
    "zh": "不用求求他",
    "vi": "Không cần cầu xin hắn"
  },
  {
    "idx": 8953,
    "start": "04:10:56,032",
    "end": "04:10:57,832",
    "start_sec": 15056.032,
    "end_sec": 15057.832,
    "zh": "我们就完蛋了",
    "vi": "chúng ta sẽ xong đời"
  },
  {
    "idx": 8954,
    "start": "04:10:57,832",
    "end": "04:10:59,112",
    "start_sec": 15057.832,
    "end_sec": 15059.112,
    "zh": "嘲讽声越来越近",
    "vi": "Tiếng chế giễu ngày càng gần"
  },
  {
    "idx": 8955,
    "start": "04:10:59,112",
    "end": "04:11:01,272",
    "start_sec": 15059.112,
    "end_sec": 15061.272,
    "zh": "农物中跑出来几个高大的男人",
    "vi": "Vài người đàn ông cao lớn chạy ra từ trong rừng"
  },
  {
    "idx": 8956,
    "start": "04:11:01,272",
    "end": "04:11:02,972",
    "start_sec": 15061.272,
    "end_sec": 15062.972,
    "zh": "藤子一自然没见过他们",
    "vi": "Tằng Tử chưa từng gặp họ"
  },
  {
    "idx": 8957,
    "start": "04:11:02,972",
    "end": "04:11:04,452",
    "start_sec": 15062.972,
    "end_sec": 15064.452,
    "zh": "反大致也能猜到",
    "vi": "nhưng đại khái cũng đoán được"
  },
  {
    "idx": 8958,
    "start": "04:11:04,452",
    "end": "04:11:07,032",
    "start_sec": 15064.452,
    "end_sec": 15067.032,
    "zh": "他们都是曙光号上被诡异复刻的成哥",
    "vi": "họ đều là những \"Thành ca\" bị dị vật sao chép trên tàu Ánh Sáng"
  },
  {
    "idx": 8959,
    "start": "04:11:07,032",
    "end": "04:11:08,892",
    "start_sec": 15067.032,
    "end_sec": 15068.892,
    "zh": "既然能走找的地上行走",
    "vi": "Nếu đã có thể đi lại trên mặt đất"
  },
  {
    "idx": 8960,
    "start": "04:11:08,892",
    "end": "04:11:10,292",
    "start_sec": 15068.892,
    "end_sec": 15070.292,
    "zh": "你们已经完全不是人了吧",
    "vi": "các người đã hoàn toàn không còn là người rồi đúng không"
  },
  {
    "idx": 8961,
    "start": "04:11:10,292",
    "end": "04:11:12,152",
    "start_sec": 15070.292,
    "end_sec": 15072.152,
    "zh": "哎呦 同交来了",
    "vi": "Ôi chao, đồng bọn của ngươi đến rồi"
  },
  {
    "idx": 8962,
    "start": "04:11:12,152",
    "end": "04:11:14,212",
    "start_sec": 15072.152,
    "end_sec": 15074.212,
    "zh": "你真真必须去证明",
    "vi": "Ngươi nhất định phải chứng minh"
  },
  {
    "idx": 8963,
    "start": "04:11:14,212",
    "end": "04:11:14,932",
    "start_sec": 15074.212,
    "end_sec": 15074.932,
    "zh": "是什么",
    "vi": "là cái gì"
  },
  {
    "idx": 8964,
    "start": "04:11:14,932",
    "end": "04:11:18,232",
    "start_sec": 15074.932,
    "end_sec": 15078.232,
    "zh": "长者提抬头看着像自己迈过来的男子",
    "vi": "Trưởng lão ngẩng đầu nhìn người đàn ông đang bước về phía mình"
  },
  {
    "idx": 8965,
    "start": "04:11:18,232",
    "end": "04:11:19,632",
    "start_sec": 15078.232,
    "end_sec": 15079.632,
    "zh": "眼色说不出的运气",
    "vi": "ánh mắt đầy vẻ bất lực"
  },
  {
    "idx": 8966,
    "start": "04:11:19,632",
    "end": "04:11:21,432",
    "start_sec": 15079.632,
    "end_sec": 15081.432,
    "zh": "鬼面窗 交给你了",
    "vi": "Quỷ Diện Thang, giao cho ngươi"
  },
  {
    "idx": 8967,
    "start": "04:11:21,432",
    "end": "04:11:22,332",
    "start_sec": 15081.432,
    "end_sec": 15082.332,
    "zh": "尽管付租",
    "vi": "Cứ tùy ý mà làm"
  },
  {
    "idx": 8968,
    "start": "04:11:22,332",
    "end": "04:11:23,332",
    "start_sec": 15082.332,
    "end_sec": 15083.332,
    "zh": "嘿嘿嘿",
    "vi": "Hắc hắc hắc"
  },
  {
    "idx": 8969,
    "start": "04:11:23,332",
    "end": "04:11:25,872",
    "start_sec": 15083.332,
    "end_sec": 15085.872,
    "zh": "小子 这次你可能顽脱了",
    "vi": "Nhóc con, lần này ngươi khó thoát lắm"
  },
  {
    "idx": 8970,
    "start": "04:11:25,872",
    "end": "04:11:28,132",
    "start_sec": 15085.872,
    "end_sec": 15088.132,
    "zh": "什么玩意也配来和我叫板",
    "vi": "Cái thứ gì cũng xứng đấu với ta"
  },
  {
    "idx": 8971,
    "start": "04:11:28,132",
    "end": "04:11:31,692",
    "start_sec": 15088.132,
    "end_sec": 15091.692,
    "zh": "妈的 这到底是什么鬼",
    "vi": "Chết tiệt đây rốt cuộc là thứ quái quỷ gì vậy."
  },
  {
    "idx": 8972,
    "start": "04:11:31,692",
    "end": "04:11:32,572",
    "start_sec": 15091.692,
    "end_sec": 15092.572,
    "zh": "没有肉体",
    "vi": "Không có cơ thể."
  },
  {
    "idx": 8973,
    "start": "04:11:32,572",
    "end": "04:11:33,392",
    "start_sec": 15092.572,
    "end_sec": 15093.392,
    "zh": "宰了之后",
    "vi": "Sau khi giết xong."
  },
  {
    "idx": 8974,
    "start": "04:11:33,392",
    "end": "04:11:34,752",
    "start_sec": 15093.392,
    "end_sec": 15094.752,
    "zh": "全都变成粘稠的水污",
    "vi": "Tất cả đều biến thành vũng nước nhớp nháp."
  },
  {
    "idx": 8975,
    "start": "04:11:34,752",
    "end": "04:11:35,472",
    "start_sec": 15094.752,
    "end_sec": 15095.472,
    "zh": "见我一脸",
    "vi": "Dính đầy mặt tôi."
  },
  {
    "idx": 8976,
    "start": "04:11:35,472",
    "end": "04:11:36,692",
    "start_sec": 15095.472,
    "end_sec": 15096.692,
    "zh": "还有这一身泥长",
    "vi": "Còn cả đống bùn trên người này nữa."
  },
  {
    "idx": 8977,
    "start": "04:11:36,692",
    "end": "04:11:37,672",
    "start_sec": 15096.692,
    "end_sec": 15097.672,
    "zh": "真够恶心的",
    "vi": "Thật là kinh tởm."
  },
  {
    "idx": 8978,
    "start": "04:11:37,672",
    "end": "04:11:39,832",
    "start_sec": 15097.672,
    "end_sec": 15099.832,
    "zh": "我人 透说了",
    "vi": "Tôi đã nói rồi mà."
  },
  {
    "idx": 8979,
    "start": "04:11:39,832",
    "end": "04:11:41,452",
    "start_sec": 15099.832,
    "end_sec": 15101.452,
    "zh": "这家伙不好搞定",
    "vi": "Tên này không dễ đối phó đâu."
  },
  {
    "idx": 8980,
    "start": "04:11:41,452",
    "end": "04:11:42,012",
    "start_sec": 15101.452,
    "end_sec": 15102.012,
    "zh": "不过",
    "vi": "Tuy nhiên."
  },
  {
    "idx": 8981,
    "start": "04:11:42,012",
    "end": "04:11:43,512",
    "start_sec": 15102.012,
    "end_sec": 15103.512,
    "zh": "这里可是鬼院",
    "vi": "Đây là Quỷ Viện mà."
  },
  {
    "idx": 8982,
    "start": "04:11:43,512",
    "end": "04:11:44,472",
    "start_sec": 15103.512,
    "end_sec": 15104.472,
    "zh": "随即",
    "vi": "Ngay lập tức."
  },
  {
    "idx": 8983,
    "start": "04:11:44,472",
    "end": "04:11:46,132",
    "start_sec": 15104.472,
    "end_sec": 15106.132,
    "zh": "剩下几人前顾后继的",
    "vi": "Mấy kẻ còn lại lao lên tiếp nối nhau."
  },
  {
    "idx": 8984,
    "start": "04:11:46,132",
    "end": "04:11:47,232",
    "start_sec": 15106.132,
    "end_sec": 15107.232,
    "zh": "向橙子皮混",
    "vi": "Hướng về phía Trần Tử Bì."
  },
  {
    "idx": 8985,
    "start": "04:11:47,232",
    "end": "04:11:48,392",
    "start_sec": 15107.232,
    "end_sec": 15108.392,
    "zh": "就给你们",
    "vi": "Để tôi cho các người biết."
  },
  {
    "idx": 8986,
    "start": "04:11:48,392",
    "end": "04:11:49,612",
    "start_sec": 15108.392,
    "end_sec": 15109.612,
    "zh": "在鬼爷我面前",
    "vi": "Trước mặt Quỷ Gia tôi đây."
  },
  {
    "idx": 8987,
    "start": "04:11:49,612",
    "end": "04:11:50,732",
    "start_sec": 15109.612,
    "end_sec": 15110.732,
    "zh": "不够看了",
    "vi": "Các người chẳng là gì cả."
  },
  {
    "idx": 8988,
    "start": "04:11:50,732",
    "end": "04:11:54,872",
    "start_sec": 15110.732,
    "end_sec": 15114.872,
    "zh": "鬼面康解是凝视了一眼几人",
    "vi": "Quỷ Diện Khang nhìn chằm chằm vào mấy kẻ đó."
  },
  {
    "idx": 8989,
    "start": "04:11:54,872",
    "end": "04:11:56,412",
    "start_sec": 15114.872,
    "end_sec": 15116.412,
    "zh": "他们的身体便僵持住",
    "vi": "Cơ thể chúng liền cứng đờ lại."
  },
  {
    "idx": 8990,
    "start": "04:11:56,412",
    "end": "04:11:57,132",
    "start_sec": 15116.412,
    "end_sec": 15117.132,
    "zh": "无法动弹",
    "vi": "Không thể cử động."
  },
  {
    "idx": 8991,
    "start": "04:11:57,132",
    "end": "04:11:59,152",
    "start_sec": 15117.132,
    "end_sec": 15119.152,
    "zh": "进而身体炸动手无非剑",
    "vi": "Sau đó cơ thể chúng nổ tung thành vũng máu."
  },
  {
    "idx": 8992,
    "start": "04:11:59,152",
    "end": "04:11:59,772",
    "start_sec": 15119.152,
    "end_sec": 15119.772,
    "zh": "同时",
    "vi": "Đồng thời."
  },
  {
    "idx": 8993,
    "start": "04:11:59,772",
    "end": "04:12:01,372",
    "start_sec": 15119.772,
    "end_sec": 15121.372,
    "zh": "橙子皮脖子上的鬼纹",
    "vi": "Vết xăm quỷ trên cổ Trần Tử Bì."
  },
  {
    "idx": 8994,
    "start": "04:12:01,372",
    "end": "04:12:02,292",
    "start_sec": 15121.372,
    "end_sec": 15122.292,
    "zh": "也消散一条",
    "vi": "Cũng biến mất một vạch."
  },
  {
    "idx": 8995,
    "start": "04:12:02,292",
    "end": "04:12:03,452",
    "start_sec": 15122.292,
    "end_sec": 15123.452,
    "zh": "嘿嘿嘿",
    "vi": "Hê hê hê."
  },
  {
    "idx": 8996,
    "start": "04:12:03,452",
    "end": "04:12:03,892",
    "start_sec": 15123.452,
    "end_sec": 15123.892,
    "zh": "小子",
    "vi": "Nhóc con."
  },
  {
    "idx": 8997,
    "start": "04:12:03,892",
    "end": "04:12:05,412",
    "start_sec": 15123.892,
    "end_sec": 15125.412,
    "zh": "远处好像来了不少",
    "vi": "Đằng xa hình như có không ít."
  },
  {
    "idx": 8998,
    "start": "04:12:05,412",
    "end": "04:12:06,432",
    "start_sec": 15125.412,
    "end_sec": 15126.432,
    "zh": "误障鬼啊",
    "vi": "Quỷ Vụ Chướng đang tới kìa."
  },
  {
    "idx": 8999,
    "start": "04:12:06,432",
    "end": "04:12:07,232",
    "start_sec": 15126.432,
    "end_sec": 15127.232,
    "zh": "你是说",
    "vi": "Ý ông là."
  },
  {
    "idx": 9000,
    "start": "04:12:07,232",
    "end": "04:12:08,632",
    "start_sec": 15127.232,
    "end_sec": 15128.632,
    "zh": "这些鬼是误障鬼吗",
    "vi": "Những con quỷ này là Quỷ Vụ Chướng sao."
  },
  {
    "idx": 9001,
    "start": "04:12:08,632",
    "end": "04:12:09,032",
    "start_sec": 15128.632,
    "end_sec": 15129.032,
    "zh": "对",
    "vi": "Đúng vậy."
  },
  {
    "idx": 9002,
    "start": "04:12:09,032",
    "end": "04:12:11,172",
    "start_sec": 15129.032,
    "end_sec": 15131.172,
    "zh": "准确来说是物障鬼的分裂体",
    "vi": "Chính xác mà nói thì đây là các phân thân của Quỷ Vụ Chướng."
  },
  {
    "idx": 9003,
    "start": "04:12:11,172",
    "end": "04:12:12,932",
    "start_sec": 15131.172,
    "end_sec": 15132.932,
    "zh": "物障鬼的能力是至高可用",
    "vi": "Năng lực của Quỷ Vụ Chướng rất đặc biệt."
  },
  {
    "idx": 9004,
    "start": "04:12:12,932",
    "end": "04:12:14,412",
    "start_sec": 15132.932,
    "end_sec": 15134.412,
    "zh": "不可幻化出分身",
    "vi": "Nó có thể biến hóa ra các phân thân."
  },
  {
    "idx": 9005,
    "start": "04:12:14,412",
    "end": "04:12:15,912",
    "start_sec": 15134.412,
    "end_sec": 15135.912,
    "zh": "或是模拟出其他人形",
    "vi": "Hoặc mô phỏng theo hình dáng của người khác."
  },
  {
    "idx": 9006,
    "start": "04:12:15,912",
    "end": "04:12:17,452",
    "start_sec": 15135.912,
    "end_sec": 15137.452,
    "zh": "人体能力其实不强",
    "vi": "Thực ra năng lực của bản thể không mạnh."
  },
  {
    "idx": 9007,
    "start": "04:12:17,452",
    "end": "04:12:19,352",
    "start_sec": 15137.452,
    "end_sec": 15139.352,
    "zh": "人体在哪才是关键问题",
    "vi": "Bản thể đang ở đâu mới là vấn đề mấu chốt."
  },
  {
    "idx": 9008,
    "start": "04:12:19,352",
    "end": "04:12:20,592",
    "start_sec": 15139.352,
    "end_sec": 15140.592,
    "zh": "只要不消灭本体",
    "vi": "Chỉ cần không tiêu diệt bản thể."
  },
  {
    "idx": 9009,
    "start": "04:12:20,592",
    "end": "04:12:22,592",
    "start_sec": 15140.592,
    "end_sec": 15142.592,
    "zh": "水物分身就可以一直幻化",
    "vi": "Thì các phân thân sương mù vẫn sẽ tiếp tục biến hóa ra."
  },
  {
    "idx": 9010,
    "start": "04:12:22,592",
    "end": "04:12:23,652",
    "start_sec": 15142.592,
    "end_sec": 15143.652,
    "zh": "原来如此",
    "vi": "Hóa ra là vậy."
  },
  {
    "idx": 9011,
    "start": "04:12:23,652",
    "end": "04:12:25,192",
    "start_sec": 15143.652,
    "end_sec": 15145.192,
    "zh": "难怪船上的人不断消失",
    "vi": "Thảo nào những người trên tàu cứ liên tục biến mất."
  },
  {
    "idx": 9012,
    "start": "04:12:25,192",
    "end": "04:12:26,272",
    "start_sec": 15145.192,
    "end_sec": 15146.272,
    "zh": "不断出现",
    "vi": "Rồi lại liên tục xuất hiện."
  },
  {
    "idx": 9013,
    "start": "04:12:26,272",
    "end": "04:12:28,992",
    "start_sec": 15146.272,
    "end_sec": 15148.992,
    "zh": "本体难道是周克山吗",
    "vi": "Chẳng lẽ bản thể chính là Chu Khắc Sơn sao."
  },
  {
    "idx": 9014,
    "start": "04:12:28,992",
    "end": "04:12:30,552",
    "start_sec": 15148.992,
    "end_sec": 15150.552,
    "zh": "长者一件件理性思路",
    "vi": "Hãy xâu chuỗi lại các manh mối một cách hợp lý."
  },
  {
    "idx": 9015,
    "start": "04:12:30,552",
    "end": "04:12:33,032",
    "start_sec": 15150.552,
    "end_sec": 15153.032,
    "zh": "如果说曙光号出现水物号",
    "vi": "Nếu nói trên tàu Thự Quang xuất hiện sương mù."
  },
  {
    "idx": 9016,
    "start": "04:12:33,032",
    "end": "04:12:33,952",
    "start_sec": 15153.032,
    "end_sec": 15153.952,
    "zh": "他打开轨迹",
    "vi": "Ông ta đã mở lối đi."
  },
  {
    "idx": 9017,
    "start": "04:12:33,952",
    "end": "04:12:35,612",
    "start_sec": 15153.952,
    "end_sec": 15155.612,
    "zh": "带着小墨迹来到了这里",
    "vi": "Và đưa Tiểu Mặc Tích đến đây."
  },
  {
    "idx": 9018,
    "start": "04:12:35,612",
    "end": "04:12:37,352",
    "start_sec": 15155.612,
    "end_sec": 15157.352,
    "zh": "但是刚刚的路上",
    "vi": "Nhưng trên con đường vừa rồi."
  },
  {
    "idx": 9019,
    "start": "04:12:37,352",
    "end": "04:12:38,452",
    "start_sec": 15157.352,
    "end_sec": 15158.452,
    "zh": "他又没有留下脚印",
    "vi": "Ông ta lại không hề để lại dấu chân."
  },
  {
    "idx": 9020,
    "start": "04:12:38,452",
    "end": "04:12:39,652",
    "start_sec": 15158.452,
    "end_sec": 15159.652,
    "zh": "有没有一种可能",
    "vi": "Liệu có khả năng nào."
  },
  {
    "idx": 9021,
    "start": "04:12:39,652",
    "end": "04:12:41,012",
    "start_sec": 15159.652,
    "end_sec": 15161.012,
    "zh": "是他先打开了鬼镜",
    "vi": "Là ông ta đã mở Quỷ Kính trước."
  },
  {
    "idx": 9022,
    "start": "04:12:41,012",
    "end": "04:12:42,292",
    "start_sec": 15161.012,
    "end_sec": 15162.292,
    "zh": "然后藏到鬼域中",
    "vi": "Sau đó trốn vào trong Quỷ Vực."
  },
  {
    "idx": 9023,
    "start": "04:12:42,292",
    "end": "04:12:43,632",
    "start_sec": 15162.292,
    "end_sec": 15163.632,
    "zh": "释放了误障鬼的能力",
    "vi": "Rồi giải phóng năng lực của Quỷ Vụ Chướng."
  },
  {
    "idx": 9024,
    "start": "04:12:43,632",
    "end": "04:12:45,312",
    "start_sec": 15163.632,
    "end_sec": 15165.312,
    "zh": "将水物弥漫到曙光号呢",
    "vi": "Để sương mù bao phủ khắp tàu Thự Quang không."
  },
  {
    "idx": 9025,
    "start": "04:12:45,312",
    "end": "04:12:46,832",
    "start_sec": 15165.312,
    "end_sec": 15166.832,
    "zh": "因为鬼镜打通了",
    "vi": "Bởi vì Quỷ Kính đã được thông suốt."
  },
  {
    "idx": 9026,
    "start": "04:12:46,832",
    "end": "04:12:48,052",
    "start_sec": 15166.832,
    "end_sec": 15168.052,
    "zh": "这里的误障鬼分身",
    "vi": "Nên các phân thân Quỷ Vụ Chướng ở đây."
  },
  {
    "idx": 9027,
    "start": "04:12:48,052",
    "end": "04:12:49,572",
    "start_sec": 15168.052,
    "end_sec": 15169.572,
    "zh": "就可以潜入曙光号",
    "vi": "Mới có thể lẻn vào tàu Thự Quang."
  },
  {
    "idx": 9028,
    "start": "04:12:49,572",
    "end": "04:12:52,092",
    "start_sec": 15169.572,
    "end_sec": 15172.092,
    "zh": "而小莫吉出于本能在鬼域中乱走",
    "vi": "Còn Tiểu Mặc Tích thì đi lung tung trong Quỷ Vực theo bản năng."
  },
  {
    "idx": 9029,
    "start": "04:12:52,092",
    "end": "04:12:53,012",
    "start_sec": 15172.092,
    "end_sec": 15173.012,
    "zh": "被伤害后",
    "vi": "Sau khi bị thương."
  },
  {
    "idx": 9030,
    "start": "04:12:53,012",
    "end": "04:12:54,212",
    "start_sec": 15173.012,
    "end_sec": 15174.212,
    "zh": "退一放在了沼泽区",
    "vi": "Thì bị bỏ lại ở khu vực đầm lầy."
  },
  {
    "idx": 9031,
    "start": "04:12:54,212",
    "end": "04:12:56,592",
    "start_sec": 15174.212,
    "end_sec": 15176.592,
    "zh": "周赫山也由于鬼者网页的登陆权限",
    "vi": "Chu Hách Sơn cũng nhờ có quyền đăng nhập vào trang web ngự quỷ."
  },
  {
    "idx": 9032,
    "start": "04:12:56,592",
    "end": "04:12:57,732",
    "start_sec": 15176.592,
    "end_sec": 15177.732,
    "zh": "他知道我的能力",
    "vi": "Hắn biết năng lực của tôi."
  },
  {
    "idx": 9033,
    "start": "04:12:57,732",
    "end": "04:12:58,232",
    "start_sec": 15177.732,
    "end_sec": 15178.232,
    "zh": "所以",
    "vi": "Cho nên"
  },
  {
    "idx": 9034,
    "start": "04:12:58,232",
    "end": "04:12:59,632",
    "start_sec": 15178.232,
    "end_sec": 15179.632,
    "zh": "他故意引我进鬼域",
    "vi": "Hắn cố ý dẫn tôi vào quỷ vực."
  },
  {
    "idx": 9035,
    "start": "04:12:59,632",
    "end": "04:13:00,392",
    "start_sec": 15179.632,
    "end_sec": 15180.392,
    "zh": "给我设局",
    "vi": "Bày mưu hại tôi."
  },
  {
    "idx": 9036,
    "start": "04:13:00,392",
    "end": "04:13:01,452",
    "start_sec": 15180.392,
    "end_sec": 15181.452,
    "zh": "是想做掉我",
    "vi": "Là muốn tiêu diệt tôi."
  },
  {
    "idx": 9037,
    "start": "04:13:01,452",
    "end": "04:13:02,572",
    "start_sec": 15181.452,
    "end_sec": 15182.572,
    "zh": "在往深处想",
    "vi": "Nghĩ sâu hơn một chút."
  },
  {
    "idx": 9038,
    "start": "04:13:02,572",
    "end": "04:13:05,172",
    "start_sec": 15182.572,
    "end_sec": 15185.172,
    "zh": "周赫山会不会是早在023找到我前",
    "vi": "Liệu Chu Hách Sơn có phải từ trước khi 023 tìm thấy tôi."
  },
  {
    "idx": 9039,
    "start": "04:13:05,172",
    "end": "04:13:06,112",
    "start_sec": 15185.172,
    "end_sec": 15186.112,
    "zh": "就进入了鬼域",
    "vi": "Đã đi vào quỷ vực rồi."
  },
  {
    "idx": 9040,
    "start": "04:13:06,112",
    "end": "04:13:07,532",
    "start_sec": 15186.112,
    "end_sec": 15187.532,
    "zh": "在这里驾驭了一只物账鬼",
    "vi": "Và đã chế ngự được một con quỷ chướng khí ở đây."
  },
  {
    "idx": 9041,
    "start": "04:13:07,532",
    "end": "04:13:08,332",
    "start_sec": 15187.532,
    "end_sec": 15188.332,
    "zh": "毕竟",
    "vi": "Dù sao thì"
  },
  {
    "idx": 9042,
    "start": "04:13:08,332",
    "end": "04:13:09,632",
    "start_sec": 15188.332,
    "end_sec": 15189.632,
    "zh": "轨迹持有者的能力",
    "vi": "Năng lực của người sở hữu quỹ tích"
  },
  {
    "idx": 9043,
    "start": "04:13:09,632",
    "end": "04:13:10,672",
    "start_sec": 15189.632,
    "end_sec": 15190.672,
    "zh": "就是和轨迹交流",
    "vi": "Chính là giao tiếp với quỹ tích."
  },
  {
    "idx": 9044,
    "start": "04:13:10,672",
    "end": "04:13:11,892",
    "start_sec": 15190.672,
    "end_sec": 15191.892,
    "zh": "他既能打开轨迹",
    "vi": "Hắn vừa có thể mở ra quỹ tích."
  },
  {
    "idx": 9045,
    "start": "04:13:11,892",
    "end": "04:13:13,172",
    "start_sec": 15191.892,
    "end_sec": 15193.172,
    "zh": "又能操红物账鬼",
    "vi": "Lại vừa có thể điều khiển quỷ chướng khí."
  },
  {
    "idx": 9046,
    "start": "04:13:13,172",
    "end": "04:13:14,692",
    "start_sec": 15193.172,
    "end_sec": 15194.692,
    "zh": "是一个双轨迹持有者",
    "vi": "Là một người sở hữu quỹ tích kép."
  },
  {
    "idx": 9047,
    "start": "04:13:14,692",
    "end": "04:13:16,232",
    "start_sec": 15194.692,
    "end_sec": 15196.232,
    "zh": "这样便能解释他",
    "vi": "Như vậy có thể giải thích được lý do."
  },
  {
    "idx": 9048,
    "start": "04:13:16,232",
    "end": "04:13:18,072",
    "start_sec": 15196.232,
    "end_sec": 15198.072,
    "zh": "每次在023面前开启轨迹",
    "vi": "Mỗi lần hắn mở ra quỹ tích trước mặt 023."
  },
  {
    "idx": 9049,
    "start": "04:13:18,072",
    "end": "04:13:19,712",
    "start_sec": 15198.072,
    "end_sec": 15199.712,
    "zh": "证实自己是真人的原因了",
    "vi": "Để chứng minh bản thân là người sống."
  },
  {
    "idx": 9050,
    "start": "04:13:19,712",
    "end": "04:13:21,272",
    "start_sec": 15199.712,
    "end_sec": 15201.272,
    "zh": "长子皮越想越觉得",
    "vi": "Trương Tử Bì càng nghĩ càng cảm thấy."
  },
  {
    "idx": 9051,
    "start": "04:13:21,272",
    "end": "04:13:23,472",
    "start_sec": 15201.272,
    "end_sec": 15203.472,
    "zh": "周赫山就是这一切的幕后推手",
    "vi": "Chu Hách Sơn chính là kẻ đứng sau giật dây mọi chuyện."
  },
  {
    "idx": 9052,
    "start": "04:13:23,472",
    "end": "04:13:25,552",
    "start_sec": 15203.472,
    "end_sec": 15205.552,
    "zh": "就在长子皮思考之际",
    "vi": "Ngay trong lúc Trương Tử Bì đang suy nghĩ."
  },
  {
    "idx": 9053,
    "start": "04:13:25,552",
    "end": "04:13:26,192",
    "start_sec": 15205.552,
    "end_sec": 15206.192,
    "zh": "水雾中",
    "vi": "Trong làn sương nước."
  },
  {
    "idx": 9054,
    "start": "04:13:26,192",
    "end": "04:13:27,852",
    "start_sec": 15206.192,
    "end_sec": 15207.852,
    "zh": "无数人影穿梭而来",
    "vi": "Vô số bóng người đang lao tới."
  },
  {
    "idx": 9055,
    "start": "04:13:27,852",
    "end": "04:13:28,852",
    "start_sec": 15207.852,
    "end_sec": 15208.852,
    "zh": "他们没有形体",
    "vi": "Chúng không có hình thể."
  },
  {
    "idx": 9056,
    "start": "04:13:28,852",
    "end": "04:13:30,132",
    "start_sec": 15208.852,
    "end_sec": 15210.132,
    "zh": "像是人形的水怪",
    "vi": "Trông giống như những thủy quái hình người."
  },
  {
    "idx": 9057,
    "start": "04:13:30,132",
    "end": "04:13:30,792",
    "start_sec": 15210.132,
    "end_sec": 15210.792,
    "zh": "不过",
    "vi": "Thế nhưng"
  },
  {
    "idx": 9058,
    "start": "04:13:30,792",
    "end": "04:13:33,072",
    "start_sec": 15210.792,
    "end_sec": 15213.072,
    "zh": "在毫无压制的鬼面窗目视之下",
    "vi": "Dưới cái nhìn không hề bị áp chế của cửa sổ mặt quỷ."
  },
  {
    "idx": 9059,
    "start": "04:13:33,072",
    "end": "04:13:35,152",
    "start_sec": 15213.072,
    "end_sec": 15215.152,
    "zh": "一个个水怪接二连三的大事",
    "vi": "Từng con thủy quái lần lượt tan biến."
  },
  {
    "idx": 9060,
    "start": "04:13:35,152",
    "end": "04:13:39,252",
    "start_sec": 15215.152,
    "end_sec": 15219.252,
    "zh": "长子提和光子忙着掏出手机",
    "vi": "Trương Tử Bì và Quang Tử vội vàng rút điện thoại ra."
  },
  {
    "idx": 9061,
    "start": "04:13:39,252",
    "end": "04:13:40,072",
    "start_sec": 15219.252,
    "end_sec": 15220.072,
    "zh": "小子",
    "vi": "Nhóc con."
  },
  {
    "idx": 9062,
    "start": "04:13:40,072",
    "end": "04:13:41,212",
    "start_sec": 15220.072,
    "end_sec": 15221.212,
    "zh": "这么多个怪物",
    "vi": "Nhiều quái vật như thế này."
  },
  {
    "idx": 9063,
    "start": "04:13:41,212",
    "end": "04:13:42,152",
    "start_sec": 15221.212,
    "end_sec": 15222.152,
    "zh": "我这全杀了",
    "vi": "Ta mà giết sạch chỗ này."
  },
  {
    "idx": 9064,
    "start": "04:13:42,152",
    "end": "04:13:43,512",
    "start_sec": 15222.152,
    "end_sec": 15223.512,
    "zh": "你身体吃了消吗",
    "vi": "Cơ thể ngươi có chịu đựng nổi không."
  },
  {
    "idx": 9065,
    "start": "04:13:43,512",
    "end": "04:13:44,732",
    "start_sec": 15223.512,
    "end_sec": 15224.732,
    "zh": "你尽管动手",
    "vi": "Ngươi cứ việc ra tay đi."
  },
  {
    "idx": 9066,
    "start": "04:13:44,732",
    "end": "04:13:46,192",
    "start_sec": 15224.732,
    "end_sec": 15226.192,
    "zh": "复苏了算我呢",
    "vi": "Nếu ta có thức tỉnh thì cứ tính cho ta."
  },
  {
    "idx": 9067,
    "start": "04:13:46,192",
    "end": "04:13:46,772",
    "start_sec": 15226.192,
    "end_sec": 15226.772,
    "zh": "嘿嘿",
    "vi": "Hắc hắc."
  },
  {
    "idx": 9068,
    "start": "04:13:46,772",
    "end": "04:13:47,532",
    "start_sec": 15226.772,
    "end_sec": 15227.532,
    "zh": "小子",
    "vi": "Nhóc con."
  },
  {
    "idx": 9069,
    "start": "04:13:47,532",
    "end": "04:13:48,912",
    "start_sec": 15227.532,
    "end_sec": 15228.912,
    "zh": "我要感谢你啊",
    "vi": "Ta phải cảm ơn ngươi rồi."
  },
  {
    "idx": 9070,
    "start": "04:13:48,912",
    "end": "04:13:49,532",
    "start_sec": 15228.912,
    "end_sec": 15229.532,
    "zh": "你死后",
    "vi": "Sau khi ngươi chết."
  },
  {
    "idx": 9071,
    "start": "04:13:49,532",
    "end": "04:13:50,532",
    "start_sec": 15229.532,
    "end_sec": 15230.532,
    "zh": "我复苏了",
    "vi": "Ta thức tỉnh hoàn toàn."
  },
  {
    "idx": 9072,
    "start": "04:13:50,532",
    "end": "04:13:51,932",
    "start_sec": 15230.532,
    "end_sec": 15231.932,
    "zh": "会替你报仇的",
    "vi": "Sẽ báo thù thay cho ngươi."
  },
  {
    "idx": 9073,
    "start": "04:13:51,932",
    "end": "04:13:52,512",
    "start_sec": 15231.932,
    "end_sec": 15232.512,
    "zh": "你放心",
    "vi": "Ngươi cứ yên tâm."
  },
  {
    "idx": 9074,
    "start": "04:13:52,512",
    "end": "04:13:53,592",
    "start_sec": 15232.512,
    "end_sec": 15233.592,
    "zh": "这片鬼域",
    "vi": "Mảnh quỷ vực này."
  },
  {
    "idx": 9075,
    "start": "04:13:53,592",
    "end": "04:13:54,712",
    "start_sec": 15233.592,
    "end_sec": 15234.712,
    "zh": "以后的主人",
    "vi": "Chủ nhân sau này của nó."
  },
  {
    "idx": 9076,
    "start": "04:13:54,712",
    "end": "04:13:56,092",
    "start_sec": 15234.712,
    "end_sec": 15236.092,
    "zh": "会是本大爷子",
    "vi": "Sẽ là bổn đại gia ta."
  },
  {
    "idx": 9077,
    "start": "04:13:56,092",
    "end": "04:13:58,392",
    "start_sec": 15236.092,
    "end_sec": 15238.392,
    "zh": "长子提没有理会鬼面窗的姿态",
    "vi": "Trương Tử Bì không thèm để ý đến thái độ của Quỷ Diện Song."
  },
  {
    "idx": 9078,
    "start": "04:13:58,392",
    "end": "04:14:00,792",
    "start_sec": 15238.392,
    "end_sec": 15240.792,
    "zh": "只是迅速将消息发给过去的自己",
    "vi": "Chỉ nhanh chóng gửi tin nhắn cho bản thân trong quá khứ."
  },
  {
    "idx": 9079,
    "start": "04:14:00,792",
    "end": "04:14:01,652",
    "start_sec": 15240.792,
    "end_sec": 15241.652,
    "zh": "随后",
    "vi": "Sau đó."
  },
  {
    "idx": 9080,
    "start": "04:14:01,652",
    "end": "04:14:03,272",
    "start_sec": 15241.652,
    "end_sec": 15243.272,
    "zh": "长子提快步离开找门",
    "vi": "Trương Tử Bì nhanh chóng rời đi tìm cửa."
  },
  {
    "idx": 9081,
    "start": "04:14:03,272",
    "end": "04:14:04,812",
    "start_sec": 15243.272,
    "end_sec": 15244.812,
    "zh": "在鬼面窗的家之下",
    "vi": "Dưới sự hỗ trợ của Quỷ Diện Song."
  },
  {
    "idx": 9082,
    "start": "04:14:04,812",
    "end": "04:14:05,812",
    "start_sec": 15244.812,
    "end_sec": 15245.812,
    "zh": "它们迈出一步",
    "vi": "Mỗi khi anh ta bước ra một bước."
  },
  {
    "idx": 9083,
    "start": "04:14:05,812",
    "end": "04:14:07,872",
    "start_sec": 15245.812,
    "end_sec": 15247.872,
    "zh": "就有一只物障鬼的分裂体罩",
    "vi": "Thì có một phân thân của Vật Chướng Quỷ bị tiêu diệt."
  },
  {
    "idx": 9084,
    "start": "04:14:07,872",
    "end": "04:14:09,452",
    "start_sec": 15247.872,
    "end_sec": 15249.452,
    "zh": "趁在下次重开之前",
    "vi": "Tranh thủ trước lần thiết lập lại tiếp theo."
  },
  {
    "idx": 9085,
    "start": "04:14:09,452",
    "end": "04:14:11,592",
    "start_sec": 15249.452,
    "end_sec": 15251.592,
    "zh": "现在还是要尽可能的探索这片鬼域",
    "vi": "Hiện tại vẫn phải cố gắng hết sức khám phá mảnh quỷ vực này."
  },
  {
    "idx": 9086,
    "start": "04:14:11,592",
    "end": "04:14:13,052",
    "start_sec": 15251.592,
    "end_sec": 15253.052,
    "zh": "最好是能找到周和山",
    "vi": "Tốt nhất là có thể tìm thấy Chu Hòa Sơn."
  },
  {
    "idx": 9087,
    "start": "04:14:13,052",
    "end": "04:14:13,892",
    "start_sec": 15253.052,
    "end_sec": 15253.892,
    "zh": "不多时",
    "vi": "Không lâu sau."
  },
  {
    "idx": 9088,
    "start": "04:14:13,892",
    "end": "04:14:16,632",
    "start_sec": 15253.892,
    "end_sec": 15256.632,
    "zh": "橙子皮脖子上的第二道鬼纹也消失",
    "vi": "Đạo quỷ văn thứ hai trên cổ Trương Tử Bì cũng biến mất."
  },
  {
    "idx": 9089,
    "start": "04:14:16,632",
    "end": "04:14:17,572",
    "start_sec": 15256.632,
    "end_sec": 15257.572,
    "zh": "一路前行",
    "vi": "Đi suốt chặng đường."
  },
  {
    "idx": 9090,
    "start": "04:14:17,572",
    "end": "04:14:20,052",
    "start_sec": 15257.572,
    "end_sec": 15260.052,
    "zh": "终于眼前的水雾淡泊起来",
    "vi": "Cuối cùng sương mù trước mắt cũng nhạt dần."
  },
  {
    "idx": 9091,
    "start": "04:14:20,052",
    "end": "04:14:21,432",
    "start_sec": 15260.052,
    "end_sec": 15261.432,
    "zh": "在水雾树林的尽头",
    "vi": "Ở cuối khu rừng sương mù."
  },
  {
    "idx": 9092,
    "start": "04:14:21,432",
    "end": "04:14:23,692",
    "start_sec": 15261.432,
    "end_sec": 15263.692,
    "zh": "竟然有一片看不到尽头的湖泊",
    "vi": "Lại xuất hiện một hồ nước rộng không thấy bờ."
  },
  {
    "idx": 9093,
    "start": "04:14:23,692",
    "end": "04:14:24,672",
    "start_sec": 15263.692,
    "end_sec": 15264.672,
    "zh": "湖泊边上",
    "vi": "Bên bờ hồ."
  },
  {
    "idx": 9094,
    "start": "04:14:24,672",
    "end": "04:14:26,812",
    "start_sec": 15264.672,
    "end_sec": 15266.812,
    "zh": "一个与周扬长相相似的老人",
    "vi": "Một ông lão có ngoại hình giống hệt Chu Dương."
  },
  {
    "idx": 9095,
    "start": "04:14:26,812",
    "end": "04:14:29,172",
    "start_sec": 15266.812,
    "end_sec": 15269.172,
    "zh": "正恳指着一具已经火烂的老师",
    "vi": "Đang ngồi cạnh một xác chó đã cháy đen."
  },
  {
    "idx": 9096,
    "start": "04:14:29,172",
    "end": "04:14:29,912",
    "start_sec": 15269.172,
    "end_sec": 15269.912,
    "zh": "这是",
    "vi": "Đây là."
  },
  {
    "idx": 9097,
    "start": "04:14:29,912",
    "end": "04:14:31,652",
    "start_sec": 15269.912,
    "end_sec": 15271.652,
    "zh": "故事的我送给周扬的黑狗",
    "vi": "Con chó đen mà tôi tặng cho Chu Dương."
  },
  {
    "idx": 9098,
    "start": "04:14:31,652",
    "end": "04:14:32,492",
    "start_sec": 15271.652,
    "end_sec": 15272.492,
    "zh": "小黑子",
    "vi": "Tiểu Hắc."
  },
  {
    "idx": 9099,
    "start": "04:14:32,492",
    "end": "04:14:34,832",
    "start_sec": 15272.492,
    "end_sec": 15274.832,
    "zh": "明明就是周赫山了吧",
    "vi": "Chắc chắn đó là Chu Hòa Sơn rồi."
  },
  {
    "idx": 9100,
    "start": "04:14:34,832",
    "end": "04:14:35,452",
    "start_sec": 15274.832,
    "end_sec": 15275.452,
    "zh": "该死",
    "vi": "Đáng chết thật."
  },
  {
    "idx": 9101,
    "start": "04:14:35,452",
    "end": "04:14:37,412",
    "start_sec": 15275.452,
    "end_sec": 15277.412,
    "zh": "你已经变得和鬼力一样了吗",
    "vi": "Ông đã biến thành quỷ dữ rồi sao."
  },
  {
    "idx": 9102,
    "start": "04:14:37,412",
    "end": "04:14:38,532",
    "start_sec": 15277.412,
    "end_sec": 15278.532,
    "zh": "这可是你儿子的狗",
    "vi": "Đó là chó của con trai ông đấy."
  },
  {
    "idx": 9103,
    "start": "04:14:38,532",
    "end": "04:14:41,612",
    "start_sec": 15278.532,
    "end_sec": 15281.612,
    "zh": "这玩意不好吃",
    "vi": "Thứ này ăn không ngon."
  },
  {
    "idx": 9104,
    "start": "04:14:41,612",
    "end": "04:14:43,512",
    "start_sec": 15281.612,
    "end_sec": 15283.512,
    "zh": "只有要新鲜的才好吃",
    "vi": "Chỉ có đồ tươi mới ngon thôi."
  },
  {
    "idx": 9105,
    "start": "04:14:43,512",
    "end": "04:14:45,332",
    "start_sec": 15283.512,
    "end_sec": 15285.332,
    "zh": "你的内子狗挺精神",
    "vi": "Con chó của con trai tôi khá linh hoạt."
  },
  {
    "idx": 9106,
    "start": "04:14:45,332",
    "end": "04:14:47,352",
    "start_sec": 15285.332,
    "end_sec": 15287.352,
    "zh": "不过为了让你上当",
    "vi": "Nhưng để lừa được cậu."
  },
  {
    "idx": 9107,
    "start": "04:14:47,352",
    "end": "04:14:48,532",
    "start_sec": 15287.352,
    "end_sec": 15288.532,
    "zh": "只能先晾着",
    "vi": "Đành phải để nó ở đó trước."
  },
  {
    "idx": 9108,
    "start": "04:14:48,532",
    "end": "04:14:50,232",
    "start_sec": 15288.532,
    "end_sec": 15290.232,
    "zh": "床子皮咬牙",
    "vi": "Trương Tử Bì nghiến răng."
  },
  {
    "idx": 9109,
    "start": "04:14:50,232",
    "end": "04:14:51,692",
    "start_sec": 15290.232,
    "end_sec": 15291.692,
    "zh": "毁灭窗在里方吧",
    "vi": "Hắn lao thẳng về phía trước."
  },
  {
    "idx": 9110,
    "start": "04:14:51,692",
    "end": "04:14:53,432",
    "start_sec": 15291.692,
    "end_sec": 15293.432,
    "zh": "他就奔冲到周赫山面前",
    "vi": "Cậu lao đến trước mặt Chu Hòa Sơn."
  },
  {
    "idx": 9111,
    "start": "04:14:53,432",
    "end": "04:14:54,732",
    "start_sec": 15293.432,
    "end_sec": 15294.732,
    "zh": "一拳打了上去",
    "vi": "Vung một cú đấm vào ông ta."
  },
  {
    "idx": 9112,
    "start": "04:14:54,732",
    "end": "04:15:01,295",
    "start_sec": 15294.732,
    "end_sec": 15301.295,
    "zh": "你看看防我小木槿床子皮没有得到回应而周赫山嘴角一直含笑下一秒,直接被抬上去这个,竟然也是灰身",
    "vi": "Trương Tử Bì không nhận được phản hồi còn Chu Hòa Sơn vẫn mỉm cười và"
  },
  {
    "idx": 9112,
    "start": "04:15:01,295",
    "end": "04:15:07,038",
    "start_sec": 15301.295,
    "end_sec": 15307.038,
    "zh": "你看看防我小木槿床子皮没有得到回应而周赫山嘴角一直含笑下一秒,直接被抬上去这个,竟然也是灰身",
    "vi": "giây tiếp theo hắn bị hất văng đi vì kẻ này cũng là quỷ."
  },
  {
    "idx": 9113,
    "start": "04:15:07,038",
    "end": "04:15:10,718",
    "start_sec": 15307.038,
    "end_sec": 15310.718,
    "zh": "突然,橙子皮只觉得一阵阴风从后背袭来",
    "vi": "Đột nhiên Trương Tử Bì cảm thấy một luồng khí lạnh ập đến từ phía sau."
  },
  {
    "idx": 9114,
    "start": "04:15:10,718",
    "end": "04:15:15,458",
    "start_sec": 15310.718,
    "end_sec": 15315.458,
    "zh": "老人厉害,咱们来试试这次的比率",
    "vi": "Ông lão giỏi lắm chúng ta hãy thử sức với số lượng này xem."
  },
  {
    "idx": 9115,
    "start": "04:15:15,458",
    "end": "04:15:17,958",
    "start_sec": 15315.458,
    "end_sec": 15317.958,
    "zh": "数百个老人齐齐看向橙子皮",
    "vi": "Hàng trăm ông lão đồng loạt nhìn về phía Trương Tử Bì."
  },
  {
    "idx": 9116,
    "start": "04:15:17,958",
    "end": "04:15:19,398",
    "start_sec": 15317.958,
    "end_sec": 15319.398,
    "zh": "露出猙獰的笑容",
    "vi": "Để lộ nụ cười hung ác."
  },
  {
    "idx": 9117,
    "start": "04:15:19,398",
    "end": "04:15:21,258",
    "start_sec": 15319.398,
    "end_sec": 15321.258,
    "zh": "到底,哪个才是周赫山",
    "vi": "Rốt cuộc đâu mới là Chu Hòa Sơn."
  },
  {
    "idx": 9118,
    "start": "04:15:21,258",
    "end": "04:15:22,318",
    "start_sec": 15321.258,
    "end_sec": 15322.318,
    "zh": "又或者都不是",
    "vi": "Hay là không ai trong số đó."
  },
  {
    "idx": 9119,
    "start": "04:15:22,318",
    "end": "04:15:23,878",
    "start_sec": 15322.318,
    "end_sec": 15323.878,
    "zh": "妈的,鬼面窗",
    "vi": "Chết tiệt Quỷ Diện Trương."
  },
  {
    "idx": 9120,
    "start": "04:15:23,878",
    "end": "04:15:24,858",
    "start_sec": 15323.878,
    "end_sec": 15324.858,
    "zh": "交给你了",
    "vi": "Giao cho cậu đấy."
  },
  {
    "idx": 9121,
    "start": "04:15:24,858",
    "end": "04:15:26,098",
    "start_sec": 15324.858,
    "end_sec": 15326.098,
    "zh": "长子皮黑着脸",
    "vi": "Trưởng Tử Bì sa sầm mặt lại."
  },
  {
    "idx": 9122,
    "start": "04:15:26,098",
    "end": "04:15:28,118",
    "start_sec": 15326.098,
    "end_sec": 15328.118,
    "zh": "要是这次找不到周赫山的本体",
    "vi": "Nếu lần này không tìm được bản thể của Chu Hách Sơn."
  },
  {
    "idx": 9123,
    "start": "04:15:28,118",
    "end": "04:15:30,298",
    "start_sec": 15328.118,
    "end_sec": 15330.298,
    "zh": "重开之后再来一次也是白了",
    "vi": "Thì có hồi sinh làm lại từ đầu cũng vô ích."
  },
  {
    "idx": 9124,
    "start": "04:15:30,298",
    "end": "04:15:31,098",
    "start_sec": 15330.298,
    "end_sec": 15331.098,
    "zh": "鬼面疮",
    "vi": "Quỷ Diện Sang."
  },
  {
    "idx": 9125,
    "start": "04:15:31,098",
    "end": "04:15:32,098",
    "start_sec": 15331.098,
    "end_sec": 15332.098,
    "zh": "动手啊",
    "vi": "Ra tay đi."
  },
  {
    "idx": 9126,
    "start": "04:15:32,098",
    "end": "04:15:33,298",
    "start_sec": 15332.098,
    "end_sec": 15333.298,
    "zh": "嘿嘿嘿",
    "vi": "Hắc hắc hắc."
  },
  {
    "idx": 9127,
    "start": "04:15:33,298",
    "end": "04:15:33,738",
    "start_sec": 15333.298,
    "end_sec": 15333.738,
    "zh": "小的",
    "vi": "Nhóc con."
  },
  {
    "idx": 9128,
    "start": "04:15:33,738",
    "end": "04:15:35,098",
    "start_sec": 15333.738,
    "end_sec": 15335.098,
    "zh": "你已经撑不住了",
    "vi": "Ngươi sắp không chống đỡ nổi nữa rồi."
  },
  {
    "idx": 9129,
    "start": "04:15:35,098",
    "end": "04:15:36,178",
    "start_sec": 15335.098,
    "end_sec": 15336.178,
    "zh": "我就是不杀他们",
    "vi": "Ta không giết bọn chúng đâu."
  },
  {
    "idx": 9130,
    "start": "04:15:36,178",
    "end": "04:15:37,618",
    "start_sec": 15336.178,
    "end_sec": 15337.618,
    "zh": "反正他们也不是本体",
    "vi": "Dù sao bọn chúng cũng không phải bản thể."
  },
  {
    "idx": 9131,
    "start": "04:15:37,618",
    "end": "04:15:38,718",
    "start_sec": 15337.618,
    "end_sec": 15338.718,
    "zh": "杀了也没意思",
    "vi": "Giết cũng chẳng có vị gì."
  },
  {
    "idx": 9132,
    "start": "04:15:38,718",
    "end": "04:15:39,978",
    "start_sec": 15338.718,
    "end_sec": 15339.978,
    "zh": "等我成土体了",
    "vi": "Đợi ta có được thực thể rồi."
  },
  {
    "idx": 9133,
    "start": "04:15:39,978",
    "end": "04:15:41,358",
    "start_sec": 15339.978,
    "end_sec": 15341.358,
    "zh": "我再好好清剿这",
    "vi": "Ta sẽ dọn dẹp sạch sẽ nơi này."
  },
  {
    "idx": 9134,
    "start": "04:15:41,358",
    "end": "04:15:42,598",
    "start_sec": 15341.358,
    "end_sec": 15342.598,
    "zh": "长子皮冷着脸",
    "vi": "Trưởng Tử Bì lạnh mặt."
  },
  {
    "idx": 9135,
    "start": "04:15:42,598",
    "end": "04:15:44,798",
    "start_sec": 15342.598,
    "end_sec": 15344.798,
    "zh": "脖子上的第三道鬼纹已经消失",
    "vi": "Quỷ văn thứ ba trên cổ đã biến mất."
  },
  {
    "idx": 9136,
    "start": "04:15:44,798",
    "end": "04:15:46,398",
    "start_sec": 15344.798,
    "end_sec": 15346.398,
    "zh": "已经压制不住鬼面疮",
    "vi": "Đã không còn áp chế được Quỷ Diện Sang nữa."
  },
  {
    "idx": 9137,
    "start": "04:15:46,398",
    "end": "04:15:48,058",
    "start_sec": 15346.398,
    "end_sec": 15348.058,
    "zh": "反正我都要死了",
    "vi": "Dù sao ta cũng sắp chết rồi."
  },
  {
    "idx": 9138,
    "start": "04:15:48,058",
    "end": "04:15:49,718",
    "start_sec": 15348.058,
    "end_sec": 15349.718,
    "zh": "不如我求你一件事吧",
    "vi": "Hay là ta cầu xin ngươi một chuyện nhé."
  },
  {
    "idx": 9139,
    "start": "04:15:49,718",
    "end": "04:15:50,218",
    "start_sec": 15349.718,
    "end_sec": 15350.218,
    "zh": "哦",
    "vi": "Ồ."
  },
  {
    "idx": 9140,
    "start": "04:15:50,218",
    "end": "04:15:51,338",
    "start_sec": 15350.218,
    "end_sec": 15351.338,
    "zh": "难得啊",
    "vi": "Hiếm thấy đấy."
  },
  {
    "idx": 9141,
    "start": "04:15:51,338",
    "end": "04:15:52,258",
    "start_sec": 15351.338,
    "end_sec": 15352.258,
    "zh": "你求我",
    "vi": "Ngươi cầu xin ta sao."
  },
  {
    "idx": 9142,
    "start": "04:15:52,258",
    "end": "04:15:52,618",
    "start_sec": 15352.258,
    "end_sec": 15352.618,
    "zh": "对",
    "vi": "Đúng vậy."
  },
  {
    "idx": 9143,
    "start": "04:15:52,618",
    "end": "04:15:54,178",
    "start_sec": 15352.618,
    "end_sec": 15354.178,
    "zh": "让我看看你真正的力量",
    "vi": "Hãy cho ta thấy sức mạnh thực sự của ngươi."
  },
  {
    "idx": 9144,
    "start": "04:15:54,178",
    "end": "04:15:54,698",
    "start_sec": 15354.178,
    "end_sec": 15354.698,
    "zh": "还有",
    "vi": "Còn nữa."
  },
  {
    "idx": 9145,
    "start": "04:15:54,698",
    "end": "04:15:55,758",
    "start_sec": 15354.698,
    "end_sec": 15355.758,
    "zh": "如果可以",
    "vi": "Nếu có thể."
  },
  {
    "idx": 9146,
    "start": "04:15:55,758",
    "end": "04:15:57,338",
    "start_sec": 15355.758,
    "end_sec": 15357.338,
    "zh": "我想看到他们死光了",
    "vi": "Ta muốn nhìn thấy bọn họ chết sạch rồi."
  },
  {
    "idx": 9147,
    "start": "04:15:57,338",
    "end": "04:15:57,838",
    "start_sec": 15357.338,
    "end_sec": 15357.838,
    "zh": "我在死",
    "vi": "Ta mới chết."
  },
  {
    "idx": 9148,
    "start": "04:15:57,838",
    "end": "04:15:58,498",
    "start_sec": 15357.838,
    "end_sec": 15358.498,
    "zh": "可以吗",
    "vi": "Có được không."
  },
  {
    "idx": 9149,
    "start": "04:15:58,498",
    "end": "04:15:59,678",
    "start_sec": 15358.498,
    "end_sec": 15359.678,
    "zh": "我真正的力量",
    "vi": "Sức mạnh thực sự của ta sao."
  },
  {
    "idx": 9150,
    "start": "04:15:59,678",
    "end": "04:16:00,938",
    "start_sec": 15359.678,
    "end_sec": 15360.938,
    "zh": "小子",
    "vi": "Nhóc con."
  },
  {
    "idx": 9151,
    "start": "04:16:00,938",
    "end": "04:16:02,098",
    "start_sec": 15360.938,
    "end_sec": 15362.098,
    "zh": "你让我有点失望",
    "vi": "Ngươi làm ta hơi thất vọng."
  },
  {
    "idx": 9152,
    "start": "04:16:02,098",
    "end": "04:16:02,758",
    "start_sec": 15362.098,
    "end_sec": 15362.758,
    "zh": "不过",
    "vi": "Nhưng mà"
  },
  {
    "idx": 9153,
    "start": "04:16:02,758",
    "end": "04:16:04,198",
    "start_sec": 15362.758,
    "end_sec": 15364.198,
    "zh": "好歹和你相处一场",
    "vi": "dù sao cũng đã ở bên ngươi một thời gian"
  },
  {
    "idx": 9154,
    "start": "04:16:04,198",
    "end": "04:16:05,278",
    "start_sec": 15364.198,
    "end_sec": 15365.278,
    "zh": "就让你看看",
    "vi": "nên sẽ cho ngươi xem"
  },
  {
    "idx": 9155,
    "start": "04:16:05,278",
    "end": "04:16:06,018",
    "start_sec": 15365.278,
    "end_sec": 15366.018,
    "zh": "你一直以来",
    "vi": "sức mạnh mà bấy lâu nay"
  },
  {
    "idx": 9156,
    "start": "04:16:06,018",
    "end": "04:16:07,338",
    "start_sec": 15366.018,
    "end_sec": 15367.338,
    "zh": "所拥有的是什么力量",
    "vi": "ngươi đang sở hữu là gì."
  },
  {
    "idx": 9157,
    "start": "04:16:07,338",
    "end": "04:16:08,918",
    "start_sec": 15367.338,
    "end_sec": 15368.918,
    "zh": "左耿坚的鬼面窗",
    "vi": "Quỷ Diện Song của Tả Cảnh Kiên"
  },
  {
    "idx": 9158,
    "start": "04:16:08,918",
    "end": "04:16:09,798",
    "start_sec": 15368.918,
    "end_sec": 15369.798,
    "zh": "不见空荡",
    "vi": "không hề trống rỗng."
  },
  {
    "idx": 9159,
    "start": "04:16:09,798",
    "end": "04:16:11,098",
    "start_sec": 15369.798,
    "end_sec": 15371.098,
    "zh": "橙子皮的身体",
    "vi": "Cơ thể của Trần Tử Bì"
  },
  {
    "idx": 9160,
    "start": "04:16:11,098",
    "end": "04:16:12,338",
    "start_sec": 15371.098,
    "end_sec": 15372.338,
    "zh": "开始不受控制",
    "vi": "bắt đầu mất kiểm soát."
  },
  {
    "idx": 9161,
    "start": "04:16:12,338",
    "end": "04:16:14,158",
    "start_sec": 15372.338,
    "end_sec": 15374.158,
    "zh": "不落一群杂碎",
    "vi": "Chỉ là một lũ rác rưởi"
  },
  {
    "idx": 9162,
    "start": "04:16:14,158",
    "end": "04:16:15,558",
    "start_sec": 15374.158,
    "end_sec": 15375.558,
    "zh": "镇压",
    "vi": "Trấn áp."
  },
  {
    "idx": 9163,
    "start": "04:16:15,558",
    "end": "04:16:17,598",
    "start_sec": 15375.558,
    "end_sec": 15377.598,
    "zh": "原来",
    "vi": "Hóa ra"
  },
  {
    "idx": 9164,
    "start": "04:16:17,598",
    "end": "04:16:19,158",
    "start_sec": 15377.598,
    "end_sec": 15379.158,
    "zh": "鬼面窗的无效化能力之后",
    "vi": "sau khả năng vô hiệu hóa của Quỷ Diện Song"
  },
  {
    "idx": 9165,
    "start": "04:16:19,158",
    "end": "04:16:19,998",
    "start_sec": 15379.158,
    "end_sec": 15379.998,
    "zh": "还有镇压",
    "vi": "vẫn còn khả năng trấn áp."
  },
  {
    "idx": 9166,
    "start": "04:16:19,998",
    "end": "04:16:20,858",
    "start_sec": 15379.998,
    "end_sec": 15380.858,
    "zh": "白水消散",
    "vi": "Nước trắng tan biến"
  },
  {
    "idx": 9167,
    "start": "04:16:20,858",
    "end": "04:16:21,978",
    "start_sec": 15380.858,
    "end_sec": 15381.978,
    "zh": "但林宗的物体",
    "vi": "nhưng vật thể của Lâm Tông"
  },
  {
    "idx": 9168,
    "start": "04:16:21,978",
    "end": "04:16:22,638",
    "start_sec": 15381.978,
    "end_sec": 15382.638,
    "zh": "能被消散",
    "vi": "có thể bị tan biến"
  },
  {
    "idx": 9169,
    "start": "04:16:22,638",
    "end": "04:16:24,198",
    "start_sec": 15382.638,
    "end_sec": 15384.198,
    "zh": "说明周赫山的本体",
    "vi": "chứng tỏ bản thể của Chu Hách Sơn"
  },
  {
    "idx": 9170,
    "start": "04:16:24,198",
    "end": "04:16:25,018",
    "start_sec": 15384.198,
    "end_sec": 15385.018,
    "zh": "并不太集中",
    "vi": "không quá tập trung."
  },
  {
    "idx": 9171,
    "start": "04:16:25,018",
    "end": "04:16:26,978",
    "start_sec": 15385.018,
    "end_sec": 15386.978,
    "zh": "橙子皮满意的闭上眼睛",
    "vi": "Trần Tử Bì hài lòng nhắm mắt lại."
  },
  {
    "idx": 9172,
    "start": "04:16:26,978",
    "end": "04:16:27,758",
    "start_sec": 15386.978,
    "end_sec": 15387.758,
    "zh": "下一个",
    "vi": "Kẻ tiếp theo."
  },
  {
    "idx": 9173,
    "start": "04:16:27,758",
    "end": "04:16:28,758",
    "start_sec": 15387.758,
    "end_sec": 15388.758,
    "zh": "炸开的这些",
    "vi": "Những thứ bị nổ tung này"
  },
  {
    "idx": 9174,
    "start": "04:16:28,758",
    "end": "04:16:30,138",
    "start_sec": 15388.758,
    "end_sec": 15390.138,
    "zh": "小的",
    "vi": "chỉ là chuyện nhỏ."
  },
  {
    "idx": 9175,
    "start": "04:16:30,138",
    "end": "04:16:31,818",
    "start_sec": 15390.138,
    "end_sec": 15391.818,
    "zh": "你让我很失望啊",
    "vi": "Ngươi làm ta rất thất vọng đó."
  },
  {
    "idx": 9176,
    "start": "04:16:31,818",
    "end": "04:16:32,958",
    "start_sec": 15391.818,
    "end_sec": 15392.958,
    "zh": "那好",
    "vi": "Được rồi"
  },
  {
    "idx": 9177,
    "start": "04:16:32,958",
    "end": "04:16:35,298",
    "start_sec": 15392.958,
    "end_sec": 15395.298,
    "zh": "待会我会让组织发链接给你",
    "vi": "lát nữa ta sẽ bảo tổ chức gửi liên kết cho ngươi."
  },
  {
    "idx": 9178,
    "start": "04:16:35,298",
    "end": "04:16:35,958",
    "start_sec": 15395.298,
    "end_sec": 15395.958,
    "zh": "什么",
    "vi": "Cái gì."
  },
  {
    "idx": 9179,
    "start": "04:16:35,958",
    "end": "04:16:37,598",
    "start_sec": 15395.958,
    "end_sec": 15397.598,
    "zh": "浓厚的烟味传来",
    "vi": "Mùi khói nồng nặc truyền đến"
  },
  {
    "idx": 9180,
    "start": "04:16:37,598",
    "end": "04:16:38,838",
    "start_sec": 15397.598,
    "end_sec": 15398.838,
    "zh": "橙子皮在回神",
    "vi": "Trần Tử Bì đang tỉnh táo lại."
  },
  {
    "idx": 9181,
    "start": "04:16:38,838",
    "end": "04:16:40,958",
    "start_sec": 15398.838,
    "end_sec": 15400.958,
    "zh": "原来他回到了与零二三残忧",
    "vi": "Hóa ra anh ta đã quay lại thời điểm cùng Linh Nhị Tam"
  },
  {
    "idx": 9182,
    "start": "04:16:40,958",
    "end": "04:16:42,598",
    "start_sec": 15400.958,
    "end_sec": 15402.598,
    "zh": "加入玉鬼者组织的时候",
    "vi": "gia nhập tổ chức Ngự Quỷ Giả"
  },
  {
    "idx": 9183,
    "start": "04:16:42,598",
    "end": "04:16:43,358",
    "start_sec": 15402.598,
    "end_sec": 15403.358,
    "zh": "走吧",
    "vi": "Đi thôi"
  },
  {
    "idx": 9184,
    "start": "04:16:43,358",
    "end": "04:16:44,978",
    "start_sec": 15403.358,
    "end_sec": 15404.978,
    "zh": "现在我带你去看看",
    "vi": "Bây giờ ta đưa ngươi đi xem"
  },
  {
    "idx": 9185,
    "start": "04:16:44,978",
    "end": "04:16:46,158",
    "start_sec": 15404.978,
    "end_sec": 15406.158,
    "zh": "周赫山在哪",
    "vi": "Chu Hách Sơn đang ở đâu"
  },
  {
    "idx": 9186,
    "start": "04:16:46,158",
    "end": "04:16:48,438",
    "start_sec": 15406.158,
    "end_sec": 15408.438,
    "zh": "橙子皮跟在零二三身后",
    "vi": "Trần Tử Bì đi sau Linh Nhị Tam"
  },
  {
    "idx": 9187,
    "start": "04:16:48,438",
    "end": "04:16:49,478",
    "start_sec": 15408.438,
    "end_sec": 15409.478,
    "zh": "突然想到什么",
    "vi": "đột nhiên nghĩ ra điều gì đó"
  },
  {
    "idx": 9188,
    "start": "04:16:49,478",
    "end": "04:16:50,318",
    "start_sec": 15409.478,
    "end_sec": 15410.318,
    "zh": "对了",
    "vi": "Đúng rồi"
  },
  {
    "idx": 9189,
    "start": "04:16:50,318",
    "end": "04:16:52,258",
    "start_sec": 15410.318,
    "end_sec": 15412.258,
    "zh": "前辈你上午去看周赫山的时候",
    "vi": "Tiền bối lúc sáng tiền bối đi gặp Chu Hách Sơn"
  },
  {
    "idx": 9190,
    "start": "04:16:52,258",
    "end": "04:16:53,958",
    "start_sec": 15412.258,
    "end_sec": 15413.958,
    "zh": "他的身边有一条黑肿吗",
    "vi": "bên cạnh ông ta có một con chó đen không."
  },
  {
    "idx": 9191,
    "start": "04:16:53,958",
    "end": "04:16:54,958",
    "start_sec": 15413.958,
    "end_sec": 15414.958,
    "zh": "黑狗",
    "vi": "Chó đen."
  },
  {
    "idx": 9192,
    "start": "04:16:54,958",
    "end": "04:16:55,958",
    "start_sec": 15414.958,
    "end_sec": 15415.958,
    "zh": "什么黑狗",
    "vi": "Chó đen gì cơ."
  },
  {
    "idx": 9193,
    "start": "04:16:55,958",
    "end": "04:16:58,138",
    "start_sec": 15415.958,
    "end_sec": 15418.138,
    "zh": "就是周扬自己养的那只啊",
    "vi": "Chính là con chó do Chu Dương tự nuôi đó."
  },
  {
    "idx": 9194,
    "start": "04:16:58,138",
    "end": "04:16:58,958",
    "start_sec": 15418.138,
    "end_sec": 15418.958,
    "zh": "哦",
    "vi": "Ồ."
  },
  {
    "idx": 9195,
    "start": "04:16:58,958",
    "end": "04:17:00,198",
    "start_sec": 15418.958,
    "end_sec": 15420.198,
    "zh": "你说那只啊",
    "vi": "Ngươi nói con đó hả."
  },
  {
    "idx": 9196,
    "start": "04:17:00,198",
    "end": "04:17:02,098",
    "start_sec": 15420.198,
    "end_sec": 15422.098,
    "zh": "好像在他见过他父亲后",
    "vi": "Hình như sau khi cậu ta gặp cha mình"
  },
  {
    "idx": 9197,
    "start": "04:17:02,098",
    "end": "04:17:03,458",
    "start_sec": 15422.098,
    "end_sec": 15423.458,
    "zh": "放在船长室里",
    "vi": "đã để nó trong phòng thuyền trưởng"
  },
  {
    "idx": 9198,
    "start": "04:17:03,458",
    "end": "04:17:05,378",
    "start_sec": 15423.458,
    "end_sec": 15425.378,
    "zh": "某天在开启轨迹的时候",
    "vi": "Một ngày nọ khi mở quỹ đạo"
  },
  {
    "idx": 9199,
    "start": "04:17:05,378",
    "end": "04:17:07,458",
    "start_sec": 15425.378,
    "end_sec": 15427.458,
    "zh": "说是狗钻进去找不到了",
    "vi": "nghe nói con chó chui vào trong rồi mất tích."
  },
  {
    "idx": 9200,
    "start": "04:17:07,458",
    "end": "04:17:08,178",
    "start_sec": 15427.458,
    "end_sec": 15428.178,
    "zh": "是啊",
    "vi": "Đúng vậy."
  },
  {
    "idx": 9201,
    "start": "04:17:08,178",
    "end": "04:17:10,918",
    "start_sec": 15428.178,
    "end_sec": 15430.918,
    "zh": "周扬当时和我可不是这么说的",
    "vi": "Lúc đó Chu Dương không nói với tôi như thế."
  },
  {
    "idx": 9202,
    "start": "04:17:10,918",
    "end": "04:17:12,738",
    "start_sec": 15430.918,
    "end_sec": 15432.738,
    "zh": "岂不是说明周扬也有问题",
    "vi": "Chẳng lẽ Chu Dương cũng có vấn đề sao."
  },
  {
    "idx": 9203,
    "start": "04:17:12,738",
    "end": "04:17:14,758",
    "start_sec": 15432.738,
    "end_sec": 15434.758,
    "zh": "亏我之前还这么信任周扬",
    "vi": "Uổng công trước đây tôi tin tưởng Chu Dương như vậy."
  },
  {
    "idx": 9204,
    "start": "04:17:14,758",
    "end": "04:17:15,498",
    "start_sec": 15434.758,
    "end_sec": 15435.498,
    "zh": "还有",
    "vi": "Còn nữa"
  },
  {
    "idx": 9205,
    "start": "04:17:15,498",
    "end": "04:17:17,458",
    "start_sec": 15435.498,
    "end_sec": 15437.458,
    "zh": "周扬是可以随时在船长室",
    "vi": "Chu Dương có thể vào phòng thuyền trưởng"
  },
  {
    "idx": 9206,
    "start": "04:17:17,458",
    "end": "04:17:18,798",
    "start_sec": 15437.458,
    "end_sec": 15438.798,
    "zh": "看他父亲的吗",
    "vi": "gặp cha mình bất cứ lúc nào sao."
  },
  {
    "idx": 9207,
    "start": "04:17:18,798",
    "end": "04:17:19,518",
    "start_sec": 15438.798,
    "end_sec": 15439.518,
    "zh": "这个啊",
    "vi": "Chuyện này à."
  },
  {
    "idx": 9208,
    "start": "04:17:19,518",
    "end": "04:17:20,238",
    "start_sec": 15439.518,
    "end_sec": 15440.238,
    "zh": "他要是想",
    "vi": "Nếu cậu ta muốn"
  },
  {
    "idx": 9209,
    "start": "04:17:20,238",
    "end": "04:17:22,518",
    "start_sec": 15440.238,
    "end_sec": 15442.518,
    "zh": "提前用手机和他父亲说",
    "vi": "chỉ cần dùng điện thoại nói trước với cha mình"
  },
  {
    "idx": 9210,
    "start": "04:17:22,518",
    "end": "04:17:24,558",
    "start_sec": 15442.518,
    "end_sec": 15444.558,
    "zh": "他父亲在里面给他开门",
    "vi": "cha cậu ta sẽ mở cửa từ bên trong."
  },
  {
    "idx": 9211,
    "start": "04:17:24,558",
    "end": "04:17:26,238",
    "start_sec": 15444.558,
    "end_sec": 15446.238,
    "zh": "我们也是不会知道的",
    "vi": "Chúng tôi cũng không biết được"
  },
  {
    "idx": 9212,
    "start": "04:17:26,238",
    "end": "04:17:27,198",
    "start_sec": 15446.238,
    "end_sec": 15447.198,
    "zh": "原来如此",
    "vi": "Thì ra là vậy"
  },
  {
    "idx": 9213,
    "start": "04:17:27,198",
    "end": "04:17:28,198",
    "start_sec": 15447.198,
    "end_sec": 15448.198,
    "zh": "我说",
    "vi": "Nói này"
  },
  {
    "idx": 9214,
    "start": "04:17:28,198",
    "end": "04:17:30,338",
    "start_sec": 15448.198,
    "end_sec": 15450.338,
    "zh": "你怎么突然这么多问题啊",
    "vi": "Sao đột nhiên bạn có nhiều câu hỏi vậy"
  },
  {
    "idx": 9215,
    "start": "04:17:30,338",
    "end": "04:17:30,978",
    "start_sec": 15450.338,
    "end_sec": 15450.978,
    "zh": "没什么",
    "vi": "Không có gì"
  },
  {
    "idx": 9216,
    "start": "04:17:30,978",
    "end": "04:17:31,538",
    "start_sec": 15450.978,
    "end_sec": 15451.538,
    "zh": "对了",
    "vi": "À phải rồi"
  },
  {
    "idx": 9217,
    "start": "04:17:31,538",
    "end": "04:17:33,078",
    "start_sec": 15451.538,
    "end_sec": 15453.078,
    "zh": "我先不注册玉鬼子组织",
    "vi": "Tôi tạm thời không đăng ký tổ chức Ngự Quỷ"
  },
  {
    "idx": 9218,
    "start": "04:17:33,078",
    "end": "04:17:33,998",
    "start_sec": 15453.078,
    "end_sec": 15453.998,
    "zh": "应该没事吧",
    "vi": "Chắc không sao chứ"
  },
  {
    "idx": 9219,
    "start": "04:17:33,998",
    "end": "04:17:34,758",
    "start_sec": 15453.998,
    "end_sec": 15454.758,
    "zh": "没事",
    "vi": "Không sao"
  },
  {
    "idx": 9220,
    "start": "04:17:34,758",
    "end": "04:17:37,578",
    "start_sec": 15454.758,
    "end_sec": 15457.578,
    "zh": "你想什么时候注册就什么时候注册",
    "vi": "Bạn muốn đăng ký lúc nào cũng được"
  },
  {
    "idx": 9221,
    "start": "04:17:37,578",
    "end": "04:17:39,978",
    "start_sec": 15457.578,
    "end_sec": 15459.978,
    "zh": "任务奖励会算在一起的",
    "vi": "Phần thưởng nhiệm vụ sẽ được tính gộp lại"
  },
  {
    "idx": 9222,
    "start": "04:17:39,978",
    "end": "04:17:40,638",
    "start_sec": 15459.978,
    "end_sec": 15460.638,
    "zh": "那好",
    "vi": "Vậy thì tốt"
  },
  {
    "idx": 9223,
    "start": "04:17:40,638",
    "end": "04:17:41,478",
    "start_sec": 15460.638,
    "end_sec": 15461.478,
    "zh": "我没事了",
    "vi": "Tôi không có việc gì nữa rồi"
  },
  {
    "idx": 9224,
    "start": "04:17:41,478",
    "end": "04:17:44,598",
    "start_sec": 15461.478,
    "end_sec": 15464.598,
    "zh": "你这是",
    "vi": "Cái này của bạn là"
  },
  {
    "idx": 9225,
    "start": "04:17:44,598",
    "end": "04:17:46,418",
    "start_sec": 15464.598,
    "end_sec": 15466.418,
    "zh": "我再验证一件事",
    "vi": "Tôi cần xác minh lại một chuyện"
  },
  {
    "idx": 9226,
    "start": "04:17:46,418",
    "end": "04:17:47,818",
    "start_sec": 15466.418,
    "end_sec": 15467.818,
    "zh": "023点了点头",
    "vi": "023 gật đầu"
  },
  {
    "idx": 9227,
    "start": "04:17:47,818",
    "end": "04:17:48,878",
    "start_sec": 15467.818,
    "end_sec": 15468.878,
    "zh": "也没多说什么",
    "vi": "Không nói thêm gì"
  },
  {
    "idx": 9228,
    "start": "04:17:48,878",
    "end": "04:17:50,278",
    "start_sec": 15468.878,
    "end_sec": 15470.278,
    "zh": "我先回去了",
    "vi": "Tôi về trước đây"
  },
  {
    "idx": 9229,
    "start": "04:17:50,278",
    "end": "04:17:53,078",
    "start_sec": 15470.278,
    "end_sec": 15473.078,
    "zh": "周赫山早上刚打开过一次古镜",
    "vi": "Sáng nay Châu Hạc Sơn vừa mở cổ kính một lần"
  },
  {
    "idx": 9230,
    "start": "04:17:53,078",
    "end": "04:17:54,118",
    "start_sec": 15473.078,
    "end_sec": 15474.118,
    "zh": "我看他挺累的",
    "vi": "Tôi thấy ông ấy khá mệt"
  },
  {
    "idx": 9231,
    "start": "04:17:54,118",
    "end": "04:17:56,038",
    "start_sec": 15474.118,
    "end_sec": 15476.038,
    "zh": "你最好还是不要进去打扰",
    "vi": "Tốt nhất bạn đừng vào làm phiền"
  },
  {
    "idx": 9232,
    "start": "04:17:56,038",
    "end": "04:17:57,798",
    "start_sec": 15476.038,
    "end_sec": 15477.798,
    "zh": "长子皮蹲在门前",
    "vi": "Trưởng tử Bì ngồi xổm trước cửa"
  },
  {
    "idx": 9233,
    "start": "04:17:57,798",
    "end": "04:17:59,198",
    "start_sec": 15477.798,
    "end_sec": 15479.198,
    "zh": "我意识之前的心情",
    "vi": "Tôi nhớ lại tâm trạng lúc trước"
  },
  {
    "idx": 9234,
    "start": "04:17:59,198",
    "end": "04:18:01,158",
    "start_sec": 15479.198,
    "end_sec": 15481.158,
    "zh": "当时从这里回到周扬房间",
    "vi": "Lúc đó từ đây trở về phòng Châu Dương"
  },
  {
    "idx": 9235,
    "start": "04:18:01,158",
    "end": "04:18:02,338",
    "start_sec": 15481.158,
    "end_sec": 15482.338,
    "zh": "周扬却不在屋内",
    "vi": "Châu Dương lại không có ở trong phòng"
  },
  {
    "idx": 9236,
    "start": "04:18:02,338",
    "end": "04:18:04,158",
    "start_sec": 15482.338,
    "end_sec": 15484.158,
    "zh": "随后我收到御鬼者注册链接",
    "vi": "Sau đó tôi nhận được liên kết đăng ký Ngự Quỷ"
  },
  {
    "idx": 9237,
    "start": "04:18:04,158",
    "end": "04:18:05,278",
    "start_sec": 15484.158,
    "end_sec": 15485.278,
    "zh": "就研究起网站",
    "vi": "Và bắt đầu nghiên cứu trang web"
  },
  {
    "idx": 9238,
    "start": "04:18:05,278",
    "end": "04:18:06,938",
    "start_sec": 15485.278,
    "end_sec": 15486.938,
    "zh": "之后周扬回到房间",
    "vi": "Sau đó Châu Dương trở về phòng"
  },
  {
    "idx": 9239,
    "start": "04:18:06,938",
    "end": "04:18:09,598",
    "start_sec": 15486.938,
    "end_sec": 15489.598,
    "zh": "说小莫记被他送到周赫山那里了",
    "vi": "Nói Tiểu Mạc Ký đã được anh ta gửi đến chỗ Châu Hạc Sơn rồi"
  },
  {
    "idx": 9240,
    "start": "04:18:09,598",
    "end": "04:18:11,058",
    "start_sec": 15489.598,
    "end_sec": 15491.058,
    "zh": "如果周扬没说谎的话",
    "vi": "Nếu Châu Dương không nói dối"
  },
  {
    "idx": 9241,
    "start": "04:18:11,058",
    "end": "04:18:13,378",
    "start_sec": 15491.058,
    "end_sec": 15493.378,
    "zh": "那么他此时应该是在船长室",
    "vi": "Vậy lúc này chắc ông ấy đang ở trong phòng thuyền trưởng."
  },
  {
    "idx": 9242,
    "start": "04:18:13,378",
    "end": "04:18:18,578",
    "start_sec": 15493.378,
    "end_sec": 15498.578,
    "zh": "哎 程子皮",
    "vi": "Ơ, Trình Tử Bì."
  },
  {
    "idx": 9243,
    "start": "04:18:18,578",
    "end": "04:18:19,558",
    "start_sec": 15498.578,
    "end_sec": 15499.558,
    "zh": "你怎么在这",
    "vi": "Sao bạn lại ở đây."
  },
  {
    "idx": 9244,
    "start": "04:18:19,558",
    "end": "04:18:20,758",
    "start_sec": 15499.558,
    "end_sec": 15500.758,
    "zh": "小墨记呢",
    "vi": "Tiểu Mặc Ký đâu rồi."
  },
  {
    "idx": 9245,
    "start": "04:18:20,758",
    "end": "04:18:21,578",
    "start_sec": 15500.758,
    "end_sec": 15501.578,
    "zh": "小墨记",
    "vi": "Tiểu Mặc Ký hả."
  },
  {
    "idx": 9246,
    "start": "04:18:21,578",
    "end": "04:18:22,418",
    "start_sec": 15501.578,
    "end_sec": 15502.418,
    "zh": "这个",
    "vi": "Cái đó."
  },
  {
    "idx": 9247,
    "start": "04:18:22,418",
    "end": "04:18:23,218",
    "start_sec": 15502.418,
    "end_sec": 15503.218,
    "zh": "不好意思",
    "vi": "Xin lỗi nhé."
  },
  {
    "idx": 9248,
    "start": "04:18:23,218",
    "end": "04:18:24,518",
    "start_sec": 15503.218,
    "end_sec": 15504.518,
    "zh": "我爸太喜欢了",
    "vi": "Bố tôi thích nó quá."
  },
  {
    "idx": 9249,
    "start": "04:18:24,518",
    "end": "04:18:24,858",
    "start_sec": 15504.518,
    "end_sec": 15504.858,
    "zh": "所以",
    "vi": "Nên là."
  },
  {
    "idx": 9250,
    "start": "04:18:24,858",
    "end": "04:18:26,218",
    "start_sec": 15504.858,
    "end_sec": 15506.218,
    "zh": "所以给放他那了",
    "vi": "Nên đã để lại chỗ ông ấy rồi."
  },
  {
    "idx": 9251,
    "start": "04:18:26,218",
    "end": "04:18:26,678",
    "start_sec": 15506.218,
    "end_sec": 15506.678,
    "zh": "是吗",
    "vi": "Thế à."
  },
  {
    "idx": 9252,
    "start": "04:18:26,678",
    "end": "04:18:27,918",
    "start_sec": 15506.678,
    "end_sec": 15507.918,
    "zh": "想起在鬼域里",
    "vi": "Nghĩ đến cảnh trong Quỷ Vực."
  },
  {
    "idx": 9253,
    "start": "04:18:27,918",
    "end": "04:18:29,778",
    "start_sec": 15507.918,
    "end_sec": 15509.778,
    "zh": "小墨记被磨断脖子的模样",
    "vi": "Tiểu Mặc Ký bị cứa đứt cổ."
  },
  {
    "idx": 9254,
    "start": "04:18:29,778",
    "end": "04:18:30,478",
    "start_sec": 15509.778,
    "end_sec": 15510.478,
    "zh": "橙子皮",
    "vi": "Trình Tử Bì."
  },
  {
    "idx": 9255,
    "start": "04:18:30,478",
    "end": "04:18:31,658",
    "start_sec": 15510.478,
    "end_sec": 15511.658,
    "zh": "脸色独剪一路",
    "vi": "Sắc mặt dần sa sầm xuống."
  },
  {
    "idx": 9256,
    "start": "04:18:31,658",
    "end": "04:18:32,298",
    "start_sec": 15511.658,
    "end_sec": 15512.298,
    "zh": "周扬",
    "vi": "Chu Dương."
  },
  {
    "idx": 9257,
    "start": "04:18:32,298",
    "end": "04:18:33,618",
    "start_sec": 15512.298,
    "end_sec": 15513.618,
    "zh": "如果你不让你帮忙",
    "vi": "Nếu ông ấy không để bạn giúp đỡ."
  },
  {
    "idx": 9258,
    "start": "04:18:33,618",
    "end": "04:18:34,418",
    "start_sec": 15513.618,
    "end_sec": 15514.418,
    "zh": "你会帮吗",
    "vi": "Bạn có giúp không."
  },
  {
    "idx": 9259,
    "start": "04:18:34,418",
    "end": "04:18:35,738",
    "start_sec": 15514.418,
    "end_sec": 15515.738,
    "zh": "你问这个干嘛",
    "vi": "Bạn hỏi chuyện này làm gì."
  },
  {
    "idx": 9260,
    "start": "04:18:35,738",
    "end": "04:18:36,698",
    "start_sec": 15515.738,
    "end_sec": 15516.698,
    "zh": "我是他儿子",
    "vi": "Tôi là con trai ông ấy."
  },
  {
    "idx": 9261,
    "start": "04:18:36,698",
    "end": "04:18:37,538",
    "start_sec": 15516.698,
    "end_sec": 15517.538,
    "zh": "他要我干什么",
    "vi": "Ông ấy muốn tôi làm gì."
  },
  {
    "idx": 9262,
    "start": "04:18:37,538",
    "end": "04:18:39,038",
    "start_sec": 15517.538,
    "end_sec": 15519.038,
    "zh": "我不就干什么吗",
    "vi": "Thì tôi làm nấy thôi."
  },
  {
    "idx": 9263,
    "start": "04:18:39,038",
    "end": "04:18:40,258",
    "start_sec": 15519.038,
    "end_sec": 15520.258,
    "zh": "喂喂喂",
    "vi": "Này này này."
  },
  {
    "idx": 9264,
    "start": "04:18:40,258",
    "end": "04:18:40,658",
    "start_sec": 15520.258,
    "end_sec": 15520.658,
    "zh": "走吧",
    "vi": "Đi thôi."
  },
  {
    "idx": 9265,
    "start": "04:18:40,658",
    "end": "04:18:42,098",
    "start_sec": 15520.658,
    "end_sec": 15522.098,
    "zh": "我爸脾气很臭的",
    "vi": "Tính khí bố tôi tệ lắm."
  },
  {
    "idx": 9266,
    "start": "04:18:42,098",
    "end": "04:18:42,918",
    "start_sec": 15522.098,
    "end_sec": 15522.918,
    "zh": "别去打扰他",
    "vi": "Đừng đến làm phiền ông ấy."
  },
  {
    "idx": 9267,
    "start": "04:18:42,918",
    "end": "04:18:43,398",
    "start_sec": 15522.918,
    "end_sec": 15523.398,
    "zh": "否则",
    "vi": "Nếu không."
  },
  {
    "idx": 9268,
    "start": "04:18:43,398",
    "end": "04:18:44,718",
    "start_sec": 15523.398,
    "end_sec": 15524.718,
    "zh": "他下次不见零二三",
    "vi": "Lần sau ông ấy không gặp Không Hai Ba nữa."
  },
  {
    "idx": 9269,
    "start": "04:18:44,718",
    "end": "04:18:45,658",
    "start_sec": 15524.718,
    "end_sec": 15525.658,
    "zh": "你也不好办呢",
    "vi": "Thì bạn cũng khó xử đấy."
  },
  {
    "idx": 9270,
    "start": "04:18:45,658",
    "end": "04:18:47,798",
    "start_sec": 15525.658,
    "end_sec": 15527.798,
    "zh": "周扬想是生发橙子皮进去",
    "vi": "Chu Dương như muốn kéo Trình Tử Bì vào trong."
  },
  {
    "idx": 9271,
    "start": "04:18:47,798",
    "end": "04:18:49,058",
    "start_sec": 15527.798,
    "end_sec": 15529.058,
    "zh": "几乎是半拉半扯",
    "vi": "Gần như là vừa kéo vừa lôi."
  },
  {
    "idx": 9272,
    "start": "04:18:49,058",
    "end": "04:18:50,198",
    "start_sec": 15529.058,
    "end_sec": 15530.198,
    "zh": "带着橙子提鱼",
    "vi": "Đưa Trình Tử Bì đi cùng."
  },
  {
    "idx": 9273,
    "start": "04:18:50,198",
    "end": "04:18:50,938",
    "start_sec": 15530.198,
    "end_sec": 15530.938,
    "zh": "对了",
    "vi": "Đúng rồi."
  },
  {
    "idx": 9274,
    "start": "04:18:50,938",
    "end": "04:18:52,258",
    "start_sec": 15530.938,
    "end_sec": 15532.258,
    "zh": "023喊你过去",
    "vi": "Không Hai Ba gọi bạn qua đó."
  },
  {
    "idx": 9275,
    "start": "04:18:52,258",
    "end": "04:18:53,578",
    "start_sec": 15532.258,
    "end_sec": 15533.578,
    "zh": "是要你成为玉鬼者吗",
    "vi": "Là muốn bạn trở thành Ngự Quỷ Nhân sao."
  },
  {
    "idx": 9276,
    "start": "04:18:53,578",
    "end": "04:18:54,258",
    "start_sec": 15533.578,
    "end_sec": 15534.258,
    "zh": "是的",
    "vi": "Đúng vậy."
  },
  {
    "idx": 9277,
    "start": "04:18:54,258",
    "end": "04:18:55,818",
    "start_sec": 15534.258,
    "end_sec": 15535.818,
    "zh": "橙子提一样理想",
    "vi": "Trình Tử Bì nghĩ thầm."
  },
  {
    "idx": 9278,
    "start": "04:18:55,818",
    "end": "04:18:57,438",
    "start_sec": 15535.818,
    "end_sec": 15537.438,
    "zh": "虽说现在我和周扬之间",
    "vi": "Mặc dù bây giờ giữa tôi và Chu Dương."
  },
  {
    "idx": 9279,
    "start": "04:18:57,438",
    "end": "04:18:58,478",
    "start_sec": 15537.438,
    "end_sec": 15538.478,
    "zh": "已经存在间隙",
    "vi": "Đã có khoảng cách."
  },
  {
    "idx": 9280,
    "start": "04:18:58,478",
    "end": "04:19:00,178",
    "start_sec": 15538.478,
    "end_sec": 15540.178,
    "zh": "但现在还不是能摊牌的时候",
    "vi": "Nhưng bây giờ vẫn chưa phải lúc lật bài ngửa."
  },
  {
    "idx": 9281,
    "start": "04:19:00,178",
    "end": "04:19:01,458",
    "start_sec": 15540.178,
    "end_sec": 15541.458,
    "zh": "我需要更多的细节",
    "vi": "Tôi cần biết thêm nhiều chi tiết hơn."
  },
  {
    "idx": 9282,
    "start": "04:19:01,458",
    "end": "04:19:02,998",
    "start_sec": 15541.458,
    "end_sec": 15542.998,
    "zh": "不然贸然冲进船长室",
    "vi": "Nếu không, tự ý xông vào phòng thuyền trưởng."
  },
  {
    "idx": 9283,
    "start": "04:19:02,998",
    "end": "04:19:04,438",
    "start_sec": 15542.998,
    "end_sec": 15544.438,
    "zh": "苏克山藏进古镜里",
    "vi": "Tô Khắc Sơn trốn vào trong gương cổ."
  },
  {
    "idx": 9284,
    "start": "04:19:04,438",
    "end": "04:19:05,798",
    "start_sec": 15544.438,
    "end_sec": 15545.798,
    "zh": "我也没有任何办法",
    "vi": "Thì tôi cũng chẳng có cách nào cả."
  },
  {
    "idx": 9285,
    "start": "04:19:05,798",
    "end": "04:19:06,258",
    "start_sec": 15545.798,
    "end_sec": 15546.258,
    "zh": "眼下",
    "vi": "Trước mắt."
  },
  {
    "idx": 9286,
    "start": "04:19:06,258",
    "end": "04:19:07,258",
    "start_sec": 15546.258,
    "end_sec": 15547.258,
    "zh": "送中自重的",
    "vi": "Điều quan trọng nhất."
  },
  {
    "idx": 9287,
    "start": "04:19:07,258",
    "end": "04:19:08,798",
    "start_sec": 15547.258,
    "end_sec": 15548.798,
    "zh": "还是要找到物证鬼的本体",
    "vi": "Vẫn là phải tìm được bản thể của Vật Chứng Quỷ."
  },
  {
    "idx": 9288,
    "start": "04:19:08,798",
    "end": "04:19:11,818",
    "start_sec": 15548.798,
    "end_sec": 15551.818,
    "zh": "两人一路回到房间内",
    "vi": "Hai người cùng nhau đi về phòng."
  },
  {
    "idx": 9289,
    "start": "04:19:11,818",
    "end": "04:19:14,038",
    "start_sec": 15551.818,
    "end_sec": 15554.038,
    "zh": "周扬就迫不及待的打开了手机",
    "vi": "Chu Dương đã không nhịn được mà mở điện thoại ra ngay."
  },
  {
    "idx": 9290,
    "start": "04:19:14,038",
    "end": "04:19:15,558",
    "start_sec": 15554.038,
    "end_sec": 15555.558,
    "zh": "橙子提撇了一眼",
    "vi": "Trình Tử Bì liếc nhìn một cái."
  },
  {
    "idx": 9291,
    "start": "04:19:15,558",
    "end": "04:19:17,998",
    "start_sec": 15555.558,
    "end_sec": 15557.998,
    "zh": "周扬正快速翻动着玉鬼者网页",
    "vi": "Chu Dương đang nhanh chóng lướt trang web Ngự Quỷ Nhân."
  },
  {
    "idx": 9292,
    "start": "04:19:17,998",
    "end": "04:19:19,278",
    "start_sec": 15557.998,
    "end_sec": 15559.278,
    "zh": "喂 程子皮",
    "vi": "Này Trình Tử Bì."
  },
  {
    "idx": 9293,
    "start": "04:19:19,278",
    "end": "04:19:21,138",
    "start_sec": 15559.278,
    "end_sec": 15561.138,
    "zh": "我为什么没看到你的信息啊",
    "vi": "Sao tôi không thấy thông tin của bạn thế."
  },
  {
    "idx": 9294,
    "start": "04:19:21,138",
    "end": "04:19:21,598",
    "start_sec": 15561.138,
    "end_sec": 15561.598,
    "zh": "话说",
    "vi": "Mà này."
  },
  {
    "idx": 9295,
    "start": "04:19:21,598",
    "end": "04:19:24,098",
    "start_sec": 15561.598,
    "end_sec": 15564.098,
    "zh": "023不是喊你成为预轨者同源了吗",
    "vi": "Không Hai Ba không phải gọi bạn đến để trở thành thành viên Ngự Quỷ Nhân sao."
  },
  {
    "idx": 9296,
    "start": "04:19:24,098",
    "end": "04:19:26,458",
    "start_sec": 15564.098,
    "end_sec": 15566.458,
    "zh": "嗯 我暂时不想加入他们",
    "vi": "Ừm tôi tạm thời chưa muốn gia nhập họ."
  },
  {
    "idx": 9297,
    "start": "04:19:26,458",
    "end": "04:19:27,458",
    "start_sec": 15566.458,
    "end_sec": 15567.458,
    "zh": "为什么",
    "vi": "Tại sao."
  },
  {
    "idx": 9298,
    "start": "04:19:27,458",
    "end": "04:19:28,718",
    "start_sec": 15567.458,
    "end_sec": 15568.718,
    "zh": "加入他们",
    "vi": "Gia nhập họ."
  },
  {
    "idx": 9299,
    "start": "04:19:28,718",
    "end": "04:19:29,798",
    "start_sec": 15568.718,
    "end_sec": 15569.798,
    "zh": "固然安全了",
    "vi": "Tuy rằng an toàn thật."
  },
  {
    "idx": 9300,
    "start": "04:19:29,798",
    "end": "04:19:31,378",
    "start_sec": 15569.798,
    "end_sec": 15571.378,
    "zh": "但同时也被束缚了",
    "vi": "Nhưng đồng thời cũng bị ràng buộc rồi."
  },
  {
    "idx": 9301,
    "start": "04:19:31,378",
    "end": "04:19:32,258",
    "start_sec": 15571.378,
    "end_sec": 15572.258,
    "zh": "不是吗",
    "vi": "Không phải sao."
  },
  {
    "idx": 9302,
    "start": "04:19:32,258",
    "end": "04:19:33,618",
    "start_sec": 15572.258,
    "end_sec": 15573.618,
    "zh": "哦 你真的这么想",
    "vi": "Ồ bạn thực sự nghĩ vậy sao."
  },
  {
    "idx": 9303,
    "start": "04:19:33,618",
    "end": "04:19:35,438",
    "start_sec": 15573.618,
    "end_sec": 15575.438,
    "zh": "那你的能力是什么",
    "vi": "Vậy năng lực của bạn là gì."
  },
  {
    "idx": 9304,
    "start": "04:19:35,438",
    "end": "04:19:36,258",
    "start_sec": 15575.438,
    "end_sec": 15576.258,
    "zh": "这个呀",
    "vi": "Cái này hả."
  },
  {
    "idx": 9305,
    "start": "04:19:36,258",
    "end": "04:19:37,498",
    "start_sec": 15576.258,
    "end_sec": 15577.498,
    "zh": "就是很普通的能力",
    "vi": "Chỉ là một năng lực rất bình thường thôi."
  },
  {
    "idx": 9306,
    "start": "04:19:37,498",
    "end": "04:19:38,298",
    "start_sec": 15577.498,
    "end_sec": 15578.298,
    "zh": "不值一提",
    "vi": "Không đáng nhắc tới."
  },
  {
    "idx": 9307,
    "start": "04:19:38,298",
    "end": "04:19:39,078",
    "start_sec": 15578.298,
    "end_sec": 15579.078,
    "zh": "好吧",
    "vi": "Được rồi."
  },
  {
    "idx": 9308,
    "start": "04:19:39,078",
    "end": "04:19:40,638",
    "start_sec": 15579.078,
    "end_sec": 15580.638,
    "zh": "你不愿意说就算了",
    "vi": "Bạn không muốn nói thì thôi vậy."
  },
  {
    "idx": 9309,
    "start": "04:19:40,638",
    "end": "04:19:41,398",
    "start_sec": 15580.638,
    "end_sec": 15581.398,
    "zh": "对了",
    "vi": "Đúng rồi."
  },
  {
    "idx": 9310,
    "start": "04:19:41,398",
    "end": "04:19:42,338",
    "start_sec": 15581.398,
    "end_sec": 15582.338,
    "zh": "我先睡了",
    "vi": "Tôi đi ngủ trước đây."
  },
  {
    "idx": 9311,
    "start": "04:19:42,338",
    "end": "04:19:43,478",
    "start_sec": 15582.338,
    "end_sec": 15583.478,
    "zh": "有事喊我",
    "vi": "Có chuyện gì thì gọi tôi."
  },
  {
    "idx": 9312,
    "start": "04:19:43,478",
    "end": "04:19:43,918",
    "start_sec": 15583.478,
    "end_sec": 15583.918,
    "zh": "行",
    "vi": "Được."
  },
  {
    "idx": 9313,
    "start": "04:19:43,918",
    "end": "04:19:47,238",
    "start_sec": 15583.918,
    "end_sec": 15587.238,
    "zh": "上次就是注册的预轨者信息",
    "vi": "Lần trước chính là thông tin đăng ký của người dự quy."
  },
  {
    "idx": 9314,
    "start": "04:19:47,238",
    "end": "04:19:50,398",
    "start_sec": 15587.238,
    "end_sec": 15590.398,
    "zh": "周克山和周扬在网页上都能看到我的能力",
    "vi": "Chu Hách Sơn và Chu Dương đều có thể nhìn thấy năng lực của tôi trên trang web."
  },
  {
    "idx": 9315,
    "start": "04:19:50,398",
    "end": "04:19:52,638",
    "start_sec": 15590.398,
    "end_sec": 15592.638,
    "zh": "所以才会有那么一场针对我的计划吧",
    "vi": "Cho nên mới có một kế hoạch nhắm vào tôi như vậy."
  },
  {
    "idx": 9316,
    "start": "04:19:52,638",
    "end": "04:19:54,518",
    "start_sec": 15592.638,
    "end_sec": 15594.518,
    "zh": "看来这次重开之后",
    "vi": "Xem ra sau lần bắt đầu lại này."
  },
  {
    "idx": 9317,
    "start": "04:19:54,518",
    "end": "04:19:57,358",
    "start_sec": 15594.518,
    "end_sec": 15597.358,
    "zh": "先不着急注册预规者才是对的选择",
    "vi": "Không vội đăng ký thông tin người dự quy mới là lựa chọn đúng đắn."
  },
  {
    "idx": 9318,
    "start": "04:19:57,358",
    "end": "04:19:59,918",
    "start_sec": 15597.358,
    "end_sec": 15599.918,
    "zh": "只有023和026知道我的能力",
    "vi": "Chỉ có 023 và 026 biết năng lực của tôi."
  },
  {
    "idx": 9319,
    "start": "04:20:00,060",
    "end": "04:20:02,900",
    "start_sec": 15600.06,
    "end_sec": 15602.9,
    "zh": "这样的话是不是就能改变事情的走向了呢",
    "vi": "Như vậy thì có thể thay đổi được hướng đi của sự việc hay không."
  },
  {
    "idx": 9320,
    "start": "04:20:02,900",
    "end": "04:20:05,460",
    "start_sec": 15602.9,
    "end_sec": 15605.46,
    "zh": "现在已知的是周赫山不遇的问题",
    "vi": "Hiện tại điều đã biết là vấn đề của Chu Hách Sơn."
  },
  {
    "idx": 9321,
    "start": "04:20:05,460",
    "end": "04:20:07,720",
    "start_sec": 15605.46,
    "end_sec": 15607.72,
    "zh": "周扬十六八九也脱不了关系",
    "vi": "Chu Dương tám chín phần mười cũng không thoát khỏi liên can."
  },
  {
    "idx": 9322,
    "start": "04:20:07,720",
    "end": "04:20:10,580",
    "start_sec": 15607.72,
    "end_sec": 15610.58,
    "zh": "毕竟鬼镜和物账鬼都是他老周家的",
    "vi": "Dù sao thì Kính Quỷ và Vụ Chướng Quỷ đều là của nhà họ Chu."
  },
  {
    "idx": 9323,
    "start": "04:20:10,580",
    "end": "04:20:13,460",
    "start_sec": 15610.58,
    "end_sec": 15613.46,
    "zh": "一直以来船上的诡异都是周赫山在搞鬼",
    "vi": "Từ trước đến nay sự kỳ dị trên tàu đều do Chu Hách Sơn bày trò."
  },
  {
    "idx": 9324,
    "start": "04:20:13,460",
    "end": "04:20:16,140",
    "start_sec": 15613.46,
    "end_sec": 15616.14,
    "zh": "而这个内鬼还一直处于被保护状态",
    "vi": "Mà kẻ nội gián này vẫn luôn ở trong trạng thái được bảo vệ."
  },
  {
    "idx": 9325,
    "start": "04:20:16,140",
    "end": "04:20:17,720",
    "start_sec": 15616.14,
    "end_sec": 15617.72,
    "zh": "要不是我有重开的能力",
    "vi": "Nếu không phải tôi có năng lực bắt đầu lại."
  },
  {
    "idx": 9326,
    "start": "04:20:17,720",
    "end": "04:20:20,140",
    "start_sec": 15617.72,
    "end_sec": 15620.14,
    "zh": "一切难以想到内鬼就是周赫山",
    "vi": "Thì hoàn toàn không thể ngờ được nội gián lại là Chu Hách Sơn."
  },
  {
    "idx": 9327,
    "start": "04:20:20,140",
    "end": "04:20:23,020",
    "start_sec": 15620.14,
    "end_sec": 15623.02,
    "zh": "床子皮冷静的分析着船上的每个细节",
    "vi": "Trang Tử Bì bình tĩnh phân tích từng chi tiết trên tàu."
  },
  {
    "idx": 9328,
    "start": "04:20:23,020",
    "end": "04:20:25,580",
    "start_sec": 15623.02,
    "end_sec": 15625.58,
    "zh": "但敌岸网民仍然和自己能获得同情",
    "vi": "Nhưng cư dân mạng bờ bên kia vẫn có thể đồng cảm với mình."
  },
  {
    "idx": 9329,
    "start": "04:20:25,580",
    "end": "04:20:27,280",
    "start_sec": 15625.58,
    "end_sec": 15627.28,
    "zh": "周赫山 物账鬼",
    "vi": "Chu Hách Sơn, Vụ Chướng Quỷ."
  },
  {
    "idx": 9330,
    "start": "04:20:27,280",
    "end": "04:20:30,420",
    "start_sec": 15627.28,
    "end_sec": 15630.42,
    "zh": "你的本体到底藏在哪呢",
    "vi": "Bản thể của ngươi rốt cuộc đang trốn ở đâu."
  },
  {
    "idx": 9331,
    "start": "04:20:30,420",
    "end": "04:20:31,100",
    "start_sec": 15630.42,
    "end_sec": 15631.1,
    "zh": "对了",
    "vi": "Đúng rồi."
  },
  {
    "idx": 9332,
    "start": "04:20:31,100",
    "end": "04:20:32,400",
    "start_sec": 15631.1,
    "end_sec": 15632.4,
    "zh": "按照现在的时间线",
    "vi": "Theo dòng thời gian hiện tại."
  },
  {
    "idx": 9333,
    "start": "04:20:32,400",
    "end": "04:20:33,220",
    "start_sec": 15632.4,
    "end_sec": 15633.22,
    "zh": "凌早吃饭",
    "vi": "Ăn lúc rạng sáng."
  },
  {
    "idx": 9334,
    "start": "04:20:33,220",
    "end": "04:20:35,820",
    "start_sec": 15633.22,
    "end_sec": 15635.82,
    "zh": "我会碰到夏桃红和她弟弟的对峙时间吧",
    "vi": "Tôi sẽ gặp lúc Hạ Đào Hồng và em trai cô ấy đối đầu nhau nhỉ."
  },
  {
    "idx": 9335,
    "start": "04:20:35,820",
    "end": "04:20:36,920",
    "start_sec": 15635.82,
    "end_sec": 15636.92,
    "zh": "夏桃红说过",
    "vi": "Hạ Đào Hồng từng nói."
  },
  {
    "idx": 9336,
    "start": "04:20:36,920",
    "end": "04:20:38,640",
    "start_sec": 15636.92,
    "end_sec": 15638.64,
    "zh": "她弟弟会快踏一步来到餐厅",
    "vi": "Em trai cô ấy sẽ đến nhà ăn trước một bước."
  },
  {
    "idx": 9337,
    "start": "04:20:38,640",
    "end": "04:20:39,380",
    "start_sec": 15638.64,
    "end_sec": 15639.38,
    "zh": "也就是说",
    "vi": "Nghĩa là."
  },
  {
    "idx": 9338,
    "start": "04:20:39,380",
    "end": "04:20:41,340",
    "start_sec": 15639.38,
    "end_sec": 15641.34,
    "zh": "她弟弟是会在凌早吃饭",
    "vi": "Em trai cô ấy sẽ ăn cơm vào lúc rạng sáng."
  },
  {
    "idx": 9339,
    "start": "04:20:41,340",
    "end": "04:20:43,100",
    "start_sec": 15641.34,
    "end_sec": 15643.1,
    "zh": "如果提前提前的话",
    "vi": "Nếu mình đi sớm hơn."
  },
  {
    "idx": 9340,
    "start": "04:20:43,100",
    "end": "04:20:44,940",
    "start_sec": 15643.1,
    "end_sec": 15644.94,
    "zh": "是不是有几率找到本体呢",
    "vi": "Liệu có cơ hội tìm thấy bản thể không nhỉ."
  },
  {
    "idx": 9341,
    "start": "04:20:44,940",
    "end": "04:20:47,940",
    "start_sec": 15644.94,
    "end_sec": 15647.94,
    "zh": "想着橙子提携的这方法的确可行",
    "vi": "Nghĩ lại thì phương pháp mà Thành Tử gợi ý quả thực khả thi."
  },
  {
    "idx": 9342,
    "start": "04:20:47,940",
    "end": "04:20:49,740",
    "start_sec": 15647.94,
    "end_sec": 15649.74,
    "zh": "因为知道今晚无事发生",
    "vi": "Vì biết đêm nay không có chuyện gì xảy ra."
  },
  {
    "idx": 9343,
    "start": "04:20:49,740",
    "end": "04:20:51,700",
    "start_sec": 15649.74,
    "end_sec": 15651.7,
    "zh": "所以她并没有什么紧张感",
    "vi": "Nên cô ấy không hề cảm thấy căng thẳng."
  },
  {
    "idx": 9344,
    "start": "04:20:51,700",
    "end": "04:20:54,400",
    "start_sec": 15651.7,
    "end_sec": 15654.4,
    "zh": "直到凌晨四点",
    "vi": "Cho đến bốn giờ sáng."
  },
  {
    "idx": 9345,
    "start": "04:20:54,400",
    "end": "04:20:56,560",
    "start_sec": 15654.4,
    "end_sec": 15656.56,
    "zh": "橙子提提前定个脑中镇定计",
    "vi": "Thành Tử đã đặt báo thức từ trước."
  },
  {
    "idx": 9346,
    "start": "04:20:56,560",
    "end": "04:21:15,260",
    "start_sec": 15656.56,
    "end_sec": 15675.26,
    "zh": "嘿嘿嘿",
    "vi": "Hì hì hì."
  },
  {
    "idx": 9347,
    "start": "04:21:15,260",
    "end": "04:21:16,440",
    "start_sec": 15675.26,
    "end_sec": 15676.44,
    "zh": "只要我来得早",
    "vi": "Chỉ cần mình đến sớm."
  },
  {
    "idx": 9348,
    "start": "04:21:16,440",
    "end": "04:21:19,020",
    "start_sec": 15676.44,
    "end_sec": 15679.02,
    "zh": "就没人能和我抢肉饭团吃了",
    "vi": "Thì sẽ không ai tranh cơm nắm thịt với mình nữa."
  },
  {
    "idx": 9349,
    "start": "04:21:19,020",
    "end": "04:21:20,960",
    "start_sec": 15679.02,
    "end_sec": 15680.96,
    "zh": "我要给姐姐抢两个",
    "vi": "Mình phải lấy hai cái cho chị gái mới được."
  },
  {
    "idx": 9350,
    "start": "04:21:20,960",
    "end": "04:21:27,240",
    "start_sec": 15680.96,
    "end_sec": 15687.24,
    "zh": "小猫啊",
    "vi": "Tiểu Miêu à."
  },
  {
    "idx": 9351,
    "start": "04:21:27,240",
    "end": "04:21:28,520",
    "start_sec": 15687.24,
    "end_sec": 15688.52,
    "zh": "起这么早吗",
    "vi": "Dậy sớm thế sao."
  },
  {
    "idx": 9352,
    "start": "04:21:28,520",
    "end": "04:21:29,340",
    "start_sec": 15688.52,
    "end_sec": 15689.34,
    "zh": "这是",
    "vi": "Đây là."
  },
  {
    "idx": 9353,
    "start": "04:21:29,340",
    "end": "04:21:30,780",
    "start_sec": 15689.34,
    "end_sec": 15690.78,
    "zh": "周和珊的声音",
    "vi": "Giọng của Chu Hòa San."
  },
  {
    "idx": 9354,
    "start": "04:21:30,780",
    "end": "04:21:31,180",
    "start_sec": 15690.78,
    "end_sec": 15691.18,
    "zh": "难道",
    "vi": "Không lẽ."
  },
  {
    "idx": 9355,
    "start": "04:21:31,180",
    "end": "04:21:32,740",
    "start_sec": 15691.18,
    "end_sec": 15692.74,
    "zh": "这家伙每天起早抓单",
    "vi": "Tên này ngày nào cũng dậy sớm để bắt người đi lẻ."
  },
  {
    "idx": 9356,
    "start": "04:21:32,740",
    "end": "04:21:34,240",
    "start_sec": 15692.74,
    "end_sec": 15694.24,
    "zh": "然后实行诡异替换吗",
    "vi": "Sau đó thực hiện việc tráo đổi quỷ dị sao."
  },
  {
    "idx": 9357,
    "start": "04:21:34,240",
    "end": "04:21:35,160",
    "start_sec": 15694.24,
    "end_sec": 15695.16,
    "zh": "老爷爷",
    "vi": "Ông cụ ơi."
  },
  {
    "idx": 9358,
    "start": "04:21:35,160",
    "end": "04:21:37,660",
    "start_sec": 15695.16,
    "end_sec": 15697.66,
    "zh": "你为什么要和我做一桌啊",
    "vi": "Sao ông lại ngồi cùng bàn với cháu thế."
  },
  {
    "idx": 9359,
    "start": "04:21:37,660",
    "end": "04:21:38,440",
    "start_sec": 15697.66,
    "end_sec": 15698.44,
    "zh": "因为",
    "vi": "Bởi vì."
  },
  {
    "idx": 9360,
    "start": "04:21:38,440",
    "end": "04:21:40,720",
    "start_sec": 15698.44,
    "end_sec": 15700.72,
    "zh": "我们永远欢迎落单的人",
    "vi": "Chúng ta luôn chào đón những người đi lẻ."
  },
  {
    "idx": 9361,
    "start": "04:21:40,720",
    "end": "04:21:42,180",
    "start_sec": 15700.72,
    "end_sec": 15702.18,
    "zh": "你",
    "vi": "Ngươi."
  },
  {
    "idx": 9362,
    "start": "04:21:42,180",
    "end": "04:21:42,960",
    "start_sec": 15702.18,
    "end_sec": 15702.96,
    "zh": "你是",
    "vi": "Ngươi là."
  },
  {
    "idx": 9363,
    "start": "04:21:42,960",
    "end": "04:21:46,520",
    "start_sec": 15702.96,
    "end_sec": 15706.52,
    "zh": "脸面疮",
    "vi": "Kẻ mang mặt nạ lở loét."
  },
  {
    "idx": 9364,
    "start": "04:21:46,520",
    "end": "04:21:48,960",
    "start_sec": 15706.52,
    "end_sec": 15708.96,
    "zh": "该死",
    "vi": "Đáng chết thật."
  },
  {
    "idx": 9365,
    "start": "04:21:48,960",
    "end": "04:21:49,820",
    "start_sec": 15708.96,
    "end_sec": 15709.82,
    "zh": "这个周和珊",
    "vi": "Con nhỏ Chu Hòa San này."
  },
  {
    "idx": 9366,
    "start": "04:21:49,820",
    "end": "04:21:50,940",
    "start_sec": 15709.82,
    "end_sec": 15710.94,
    "zh": "也是假的",
    "vi": "Cũng là giả mạo."
  },
  {
    "idx": 9367,
    "start": "04:21:50,940",
    "end": "04:21:52,660",
    "start_sec": 15710.94,
    "end_sec": 15712.66,
    "zh": "妈的,真够谨慎的呀",
    "vi": "Mẹ kiếp, cẩn thận thật đấy."
  },
  {
    "idx": 9368,
    "start": "04:21:52,660",
    "end": "04:21:55,1000",
    "start_sec": 15712.66,
    "end_sec": 15716.0,
    "zh": "哥哥,哥哥,你,你也是道长吗",
    "vi": "Anh ơi, anh ơi, anh cũng là đạo sĩ sao."
  },
  {
    "idx": 9369,
    "start": "04:21:55,1000",
    "end": "04:21:58,740",
    "start_sec": 15716.0,
    "end_sec": 15718.74,
    "zh": "哎,小不点,以后别再着急了",
    "vi": "Này nhóc con, sau này đừng có vội vàng nữa."
  },
  {
    "idx": 9370,
    "start": "04:21:58,740",
    "end": "04:22:02,040",
    "start_sec": 15718.74,
    "end_sec": 15722.04,
    "zh": "可是不着急,就吃不到肉饭团了呢",
    "vi": "Nhưng không vội thì cháu không ăn được cơm nắm thịt đâu."
  },
  {
    "idx": 9371,
    "start": "04:22:02,040",
    "end": "04:22:04,360",
    "start_sec": 15722.04,
    "end_sec": 15724.36,
    "zh": "好吧,那我陪你等等吧",
    "vi": "Được rồi, vậy anh ngồi đợi cùng cháu."
  },
  {
    "idx": 9372,
    "start": "04:22:04,360",
    "end": "04:22:08,140",
    "start_sec": 15724.36,
    "end_sec": 15728.14,
    "zh": "哥哥,哥哥,我叫夏竹青,你叫什么",
    "vi": "Anh ơi, anh ơi, cháu tên là Hạ Trúc Thanh, anh tên gì."
  },
  {
    "idx": 9373,
    "start": "04:22:08,140",
    "end": "04:22:09,460",
    "start_sec": 15728.14,
    "end_sec": 15729.46,
    "zh": "橙子皮",
    "vi": "Trần Tử Bì."
  },
  {
    "idx": 9374,
    "start": "04:22:09,460",
    "end": "04:22:12,320",
    "start_sec": 15729.46,
    "end_sec": 15732.32,
    "zh": "哦,皮哥哥,你是道士吗",
    "vi": "Ồ, anh Vỏ, anh là đạo sĩ ạ."
  },
  {
    "idx": 9375,
    "start": "04:22:12,320",
    "end": "04:22:15,920",
    "start_sec": 15732.32,
    "end_sec": 15735.92,
    "zh": "不是,还有,请叫我橙哥哥,不要叫皮哥哥",
    "vi": "Không phải, với lại hãy gọi anh là anh Cam, đừng gọi anh Vỏ."
  },
  {
    "idx": 9376,
    "start": "04:22:15,920",
    "end": "04:22:18,840",
    "start_sec": 15735.92,
    "end_sec": 15738.84,
    "zh": "好吧,可是你像我爸爸一样厉害",
    "vi": "Vâng ạ, nhưng anh cũng giỏi như bố cháu vậy."
  },
  {
    "idx": 9377,
    "start": "04:22:18,840",
    "end": "04:22:19,960",
    "start_sec": 15738.84,
    "end_sec": 15739.96,
    "zh": "一出现",
    "vi": "Mỗi khi anh xuất hiện."
  },
  {
    "idx": 9378,
    "start": "04:22:19,960",
    "end": "04:22:21,640",
    "start_sec": 15739.96,
    "end_sec": 15741.64,
    "zh": "那些鬼啊妖怪的",
    "vi": "Mấy con quỷ hay yêu quái đó."
  },
  {
    "idx": 9379,
    "start": "04:22:21,640",
    "end": "04:22:22,860",
    "start_sec": 15741.64,
    "end_sec": 15742.86,
    "zh": "就死光了呢",
    "vi": "Đều chết sạch cả."
  },
  {
    "idx": 9380,
    "start": "04:22:22,860",
    "end": "04:22:23,720",
    "start_sec": 15742.86,
    "end_sec": 15743.72,
    "zh": "是啊",
    "vi": "Đúng vậy."
  },
  {
    "idx": 9381,
    "start": "04:22:23,720",
    "end": "04:22:25,080",
    "start_sec": 15743.72,
    "end_sec": 15745.08,
    "zh": "我怎么忘了这一点",
    "vi": "Sao mình lại quên mất điều này nhỉ."
  },
  {
    "idx": 9382,
    "start": "04:22:25,080",
    "end": "04:22:26,480",
    "start_sec": 15745.08,
    "end_sec": 15746.48,
    "zh": "现在曙光号上",
    "vi": "Hiện tại trên tàu Thự Quang."
  },
  {
    "idx": 9383,
    "start": "04:22:26,480",
    "end": "04:22:28,640",
    "start_sec": 15746.48,
    "end_sec": 15748.64,
    "zh": "能与诡异抗衡的人手严重不足",
    "vi": "Nhân lực có thể chống lại quỷ dị đang thiếu hụt trầm trọng."
  },
  {
    "idx": 9384,
    "start": "04:22:28,640",
    "end": "04:22:29,940",
    "start_sec": 15748.64,
    "end_sec": 15749.94,
    "zh": "要是能多个道士",
    "vi": "Nếu có thêm một đạo sĩ."
  },
  {
    "idx": 9385,
    "start": "04:22:29,940",
    "end": "04:22:31,240",
    "start_sec": 15749.94,
    "end_sec": 15751.24,
    "zh": "小家伙",
    "vi": "Nhóc con này."
  },
  {
    "idx": 9386,
    "start": "04:22:31,240",
    "end": "04:22:32,960",
    "start_sec": 15751.24,
    "end_sec": 15752.96,
    "zh": "你家以前是住哪的",
    "vi": "Trước đây nhà cháu sống ở đâu."
  },
  {
    "idx": 9387,
    "start": "04:22:32,960",
    "end": "04:22:34,360",
    "start_sec": 15752.96,
    "end_sec": 15754.36,
    "zh": "普连花小区啊",
    "vi": "Khu chung cư Phổ Liên Hoa ạ."
  },
  {
    "idx": 9388,
    "start": "04:22:34,360",
    "end": "04:22:35,500",
    "start_sec": 15754.36,
    "end_sec": 15755.5,
    "zh": "一单元二楼",
    "vi": "Tòa một tầng hai."
  },
  {
    "idx": 9389,
    "start": "04:22:35,500",
    "end": "04:22:37,120",
    "start_sec": 15755.5,
    "end_sec": 15757.12,
    "zh": "那你爸爸手机号呢",
    "vi": "Vậy số điện thoại của bố cháu là gì."
  },
  {
    "idx": 9390,
    "start": "04:22:37,120",
    "end": "04:22:37,620",
    "start_sec": 15757.12,
    "end_sec": 15757.62,
    "zh": "哦",
    "vi": "Dạ."
  },
  {
    "idx": 9391,
    "start": "04:22:37,620",
    "end": "04:22:38,720",
    "start_sec": 15757.62,
    "end_sec": 15758.72,
    "zh": "我想想",
    "vi": "Để tôi nhớ xem."
  },
  {
    "idx": 9392,
    "start": "04:22:38,720",
    "end": "04:22:39,740",
    "start_sec": 15758.72,
    "end_sec": 15759.74,
    "zh": "好像是",
    "vi": "Hình như là."
  },
  {
    "idx": 9393,
    "start": "04:22:39,740",
    "end": "04:22:41,040",
    "start_sec": 15759.74,
    "end_sec": 15761.04,
    "zh": "是10086",
    "vi": "Là số 10086."
  },
  {
    "idx": 9394,
    "start": "04:22:41,040",
    "end": "04:22:42,960",
    "start_sec": 15761.04,
    "end_sec": 15762.96,
    "zh": "长子皮默默记下号码",
    "vi": "Trình Tử Bì lặng lẽ ghi nhớ số điện thoại."
  },
  {
    "idx": 9395,
    "start": "04:22:42,960",
    "end": "04:22:43,680",
    "start_sec": 15762.96,
    "end_sec": 15763.68,
    "zh": "让不住笑了",
    "vi": "Không nhịn được cười."
  },
  {
    "idx": 9396,
    "start": "04:22:43,680",
    "end": "04:22:45,120",
    "start_sec": 15763.68,
    "end_sec": 15765.12,
    "zh": "你什么都告诉我",
    "vi": "Bạn nói cho tôi biết hết mọi thứ."
  },
  {
    "idx": 9397,
    "start": "04:22:45,120",
    "end": "04:22:46,440",
    "start_sec": 15765.12,
    "end_sec": 15766.44,
    "zh": "不怕我去你家偷东西吗",
    "vi": "Không sợ tôi đến nhà bạn trộm đồ sao."
  },
  {
    "idx": 9398,
    "start": "04:22:46,440",
    "end": "04:22:47,120",
    "start_sec": 15766.44,
    "end_sec": 15767.12,
    "zh": "哥哥",
    "vi": "Anh trai à."
  },
  {
    "idx": 9399,
    "start": "04:22:47,120",
    "end": "04:22:48,940",
    "start_sec": 15767.12,
    "end_sec": 15768.94,
    "zh": "你当我三岁小孩啊",
    "vi": "Bạn coi tôi là đứa trẻ ba tuổi sao."
  },
  {
    "idx": 9400,
    "start": "04:22:48,940",
    "end": "04:22:51,060",
    "start_sec": 15768.94,
    "end_sec": 15771.06,
    "zh": "你现在要是还能去我家",
    "vi": "Nếu bây giờ bạn còn có thể đến nhà tôi."
  },
  {
    "idx": 9401,
    "start": "04:22:51,060",
    "end": "04:22:53,160",
    "start_sec": 15771.06,
    "end_sec": 15773.16,
    "zh": "屋里东西你随便拿",
    "vi": "Đồ đạc trong nhà bạn cứ lấy tự nhiên."
  },
  {
    "idx": 9402,
    "start": "04:22:53,160",
    "end": "04:22:54,060",
    "start_sec": 15773.16,
    "end_sec": 15774.06,
    "zh": "哈哈哈哈",
    "vi": "Ha ha ha ha."
  },
  {
    "idx": 9403,
    "start": "04:22:54,060",
    "end": "04:22:54,580",
    "start_sec": 15774.06,
    "end_sec": 15774.58,
    "zh": "小鬼",
    "vi": "Nhóc con."
  },
  {
    "idx": 9404,
    "start": "04:22:54,580",
    "end": "04:22:55,960",
    "start_sec": 15774.58,
    "end_sec": 15775.96,
    "zh": "你还挺劲的",
    "vi": "Bạn cũng khá đấy chứ."
  },
  {
    "idx": 9405,
    "start": "04:22:55,960",
    "end": "04:22:56,780",
    "start_sec": 15775.96,
    "end_sec": 15776.78,
    "zh": "有一句没一句",
    "vi": "Câu được câu chăng."
  },
  {
    "idx": 9406,
    "start": "04:22:56,780",
    "end": "04:22:57,860",
    "start_sec": 15776.78,
    "end_sec": 15777.86,
    "zh": "和小家伙聊着",
    "vi": "Trò chuyện cùng nhóc con."
  },
  {
    "idx": 9407,
    "start": "04:22:57,860",
    "end": "04:22:58,660",
    "start_sec": 15777.86,
    "end_sec": 15778.66,
    "zh": "天色渐亮",
    "vi": "Trời dần sáng."
  },
  {
    "idx": 9408,
    "start": "04:22:58,660",
    "end": "04:23:01,260",
    "start_sec": 15778.66,
    "end_sec": 15781.26,
    "zh": "人群零零散散的从电梯里走出来",
    "vi": "Đám đông lác đác bước ra từ thang máy."
  },
  {
    "idx": 9409,
    "start": "04:23:01,260",
    "end": "04:23:05,180",
    "start_sec": 15781.26,
    "end_sec": 15785.18,
    "zh": "接着就见到零二六带着徐坚志和周扬从电梯里走出来",
    "vi": "Tiếp đó thấy Linh Nhị Lục dẫn Từ Kiên Chí và Chu Dương bước ra từ thang máy."
  },
  {
    "idx": 9410,
    "start": "04:23:05,180",
    "end": "04:23:06,800",
    "start_sec": 15785.18,
    "end_sec": 15786.8,
    "zh": "好小子",
    "vi": "Cậu khá lắm."
  },
  {
    "idx": 9411,
    "start": "04:23:06,800",
    "end": "04:23:08,440",
    "start_sec": 15786.8,
    "end_sec": 15788.44,
    "zh": "你背着我出来先吃饭啊",
    "vi": "Cậu giấu tôi ra ngoài ăn cơm trước à."
  },
  {
    "idx": 9412,
    "start": "04:23:08,440",
    "end": "04:23:09,300",
    "start_sec": 15788.44,
    "end_sec": 15789.3,
    "zh": "你就这么保护我的",
    "vi": "Cậu bảo vệ tôi như thế đấy à."
  },
  {
    "idx": 9413,
    "start": "04:23:09,300",
    "end": "04:23:10,080",
    "start_sec": 15789.3,
    "end_sec": 15790.08,
    "zh": "这个",
    "vi": "Chuyện này."
  },
  {
    "idx": 9414,
    "start": "04:23:10,080",
    "end": "04:23:12,100",
    "start_sec": 15790.08,
    "end_sec": 15792.1,
    "zh": "其实我是想给你带东西回去的",
    "vi": "Thật ra tôi muốn mang đồ về cho bạn."
  },
  {
    "idx": 9415,
    "start": "04:23:12,100",
    "end": "04:23:13,600",
    "start_sec": 15792.1,
    "end_sec": 15793.6,
    "zh": "随意和周扬扯着",
    "vi": "Tùy ý tán gẫu với Chu Dương."
  },
  {
    "idx": 9416,
    "start": "04:23:13,600",
    "end": "04:23:16,200",
    "start_sec": 15793.6,
    "end_sec": 15796.2,
    "zh": "程子提注意到零二六也没有看自己",
    "vi": "Trình Tử Bì để ý thấy Linh Nhị Lục cũng không nhìn mình."
  },
  {
    "idx": 9417,
    "start": "04:23:16,200",
    "end": "04:23:18,920",
    "start_sec": 15796.2,
    "end_sec": 15798.92,
    "zh": "因为这次重开我没有注册遇鬼者信息",
    "vi": "Vì lần mở lại này tôi không đăng ký thông tin người gặp quỷ."
  },
  {
    "idx": 9418,
    "start": "04:23:18,920",
    "end": "04:23:20,520",
    "start_sec": 15798.92,
    "end_sec": 15800.52,
    "zh": "所以他才懒得理我吧",
    "vi": "Nên cậu ta mới lười quan tâm đến tôi."
  },
  {
    "idx": 9419,
    "start": "04:23:20,520",
    "end": "04:23:22,880",
    "start_sec": 15800.52,
    "end_sec": 15802.88,
    "zh": "果然一系列联手反应都出现了",
    "vi": "Quả nhiên một loạt phản ứng dây chuyền đều xuất hiện."
  },
  {
    "idx": 9420,
    "start": "04:23:22,880",
    "end": "04:23:23,440",
    "start_sec": 15802.88,
    "end_sec": 15803.44,
    "zh": "这样的话",
    "vi": "Nếu vậy thì."
  },
  {
    "idx": 9421,
    "start": "04:23:23,440",
    "end": "04:23:25,440",
    "start_sec": 15803.44,
    "end_sec": 15805.44,
    "zh": "后面鬼一挑拨我和026的事情",
    "vi": "Sau đó chuyện con quỷ ly gián tôi và 026"
  },
  {
    "idx": 9422,
    "start": "04:23:25,440",
    "end": "04:23:26,560",
    "start_sec": 15805.44,
    "end_sec": 15806.56,
    "zh": "也不会发生了吧",
    "vi": "cũng sẽ không xảy ra nữa."
  },
  {
    "idx": 9423,
    "start": "04:23:26,560",
    "end": "04:23:35,360",
    "start_sec": 15806.56,
    "end_sec": 15815.36,
    "zh": "我说你压能耐了还不开船",
    "vi": "Tôi nói này bạn giỏi rồi sao vẫn chưa chịu lái tàu."
  },
  {
    "idx": 9424,
    "start": "04:23:35,360",
    "end": "04:23:37,100",
    "start_sec": 15815.36,
    "end_sec": 15817.1,
    "zh": "我我想再等等",
    "vi": "Tôi tôi muốn đợi thêm chút nữa."
  },
  {
    "idx": 9425,
    "start": "04:23:37,100",
    "end": "04:23:38,480",
    "start_sec": 15817.1,
    "end_sec": 15818.48,
    "zh": "等你妈的",
    "vi": "Đợi cái gì chứ."
  },
  {
    "idx": 9426,
    "start": "04:23:38,480",
    "end": "04:23:40,980",
    "start_sec": 15818.48,
    "end_sec": 15820.98,
    "zh": "你那个什么堂弟死了就死了",
    "vi": "Người em họ gì đó của bạn chết thì cũng chết rồi."
  },
  {
    "idx": 9427,
    "start": "04:23:40,980",
    "end": "04:23:42,960",
    "start_sec": 15820.98,
    "end_sec": 15822.96,
    "zh": "他和任务比孰轻孰重",
    "vi": "Cậu ta và nhiệm vụ bên nào nặng bên nào nhẹ."
  },
  {
    "idx": 9428,
    "start": "04:23:42,960",
    "end": "04:23:44,180",
    "start_sec": 15822.96,
    "end_sec": 15824.18,
    "zh": "你分不清吗",
    "vi": "Bạn không phân biệt được sao."
  },
  {
    "idx": 9429,
    "start": "04:23:44,180",
    "end": "04:23:45,760",
    "start_sec": 15824.18,
    "end_sec": 15825.76,
    "zh": "算了",
    "vi": "Bỏ đi."
  },
  {
    "idx": 9430,
    "start": "04:23:45,760",
    "end": "04:23:47,660",
    "start_sec": 15825.76,
    "end_sec": 15827.66,
    "zh": "小海你去开船吧",
    "vi": "Tiểu Hải bạn đi lái tàu đi."
  },
  {
    "idx": 9431,
    "start": "04:23:47,660",
    "end": "04:23:49,340",
    "start_sec": 15827.66,
    "end_sec": 15829.34,
    "zh": "我爱你放心",
    "vi": "Tôi đi đây bạn yên tâm."
  },
  {
    "idx": 9432,
    "start": "04:23:49,340",
    "end": "04:23:50,860",
    "start_sec": 15829.34,
    "end_sec": 15830.86,
    "zh": "我不去甲板了",
    "vi": "Tôi không lên boong tàu nữa."
  },
  {
    "idx": 9433,
    "start": "04:23:50,860",
    "end": "04:23:52,760",
    "start_sec": 15830.86,
    "end_sec": 15832.76,
    "zh": "算了算了",
    "vi": "Bỏ đi bỏ đi."
  },
  {
    "idx": 9434,
    "start": "04:23:52,760",
    "end": "04:23:53,400",
    "start_sec": 15832.76,
    "end_sec": 15833.4,
    "zh": "小海",
    "vi": "Tiểu Hải."
  },
  {
    "idx": 9435,
    "start": "04:23:53,400",
    "end": "04:23:55,520",
    "start_sec": 15833.4,
    "end_sec": 15835.52,
    "zh": "徐天只颓废的走向电梯",
    "vi": "Từ Thiên chỉ biết ủ rũ đi về phía thang máy."
  },
  {
    "idx": 9436,
    "start": "04:23:55,520",
    "end": "04:23:57,540",
    "start_sec": 15835.52,
    "end_sec": 15837.54,
    "zh": "026抬头看了一眼",
    "vi": "026 ngẩng đầu lên nhìn một cái."
  },
  {
    "idx": 9437,
    "start": "04:23:57,540",
    "end": "04:23:59,120",
    "start_sec": 15837.54,
    "end_sec": 15839.12,
    "zh": "快步走向甲板去",
    "vi": "Rồi nhanh chân đi về phía boong tàu."
  },
  {
    "idx": 9438,
    "start": "04:23:59,120",
    "end": "04:24:01,200",
    "start_sec": 15839.12,
    "end_sec": 15841.2,
    "zh": "喂",
    "vi": "Này."
  },
  {
    "idx": 9439,
    "start": "04:24:01,200",
    "end": "04:24:02,800",
    "start_sec": 15841.2,
    "end_sec": 15842.8,
    "zh": "橙子皮吃完了没",
    "vi": "Ăn xong Trần Tử Bì chưa."
  },
  {
    "idx": 9440,
    "start": "04:24:02,800",
    "end": "04:24:03,640",
    "start_sec": 15842.8,
    "end_sec": 15843.64,
    "zh": "吃完了",
    "vi": "Ăn xong rồi."
  },
  {
    "idx": 9441,
    "start": "04:24:03,640",
    "end": "04:24:05,360",
    "start_sec": 15843.64,
    "end_sec": 15845.36,
    "zh": "我有点事想跟你说",
    "vi": "Tôi có chút chuyện muốn nói với bạn."
  },
  {
    "idx": 9442,
    "start": "04:24:05,360",
    "end": "04:24:05,760",
    "start_sec": 15845.36,
    "end_sec": 15845.76,
    "zh": "什么",
    "vi": "Chuyện gì thế."
  },
  {
    "idx": 9443,
    "start": "04:24:05,760",
    "end": "04:24:06,720",
    "start_sec": 15845.76,
    "end_sec": 15846.72,
    "zh": "算了",
    "vi": "Bỏ đi."
  },
  {
    "idx": 9444,
    "start": "04:24:06,720",
    "end": "04:24:07,660",
    "start_sec": 15846.72,
    "end_sec": 15847.66,
    "zh": "你先回去吧",
    "vi": "Bạn về trước đi."
  },
  {
    "idx": 9445,
    "start": "04:24:07,660",
    "end": "04:24:08,720",
    "start_sec": 15847.66,
    "end_sec": 15848.72,
    "zh": "我待会找你",
    "vi": "Lát nữa tôi sẽ tìm bạn."
  },
  {
    "idx": 9446,
    "start": "04:24:08,720",
    "end": "04:24:10,200",
    "start_sec": 15848.72,
    "end_sec": 15850.2,
    "zh": "026负责开船",
    "vi": "026 chịu trách nhiệm lái tàu."
  },
  {
    "idx": 9447,
    "start": "04:24:10,200",
    "end": "04:24:11,760",
    "start_sec": 15850.2,
    "end_sec": 15851.76,
    "zh": "肯定是诡异的目标之一",
    "vi": "Chắc chắn là một trong những mục tiêu của con quỷ."
  },
  {
    "idx": 9448,
    "start": "04:24:11,760",
    "end": "04:24:13,480",
    "start_sec": 15851.76,
    "end_sec": 15853.48,
    "zh": "眼下我要提醒026注意点",
    "vi": "Lúc này tôi cần nhắc nhở 026 chú ý một chút."
  },
  {
    "idx": 9449,
    "start": "04:24:13,480",
    "end": "04:24:15,540",
    "start_sec": 15853.48,
    "end_sec": 15855.54,
    "zh": "但总不能当着这样的面提醒他",
    "vi": "Nhưng không thể nhắc nhở anh ta ngay trước mặt người này được."
  },
  {
    "idx": 9450,
    "start": "04:24:15,540",
    "end": "04:24:18,520",
    "start_sec": 15855.54,
    "end_sec": 15858.52,
    "zh": "我讨你这保镖可真不称职啊",
    "vi": "Người vệ sĩ như bạn thật sự không làm tròn trách nhiệm chút nào."
  },
  {
    "idx": 9451,
    "start": "04:24:18,520",
    "end": "04:24:19,140",
    "start_sec": 15858.52,
    "end_sec": 15859.14,
    "zh": "算了",
    "vi": "Thôi bỏ đi."
  },
  {
    "idx": 9452,
    "start": "04:24:19,140",
    "end": "04:24:20,100",
    "start_sec": 15859.14,
    "end_sec": 15860.1,
    "zh": "你也没加入他们",
    "vi": "Bạn cũng không gia nhập với họ."
  },
  {
    "idx": 9453,
    "start": "04:24:20,100",
    "end": "04:24:21,600",
    "start_sec": 15860.1,
    "end_sec": 15861.6,
    "zh": "也不需要服从他们的命令",
    "vi": "Cũng không cần phải phục tùng mệnh lệnh của họ."
  },
  {
    "idx": 9454,
    "start": "04:24:21,600",
    "end": "04:24:23,420",
    "start_sec": 15861.6,
    "end_sec": 15863.42,
    "zh": "你想怎样就怎样吧",
    "vi": "Bạn muốn làm gì thì tùy bạn vậy."
  },
  {
    "idx": 9455,
    "start": "04:24:23,420",
    "end": "04:24:25,680",
    "start_sec": 15863.42,
    "end_sec": 15865.68,
    "zh": "目送周扬走进电梯",
    "vi": "Nhìn theo Chu Dương bước vào thang máy."
  },
  {
    "idx": 9456,
    "start": "04:24:25,680",
    "end": "04:24:27,260",
    "start_sec": 15865.68,
    "end_sec": 15867.26,
    "zh": "程子皮刚准备起身",
    "vi": "Trình Tử Bì vừa định đứng dậy."
  },
  {
    "idx": 9457,
    "start": "04:24:27,260",
    "end": "04:24:29,020",
    "start_sec": 15867.26,
    "end_sec": 15869.02,
    "zh": "去提醒甲板区的026",
    "vi": "Để đi nhắc nhở 026 ở khu vực boong tàu."
  },
  {
    "idx": 9458,
    "start": "04:24:29,020",
    "end": "04:24:31,300",
    "start_sec": 15869.02,
    "end_sec": 15871.3,
    "zh": "突然下行的电梯门又打开",
    "vi": "Đột nhiên cửa thang máy đang đi xuống lại mở ra."
  },
  {
    "idx": 9459,
    "start": "04:24:31,300",
    "end": "04:24:33,160",
    "start_sec": 15871.3,
    "end_sec": 15873.16,
    "zh": "徐天志又急匆匆走出来",
    "vi": "Từ Thiên Chí lại vội vã đi ra."
  },
  {
    "idx": 9460,
    "start": "04:24:33,160",
    "end": "04:24:34,120",
    "start_sec": 15873.16,
    "end_sec": 15874.12,
    "zh": "直奔甲板区",
    "vi": "Đi thẳng về phía khu vực boong tàu."
  },
  {
    "idx": 9461,
    "start": "04:24:34,120",
    "end": "04:24:35,740",
    "start_sec": 15874.12,
    "end_sec": 15875.74,
    "zh": "徐天志",
    "vi": "Từ Thiên Chí."
  },
  {
    "idx": 9462,
    "start": "04:24:35,740",
    "end": "04:24:37,460",
    "start_sec": 15875.74,
    "end_sec": 15877.46,
    "zh": "他怎么会有心思回来呢",
    "vi": "Sao ông ta lại có tâm trí quay lại đây chứ."
  },
  {
    "idx": 9463,
    "start": "04:24:37,460",
    "end": "04:24:38,060",
    "start_sec": 15877.46,
    "end_sec": 15878.06,
    "zh": "不对",
    "vi": "Không đúng."
  },
  {
    "idx": 9464,
    "start": "04:24:38,060",
    "end": "04:24:40,020",
    "start_sec": 15878.06,
    "end_sec": 15880.02,
    "zh": "如果现在诡异不针对我了",
    "vi": "Nếu bây giờ con quỷ không nhắm vào tôi nữa."
  },
  {
    "idx": 9465,
    "start": "04:24:40,020",
    "end": "04:24:43,000",
    "start_sec": 15880.02,
    "end_sec": 15883.0,
    "zh": "那么他应该会避开对026的挑拨离间",
    "vi": "Thì nó nên tránh việc chia rẽ 026."
  },
  {
    "idx": 9466,
    "start": "04:24:43,000",
    "end": "04:24:44,620",
    "start_sec": 15883.0,
    "end_sec": 15884.62,
    "zh": "直接对026下手",
    "vi": "Mà trực tiếp ra tay với 026 luôn."
  },
  {
    "idx": 9467,
    "start": "04:24:44,620",
    "end": "04:24:47,300",
    "start_sec": 15884.62,
    "end_sec": 15887.3,
    "zh": "这个徐天志很可能是假的",
    "vi": "Từ Thiên Chí này rất có thể là giả."
  },
  {
    "idx": 9468,
    "start": "04:24:47,300",
    "end": "04:24:53,980",
    "start_sec": 15887.3,
    "end_sec": 15893.98,
    "zh": "小海",
    "vi": "Tiểu Hải."
  },
  {
    "idx": 9469,
    "start": "04:24:53,980",
    "end": "04:24:54,720",
    "start_sec": 15893.98,
    "end_sec": 15894.72,
    "zh": "徐叔",
    "vi": "Chú Từ."
  },
  {
    "idx": 9470,
    "start": "04:24:54,720",
    "end": "04:25:09,897",
    "start_sec": 15894.72,
    "end_sec": 15909.897,
    "zh": "你怎么下来了徐叔你喂026你跟啥比他不是全天制什么虚出",
    "vi": "Sao chú lại xuống đây chú Từ. Này 026, anh làm cái gì thế, ông ta không phải Từ Thiên Chí, chú Từ gì chứ."
  },
  {
    "idx": 9471,
    "start": "04:25:09,897",
    "end": "04:25:10,297",
    "start_sec": 15909.897,
    "end_sec": 15910.297,
    "zh": "你",
    "vi": "Mày."
  },
  {
    "idx": 9472,
    "start": "04:25:10,297",
    "end": "04:25:11,597",
    "start_sec": 15910.297,
    "end_sec": 15911.597,
    "zh": "真是该死",
    "vi": "Thật là đáng chết."
  },
  {
    "idx": 9473,
    "start": "04:25:11,597",
    "end": "04:25:12,997",
    "start_sec": 15911.597,
    "end_sec": 15912.997,
    "zh": "臭小子",
    "vi": "Thằng ranh con."
  },
  {
    "idx": 9474,
    "start": "04:25:12,997",
    "end": "04:25:15,097",
    "start_sec": 15912.997,
    "end_sec": 15915.097,
    "zh": "你怎么就知道我是假的",
    "vi": "Sao mày biết tao là giả chứ."
  },
  {
    "idx": 9475,
    "start": "04:25:15,097",
    "end": "04:25:16,337",
    "start_sec": 15915.097,
    "end_sec": 15916.337,
    "zh": "人有心有情绪",
    "vi": "Con người có trái tim và cảm xúc."
  },
  {
    "idx": 9476,
    "start": "04:25:16,337",
    "end": "04:25:17,317",
    "start_sec": 15916.337,
    "end_sec": 15917.317,
    "zh": "可诡异没有",
    "vi": "Nhưng quỷ dữ thì không."
  },
  {
    "idx": 9477,
    "start": "04:25:17,317",
    "end": "04:25:18,297",
    "start_sec": 15917.317,
    "end_sec": 15918.297,
    "zh": "026",
    "vi": "026."
  },
  {
    "idx": 9478,
    "start": "04:25:18,297",
    "end": "04:25:19,157",
    "start_sec": 15918.297,
    "end_sec": 15919.157,
    "zh": "动手",
    "vi": "Ra tay đi."
  },
  {
    "idx": 9479,
    "start": "04:25:19,157",
    "end": "04:25:20,357",
    "start_sec": 15919.157,
    "end_sec": 15920.357,
    "zh": "三天天虚出",
    "vi": "Từ Thiên Chí."
  },
  {
    "idx": 9480,
    "start": "04:25:20,357",
    "end": "04:25:20,997",
    "start_sec": 15920.357,
    "end_sec": 15920.997,
    "zh": "你给我去",
    "vi": "Mày đi chết đi."
  },
  {
    "idx": 9481,
    "start": "04:25:20,997",
    "end": "04:25:25,337",
    "start_sec": 15920.997,
    "end_sec": 15925.337,
    "zh": "之所以让零二六回头",
    "vi": "Sở dĩ bắt 026 quay lại"
  },
  {
    "idx": 9482,
    "start": "04:25:25,337",
    "end": "04:25:28,477",
    "start_sec": 15925.337,
    "end_sec": 15928.477,
    "zh": "是因为橙子皮并不想暴露鬼面窗的存在",
    "vi": "là vì Trần Tử Bì không muốn để lộ sự tồn tại của Cửa Sổ Mặt Quỷ."
  },
  {
    "idx": 9483,
    "start": "04:25:28,477",
    "end": "04:25:28,997",
    "start_sec": 15928.477,
    "end_sec": 15928.997,
    "zh": "喂",
    "vi": "Này."
  },
  {
    "idx": 9484,
    "start": "04:25:28,997",
    "end": "04:25:29,377",
    "start_sec": 15928.997,
    "end_sec": 15929.377,
    "zh": "这",
    "vi": "Cái này."
  },
  {
    "idx": 9485,
    "start": "04:25:29,377",
    "end": "04:25:30,177",
    "start_sec": 15929.377,
    "end_sec": 15930.177,
    "zh": "谢谢你",
    "vi": "Cảm ơn bạn."
  },
  {
    "idx": 9486,
    "start": "04:25:30,177",
    "end": "04:25:31,857",
    "start_sec": 15930.177,
    "end_sec": 15931.857,
    "zh": "这可真是稀罕事",
    "vi": "Đúng là chuyện lạ nha."
  },
  {
    "idx": 9487,
    "start": "04:25:31,857",
    "end": "04:25:33,117",
    "start_sec": 15931.857,
    "end_sec": 15933.117,
    "zh": "你也会谢我呀",
    "vi": "Bạn cũng biết cảm ơn tôi cơ đấy."
  },
  {
    "idx": 9488,
    "start": "04:25:33,117",
    "end": "04:25:35,177",
    "start_sec": 15933.117,
    "end_sec": 15935.177,
    "zh": "喂",
    "vi": "Này."
  },
  {
    "idx": 9489,
    "start": "04:25:35,177",
    "end": "04:25:36,457",
    "start_sec": 15935.177,
    "end_sec": 15936.457,
    "zh": "你现在不能落单",
    "vi": "Bây giờ bạn không được đi lẻ đâu."
  },
  {
    "idx": 9490,
    "start": "04:25:36,457",
    "end": "04:25:39,377",
    "start_sec": 15936.457,
    "end_sec": 15939.377,
    "zh": "然而零二六没有理会橙子皮的劝阻",
    "vi": "Thế nhưng 026 không thèm nghe lời khuyên ngăn của Trần Tử Bì."
  },
  {
    "idx": 9491,
    "start": "04:25:39,377",
    "end": "04:25:40,677",
    "start_sec": 15939.377,
    "end_sec": 15940.677,
    "zh": "见零二六快步离开",
    "vi": "Thấy 026 rảo bước rời đi"
  },
  {
    "idx": 9492,
    "start": "04:25:40,677",
    "end": "04:25:42,377",
    "start_sec": 15940.677,
    "end_sec": 15942.377,
    "zh": "橙子皮只能跟上去",
    "vi": "Trần Tử Bì chỉ đành đuổi theo."
  },
  {
    "idx": 9493,
    "start": "04:25:42,377",
    "end": "04:25:44,737",
    "start_sec": 15942.377,
    "end_sec": 15944.737,
    "zh": "该死",
    "vi": "Đáng chết."
  },
  {
    "idx": 9494,
    "start": "04:25:44,737",
    "end": "04:25:45,257",
    "start_sec": 15944.737,
    "end_sec": 15945.257,
    "zh": "徐叔",
    "vi": "Chú Từ."
  },
  {
    "idx": 9495,
    "start": "04:25:45,257",
    "end": "04:25:46,097",
    "start_sec": 15945.257,
    "end_sec": 15946.097,
    "zh": "徐叔的",
    "vi": "Của chú Từ."
  },
  {
    "idx": 9496,
    "start": "04:25:46,097",
    "end": "04:25:46,837",
    "start_sec": 15946.097,
    "end_sec": 15946.837,
    "zh": "该死",
    "vi": "Đáng chết."
  },
  {
    "idx": 9497,
    "start": "04:25:46,837",
    "end": "04:25:47,717",
    "start_sec": 15946.837,
    "end_sec": 15947.717,
    "zh": "我这三口",
    "vi": "Tôi thật là."
  },
  {
    "idx": 9498,
    "start": "04:25:47,717",
    "end": "04:25:49,757",
    "start_sec": 15947.717,
    "end_sec": 15949.757,
    "zh": "零二六一拳拔在了墙壁上",
    "vi": "026 đấm mạnh một cú vào tường."
  },
  {
    "idx": 9499,
    "start": "04:25:49,757",
    "end": "04:25:50,637",
    "start_sec": 15949.757,
    "end_sec": 15950.637,
    "zh": "喂喂喂",
    "vi": "Này này này."
  },
  {
    "idx": 9500,
    "start": "04:25:50,637",
    "end": "04:25:56,417",
    "start_sec": 15950.637,
    "end_sec": 15956.417,
    "zh": "你可别瞎跑,现在最好立刻马上找023过来,现在的情况很不对劲。",
    "vi": "Bạn đừng có chạy lung tung, bây giờ tốt nhất là lập tức gọi 023 qua đây, tình hình hiện tại rất không ổn."
  },
  {
    "idx": 9501,
    "start": "04:25:57,337",
    "end": "04:26:01,400",
    "start_sec": 15957.337,
    "end_sec": 15961.4,
    "zh": "接下来的发展应该就是水雾从轨迹系整到整个曙光号,上一次是针对我和026,这次应该就是针对026自己了吧。",
    "vi": "Diễn biến tiếp theo chắc là sương mù sẽ lan từ khoang quỹ đạo ra toàn bộ tàu Bình Minh,"
  },
  {
    "idx": 9501,
    "start": "04:26:01,400",
    "end": "04:26:05,057",
    "start_sec": 15961.4,
    "end_sec": 15965.057,
    "zh": "接下来的发展应该就是水雾从轨迹系整到整个曙光号,上一次是针对我和026,这次应该就是针对026自己了吧。",
    "vi": "lần trước là nhắm vào tôi và 026, lần này chắc là nhắm vào một mình 026 rồi."
  },
  {
    "idx": 9502,
    "start": "04:26:05,377",
    "end": "04:26:07,537",
    "start_sec": 15965.377,
    "end_sec": 15967.537,
    "zh": "你怎么就知道情况要不对了呢?",
    "vi": "Sao bạn biết là tình hình sắp không ổn."
  },
  {
    "idx": 9503,
    "start": "04:26:08,257",
    "end": "04:26:09,517",
    "start_sec": 15968.257,
    "end_sec": 15969.517,
    "zh": "我猜的,你信吗?",
    "vi": "Tôi đoán đấy, bạn tin không."
  },
  {
    "idx": 9504,
    "start": "04:26:09,977",
    "end": "04:26:13,277",
    "start_sec": 15969.977,
    "end_sec": 15973.277,
    "zh": "果然,如橙子皮所料,水雾从手到蔓延了。",
    "vi": "Quả nhiên, đúng như Trần Tử Bì dự đoán, sương mù đã bắt đầu lan rộng."
  },
  {
    "idx": 9505,
    "start": "04:26:14,477",
    "end": "04:26:16,437",
    "start_sec": 15974.477,
    "end_sec": 15976.437,
    "zh": "故障鬼,到底藏哪了?",
    "vi": "Con quỷ sự cố rốt cuộc trốn ở đâu rồi."
  },
  {
    "idx": 9506,
    "start": "04:26:16,797",
    "end": "04:26:19,377",
    "start_sec": 15976.797,
    "end_sec": 15979.377,
    "zh": "想着橙子皮带着026进了房间。",
    "vi": "Nghĩ đoạn, Trần Tử Bì đưa 026 vào trong phòng."
  },
  {
    "idx": 9507,
    "start": "04:26:19,377",
    "end": "04:26:20,817",
    "start_sec": 15979.377,
    "end_sec": 15980.817,
    "zh": "现在当务之急",
    "vi": "Việc cấp bách hiện tại"
  },
  {
    "idx": 9508,
    "start": "04:26:20,817",
    "end": "04:26:22,897",
    "start_sec": 15980.817,
    "end_sec": 15982.897,
    "zh": "应该是先把零二六保护起来",
    "vi": "là phải bảo vệ 026 trước đã."
  },
  {
    "idx": 9509,
    "start": "04:26:22,897",
    "end": "04:26:24,137",
    "start_sec": 15982.897,
    "end_sec": 15984.137,
    "zh": "零二六负责开船",
    "vi": "026 chịu trách nhiệm lái tàu"
  },
  {
    "idx": 9510,
    "start": "04:26:24,137",
    "end": "04:26:25,257",
    "start_sec": 15984.137,
    "end_sec": 15985.257,
    "zh": "他绝对不能死",
    "vi": "cậu ấy tuyệt đối không thể chết."
  },
  {
    "idx": 9511,
    "start": "04:26:25,257",
    "end": "04:26:27,877",
    "start_sec": 15985.257,
    "end_sec": 15987.877,
    "zh": "现在的局面还是太被动了",
    "vi": "Tình hình hiện tại vẫn quá bị động."
  },
  {
    "idx": 9512,
    "start": "04:26:27,877",
    "end": "04:26:28,957",
    "start_sec": 15987.877,
    "end_sec": 15988.957,
    "zh": "静静等候在屋内",
    "vi": "Tôi lặng lẽ chờ đợi trong nhà."
  },
  {
    "idx": 9513,
    "start": "04:26:28,957",
    "end": "04:26:30,657",
    "start_sec": 15988.957,
    "end_sec": 15990.657,
    "zh": "门外响起了一阵脚步声",
    "vi": "Bên ngoài cửa vang lên tiếng bước chân."
  },
  {
    "idx": 9514,
    "start": "04:26:30,657",
    "end": "04:26:33,297",
    "start_sec": 15990.657,
    "end_sec": 15993.297,
    "zh": "小心",
    "vi": "Cẩn thận."
  },
  {
    "idx": 9515,
    "start": "04:26:33,297",
    "end": "04:26:34,397",
    "start_sec": 15993.297,
    "end_sec": 15994.397,
    "zh": "可能是假的",
    "vi": "Có thể là giả."
  },
  {
    "idx": 9516,
    "start": "04:26:34,397",
    "end": "04:26:36,477",
    "start_sec": 15994.397,
    "end_sec": 15996.477,
    "zh": "你这是一招被蛇咬",
    "vi": "Bạn bị một lần rắn cắn."
  },
  {
    "idx": 9517,
    "start": "04:26:36,477",
    "end": "04:26:37,937",
    "start_sec": 15996.477,
    "end_sec": 15997.937,
    "zh": "十年怕几十啊",
    "vi": "Mười năm sợ cả trăm lần."
  },
  {
    "idx": 9518,
    "start": "04:26:37,937",
    "end": "04:26:38,637",
    "start_sec": 15997.937,
    "end_sec": 15998.637,
    "zh": "无妨",
    "vi": "Không sao."
  },
  {
    "idx": 9519,
    "start": "04:26:38,637",
    "end": "04:26:40,037",
    "start_sec": 15998.637,
    "end_sec": 16000.037,
    "zh": "我自有辨别手段",
    "vi": "Tôi có cách để phân biệt."
  },
  {
    "idx": 9520,
    "start": "04:26:40,037",
    "end": "04:26:40,877",
    "start_sec": 16000.037,
    "end_sec": 16000.877,
    "zh": "打开门",
    "vi": "Mở cửa."
  },
  {
    "idx": 9521,
    "start": "04:26:40,877",
    "end": "04:26:42,737",
    "start_sec": 16000.877,
    "end_sec": 16002.737,
    "zh": "橙子皮朝外面看了一眼",
    "vi": "Trần Tử Bì liếc nhìn ra ngoài."
  },
  {
    "idx": 9522,
    "start": "04:26:42,737",
    "end": "04:26:43,957",
    "start_sec": 16002.737,
    "end_sec": 16003.957,
    "zh": "零二三正黑着脸",
    "vi": "Linh Nhị Tam đang cau mày."
  },
  {
    "idx": 9523,
    "start": "04:26:43,957",
    "end": "04:26:45,197",
    "start_sec": 16003.957,
    "end_sec": 16005.197,
    "zh": "嘴里叼着个烟潮",
    "vi": "Ngậm một điếu thuốc trong miệng."
  },
  {
    "idx": 9524,
    "start": "04:26:45,197",
    "end": "04:26:45,837",
    "start_sec": 16005.197,
    "end_sec": 16005.837,
    "zh": "这边走来",
    "vi": "Đi về phía này."
  },
  {
    "idx": 9525,
    "start": "04:26:45,837",
    "end": "04:26:46,357",
    "start_sec": 16005.837,
    "end_sec": 16006.357,
    "zh": "喂",
    "vi": "Này."
  },
  {
    "idx": 9526,
    "start": "04:26:46,357",
    "end": "04:26:47,377",
    "start_sec": 16006.357,
    "end_sec": 16007.377,
    "zh": "橙子皮",
    "vi": "Trần Tử Bì."
  },
  {
    "idx": 9527,
    "start": "04:26:47,377",
    "end": "04:26:48,257",
    "start_sec": 16007.377,
    "end_sec": 16008.257,
    "zh": "什么情况",
    "vi": "Chuyện gì vậy."
  },
  {
    "idx": 9528,
    "start": "04:26:48,257",
    "end": "04:26:51,577",
    "start_sec": 16008.257,
    "end_sec": 16011.577,
    "zh": "喂 橙子皮 什么情况",
    "vi": "Này Trần Tử Bì, chuyện gì vậy."
  },
  {
    "idx": 9529,
    "start": "04:26:51,577",
    "end": "04:26:55,577",
    "start_sec": 16011.577,
    "end_sec": 16015.577,
    "zh": "你自己看吧 026被袭击了",
    "vi": "Tự mình xem đi, 026 bị tấn công rồi."
  },
  {
    "idx": 9530,
    "start": "04:26:55,577",
    "end": "04:26:59,117",
    "start_sec": 16015.577,
    "end_sec": 16019.117,
    "zh": "026不是 你还能被伤到",
    "vi": "026 không, bạn vẫn bị thương sao."
  },
  {
    "idx": 9531,
    "start": "04:26:59,117",
    "end": "04:27:00,477",
    "start_sec": 16019.117,
    "end_sec": 16020.477,
    "zh": "是鬼域变成了许数",
    "vi": "Là Quỷ Vực biến thành Hứa Số."
  },
  {
    "idx": 9532,
    "start": "04:27:00,477",
    "end": "04:27:03,217",
    "start_sec": 16020.477,
    "end_sec": 16023.217,
    "zh": "这群狗东西 我不去找他们麻烦",
    "vi": "Lũ khốn này, tôi không đi tìm chúng gây sự."
  },
  {
    "idx": 9533,
    "start": "04:27:03,217",
    "end": "04:27:05,637",
    "start_sec": 16023.217,
    "end_sec": 16025.637,
    "zh": "他们居然敢主动来找我们麻烦",
    "vi": "Chúng lại dám chủ động tìm chúng tôi gây sự."
  },
  {
    "idx": 9534,
    "start": "04:27:05,637",
    "end": "04:27:08,117",
    "start_sec": 16025.637,
    "end_sec": 16028.117,
    "zh": "023 我觉得现在的当务之急",
    "vi": "023, tôi nghĩ việc cấp bách bây giờ."
  },
  {
    "idx": 9535,
    "start": "04:27:08,117",
    "end": "04:27:10,917",
    "start_sec": 16028.117,
    "end_sec": 16030.917,
    "zh": "是守住这里 等曙光号到达终点吧",
    "vi": "Là giữ vững nơi này, chờ Tàu Bình Minh đến đích."
  },
  {
    "idx": 9536,
    "start": "04:27:10,917",
    "end": "04:27:13,537",
    "start_sec": 16030.917,
    "end_sec": 16033.537,
    "zh": "由我和023加上026",
    "vi": "Tôi và 023 cộng với 026."
  },
  {
    "idx": 9537,
    "start": "04:27:13,537",
    "end": "04:27:14,837",
    "start_sec": 16033.537,
    "end_sec": 16034.837,
    "zh": "三个遇鬼者齐聚",
    "vi": "Ba người gặp quỷ cùng tề tựu."
  },
  {
    "idx": 9538,
    "start": "04:27:14,837",
    "end": "04:27:16,917",
    "start_sec": 16034.837,
    "end_sec": 16036.917,
    "zh": "哪怕周赫山是双鬼一掌控者",
    "vi": "Dù Chu Hách Sơn có là người điều khiển song quỷ."
  },
  {
    "idx": 9539,
    "start": "04:27:16,917",
    "end": "04:27:18,257",
    "start_sec": 16036.917,
    "end_sec": 16038.257,
    "zh": "也不可能突破这里",
    "vi": "Cũng không thể đột phá nơi này."
  },
  {
    "idx": 9540,
    "start": "04:27:18,257",
    "end": "04:27:21,537",
    "start_sec": 16038.257,
    "end_sec": 16041.537,
    "zh": "鬼一那边应该是盯上了026的能力",
    "vi": "Bên Quỷ Nhất có lẽ đang nhắm vào năng lực của 026."
  },
  {
    "idx": 9541,
    "start": "04:27:21,537",
    "end": "04:27:23,437",
    "start_sec": 16041.537,
    "end_sec": 16043.437,
    "zh": "想让我们停在水域中",
    "vi": "Muốn chúng ta dừng lại ở vùng nước này."
  },
  {
    "idx": 9542,
    "start": "04:27:23,437",
    "end": "04:27:24,677",
    "start_sec": 16043.437,
    "end_sec": 16044.677,
    "zh": "我知道你的意思",
    "vi": "Tôi hiểu ý bạn."
  },
  {
    "idx": 9543,
    "start": "04:27:24,677",
    "end": "04:27:27,477",
    "start_sec": 16044.677,
    "end_sec": 16047.477,
    "zh": "但是这次组织派出四名御鬼者",
    "vi": "Nhưng lần này tổ chức đã phái bốn người điều khiển quỷ."
  },
  {
    "idx": 9544,
    "start": "04:27:27,477",
    "end": "04:27:28,737",
    "start_sec": 16047.477,
    "end_sec": 16048.737,
    "zh": "总不能无功而返",
    "vi": "Không thể nào tay trắng trở về."
  },
  {
    "idx": 9545,
    "start": "04:27:28,737",
    "end": "04:27:29,577",
    "start_sec": 16048.737,
    "end_sec": 16049.577,
    "zh": "这样吧",
    "vi": "Thế này đi."
  },
  {
    "idx": 9546,
    "start": "04:27:29,577",
    "end": "04:27:30,677",
    "start_sec": 16049.577,
    "end_sec": 16050.677,
    "zh": "我守在这里",
    "vi": "Tôi sẽ canh giữ ở đây."
  },
  {
    "idx": 9547,
    "start": "04:27:30,677",
    "end": "04:27:32,297",
    "start_sec": 16050.677,
    "end_sec": 16052.297,
    "zh": "你去把周扬接过来",
    "vi": "Bạn hãy đi đón Chu Dương tới đây."
  },
  {
    "idx": 9548,
    "start": "04:27:32,297",
    "end": "04:27:33,837",
    "start_sec": 16052.297,
    "end_sec": 16053.837,
    "zh": "如果是周扬和周赫山",
    "vi": "Nếu là Chu Dương và Chu Hách Sơn."
  },
  {
    "idx": 9549,
    "start": "04:27:33,837",
    "end": "04:27:34,677",
    "start_sec": 16053.837,
    "end_sec": 16054.677,
    "zh": "有问题吗",
    "vi": "Có vấn đề gì không."
  },
  {
    "idx": 9550,
    "start": "04:27:34,677",
    "end": "04:27:35,977",
    "start_sec": 16054.677,
    "end_sec": 16055.977,
    "zh": "听着橙子皮的话",
    "vi": "Nghe lời của Trình Tử Bì."
  },
  {
    "idx": 9551,
    "start": "04:27:35,977",
    "end": "04:27:37,357",
    "start_sec": 16055.977,
    "end_sec": 16057.357,
    "zh": "023一阵沉默",
    "vi": "023 im lặng một hồi."
  },
  {
    "idx": 9552,
    "start": "04:27:37,357",
    "end": "04:27:38,477",
    "start_sec": 16057.357,
    "end_sec": 16058.477,
    "zh": "无论如何",
    "vi": "Dù thế nào đi nữa."
  },
  {
    "idx": 9553,
    "start": "04:27:38,477",
    "end": "04:27:40,577",
    "start_sec": 16058.477,
    "end_sec": 16060.577,
    "zh": "周家的血脉总要留存一个",
    "vi": "Huyết mạch nhà họ Chu cũng phải giữ lại một người."
  },
  {
    "idx": 9554,
    "start": "04:27:40,577",
    "end": "04:27:41,537",
    "start_sec": 16060.577,
    "end_sec": 16061.537,
    "zh": "橙子皮",
    "vi": "Trình Tử Bì."
  },
  {
    "idx": 9555,
    "start": "04:27:41,537",
    "end": "04:27:44,197",
    "start_sec": 16061.537,
    "end_sec": 16064.197,
    "zh": "虽然你现在还未加入御鬼者组织",
    "vi": "Tuy bạn vẫn chưa gia nhập tổ chức điều khiển quỷ."
  },
  {
    "idx": 9556,
    "start": "04:27:44,197",
    "end": "04:27:46,757",
    "start_sec": 16064.197,
    "end_sec": 16066.757,
    "zh": "我知道对你提这些有些过分",
    "vi": "Tôi biết yêu cầu bạn những điều này là hơi quá đáng."
  },
  {
    "idx": 9557,
    "start": "04:27:46,757",
    "end": "04:27:49,297",
    "start_sec": 16066.757,
    "end_sec": 16069.297,
    "zh": "但现在能看清局势的只有你了",
    "vi": "Nhưng hiện tại chỉ có bạn mới nhìn rõ cục diện."
  },
  {
    "idx": 9558,
    "start": "04:27:49,297",
    "end": "04:27:50,277",
    "start_sec": 16069.297,
    "end_sec": 16070.277,
    "zh": "拜托了",
    "vi": "Nhờ cả vào bạn."
  },
  {
    "idx": 9559,
    "start": "04:27:50,277",
    "end": "04:27:52,377",
    "start_sec": 16070.277,
    "end_sec": 16072.377,
    "zh": "023恳求着目光看来",
    "vi": "023 nhìn với ánh mắt khẩn cầu."
  },
  {
    "idx": 9560,
    "start": "04:27:52,377",
    "end": "04:27:53,617",
    "start_sec": 16072.377,
    "end_sec": 16073.617,
    "zh": "程子皮犹豫天恨",
    "vi": "Trình Tử Bì do dự một lúc."
  },
  {
    "idx": 9561,
    "start": "04:27:53,617",
    "end": "04:27:55,697",
    "start_sec": 16073.617,
    "end_sec": 16075.697,
    "zh": "点点头走出房间",
    "vi": "Gật đầu rồi bước ra khỏi phòng."
  },
  {
    "idx": 9562,
    "start": "04:27:55,697",
    "end": "04:27:57,317",
    "start_sec": 16075.697,
    "end_sec": 16077.317,
    "zh": "朱和山的本体",
    "vi": "Bản thể của Chu Hách Sơn."
  },
  {
    "idx": 9563,
    "start": "04:27:57,317",
    "end": "04:27:59,477",
    "start_sec": 16077.317,
    "end_sec": 16079.477,
    "zh": "他妈的本体到底藏哪了",
    "vi": "Rốt cuộc thì bản thể của hắn đang trốn ở đâu."
  },
  {
    "idx": 9564,
    "start": "04:27:59,477",
    "end": "04:28:00,697",
    "start_sec": 16079.477,
    "end_sec": 16080.697,
    "zh": "局势太过被动",
    "vi": "Cục diện quá bị động."
  },
  {
    "idx": 9565,
    "start": "04:28:00,697",
    "end": "04:28:02,217",
    "start_sec": 16080.697,
    "end_sec": 16082.217,
    "zh": "程子皮只觉得憋屈",
    "vi": "Trình Tử Bì chỉ cảm thấy uất ức."
  },
  {
    "idx": 9566,
    "start": "04:28:02,217",
    "end": "04:28:02,957",
    "start_sec": 16082.217,
    "end_sec": 16082.957,
    "zh": "对了",
    "vi": "Đúng rồi."
  },
  {
    "idx": 9567,
    "start": "04:28:02,957",
    "end": "04:28:05,437",
    "start_sec": 16082.957,
    "end_sec": 16085.437,
    "zh": "虽然我不能确定朱和山的本体在哪",
    "vi": "Tuy tôi không thể xác định bản thể Chu Hách Sơn ở đâu."
  },
  {
    "idx": 9568,
    "start": "04:28:05,437",
    "end": "04:28:06,917",
    "start_sec": 16085.437,
    "end_sec": 16086.917,
    "zh": "要是我把周扬抓起来",
    "vi": "Nếu tôi bắt giữ Chu Dương."
  },
  {
    "idx": 9569,
    "start": "04:28:06,917",
    "end": "04:28:08,037",
    "start_sec": 16086.917,
    "end_sec": 16088.037,
    "zh": "用他要挟朱和山",
    "vi": "Dùng cậu ta để uy hiếp Chu Hách Sơn."
  },
  {
    "idx": 9570,
    "start": "04:28:08,037",
    "end": "04:28:09,657",
    "start_sec": 16088.037,
    "end_sec": 16089.657,
    "zh": "能不能打破这个僵局呢",
    "vi": "Liệu có thể phá vỡ thế bế tắc này không."
  },
  {
    "idx": 9571,
    "start": "04:28:09,657",
    "end": "04:28:11,997",
    "start_sec": 16089.657,
    "end_sec": 16091.997,
    "zh": "如果他们父子俩父慈子孝的话",
    "vi": "Nếu hai cha con họ thực sự hòa thuận yêu thương nhau"
  },
  {
    "idx": 9572,
    "start": "04:28:11,997",
    "end": "04:28:13,457",
    "start_sec": 16091.997,
    "end_sec": 16093.457,
    "zh": "这个计划确实可行",
    "vi": "kế hoạch này quả thực khả thi."
  },
  {
    "idx": 9573,
    "start": "04:28:13,457",
    "end": "04:28:14,897",
    "start_sec": 16093.457,
    "end_sec": 16094.897,
    "zh": "要是恰恰相传的话",
    "vi": "Nhưng nếu ngược lại"
  },
  {
    "idx": 9574,
    "start": "04:28:14,897",
    "end": "04:28:17,317",
    "start_sec": 16094.897,
    "end_sec": 16097.317,
    "zh": "这样做也只会引起朱和山的警惕",
    "vi": "làm vậy chỉ khiến Chu Hòa Sơn thêm cảnh giác."
  },
  {
    "idx": 9575,
    "start": "04:28:17,317",
    "end": "04:28:18,477",
    "start_sec": 16097.317,
    "end_sec": 16098.477,
    "zh": "思绪游荡间",
    "vi": "Trong lúc đang suy nghĩ mông lung"
  },
  {
    "idx": 9576,
    "start": "04:28:18,477",
    "end": "04:28:20,797",
    "start_sec": 16098.477,
    "end_sec": 16100.797,
    "zh": "程子皮已经来到了周扬的门前",
    "vi": "Trình Tử Bì đã đi đến trước cửa phòng Chu Dương."
  },
  {
    "idx": 9577,
    "start": "04:28:20,797",
    "end": "04:28:24,477",
    "start_sec": 16100.797,
    "end_sec": 16104.477,
    "zh": "哟 程子皮 你回来了",
    "vi": "Ồ Trình Tử Bì anh về rồi đấy à."
  },
  {
    "idx": 9578,
    "start": "04:28:24,477",
    "end": "04:28:26,837",
    "start_sec": 16104.477,
    "end_sec": 16106.837,
    "zh": "周扬站起身靠近程子皮",
    "vi": "Chu Dương đứng dậy tiến lại gần Trình Tử Bì"
  },
  {
    "idx": 9579,
    "start": "04:28:26,837",
    "end": "04:28:28,577",
    "start_sec": 16106.837,
    "end_sec": 16108.577,
    "zh": "而他却后退了两步",
    "vi": "nhưng anh ta lại lùi lại hai bước."
  },
  {
    "idx": 9580,
    "start": "04:28:28,577",
    "end": "04:28:30,677",
    "start_sec": 16108.577,
    "end_sec": 16110.677,
    "zh": "妈的 鬼面窗给我的反馈是",
    "vi": "Chết tiệt Quỷ Diện Song phản hồi cho tôi biết"
  },
  {
    "idx": 9581,
    "start": "04:28:30,677",
    "end": "04:28:31,877",
    "start_sec": 16110.677,
    "end_sec": 16111.877,
    "zh": "这俩人都是假的",
    "vi": "cả hai người này đều là giả."
  },
  {
    "idx": 9582,
    "start": "04:28:31,877",
    "end": "04:28:32,537",
    "start_sec": 16111.877,
    "end_sec": 16112.537,
    "zh": "搞什么",
    "vi": "Cái quái gì thế này."
  },
  {
    "idx": 9583,
    "start": "04:28:32,537",
    "end": "04:28:33,877",
    "start_sec": 16112.537,
    "end_sec": 16113.877,
    "zh": "这一对父子作假",
    "vi": "Cặp cha con giả mạo này"
  },
  {
    "idx": 9584,
    "start": "04:28:33,877",
    "end": "04:28:34,757",
    "start_sec": 16113.877,
    "end_sec": 16114.757,
    "zh": "找我干嘛",
    "vi": "tìm tôi để làm gì chứ."
  },
  {
    "idx": 9585,
    "start": "04:28:34,757",
    "end": "04:28:37,257",
    "start_sec": 16114.757,
    "end_sec": 16117.257,
    "zh": "难道周扬预判了我的预判",
    "vi": "Chẳng lẽ Chu Dương đã đi trước tôi một bước"
  },
  {
    "idx": 9586,
    "start": "04:28:37,257",
    "end": "04:28:38,977",
    "start_sec": 16117.257,
    "end_sec": 16118.977,
    "zh": "知道我会用他来威胁朱和山",
    "vi": "biết tôi sẽ dùng hắn để uy hiếp Chu Hòa Sơn."
  },
  {
    "idx": 9587,
    "start": "04:28:38,977",
    "end": "04:28:40,477",
    "start_sec": 16118.977,
    "end_sec": 16120.477,
    "zh": "也不可能啊",
    "vi": "Nhưng cũng không thể nào."
  },
  {
    "idx": 9588,
    "start": "04:28:40,477",
    "end": "04:28:41,577",
    "start_sec": 16120.477,
    "end_sec": 16121.577,
    "zh": "周扬应该多不清楚",
    "vi": "Chu Dương chắc chắn không biết rõ"
  },
  {
    "idx": 9589,
    "start": "04:28:41,577",
    "end": "04:28:43,017",
    "start_sec": 16121.577,
    "end_sec": 16123.017,
    "zh": "我对他是否有敌意",
    "vi": "liệu tôi có ác ý với hắn hay không."
  },
  {
    "idx": 9590,
    "start": "04:28:43,017",
    "end": "04:28:44,857",
    "start_sec": 16123.017,
    "end_sec": 16124.857,
    "zh": "周大公子 你有事找我",
    "vi": "Chu đại công tử anh tìm tôi có việc gì sao."
  },
  {
    "idx": 9591,
    "start": "04:28:44,857",
    "end": "04:28:45,457",
    "start_sec": 16124.857,
    "end_sec": 16125.457,
    "zh": "是吗",
    "vi": "Đúng vậy không."
  },
  {
    "idx": 9592,
    "start": "04:28:45,457",
    "end": "04:28:46,537",
    "start_sec": 16125.457,
    "end_sec": 16126.537,
    "zh": "橙子皮",
    "vi": "Trình Tử Bì"
  },
  {
    "idx": 9593,
    "start": "04:28:46,537",
    "end": "04:28:48,037",
    "start_sec": 16126.537,
    "end_sec": 16128.037,
    "zh": "是不是知道些什么",
    "vi": "có phải anh đã biết điều gì rồi không."
  },
  {
    "idx": 9594,
    "start": "04:28:48,037",
    "end": "04:28:49,477",
    "start_sec": 16128.037,
    "end_sec": 16129.477,
    "zh": "眼下我还不能暴露",
    "vi": "Lúc này mình vẫn chưa thể bại lộ"
  },
  {
    "idx": 9595,
    "start": "04:28:49,477",
    "end": "04:28:50,537",
    "start_sec": 16129.477,
    "end_sec": 16130.537,
    "zh": "还是将计就计",
    "vi": "chi bằng cứ tương kế tựu kế"
  },
  {
    "idx": 9596,
    "start": "04:28:50,537",
    "end": "04:28:52,057",
    "start_sec": 16130.537,
    "end_sec": 16132.057,
    "zh": "看看他们要耍什么花招",
    "vi": "để xem bọn họ muốn giở trò gì."
  },
  {
    "idx": 9597,
    "start": "04:28:52,057",
    "end": "04:28:53,437",
    "start_sec": 16132.057,
    "end_sec": 16133.437,
    "zh": "我能知道什么",
    "vi": "Tôi thì biết được gì chứ."
  },
  {
    "idx": 9598,
    "start": "04:28:53,437",
    "end": "04:28:55,537",
    "start_sec": 16133.437,
    "end_sec": 16135.537,
    "zh": "我上船后满单满算不过才一天",
    "vi": "Tôi lên tàu tính kỹ ra cũng mới được một ngày"
  },
  {
    "idx": 9599,
    "start": "04:28:55,537",
    "end": "04:28:56,557",
    "start_sec": 16135.537,
    "end_sec": 16136.557,
    "zh": "还能知道什么",
    "vi": "thì có thể biết được chuyện gì chứ."
  },
  {
    "idx": 9600,
    "start": "04:28:56,557",
    "end": "04:28:57,497",
    "start_sec": 16136.557,
    "end_sec": 16137.497,
    "zh": "那倒是",
    "vi": "Cũng đúng."
  },
  {
    "idx": 9601,
    "start": "04:28:57,497",
    "end": "04:28:58,097",
    "start_sec": 16137.497,
    "end_sec": 16138.097,
    "zh": "对了",
    "vi": "Đúng rồi."
  },
  {
    "idx": 9602,
    "start": "04:28:58,097",
    "end": "04:28:58,957",
    "start_sec": 16138.097,
    "end_sec": 16138.957,
    "zh": "和你介绍一下",
    "vi": "Giới thiệu với bạn một chút."
  },
  {
    "idx": 9603,
    "start": "04:28:58,957",
    "end": "04:29:00,277",
    "start_sec": 16138.957,
    "end_sec": 16140.277,
    "zh": "这是我父亲周和尚",
    "vi": "Đây là bố tôi, Chu Hòa Thượng."
  },
  {
    "idx": 9604,
    "start": "04:29:00,277",
    "end": "04:29:01,057",
    "start_sec": 16140.277,
    "end_sec": 16141.057,
    "zh": "我说",
    "vi": "Tôi nói này."
  },
  {
    "idx": 9605,
    "start": "04:29:01,057",
    "end": "04:29:02,117",
    "start_sec": 16141.057,
    "end_sec": 16142.117,
    "zh": "外面起雾了",
    "vi": "Bên ngoài sương mù lên rồi."
  },
  {
    "idx": 9606,
    "start": "04:29:02,117",
    "end": "04:29:03,337",
    "start_sec": 16142.117,
    "end_sec": 16143.337,
    "zh": "你居然带着你老爹",
    "vi": "Bạn lại dẫn theo bố mình."
  },
  {
    "idx": 9607,
    "start": "04:29:03,337",
    "end": "04:29:04,377",
    "start_sec": 16143.337,
    "end_sec": 16144.377,
    "zh": "特意和我认识",
    "vi": "Đến để làm quen với tôi."
  },
  {
    "idx": 9608,
    "start": "04:29:04,377",
    "end": "04:29:05,257",
    "start_sec": 16144.377,
    "end_sec": 16145.257,
    "zh": "这不对吧",
    "vi": "Thế này không đúng lắm nhỉ."
  },
  {
    "idx": 9609,
    "start": "04:29:05,257",
    "end": "04:29:05,797",
    "start_sec": 16145.257,
    "end_sec": 16145.797,
    "zh": "哈哈",
    "vi": "Haha."
  },
  {
    "idx": 9610,
    "start": "04:29:05,797",
    "end": "04:29:06,677",
    "start_sec": 16145.797,
    "end_sec": 16146.677,
    "zh": "我就说",
    "vi": "Tôi đã bảo mà."
  },
  {
    "idx": 9611,
    "start": "04:29:06,677",
    "end": "04:29:07,877",
    "start_sec": 16146.677,
    "end_sec": 16147.877,
    "zh": "你很敏锐嘛",
    "vi": "Bạn rất nhạy bén đấy."
  },
  {
    "idx": 9612,
    "start": "04:29:07,877",
    "end": "04:29:09,097",
    "start_sec": 16147.877,
    "end_sec": 16149.097,
    "zh": "橙子皮",
    "vi": "Trần Tử Bì."
  },
  {
    "idx": 9613,
    "start": "04:29:09,097",
    "end": "04:29:10,297",
    "start_sec": 16149.097,
    "end_sec": 16150.297,
    "zh": "不知道为什么",
    "vi": "Không biết tại sao."
  },
  {
    "idx": 9614,
    "start": "04:29:10,297",
    "end": "04:29:11,057",
    "start_sec": 16150.297,
    "end_sec": 16151.057,
    "zh": "你这个人",
    "vi": "Con người bạn."
  },
  {
    "idx": 9615,
    "start": "04:29:11,057",
    "end": "04:29:13,197",
    "start_sec": 16151.057,
    "end_sec": 16153.197,
    "zh": "给我感觉是一种玄自幼玄的存在",
    "vi": "Lại cho tôi cảm giác rất huyền bí."
  },
  {
    "idx": 9616,
    "start": "04:29:13,197",
    "end": "04:29:14,737",
    "start_sec": 16153.197,
    "end_sec": 16154.737,
    "zh": "我看不清",
    "vi": "Tôi không nhìn thấu được."
  },
  {
    "idx": 9617,
    "start": "04:29:14,737",
    "end": "04:29:16,237",
    "start_sec": 16154.737,
    "end_sec": 16156.237,
    "zh": "你在诡异降临前",
    "vi": "Trước khi sự kiện kỳ dị giáng xuống."
  },
  {
    "idx": 9618,
    "start": "04:29:16,237",
    "end": "04:29:17,377",
    "start_sec": 16156.237,
    "end_sec": 16157.377,
    "zh": "拜托我找法器",
    "vi": "Bạn nhờ tôi tìm pháp khí."
  },
  {
    "idx": 9619,
    "start": "04:29:17,377",
    "end": "04:29:19,297",
    "start_sec": 16157.377,
    "end_sec": 16159.297,
    "zh": "然后你又特意买黑狗凤",
    "vi": "Rồi bạn lại đặc biệt mua chó đen."
  },
  {
    "idx": 9620,
    "start": "04:29:19,297",
    "end": "04:29:20,457",
    "start_sec": 16159.297,
    "end_sec": 16160.457,
    "zh": "这一切的一切",
    "vi": "Tất cả những điều này."
  },
  {
    "idx": 9621,
    "start": "04:29:20,457",
    "end": "04:29:21,957",
    "start_sec": 16160.457,
    "end_sec": 16161.957,
    "zh": "仿佛都在诡异降临后",
    "vi": "Dường như đều sau khi sự kiện kỳ dị giáng xuống."
  },
  {
    "idx": 9622,
    "start": "04:29:21,957",
    "end": "04:29:23,237",
    "start_sec": 16161.957,
    "end_sec": 16163.237,
    "zh": "发挥了巨大的作用",
    "vi": "Phát huy tác dụng to lớn."
  },
  {
    "idx": 9623,
    "start": "04:29:23,237",
    "end": "04:29:24,557",
    "start_sec": 16163.237,
    "end_sec": 16164.557,
    "zh": "我有时候都怀疑",
    "vi": "Có đôi lúc tôi còn nghi ngờ."
  },
  {
    "idx": 9624,
    "start": "04:29:24,557",
    "end": "04:29:27,317",
    "start_sec": 16164.557,
    "end_sec": 16167.317,
    "zh": "你是不是契约了什么时间内的诡异",
    "vi": "Có phải bạn đã lập khế ước với thế lực kỳ dị kiểm soát thời gian nào đó không."
  },
  {
    "idx": 9625,
    "start": "04:29:27,317",
    "end": "04:29:28,117",
    "start_sec": 16167.317,
    "end_sec": 16168.117,
    "zh": "果然",
    "vi": "Quả nhiên."
  },
  {
    "idx": 9626,
    "start": "04:29:28,117",
    "end": "04:29:30,797",
    "start_sec": 16168.117,
    "end_sec": 16170.797,
    "zh": "周扬不可能不对我所经历的一切做深究",
    "vi": "Chu Dương không thể nào không tìm hiểu kỹ những gì tôi đã trải qua."
  },
  {
    "idx": 9627,
    "start": "04:29:30,797",
    "end": "04:29:32,037",
    "start_sec": 16170.797,
    "end_sec": 16172.037,
    "zh": "你是个人才",
    "vi": "Bạn là một nhân tài."
  },
  {
    "idx": 9628,
    "start": "04:29:32,037",
    "end": "04:29:33,337",
    "start_sec": 16172.037,
    "end_sec": 16173.337,
    "zh": "我真的很欣赏你",
    "vi": "Tôi thực sự rất trân trọng bạn."
  },
  {
    "idx": 9629,
    "start": "04:29:33,337",
    "end": "04:29:34,637",
    "start_sec": 16173.337,
    "end_sec": 16174.637,
    "zh": "所以我破例一次",
    "vi": "Nên tôi phá lệ một lần."
  },
  {
    "idx": 9630,
    "start": "04:29:34,637",
    "end": "04:29:35,817",
    "start_sec": 16174.637,
    "end_sec": 16175.817,
    "zh": "程子提",
    "vi": "Trần Tử Bì."
  },
  {
    "idx": 9631,
    "start": "04:29:35,817",
    "end": "04:29:36,837",
    "start_sec": 16175.817,
    "end_sec": 16176.837,
    "zh": "我只问一次",
    "vi": "Tôi chỉ hỏi một lần."
  },
  {
    "idx": 9632,
    "start": "04:29:36,837",
    "end": "04:29:38,937",
    "start_sec": 16176.837,
    "end_sec": 16178.937,
    "zh": "你要加入我们吗",
    "vi": "Bạn có muốn gia nhập chúng tôi không."
  },
  {
    "idx": 9633,
    "start": "04:29:38,937",
    "end": "04:29:40,377",
    "start_sec": 16178.937,
    "end_sec": 16180.377,
    "zh": "什么意思啊",
    "vi": "Ý bạn là gì vậy."
  },
  {
    "idx": 9634,
    "start": "04:29:40,377",
    "end": "04:29:41,257",
    "start_sec": 16180.377,
    "end_sec": 16181.257,
    "zh": "什么叫加入你们",
    "vi": "Gia nhập chúng tôi là sao."
  },
  {
    "idx": 9635,
    "start": "04:29:41,257",
    "end": "04:29:42,397",
    "start_sec": 16181.257,
    "end_sec": 16182.397,
    "zh": "别装了",
    "vi": "Đừng giả vờ nữa."
  },
  {
    "idx": 9636,
    "start": "04:29:42,397",
    "end": "04:29:43,537",
    "start_sec": 16182.397,
    "end_sec": 16183.537,
    "zh": "我知道你很聪明",
    "vi": "Tôi biết bạn rất thông minh."
  },
  {
    "idx": 9637,
    "start": "04:29:43,537",
    "end": "04:29:44,977",
    "start_sec": 16183.537,
    "end_sec": 16184.977,
    "zh": "而且你很强",
    "vi": "Và bạn rất mạnh."
  },
  {
    "idx": 9638,
    "start": "04:29:44,977",
    "end": "04:29:46,337",
    "start_sec": 16184.977,
    "end_sec": 16186.337,
    "zh": "我也不瞒你",
    "vi": "Tôi cũng không giấu bạn."
  },
  {
    "idx": 9639,
    "start": "04:29:46,337",
    "end": "04:29:47,317",
    "start_sec": 16186.337,
    "end_sec": 16187.317,
    "zh": "现在的这一切",
    "vi": "Tất cả những gì đang diễn ra."
  },
  {
    "idx": 9640,
    "start": "04:29:47,317",
    "end": "04:29:48,597",
    "start_sec": 16187.317,
    "end_sec": 16188.597,
    "zh": "都是我们搞出来的",
    "vi": "Đều là do chúng tôi tạo ra."
  },
  {
    "idx": 9641,
    "start": "04:29:48,597",
    "end": "04:29:51,617",
    "start_sec": 16188.597,
    "end_sec": 16191.617,
    "zh": "我周家有鬼镜",
    "vi": "Nhà họ Chu chúng tôi có gương ma."
  },
  {
    "idx": 9642,
    "start": "04:29:51,617",
    "end": "04:29:53,017",
    "start_sec": 16191.617,
    "end_sec": 16193.017,
    "zh": "会愁眉鬼艺吗",
    "vi": "Có thể điều khiển cả U Sầu Quỷ Nghệ sao."
  },
  {
    "idx": 9643,
    "start": "04:29:53,017",
    "end": "04:29:53,897",
    "start_sec": 16193.017,
    "end_sec": 16193.897,
    "zh": "只要鬼镜在",
    "vi": "Chỉ cần gương ma còn đó."
  },
  {
    "idx": 9644,
    "start": "04:29:53,897",
    "end": "04:29:59,757",
    "start_sec": 16193.897,
    "end_sec": 16199.757,
    "zh": "探索里面的世界别说两只鬼蜜就是四只五只我们一样可以尝试驾驭我家拥有着无限可能,你觉得我们乐意和什么玉鬼者组织合作吗?",
    "vi": "Khám phá thế giới bên trong, đừng nói hai con ma mật, dù có bốn năm con chúng tôi cũng có thể thử điều khiển"
  },
  {
    "idx": 9644,
    "start": "04:29:59,757",
    "end": "04:30:04,914",
    "start_sec": 16199.757,
    "end_sec": 16204.914,
    "zh": "探索里面的世界别说两只鬼蜜就是四只五只我们一样可以尝试驾驭我家拥有着无限可能,你觉得我们乐意和什么玉鬼者组织合作吗?",
    "vi": "Nhà tôi có vô hạn khả năng, bạn nghĩ chúng tôi có muốn hợp tác với tổ chức Quỷ Giả nào sao"
  },
  {
    "idx": 9645,
    "start": "04:30:05,674",
    "end": "04:30:11,174",
    "start_sec": 16205.674,
    "end_sec": 16211.174,
    "zh": "长子提看着近乎癫狂的欧阳,不了讲解的,你问我有成八一方的能力,会干什么?原来,那个时候,你就在试探我的选择吗?我加入你,你能给我什么好处,一直在这船上漂着吗?",
    "vi": "Trần Tử Bì nhìn Âu Dương gần như phát điên, không giải thích, bạn hỏi tôi có năng lực của Bát Phương, sẽ làm gì"
  },
  {
    "idx": 9645,
    "start": "04:30:11,174",
    "end": "04:30:14,034",
    "start_sec": 16211.174,
    "end_sec": 16214.034,
    "zh": "长子提看着近乎癫狂的欧阳,不了讲解的,你问我有成八一方的能力,会干什么?原来,那个时候,你就在试探我的选择吗?我加入你,你能给我什么好处,一直在这船上漂着吗?",
    "vi": "Hóa ra, lúc đó bạn đang thử thách lựa chọn của tôi sao"
  },
  {
    "idx": 9645,
    "start": "04:30:14,034",
    "end": "04:30:18,214",
    "start_sec": 16214.034,
    "end_sec": 16218.214,
    "zh": "长子提看着近乎癫狂的欧阳,不了讲解的,你问我有成八一方的能力,会干什么?原来,那个时候,你就在试探我的选择吗?我加入你,你能给我什么好处,一直在这船上漂着吗?",
    "vi": "Tôi gia nhập bạn, bạn cho tôi lợi ích gì, cứ trôi dạt trên con thuyền này mãi sao"
  },
  {
    "idx": 9646,
    "start": "04:30:18,214",
    "end": "04:30:19,354",
    "start_sec": 16218.214,
    "end_sec": 16219.354,
    "zh": "当然不是",
    "vi": "Tất nhiên là không."
  },
  {
    "idx": 9647,
    "start": "04:30:19,354",
    "end": "04:30:21,834",
    "start_sec": 16219.354,
    "end_sec": 16221.834,
    "zh": "我们会不断攻击023 026",
    "vi": "Chúng tôi sẽ liên tục tấn công 023 và 026."
  },
  {
    "idx": 9648,
    "start": "04:30:21,834",
    "end": "04:30:23,254",
    "start_sec": 16221.834,
    "end_sec": 16223.254,
    "zh": "让他们的诡异复苏",
    "vi": "Để những thứ kỳ lạ của chúng hồi sinh."
  },
  {
    "idx": 9649,
    "start": "04:30:23,254",
    "end": "04:30:23,894",
    "start_sec": 16223.254,
    "end_sec": 16223.894,
    "zh": "如此",
    "vi": "Như vậy."
  },
  {
    "idx": 9650,
    "start": "04:30:23,894",
    "end": "04:30:25,534",
    "start_sec": 16223.894,
    "end_sec": 16225.534,
    "zh": "船上就有了两只鼓",
    "vi": "Trên thuyền sẽ có hai con quỷ."
  },
  {
    "idx": 9651,
    "start": "04:30:25,534",
    "end": "04:30:28,434",
    "start_sec": 16225.534,
    "end_sec": 16228.434,
    "zh": "接下来将船上所有人变成分身",
    "vi": "Tiếp theo sẽ biến tất cả mọi người trên thuyền thành phân thân."
  },
  {
    "idx": 9652,
    "start": "04:30:28,434",
    "end": "04:30:30,994",
    "start_sec": 16228.434,
    "end_sec": 16230.994,
    "zh": "将这艘船造成周家的鬼邮轮",
    "vi": "Biến con thuyền này thành Du Thuyền Quỷ của nhà họ Chu."
  },
  {
    "idx": 9653,
    "start": "04:30:30,994",
    "end": "04:30:33,894",
    "start_sec": 16230.994,
    "end_sec": 16233.894,
    "zh": "这便是我们在诡异末日的安身立命之处",
    "vi": "Đây chính là nơi nương tựa của chúng tôi trong ngày tận thế kỳ lạ."
  },
  {
    "idx": 9654,
    "start": "04:30:33,894",
    "end": "04:30:35,114",
    "start_sec": 16233.894,
    "end_sec": 16235.114,
    "zh": "除此之外",
    "vi": "Ngoài ra."
  },
  {
    "idx": 9655,
    "start": "04:30:35,114",
    "end": "04:30:37,474",
    "start_sec": 16235.114,
    "end_sec": 16237.474,
    "zh": "我们还可以接着探索鬼境内的一切",
    "vi": "Chúng ta còn có thể tiếp tục khám phá mọi thứ trong gương quỷ."
  },
  {
    "idx": 9656,
    "start": "04:30:37,474",
    "end": "04:30:39,594",
    "start_sec": 16237.474,
    "end_sec": 16239.594,
    "zh": "我们拥有着无限的可能",
    "vi": "Chúng tôi có vô hạn khả năng."
  },
  {
    "idx": 9657,
    "start": "04:30:39,594",
    "end": "04:30:41,374",
    "start_sec": 16239.594,
    "end_sec": 16241.374,
    "zh": "橙子皮加入我们",
    "vi": "Trần Tử Bì, gia nhập chúng tôi đi."
  },
  {
    "idx": 9658,
    "start": "04:30:41,374",
    "end": "04:30:42,974",
    "start_sec": 16241.374,
    "end_sec": 16242.974,
    "zh": "你说的很不错呀",
    "vi": "Bạn nói rất hay."
  },
  {
    "idx": 9659,
    "start": "04:30:42,974",
    "end": "04:30:44,774",
    "start_sec": 16242.974,
    "end_sec": 16244.774,
    "zh": "但是我拒绝",
    "vi": "Nhưng tôi từ chối."
  },
  {
    "idx": 9660,
    "start": "04:30:44,774",
    "end": "04:30:46,814",
    "start_sec": 16244.774,
    "end_sec": 16246.814,
    "zh": "我拒绝",
    "vi": "Tôi từ chối."
  },
  {
    "idx": 9661,
    "start": "04:30:46,814",
    "end": "04:30:47,574",
    "start_sec": 16246.814,
    "end_sec": 16247.574,
    "zh": "为什么",
    "vi": "Tại sao."
  },
  {
    "idx": 9662,
    "start": "04:30:47,574",
    "end": "04:30:49,654",
    "start_sec": 16247.574,
    "end_sec": 16249.654,
    "zh": "因为你们是家族企业",
    "vi": "Vì các người là doanh nghiệp gia đình."
  },
  {
    "idx": 9663,
    "start": "04:30:49,654",
    "end": "04:30:52,014",
    "start_sec": 16249.654,
    "end_sec": 16252.014,
    "zh": "我呀最讨厌家族企业了",
    "vi": "Tôi ghét nhất là doanh nghiệp gia đình đấy."
  },
  {
    "idx": 9664,
    "start": "04:30:52,014",
    "end": "04:30:54,754",
    "start_sec": 16252.014,
    "end_sec": 16254.754,
    "zh": "当然我也不是什么自诩清高的人",
    "vi": "Tất nhiên tôi cũng chẳng phải kẻ thanh cao gì."
  },
  {
    "idx": 9665,
    "start": "04:30:54,754",
    "end": "04:30:56,474",
    "start_sec": 16254.754,
    "end_sec": 16256.474,
    "zh": "只是我有个朋友",
    "vi": "Chỉ là tôi có một người bạn."
  },
  {
    "idx": 9666,
    "start": "04:30:56,474",
    "end": "04:30:59,814",
    "start_sec": 16256.474,
    "end_sec": 16259.814,
    "zh": "他一生都在与那些家族企业做抗争",
    "vi": "Cả đời cậu ấy đã đấu tranh chống lại những doanh nghiệp gia đình đó."
  },
  {
    "idx": 9667,
    "start": "04:30:59,814",
    "end": "04:31:01,894",
    "start_sec": 16259.814,
    "end_sec": 16261.894,
    "zh": "到头来连条烂命都没留下",
    "vi": "Đến cuối cùng ngay cả mạng sống cũng không giữ nổi."
  },
  {
    "idx": 9668,
    "start": "04:31:01,894",
    "end": "04:31:03,774",
    "start_sec": 16261.894,
    "end_sec": 16263.774,
    "zh": "大人物有大人物的拳头",
    "vi": "Nhân vật lớn có nắm đấm của nhân vật lớn."
  },
  {
    "idx": 9669,
    "start": "04:31:03,774",
    "end": "04:31:05,654",
    "start_sec": 16263.774,
    "end_sec": 16265.654,
    "zh": "小人物也有小人物的意志不是",
    "vi": "Người nhỏ bé cũng có ý chí của người nhỏ bé mà."
  },
  {
    "idx": 9670,
    "start": "04:31:05,654",
    "end": "04:31:08,294",
    "start_sec": 16265.654,
    "end_sec": 16268.294,
    "zh": "我不喜欢你们这些自命不凡的家族",
    "vi": "Tôi không thích những gia tộc tự cao tự đại như các người."
  },
  {
    "idx": 9671,
    "start": "04:31:08,294",
    "end": "04:31:10,174",
    "start_sec": 16268.294,
    "end_sec": 16270.174,
    "zh": "所以我拒绝",
    "vi": "Nên tôi từ chối."
  },
  {
    "idx": 9672,
    "start": "04:31:10,174",
    "end": "04:31:10,774",
    "start_sec": 16270.174,
    "end_sec": 16270.774,
    "zh": "你",
    "vi": "Anh."
  },
  {
    "idx": 9673,
    "start": "04:31:10,774",
    "end": "04:31:13,614",
    "start_sec": 16270.774,
    "end_sec": 16273.614,
    "zh": "再者周大公子你也没诚意啊",
    "vi": "Hơn nữa cậu cả nhà họ Chu cũng thật thiếu thành ý."
  },
  {
    "idx": 9674,
    "start": "04:31:13,614",
    "end": "04:31:15,754",
    "start_sec": 16273.614,
    "end_sec": 16275.754,
    "zh": "邀请我加入居然派假身来",
    "vi": "Mời tôi gia nhập mà lại cử phân thân đến."
  },
  {
    "idx": 9675,
    "start": "04:31:15,754",
    "end": "04:31:17,474",
    "start_sec": 16275.754,
    "end_sec": 16277.474,
    "zh": "哦你竟然知道",
    "vi": "Ồ anh lại biết chuyện đó sao."
  },
  {
    "idx": 9676,
    "start": "04:31:17,474",
    "end": "04:31:19,534",
    "start_sec": 16277.474,
    "end_sec": 16279.534,
    "zh": "橙子皮啊橙子皮",
    "vi": "Trần Tử Bì à Trần Tử Bì."
  },
  {
    "idx": 9677,
    "start": "04:31:19,534",
    "end": "04:31:20,454",
    "start_sec": 16279.534,
    "end_sec": 16280.454,
    "zh": "说了这么多",
    "vi": "Nói nhiều như vậy."
  },
  {
    "idx": 9678,
    "start": "04:31:20,454",
    "end": "04:31:21,574",
    "start_sec": 16280.454,
    "end_sec": 16281.574,
    "zh": "你也还是拒绝",
    "vi": "Anh vẫn từ chối sao."
  },
  {
    "idx": 9679,
    "start": "04:31:21,574",
    "end": "04:31:22,634",
    "start_sec": 16281.574,
    "end_sec": 16282.634,
    "zh": "我不好意思",
    "vi": "Tôi rất tiếc."
  },
  {
    "idx": 9680,
    "start": "04:31:22,634",
    "end": "04:31:25,294",
    "start_sec": 16282.634,
    "end_sec": 16285.294,
    "zh": "这船上只能容得下周家人了",
    "vi": "Con tàu này chỉ có chỗ cho người nhà họ Chu thôi."
  },
  {
    "idx": 9681,
    "start": "04:31:25,294",
    "end": "04:31:26,854",
    "start_sec": 16285.294,
    "end_sec": 16286.854,
    "zh": "无聊的把戏",
    "vi": "Trò hề vô vị."
  },
  {
    "idx": 9682,
    "start": "04:31:26,854",
    "end": "04:31:31,154",
    "start_sec": 16286.854,
    "end_sec": 16291.154,
    "zh": "来死还是太被动了",
    "vi": "Chờ chết thì quá bị động rồi."
  },
  {
    "idx": 9683,
    "start": "04:31:31,154",
    "end": "04:31:32,234",
    "start_sec": 16291.154,
    "end_sec": 16292.234,
    "zh": "他们不出真身",
    "vi": "Họ không lộ bản thể."
  },
  {
    "idx": 9684,
    "start": "04:31:32,234",
    "end": "04:31:34,074",
    "start_sec": 16292.234,
    "end_sec": 16294.074,
    "zh": "我们这边哪怕有三个遇鬼者",
    "vi": "Bên ta dù có ba ngự quỷ giả."
  },
  {
    "idx": 9685,
    "start": "04:31:34,074",
    "end": "04:31:35,554",
    "start_sec": 16294.074,
    "end_sec": 16295.554,
    "zh": "他们不断用分身骚扰",
    "vi": "Họ liên tục dùng phân thân quấy rối."
  },
  {
    "idx": 9686,
    "start": "04:31:35,554",
    "end": "04:31:36,914",
    "start_sec": 16295.554,
    "end_sec": 16296.914,
    "zh": "我们也根本没有胜算",
    "vi": "Chúng ta cũng hoàn toàn không có cơ hội thắng."
  },
  {
    "idx": 9687,
    "start": "04:31:36,914",
    "end": "04:31:38,134",
    "start_sec": 16296.914,
    "end_sec": 16298.134,
    "zh": "走出房间",
    "vi": "Đi ra khỏi phòng."
  },
  {
    "idx": 9688,
    "start": "04:31:38,134",
    "end": "04:31:39,734",
    "start_sec": 16298.134,
    "end_sec": 16299.734,
    "zh": "橙子皮门口和026",
    "vi": "Trần Tử Bì ở cửa cùng 026."
  },
  {
    "idx": 9689,
    "start": "04:31:39,734",
    "end": "04:31:40,854",
    "start_sec": 16299.734,
    "end_sec": 16300.854,
    "zh": "023回合",
    "vi": "hội hợp với 023."
  },
  {
    "idx": 9690,
    "start": "04:31:40,854",
    "end": "04:31:42,194",
    "start_sec": 16300.854,
    "end_sec": 16302.194,
    "zh": "那样根本没有意义",
    "vi": "Như vậy chẳng có ý nghĩa gì cả."
  },
  {
    "idx": 9691,
    "start": "04:31:42,194",
    "end": "04:31:42,754",
    "start_sec": 16302.194,
    "end_sec": 16302.754,
    "zh": "想了想",
    "vi": "Sau khi suy nghĩ một lát"
  },
  {
    "idx": 9692,
    "start": "04:31:42,754",
    "end": "04:31:44,554",
    "start_sec": 16302.754,
    "end_sec": 16304.554,
    "zh": "他朝着三门船长式的行",
    "vi": "anh ta đi về phía cabin của thuyền trưởng"
  },
  {
    "idx": 9693,
    "start": "04:31:44,554",
    "end": "04:31:49,414",
    "start_sec": 16304.554,
    "end_sec": 16309.414,
    "zh": "说不定他要重开一次",
    "vi": "biết đâu anh ta muốn bắt đầu lại một lần nữa"
  },
  {
    "idx": 9694,
    "start": "04:31:49,414",
    "end": "04:31:51,454",
    "start_sec": 16309.414,
    "end_sec": 16311.454,
    "zh": "给过去的自己发完消息",
    "vi": "Sau khi gửi tin nhắn cho bản thân trong quá khứ"
  },
  {
    "idx": 9695,
    "start": "04:31:51,454",
    "end": "04:31:54,094",
    "start_sec": 16311.454,
    "end_sec": 16314.094,
    "zh": "橙子皮硬着头皮再次走进鬼界",
    "vi": "Trần Tử Bì đành phải liều mạng bước vào quỷ giới một lần nữa"
  },
  {
    "idx": 9696,
    "start": "04:31:54,094",
    "end": "04:31:57,094",
    "start_sec": 16314.094,
    "end_sec": 16317.094,
    "zh": "希望这一次能有新发现吧",
    "vi": "hy vọng lần này sẽ có phát hiện mới"
  },
  {
    "idx": 9697,
    "start": "04:31:57,094",
    "end": "04:31:59,014",
    "start_sec": 16317.094,
    "end_sec": 16319.014,
    "zh": "一路上都是熟悉的画面",
    "vi": "Suốt chặng đường đều là những hình ảnh quen thuộc"
  },
  {
    "idx": 9698,
    "start": "04:31:59,014",
    "end": "04:32:01,694",
    "start_sec": 16319.014,
    "end_sec": 16321.694,
    "zh": "橙子皮黑着脸绕过小磨叽的时机",
    "vi": "Trần Tử Bì sa sầm mặt mày đi vòng qua thời điểm của Tiểu Mặc Kê"
  },
  {
    "idx": 9699,
    "start": "04:32:01,694",
    "end": "04:32:03,814",
    "start_sec": 16321.694,
    "end_sec": 16323.814,
    "zh": "可能是剧情走向偏差的缘故",
    "vi": "Có lẽ là do hướng đi của cốt truyện bị lệch"
  },
  {
    "idx": 9700,
    "start": "04:32:03,814",
    "end": "04:32:05,434",
    "start_sec": 16323.814,
    "end_sec": 16325.434,
    "zh": "这次并没有遇到误障鬼",
    "vi": "lần này không hề gặp phải sương chướng quỷ"
  },
  {
    "idx": 9701,
    "start": "04:32:05,434",
    "end": "04:32:06,874",
    "start_sec": 16325.434,
    "end_sec": 16326.874,
    "zh": "浓稠的水雾尽头",
    "vi": "Nơi tận cùng của làn sương nước dày đặc"
  },
  {
    "idx": 9702,
    "start": "04:32:06,874",
    "end": "04:32:09,914",
    "start_sec": 16326.874,
    "end_sec": 16329.914,
    "zh": "这一次橙子皮在尽头处看到了两个人",
    "vi": "lần này Trần Tử Bì nhìn thấy hai người ở phía cuối đường"
  },
  {
    "idx": 9703,
    "start": "04:32:09,914",
    "end": "04:32:10,654",
    "start_sec": 16329.914,
    "end_sec": 16330.654,
    "zh": "老爹",
    "vi": "Cha ơi"
  },
  {
    "idx": 9704,
    "start": "04:32:10,654",
    "end": "04:32:12,334",
    "start_sec": 16330.654,
    "end_sec": 16332.334,
    "zh": "你说湖泊对面是什么呢",
    "vi": "cha nói xem phía đối diện hồ nước là gì vậy."
  },
  {
    "idx": 9705,
    "start": "04:32:12,334",
    "end": "04:32:14,434",
    "start_sec": 16332.334,
    "end_sec": 16334.434,
    "zh": "那里又藏着什么鬼迷呢",
    "vi": "nơi đó lại ẩn chứa bí ẩn quỷ dị gì chứ."
  },
  {
    "idx": 9706,
    "start": "04:32:14,434",
    "end": "04:32:16,274",
    "start_sec": 16334.434,
    "end_sec": 16336.274,
    "zh": "呵呵",
    "vi": "Ha ha"
  },
  {
    "idx": 9707,
    "start": "04:32:16,274",
    "end": "04:32:17,634",
    "start_sec": 16336.274,
    "end_sec": 16337.634,
    "zh": "你都不怕这玩意了",
    "vi": "con đã không còn sợ thứ này nữa rồi"
  },
  {
    "idx": 9708,
    "start": "04:32:17,634",
    "end": "04:32:18,374",
    "start_sec": 16337.634,
    "end_sec": 16338.374,
    "zh": "我喝不喝",
    "vi": "ta uống hay không."
  },
  {
    "idx": 9709,
    "start": "04:32:18,374",
    "end": "04:32:18,994",
    "start_sec": 16338.374,
    "end_sec": 16338.994,
    "zh": "你无所谓",
    "vi": "con cũng không quan tâm"
  },
  {
    "idx": 9710,
    "start": "04:32:18,994",
    "end": "04:32:21,854",
    "start_sec": 16338.994,
    "end_sec": 16341.854,
    "zh": "不得不说",
    "vi": "Không thể không nói"
  },
  {
    "idx": 9711,
    "start": "04:32:21,854",
    "end": "04:32:22,894",
    "start_sec": 16341.854,
    "end_sec": 16342.894,
    "zh": "这新鲜蛋",
    "vi": "quả trứng tươi này"
  },
  {
    "idx": 9712,
    "start": "04:32:22,894",
    "end": "04:32:24,134",
    "start_sec": 16342.894,
    "end_sec": 16344.134,
    "zh": "就是不一样",
    "vi": "đúng là khác biệt"
  },
  {
    "idx": 9713,
    "start": "04:32:24,134",
    "end": "04:32:25,294",
    "start_sec": 16344.134,
    "end_sec": 16345.294,
    "zh": "复制体",
    "vi": "Bản sao"
  },
  {
    "idx": 9714,
    "start": "04:32:25,294",
    "end": "04:32:26,534",
    "start_sec": 16345.294,
    "end_sec": 16346.534,
    "zh": "终究只是复制体",
    "vi": "rốt cuộc cũng chỉ là bản sao"
  },
  {
    "idx": 9715,
    "start": "04:32:26,534",
    "end": "04:32:27,074",
    "start_sec": 16346.534,
    "end_sec": 16347.074,
    "zh": "没意思",
    "vi": "thật vô vị"
  },
  {
    "idx": 9716,
    "start": "04:32:27,074",
    "end": "04:32:28,614",
    "start_sec": 16347.074,
    "end_sec": 16348.614,
    "zh": "这方世界",
    "vi": "Thế giới này"
  },
  {
    "idx": 9717,
    "start": "04:32:28,614",
    "end": "04:32:30,034",
    "start_sec": 16348.614,
    "end_sec": 16350.034,
    "zh": "一个人游荡",
    "vi": "một mình lang thang"
  },
  {
    "idx": 9718,
    "start": "04:32:30,034",
    "end": "04:32:31,794",
    "start_sec": 16350.034,
    "end_sec": 16351.794,
    "zh": "终究是无趣的心啊",
    "vi": "rốt cuộc cũng là một trái tim tẻ nhạt"
  },
  {
    "idx": 9719,
    "start": "04:32:31,794",
    "end": "04:32:32,474",
    "start_sec": 16351.794,
    "end_sec": 16352.474,
    "zh": "橙子皮啊",
    "vi": "Trần Tử Bì à"
  },
  {
    "idx": 9720,
    "start": "04:32:32,474",
    "end": "04:32:33,014",
    "start_sec": 16352.474,
    "end_sec": 16353.014,
    "zh": "橙子皮",
    "vi": "Trần Tử Bì"
  },
  {
    "idx": 9721,
    "start": "04:32:33,014",
    "end": "04:32:33,674",
    "start_sec": 16353.014,
    "end_sec": 16353.674,
    "zh": "你为什么",
    "vi": "Tại sao ngươi"
  },
  {
    "idx": 9722,
    "start": "04:32:33,674",
    "end": "04:32:35,294",
    "start_sec": 16353.674,
    "end_sec": 16355.294,
    "zh": "不肯加入我们呢",
    "vi": "lại không chịu gia nhập với chúng ta chứ."
  },
  {
    "idx": 9723,
    "start": "04:32:35,294",
    "end": "04:32:36,274",
    "start_sec": 16355.294,
    "end_sec": 16356.274,
    "zh": "这俩人喝的",
    "vi": "Hai kẻ này đang uống"
  },
  {
    "idx": 9724,
    "start": "04:32:36,274",
    "end": "04:32:37,114",
    "start_sec": 16356.274,
    "end_sec": 16357.114,
    "zh": "怕不是红酒",
    "vi": "e rằng không phải rượu vang"
  },
  {
    "idx": 9725,
    "start": "04:32:37,114",
    "end": "04:32:38,094",
    "start_sec": 16357.114,
    "end_sec": 16358.094,
    "zh": "而是血吧",
    "vi": "mà là máu"
  },
  {
    "idx": 9726,
    "start": "04:32:38,094",
    "end": "04:32:38,934",
    "start_sec": 16358.094,
    "end_sec": 16358.934,
    "zh": "妈的",
    "vi": "Mẹ kiếp"
  },
  {
    "idx": 9727,
    "start": "04:32:38,934",
    "end": "04:32:40,314",
    "start_sec": 16358.934,
    "end_sec": 16360.314,
    "zh": "该不会是小磨叽的血吧",
    "vi": "không lẽ là máu của Tiểu Mặc Kê."
  },
  {
    "idx": 9728,
    "start": "04:32:40,314",
    "end": "04:32:43,734",
    "start_sec": 16360.314,
    "end_sec": 16363.734,
    "zh": "两位好雅兴啊",
    "vi": "Hai vị thật là nhã hứng."
  },
  {
    "idx": 9729,
    "start": "04:32:43,734",
    "end": "04:32:46,294",
    "start_sec": 16363.734,
    "end_sec": 16366.294,
    "zh": "看狐影眩,喝的,是黑狗血吗?",
    "vi": "Nhìn Hồ Ảnh Huyễn kìa, thứ đang uống là máu chó đen sao."
  },
  {
    "idx": 9730,
    "start": "04:32:46,614",
    "end": "04:32:48,414",
    "start_sec": 16366.614,
    "end_sec": 16368.414,
    "zh": "橙子皮,你居然能找到这里?",
    "vi": "Trần Tử Bì, ngươi vậy mà lại tìm được đến đây."
  },
  {
    "idx": 9731,
    "start": "04:32:48,754",
    "end": "04:32:50,874",
    "start_sec": 16368.754,
    "end_sec": 16370.874,
    "zh": "我能找到这里,运气好吧了。",
    "vi": "Ta tìm được đến đây chỉ là do may mắn thôi."
  },
  {
    "idx": 9732,
    "start": "04:32:51,394",
    "end": "04:32:53,434",
    "start_sec": 16371.394,
    "end_sec": 16373.434,
    "zh": "运气好能避开我给你设置的陷阱吗?",
    "vi": "May mắn mà né được bẫy ta giăng sẵn cho ngươi sao."
  },
  {
    "idx": 9733,
    "start": "04:32:54,534",
    "end": "04:32:56,434",
    "start_sec": 16374.534,
    "end_sec": 16376.434,
    "zh": "小墨鸡,果然是你杀的。",
    "vi": "Tiểu Mặc Kê quả nhiên là do ngươi giết."
  },
  {
    "idx": 9734,
    "start": "04:32:56,934",
    "end": "04:33:00,494",
    "start_sec": 16376.934,
    "end_sec": 16380.494,
    "zh": "橙子皮啊橙子皮,是我看不懂你了,还是你真的变了呢?",
    "vi": "Trần Tử Bì à Trần Tử Bì, là ta nhìn không thấu ngươi hay là ngươi thực sự đã thay đổi rồi."
  },
  {
    "idx": 9735,
    "start": "04:33:00,834",
    "end": "04:33:04,914",
    "start_sec": 16380.834,
    "end_sec": 16384.914,
    "zh": "以我对你的了解,你肯定会奋不顾身的去看小墨鸡,然后掉进你场地。",
    "vi": "Theo những gì ta biết về ngươi, ngươi chắc chắn sẽ bất chấp tất cả đi xem Tiểu Mặc Kê rồi rơi vào bẫy."
  },
  {
    "idx": 9736,
    "start": "04:33:05,254",
    "end": "04:33:09,194",
    "start_sec": 16385.254,
    "end_sec": 16389.194,
    "zh": "可是,你明明看见了小墨鸡,却是只不见,心平气和的走到这里。",
    "vi": "Nhưng ngươi rõ ràng đã nhìn thấy Tiểu Mặc Kê mà lại vờ như không thấy, bình thản đi đến đây."
  },
  {
    "idx": 9737,
    "start": "04:33:09,454",
    "end": "04:33:12,134",
    "start_sec": 16389.454,
    "end_sec": 16392.134,
    "zh": "说实话,我都怀疑,你还是不是那个橙子皮了?",
    "vi": "Nói thật, ta đều nghi ngờ không biết ngươi có còn là Trần Tử Bì đó nữa không."
  },
  {
    "idx": 9738,
    "start": "04:33:12,134",
    "end": "04:33:14,214",
    "start_sec": 16392.134,
    "end_sec": 16394.214,
    "zh": "那你还是以前那个周扬吗",
    "vi": "Vậy ngươi có còn là Chu Dương của trước kia không."
  },
  {
    "idx": 9739,
    "start": "04:33:14,214",
    "end": "04:33:17,374",
    "start_sec": 16394.214,
    "end_sec": 16397.374,
    "zh": "这他妈狗日的鬼衣墨鱼",
    "vi": "Cái thứ Quỷ Y Mặc Ngư khốn kiếp này"
  },
  {
    "idx": 9740,
    "start": "04:33:17,374",
    "end": "04:33:18,834",
    "start_sec": 16397.374,
    "end_sec": 16398.834,
    "zh": "谁他妈还当人了",
    "vi": "ai thèm làm người nữa chứ."
  },
  {
    "idx": 9741,
    "start": "04:33:18,834",
    "end": "04:33:19,934",
    "start_sec": 16398.834,
    "end_sec": 16399.934,
    "zh": "很好很好",
    "vi": "Tốt lắm tốt lắm"
  },
  {
    "idx": 9742,
    "start": "04:33:19,934",
    "end": "04:33:20,754",
    "start_sec": 16399.934,
    "end_sec": 16400.754,
    "zh": "陈子皮",
    "vi": "Trần Tử Bì"
  },
  {
    "idx": 9743,
    "start": "04:33:20,754",
    "end": "04:33:22,494",
    "start_sec": 16400.754,
    "end_sec": 16402.494,
    "zh": "我越来越欣赏你了",
    "vi": "ta ngày càng đánh giá cao ngươi rồi đấy."
  },
  {
    "idx": 9744,
    "start": "04:33:22,494",
    "end": "04:33:23,594",
    "start_sec": 16402.494,
    "end_sec": 16403.594,
    "zh": "我最后问你一次",
    "vi": "Ta hỏi ngươi lần cuối"
  },
  {
    "idx": 9745,
    "start": "04:33:23,594",
    "end": "04:33:24,634",
    "start_sec": 16403.594,
    "end_sec": 16404.634,
    "zh": "加入我吗",
    "vi": "có gia nhập với ta không."
  },
  {
    "idx": 9746,
    "start": "04:33:24,634",
    "end": "04:33:25,354",
    "start_sec": 16404.634,
    "end_sec": 16405.354,
    "zh": "你我联手",
    "vi": "Ngươi và ta liên thủ"
  },
  {
    "idx": 9747,
    "start": "04:33:25,354",
    "end": "04:33:27,134",
    "start_sec": 16405.354,
    "end_sec": 16407.134,
    "zh": "我觉得我们未必打造不出",
    "vi": "ta nghĩ chúng ta chưa chắc đã không thể tạo nên"
  },
  {
    "idx": 9748,
    "start": "04:33:27,134",
    "end": "04:33:28,674",
    "start_sec": 16407.134,
    "end_sec": 16408.674,
    "zh": "与鬼者组织那样的势力",
    "vi": "một thế lực như tổ chức Ngự Quỷ Giả."
  },
  {
    "idx": 9749,
    "start": "04:33:28,674",
    "end": "04:33:30,054",
    "start_sec": 16408.674,
    "end_sec": 16410.054,
    "zh": "然而这次陈子皮",
    "vi": "Thế nhưng lần này Trần Tử Bì"
  },
  {
    "idx": 9750,
    "start": "04:33:30,054",
    "end": "04:33:31,414",
    "start_sec": 16410.054,
    "end_sec": 16411.414,
    "zh": "没有给出任何回应",
    "vi": "đã không đưa ra bất kỳ phản hồi nào."
  },
  {
    "idx": 9751,
    "start": "04:33:31,414",
    "end": "04:33:33,034",
    "start_sec": 16411.414,
    "end_sec": 16413.034,
    "zh": "鬼面窗",
    "vi": "Quỷ Diện Song"
  },
  {
    "idx": 9752,
    "start": "04:33:33,034",
    "end": "04:33:36,914",
    "start_sec": 16413.034,
    "end_sec": 16416.914,
    "zh": "小子",
    "vi": "Nhóc con"
  },
  {
    "idx": 9753,
    "start": "04:33:36,914",
    "end": "04:33:37,774",
    "start_sec": 16416.914,
    "end_sec": 16417.774,
    "zh": "你是不是",
    "vi": "Mày đang"
  },
  {
    "idx": 9754,
    "start": "04:33:37,774",
    "end": "04:33:39,074",
    "start_sec": 16417.774,
    "end_sec": 16419.074,
    "zh": "来把我当鬼",
    "vi": "coi tao là quỷ à"
  },
  {
    "idx": 9755,
    "start": "04:33:39,074",
    "end": "04:33:40,914",
    "start_sec": 16419.074,
    "end_sec": 16420.914,
    "zh": "鬼面窗",
    "vi": "Quỷ Diện Song"
  },
  {
    "idx": 9756,
    "start": "04:33:40,914",
    "end": "04:33:42,014",
    "start_sec": 16420.914,
    "end_sec": 16422.014,
    "zh": "小子",
    "vi": "Nhóc con"
  },
  {
    "idx": 9757,
    "start": "04:33:42,014",
    "end": "04:33:42,734",
    "start_sec": 16422.014,
    "end_sec": 16422.734,
    "zh": "别叫了",
    "vi": "Đừng la nữa"
  },
  {
    "idx": 9758,
    "start": "04:33:42,734",
    "end": "04:33:43,594",
    "start_sec": 16422.734,
    "end_sec": 16423.594,
    "zh": "你运气不错",
    "vi": "Mày may mắn lắm đấy"
  },
  {
    "idx": 9759,
    "start": "04:33:43,594",
    "end": "04:33:44,674",
    "start_sec": 16423.594,
    "end_sec": 16424.674,
    "zh": "这个是本体",
    "vi": "Đây là bản thể"
  },
  {
    "idx": 9760,
    "start": "04:33:44,674",
    "end": "04:33:47,314",
    "start_sec": 16424.674,
    "end_sec": 16427.314,
    "zh": "小家伙",
    "vi": "Tiểu tử"
  },
  {
    "idx": 9761,
    "start": "04:33:47,314",
    "end": "04:33:48,354",
    "start_sec": 16427.314,
    "end_sec": 16428.354,
    "zh": "看不出来",
    "vi": "Không ngờ"
  },
  {
    "idx": 9762,
    "start": "04:33:48,354",
    "end": "04:33:51,474",
    "start_sec": 16428.354,
    "end_sec": 16431.474,
    "zh": "你的身上还有这么强硕的力量",
    "vi": "Trên người mày lại có sức mạnh cường đại đến vậy"
  },
  {
    "idx": 9763,
    "start": "04:33:51,474",
    "end": "04:33:53,234",
    "start_sec": 16431.474,
    "end_sec": 16433.234,
    "zh": "可不像是人为半年",
    "vi": "Không giống như bị người ta điều khiển nửa năm"
  },
  {
    "idx": 9764,
    "start": "04:33:53,234",
    "end": "04:33:54,374",
    "start_sec": 16433.234,
    "end_sec": 16434.374,
    "zh": "让一个",
    "vi": "Để một"
  },
  {
    "idx": 9765,
    "start": "04:33:54,374",
    "end": "04:33:57,474",
    "start_sec": 16434.374,
    "end_sec": 16437.474,
    "zh": "下一个",
    "vi": "Kẻ tiếp theo"
  },
  {
    "idx": 9766,
    "start": "04:33:57,474",
    "end": "04:33:59,094",
    "start_sec": 16437.474,
    "end_sec": 16439.094,
    "zh": "周河山碎裂成鬼物",
    "vi": "Chu Hà Sơn tan thành quỷ vật"
  },
  {
    "idx": 9767,
    "start": "04:33:59,094",
    "end": "04:34:01,354",
    "start_sec": 16439.094,
    "end_sec": 16441.354,
    "zh": "正在缓缓扭曲藏藏的皮肤",
    "vi": "Làn da của Tang Tang đang từ từ bị vặn vẹo"
  },
  {
    "idx": 9768,
    "start": "04:34:01,354",
    "end": "04:34:02,634",
    "start_sec": 16441.354,
    "end_sec": 16442.634,
    "zh": "妈的",
    "vi": "Chết tiệt"
  },
  {
    "idx": 9769,
    "start": "04:34:02,634",
    "end": "04:34:04,374",
    "start_sec": 16442.634,
    "end_sec": 16444.374,
    "zh": "原来周河山已经死了",
    "vi": "Hóa ra Chu Hà Sơn đã chết rồi"
  },
  {
    "idx": 9770,
    "start": "04:34:04,374",
    "end": "04:34:06,414",
    "start_sec": 16444.374,
    "end_sec": 16446.414,
    "zh": "这个周河山就是物账鬼的本体",
    "vi": "Chu Hà Sơn này chính là bản thể của Vật Trướng Quỷ"
  },
  {
    "idx": 9771,
    "start": "04:34:06,414",
    "end": "04:34:07,554",
    "start_sec": 16446.414,
    "end_sec": 16447.554,
    "zh": "他是周扬的鬼力",
    "vi": "Đó là sức mạnh quỷ dị của Chu Dương"
  },
  {
    "idx": 9772,
    "start": "04:34:07,554",
    "end": "04:34:08,574",
    "start_sec": 16447.554,
    "end_sec": 16448.574,
    "zh": "鬼面窗",
    "vi": "Quỷ Diện Song"
  },
  {
    "idx": 9773,
    "start": "04:34:08,574",
    "end": "04:34:09,734",
    "start_sec": 16448.574,
    "end_sec": 16449.734,
    "zh": "能不能把它做掉",
    "vi": "Có thể xử lý nó không"
  },
  {
    "idx": 9774,
    "start": "04:34:09,734",
    "end": "04:34:10,554",
    "start_sec": 16449.734,
    "end_sec": 16450.554,
    "zh": "小的",
    "vi": "Tiểu đệ"
  },
  {
    "idx": 9775,
    "start": "04:34:10,554",
    "end": "04:34:11,994",
    "start_sec": 16450.554,
    "end_sec": 16451.994,
    "zh": "这有点难搞啊",
    "vi": "Cái này hơi khó đấy"
  },
  {
    "idx": 9776,
    "start": "04:34:11,994",
    "end": "04:34:12,634",
    "start_sec": 16451.994,
    "end_sec": 16452.634,
    "zh": "为什么",
    "vi": "Tại sao"
  },
  {
    "idx": 9777,
    "start": "04:34:12,634",
    "end": "04:34:15,574",
    "start_sec": 16452.634,
    "end_sec": 16455.574,
    "zh": "因为这只鬼异与鬼运相互聚约了",
    "vi": "Bởi vì con quỷ này đã bị Quỷ Dị và Quỷ Vận ràng buộc lẫn nhau"
  },
  {
    "idx": 9778,
    "start": "04:34:15,574",
    "end": "04:34:16,274",
    "start_sec": 16455.574,
    "end_sec": 16456.274,
    "zh": "也就是说",
    "vi": "Nói cách khác"
  },
  {
    "idx": 9779,
    "start": "04:34:16,274",
    "end": "04:34:17,734",
    "start_sec": 16456.274,
    "end_sec": 16457.734,
    "zh": "它可以全力调用能力",
    "vi": "Nó có thể toàn quyền sử dụng năng lực"
  },
  {
    "idx": 9780,
    "start": "04:34:17,734",
    "end": "04:34:19,554",
    "start_sec": 16457.734,
    "end_sec": 16459.554,
    "zh": "不用害怕宿主被鬼异复苏",
    "vi": "Không cần lo lắng ký chủ bị Quỷ Dị phục hồi"
  },
  {
    "idx": 9781,
    "start": "04:34:19,554",
    "end": "04:34:20,574",
    "start_sec": 16459.554,
    "end_sec": 16460.574,
    "zh": "但是你",
    "vi": "Nhưng bạn thì"
  },
  {
    "idx": 9782,
    "start": "04:34:20,574",
    "end": "04:34:22,434",
    "start_sec": 16460.574,
    "end_sec": 16462.434,
    "zh": "除非你让我复苏",
    "vi": "Trừ khi bạn cho phép tôi hồi sinh"
  },
  {
    "idx": 9783,
    "start": "04:34:22,434",
    "end": "04:34:24,254",
    "start_sec": 16462.434,
    "end_sec": 16464.254,
    "zh": "不拼着鬼异复苏的全力去",
    "vi": "Nếu không dốc toàn lực cho sự hồi sinh của quỷ dị"
  },
  {
    "idx": 9784,
    "start": "04:34:24,254",
    "end": "04:34:25,754",
    "start_sec": 16464.254,
    "end_sec": 16465.754,
    "zh": "我可制衡不了它多久",
    "vi": "Tôi không thể kiềm chế nó được bao lâu đâu"
  },
  {
    "idx": 9785,
    "start": "04:34:25,754",
    "end": "04:34:27,474",
    "start_sec": 16465.754,
    "end_sec": 16467.474,
    "zh": "仍然橙子皮咬着",
    "vi": "Vẫn đang cắn Trần Tử Bì"
  },
  {
    "idx": 9786,
    "start": "04:34:27,474",
    "end": "04:34:29,114",
    "start_sec": 16467.474,
    "end_sec": 16469.114,
    "zh": "还想面色淡然的周扬",
    "vi": "Chu Dương vẫn giữ vẻ mặt bình thản"
  },
  {
    "idx": 9787,
    "start": "04:34:29,114",
    "end": "04:34:29,934",
    "start_sec": 16469.114,
    "end_sec": 16469.934,
    "zh": "冷声问了",
    "vi": "Lạnh lùng hỏi"
  },
  {
    "idx": 9788,
    "start": "04:34:29,934",
    "end": "04:34:30,514",
    "start_sec": 16469.934,
    "end_sec": 16470.514,
    "zh": "其实",
    "vi": "Thực ra"
  },
  {
    "idx": 9789,
    "start": "04:34:30,514",
    "end": "04:34:32,114",
    "start_sec": 16470.514,
    "end_sec": 16472.114,
    "zh": "诸葛山一早就死了",
    "vi": "Gia Cát Sơn đã chết từ lâu rồi"
  },
  {
    "idx": 9790,
    "start": "04:34:32,114",
    "end": "04:34:32,614",
    "start_sec": 16472.114,
    "end_sec": 16472.614,
    "zh": "对吧",
    "vi": "Đúng không"
  },
  {
    "idx": 9791,
    "start": "04:34:32,614",
    "end": "04:34:33,034",
    "start_sec": 16472.614,
    "end_sec": 16473.034,
    "zh": "哦",
    "vi": "Ồ"
  },
  {
    "idx": 9792,
    "start": "04:34:33,034",
    "end": "04:34:34,034",
    "start_sec": 16473.034,
    "end_sec": 16474.034,
    "zh": "你怎么知道的",
    "vi": "Sao bạn lại biết được"
  },
  {
    "idx": 9793,
    "start": "04:34:34,034",
    "end": "04:34:34,934",
    "start_sec": 16474.034,
    "end_sec": 16474.934,
    "zh": "怎么",
    "vi": "Sao nào"
  },
  {
    "idx": 9794,
    "start": "04:34:34,934",
    "end": "04:34:36,654",
    "start_sec": 16474.934,
    "end_sec": 16476.654,
    "zh": "你的鬼异能看出真假吗",
    "vi": "Quỷ dị của bạn có thể nhìn ra thật giả sao"
  },
  {
    "idx": 9795,
    "start": "04:34:36,654",
    "end": "04:34:37,934",
    "start_sec": 16476.654,
    "end_sec": 16477.934,
    "zh": "周扬思绪黑化",
    "vi": "Tư duy của Chu Dương trở nên đen tối"
  },
  {
    "idx": 9796,
    "start": "04:34:37,934",
    "end": "04:34:39,014",
    "start_sec": 16477.934,
    "end_sec": 16479.014,
    "zh": "几乎是一瞬间",
    "vi": "Gần như ngay lập tức"
  },
  {
    "idx": 9797,
    "start": "04:34:39,014",
    "end": "04:34:40,854",
    "start_sec": 16479.014,
    "end_sec": 16480.854,
    "zh": "就琢磨出了橙子皮的能力",
    "vi": "Đã đoán ra được năng lực của Trần Tử Bì"
  },
  {
    "idx": 9798,
    "start": "04:34:40,854",
    "end": "04:34:41,694",
    "start_sec": 16480.854,
    "end_sec": 16481.694,
    "zh": "周扬啊周扬",
    "vi": "Chu Dương à Chu Dương"
  },
  {
    "idx": 9799,
    "start": "04:34:41,694",
    "end": "04:34:42,494",
    "start_sec": 16481.694,
    "end_sec": 16482.494,
    "zh": "不得不承认",
    "vi": "Phải thừa nhận rằng"
  },
  {
    "idx": 9800,
    "start": "04:34:42,494",
    "end": "04:34:43,834",
    "start_sec": 16482.494,
    "end_sec": 16483.834,
    "zh": "你可真是老谋生算了",
    "vi": "Bạn thật sự rất mưu mô tính toán"
  },
  {
    "idx": 9801,
    "start": "04:34:43,834",
    "end": "04:34:44,734",
    "start_sec": 16483.834,
    "end_sec": 16484.734,
    "zh": "同时之中",
    "vi": "Trong cùng một lúc"
  },
  {
    "idx": 9802,
    "start": "04:34:44,734",
    "end": "04:34:46,014",
    "start_sec": 16484.734,
    "end_sec": 16486.014,
    "zh": "大家都被你骗了",
    "vi": "Mọi người đều bị bạn lừa"
  },
  {
    "idx": 9803,
    "start": "04:34:46,014",
    "end": "04:34:47,494",
    "start_sec": 16486.014,
    "end_sec": 16487.494,
    "zh": "你们父子带着鬼精上船",
    "vi": "Hai cha con bạn mang quỷ tinh lên tàu"
  },
  {
    "idx": 9804,
    "start": "04:34:47,494",
    "end": "04:34:49,094",
    "start_sec": 16487.494,
    "end_sec": 16489.094,
    "zh": "谁都不会去怀疑你的身份",
    "vi": "Sẽ chẳng ai nghi ngờ thân phận của bạn cả"
  },
  {
    "idx": 9805,
    "start": "04:34:49,094",
    "end": "04:34:50,014",
    "start_sec": 16489.094,
    "end_sec": 16490.014,
    "zh": "也就是说",
    "vi": "Nghĩa là"
  },
  {
    "idx": 9806,
    "start": "04:34:50,014",
    "end": "04:34:50,754",
    "start_sec": 16490.014,
    "end_sec": 16490.754,
    "zh": "你让物账鬼",
    "vi": "Bạn để quỷ vật trướng"
  },
  {
    "idx": 9807,
    "start": "04:34:50,754",
    "end": "04:34:51,994",
    "start_sec": 16490.754,
    "end_sec": 16491.994,
    "zh": "变成死里的周和珊",
    "vi": "Biến thành Chu Hòa Sơn đã chết"
  },
  {
    "idx": 9808,
    "start": "04:34:51,994",
    "end": "04:34:53,334",
    "start_sec": 16491.994,
    "end_sec": 16493.334,
    "zh": "大家就会自然的以为",
    "vi": "Mọi người sẽ tự nhiên cho rằng"
  },
  {
    "idx": 9809,
    "start": "04:34:53,334",
    "end": "04:34:54,254",
    "start_sec": 16493.334,
    "end_sec": 16494.254,
    "zh": "那就是你父亲",
    "vi": "Đó chính là cha của bạn"
  },
  {
    "idx": 9810,
    "start": "04:34:54,254",
    "end": "04:34:57,238",
    "start_sec": 16494.254,
    "end_sec": 16497.238,
    "zh": "鬼精的持有人非常重要的角色你这样做就是为了时刻保证自己在世间之外对吧常人潜意识里都会猜测周克山才是鬼精持有者是鬼一家狱的东西哪怕是刚刚你都在忽悠我",
    "vi": "Người nắm giữ quỷ tinh là một vai trò rất quan trọng bạn làm vậy"
  },
  {
    "idx": 9810,
    "start": "04:34:57,238",
    "end": "04:35:00,222",
    "start_sec": 16497.238,
    "end_sec": 16500.222,
    "zh": "鬼精的持有人非常重要的角色你这样做就是为了时刻保证自己在世间之外对吧常人潜意识里都会猜测周克山才是鬼精持有者是鬼一家狱的东西哪怕是刚刚你都在忽悠我",
    "vi": "là để luôn giữ mình nằm ngoài cuộc đúng không tiềm thức của người thường"
  },
  {
    "idx": 9810,
    "start": "04:35:00,222",
    "end": "04:35:03,007",
    "start_sec": 16500.222,
    "end_sec": 16503.007,
    "zh": "鬼精的持有人非常重要的角色你这样做就是为了时刻保证自己在世间之外对吧常人潜意识里都会猜测周克山才是鬼精持有者是鬼一家狱的东西哪怕是刚刚你都在忽悠我",
    "vi": "đều đoán rằng Chu Khắc Sơn mới là người giữ quỷ tinh là thứ"
  },
  {
    "idx": 9810,
    "start": "04:35:03,007",
    "end": "04:35:05,991",
    "start_sec": 16503.007,
    "end_sec": 16505.991,
    "zh": "鬼精的持有人非常重要的角色你这样做就是为了时刻保证自己在世间之外对吧常人潜意识里都会猜测周克山才是鬼精持有者是鬼一家狱的东西哪怕是刚刚你都在忽悠我",
    "vi": "thuộc về quỷ nhất gia ngục ngay cả vừa rồi bạn cũng đang lừa tôi"
  },
  {
    "idx": 9811,
    "start": "04:35:05,991",
    "end": "04:35:08,091",
    "start_sec": 16505.991,
    "end_sec": 16508.091,
    "zh": "这就是我刚刚为什么不对周克山动手",
    "vi": "Đó là lý do tại sao vừa rồi tôi không ra tay với Chu Khắc Sơn."
  },
  {
    "idx": 9812,
    "start": "04:35:08,091",
    "end": "04:35:09,651",
    "start_sec": 16508.091,
    "end_sec": 16509.651,
    "zh": "而是直接对你动手的原因",
    "vi": "Mà lại trực tiếp ra tay với bạn."
  },
  {
    "idx": 9813,
    "start": "04:35:09,651",
    "end": "04:35:13,551",
    "start_sec": 16509.651,
    "end_sec": 16513.551,
    "zh": "厉害啊程子皮",
    "vi": "Lợi hại thật đấy Trình Tử Bì."
  },
  {
    "idx": 9814,
    "start": "04:35:13,551",
    "end": "04:35:14,951",
    "start_sec": 16513.551,
    "end_sec": 16514.951,
    "zh": "不愧是我看上了你",
    "vi": "Không hổ danh là người tôi đã để mắt tới."
  },
  {
    "idx": 9815,
    "start": "04:35:14,951",
    "end": "04:35:17,131",
    "start_sec": 16514.951,
    "end_sec": 16517.131,
    "zh": "我就说我不会看走眼了",
    "vi": "Tôi đã nói là tôi không nhìn lầm người mà."
  },
  {
    "idx": 9816,
    "start": "04:35:17,131",
    "end": "04:35:18,431",
    "start_sec": 16517.131,
    "end_sec": 16518.431,
    "zh": "我就说我不会看走眼",
    "vi": "Tôi đã nói là tôi không nhìn lầm mà."
  },
  {
    "idx": 9817,
    "start": "04:35:18,431",
    "end": "04:35:21,351",
    "start_sec": 16518.431,
    "end_sec": 16521.351,
    "zh": "你和那些被我耍得团团转的人果然不一样",
    "vi": "Bạn quả nhiên khác với những kẻ bị tôi xoay như chong chóng ngoài kia."
  },
  {
    "idx": 9818,
    "start": "04:35:21,351",
    "end": "04:35:22,071",
    "start_sec": 16521.351,
    "end_sec": 16522.071,
    "zh": "说吧",
    "vi": "Nói đi."
  },
  {
    "idx": 9819,
    "start": "04:35:22,071",
    "end": "04:35:23,191",
    "start_sec": 16522.071,
    "end_sec": 16523.191,
    "zh": "你是什么时候怀疑我",
    "vi": "Bạn bắt đầu nghi ngờ tôi từ khi nào."
  },
  {
    "idx": 9820,
    "start": "04:35:23,191",
    "end": "04:35:25,131",
    "start_sec": 16523.191,
    "end_sec": 16525.131,
    "zh": "其实在你们喝牌酒之前",
    "vi": "Thật ra trước khi các người uống rượu phạt."
  },
  {
    "idx": 9821,
    "start": "04:35:25,131",
    "end": "04:35:26,811",
    "start_sec": 16525.131,
    "end_sec": 16526.811,
    "zh": "我都以为你老爹才是御鬼者",
    "vi": "Tôi vẫn luôn nghĩ cha của bạn mới là người ngự quỷ."
  },
  {
    "idx": 9822,
    "start": "04:35:26,811",
    "end": "04:35:28,331",
    "start_sec": 16526.811,
    "end_sec": 16528.331,
    "zh": "但黑狗血暴露了你们",
    "vi": "Nhưng máu chó đen đã làm lộ tẩy các người."
  },
  {
    "idx": 9823,
    "start": "04:35:28,331",
    "end": "04:35:29,451",
    "start_sec": 16528.331,
    "end_sec": 16529.451,
    "zh": "怎么说",
    "vi": "Nói thế nào đây."
  },
  {
    "idx": 9824,
    "start": "04:35:29,451",
    "end": "04:35:30,591",
    "start_sec": 16529.451,
    "end_sec": 16530.591,
    "zh": "你曾经和我说",
    "vi": "Bạn từng nói với tôi."
  },
  {
    "idx": 9825,
    "start": "04:35:30,591",
    "end": "04:35:32,771",
    "start_sec": 16530.591,
    "end_sec": 16532.771,
    "zh": "我做你的黑狗帮你躲过了不少诡异",
    "vi": "Tôi làm con chó đen của bạn giúp bạn tránh được không ít quỷ dị."
  },
  {
    "idx": 9826,
    "start": "04:35:32,771",
    "end": "04:35:33,971",
    "start_sec": 16532.771,
    "end_sec": 16533.971,
    "zh": "现在我细细想来",
    "vi": "Bây giờ tôi nghĩ kỹ lại."
  },
  {
    "idx": 9827,
    "start": "04:35:33,971",
    "end": "04:35:34,811",
    "start_sec": 16533.971,
    "end_sec": 16534.811,
    "zh": "你一个官二代",
    "vi": "Bạn là một cậu ấm."
  },
  {
    "idx": 9828,
    "start": "04:35:34,811",
    "end": "04:35:36,011",
    "start_sec": 16534.811,
    "end_sec": 16536.011,
    "zh": "又有三个御鬼者保护",
    "vi": "Lại có ba người ngự quỷ bảo vệ."
  },
  {
    "idx": 9829,
    "start": "04:35:36,011",
    "end": "04:35:37,311",
    "start_sec": 16536.011,
    "end_sec": 16537.311,
    "zh": "哪来那么多诡异碰见呢",
    "vi": "Lấy đâu ra nhiều quỷ dị để gặp như thế chứ."
  },
  {
    "idx": 9830,
    "start": "04:35:37,311",
    "end": "04:35:38,171",
    "start_sec": 16537.311,
    "end_sec": 16538.171,
    "zh": "真要有鬼",
    "vi": "Nếu thực sự có quỷ."
  },
  {
    "idx": 9831,
    "start": "04:35:38,171",
    "end": "04:35:39,431",
    "start_sec": 16538.171,
    "end_sec": 16539.431,
    "zh": "也是鬼精里的鬼吧",
    "vi": "Thì cũng là quỷ trong quỷ tinh thôi."
  },
  {
    "idx": 9832,
    "start": "04:35:39,431",
    "end": "04:35:41,851",
    "start_sec": 16539.431,
    "end_sec": 16541.851,
    "zh": "长者提起来的纸地上的红血杯",
    "vi": "Chén máu đỏ trên mặt đất."
  },
  {
    "idx": 9833,
    "start": "04:35:41,851",
    "end": "04:35:44,471",
    "start_sec": 16541.851,
    "end_sec": 16544.471,
    "zh": "这酒杯里不出意外是小墨鸡的血",
    "vi": "Trong chén rượu này không ngoài dự đoán chính là máu gà đen."
  },
  {
    "idx": 9834,
    "start": "04:35:44,471",
    "end": "04:35:45,811",
    "start_sec": 16544.471,
    "end_sec": 16545.811,
    "zh": "黑狗血能压制诡异",
    "vi": "Máu chó đen có thể trấn áp quỷ dị."
  },
  {
    "idx": 9835,
    "start": "04:35:45,811",
    "end": "04:35:47,091",
    "start_sec": 16545.811,
    "end_sec": 16547.091,
    "zh": "但也只是初期的诡异",
    "vi": "Nhưng cũng chỉ là quỷ dị thời kỳ đầu."
  },
  {
    "idx": 9836,
    "start": "04:35:47,091",
    "end": "04:35:48,791",
    "start_sec": 16547.091,
    "end_sec": 16548.791,
    "zh": "身为物战鬼本体的周河山",
    "vi": "Chu Hòa Sơn với tư cách là bản thể của quỷ vật."
  },
  {
    "idx": 9837,
    "start": "04:35:48,791",
    "end": "04:35:50,071",
    "start_sec": 16548.791,
    "end_sec": 16550.071,
    "zh": "就和你那些初期诡异",
    "vi": "Cũng giống như những quỷ dị thời kỳ đầu của bạn."
  },
  {
    "idx": 9838,
    "start": "04:35:50,071",
    "end": "04:35:51,071",
    "start_sec": 16550.071,
    "end_sec": 16551.071,
    "zh": "已经不惧怕这些",
    "vi": "Đã không còn sợ những thứ này nữa."
  },
  {
    "idx": 9839,
    "start": "04:35:51,071",
    "end": "04:35:52,231",
    "start_sec": 16551.071,
    "end_sec": 16552.231,
    "zh": "至于你为什么喝",
    "vi": "Còn về lý do tại sao bạn lại uống."
  },
  {
    "idx": 9840,
    "start": "04:35:52,231",
    "end": "04:35:53,071",
    "start_sec": 16552.231,
    "end_sec": 16553.071,
    "zh": "你是想看看",
    "vi": "Là vì bạn muốn xem thử."
  },
  {
    "idx": 9841,
    "start": "04:35:53,071",
    "end": "04:35:53,631",
    "start_sec": 16553.071,
    "end_sec": 16553.631,
    "zh": "飞龙鞋",
    "vi": "Giày Phi Long."
  },
  {
    "idx": 9842,
    "start": "04:35:53,631",
    "end": "04:35:54,631",
    "start_sec": 16553.631,
    "end_sec": 16554.631,
    "zh": "是不是还能压制鬼",
    "vi": "Có phải vẫn có thể áp chế quỷ."
  },
  {
    "idx": 9843,
    "start": "04:35:54,631",
    "end": "04:35:55,451",
    "start_sec": 16554.631,
    "end_sec": 16555.451,
    "zh": "是吧",
    "vi": "Đúng chứ."
  },
  {
    "idx": 9844,
    "start": "04:35:55,451",
    "end": "04:35:56,231",
    "start_sec": 16555.451,
    "end_sec": 16556.231,
    "zh": "你接小墨记",
    "vi": "Ngươi tiếp cận Tiểu Mặc Ký."
  },
  {
    "idx": 9845,
    "start": "04:35:56,231",
    "end": "04:35:58,071",
    "start_sec": 16556.231,
    "end_sec": 16558.071,
    "zh": "一开始就是想做这个实验",
    "vi": "Ngay từ đầu đã muốn làm thí nghiệm này."
  },
  {
    "idx": 9846,
    "start": "04:35:58,071",
    "end": "04:35:59,271",
    "start_sec": 16558.071,
    "end_sec": 16559.271,
    "zh": "只是我不肯加入你",
    "vi": "Chỉ là ta không chịu gia nhập với ngươi."
  },
  {
    "idx": 9847,
    "start": "04:35:59,271",
    "end": "04:36:00,031",
    "start_sec": 16559.271,
    "end_sec": 16560.031,
    "zh": "你就想到了",
    "vi": "Nên ngươi mới nghĩ ra."
  },
  {
    "idx": 9848,
    "start": "04:36:00,031",
    "end": "04:36:01,151",
    "start_sec": 16560.031,
    "end_sec": 16561.151,
    "zh": "用小墨记的尸体",
    "vi": "Dùng xác của Tiểu Mặc Ký."
  },
  {
    "idx": 9849,
    "start": "04:36:01,151",
    "end": "04:36:02,231",
    "start_sec": 16561.151,
    "end_sec": 16562.231,
    "zh": "设计坑害我",
    "vi": "Thiết kế để hãm hại ta."
  },
  {
    "idx": 9850,
    "start": "04:36:02,231",
    "end": "04:36:03,251",
    "start_sec": 16562.231,
    "end_sec": 16563.251,
    "zh": "厉害厉害",
    "vi": "Lợi hại, lợi hại."
  },
  {
    "idx": 9851,
    "start": "04:36:03,251",
    "end": "04:36:04,351",
    "start_sec": 16563.251,
    "end_sec": 16564.351,
    "zh": "我真没想到",
    "vi": "Ta thật không ngờ."
  },
  {
    "idx": 9852,
    "start": "04:36:04,351",
    "end": "04:36:04,911",
    "start_sec": 16564.351,
    "end_sec": 16564.911,
    "zh": "末日之前",
    "vi": "Trước ngày tận thế."
  },
  {
    "idx": 9853,
    "start": "04:36:04,911",
    "end": "04:36:06,331",
    "start_sec": 16564.911,
    "end_sec": 16566.331,
    "zh": "你随便找来寻乐的小食人",
    "vi": "Kẻ ăn người nhỏ bé mà ngươi tùy tiện tìm về để giải trí."
  },
  {
    "idx": 9854,
    "start": "04:36:06,331",
    "end": "04:36:07,111",
    "start_sec": 16566.331,
    "end_sec": 16567.111,
    "zh": "末日以后",
    "vi": "Sau ngày tận thế."
  },
  {
    "idx": 9855,
    "start": "04:36:07,111",
    "end": "04:36:08,071",
    "start_sec": 16567.111,
    "end_sec": 16568.071,
    "zh": "居然能和我较量",
    "vi": "Lại có thể đọ sức với ta."
  },
  {
    "idx": 9856,
    "start": "04:36:08,071",
    "end": "04:36:09,731",
    "start_sec": 16568.071,
    "end_sec": 16569.731,
    "zh": "你知道吗",
    "vi": "Ngươi có biết không."
  },
  {
    "idx": 9857,
    "start": "04:36:09,731",
    "end": "04:36:11,571",
    "start_sec": 16569.731,
    "end_sec": 16571.571,
    "zh": "当时你给我发短信求助",
    "vi": "Lúc đó ngươi nhắn tin cầu cứu ta."
  },
  {
    "idx": 9858,
    "start": "04:36:11,571",
    "end": "04:36:12,631",
    "start_sec": 16571.571,
    "end_sec": 16572.631,
    "zh": "我是不屑的",
    "vi": "Ta đã rất khinh bỉ."
  },
  {
    "idx": 9859,
    "start": "04:36:12,631",
    "end": "04:36:13,691",
    "start_sec": 16572.631,
    "end_sec": 16573.691,
    "zh": "你什么身份",
    "vi": "Ngươi là thân phận gì."
  },
  {
    "idx": 9860,
    "start": "04:36:13,691",
    "end": "04:36:14,571",
    "start_sec": 16573.691,
    "end_sec": 16574.571,
    "zh": "我什么地位",
    "vi": "Ta là địa vị gì."
  },
  {
    "idx": 9861,
    "start": "04:36:14,571",
    "end": "04:36:15,491",
    "start_sec": 16574.571,
    "end_sec": 16575.491,
    "zh": "但是",
    "vi": "Nhưng mà."
  },
  {
    "idx": 9862,
    "start": "04:36:15,491",
    "end": "04:36:17,251",
    "start_sec": 16575.491,
    "end_sec": 16577.251,
    "zh": "变故就出现在第三日",
    "vi": "Biến cố đã xảy ra vào ngày thứ ba."
  },
  {
    "idx": 9863,
    "start": "04:36:17,251",
    "end": "04:36:18,511",
    "start_sec": 16577.251,
    "end_sec": 16578.511,
    "zh": "老头子驾驭了鬼",
    "vi": "Ông già đó đã khống chế được quỷ."
  },
  {
    "idx": 9864,
    "start": "04:36:18,511",
    "end": "04:36:20,151",
    "start_sec": 16578.511,
    "end_sec": 16580.151,
    "zh": "老爹,怎么办?",
    "vi": "Bố ơi, phải làm sao đây."
  },
  {
    "idx": 9865,
    "start": "04:36:20,511",
    "end": "04:36:24,611",
    "start_sec": 16580.511,
    "end_sec": 16584.611,
    "zh": "阿阳,这鬼镜消耗太大,我撑不了多久,我们先进去。",
    "vi": "A Dương, tấm gương quỷ này tiêu hao quá lớn, bố không trụ được lâu đâu, chúng ta mau vào trong trước."
  },
  {
    "idx": 9866,
    "start": "04:36:29,631",
    "end": "04:36:32,891",
    "start_sec": 16589.631,
    "end_sec": 16592.891,
    "zh": "鬼医竟然怕黑狗,既然如此,客客。",
    "vi": "Quỷ y hóa ra lại sợ chó đen, đã như vậy thì, hắc hắc."
  },
  {
    "idx": 9867,
    "start": "04:36:35,271",
    "end": "04:36:36,431",
    "start_sec": 16595.271,
    "end_sec": 16596.431,
    "zh": "阿阳,你...",
    "vi": "A Dương, con."
  },
  {
    "idx": 9868,
    "start": "04:36:36,431",
    "end": "04:36:40,350",
    "start_sec": 16596.431,
    "end_sec": 16600.35,
    "zh": "老爹,反正你也撑不住,不如你去,你就当是为了我好,这样我不付任何代价,就能记住我,敬你。",
    "vi": "Bố à, dù sao bố cũng không trụ được nữa, chi bằng bố đi đi, bố cứ coi như là vì tốt"
  },
  {
    "idx": 9868,
    "start": "04:36:40,350",
    "end": "04:36:44,091",
    "start_sec": 16600.35,
    "end_sec": 16604.091,
    "zh": "老爹,反正你也撑不住,不如你去,你就当是为了我好,这样我不付任何代价,就能记住我,敬你。",
    "vi": "cho con đi, như vậy con không cần trả bất kỳ giá nào, vẫn có thể nhớ kỹ con, kính bố."
  },
  {
    "idx": 9869,
    "start": "04:36:44,611",
    "end": "04:36:45,651",
    "start_sec": 16604.611,
    "end_sec": 16605.651,
    "zh": "你个不孝子。",
    "vi": "Đồ nghịch tử này."
  },
  {
    "idx": 9870,
    "start": "04:36:48,511",
    "end": "04:36:51,071",
    "start_sec": 16608.511,
    "end_sec": 16611.071,
    "zh": "竟然被鬼镜反噬了",
    "vi": "Không ngờ lại bị gương quỷ phản phệ rồi."
  },
  {
    "idx": 9871,
    "start": "04:36:51,071",
    "end": "04:36:53,151",
    "start_sec": 16611.071,
    "end_sec": 16613.151,
    "zh": "该死的老东西还藏有后手",
    "vi": "Lão già chết tiệt kia vẫn còn giấu bài tẩy sao."
  },
  {
    "idx": 9872,
    "start": "04:36:53,151",
    "end": "04:36:53,871",
    "start_sec": 16613.151,
    "end_sec": 16613.871,
    "zh": "对了",
    "vi": "Đúng rồi."
  },
  {
    "idx": 9873,
    "start": "04:36:53,871",
    "end": "04:36:54,311",
    "start_sec": 16613.871,
    "end_sec": 16614.311,
    "zh": "黑狗",
    "vi": "Chó đen."
  },
  {
    "idx": 9874,
    "start": "04:36:54,311",
    "end": "04:36:55,711",
    "start_sec": 16614.311,
    "end_sec": 16615.711,
    "zh": "黑狗能抵抗鬼异",
    "vi": "Chó đen có thể chống lại quỷ dị."
  },
  {
    "idx": 9875,
    "start": "04:36:55,711",
    "end": "04:36:57,791",
    "start_sec": 16615.711,
    "end_sec": 16617.791,
    "zh": "那黑狗血一定能抵御反噬",
    "vi": "Vậy thì máu chó đen chắc chắn có thể chống lại sự phản phệ."
  },
  {
    "idx": 9876,
    "start": "04:36:57,791",
    "end": "04:37:04,591",
    "start_sec": 16617.791,
    "end_sec": 16624.591,
    "zh": "这是什么",
    "vi": "Đây là cái gì."
  },
  {
    "idx": 9877,
    "start": "04:37:04,591",
    "end": "04:37:05,791",
    "start_sec": 16624.591,
    "end_sec": 16625.791,
    "zh": "好像是一只鬼异",
    "vi": "Hình như là một con quỷ dị."
  },
  {
    "idx": 9878,
    "start": "04:37:05,791",
    "end": "04:37:06,871",
    "start_sec": 16625.791,
    "end_sec": 16626.871,
    "zh": "好好好",
    "vi": "Tốt tốt tốt."
  },
  {
    "idx": 9879,
    "start": "04:37:06,871",
    "end": "04:37:07,671",
    "start_sec": 16626.871,
    "end_sec": 16627.671,
    "zh": "牵住我眼",
    "vi": "Thu hút ánh nhìn của ta."
  },
  {
    "idx": 9880,
    "start": "04:37:07,671",
    "end": "04:37:09,211",
    "start_sec": 16627.671,
    "end_sec": 16629.211,
    "zh": "我现在掌控了鬼镜",
    "vi": "Bây giờ ta đã khống chế được gương quỷ."
  },
  {
    "idx": 9881,
    "start": "04:37:09,211",
    "end": "04:37:10,571",
    "start_sec": 16629.211,
    "end_sec": 16630.571,
    "zh": "还有黑狗血相助",
    "vi": "Lại có thêm máu chó đen trợ giúp."
  },
  {
    "idx": 9882,
    "start": "04:37:10,571",
    "end": "04:37:13,011",
    "start_sec": 16630.571,
    "end_sec": 16633.011,
    "zh": "正是融合第二只鬼异的最佳时机",
    "vi": "Đây chính là thời cơ tốt nhất để dung hợp con quỷ dị thứ hai."
  },
  {
    "idx": 9883,
    "start": "04:37:13,011",
    "end": "04:37:13,991",
    "start_sec": 16633.011,
    "end_sec": 16633.991,
    "zh": "在这末日里",
    "vi": "Trong thời mạt thế này."
  },
  {
    "idx": 9884,
    "start": "04:37:13,991",
    "end": "04:37:16,611",
    "start_sec": 16633.991,
    "end_sec": 16636.611,
    "zh": "我周扬早晚有一天会成为一方霸主",
    "vi": "Ta, Chu Dương, sớm muộn gì cũng sẽ trở thành bá chủ một phương."
  },
  {
    "idx": 9885,
    "start": "04:37:16,611",
    "end": "04:37:19,411",
    "start_sec": 16636.611,
    "end_sec": 16639.411,
    "zh": "你是兜市长的儿子兜阳",
    "vi": "Ngươi là Đô Dương, con trai của thị trưởng Đô phải không."
  },
  {
    "idx": 9886,
    "start": "04:37:19,411",
    "end": "04:37:21,731",
    "start_sec": 16639.411,
    "end_sec": 16641.731,
    "zh": "我们是御鬼者组织成员",
    "vi": "Chúng ta là thành viên của tổ chức Ngự Quỷ Giả."
  },
  {
    "idx": 9887,
    "start": "04:37:21,731",
    "end": "04:37:24,491",
    "start_sec": 16641.731,
    "end_sec": 16644.491,
    "zh": "奉命给你们父子上属光号邮轮",
    "vi": "Nhận lệnh đưa cha con các ngươi lên du thuyền Thự Quang."
  },
  {
    "idx": 9888,
    "start": "04:37:24,491",
    "end": "04:37:25,391",
    "start_sec": 16644.491,
    "end_sec": 16645.391,
    "zh": "叫上你老爹",
    "vi": "Hãy gọi cha của ngươi đi cùng."
  },
  {
    "idx": 9889,
    "start": "04:37:25,391",
    "end": "04:37:27,251",
    "start_sec": 16645.391,
    "end_sec": 16647.251,
    "zh": "跟我们回御鬼者基地",
    "vi": "Theo chúng ta về căn cứ Ngự Quỷ Giả."
  },
  {
    "idx": 9890,
    "start": "04:37:27,251",
    "end": "04:37:29,531",
    "start_sec": 16647.251,
    "end_sec": 16649.531,
    "zh": "什么狗屁御鬼者基地",
    "vi": "Căn cứ Ngự Quỷ Giả chó má gì chứ."
  },
  {
    "idx": 9891,
    "start": "04:37:29,531",
    "end": "04:37:30,671",
    "start_sec": 16649.531,
    "end_sec": 16650.671,
    "zh": "义父命令的口吻",
    "vi": "Lại dùng giọng điệu ra lệnh."
  },
  {
    "idx": 9892,
    "start": "04:37:30,671",
    "end": "04:37:32,811",
    "start_sec": 16650.671,
    "end_sec": 16652.811,
    "zh": "不过现在还不能和他们正面重出",
    "vi": "Nhưng bây giờ vẫn chưa thể xung đột trực diện với bọn họ."
  },
  {
    "idx": 9893,
    "start": "04:37:32,811",
    "end": "04:37:33,851",
    "start_sec": 16652.811,
    "end_sec": 16653.851,
    "zh": "还是得找机会",
    "vi": "Vẫn phải tìm cơ hội thôi."
  },
  {
    "idx": 9894,
    "start": "04:37:33,851",
    "end": "04:37:35,171",
    "start_sec": 16653.851,
    "end_sec": 16655.171,
    "zh": "至于死去的老爹",
    "vi": "Còn về người cha đã chết."
  },
  {
    "idx": 9895,
    "start": "04:37:35,171",
    "end": "04:37:36,751",
    "start_sec": 16655.171,
    "end_sec": 16656.751,
    "zh": "先让物账鬼伪装一下",
    "vi": "Cứ để Vật Chướng Quỷ ngụy trang một chút."
  },
  {
    "idx": 9896,
    "start": "04:37:36,751",
    "end": "04:37:37,771",
    "start_sec": 16656.751,
    "end_sec": 16657.771,
    "zh": "反正他们也不知道",
    "vi": "Dù sao bọn họ cũng không biết."
  },
  {
    "idx": 9897,
    "start": "04:37:37,771",
    "end": "04:37:39,091",
    "start_sec": 16657.771,
    "end_sec": 16659.091,
    "zh": "我爹之前是什么样子",
    "vi": "Trước đây cha ta trông như thế nào."
  },
  {
    "idx": 9898,
    "start": "04:37:39,091",
    "end": "04:37:42,771",
    "start_sec": 16659.091,
    "end_sec": 16662.771,
    "zh": "要加强物账鬼的能力",
    "vi": "Muốn tăng cường năng lực của Vật Chướng Quỷ."
  },
  {
    "idx": 9899,
    "start": "04:37:42,771",
    "end": "04:37:43,851",
    "start_sec": 16662.771,
    "end_sec": 16663.851,
    "zh": "就必须要吃人",
    "vi": "Thì bắt buộc phải ăn thịt người."
  },
  {
    "idx": 9900,
    "start": "04:37:43,851",
    "end": "04:37:45,011",
    "start_sec": 16663.851,
    "end_sec": 16665.011,
    "zh": "可以每吃一个人",
    "vi": "Có thể mỗi khi ăn một người."
  },
  {
    "idx": 9901,
    "start": "04:37:45,011",
    "end": "04:37:46,051",
    "start_sec": 16665.011,
    "end_sec": 16666.051,
    "zh": "就画画一只村村",
    "vi": "Chỉ cần vẽ ra một phân thân."
  },
  {
    "idx": 9902,
    "start": "04:37:46,051",
    "end": "04:37:48,191",
    "start_sec": 16666.051,
    "end_sec": 16668.191,
    "zh": "只是分身不具备灵智",
    "vi": "Chỉ là phân thân không có linh trí."
  },
  {
    "idx": 9903,
    "start": "04:37:48,191",
    "end": "04:37:49,031",
    "start_sec": 16668.191,
    "end_sec": 16669.031,
    "zh": "肯定会露出",
    "vi": "Chắc chắn sẽ sơ hở."
  },
  {
    "idx": 9904,
    "start": "04:37:49,031",
    "end": "04:37:49,971",
    "start_sec": 16669.031,
    "end_sec": 16669.971,
    "zh": "但也没关系",
    "vi": "Nhưng cũng không sao cả."
  },
  {
    "idx": 9905,
    "start": "04:37:49,971",
    "end": "04:37:51,151",
    "start_sec": 16669.971,
    "end_sec": 16671.151,
    "zh": "谁会怀疑到我身上",
    "vi": "Ai mà nghi ngờ ta được chứ."
  },
  {
    "idx": 9906,
    "start": "04:37:51,151",
    "end": "04:37:53,091",
    "start_sec": 16671.151,
    "end_sec": 16673.091,
    "zh": "那些有能力无智力的御鬼者们",
    "vi": "Những kẻ ngự quỷ có năng lực mà thiếu trí tuệ đó."
  },
  {
    "idx": 9907,
    "start": "04:37:53,091",
    "end": "04:37:54,791",
    "start_sec": 16673.091,
    "end_sec": 16674.791,
    "zh": "也只会怀疑是传下来的诡异吧",
    "vi": "Chỉ nghĩ đó là quỷ dị truyền lại mà thôi."
  },
  {
    "idx": 9908,
    "start": "04:37:54,791",
    "end": "04:37:58,471",
    "start_sec": 16674.791,
    "end_sec": 16678.471,
    "zh": "程子皮你知道吗",
    "vi": "Trình Tử Bì ngươi có biết không."
  },
  {
    "idx": 9909,
    "start": "04:37:58,471",
    "end": "04:37:59,911",
    "start_sec": 16678.471,
    "end_sec": 16679.911,
    "zh": "我离彻底掌控曙光号",
    "vi": "Ta cách việc kiểm soát hoàn toàn tàu Thự Quang."
  },
  {
    "idx": 9910,
    "start": "04:37:59,911",
    "end": "04:38:00,891",
    "start_sec": 16679.911,
    "end_sec": 16680.891,
    "zh": "只差了最后一步",
    "vi": "Chỉ còn thiếu bước cuối cùng."
  },
  {
    "idx": 9911,
    "start": "04:38:00,891",
    "end": "04:38:02,091",
    "start_sec": 16680.891,
    "end_sec": 16682.091,
    "zh": "可偏偏这时候",
    "vi": "Vậy mà đúng lúc này."
  },
  {
    "idx": 9912,
    "start": "04:38:02,091",
    "end": "04:38:03,331",
    "start_sec": 16682.091,
    "end_sec": 16683.331,
    "zh": "你却上船了",
    "vi": "Ngươi lại lên tàu."
  },
  {
    "idx": 9913,
    "start": "04:38:03,331",
    "end": "04:38:04,891",
    "start_sec": 16683.331,
    "end_sec": 16684.891,
    "zh": "我是万万没想到",
    "vi": "Ta thật sự không ngờ tới."
  },
  {
    "idx": 9914,
    "start": "04:38:04,891",
    "end": "04:38:06,951",
    "start_sec": 16684.891,
    "end_sec": 16686.951,
    "zh": "我不过是随便搭理了你几次",
    "vi": "Ta chỉ tùy tiện đáp lại ngươi vài câu."
  },
  {
    "idx": 9915,
    "start": "04:38:06,951",
    "end": "04:38:09,011",
    "start_sec": 16686.951,
    "end_sec": 16689.011,
    "zh": "你居然是一步一步的走到我眼前",
    "vi": "Ngươi vậy mà từng bước đi đến trước mặt ta."
  },
  {
    "idx": 9916,
    "start": "04:38:09,011",
    "end": "04:38:10,451",
    "start_sec": 16689.011,
    "end_sec": 16690.451,
    "zh": "你是个人才啊",
    "vi": "Ngươi đúng là một nhân tài."
  },
  {
    "idx": 9917,
    "start": "04:38:10,451",
    "end": "04:38:11,691",
    "start_sec": 16690.451,
    "end_sec": 16691.691,
    "zh": "程子皮",
    "vi": "Trình Tử Bì."
  },
  {
    "idx": 9918,
    "start": "04:38:11,691",
    "end": "04:38:12,731",
    "start_sec": 16691.691,
    "end_sec": 16692.731,
    "zh": "加入我",
    "vi": "Hãy gia nhập với ta."
  },
  {
    "idx": 9919,
    "start": "04:38:12,731",
    "end": "04:38:13,651",
    "start_sec": 16692.731,
    "end_sec": 16693.651,
    "zh": "否则",
    "vi": "Nếu không thì."
  },
  {
    "idx": 9920,
    "start": "04:38:13,651",
    "end": "04:38:16,871",
    "start_sec": 16693.651,
    "end_sec": 16696.871,
    "zh": "橙子皮看着周扬",
    "vi": "Trình Tử Bì nhìn Chu Dương."
  },
  {
    "idx": 9921,
    "start": "04:38:16,871",
    "end": "04:38:17,991",
    "start_sec": 16696.871,
    "end_sec": 16697.991,
    "zh": "心里无畏达成",
    "vi": "Trong lòng không chút sợ hãi."
  },
  {
    "idx": 9922,
    "start": "04:38:17,991",
    "end": "04:38:18,871",
    "start_sec": 16697.991,
    "end_sec": 16698.871,
    "zh": "周扬啊",
    "vi": "Chu Dương à."
  },
  {
    "idx": 9923,
    "start": "04:38:18,871",
    "end": "04:38:19,811",
    "start_sec": 16698.871,
    "end_sec": 16699.811,
    "zh": "你不是当演员",
    "vi": "Ngươi không đi làm diễn viên."
  },
  {
    "idx": 9924,
    "start": "04:38:19,811",
    "end": "04:38:20,531",
    "start_sec": 16699.811,
    "end_sec": 16700.531,
    "zh": "可惜了",
    "vi": "Thật là đáng tiếc."
  },
  {
    "idx": 9925,
    "start": "04:38:20,531",
    "end": "04:38:21,351",
    "start_sec": 16700.531,
    "end_sec": 16701.351,
    "zh": "不得不说",
    "vi": "Phải nói rằng."
  },
  {
    "idx": 9926,
    "start": "04:38:21,351",
    "end": "04:38:22,291",
    "start_sec": 16701.351,
    "end_sec": 16702.291,
    "zh": "无论手段",
    "vi": "Dù là thủ đoạn."
  },
  {
    "idx": 9927,
    "start": "04:38:22,291",
    "end": "04:38:22,791",
    "start_sec": 16702.291,
    "end_sec": 16702.791,
    "zh": "智慧",
    "vi": "Trí tuệ."
  },
  {
    "idx": 9928,
    "start": "04:38:22,791",
    "end": "04:38:23,371",
    "start_sec": 16702.791,
    "end_sec": 16703.371,
    "zh": "才华",
    "vi": "Hay tài năng."
  },
  {
    "idx": 9929,
    "start": "04:38:23,371",
    "end": "04:38:24,751",
    "start_sec": 16703.371,
    "end_sec": 16704.751,
    "zh": "你都是一等一的天才",
    "vi": "Ngươi đều là thiên tài hạng nhất."
  },
  {
    "idx": 9930,
    "start": "04:38:24,751",
    "end": "04:38:26,091",
    "start_sec": 16704.751,
    "end_sec": 16706.091,
    "zh": "要不是我能联系过去",
    "vi": "Nếu không phải ta có thể liên lạc với quá khứ."
  },
  {
    "idx": 9931,
    "start": "04:38:26,091",
    "end": "04:38:27,251",
    "start_sec": 16706.091,
    "end_sec": 16707.251,
    "zh": "早被你玩死了",
    "vi": "Đã sớm bị bạn chơi chết rồi."
  },
  {
    "idx": 9932,
    "start": "04:38:27,251",
    "end": "04:38:29,151",
    "start_sec": 16707.251,
    "end_sec": 16709.151,
    "zh": "你才是最大的保持啊",
    "vi": "Bạn mới là trùm cuối đáng sợ nhất đấy."
  },
  {
    "idx": 9933,
    "start": "04:38:29,151",
    "end": "04:38:30,551",
    "start_sec": 16709.151,
    "end_sec": 16710.551,
    "zh": "坐在橙子皮说话间",
    "vi": "Trong lúc Trần Tử Bì đang nói chuyện."
  },
  {
    "idx": 9934,
    "start": "04:38:30,551",
    "end": "04:38:32,611",
    "start_sec": 16710.551,
    "end_sec": 16712.611,
    "zh": "故障鬼开始分裂",
    "vi": "Con quỷ lỗi bắt đầu phân tách."
  },
  {
    "idx": 9935,
    "start": "04:38:32,611",
    "end": "04:38:34,391",
    "start_sec": 16712.611,
    "end_sec": 16714.391,
    "zh": "伴随数量越分裂越多",
    "vi": "Cùng với số lượng phân tách ngày càng nhiều."
  },
  {
    "idx": 9936,
    "start": "04:38:34,391",
    "end": "04:38:35,331",
    "start_sec": 16714.391,
    "end_sec": 16715.331,
    "zh": "橙子皮知道",
    "vi": "Trần Tử Bì biết rằng."
  },
  {
    "idx": 9937,
    "start": "04:38:35,331",
    "end": "04:38:36,331",
    "start_sec": 16715.331,
    "end_sec": 16716.331,
    "zh": "他如何逃避",
    "vi": "Dù bản thân có trốn tránh thế nào."
  },
  {
    "idx": 9938,
    "start": "04:38:36,331",
    "end": "04:38:37,171",
    "start_sec": 16716.331,
    "end_sec": 16717.171,
    "zh": "已经没有了你",
    "vi": "Cũng đã không còn đường lui nữa."
  },
  {
    "idx": 9939,
    "start": "04:38:37,171",
    "end": "04:38:38,291",
    "start_sec": 16717.171,
    "end_sec": 16718.291,
    "zh": "他咧嘴笑了笑",
    "vi": "Cậu ấy nhếch mép cười."
  },
  {
    "idx": 9940,
    "start": "04:38:38,291",
    "end": "04:38:39,291",
    "start_sec": 16718.291,
    "end_sec": 16719.291,
    "zh": "找到不可别的",
    "vi": "Tìm kiếm điều không thể tránh khỏi."
  },
  {
    "idx": 9941,
    "start": "04:38:39,291",
    "end": "04:38:40,731",
    "start_sec": 16719.291,
    "end_sec": 16720.731,
    "zh": "什么联系过去",
    "vi": "Để liên kết với quá khứ."
  },
  {
    "idx": 9942,
    "start": "04:38:40,731",
    "end": "04:38:42,211",
    "start_sec": 16720.731,
    "end_sec": 16722.211,
    "zh": "橙子皮你在说什么",
    "vi": "Trần Tử Bì, bạn đang nói cái gì thế."
  },
  {
    "idx": 9943,
    "start": "04:38:42,211",
    "end": "04:38:42,811",
    "start_sec": 16722.211,
    "end_sec": 16722.811,
    "zh": "为什么",
    "vi": "Tại sao."
  },
  {
    "idx": 9944,
    "start": "04:38:42,811",
    "end": "04:38:44,891",
    "start_sec": 16722.811,
    "end_sec": 16724.891,
    "zh": "我从你眼里看不到一丝害怕",
    "vi": "Tôi không nhìn thấy một chút sợ hãi nào trong mắt bạn."
  },
  {
    "idx": 9945,
    "start": "04:38:44,891",
    "end": "04:38:47,251",
    "start_sec": 16724.891,
    "end_sec": 16727.251,
    "zh": "长子皮以为深藏的看向周扬",
    "vi": "Trần Tử Bì nhìn Chu Dương với ánh mắt đầy ẩn ý."
  },
  {
    "idx": 9946,
    "start": "04:38:47,251",
    "end": "04:38:48,991",
    "start_sec": 16727.251,
    "end_sec": 16728.991,
    "zh": "或许就像你说的",
    "vi": "Có lẽ giống như bạn đã nói."
  },
  {
    "idx": 9947,
    "start": "04:38:48,991",
    "end": "04:38:51,371",
    "start_sec": 16728.991,
    "end_sec": 16731.371,
    "zh": "我跟着你能得到最快速度的成长",
    "vi": "Tôi đi theo bạn sẽ có được sự trưởng thành nhanh nhất."
  },
  {
    "idx": 9948,
    "start": "04:38:51,371",
    "end": "04:38:52,931",
    "start_sec": 16731.371,
    "end_sec": 16732.931,
    "zh": "但是不好意思啊",
    "vi": "Nhưng thật xin lỗi nhé."
  },
  {
    "idx": 9949,
    "start": "04:38:52,931",
    "end": "04:38:53,291",
    "start_sec": 16732.931,
    "end_sec": 16733.291,
    "zh": "周扬",
    "vi": "Chu Dương."
  },
  {
    "idx": 9950,
    "start": "04:38:53,291",
    "end": "04:38:54,391",
    "start_sec": 16733.291,
    "end_sec": 16734.391,
    "zh": "你有你的秘密",
    "vi": "Bạn có bí mật của bạn."
  },
  {
    "idx": 9951,
    "start": "04:38:54,391",
    "end": "04:38:55,371",
    "start_sec": 16734.391,
    "end_sec": 16735.371,
    "zh": "我也有我的秘密",
    "vi": "Tôi cũng có bí mật của tôi."
  },
  {
    "idx": 9952,
    "start": "04:38:55,371",
    "end": "04:38:57,271",
    "start_sec": 16735.371,
    "end_sec": 16737.271,
    "zh": "我们是不可能合作的",
    "vi": "Chúng ta không thể nào hợp tác được."
  },
  {
    "idx": 9953,
    "start": "04:38:57,271",
    "end": "04:38:57,991",
    "start_sec": 16737.271,
    "end_sec": 16737.991,
    "zh": "再见了",
    "vi": "Tạm biệt nhé."
  },
  {
    "idx": 9954,
    "start": "04:38:57,991",
    "end": "04:38:58,831",
    "start_sec": 16737.991,
    "end_sec": 16738.831,
    "zh": "周扬",
    "vi": "Chu Dương."
  },
  {
    "idx": 9955,
    "start": "04:38:58,831",
    "end": "04:39:00,291",
    "start_sec": 16738.831,
    "end_sec": 16740.291,
    "zh": "不是",
    "vi": "Không phải chứ."
  },
  {
    "idx": 9956,
    "start": "04:39:00,291",
    "end": "04:39:01,211",
    "start_sec": 16740.291,
    "end_sec": 16741.211,
    "zh": "什么情况",
    "vi": "Chuyện gì thế này."
  },
  {
    "idx": 9957,
    "start": "04:39:01,211",
    "end": "04:39:02,651",
    "start_sec": 16741.211,
    "end_sec": 16742.651,
    "zh": "我没眼花吧",
    "vi": "Tôi không nhìn lầm đấy chứ."
  },
  {
    "idx": 9958,
    "start": "04:39:02,651",
    "end": "04:39:02,871",
    "start_sec": 16742.651,
    "end_sec": 16742.871,
    "zh": "他",
    "vi": "Cậu ấy."
  },
  {
    "idx": 9959,
    "start": "04:39:02,871",
    "end": "04:39:04,351",
    "start_sec": 16742.871,
    "end_sec": 16744.351,
    "zh": "他跳下去了",
    "vi": "Cậu ấy nhảy xuống rồi."
  },
  {
    "idx": 9960,
    "start": "04:39:04,351",
    "end": "04:39:06,551",
    "start_sec": 16744.351,
    "end_sec": 16746.551,
    "zh": "就连一旁还在分裂的日上鬼",
    "vi": "Ngay cả con quỷ mặt trời bên cạnh vẫn đang phân tách."
  },
  {
    "idx": 9961,
    "start": "04:39:06,551",
    "end": "04:39:07,471",
    "start_sec": 16746.551,
    "end_sec": 16747.471,
    "zh": "也有点猛逼",
    "vi": "Cũng hơi liều đấy"
  },
  {
    "idx": 9962,
    "start": "04:39:07,471",
    "end": "04:39:08,611",
    "start_sec": 16747.471,
    "end_sec": 16748.611,
    "zh": "什么意思",
    "vi": "Ý gì vậy"
  },
  {
    "idx": 9963,
    "start": "04:39:08,611",
    "end": "04:39:09,531",
    "start_sec": 16748.611,
    "end_sec": 16749.531,
    "zh": "什么路数",
    "vi": "Chơi trò gì thế"
  },
  {
    "idx": 9964,
    "start": "04:39:09,531",
    "end": "04:39:11,231",
    "start_sec": 16749.531,
    "end_sec": 16751.231,
    "zh": "跑路也不能往湖里跑",
    "vi": "Bỏ chạy cũng đừng chạy xuống hồ"
  },
  {
    "idx": 9965,
    "start": "04:39:11,231",
    "end": "04:39:12,271",
    "start_sec": 16751.231,
    "end_sec": 16752.271,
    "zh": "他不会",
    "vi": "Anh ta sẽ không"
  },
  {
    "idx": 9966,
    "start": "04:39:12,271",
    "end": "04:39:13,091",
    "start_sec": 16752.271,
    "end_sec": 16753.091,
    "zh": "自杀了吧",
    "vi": "Tự sát đấy chứ"
  },
  {
    "idx": 9967,
    "start": "04:39:13,091",
    "end": "04:39:14,391",
    "start_sec": 16753.091,
    "end_sec": 16754.391,
    "zh": "静静看着胡明",
    "vi": "Tôi lặng lẽ nhìn Hồ Minh"
  },
  {
    "idx": 9968,
    "start": "04:39:14,391",
    "end": "04:39:15,391",
    "start_sec": 16754.391,
    "end_sec": 16755.391,
    "zh": "直到他的鼓里",
    "vi": "Cho đến khi trong trống của anh ta"
  },
  {
    "idx": 9969,
    "start": "04:39:15,391",
    "end": "04:39:16,171",
    "start_sec": 16755.391,
    "end_sec": 16756.171,
    "zh": "不凡黑影",
    "vi": "Một bóng đen bất thường"
  },
  {
    "idx": 9970,
    "start": "04:39:16,171",
    "end": "04:39:17,111",
    "start_sec": 16756.171,
    "end_sec": 16757.111,
    "zh": "将长嘴皮",
    "vi": "Kéo cái mỏ dài"
  },
  {
    "idx": 9971,
    "start": "04:39:17,111",
    "end": "04:39:18,191",
    "start_sec": 16757.111,
    "end_sec": 16758.191,
    "zh": "彻底拉着身体",
    "vi": "Kéo cả người"
  },
  {
    "idx": 9972,
    "start": "04:39:18,191",
    "end": "04:39:20,111",
    "start_sec": 16758.191,
    "end_sec": 16760.111,
    "zh": "周阳还忍不住骂一句",
    "vi": "Chu Dương còn không nhịn được chửi"
  },
  {
    "idx": 9973,
    "start": "04:39:20,111",
    "end": "04:39:20,511",
    "start_sec": 16760.111,
    "end_sec": 16760.511,
    "zh": "妈的",
    "vi": "Đệt"
  },
  {
    "idx": 9974,
    "start": "04:39:20,511",
    "end": "04:39:21,331",
    "start_sec": 16760.511,
    "end_sec": 16761.331,
    "zh": "什么傻逼",
    "vi": "Thằng ngu gì thế"
  },
  {
    "idx": 9975,
    "start": "04:39:21,331",
    "end": "04:39:22,271",
    "start_sec": 16761.331,
    "end_sec": 16762.271,
    "zh": "打不过就自杀",
    "vi": "Đánh không lại thì tự sát"
  },
  {
    "idx": 9976,
    "start": "04:39:22,851",
    "end": "04:39:29,871",
    "start_sec": 16762.851,
    "end_sec": 16769.871,
    "zh": "我说",
    "vi": "Tôi nói này"
  },
  {
    "idx": 9977,
    "start": "04:39:29,871",
    "end": "04:39:31,831",
    "start_sec": 16769.871,
    "end_sec": 16771.831,
    "zh": "不就是至于你杀了徐东来吗",
    "vi": "Có đáng để anh giết Từ Đông Lai không"
  },
  {
    "idx": 9978,
    "start": "04:39:31,831",
    "end": "04:39:32,851",
    "start_sec": 16771.831,
    "end_sec": 16772.851,
    "zh": "你至于这样吗",
    "vi": "Anh có cần phải thế không"
  },
  {
    "idx": 9979,
    "start": "04:39:32,851",
    "end": "04:39:33,691",
    "start_sec": 16772.851,
    "end_sec": 16773.691,
    "zh": "你看吧",
    "vi": "Thấy chưa"
  },
  {
    "idx": 9980,
    "start": "04:39:33,691",
    "end": "04:39:34,391",
    "start_sec": 16773.691,
    "end_sec": 16774.391,
    "zh": "你看吧",
    "vi": "Thấy chưa"
  },
  {
    "idx": 9981,
    "start": "04:39:34,391",
    "end": "04:39:35,651",
    "start_sec": 16774.391,
    "end_sec": 16775.651,
    "zh": "他就是有嫌疑",
    "vi": "Anh ta có nghi ngờ"
  },
  {
    "idx": 9982,
    "start": "04:39:35,651",
    "end": "04:39:37,091",
    "start_sec": 16775.651,
    "end_sec": 16777.091,
    "zh": "不然他喘气干嘛",
    "vi": "Nếu không thì anh ta thở hổn hển làm gì"
  },
  {
    "idx": 9983,
    "start": "04:39:37,091",
    "end": "04:39:38,351",
    "start_sec": 16777.091,
    "end_sec": 16778.351,
    "zh": "够了",
    "vi": "Đủ rồi"
  },
  {
    "idx": 9984,
    "start": "04:39:38,351",
    "end": "04:39:39,751",
    "start_sec": 16778.351,
    "end_sec": 16779.751,
    "zh": "刚刚我在他身上",
    "vi": "Lúc nãy tôi trên người anh ta"
  },
  {
    "idx": 9985,
    "start": "04:39:39,751",
    "end": "04:39:41,291",
    "start_sec": 16779.751,
    "end_sec": 16781.291,
    "zh": "没有搜到任何东西",
    "vi": "Không tìm thấy gì cả"
  },
  {
    "idx": 9986,
    "start": "04:39:41,291",
    "end": "04:39:43,711",
    "start_sec": 16781.291,
    "end_sec": 16783.711,
    "zh": "现在橙子皮你和我走",
    "vi": "Bây giờ Trần Tử Bì, anh đi với tôi"
  },
  {
    "idx": 9987,
    "start": "04:39:43,711",
    "end": "04:39:45,171",
    "start_sec": 16783.711,
    "end_sec": 16785.171,
    "zh": "我带你去见一个人",
    "vi": "Tôi dẫn anh đi gặp một người"
  },
  {
    "idx": 9988,
    "start": "04:39:45,171",
    "end": "04:39:46,331",
    "start_sec": 16785.171,
    "end_sec": 16786.331,
    "zh": "从地上爬起来",
    "vi": "Trèo dậy khỏi mặt đất đi"
  },
  {
    "idx": 9989,
    "start": "04:39:46,331",
    "end": "04:39:47,711",
    "start_sec": 16786.331,
    "end_sec": 16787.711,
    "zh": "橙子皮极力回旋",
    "vi": "Trần Tử Bì cố gắng xoay người"
  },
  {
    "idx": 9990,
    "start": "04:39:47,711",
    "end": "04:39:49,351",
    "start_sec": 16787.711,
    "end_sec": 16789.351,
    "zh": "这次的回到地点这么早",
    "vi": "Lần này về đích sớm thế"
  },
  {
    "idx": 9991,
    "start": "04:39:49,351",
    "end": "04:39:51,051",
    "start_sec": 16789.351,
    "end_sec": 16791.051,
    "zh": "竟然回到了刚上游泳的时候",
    "vi": "Không ngờ lại quay về lúc vừa mới lên tàu."
  },
  {
    "idx": 9992,
    "start": "04:39:51,051",
    "end": "04:39:52,791",
    "start_sec": 16791.051,
    "end_sec": 16792.791,
    "zh": "接下来要跟的是周扬",
    "vi": "Tiếp theo phải đi theo Chu Dương."
  },
  {
    "idx": 9993,
    "start": "04:39:52,791",
    "end": "04:39:54,891",
    "start_sec": 16792.791,
    "end_sec": 16794.891,
    "zh": "这次要谨慎应对每一步",
    "vi": "Lần này phải cẩn thận đối phó từng bước một."
  },
  {
    "idx": 9994,
    "start": "04:39:54,891",
    "end": "04:39:57,191",
    "start_sec": 16794.891,
    "end_sec": 16797.191,
    "zh": "023前辈",
    "vi": "Tiền bối 023."
  },
  {
    "idx": 9995,
    "start": "04:39:57,191",
    "end": "04:39:58,751",
    "start_sec": 16797.191,
    "end_sec": 16798.751,
    "zh": "我想把狗先放您这",
    "vi": "Tôi muốn gửi con chó ở chỗ tiền bối trước."
  },
  {
    "idx": 9996,
    "start": "04:39:58,751",
    "end": "04:39:59,771",
    "start_sec": 16798.751,
    "end_sec": 16799.771,
    "zh": "您看可以吗",
    "vi": "Tiền bối xem có được không."
  },
  {
    "idx": 9997,
    "start": "04:40:00,160",
    "end": "04:40:01,180",
    "start_sec": 16800.16,
    "end_sec": 16801.18,
    "zh": "为什么放我这",
    "vi": "Sao lại để ở chỗ tôi."
  },
  {
    "idx": 9998,
    "start": "04:40:01,180",
    "end": "04:40:02,340",
    "start_sec": 16801.18,
    "end_sec": 16802.34,
    "zh": "这个呀",
    "vi": "Cái này hả."
  },
  {
    "idx": 9999,
    "start": "04:40:02,340",
    "end": "04:40:03,720",
    "start_sec": 16802.34,
    "end_sec": 16803.72,
    "zh": "周扬他有吃狗肉的习惯",
    "vi": "Chu Dương có thói quen ăn thịt chó."
  },
  {
    "idx": 10000,
    "start": "04:40:03,720",
    "end": "04:40:05,120",
    "start_sec": 16803.72,
    "end_sec": 16805.12,
    "zh": "我不太敢带过去",
    "vi": "Tôi không dám mang nó theo."
  },
  {
    "idx": 10001,
    "start": "04:40:05,120",
    "end": "04:40:06,120",
    "start_sec": 16805.12,
    "end_sec": 16806.12,
    "zh": "哦 难怪",
    "vi": "Ồ hèn chi."
  },
  {
    "idx": 10002,
    "start": "04:40:06,120",
    "end": "04:40:07,780",
    "start_sec": 16806.12,
    "end_sec": 16807.78,
    "zh": "我说去他家的时候",
    "vi": "Tôi bảo lúc đến nhà cậu ta."
  },
  {
    "idx": 10003,
    "start": "04:40:07,780",
    "end": "04:40:10,000",
    "start_sec": 16807.78,
    "end_sec": 16810.0,
    "zh": "他那屋里一股子狗血气味呢",
    "vi": "Trong phòng cậu ta có mùi máu chó nồng nặc."
  },
  {
    "idx": 10004,
    "start": "04:40:10,520",
    "end": "04:40:13,840",
    "start_sec": 16810.52,
    "end_sec": 16813.84,
    "zh": "房门打开",
    "vi": "Cửa phòng mở ra."
  },
  {
    "idx": 10005,
    "start": "04:40:13,840",
    "end": "04:40:15,600",
    "start_sec": 16813.84,
    "end_sec": 16815.6,
    "zh": "一切如仿电影般重建",
    "vi": "Mọi thứ được tái hiện lại như trong phim."
  },
  {
    "idx": 10006,
    "start": "04:40:15,600",
    "end": "04:40:17,020",
    "start_sec": 16815.6,
    "end_sec": 16817.02,
    "zh": "哟 程子皮",
    "vi": "Ồ Trần Tử Bì."
  },
  {
    "idx": 10007,
    "start": "04:40:17,020",
    "end": "04:40:19,260",
    "start_sec": 16817.02,
    "end_sec": 16819.26,
    "zh": "你居然真能找到这上船啊",
    "vi": "Anh thực sự tìm được đường lên tàu sao."
  },
  {
    "idx": 10008,
    "start": "04:40:19,260",
    "end": "04:40:19,940",
    "start_sec": 16819.26,
    "end_sec": 16819.94,
    "zh": "出你的图",
    "vi": "Đưa bản đồ của anh ra đây."
  },
  {
    "idx": 10009,
    "start": "04:40:19,940",
    "end": "04:40:21,480",
    "start_sec": 16819.94,
    "end_sec": 16821.48,
    "zh": "我负了好大劲才跑出来",
    "vi": "Tôi phải tốn rất nhiều sức mới chạy thoát được."
  },
  {
    "idx": 10010,
    "start": "04:40:21,480",
    "end": "04:40:23,880",
    "start_sec": 16821.48,
    "end_sec": 16823.88,
    "zh": "能来到船上是靠小墨镜啊",
    "vi": "Lên được tàu là nhờ Tiểu Mặc Kính đó."
  },
  {
    "idx": 10011,
    "start": "04:40:23,880",
    "end": "04:40:24,440",
    "start_sec": 16823.88,
    "end_sec": 16824.44,
    "zh": "运气好",
    "vi": "May mắn thôi."
  },
  {
    "idx": 10012,
    "start": "04:40:24,440",
    "end": "04:40:26,180",
    "start_sec": 16824.44,
    "end_sec": 16826.18,
    "zh": "碰到了032和037",
    "vi": "Tôi gặp được 032 và 037."
  },
  {
    "idx": 10013,
    "start": "04:40:26,180",
    "end": "04:40:26,900",
    "start_sec": 16826.18,
    "end_sec": 16826.9,
    "zh": "带了我一路",
    "vi": "Họ đã dẫn tôi đi suốt chặng đường."
  },
  {
    "idx": 10014,
    "start": "04:40:26,900",
    "end": "04:40:27,940",
    "start_sec": 16826.9,
    "end_sec": 16827.94,
    "zh": "还有徐东来",
    "vi": "Còn có Từ Đông Lai nữa."
  },
  {
    "idx": 10015,
    "start": "04:40:27,940",
    "end": "04:40:29,240",
    "start_sec": 16827.94,
    "end_sec": 16829.24,
    "zh": "他也帮了我",
    "vi": "Anh ấy cũng đã giúp tôi."
  },
  {
    "idx": 10016,
    "start": "04:40:29,240",
    "end": "04:40:29,840",
    "start_sec": 16829.24,
    "end_sec": 16829.84,
    "zh": "不是",
    "vi": "Không phải chứ."
  },
  {
    "idx": 10017,
    "start": "04:40:29,840",
    "end": "04:40:31,860",
    "start_sec": 16829.84,
    "end_sec": 16831.86,
    "zh": "你这运气这么逆天吗",
    "vi": "Vận may của anh lại nghịch thiên thế sao."
  },
  {
    "idx": 10018,
    "start": "04:40:31,860",
    "end": "04:40:32,620",
    "start_sec": 16831.86,
    "end_sec": 16832.62,
    "zh": "对了",
    "vi": "Đúng rồi."
  },
  {
    "idx": 10019,
    "start": "04:40:32,620",
    "end": "04:40:33,420",
    "start_sec": 16832.62,
    "end_sec": 16833.42,
    "zh": "小墨记呢",
    "vi": "Tiểu Mặc Kính đâu rồi."
  },
  {
    "idx": 10020,
    "start": "04:40:33,420",
    "end": "04:40:34,700",
    "start_sec": 16833.42,
    "end_sec": 16834.7,
    "zh": "我可是听零二三说",
    "vi": "Tôi nghe 023 nói là."
  },
  {
    "idx": 10021,
    "start": "04:40:34,700",
    "end": "04:40:36,500",
    "start_sec": 16834.7,
    "end_sec": 16836.5,
    "zh": "有个牵着黑狗的家伙上墙了",
    "vi": "Có gã dắt theo con chó đen đã leo lên tường rồi."
  },
  {
    "idx": 10022,
    "start": "04:40:36,500",
    "end": "04:40:37,460",
    "start_sec": 16836.5,
    "end_sec": 16837.46,
    "zh": "才让他去帮你呢",
    "vi": "Mới bảo hắn đi giúp bạn đấy."
  },
  {
    "idx": 10023,
    "start": "04:40:37,460",
    "end": "04:40:38,540",
    "start_sec": 16837.46,
    "end_sec": 16838.54,
    "zh": "快把小墨记牵来",
    "vi": "Mau dắt Tiểu Mặc Ký tới đây."
  },
  {
    "idx": 10024,
    "start": "04:40:38,540",
    "end": "04:40:39,000",
    "start_sec": 16838.54,
    "end_sec": 16839.0,
    "zh": "我看看",
    "vi": "Để tôi xem nào."
  },
  {
    "idx": 10025,
    "start": "04:40:39,000",
    "end": "04:40:40,120",
    "start_sec": 16839.0,
    "end_sec": 16840.12,
    "zh": "小墨记啊",
    "vi": "Tiểu Mặc Ký à."
  },
  {
    "idx": 10026,
    "start": "04:40:40,120",
    "end": "04:40:41,200",
    "start_sec": 16840.12,
    "end_sec": 16841.2,
    "zh": "他这几天估计累了",
    "vi": "Mấy ngày nay chắc nó mệt rồi."
  },
  {
    "idx": 10027,
    "start": "04:40:41,200",
    "end": "04:40:42,920",
    "start_sec": 16841.2,
    "end_sec": 16842.92,
    "zh": "我拜托零二三带去休息了",
    "vi": "Tôi đã nhờ Linh Nhị Tam đưa nó đi nghỉ ngơi."
  },
  {
    "idx": 10028,
    "start": "04:40:42,920",
    "end": "04:40:44,520",
    "start_sec": 16842.92,
    "end_sec": 16844.52,
    "zh": "要不过两天",
    "vi": "Hay là đợi hai hôm nữa nhé."
  },
  {
    "idx": 10029,
    "start": "04:40:44,520",
    "end": "04:40:45,220",
    "start_sec": 16844.52,
    "end_sec": 16845.22,
    "zh": "这样啊",
    "vi": "Ra là vậy."
  },
  {
    "idx": 10030,
    "start": "04:40:45,220",
    "end": "04:40:45,680",
    "start_sec": 16845.22,
    "end_sec": 16845.68,
    "zh": "行吧",
    "vi": "Được thôi."
  },
  {
    "idx": 10031,
    "start": "04:40:45,680",
    "end": "04:40:47,280",
    "start_sec": 16845.68,
    "end_sec": 16847.28,
    "zh": "那咱哥俩好好唠唠",
    "vi": "Vậy anh em mình trò chuyện chút đi."
  },
  {
    "idx": 10032,
    "start": "04:40:47,280",
    "end": "04:40:48,080",
    "start_sec": 16847.28,
    "end_sec": 16848.08,
    "zh": "说起来",
    "vi": "Nhắc mới nhớ."
  },
  {
    "idx": 10033,
    "start": "04:40:48,080",
    "end": "04:40:48,980",
    "start_sec": 16848.08,
    "end_sec": 16848.98,
    "zh": "我还挺好奇",
    "vi": "Tôi cũng khá tò mò."
  },
  {
    "idx": 10034,
    "start": "04:40:48,980",
    "end": "04:40:50,660",
    "start_sec": 16848.98,
    "end_sec": 16850.66,
    "zh": "你怎么想着送我黑狗来的",
    "vi": "Sao bạn lại nghĩ đến việc tặng tôi con chó đen."
  },
  {
    "idx": 10035,
    "start": "04:40:50,660",
    "end": "04:40:51,980",
    "start_sec": 16850.66,
    "end_sec": 16851.98,
    "zh": "长者提议没有回答",
    "vi": "Trưởng bối đề nghị không có câu trả lời."
  },
  {
    "idx": 10036,
    "start": "04:40:51,980",
    "end": "04:40:52,760",
    "start_sec": 16851.98,
    "end_sec": 16852.76,
    "zh": "只能等房门",
    "vi": "Chỉ có thể đợi cửa phòng."
  },
  {
    "idx": 10037,
    "start": "04:40:52,760",
    "end": "04:40:53,620",
    "start_sec": 16852.76,
    "end_sec": 16853.62,
    "zh": "周大公子",
    "vi": "Chu đại công tử."
  },
  {
    "idx": 10038,
    "start": "04:40:53,620",
    "end": "04:40:54,820",
    "start_sec": 16853.62,
    "end_sec": 16854.82,
    "zh": "实在不好意思啊",
    "vi": "Thật sự rất ngại quá."
  },
  {
    "idx": 10039,
    "start": "04:40:54,820",
    "end": "04:40:56,260",
    "start_sec": 16854.82,
    "end_sec": 16856.26,
    "zh": "我好像还被他们怀疑",
    "vi": "Hình như tôi vẫn bị họ nghi ngờ."
  },
  {
    "idx": 10040,
    "start": "04:40:56,260",
    "end": "04:40:56,800",
    "start_sec": 16856.26,
    "end_sec": 16856.8,
    "zh": "要不",
    "vi": "Hay là."
  },
  {
    "idx": 10041,
    "start": "04:40:56,800",
    "end": "04:40:58,180",
    "start_sec": 16856.8,
    "end_sec": 16858.18,
    "zh": "你等我被他们问完话",
    "vi": "Bạn đợi tôi bị họ hỏi xong đã."
  },
  {
    "idx": 10042,
    "start": "04:40:58,180",
    "end": "04:40:59,140",
    "start_sec": 16858.18,
    "end_sec": 16859.14,
    "zh": "咱再来去救",
    "vi": "Rồi chúng ta hãy đi cứu."
  },
  {
    "idx": 10043,
    "start": "04:40:59,140",
    "end": "04:41:00,080",
    "start_sec": 16859.14,
    "end_sec": 16860.08,
    "zh": "那好吧",
    "vi": "Vậy cũng được."
  },
  {
    "idx": 10044,
    "start": "04:41:00,080",
    "end": "04:41:02,380",
    "start_sec": 16860.08,
    "end_sec": 16862.38,
    "zh": "重来一次",
    "vi": "Làm lại một lần nữa."
  },
  {
    "idx": 10045,
    "start": "04:41:02,380",
    "end": "04:41:03,880",
    "start_sec": 16862.38,
    "end_sec": 16863.88,
    "zh": "改变周扬对我的认知",
    "vi": "Thay đổi nhận thức của Chu Dương về tôi."
  },
  {
    "idx": 10046,
    "start": "04:41:03,880",
    "end": "04:41:06,320",
    "start_sec": 16863.88,
    "end_sec": 16866.32,
    "zh": "应该能平静的过完这一天了",
    "vi": "Chắc là có thể bình yên trải qua ngày hôm nay rồi."
  },
  {
    "idx": 10047,
    "start": "04:41:06,320",
    "end": "04:41:11,180",
    "start_sec": 16866.32,
    "end_sec": 16871.18,
    "zh": "橙子皮",
    "vi": "Trần Tử Bì."
  },
  {
    "idx": 10048,
    "start": "04:41:11,180",
    "end": "04:41:12,340",
    "start_sec": 16871.18,
    "end_sec": 16872.34,
    "zh": "24岁",
    "vi": "24 tuổi."
  },
  {
    "idx": 10049,
    "start": "04:41:12,340",
    "end": "04:41:13,080",
    "start_sec": 16872.34,
    "end_sec": 16873.08,
    "zh": "单身",
    "vi": "Độc thân."
  },
  {
    "idx": 10050,
    "start": "04:41:13,080",
    "end": "04:41:14,440",
    "start_sec": 16873.08,
    "end_sec": 16874.44,
    "zh": "别看我的档案了",
    "vi": "Đừng xem hồ sơ của tôi nữa."
  },
  {
    "idx": 10051,
    "start": "04:41:14,440",
    "end": "04:41:15,100",
    "start_sec": 16874.44,
    "end_sec": 16875.1,
    "zh": "直接说傻",
    "vi": "Nói thẳng ra là ngốc."
  },
  {
    "idx": 10052,
    "start": "04:41:15,100",
    "end": "04:41:16,320",
    "start_sec": 16875.1,
    "end_sec": 16876.32,
    "zh": "你不好奇",
    "vi": "Cậu không tò mò"
  },
  {
    "idx": 10053,
    "start": "04:41:16,320",
    "end": "04:41:17,920",
    "start_sec": 16876.32,
    "end_sec": 16877.92,
    "zh": "我为什么袭击你吗",
    "vi": "vì sao tôi lại tấn công cậu sao."
  },
  {
    "idx": 10054,
    "start": "04:41:17,920",
    "end": "04:41:19,380",
    "start_sec": 16877.92,
    "end_sec": 16879.38,
    "zh": "你怀疑我不是本人",
    "vi": "Cậu nghi ngờ tôi không phải chính chủ"
  },
  {
    "idx": 10055,
    "start": "04:41:19,380",
    "end": "04:41:20,220",
    "start_sec": 16879.38,
    "end_sec": 16880.22,
    "zh": "在试探我",
    "vi": "nên muốn thử tôi."
  },
  {
    "idx": 10056,
    "start": "04:41:20,220",
    "end": "04:41:20,940",
    "start_sec": 16880.22,
    "end_sec": 16880.94,
    "zh": "不是",
    "vi": "Không phải."
  },
  {
    "idx": 10057,
    "start": "04:41:20,940",
    "end": "04:41:21,620",
    "start_sec": 16880.94,
    "end_sec": 16881.62,
    "zh": "小子",
    "vi": "Nhóc con"
  },
  {
    "idx": 10058,
    "start": "04:41:21,620",
    "end": "04:41:22,540",
    "start_sec": 16881.62,
    "end_sec": 16882.54,
    "zh": "你怎么知道",
    "vi": "sao cậu biết được."
  },
  {
    "idx": 10059,
    "start": "04:41:22,540",
    "end": "04:41:23,840",
    "start_sec": 16882.54,
    "end_sec": 16883.84,
    "zh": "先不说这个",
    "vi": "Khoan nói chuyện đó đã"
  },
  {
    "idx": 10060,
    "start": "04:41:23,840",
    "end": "04:41:24,760",
    "start_sec": 16883.84,
    "end_sec": 16884.76,
    "zh": "船上的诡异",
    "vi": "thứ kỳ quái trên thuyền"
  },
  {
    "idx": 10061,
    "start": "04:41:24,760",
    "end": "04:41:25,820",
    "start_sec": 16884.76,
    "end_sec": 16885.82,
    "zh": "你觉得该怎么解决",
    "vi": "cậu nghĩ nên giải quyết thế nào."
  },
  {
    "idx": 10062,
    "start": "04:41:25,820",
    "end": "04:41:27,660",
    "start_sec": 16885.82,
    "end_sec": 16887.66,
    "zh": "船上有诡异",
    "vi": "Trên thuyền có thứ kỳ quái"
  },
  {
    "idx": 10063,
    "start": "04:41:27,660",
    "end": "04:41:28,480",
    "start_sec": 16887.66,
    "end_sec": 16888.48,
    "zh": "你也知道",
    "vi": "cậu cũng biết sao."
  },
  {
    "idx": 10064,
    "start": "04:41:28,480",
    "end": "04:41:30,360",
    "start_sec": 16888.48,
    "end_sec": 16890.36,
    "zh": "暂时还解决不了",
    "vi": "Tạm thời vẫn chưa giải quyết được."
  },
  {
    "idx": 10065,
    "start": "04:41:30,360",
    "end": "04:41:32,440",
    "start_sec": 16890.36,
    "end_sec": 16892.44,
    "zh": "橙子皮你的能力很特殊",
    "vi": "Trần Tử Bì, năng lực của cậu rất đặc biệt"
  },
  {
    "idx": 10066,
    "start": "04:41:32,440",
    "end": "04:41:34,720",
    "start_sec": 16892.44,
    "end_sec": 16894.72,
    "zh": "所以我想请你保护周家父子",
    "vi": "nên tôi muốn nhờ cậu bảo vệ cha con nhà họ Chu."
  },
  {
    "idx": 10067,
    "start": "04:41:34,720",
    "end": "04:41:35,680",
    "start_sec": 16894.72,
    "end_sec": 16895.68,
    "zh": "123",
    "vi": "Một hai ba."
  },
  {
    "idx": 10068,
    "start": "04:41:35,680",
    "end": "04:41:37,160",
    "start_sec": 16895.68,
    "end_sec": 16897.16,
    "zh": "为什么你就没想过",
    "vi": "Tại sao cậu lại chưa từng nghĩ tới"
  },
  {
    "idx": 10069,
    "start": "04:41:37,160",
    "end": "04:41:39,380",
    "start_sec": 16897.16,
    "end_sec": 16899.38,
    "zh": "如果鬼异变成了周家父子呢",
    "vi": "nếu thứ kỳ quái đã biến thành cha con nhà họ Chu thì sao."
  },
  {
    "idx": 10070,
    "start": "04:41:39,380",
    "end": "04:41:40,200",
    "start_sec": 16899.38,
    "end_sec": 16900.2,
    "zh": "他们",
    "vi": "Họ sao"
  },
  {
    "idx": 10071,
    "start": "04:41:40,200",
    "end": "04:41:42,100",
    "start_sec": 16900.2,
    "end_sec": 16902.1,
    "zh": "他们怎么可能是鬼异",
    "vi": "họ làm sao có thể là thứ kỳ quái được."
  },
  {
    "idx": 10072,
    "start": "04:41:42,100",
    "end": "04:41:44,240",
    "start_sec": 16902.1,
    "end_sec": 16904.24,
    "zh": "周家父子是我们三个御鬼",
    "vi": "Cha con nhà họ Chu là do ba ngự quỷ giả chúng ta"
  },
  {
    "idx": 10073,
    "start": "04:41:44,240",
    "end": "04:41:45,860",
    "start_sec": 16904.24,
    "end_sec": 16905.86,
    "zh": "这从周家救出来的",
    "vi": "cứu ra từ nhà họ Chu mà."
  },
  {
    "idx": 10074,
    "start": "04:41:45,860",
    "end": "04:41:48,060",
    "start_sec": 16905.86,
    "end_sec": 16908.06,
    "zh": "而且他们还当着我们的面",
    "vi": "Hơn nữa họ còn ở ngay trước mặt chúng ta"
  },
  {
    "idx": 10075,
    "start": "04:41:48,060",
    "end": "04:41:49,140",
    "start_sec": 16908.06,
    "end_sec": 16909.14,
    "zh": "开启了古镜",
    "vi": "mở ra chiếc gương cổ."
  },
  {
    "idx": 10076,
    "start": "04:41:49,140",
    "end": "04:41:50,280",
    "start_sec": 16909.14,
    "end_sec": 16910.28,
    "zh": "就凭这一点",
    "vi": "Chỉ dựa vào điểm này"
  },
  {
    "idx": 10077,
    "start": "04:41:50,280",
    "end": "04:41:51,980",
    "start_sec": 16910.28,
    "end_sec": 16911.98,
    "zh": "他们就不会是鬼异",
    "vi": "họ sẽ không thể là thứ kỳ quái được."
  },
  {
    "idx": 10078,
    "start": "04:41:51,980",
    "end": "04:41:53,040",
    "start_sec": 16911.98,
    "end_sec": 16913.04,
    "zh": "有没有可能",
    "vi": "Liệu có khả năng nào"
  },
  {
    "idx": 10079,
    "start": "04:41:53,040",
    "end": "04:41:53,800",
    "start_sec": 16913.04,
    "end_sec": 16913.8,
    "zh": "这父子俩",
    "vi": "hai cha con này"
  },
  {
    "idx": 10080,
    "start": "04:41:53,800",
    "end": "04:41:54,520",
    "start_sec": 16913.8,
    "end_sec": 16914.52,
    "zh": "一个是人",
    "vi": "một người là người"
  },
  {
    "idx": 10081,
    "start": "04:41:54,520",
    "end": "04:41:55,220",
    "start_sec": 16914.52,
    "end_sec": 16915.22,
    "zh": "一个是鬼",
    "vi": "một người là quỷ."
  },
  {
    "idx": 10082,
    "start": "04:41:55,220",
    "end": "04:41:56,060",
    "start_sec": 16915.22,
    "end_sec": 16916.06,
    "zh": "反正",
    "vi": "Dù sao thì"
  },
  {
    "idx": 10083,
    "start": "04:41:56,060",
    "end": "04:41:57,180",
    "start_sec": 16916.06,
    "end_sec": 16917.18,
    "zh": "有的都不了解他们",
    "vi": "chúng ta đều không hiểu rõ họ"
  },
  {
    "idx": 10084,
    "start": "04:41:57,180",
    "end": "04:41:58,820",
    "start_sec": 16917.18,
    "end_sec": 16918.82,
    "zh": "怎么会知道他们的真假呢",
    "vi": "làm sao biết được họ là thật hay giả."
  },
  {
    "idx": 10085,
    "start": "04:41:58,820",
    "end": "04:42:00,980",
    "start_sec": 16918.82,
    "end_sec": 16920.98,
    "zh": "这一点我倒是想到过",
    "vi": "Điểm này tôi cũng từng nghĩ tới."
  },
  {
    "idx": 10086,
    "start": "04:42:00,980",
    "end": "04:42:02,880",
    "start_sec": 16920.98,
    "end_sec": 16922.88,
    "zh": "那你刚刚和周扬接触",
    "vi": "Vậy lúc nãy anh tiếp xúc với Chu Dương"
  },
  {
    "idx": 10087,
    "start": "04:42:02,880",
    "end": "04:42:04,460",
    "start_sec": 16922.88,
    "end_sec": 16924.46,
    "zh": "有没有看出不对劲",
    "vi": "có nhận ra điều gì bất thường không."
  },
  {
    "idx": 10088,
    "start": "04:42:04,460",
    "end": "04:42:06,020",
    "start_sec": 16924.46,
    "end_sec": 16926.02,
    "zh": "周扬是本人",
    "vi": "Chu Dương là người thật."
  },
  {
    "idx": 10089,
    "start": "04:42:06,020",
    "end": "04:42:08,400",
    "start_sec": 16926.02,
    "end_sec": 16928.4,
    "zh": "要是他老爹不是呢",
    "vi": "Nhưng nếu cha của cậu ta không phải thì sao."
  },
  {
    "idx": 10090,
    "start": "04:42:08,400",
    "end": "04:42:09,480",
    "start_sec": 16928.4,
    "end_sec": 16929.48,
    "zh": "怎么可能",
    "vi": "Làm sao có thể chứ."
  },
  {
    "idx": 10091,
    "start": "04:42:09,480",
    "end": "04:42:11,940",
    "start_sec": 16929.48,
    "end_sec": 16931.94,
    "zh": "周赫山昨天才当着我们的面",
    "vi": "Hôm qua Chu Hách Sơn vừa mới trước mặt chúng ta"
  },
  {
    "idx": 10092,
    "start": "04:42:11,940",
    "end": "04:42:13,100",
    "start_sec": 16931.94,
    "end_sec": 16933.1,
    "zh": "开启了古镜",
    "vi": "mở ra chiếc gương cổ."
  },
  {
    "idx": 10093,
    "start": "04:42:13,100",
    "end": "04:42:14,560",
    "start_sec": 16933.1,
    "end_sec": 16934.56,
    "zh": "能打开古镜的人",
    "vi": "Người có thể mở gương cổ"
  },
  {
    "idx": 10094,
    "start": "04:42:14,560",
    "end": "04:42:16,180",
    "start_sec": 16934.56,
    "end_sec": 16936.18,
    "zh": "什么可能是诡异呢",
    "vi": "sao có thể là thứ kỳ quái được."
  },
  {
    "idx": 10095,
    "start": "04:42:16,180",
    "end": "04:42:17,020",
    "start_sec": 16936.18,
    "end_sec": 16937.02,
    "zh": "我问你",
    "vi": "Tôi hỏi anh"
  },
  {
    "idx": 10096,
    "start": "04:42:17,020",
    "end": "04:42:18,420",
    "start_sec": 16937.02,
    "end_sec": 16938.42,
    "zh": "当时开启古镜的时候",
    "vi": "lúc mở gương cổ khi đó"
  },
  {
    "idx": 10097,
    "start": "04:42:18,420",
    "end": "04:42:19,560",
    "start_sec": 16938.42,
    "end_sec": 16939.56,
    "zh": "周扬在场吗",
    "vi": "Chu Dương có mặt ở đó không."
  },
  {
    "idx": 10098,
    "start": "04:42:19,560",
    "end": "04:42:20,100",
    "start_sec": 16939.56,
    "end_sec": 16940.1,
    "zh": "不在",
    "vi": "Không có mặt."
  },
  {
    "idx": 10099,
    "start": "04:42:20,100",
    "end": "04:42:21,800",
    "start_sec": 16940.1,
    "end_sec": 16941.8,
    "zh": "古镜必须要引出了人",
    "vi": "Gương cổ bắt buộc phải có người"
  },
  {
    "idx": 10100,
    "start": "04:42:21,800",
    "end": "04:42:23,280",
    "start_sec": 16941.8,
    "end_sec": 16943.28,
    "zh": "本人在场才能开启了",
    "vi": "chính chủ có mặt mới mở được."
  },
  {
    "idx": 10101,
    "start": "04:42:23,280",
    "end": "04:42:24,820",
    "start_sec": 16943.28,
    "end_sec": 16944.82,
    "zh": "你这话什么意思",
    "vi": "Anh nói vậy là có ý gì."
  },
  {
    "idx": 10102,
    "start": "04:42:24,820",
    "end": "04:42:26,580",
    "start_sec": 16944.82,
    "end_sec": 16946.58,
    "zh": "假设周赫山是诡异",
    "vi": "Giả sử Chu Hách Sơn là thứ kỳ quái"
  },
  {
    "idx": 10103,
    "start": "04:42:26,580",
    "end": "04:42:27,840",
    "start_sec": 16946.58,
    "end_sec": 16947.84,
    "zh": "周扬才是禁止",
    "vi": "Chu Dương mới là cấm chế"
  },
  {
    "idx": 10104,
    "start": "04:42:27,840",
    "end": "04:42:29,660",
    "start_sec": 16947.84,
    "end_sec": 16949.66,
    "zh": "那么只要周扬心念一动",
    "vi": "vậy thì chỉ cần Chu Dương động niệm một cái"
  },
  {
    "idx": 10105,
    "start": "04:42:29,660",
    "end": "04:42:30,860",
    "start_sec": 16949.66,
    "end_sec": 16950.86,
    "zh": "禁止就能开启了吧",
    "vi": "cấm chế sẽ được mở ra đúng không."
  },
  {
    "idx": 10106,
    "start": "04:42:30,860",
    "end": "04:42:33,600",
    "start_sec": 16950.86,
    "end_sec": 16953.6,
    "zh": "你的意思是周家父子都有问题",
    "vi": "Ý anh là hai cha con nhà họ Chu đều có vấn đề."
  },
  {
    "idx": 10107,
    "start": "04:42:33,600",
    "end": "04:42:34,540",
    "start_sec": 16953.6,
    "end_sec": 16954.54,
    "zh": "不然呢",
    "vi": "Chứ còn gì nữa."
  },
  {
    "idx": 10108,
    "start": "04:42:34,540",
    "end": "04:42:36,140",
    "start_sec": 16954.54,
    "end_sec": 16956.14,
    "zh": "023邓大人行",
    "vi": "Đặng đại nhân."
  },
  {
    "idx": 10109,
    "start": "04:42:36,140",
    "end": "04:42:37,740",
    "start_sec": 16956.14,
    "end_sec": 16957.74,
    "zh": "如果程子皮所说是你",
    "vi": "Nếu những gì Trình Tử Bì nói là thật"
  },
  {
    "idx": 10110,
    "start": "04:42:37,740",
    "end": "04:42:40,280",
    "start_sec": 16957.74,
    "end_sec": 16960.28,
    "zh": "那么这个周扬和真命人毛不相同",
    "vi": "vậy thì Chu Dương này và người thật không giống nhau chút nào."
  },
  {
    "idx": 10111,
    "start": "04:42:40,280",
    "end": "04:42:41,680",
    "start_sec": 16960.28,
    "end_sec": 16961.68,
    "zh": "虽然你这么说",
    "vi": "Dù cậu nói như vậy."
  },
  {
    "idx": 10112,
    "start": "04:42:41,680",
    "end": "04:42:43,680",
    "start_sec": 16961.68,
    "end_sec": 16963.68,
    "zh": "但是没有确凿证据",
    "vi": "Nhưng nếu không có bằng chứng xác thực."
  },
  {
    "idx": 10113,
    "start": "04:42:43,680",
    "end": "04:42:46,560",
    "start_sec": 16963.68,
    "end_sec": 16966.56,
    "zh": "我们也不可能对周赫山和周扬动手",
    "vi": "Chúng ta cũng không thể ra tay với Chu Hách Sơn và Chu Dương."
  },
  {
    "idx": 10114,
    "start": "04:42:46,560",
    "end": "04:42:49,860",
    "start_sec": 16966.56,
    "end_sec": 16969.86,
    "zh": "毕竟他们是本次任务的关键保护对象",
    "vi": "Dù sao họ cũng là đối tượng bảo vệ quan trọng trong nhiệm vụ lần này."
  },
  {
    "idx": 10115,
    "start": "04:42:49,860",
    "end": "04:42:50,760",
    "start_sec": 16969.86,
    "end_sec": 16970.76,
    "zh": "我就知道",
    "vi": "Tôi biết ngay mà."
  },
  {
    "idx": 10116,
    "start": "04:42:50,760",
    "end": "04:42:52,140",
    "start_sec": 16970.76,
    "end_sec": 16972.14,
    "zh": "肯定说服不了你",
    "vi": "Chắc chắn là không thuyết phục được anh rồi."
  },
  {
    "idx": 10117,
    "start": "04:42:52,140",
    "end": "04:42:53,740",
    "start_sec": 16972.14,
    "end_sec": 16973.74,
    "zh": "我们这次交谈的时间很短",
    "vi": "Thời gian trò chuyện của chúng ta lần này rất ngắn."
  },
  {
    "idx": 10118,
    "start": "04:42:53,740",
    "end": "04:42:54,600",
    "start_sec": 16973.74,
    "end_sec": 16974.6,
    "zh": "应该来得及",
    "vi": "Chắc là vẫn kịp."
  },
  {
    "idx": 10119,
    "start": "04:42:54,600",
    "end": "04:42:56,700",
    "start_sec": 16974.6,
    "end_sec": 16976.7,
    "zh": "走 我带你去结壶",
    "vi": "Đi thôi, tôi đưa anh đi xem Kết Hồ."
  },
  {
    "idx": 10120,
    "start": "04:42:56,700",
    "end": "04:42:58,360",
    "start_sec": 16976.7,
    "end_sec": 16978.36,
    "zh": "结壶 什么结壶",
    "vi": "Kết Hồ. Kết Hồ gì chứ."
  },
  {
    "idx": 10121,
    "start": "04:42:58,360",
    "end": "04:42:59,500",
    "start_sec": 16978.36,
    "end_sec": 16979.5,
    "zh": "去船长室",
    "vi": "Đến phòng thuyền trưởng."
  },
  {
    "idx": 10122,
    "start": "04:42:59,500",
    "end": "04:43:00,200",
    "start_sec": 16979.5,
    "end_sec": 16980.2,
    "zh": "好吧",
    "vi": "Được rồi."
  },
  {
    "idx": 10123,
    "start": "04:43:00,200",
    "end": "04:43:03,940",
    "start_sec": 16980.2,
    "end_sec": 16983.94,
    "zh": "虽然不知道你小子为什么这么抵触周家父子",
    "vi": "Dù không biết tại sao cậu nhóc này lại bài xích cha con nhà họ Chu như vậy."
  },
  {
    "idx": 10124,
    "start": "04:43:03,940",
    "end": "04:43:06,340",
    "start_sec": 16983.94,
    "end_sec": 16986.34,
    "zh": "但是你的分析也不无道理",
    "vi": "Nhưng phân tích của cậu cũng không phải là không có lý."
  },
  {
    "idx": 10125,
    "start": "04:43:06,340",
    "end": "04:43:09,400",
    "start_sec": 16986.34,
    "end_sec": 16989.4,
    "zh": "我就去看看你小子到底葫芦里卖的什么药",
    "vi": "Tôi sẽ đi xem thử rốt cuộc trong hồ lô của cậu bán thuốc gì."
  },
  {
    "idx": 10126,
    "start": "04:43:09,400",
    "end": "04:43:11,200",
    "start_sec": 16989.4,
    "end_sec": 16991.2,
    "zh": "两人快速来到三楼船长室",
    "vi": "Cả hai nhanh chóng đi tới phòng thuyền trưởng ở tầng ba."
  },
  {
    "idx": 10127,
    "start": "04:43:11,200",
    "end": "04:43:12,520",
    "start_sec": 16991.2,
    "end_sec": 16992.52,
    "zh": "门锁依旧牢牢的",
    "vi": "Khóa cửa vẫn còn rất chặt."
  },
  {
    "idx": 10128,
    "start": "04:43:12,520",
    "end": "04:43:15,180",
    "start_sec": 16992.52,
    "end_sec": 16995.18,
    "zh": "看吧 小子 没人开门",
    "vi": "Thấy chưa cậu nhóc, không có ai mở cửa cả."
  },
  {
    "idx": 10129,
    "start": "04:43:15,180",
    "end": "04:43:17,680",
    "start_sec": 16995.18,
    "end_sec": 16997.68,
    "zh": "那不代表没有人从里面开门",
    "vi": "Điều đó không có nghĩa là không có ai mở cửa từ bên trong."
  },
  {
    "idx": 10130,
    "start": "04:43:17,680",
    "end": "04:43:19,400",
    "start_sec": 16997.68,
    "end_sec": 16999.4,
    "zh": "将船长室的大门打开",
    "vi": "Mở cánh cửa phòng thuyền trưởng ra."
  },
  {
    "idx": 10131,
    "start": "04:43:19,400",
    "end": "04:43:21,080",
    "start_sec": 16999.4,
    "end_sec": 17001.08,
    "zh": "两个小精英一共走进去",
    "vi": "Cả hai cùng nhau bước vào trong."
  },
  {
    "idx": 10132,
    "start": "04:43:21,080",
    "end": "04:43:24,260",
    "start_sec": 17001.08,
    "end_sec": 17004.26,
    "zh": "怎么回事 周赫山不在这里",
    "vi": "Chuyện gì thế này. Chu Hách Sơn không có ở đây."
  },
  {
    "idx": 10133,
    "start": "04:43:24,260",
    "end": "04:43:25,940",
    "start_sec": 17004.26,
    "end_sec": 17005.94,
    "zh": "看来是我对了",
    "vi": "Xem ra tôi đã đúng rồi."
  },
  {
    "idx": 10134,
    "start": "04:43:25,940",
    "end": "04:43:26,700",
    "start_sec": 17005.94,
    "end_sec": 17006.7,
    "zh": "这个时间点",
    "vi": "Vào thời điểm này."
  },
  {
    "idx": 10135,
    "start": "04:43:26,700",
    "end": "04:43:28,080",
    "start_sec": 17006.7,
    "end_sec": 17008.08,
    "zh": "周扬的确来了一次设定",
    "vi": "Chu Dương quả thực đã đến đây một chuyến."
  },
  {
    "idx": 10136,
    "start": "04:43:28,080",
    "end": "04:43:29,800",
    "start_sec": 17008.08,
    "end_sec": 17009.8,
    "zh": "而且是去了古镜的世界内部",
    "vi": "Hơn nữa còn đi vào bên trong thế giới của chiếc gương cổ."
  },
  {
    "idx": 10137,
    "start": "04:43:29,800",
    "end": "04:43:31,340",
    "start_sec": 17009.8,
    "end_sec": 17011.34,
    "zh": "长者提持了这口镜",
    "vi": "Người lớn tuổi cầm chiếc gương này lên."
  },
  {
    "idx": 10138,
    "start": "04:43:31,340",
    "end": "04:43:32,780",
    "start_sec": 17011.34,
    "end_sec": 17012.78,
    "zh": "带头朝着镜子走进",
    "vi": "Dẫn đầu đi về phía chiếc gương."
  },
  {
    "idx": 10139,
    "start": "04:43:32,780",
    "end": "04:43:33,820",
    "start_sec": 17012.78,
    "end_sec": 17013.82,
    "zh": "你过去干嘛",
    "vi": "Cậu đi qua đó làm gì."
  },
  {
    "idx": 10140,
    "start": "04:43:33,820",
    "end": "04:43:34,980",
    "start_sec": 17013.82,
    "end_sec": 17014.98,
    "zh": "没有使用者",
    "vi": "Khi không có người sử dụng."
  },
  {
    "idx": 10141,
    "start": "04:43:34,980",
    "end": "04:43:36,280",
    "start_sec": 17014.98,
    "end_sec": 17016.28,
    "zh": "镜子是关闭的",
    "vi": "Cái gương đang đóng"
  },
  {
    "idx": 10142,
    "start": "04:43:36,280",
    "end": "04:43:37,160",
    "start_sec": 17016.28,
    "end_sec": 17017.16,
    "zh": "你确定",
    "vi": "Anh chắc chứ"
  },
  {
    "idx": 10143,
    "start": "04:43:37,160",
    "end": "04:43:37,660",
    "start_sec": 17017.16,
    "end_sec": 17017.66,
    "zh": "说着",
    "vi": "Nói rồi"
  },
  {
    "idx": 10144,
    "start": "04:43:37,660",
    "end": "04:43:38,860",
    "start_sec": 17017.66,
    "end_sec": 17018.86,
    "zh": "长者提一只手",
    "vi": "Trưởng lão giơ một tay lên"
  },
  {
    "idx": 10145,
    "start": "04:43:38,860",
    "end": "04:43:40,380",
    "start_sec": 17018.86,
    "end_sec": 17020.38,
    "zh": "已经伸进镜面了",
    "vi": "Đã thò vào mặt gương rồi"
  },
  {
    "idx": 10146,
    "start": "04:43:40,380",
    "end": "04:43:40,700",
    "start_sec": 17020.38,
    "end_sec": 17020.7,
    "zh": "什么",
    "vi": "Cái gì"
  },
  {
    "idx": 10147,
    "start": "04:43:40,700",
    "end": "04:43:41,940",
    "start_sec": 17020.7,
    "end_sec": 17021.94,
    "zh": "这镜面通道",
    "vi": "Cái lối đi qua gương này"
  },
  {
    "idx": 10148,
    "start": "04:43:41,940",
    "end": "04:43:43,640",
    "start_sec": 17021.94,
    "end_sec": 17023.64,
    "zh": "难道是一直开放的",
    "vi": "Lẽ nào vẫn luôn mở"
  },
  {
    "idx": 10149,
    "start": "04:43:43,640",
    "end": "04:43:45,420",
    "start_sec": 17023.64,
    "end_sec": 17025.42,
    "zh": "这回你总算信我了吧",
    "vi": "Lần này anh tin tôi rồi chứ"
  },
  {
    "idx": 10150,
    "start": "04:43:45,420",
    "end": "04:43:46,220",
    "start_sec": 17025.42,
    "end_sec": 17026.22,
    "zh": "周扬身上",
    "vi": "Trên người Chu Dương"
  },
  {
    "idx": 10151,
    "start": "04:43:46,220",
    "end": "04:43:48,160",
    "start_sec": 17026.22,
    "end_sec": 17028.16,
    "zh": "有巫战鬼与鬼镜相互压制",
    "vi": "Có Vu chiến quỷ và Quỷ kính triệt tiêu lẫn nhau"
  },
  {
    "idx": 10152,
    "start": "04:43:48,160",
    "end": "04:43:49,680",
    "start_sec": 17028.16,
    "end_sec": 17029.68,
    "zh": "所以镜子一直开放",
    "vi": "Nên cái gương vẫn luôn mở"
  },
  {
    "idx": 10153,
    "start": "04:43:49,680",
    "end": "04:43:51,060",
    "start_sec": 17029.68,
    "end_sec": 17031.06,
    "zh": "他自身的消耗也极小",
    "vi": "Bản thân anh ta cũng tiêu hao rất ít"
  },
  {
    "idx": 10154,
    "start": "04:43:51,060",
    "end": "04:43:52,640",
    "start_sec": 17031.06,
    "end_sec": 17032.64,
    "zh": "巫战鬼又在迟迟吸收",
    "vi": "Vu chiến quỷ lại đang chậm rãi hấp thụ"
  },
  {
    "idx": 10155,
    "start": "04:43:52,640",
    "end": "04:43:53,920",
    "start_sec": 17032.64,
    "end_sec": 17033.92,
    "zh": "转换数额耗尽的乘客",
    "vi": "Số lượng hành khách đã chuyển hóa cạn kiệt"
  },
  {
    "idx": 10156,
    "start": "04:43:53,920",
    "end": "04:43:55,040",
    "start_sec": 17033.92,
    "end_sec": 17035.04,
    "zh": "与此供养本体",
    "vi": "Để cung cấp cho bản thể"
  },
  {
    "idx": 10157,
    "start": "04:43:55,040",
    "end": "04:43:56,100",
    "start_sec": 17035.04,
    "end_sec": 17036.1,
    "zh": "供给源源不断",
    "vi": "Nguồn cung cấp liên tục"
  },
  {
    "idx": 10158,
    "start": "04:43:56,100",
    "end": "04:43:57,260",
    "start_sec": 17036.1,
    "end_sec": 17037.26,
    "zh": "镜子持续开放",
    "vi": "Cái gương vẫn tiếp tục mở"
  },
  {
    "idx": 10159,
    "start": "04:43:57,260",
    "end": "04:43:59,100",
    "start_sec": 17037.26,
    "end_sec": 17039.1,
    "zh": "也方便物账鬼分身的持续出没",
    "vi": "Cũng tiện cho phân thân Vu chiến quỷ liên tục xuất hiện"
  },
  {
    "idx": 10160,
    "start": "04:43:59,100",
    "end": "04:44:00,520",
    "start_sec": 17039.1,
    "end_sec": 17040.52,
    "zh": "至于你一去检查鬼星",
    "vi": "Còn về việc anh đi kiểm tra Quỷ tinh"
  },
  {
    "idx": 10161,
    "start": "04:44:00,520",
    "end": "04:44:02,260",
    "start_sec": 17040.52,
    "end_sec": 17042.26,
    "zh": "周克山便装不作样走进去",
    "vi": "Chu Khắc Sơn giả trang đi vào"
  },
  {
    "idx": 10162,
    "start": "04:44:02,260",
    "end": "04:44:03,000",
    "start_sec": 17042.26,
    "end_sec": 17043.0,
    "zh": "你们也不知道",
    "vi": "Các bạn cũng không biết"
  },
  {
    "idx": 10163,
    "start": "04:44:03,000",
    "end": "04:44:04,180",
    "start_sec": 17043.0,
    "end_sec": 17044.18,
    "zh": "镜子开启和关闭",
    "vi": "Cái gương mở và đóng"
  },
  {
    "idx": 10164,
    "start": "04:44:04,180",
    "end": "04:44:05,160",
    "start_sec": 17044.18,
    "end_sec": 17045.16,
    "zh": "到底有什么区别",
    "vi": "Rốt cuộc có gì khác biệt"
  },
  {
    "idx": 10165,
    "start": "04:44:05,160",
    "end": "04:44:05,700",
    "start_sec": 17045.16,
    "end_sec": 17045.7,
    "zh": "对吧",
    "vi": "Đúng không"
  },
  {
    "idx": 10166,
    "start": "04:44:05,700",
    "end": "04:44:07,820",
    "start_sec": 17045.7,
    "end_sec": 17047.82,
    "zh": "所以答案就是这么简单",
    "vi": "Vậy nên đáp án đơn giản như vậy"
  },
  {
    "idx": 10167,
    "start": "04:44:07,820",
    "end": "04:44:08,920",
    "start_sec": 17047.82,
    "end_sec": 17048.92,
    "zh": "在你们身处局中",
    "vi": "Khi các bạn ở trong cuộc"
  },
  {
    "idx": 10168,
    "start": "04:44:08,920",
    "end": "04:44:10,100",
    "start_sec": 17048.92,
    "end_sec": 17050.1,
    "zh": "往往就是看不穿",
    "vi": "Thường là không nhìn thấu"
  },
  {
    "idx": 10169,
    "start": "04:44:10,100",
    "end": "04:44:12,080",
    "start_sec": 17050.1,
    "end_sec": 17052.08,
    "zh": "023望着长者旗的背影",
    "vi": "023 nhìn bóng lưng Trưởng lão rời đi"
  },
  {
    "idx": 10170,
    "start": "04:44:12,080",
    "end": "04:44:13,300",
    "start_sec": 17052.08,
    "end_sec": 17053.3,
    "zh": "一时间唆了一番",
    "vi": "Một lúc lâu mới hiểu ra"
  },
  {
    "idx": 10171,
    "start": "04:44:13,300",
    "end": "04:44:14,400",
    "start_sec": 17053.3,
    "end_sec": 17054.4,
    "zh": "小子",
    "vi": "Nhóc con"
  },
  {
    "idx": 10172,
    "start": "04:44:14,400",
    "end": "04:44:16,480",
    "start_sec": 17054.4,
    "end_sec": 17056.48,
    "zh": "加入我们玉髓者组织吧",
    "vi": "Tham gia tổ chức Ngọc Thạch của chúng ta đi"
  },
  {
    "idx": 10173,
    "start": "04:44:16,480",
    "end": "04:44:17,560",
    "start_sec": 17056.48,
    "end_sec": 17057.56,
    "zh": "先不说这事",
    "vi": "Tạm gác chuyện đó sang một bên"
  },
  {
    "idx": 10174,
    "start": "04:44:17,560",
    "end": "04:44:18,400",
    "start_sec": 17057.56,
    "end_sec": 17058.4,
    "zh": "当务之急",
    "vi": "Việc cấp bách"
  },
  {
    "idx": 10175,
    "start": "04:44:18,400",
    "end": "04:44:19,820",
    "start_sec": 17058.4,
    "end_sec": 17059.82,
    "zh": "还是先解决周家父子",
    "vi": "Là giải quyết cha con nhà họ Chu trước"
  },
  {
    "idx": 10176,
    "start": "04:44:19,820",
    "end": "04:44:20,960",
    "start_sec": 17059.82,
    "end_sec": 17060.96,
    "zh": "023点点头",
    "vi": "023 gật đầu"
  },
  {
    "idx": 10177,
    "start": "04:44:20,960",
    "end": "04:44:22,580",
    "start_sec": 17060.96,
    "end_sec": 17062.58,
    "zh": "这才打亮起古剑内容",
    "vi": "Rồi mới bật nội dung của thanh kiếm cổ"
  },
  {
    "idx": 10178,
    "start": "04:44:23,920",
    "end": "04:44:26,860",
    "start_sec": 17063.92,
    "end_sec": 17066.86,
    "zh": "原来这镜子里是这样的",
    "vi": "Thì ra bên trong gương là thế này"
  },
  {
    "idx": 10179,
    "start": "04:44:26,860",
    "end": "04:44:29,840",
    "start_sec": 17066.86,
    "end_sec": 17069.84,
    "zh": "话说橙子皮你是来过这里吗",
    "vi": "Nói mới nhớ, bạn Cam Tử Bì, bạn đã từng đến đây sao"
  },
  {
    "idx": 10180,
    "start": "04:44:29,840",
    "end": "04:44:31,340",
    "start_sec": 17069.84,
    "end_sec": 17071.34,
    "zh": "怎么这么熟悉呢",
    "vi": "Sao quen thuộc thế"
  },
  {
    "idx": 10181,
    "start": "04:44:31,340",
    "end": "04:44:32,220",
    "start_sec": 17071.34,
    "end_sec": 17072.22,
    "zh": "这个呀",
    "vi": "Cái này ấy hả"
  },
  {
    "idx": 10182,
    "start": "04:44:32,220",
    "end": "04:44:34,960",
    "start_sec": 17072.22,
    "end_sec": 17074.96,
    "zh": "我的我的蚕子鬼能感应到鬼在哪里",
    "vi": "Con sâu tơ của tôi có thể cảm nhận được ma quỷ ở đâu"
  },
  {
    "idx": 10183,
    "start": "04:44:34,960",
    "end": "04:44:36,080",
    "start_sec": 17074.96,
    "end_sec": 17076.08,
    "zh": "哦这样",
    "vi": "Ồ, ra vậy"
  },
  {
    "idx": 10184,
    "start": "04:44:36,080",
    "end": "04:44:37,900",
    "start_sec": 17076.08,
    "end_sec": 17077.9,
    "zh": "有着前两次的经验",
    "vi": "Với kinh nghiệm hai lần trước"
  },
  {
    "idx": 10185,
    "start": "04:44:37,900",
    "end": "04:44:39,460",
    "start_sec": 17077.9,
    "end_sec": 17079.46,
    "zh": "橙子皮带着零二分",
    "vi": "Cam Tử Bì dẫn theo Linh Nhị Phân"
  },
  {
    "idx": 10186,
    "start": "04:44:39,460",
    "end": "04:44:41,600",
    "start_sec": 17079.46,
    "end_sec": 17081.6,
    "zh": "很快来到树林尽头的湖河前",
    "vi": "Nhanh chóng đến bờ hồ cuối khu rừng"
  },
  {
    "idx": 10187,
    "start": "04:44:41,600",
    "end": "04:44:43,400",
    "start_sec": 17081.6,
    "end_sec": 17083.4,
    "zh": "哎真是无趣",
    "vi": "Haiz, thật nhàm chán"
  },
  {
    "idx": 10188,
    "start": "04:44:43,400",
    "end": "04:44:46,440",
    "start_sec": 17083.4,
    "end_sec": 17086.44,
    "zh": "本以为那个橙子皮能给我带来点什么乐趣",
    "vi": "Tôi đã nghĩ Cam Tử Bì sẽ mang lại chút thú vị gì đó cho tôi"
  },
  {
    "idx": 10189,
    "start": "04:44:46,440",
    "end": "04:44:48,160",
    "start_sec": 17086.44,
    "end_sec": 17088.16,
    "zh": "还以为他是个什么能人呢",
    "vi": "Cứ tưởng hắn là người tài giỏi gì chứ"
  },
  {
    "idx": 10190,
    "start": "04:44:48,160",
    "end": "04:44:51,680",
    "start_sec": 17088.16,
    "end_sec": 17091.68,
    "zh": "在鬼一降临前又是找福气又是买黑狗",
    "vi": "Trước khi ma quỷ xuất hiện, vừa tìm may mắn vừa mua chó đen"
  },
  {
    "idx": 10191,
    "start": "04:44:51,680",
    "end": "04:44:54,040",
    "start_sec": 17091.68,
    "end_sec": 17094.04,
    "zh": "结果就是个运气好的麻瓜爸",
    "vi": "Kết quả chỉ là một kẻ phàm nhân may mắn thôi"
  },
  {
    "idx": 10192,
    "start": "04:44:54,040",
    "end": "04:44:57,401",
    "start_sec": 17094.04,
    "end_sec": 17097.401,
    "zh": "这一船上的人也就023和026有点利用价值那要不今晚动手蠢货 你不知道逐一攻破的道理吗虽说你现在也成长得不错",
    "vi": "Trên thuyền này, chỉ có 023 và 026 là có chút giá trị"
  },
  {
    "idx": 10192,
    "start": "04:44:57,401",
    "end": "04:44:59,987",
    "start_sec": 17097.401,
    "end_sec": 17099.987,
    "zh": "这一船上的人也就023和026有点利用价值那要不今晚动手蠢货 你不知道逐一攻破的道理吗虽说你现在也成长得不错",
    "vi": "Vậy sao tối nay không ra tay đi, đồ ngốc"
  },
  {
    "idx": 10192,
    "start": "04:44:59,987",
    "end": "04:45:02,573",
    "start_sec": 17099.987,
    "end_sec": 17102.573,
    "zh": "这一船上的人也就023和026有点利用价值那要不今晚动手蠢货 你不知道逐一攻破的道理吗虽说你现在也成长得不错",
    "vi": "Ngươi không biết đạo lý công phá từng bước sao"
  },
  {
    "idx": 10192,
    "start": "04:45:02,573",
    "end": "04:45:05,417",
    "start_sec": 17102.573,
    "end_sec": 17105.417,
    "zh": "这一船上的人也就023和026有点利用价值那要不今晚动手蠢货 你不知道逐一攻破的道理吗虽说你现在也成长得不错",
    "vi": "Tuy nói ngươi bây giờ cũng trưởng thành không ít rồi"
  },
  {
    "idx": 10193,
    "start": "04:45:05,417",
    "end": "04:45:07,777",
    "start_sec": 17105.417,
    "end_sec": 17107.777,
    "zh": "但是真要给023 026合力对付",
    "vi": "Nhưng nếu thực sự để 023 và 026 hợp sức đối phó"
  },
  {
    "idx": 10194,
    "start": "04:45:07,777",
    "end": "04:45:08,917",
    "start_sec": 17107.777,
    "end_sec": 17108.917,
    "zh": "我也没把握",
    "vi": "Ta cũng không chắc chắn"
  },
  {
    "idx": 10195,
    "start": "04:45:08,917",
    "end": "04:45:10,177",
    "start_sec": 17108.917,
    "end_sec": 17110.177,
    "zh": "什么你的意思",
    "vi": "Ý ngươi là sao"
  },
  {
    "idx": 10196,
    "start": "04:45:10,177",
    "end": "04:45:12,277",
    "start_sec": 17110.177,
    "end_sec": 17112.277,
    "zh": "明天一早 下午",
    "vi": "Sáng mai, buổi chiều"
  },
  {
    "idx": 10197,
    "start": "04:45:12,277",
    "end": "04:45:13,957",
    "start_sec": 17112.277,
    "end_sec": 17113.957,
    "zh": "然后等徐天志回应你",
    "vi": "Rồi đợi Từ Thiên Chí trả lời ngươi"
  },
  {
    "idx": 10198,
    "start": "04:45:13,957",
    "end": "04:45:14,837",
    "start_sec": 17113.957,
    "end_sec": 17114.837,
    "zh": "你去宰他",
    "vi": "Ngươi đi giết hắn"
  },
  {
    "idx": 10199,
    "start": "04:45:14,837",
    "end": "04:45:16,577",
    "start_sec": 17114.837,
    "end_sec": 17116.577,
    "zh": "不止从分身后",
    "vi": "Không chỉ từ phân thân"
  },
  {
    "idx": 10200,
    "start": "04:45:16,577",
    "end": "04:45:18,277",
    "start_sec": 17116.577,
    "end_sec": 17118.277,
    "zh": "要分身对026动手",
    "vi": "Mà còn phải phân thân ra đối phó với 026"
  },
  {
    "idx": 10201,
    "start": "04:45:18,277",
    "end": "04:45:19,537",
    "start_sec": 17118.277,
    "end_sec": 17119.537,
    "zh": "以026的性格",
    "vi": "Với tính cách của 026"
  },
  {
    "idx": 10202,
    "start": "04:45:19,537",
    "end": "04:45:21,257",
    "start_sec": 17119.537,
    "end_sec": 17121.257,
    "zh": "必然不会对徐天志设防",
    "vi": "chắc chắn sẽ không đề phòng Từ Thiên Chí."
  },
  {
    "idx": 10203,
    "start": "04:45:21,257",
    "end": "04:45:22,797",
    "start_sec": 17121.257,
    "end_sec": 17122.797,
    "zh": "一击 若是得手",
    "vi": "Nếu đòn tấn công đó thành công"
  },
  {
    "idx": 10204,
    "start": "04:45:22,797",
    "end": "04:45:24,417",
    "start_sec": 17122.797,
    "end_sec": 17124.417,
    "zh": "等他体内的水果不错",
    "vi": "đợi thủy quỷ trong cơ thể hắn"
  },
  {
    "idx": 10205,
    "start": "04:45:24,417",
    "end": "04:45:25,877",
    "start_sec": 17124.417,
    "end_sec": 17125.877,
    "zh": "水鬼引到鬼境",
    "vi": "dẫn thủy quỷ vào quỷ cảnh."
  },
  {
    "idx": 10206,
    "start": "04:45:25,877",
    "end": "04:45:27,577",
    "start_sec": 17125.877,
    "end_sec": 17127.577,
    "zh": "一击要是没有得手",
    "vi": "Còn nếu đòn tấn công không thành công"
  },
  {
    "idx": 10207,
    "start": "04:45:27,577",
    "end": "04:45:29,637",
    "start_sec": 17127.577,
    "end_sec": 17129.637,
    "zh": "现在安排一个零二三的复制体",
    "vi": "thì bây giờ sẽ sắp xếp một bản sao của 023"
  },
  {
    "idx": 10208,
    "start": "04:45:29,637",
    "end": "04:45:30,817",
    "start_sec": 17129.637,
    "end_sec": 17130.817,
    "zh": "再去刺杀它",
    "vi": "để tiếp tục ám sát nó."
  },
  {
    "idx": 10209,
    "start": "04:45:30,817",
    "end": "04:45:31,817",
    "start_sec": 17130.817,
    "end_sec": 17131.817,
    "zh": "如此反复",
    "vi": "Cứ lặp đi lặp lại như vậy"
  },
  {
    "idx": 10210,
    "start": "04:45:31,817",
    "end": "04:45:32,977",
    "start_sec": 17131.817,
    "end_sec": 17132.977,
    "zh": "它体内的水鬼",
    "vi": "thủy quỷ trong cơ thể nó"
  },
  {
    "idx": 10211,
    "start": "04:45:32,977",
    "end": "04:45:34,197",
    "start_sec": 17132.977,
    "end_sec": 17134.197,
    "zh": "竟然扛不住复苏",
    "vi": "rốt cuộc sẽ không chịu nổi mà thức tỉnh."
  },
  {
    "idx": 10212,
    "start": "04:45:34,197",
    "end": "04:45:35,077",
    "start_sec": 17134.197,
    "end_sec": 17135.077,
    "zh": "至此",
    "vi": "Đến lúc đó"
  },
  {
    "idx": 10213,
    "start": "04:45:35,077",
    "end": "04:45:36,117",
    "start_sec": 17135.077,
    "end_sec": 17136.117,
    "zh": "水鬼复苏后",
    "vi": "sau khi thủy quỷ thức tỉnh"
  },
  {
    "idx": 10214,
    "start": "04:45:36,117",
    "end": "04:45:37,277",
    "start_sec": 17136.117,
    "end_sec": 17137.277,
    "zh": "曙光号停船",
    "vi": "tàu Thự Quang sẽ dừng lại."
  },
  {
    "idx": 10215,
    "start": "04:45:37,277",
    "end": "04:45:38,537",
    "start_sec": 17137.277,
    "end_sec": 17138.537,
    "zh": "这座船上的一切",
    "vi": "Mọi thứ trên con tàu này"
  },
  {
    "idx": 10216,
    "start": "04:45:38,537",
    "end": "04:45:40,077",
    "start_sec": 17138.537,
    "end_sec": 17140.077,
    "zh": "我们便可以徐徐图之",
    "vi": "chúng ta có thể từ từ đoạt lấy."
  },
  {
    "idx": 10217,
    "start": "04:45:40,077",
    "end": "04:45:41,617",
    "start_sec": 17140.077,
    "end_sec": 17141.617,
    "zh": "我说人类",
    "vi": "Này con người kia"
  },
  {
    "idx": 10218,
    "start": "04:45:41,617",
    "end": "04:45:42,837",
    "start_sec": 17141.617,
    "end_sec": 17142.837,
    "zh": "你困住水鬼",
    "vi": "ngươi nhốt thủy quỷ lại"
  },
  {
    "idx": 10219,
    "start": "04:45:42,837",
    "end": "04:45:45,077",
    "start_sec": 17142.837,
    "end_sec": 17145.077,
    "zh": "是想驾驭第三只鬼翼吗",
    "vi": "là muốn ngự trị con quỷ thứ ba sao."
  },
  {
    "idx": 10220,
    "start": "04:45:45,077",
    "end": "04:45:46,137",
    "start_sec": 17145.077,
    "end_sec": 17146.137,
    "zh": "三只",
    "vi": "Ba con sao."
  },
  {
    "idx": 10221,
    "start": "04:45:46,137",
    "end": "04:45:48,097",
    "start_sec": 17146.137,
    "end_sec": 17148.097,
    "zh": "你觉得",
    "vi": "Ngươi nghĩ"
  },
  {
    "idx": 10222,
    "start": "04:45:48,097",
    "end": "04:45:49,617",
    "start_sec": 17148.097,
    "end_sec": 17149.617,
    "zh": "我只满足三只鬼翼",
    "vi": "ta chỉ thỏa mãn với ba con quỷ thôi sao."
  },
  {
    "idx": 10223,
    "start": "04:45:49,617",
    "end": "04:45:50,777",
    "start_sec": 17149.617,
    "end_sec": 17150.777,
    "zh": "零二三的烟鬼",
    "vi": "Cả Yên Quỷ của 023"
  },
  {
    "idx": 10224,
    "start": "04:45:50,777",
    "end": "04:45:51,537",
    "start_sec": 17150.777,
    "end_sec": 17151.537,
    "zh": "我也要",
    "vi": "ta cũng muốn có."
  },
  {
    "idx": 10225,
    "start": "04:45:51,537",
    "end": "04:45:53,737",
    "start_sec": 17151.537,
    "end_sec": 17153.737,
    "zh": "这还是那个周扬吗",
    "vi": "Đây có còn là Chu Dương nữa không."
  },
  {
    "idx": 10226,
    "start": "04:45:53,737",
    "end": "04:45:56,217",
    "start_sec": 17153.737,
    "end_sec": 17156.217,
    "zh": "他居然就是一切根源的主使",
    "vi": "Hắn ta lại chính là kẻ chủ mưu đứng sau tất cả."
  },
  {
    "idx": 10227,
    "start": "04:45:56,217",
    "end": "04:45:58,477",
    "start_sec": 17156.217,
    "end_sec": 17158.477,
    "zh": "这家伙好厉害的算计",
    "vi": "Tên này tính toán thật đáng sợ."
  },
  {
    "idx": 10228,
    "start": "04:45:58,477",
    "end": "04:46:01,237",
    "start_sec": 17158.477,
    "end_sec": 17161.237,
    "zh": "原来他带下一盘很大的棋",
    "vi": "Hóa ra hắn đang đi một nước cờ rất lớn."
  },
  {
    "idx": 10229,
    "start": "04:46:01,237",
    "end": "04:46:04,037",
    "start_sec": 17161.237,
    "end_sec": 17164.037,
    "zh": "而我们不过都是他的棋子罢了",
    "vi": "Còn chúng ta chỉ là những quân cờ của hắn mà thôi."
  },
  {
    "idx": 10230,
    "start": "04:46:04,037",
    "end": "04:46:05,657",
    "start_sec": 17164.037,
    "end_sec": 17165.657,
    "zh": "零二三咬紧牙关",
    "vi": "023 nghiến chặt răng."
  },
  {
    "idx": 10231,
    "start": "04:46:05,657",
    "end": "04:46:06,737",
    "start_sec": 17165.657,
    "end_sec": 17166.737,
    "zh": "就要走出树林",
    "vi": "Sắp bước ra khỏi rừng rồi."
  },
  {
    "idx": 10232,
    "start": "04:46:06,737",
    "end": "04:46:09,777",
    "start_sec": 17166.737,
    "end_sec": 17169.777,
    "zh": "忽然橙子皮大手猛然抓住他的肩膀",
    "vi": "Bất ngờ bàn tay to lớn của Trình Tử Tề nắm chặt lấy vai cậu."
  },
  {
    "idx": 10233,
    "start": "04:46:09,777",
    "end": "04:46:11,077",
    "start_sec": 17169.777,
    "end_sec": 17171.077,
    "zh": "现在还不是时候",
    "vi": "Bây giờ vẫn chưa phải lúc."
  },
  {
    "idx": 10234,
    "start": "04:46:11,077",
    "end": "04:46:13,057",
    "start_sec": 17171.077,
    "end_sec": 17173.057,
    "zh": "我们可以有机会反射击他",
    "vi": "Chúng ta có thể tìm cơ hội phản công hắn."
  },
  {
    "idx": 10235,
    "start": "04:46:13,057",
    "end": "04:46:15,637",
    "start_sec": 17173.057,
    "end_sec": 17175.637,
    "zh": "找机会反射击",
    "vi": "Tìm cơ hội phản công sao."
  },
  {
    "idx": 10236,
    "start": "04:46:15,637",
    "end": "04:46:16,557",
    "start_sec": 17175.637,
    "end_sec": 17176.557,
    "zh": "什么机会",
    "vi": "Cơ hội gì chứ."
  },
  {
    "idx": 10237,
    "start": "04:46:16,557",
    "end": "04:46:17,617",
    "start_sec": 17176.557,
    "end_sec": 17177.617,
    "zh": "明天",
    "vi": "Ngày mai."
  },
  {
    "idx": 10238,
    "start": "04:46:17,617",
    "end": "04:46:18,577",
    "start_sec": 17177.617,
    "end_sec": 17178.577,
    "zh": "日迟明晚",
    "vi": "Tối mai."
  },
  {
    "idx": 10239,
    "start": "04:46:18,577",
    "end": "04:46:20,377",
    "start_sec": 17178.577,
    "end_sec": 17180.377,
    "zh": "我会让他主动入局",
    "vi": "Tôi sẽ khiến hắn tự nguyện rơi vào bẫy."
  },
  {
    "idx": 10240,
    "start": "04:46:20,377",
    "end": "04:46:22,317",
    "start_sec": 17180.377,
    "end_sec": 17182.317,
    "zh": "现在我们离开鬼境区域",
    "vi": "Bây giờ chúng ta rời khỏi khu vực quỷ cảnh."
  },
  {
    "idx": 10241,
    "start": "04:46:22,317",
    "end": "04:46:23,477",
    "start_sec": 17182.317,
    "end_sec": 17183.477,
    "zh": "也让他察觉到异样",
    "vi": "Cũng để hắn không nhận ra điều bất thường."
  },
  {
    "idx": 10242,
    "start": "04:46:23,477",
    "end": "04:46:25,597",
    "start_sec": 17183.477,
    "end_sec": 17185.597,
    "zh": "相信我",
    "vi": "Hãy tin tôi."
  },
  {
    "idx": 10243,
    "start": "04:46:25,597",
    "end": "04:46:27,457",
    "start_sec": 17185.597,
    "end_sec": 17187.457,
    "zh": "两人快速离开轨迹",
    "vi": "Hai người nhanh chóng rời khỏi quỹ đạo."
  },
  {
    "idx": 10244,
    "start": "04:46:27,457",
    "end": "04:46:29,037",
    "start_sec": 17187.457,
    "end_sec": 17189.037,
    "zh": "在三星组零二单",
    "vi": "Tại tổ Tam Tinh số không hai."
  },
  {
    "idx": 10245,
    "start": "04:46:29,037",
    "end": "04:46:30,037",
    "start_sec": 17189.037,
    "end_sec": 17190.037,
    "zh": "不要轻举妄动",
    "vi": "Đừng hành động thiếu suy nghĩ."
  },
  {
    "idx": 10246,
    "start": "04:46:30,037",
    "end": "04:46:32,597",
    "start_sec": 17190.037,
    "end_sec": 17192.597,
    "zh": "程子提匆匆回到周扬房间",
    "vi": "Trình Tử Tề vội vã quay về phòng của Chu Dương."
  },
  {
    "idx": 10247,
    "start": "04:46:32,597",
    "end": "04:46:34,977",
    "start_sec": 17192.597,
    "end_sec": 17194.977,
    "zh": "他坐在沙发上",
    "vi": "Cậu ngồi xuống ghế sofa."
  },
  {
    "idx": 10248,
    "start": "04:46:34,977",
    "end": "04:46:36,577",
    "start_sec": 17194.977,
    "end_sec": 17196.577,
    "zh": "联系起过去的信息",
    "vi": "Kết nối lại những thông tin cũ."
  },
  {
    "idx": 10249,
    "start": "04:46:36,577",
    "end": "04:46:37,117",
    "start_sec": 17196.577,
    "end_sec": 17197.117,
    "zh": "老姐",
    "vi": "Chị ơi."
  },
  {
    "idx": 10250,
    "start": "04:46:37,117",
    "end": "04:46:38,137",
    "start_sec": 17197.117,
    "end_sec": 17198.137,
    "zh": "在不在",
    "vi": "Chị có đó không."
  },
  {
    "idx": 10251,
    "start": "04:46:38,137",
    "end": "04:46:39,677",
    "start_sec": 17198.137,
    "end_sec": 17199.677,
    "zh": "这不是我吗",
    "vi": "Đây không phải là tôi sao."
  },
  {
    "idx": 10252,
    "start": "04:46:39,677",
    "end": "04:46:41,197",
    "start_sec": 17199.677,
    "end_sec": 17201.197,
    "zh": "最近好久没找我了呀",
    "vi": "Dạo này lâu rồi không tìm tôi nhỉ."
  },
  {
    "idx": 10253,
    "start": "04:46:41,197",
    "end": "04:46:42,437",
    "start_sec": 17201.197,
    "end_sec": 17202.437,
    "zh": "信息刚发过去",
    "vi": "Tin nhắn vừa gửi đi."
  },
  {
    "idx": 10254,
    "start": "04:46:42,437",
    "end": "04:46:43,457",
    "start_sec": 17202.437,
    "end_sec": 17203.457,
    "zh": "那边又是秒回",
    "vi": "Bên kia lại trả lời ngay lập tức."
  },
  {
    "idx": 10255,
    "start": "04:46:43,457",
    "end": "04:46:44,837",
    "start_sec": 17203.457,
    "end_sec": 17204.837,
    "zh": "程子提看着屏幕",
    "vi": "Trình Tử Tề nhìn vào màn hình."
  },
  {
    "idx": 10256,
    "start": "04:46:44,837",
    "end": "04:46:46,157",
    "start_sec": 17204.837,
    "end_sec": 17206.157,
    "zh": "不由得羡慕的笑了",
    "vi": "Không khỏi mỉm cười đầy ngưỡng mộ."
  },
  {
    "idx": 10257,
    "start": "04:46:46,157",
    "end": "04:46:47,157",
    "start_sec": 17206.157,
    "end_sec": 17207.157,
    "zh": "一个月前的我",
    "vi": "Tôi của một tháng trước."
  },
  {
    "idx": 10258,
    "start": "04:46:47,157",
    "end": "04:46:49,057",
    "start_sec": 17207.157,
    "end_sec": 17209.057,
    "zh": "这个点肯定还躺在床上",
    "vi": "Giờ này chắc chắn vẫn đang nằm trên giường."
  },
  {
    "idx": 10259,
    "start": "04:46:49,057",
    "end": "04:46:50,397",
    "start_sec": 17209.057,
    "end_sec": 17210.397,
    "zh": "正犹豫着点什么外卖吧",
    "vi": "Đang do dự xem nên đặt món gì đây."
  },
  {
    "idx": 10260,
    "start": "04:46:50,397",
    "end": "04:46:51,737",
    "start_sec": 17210.397,
    "end_sec": 17211.737,
    "zh": "我有事找你",
    "vi": "Tôi có việc cần tìm chị."
  },
  {
    "idx": 10261,
    "start": "04:46:51,737",
    "end": "04:46:52,497",
    "start_sec": 17211.737,
    "end_sec": 17212.497,
    "zh": "什么事",
    "vi": "Có chuyện gì vậy."
  },
  {
    "idx": 10262,
    "start": "04:46:52,497",
    "end": "04:46:54,897",
    "start_sec": 17212.497,
    "end_sec": 17214.897,
    "zh": "你现在去莲花小区一单人二楼",
    "vi": "Bây giờ chị hãy đến tầng hai nhà số một khu chung cư Liên Hoa."
  },
  {
    "idx": 10263,
    "start": "04:46:54,897",
    "end": "04:46:55,977",
    "start_sec": 17214.897,
    "end_sec": 17215.977,
    "zh": "拜访一位道长",
    "vi": "Để bái phỏng một vị đạo trưởng."
  },
  {
    "idx": 10264,
    "start": "04:46:55,977",
    "end": "04:46:57,037",
    "start_sec": 17215.977,
    "end_sec": 17217.037,
    "zh": "他有两个孩子",
    "vi": "Ông ấy có hai đứa con."
  },
  {
    "idx": 10265,
    "start": "04:46:57,037",
    "end": "04:46:58,397",
    "start_sec": 17217.037,
    "end_sec": 17218.397,
    "zh": "男孩子叫下朱青",
    "vi": "Con trai tên là Hạ Chu Thanh."
  },
  {
    "idx": 10266,
    "start": "04:46:58,397",
    "end": "04:46:59,637",
    "start_sec": 17218.397,
    "end_sec": 17219.637,
    "zh": "女孩叫下跑龙",
    "vi": "Con gái tên là Hạ Bảo Long."
  },
  {
    "idx": 10267,
    "start": "04:46:59,637",
    "end": "04:47:01,557",
    "start_sec": 17219.637,
    "end_sec": 17221.557,
    "zh": "他的手机号是60086",
    "vi": "Số điện thoại của ông ấy là sáu không không tám sáu."
  },
  {
    "idx": 10268,
    "start": "04:47:01,557",
    "end": "04:47:02,737",
    "start_sec": 17221.557,
    "end_sec": 17222.737,
    "zh": "不是",
    "vi": "Không phải chứ."
  },
  {
    "idx": 10269,
    "start": "04:47:02,737",
    "end": "04:47:04,477",
    "start_sec": 17222.737,
    "end_sec": 17224.477,
    "zh": "怎么又让我去社交了",
    "vi": "Sao lại bắt tôi đi giao thiệp nữa rồi."
  },
  {
    "idx": 10270,
    "start": "04:47:04,477",
    "end": "04:47:06,097",
    "start_sec": 17224.477,
    "end_sec": 17226.097,
    "zh": "咱又不是想社交牛逼战",
    "vi": "Tôi đâu có muốn làm chiến thần ngoại giao đâu."
  },
  {
    "idx": 10271,
    "start": "04:47:06,097",
    "end": "04:47:08,017",
    "start_sec": 17226.097,
    "end_sec": 17228.017,
    "zh": "这个道长以后很厉害吗",
    "vi": "Vị đạo trưởng này sau này lợi hại lắm sao."
  },
  {
    "idx": 10272,
    "start": "04:47:08,017",
    "end": "04:47:09,377",
    "start_sec": 17228.017,
    "end_sec": 17229.377,
    "zh": "有多牛逼我不清楚",
    "vi": "Lợi hại thế nào tôi cũng không rõ."
  },
  {
    "idx": 10273,
    "start": "04:47:09,377",
    "end": "04:47:10,497",
    "start_sec": 17229.377,
    "end_sec": 17230.497,
    "zh": "好着去认识他",
    "vi": "Nhưng đi làm quen với ông ấy."
  },
  {
    "idx": 10274,
    "start": "04:47:10,497",
    "end": "04:47:11,457",
    "start_sec": 17230.497,
    "end_sec": 17231.457,
    "zh": "绝对不是坏事",
    "vi": "Tuyệt đối không phải là chuyện xấu."
  },
  {
    "idx": 10275,
    "start": "04:47:11,457",
    "end": "04:47:12,237",
    "start_sec": 17231.457,
    "end_sec": 17232.237,
    "zh": "好吧",
    "vi": "Được rồi."
  },
  {
    "idx": 10276,
    "start": "04:47:12,237",
    "end": "04:47:13,557",
    "start_sec": 17232.237,
    "end_sec": 17233.557,
    "zh": "还有啥要交代的不",
    "vi": "Còn gì cần dặn dò nữa không."
  },
  {
    "idx": 10277,
    "start": "04:47:13,557",
    "end": "04:47:14,237",
    "start_sec": 17233.557,
    "end_sec": 17234.237,
    "zh": "有",
    "vi": "Có."
  },
  {
    "idx": 10278,
    "start": "04:47:14,237",
    "end": "04:47:16,197",
    "start_sec": 17234.237,
    "end_sec": 17236.197,
    "zh": "这个交代你务必记好了",
    "vi": "Lời dặn này chị nhất định phải nhớ kỹ."
  },
  {
    "idx": 10279,
    "start": "04:47:16,197",
    "end": "04:47:17,557",
    "start_sec": 17236.197,
    "end_sec": 17237.557,
    "zh": "在中元节前一天",
    "vi": "Vào trước ngày lễ Trung Nguyên một ngày."
  },
  {
    "idx": 10280,
    "start": "04:47:17,557",
    "end": "04:47:18,757",
    "start_sec": 17237.557,
    "end_sec": 17238.757,
    "zh": "你打电话给道长",
    "vi": "Chị hãy gọi điện thoại cho đạo trưởng."
  },
  {
    "idx": 10281,
    "start": "04:47:18,757",
    "end": "04:47:20,077",
    "start_sec": 17238.757,
    "end_sec": 17240.077,
    "zh": "让他千万不要外出",
    "vi": "Bảo ông ấy vạn lần đừng đi ra ngoài."
  },
  {
    "idx": 10282,
    "start": "04:47:20,077",
    "end": "04:47:21,937",
    "start_sec": 17240.077,
    "end_sec": 17241.937,
    "zh": "反正你用尽一切方法",
    "vi": "Nói chung chị hãy dùng mọi cách."
  },
  {
    "idx": 10283,
    "start": "04:47:21,937",
    "end": "04:47:23,897",
    "start_sec": 17241.937,
    "end_sec": 17243.897,
    "zh": "都确保他不要在中元节出门",
    "vi": "Để đảm bảo ông ấy không ra ngoài vào ngày lễ Trung Nguyên."
  },
  {
    "idx": 10284,
    "start": "04:47:23,897",
    "end": "04:47:24,957",
    "start_sec": 17243.897,
    "end_sec": 17244.957,
    "zh": "为什么呀",
    "vi": "Tại sao thế."
  },
  {
    "idx": 10285,
    "start": "04:47:24,957",
    "end": "04:47:27,077",
    "start_sec": 17244.957,
    "end_sec": 17247.077,
    "zh": "因为他出门就会被鬼一杀害",
    "vi": "Bởi vì nếu ra ngoài ông ấy sẽ bị quỷ sát hại."
  },
  {
    "idx": 10286,
    "start": "04:47:27,077",
    "end": "04:47:28,537",
    "start_sec": 17247.077,
    "end_sec": 17248.537,
    "zh": "我要确保他活下来",
    "vi": "Tôi muốn đảm bảo ông ấy sống sót."
  },
  {
    "idx": 10287,
    "start": "04:47:28,537",
    "end": "04:47:29,197",
    "start_sec": 17248.537,
    "end_sec": 17249.197,
    "zh": "行",
    "vi": "Được rồi."
  },
  {
    "idx": 10288,
    "start": "04:47:29,197",
    "end": "04:47:30,237",
    "start_sec": 17249.197,
    "end_sec": 17250.237,
    "zh": "我记得吧",
    "vi": "Tôi nhớ rồi."
  },
  {
    "idx": 10289,
    "start": "04:47:30,237",
    "end": "04:47:32,717",
    "start_sec": 17250.237,
    "end_sec": 17252.717,
    "zh": "如果那道士活下来上船",
    "vi": "Nếu vị đạo sĩ đó sống sót và lên tàu."
  },
  {
    "idx": 10290,
    "start": "04:47:32,717",
    "end": "04:47:34,877",
    "start_sec": 17252.717,
    "end_sec": 17254.877,
    "zh": "那么曙光号上的物战鬼替身事件",
    "vi": "Thì sự kiện quỷ thế thân trên tàu Bình Minh."
  },
  {
    "idx": 10291,
    "start": "04:47:34,877",
    "end": "04:47:35,997",
    "start_sec": 17254.877,
    "end_sec": 17255.997,
    "zh": "就不会那么猖獗",
    "vi": "Sẽ không hung hãn đến thế."
  },
  {
    "idx": 10292,
    "start": "04:47:35,997",
    "end": "04:47:37,917",
    "start_sec": 17255.997,
    "end_sec": 17257.917,
    "zh": "物战鬼吞噬的活人少了",
    "vi": "Số người sống bị vật chiến quỷ nuốt chửng đã ít đi."
  },
  {
    "idx": 10293,
    "start": "04:47:37,917",
    "end": "04:47:39,877",
    "start_sec": 17257.917,
    "end_sec": 17259.877,
    "zh": "无形中就忽略了周扬的力量",
    "vi": "Vô hình trung đã bỏ qua sức mạnh của Chu Dương."
  },
  {
    "idx": 10294,
    "start": "04:47:39,877",
    "end": "04:47:40,917",
    "start_sec": 17259.877,
    "end_sec": 17260.917,
    "zh": "周扬啊周扬",
    "vi": "Chu Dương à Chu Dương."
  },
  {
    "idx": 10295,
    "start": "04:47:40,917",
    "end": "04:47:41,717",
    "start_sec": 17260.917,
    "end_sec": 17261.717,
    "zh": "到头来",
    "vi": "Cuối cùng."
  },
  {
    "idx": 10296,
    "start": "04:47:41,717",
    "end": "04:47:43,357",
    "start_sec": 17261.717,
    "end_sec": 17263.357,
    "zh": "这盘棋是我和你共鸣",
    "vi": "Ván cờ này là ta và ngươi cùng hòa nhịp."
  },
  {
    "idx": 10297,
    "start": "04:47:43,357",
    "end": "04:47:45,777",
    "start_sec": 17263.357,
    "end_sec": 17265.777,
    "zh": "长者提之所以建立确保那个道士",
    "vi": "Sở dĩ trưởng giả đề xuất bảo đảm cho tên đạo sĩ đó."
  },
  {
    "idx": 10298,
    "start": "04:47:45,777",
    "end": "04:47:47,157",
    "start_sec": 17265.777,
    "end_sec": 17267.157,
    "zh": "是因为趁着时间发展",
    "vi": "Là vì tranh thủ thời gian phát triển."
  },
  {
    "idx": 10299,
    "start": "04:47:47,157",
    "end": "04:47:48,477",
    "start_sec": 17267.157,
    "end_sec": 17268.477,
    "zh": "他很大戴笠会带着",
    "vi": "Hắn rất có thể sẽ mang theo."
  },
  {
    "idx": 10300,
    "start": "04:47:48,477",
    "end": "04:47:49,137",
    "start_sec": 17268.477,
    "end_sec": 17269.137,
    "zh": "独自江塞",
    "vi": "Độc Tử Giang Tái."
  },
  {
    "idx": 10301,
    "start": "04:47:49,137",
    "end": "04:47:51,337",
    "start_sec": 17269.137,
    "end_sec": 17271.337,
    "zh": "下刀藤和小男孩下竹箱上去",
    "vi": "Đưa Đao Đằng và cậu bé cùng chiếc hòm tre lên đó."
  },
  {
    "idx": 10302,
    "start": "04:47:51,337",
    "end": "04:47:54,117",
    "start_sec": 17271.337,
    "end_sec": 17274.117,
    "zh": "虽说微弱的道法起不了太大作用",
    "vi": "Tuy đạo pháp yếu ớt không có tác dụng quá lớn."
  },
  {
    "idx": 10303,
    "start": "04:47:54,117",
    "end": "04:47:55,277",
    "start_sec": 17274.117,
    "end_sec": 17275.277,
    "zh": "但在这种情况下",
    "vi": "Nhưng trong tình huống này."
  },
  {
    "idx": 10304,
    "start": "04:47:55,277",
    "end": "04:47:56,857",
    "start_sec": 17275.277,
    "end_sec": 17276.857,
    "zh": "总能遏制路上鬼的发展",
    "vi": "Vẫn có thể kìm hãm sự phát triển của quỷ trên đường."
  },
  {
    "idx": 10305,
    "start": "04:47:56,857",
    "end": "04:47:59,897",
    "start_sec": 17276.857,
    "end_sec": 17279.897,
    "zh": "诚子皮",
    "vi": "Thành Tử Bì."
  },
  {
    "idx": 10306,
    "start": "04:47:59,897",
    "end": "04:48:01,317",
    "start_sec": 17279.897,
    "end_sec": 17281.317,
    "zh": "你不是去被审问了吗",
    "vi": "Ngươi không phải đi lấy lời khai sao."
  },
  {
    "idx": 10307,
    "start": "04:48:01,317",
    "end": "04:48:02,837",
    "start_sec": 17281.317,
    "end_sec": 17282.837,
    "zh": "这么快就结束了",
    "vi": "Kết thúc nhanh thế sao."
  },
  {
    "idx": 10308,
    "start": "04:48:02,837",
    "end": "04:48:04,517",
    "start_sec": 17282.837,
    "end_sec": 17284.517,
    "zh": "本来认知不是我杀的",
    "vi": "Vốn dĩ người đó không phải do ta giết."
  },
  {
    "idx": 10309,
    "start": "04:48:04,517",
    "end": "04:48:05,797",
    "start_sec": 17284.517,
    "end_sec": 17285.797,
    "zh": "当然没什么好审的呀",
    "vi": "Tất nhiên là không có gì để thẩm vấn rồi."
  },
  {
    "idx": 10310,
    "start": "04:48:05,797",
    "end": "04:48:06,497",
    "start_sec": 17285.797,
    "end_sec": 17286.497,
    "zh": "也是",
    "vi": "Cũng đúng."
  },
  {
    "idx": 10311,
    "start": "04:48:06,497",
    "end": "04:48:09,077",
    "start_sec": 17286.497,
    "end_sec": 17289.077,
    "zh": "我听说那个徐东来还有三张纸人呢",
    "vi": "Ta nghe nói Từ Đông Lai kia còn có ba hình nhân giấy nữa."
  },
  {
    "idx": 10312,
    "start": "04:48:09,077",
    "end": "04:48:10,597",
    "start_sec": 17289.077,
    "end_sec": 17290.597,
    "zh": "是从一个道士手里买的",
    "vi": "Là mua từ tay một đạo sĩ."
  },
  {
    "idx": 10313,
    "start": "04:48:10,597",
    "end": "04:48:11,277",
    "start_sec": 17290.597,
    "end_sec": 17291.277,
    "zh": "他有纸人",
    "vi": "Hắn có hình nhân giấy."
  },
  {
    "idx": 10314,
    "start": "04:48:11,277",
    "end": "04:48:12,117",
    "start_sec": 17291.277,
    "end_sec": 17292.117,
    "zh": "也有黑狗",
    "vi": "Cũng có chó đen."
  },
  {
    "idx": 10315,
    "start": "04:48:12,117",
    "end": "04:48:13,177",
    "start_sec": 17292.117,
    "end_sec": 17293.177,
    "zh": "其实大差不差",
    "vi": "Thực ra cũng không khác mấy."
  },
  {
    "idx": 10316,
    "start": "04:48:13,177",
    "end": "04:48:14,797",
    "start_sec": 17293.177,
    "end_sec": 17294.797,
    "zh": "都是狗言残喘的狗活着",
    "vi": "Đều là sống thoi thóp qua ngày."
  },
  {
    "idx": 10317,
    "start": "04:48:14,797",
    "end": "04:48:16,637",
    "start_sec": 17294.797,
    "end_sec": 17296.637,
    "zh": "你们确实没必要互相杀戮",
    "vi": "Các ngươi quả thực không cần thiết phải tàn sát lẫn nhau."
  },
  {
    "idx": 10318,
    "start": "04:48:16,637",
    "end": "04:48:18,957",
    "start_sec": 17296.637,
    "end_sec": 17298.957,
    "zh": "周扬言语里带着些许讥讽",
    "vi": "Trong lời nói của Chu Dương mang theo chút mỉa mai."
  },
  {
    "idx": 10319,
    "start": "04:48:18,957",
    "end": "04:48:20,137",
    "start_sec": 17298.957,
    "end_sec": 17300.137,
    "zh": "并没有之前那么客气",
    "vi": "Không còn khách sáo như trước nữa."
  },
  {
    "idx": 10320,
    "start": "04:48:20,137",
    "end": "04:48:21,657",
    "start_sec": 17300.137,
    "end_sec": 17301.657,
    "zh": "或许是因为这次重开",
    "vi": "Có lẽ là vì lần bắt đầu lại này."
  },
  {
    "idx": 10321,
    "start": "04:48:21,657",
    "end": "04:48:23,297",
    "start_sec": 17301.657,
    "end_sec": 17303.297,
    "zh": "橙子皮直接表明了",
    "vi": "Trần Tử Bì thể hiện rõ ra rằng"
  },
  {
    "idx": 10322,
    "start": "04:48:23,297",
    "end": "04:48:24,777",
    "start_sec": 17303.297,
    "end_sec": 17304.777,
    "zh": "自己是个草包的样子",
    "vi": "bản thân là một kẻ vô dụng"
  },
  {
    "idx": 10323,
    "start": "04:48:24,777",
    "end": "04:48:25,557",
    "start_sec": 17304.777,
    "end_sec": 17305.557,
    "zh": "我累了",
    "vi": "Tôi mệt rồi"
  },
  {
    "idx": 10324,
    "start": "04:48:25,557",
    "end": "04:48:27,237",
    "start_sec": 17305.557,
    "end_sec": 17307.237,
    "zh": "刚刚去找我老爹唠了唠嗑",
    "vi": "Vừa mới đi nói chuyện với cha tôi xong"
  },
  {
    "idx": 10325,
    "start": "04:48:27,237",
    "end": "04:48:28,257",
    "start_sec": 17307.237,
    "end_sec": 17308.257,
    "zh": "我先回屋休息",
    "vi": "Tôi về phòng nghỉ ngơi đây"
  },
  {
    "idx": 10326,
    "start": "04:48:28,257",
    "end": "04:48:29,337",
    "start_sec": 17308.257,
    "end_sec": 17309.337,
    "zh": "你要是不介意",
    "vi": "Nếu bạn không phiền"
  },
  {
    "idx": 10327,
    "start": "04:48:29,337",
    "end": "04:48:30,397",
    "start_sec": 17309.337,
    "end_sec": 17310.397,
    "zh": "就是我隔壁屋吧",
    "vi": "thì cứ ở phòng bên cạnh tôi nhé"
  },
  {
    "idx": 10328,
    "start": "04:48:30,397",
    "end": "04:48:31,737",
    "start_sec": 17310.397,
    "end_sec": 17311.737,
    "zh": "橙子皮笑了笑",
    "vi": "Trần Tử Bì mỉm cười"
  },
  {
    "idx": 10329,
    "start": "04:48:31,737",
    "end": "04:48:32,617",
    "start_sec": 17311.737,
    "end_sec": 17312.617,
    "zh": "周扬啊",
    "vi": "Chu Dương à"
  },
  {
    "idx": 10330,
    "start": "04:48:32,617",
    "end": "04:48:33,137",
    "start_sec": 17312.617,
    "end_sec": 17313.137,
    "zh": "你可太",
    "vi": "Bạn thật là"
  },
  {
    "idx": 10331,
    "start": "04:48:33,137",
    "end": "04:48:34,857",
    "start_sec": 17313.137,
    "end_sec": 17314.857,
    "zh": "真是啊",
    "vi": "Đúng là hết nói nổi"
  },
  {
    "idx": 10332,
    "start": "04:48:34,857",
    "end": "04:48:36,557",
    "start_sec": 17314.857,
    "end_sec": 17316.557,
    "zh": "回到卧室",
    "vi": "Trở về phòng ngủ"
  },
  {
    "idx": 10333,
    "start": "04:48:36,557",
    "end": "04:48:38,217",
    "start_sec": 17316.557,
    "end_sec": 17318.217,
    "zh": "橙子皮再次设置了",
    "vi": "Trần Tử Bì lại cài đặt"
  },
  {
    "idx": 10334,
    "start": "04:48:38,217",
    "end": "04:48:39,277",
    "start_sec": 17318.217,
    "end_sec": 17319.277,
    "zh": "四点的震动闹钟",
    "vi": "báo thức rung lúc bốn giờ"
  },
  {
    "idx": 10335,
    "start": "04:48:39,277",
    "end": "04:48:40,957",
    "start_sec": 17319.277,
    "end_sec": 17320.957,
    "zh": "不知过了多久",
    "vi": "Không biết đã qua bao lâu"
  },
  {
    "idx": 10336,
    "start": "04:48:40,957",
    "end": "04:48:42,237",
    "start_sec": 17320.957,
    "end_sec": 17322.237,
    "zh": "熟悉的震动声团",
    "vi": "Tiếng rung quen thuộc vang lên"
  },
  {
    "idx": 10337,
    "start": "04:48:42,237",
    "end": "04:48:43,617",
    "start_sec": 17322.237,
    "end_sec": 17323.617,
    "zh": "橙子皮睁开眼",
    "vi": "Trần Tử Bì mở mắt ra"
  },
  {
    "idx": 10338,
    "start": "04:48:43,617",
    "end": "04:48:44,717",
    "start_sec": 17323.617,
    "end_sec": 17324.717,
    "zh": "没有举着出门",
    "vi": "Không hề vội vã ra ngoài"
  },
  {
    "idx": 10339,
    "start": "04:48:44,717",
    "end": "04:48:46,557",
    "start_sec": 17324.717,
    "end_sec": 17326.557,
    "zh": "而是看向了周扬的房门",
    "vi": "Mà nhìn về phía cửa phòng Chu Dương"
  },
  {
    "idx": 10340,
    "start": "04:48:46,557",
    "end": "04:48:47,757",
    "start_sec": 17326.557,
    "end_sec": 17327.757,
    "zh": "周扬现在还在睡觉",
    "vi": "Chu Dương bây giờ vẫn đang ngủ"
  },
  {
    "idx": 10341,
    "start": "04:48:47,757",
    "end": "04:48:48,797",
    "start_sec": 17327.757,
    "end_sec": 17328.797,
    "zh": "到底要不要动手",
    "vi": "Rốt cuộc có nên ra tay không"
  },
  {
    "idx": 10342,
    "start": "04:48:48,797",
    "end": "04:48:49,777",
    "start_sec": 17328.797,
    "end_sec": 17329.777,
    "zh": "正主是周扬",
    "vi": "Mục tiêu chính là Chu Dương"
  },
  {
    "idx": 10343,
    "start": "04:48:49,777",
    "end": "04:48:50,857",
    "start_sec": 17329.777,
    "end_sec": 17330.857,
    "zh": "只要解决了周扬",
    "vi": "Chỉ cần giải quyết được Chu Dương"
  },
  {
    "idx": 10344,
    "start": "04:48:50,857",
    "end": "04:48:52,397",
    "start_sec": 17330.857,
    "end_sec": 17332.397,
    "zh": "一切都会随之结束",
    "vi": "Mọi chuyện sẽ kết thúc theo"
  },
  {
    "idx": 10345,
    "start": "04:48:52,397",
    "end": "04:48:53,117",
    "start_sec": 17332.397,
    "end_sec": 17333.117,
    "zh": "想了想",
    "vi": "Suy nghĩ một chút"
  },
  {
    "idx": 10346,
    "start": "04:48:53,117",
    "end": "04:48:54,477",
    "start_sec": 17333.117,
    "end_sec": 17334.477,
    "zh": "藤子皮还在房间",
    "vi": "Trần Tử Bì vẫn ở trong phòng"
  },
  {
    "idx": 10347,
    "start": "04:48:54,477",
    "end": "04:48:55,417",
    "start_sec": 17334.477,
    "end_sec": 17335.417,
    "zh": "还是算了",
    "vi": "Thôi bỏ đi"
  },
  {
    "idx": 10348,
    "start": "04:48:55,417",
    "end": "04:48:56,297",
    "start_sec": 17335.417,
    "end_sec": 17336.297,
    "zh": "以周扬的性格",
    "vi": "Với tính cách của Chu Dương"
  },
  {
    "idx": 10349,
    "start": "04:48:56,297",
    "end": "04:48:57,557",
    "start_sec": 17336.297,
    "end_sec": 17337.557,
    "zh": "不可能睡觉没有防备",
    "vi": "Không thể nào ngủ mà không đề phòng"
  },
  {
    "idx": 10350,
    "start": "04:48:57,557",
    "end": "04:48:58,417",
    "start_sec": 17337.557,
    "end_sec": 17338.417,
    "zh": "万一失手",
    "vi": "Lỡ như thất bại thì sao"
  },
  {
    "idx": 10351,
    "start": "04:48:58,417",
    "end": "04:48:59,537",
    "start_sec": 17338.417,
    "end_sec": 17339.537,
    "zh": "就得不偿失了",
    "vi": "thì sẽ lỗ vốn"
  },
  {
    "idx": 10352,
    "start": "04:48:59,537",
    "end": "04:49:01,737",
    "start_sec": 17339.537,
    "end_sec": 17341.737,
    "zh": "藤子皮捏手捏脚的推开门",
    "vi": "Trần Tử Bì rón rén đẩy cửa bước vào"
  },
  {
    "idx": 10353,
    "start": "04:49:01,737",
    "end": "04:49:02,697",
    "start_sec": 17341.737,
    "end_sec": 17342.697,
    "zh": "如上次一样",
    "vi": "Như lần trước"
  },
  {
    "idx": 10354,
    "start": "04:49:02,697",
    "end": "04:49:03,717",
    "start_sec": 17342.697,
    "end_sec": 17343.717,
    "zh": "来到夜楼大厅",
    "vi": "Đến sảnh nhà đêm"
  },
  {
    "idx": 10355,
    "start": "04:49:03,717",
    "end": "04:49:04,777",
    "start_sec": 17343.717,
    "end_sec": 17344.777,
    "zh": "躲到餐桌下",
    "vi": "Trốn dưới bàn ăn"
  },
  {
    "idx": 10356,
    "start": "04:49:04,777",
    "end": "04:49:07,037",
    "start_sec": 17344.777,
    "end_sec": 17347.037,
    "zh": "老爹",
    "vi": "Bố ơi"
  },
  {
    "idx": 10357,
    "start": "04:49:07,037",
    "end": "04:49:08,517",
    "start_sec": 17347.037,
    "end_sec": 17348.517,
    "zh": "昨天那个上船的",
    "vi": "Người lên thuyền hôm qua"
  },
  {
    "idx": 10358,
    "start": "04:49:08,517",
    "end": "04:49:10,177",
    "start_sec": 17348.517,
    "end_sec": 17350.177,
    "zh": "是不是皮哥哥啊",
    "vi": "Có phải anh Trần Tử Bì không ạ"
  },
  {
    "idx": 10359,
    "start": "04:49:10,177",
    "end": "04:49:12,277",
    "start_sec": 17350.177,
    "end_sec": 17352.277,
    "zh": "我看着有点像呢",
    "vi": "Con thấy hơi giống"
  },
  {
    "idx": 10360,
    "start": "04:49:12,277",
    "end": "04:49:13,857",
    "start_sec": 17352.277,
    "end_sec": 17353.857,
    "zh": "他们现在就认识我了",
    "vi": "Họ đã biết con rồi"
  },
  {
    "idx": 10361,
    "start": "04:49:13,857",
    "end": "04:49:14,577",
    "start_sec": 17353.857,
    "end_sec": 17354.577,
    "zh": "不得不说",
    "vi": "Phải nói là"
  },
  {
    "idx": 10362,
    "start": "04:49:14,577",
    "end": "04:49:16,957",
    "start_sec": 17354.577,
    "end_sec": 17356.957,
    "zh": "过去的我办事效率是真高啊",
    "vi": "Hiệu quả làm việc của tôi trước đây thật sự rất cao"
  },
  {
    "idx": 10363,
    "start": "04:49:16,957",
    "end": "04:49:17,497",
    "start_sec": 17356.957,
    "end_sec": 17357.497,
    "zh": "夏祝卿",
    "vi": "Hạ Chúc Thanh"
  },
  {
    "idx": 10364,
    "start": "04:49:17,497",
    "end": "04:49:18,457",
    "start_sec": 17357.497,
    "end_sec": 17358.457,
    "zh": "夏桃红",
    "vi": "Hạ Đào Hồng"
  },
  {
    "idx": 10365,
    "start": "04:49:18,457",
    "end": "04:49:19,057",
    "start_sec": 17358.457,
    "end_sec": 17359.057,
    "zh": "夏清源",
    "vi": "Hạ Thanh Nguyên"
  },
  {
    "idx": 10366,
    "start": "04:49:19,057",
    "end": "04:49:20,777",
    "start_sec": 17359.057,
    "end_sec": 17360.777,
    "zh": "单身老父亲带着两个娃",
    "vi": "Một ông bố độc thân với hai đứa con"
  },
  {
    "idx": 10367,
    "start": "04:49:20,777",
    "end": "04:49:23,017",
    "start_sec": 17360.777,
    "end_sec": 17363.017,
    "zh": "开过去已经被更改成功了",
    "vi": "Đã mở ra và thay đổi thành công rồi"
  },
  {
    "idx": 10368,
    "start": "04:49:23,017",
    "end": "04:49:24,497",
    "start_sec": 17363.017,
    "end_sec": 17364.497,
    "zh": "是不是你皮哥哥",
    "vi": "Có phải anh Trần Tử Bì không"
  },
  {
    "idx": 10369,
    "start": "04:49:24,497",
    "end": "04:49:26,237",
    "start_sec": 17364.497,
    "end_sec": 17366.237,
    "zh": "待会吃饭就知道了",
    "vi": "Lát ăn cơm sẽ biết"
  },
  {
    "idx": 10370,
    "start": "04:49:26,237",
    "end": "04:49:28,117",
    "start_sec": 17366.237,
    "end_sec": 17368.117,
    "zh": "我手机早就丢了",
    "vi": "Điện thoại của tôi đã mất từ lâu rồi"
  },
  {
    "idx": 10371,
    "start": "04:49:28,117",
    "end": "04:49:30,217",
    "start_sec": 17368.117,
    "end_sec": 17370.217,
    "zh": "昨天又是那什么御鬼者",
    "vi": "Hôm qua lại là cái tên người điều khiển quỷ đó"
  },
  {
    "idx": 10372,
    "start": "04:49:30,217",
    "end": "04:49:31,197",
    "start_sec": 17370.217,
    "end_sec": 17371.197,
    "zh": "领着他走的",
    "vi": "Dẫn anh ta đi"
  },
  {
    "idx": 10373,
    "start": "04:49:31,197",
    "end": "04:49:31,897",
    "start_sec": 17371.197,
    "end_sec": 17371.897,
    "zh": "哎",
    "vi": "Ai"
  },
  {
    "idx": 10374,
    "start": "04:49:31,897",
    "end": "04:49:34,397",
    "start_sec": 17371.897,
    "end_sec": 17374.397,
    "zh": "那个小子住林平小区啊",
    "vi": "Cậu ta ở khu Lâm Bình"
  },
  {
    "idx": 10375,
    "start": "04:49:34,397",
    "end": "04:49:36,817",
    "start_sec": 17374.397,
    "end_sec": 17376.817,
    "zh": "也不知道这段时间经历了什么",
    "vi": "Không biết thời gian qua đã trải qua những gì"
  },
  {
    "idx": 10376,
    "start": "04:49:36,817",
    "end": "04:49:39,057",
    "start_sec": 17376.817,
    "end_sec": 17379.057,
    "zh": "听着夏星源带着关心的语气",
    "vi": "Nghe Hạ Tinh Nguyên nói với giọng quan tâm"
  },
  {
    "idx": 10377,
    "start": "04:49:39,057",
    "end": "04:49:40,797",
    "start_sec": 17379.057,
    "end_sec": 17380.797,
    "zh": "橙子皮心头不禁一来",
    "vi": "Trần Tử Bì không khỏi xúc động"
  },
  {
    "idx": 10378,
    "start": "04:49:40,797",
    "end": "04:49:42,037",
    "start_sec": 17380.797,
    "end_sec": 17382.037,
    "zh": "至少这一下三口",
    "vi": "Ít nhất thì ba người này"
  },
  {
    "idx": 10379,
    "start": "04:49:42,037",
    "end": "04:49:43,437",
    "start_sec": 17382.037,
    "end_sec": 17383.437,
    "zh": "是真的在为他担心",
    "vi": "Thực sự đang lo lắng cho cậu ta"
  },
  {
    "idx": 10380,
    "start": "04:49:43,437",
    "end": "04:49:44,357",
    "start_sec": 17383.437,
    "end_sec": 17384.357,
    "zh": "爸",
    "vi": "Bố"
  },
  {
    "idx": 10381,
    "start": "04:49:44,357",
    "end": "04:49:46,117",
    "start_sec": 17384.357,
    "end_sec": 17386.117,
    "zh": "要是待会真见到诚哥了",
    "vi": "Lát nữa nếu thực sự gặp anh Thành"
  },
  {
    "idx": 10382,
    "start": "04:49:46,117",
    "end": "04:49:47,477",
    "start_sec": 17386.117,
    "end_sec": 17387.477,
    "zh": "你一定要好好感谢他",
    "vi": "anh nhất định phải cảm ơn cậu ấy thật tốt."
  },
  {
    "idx": 10383,
    "start": "04:49:47,477",
    "end": "04:49:48,617",
    "start_sec": 17387.477,
    "end_sec": 17388.617,
    "zh": "那晚你要出门",
    "vi": "Đêm đó anh định ra ngoài"
  },
  {
    "idx": 10384,
    "start": "04:49:48,617",
    "end": "04:49:49,777",
    "start_sec": 17388.617,
    "end_sec": 17389.777,
    "zh": "他打电话来说",
    "vi": "cậu ấy gọi điện đến nói"
  },
  {
    "idx": 10385,
    "start": "04:49:49,777",
    "end": "04:49:51,097",
    "start_sec": 17389.777,
    "end_sec": 17391.097,
    "zh": "他把我肚子搞大了",
    "vi": "cậu ấy làm em có thai rồi"
  },
  {
    "idx": 10386,
    "start": "04:49:51,097",
    "end": "04:49:52,717",
    "start_sec": 17391.097,
    "end_sec": 17392.717,
    "zh": "要你别出门在家照顾我",
    "vi": "bảo anh đừng ra ngoài mà ở nhà chăm sóc em."
  },
  {
    "idx": 10387,
    "start": "04:49:52,717",
    "end": "04:49:53,937",
    "start_sec": 17392.717,
    "end_sec": 17393.937,
    "zh": "当时你还骂了他",
    "vi": "Lúc đó anh còn mắng cậu ấy."
  },
  {
    "idx": 10388,
    "start": "04:49:53,937",
    "end": "04:49:57,386",
    "start_sec": 17393.937,
    "end_sec": 17397.386,
    "zh": "现在我才知道那晚莲花小区有个大诡异连杀了十三栋楼的住户我估计要是把你出去了也是个死哼 那臭小子也不知道他怎么就知道我当时想出去的",
    "vi": "Bây giờ em mới biết đêm đó ở khu chung cư Liên Hoa có một"
  },
  {
    "idx": 10388,
    "start": "04:49:57,386",
    "end": "04:50:00,835",
    "start_sec": 17397.386,
    "end_sec": 17400.835,
    "zh": "现在我才知道那晚莲花小区有个大诡异连杀了十三栋楼的住户我估计要是把你出去了也是个死哼 那臭小子也不知道他怎么就知道我当时想出去的",
    "vi": "thế lực tà ác lớn đã giết sạch cư dân của mười ba tòa nhà"
  },
  {
    "idx": 10388,
    "start": "04:50:00,835",
    "end": "04:50:03,364",
    "start_sec": 17400.835,
    "end_sec": 17403.364,
    "zh": "现在我才知道那晚莲花小区有个大诡异连杀了十三栋楼的住户我估计要是把你出去了也是个死哼 那臭小子也不知道他怎么就知道我当时想出去的",
    "vi": "Em đoán nếu anh ra ngoài thì cũng chết chắc rồi"
  },
  {
    "idx": 10388,
    "start": "04:50:03,364",
    "end": "04:50:07,274",
    "start_sec": 17403.364,
    "end_sec": 17407.274,
    "zh": "现在我才知道那晚莲花小区有个大诡异连杀了十三栋楼的住户我估计要是把你出去了也是个死哼 那臭小子也不知道他怎么就知道我当时想出去的",
    "vi": "Hừ, thằng nhóc thối đó không biết làm sao biết được lúc đó tôi muốn ra ngoài"
  },
  {
    "idx": 10389,
    "start": "04:50:07,274",
    "end": "04:50:10,874",
    "start_sec": 17407.274,
    "end_sec": 17410.874,
    "zh": "居然能想到这么个狗屁法子留我在家",
    "vi": "mà lại nghĩ ra cái cách thối tha này để giữ tôi ở nhà."
  },
  {
    "idx": 10390,
    "start": "04:50:10,874",
    "end": "04:50:12,594",
    "start_sec": 17410.874,
    "end_sec": 17412.594,
    "zh": "我操 好好好",
    "vi": "Vãi thật. Tốt tốt tốt."
  },
  {
    "idx": 10391,
    "start": "04:50:12,594",
    "end": "04:50:13,774",
    "start_sec": 17412.594,
    "end_sec": 17413.774,
    "zh": "不愧是我呀",
    "vi": "Không hổ danh là tôi."
  },
  {
    "idx": 10392,
    "start": "04:50:13,774",
    "end": "04:50:15,394",
    "start_sec": 17413.774,
    "end_sec": 17415.394,
    "zh": "把夏桃红布子搞大了",
    "vi": "Làm cho Hạ Đào Hồng có thai"
  },
  {
    "idx": 10393,
    "start": "04:50:15,394",
    "end": "04:50:16,654",
    "start_sec": 17415.394,
    "end_sec": 17416.654,
    "zh": "这种法子也想得出来",
    "vi": "cách này mà cũng nghĩ ra được."
  },
  {
    "idx": 10394,
    "start": "04:50:16,654",
    "end": "04:50:19,154",
    "start_sec": 17416.654,
    "end_sec": 17419.154,
    "zh": "算了 今天要是见到他",
    "vi": "Bỏ đi. Hôm nay nếu gặp cậu ấy"
  },
  {
    "idx": 10395,
    "start": "04:50:19,154",
    "end": "04:50:21,714",
    "start_sec": 17419.154,
    "end_sec": 17421.714,
    "zh": "我就把那皇符送给那小子吧",
    "vi": "tôi sẽ tặng lá bùa vàng đó cho thằng nhóc đó."
  },
  {
    "idx": 10396,
    "start": "04:50:21,714",
    "end": "04:50:24,014",
    "start_sec": 17421.714,
    "end_sec": 17424.014,
    "zh": "也算是感谢他的提醒",
    "vi": "Coi như là để cảm ơn lời nhắc nhở của cậu ấy."
  },
  {
    "idx": 10397,
    "start": "04:50:24,014",
    "end": "04:50:26,834",
    "start_sec": 17424.014,
    "end_sec": 17426.834,
    "zh": "这时周赫山和几个年轻人",
    "vi": "Lúc này Chu Hách Sơn và vài người trẻ tuổi"
  },
  {
    "idx": 10398,
    "start": "04:50:26,834",
    "end": "04:50:28,014",
    "start_sec": 17426.834,
    "end_sec": 17428.014,
    "zh": "同便一方向走",
    "vi": "đi về cùng một hướng."
  },
  {
    "idx": 10399,
    "start": "04:50:28,014",
    "end": "04:50:30,254",
    "start_sec": 17428.014,
    "end_sec": 17430.254,
    "zh": "他看了一眼餐厅里的假生员",
    "vi": "Anh ta liếc nhìn những sinh viên giả trong nhà ăn"
  },
  {
    "idx": 10400,
    "start": "04:50:30,254",
    "end": "04:50:31,434",
    "start_sec": 17430.254,
    "end_sec": 17431.434,
    "zh": "怒头就要走",
    "vi": "quay đầu định đi."
  },
  {
    "idx": 10401,
    "start": "04:50:31,434",
    "end": "04:50:32,634",
    "start_sec": 17431.434,
    "end_sec": 17432.634,
    "zh": "按照剧情发展",
    "vi": "Theo tiến trình của cốt truyện"
  },
  {
    "idx": 10402,
    "start": "04:50:32,634",
    "end": "04:50:34,494",
    "start_sec": 17432.634,
    "end_sec": 17434.494,
    "zh": "周赫山现在应该是来抓单的",
    "vi": "Chu Hách Sơn lúc này đáng lẽ là đến để bắt người đi lẻ."
  },
  {
    "idx": 10403,
    "start": "04:50:34,494",
    "end": "04:50:36,214",
    "start_sec": 17434.494,
    "end_sec": 17436.214,
    "zh": "但现在有了夏叔这个导师在",
    "vi": "Nhưng bây giờ có chú Hạ là người hướng dẫn ở đây"
  },
  {
    "idx": 10404,
    "start": "04:50:36,214",
    "end": "04:50:37,754",
    "start_sec": 17436.214,
    "end_sec": 17437.754,
    "zh": "情况就完全不一样了",
    "vi": "tình hình đã hoàn toàn khác biệt."
  },
  {
    "idx": 10405,
    "start": "04:50:37,754",
    "end": "04:50:39,094",
    "start_sec": 17437.754,
    "end_sec": 17439.094,
    "zh": "走什么呢",
    "vi": "Đi đâu thế."
  },
  {
    "idx": 10406,
    "start": "04:50:39,094",
    "end": "04:50:40,214",
    "start_sec": 17439.094,
    "end_sec": 17440.214,
    "zh": "夏道长",
    "vi": "Đạo trưởng Hạ."
  },
  {
    "idx": 10407,
    "start": "04:50:40,214",
    "end": "04:50:40,634",
    "start_sec": 17440.214,
    "end_sec": 17440.634,
    "zh": "早",
    "vi": "Chào buổi sáng."
  },
  {
    "idx": 10408,
    "start": "04:50:40,634",
    "end": "04:50:41,474",
    "start_sec": 17440.634,
    "end_sec": 17441.474,
    "zh": "早啊",
    "vi": "Chào buổi sáng."
  },
  {
    "idx": 10409,
    "start": "04:50:41,474",
    "end": "04:50:44,574",
    "start_sec": 17441.474,
    "end_sec": 17444.574,
    "zh": "这么早带着几个男人闲过",
    "vi": "Sáng sớm thế này đã dẫn theo mấy người đàn ông đi loanh quanh"
  },
  {
    "idx": 10410,
    "start": "04:50:44,574",
    "end": "04:50:45,134",
    "start_sec": 17444.574,
    "end_sec": 17445.134,
    "zh": "怎么",
    "vi": "sao."
  },
  {
    "idx": 10411,
    "start": "04:50:45,134",
    "end": "04:50:47,574",
    "start_sec": 17445.134,
    "end_sec": 17447.574,
    "zh": "你这个分身还要找替身",
    "vi": "Phân thân này của ngươi còn muốn tìm kẻ thế mạng sao."
  },
  {
    "idx": 10412,
    "start": "04:50:47,574",
    "end": "04:50:48,654",
    "start_sec": 17447.574,
    "end_sec": 17448.654,
    "zh": "哎呦",
    "vi": "Ái chà."
  },
  {
    "idx": 10413,
    "start": "04:50:48,654",
    "end": "04:50:50,614",
    "start_sec": 17448.654,
    "end_sec": 17450.614,
    "zh": "夏道长你这说的什么话",
    "vi": "Đạo trưởng Hạ, ngài nói gì thế."
  },
  {
    "idx": 10414,
    "start": "04:50:50,614",
    "end": "04:50:52,014",
    "start_sec": 17450.614,
    "end_sec": 17452.014,
    "zh": "我就是带着保镖",
    "vi": "Ta chỉ là dẫn theo vệ sĩ."
  },
  {
    "idx": 10415,
    "start": "04:50:52,014",
    "end": "04:50:53,574",
    "start_sec": 17452.014,
    "end_sec": 17453.574,
    "zh": "没事出来溜达溜达",
    "vi": "Rảnh rỗi ra ngoài đi dạo chút thôi."
  },
  {
    "idx": 10416,
    "start": "04:50:53,574",
    "end": "04:50:54,654",
    "start_sec": 17453.574,
    "end_sec": 17454.654,
    "zh": "你也知道的",
    "vi": "Ngươi cũng biết đấy."
  },
  {
    "idx": 10417,
    "start": "04:50:54,654",
    "end": "04:50:55,874",
    "start_sec": 17454.654,
    "end_sec": 17455.874,
    "zh": "我身份特殊吗",
    "vi": "Thân phận của ta đặc biệt mà."
  },
  {
    "idx": 10418,
    "start": "04:50:55,874",
    "end": "04:50:57,774",
    "start_sec": 17455.874,
    "end_sec": 17457.774,
    "zh": "这么早出来溜达",
    "vi": "Ra ngoài đi dạo sớm thế này."
  },
  {
    "idx": 10419,
    "start": "04:50:57,774",
    "end": "04:51:00,494",
    "start_sec": 17457.774,
    "end_sec": 17460.494,
    "zh": "莫非你们也是来吃肉饭团的",
    "vi": "Chẳng lẽ các ngươi cũng đến để ăn cơm nắm thịt sao."
  },
  {
    "idx": 10420,
    "start": "04:51:00,494",
    "end": "04:51:01,314",
    "start_sec": 17460.494,
    "end_sec": 17461.314,
    "zh": "差",
    "vi": "Gần."
  },
  {
    "idx": 10421,
    "start": "04:51:01,314",
    "end": "04:51:02,594",
    "start_sec": 17461.314,
    "end_sec": 17462.594,
    "zh": "差不多吧",
    "vi": "Gần như vậy đi."
  },
  {
    "idx": 10422,
    "start": "04:51:02,594",
    "end": "04:51:04,434",
    "start_sec": 17462.594,
    "end_sec": 17464.434,
    "zh": "物账鬼幻化的周和珊分身",
    "vi": "Phân thân Chu Hòa San do Vật Chướng Quỷ biến thành."
  },
  {
    "idx": 10423,
    "start": "04:51:04,434",
    "end": "04:51:05,294",
    "start_sec": 17464.434,
    "end_sec": 17465.294,
    "zh": "生意发虚",
    "vi": "Giọng nói run rẩy."
  },
  {
    "idx": 10424,
    "start": "04:51:05,294",
    "end": "04:51:06,434",
    "start_sec": 17465.294,
    "end_sec": 17466.434,
    "zh": "不由的开始倒退",
    "vi": "Không tự chủ được mà bắt đầu lùi lại."
  },
  {
    "idx": 10425,
    "start": "04:51:06,434",
    "end": "04:51:07,574",
    "start_sec": 17466.434,
    "end_sec": 17467.574,
    "zh": "果然",
    "vi": "Quả nhiên."
  },
  {
    "idx": 10426,
    "start": "04:51:07,574",
    "end": "04:51:09,754",
    "start_sec": 17467.574,
    "end_sec": 17469.754,
    "zh": "这几个分身还是惧怕造法的",
    "vi": "Mấy phân thân này vẫn sợ hãi đạo pháp."
  },
  {
    "idx": 10427,
    "start": "04:51:09,754",
    "end": "04:51:11,394",
    "start_sec": 17469.754,
    "end_sec": 17471.394,
    "zh": "但要是真的本体诡异来了",
    "vi": "Nhưng nếu bản thể quỷ dị thật sự đến."
  },
  {
    "idx": 10428,
    "start": "04:51:11,394",
    "end": "04:51:12,914",
    "start_sec": 17471.394,
    "end_sec": 17472.914,
    "zh": "夏青园肯定对付不了",
    "vi": "Hạ Thanh Viên chắc chắn không đối phó nổi."
  },
  {
    "idx": 10429,
    "start": "04:51:12,914",
    "end": "04:51:13,674",
    "start_sec": 17472.914,
    "end_sec": 17473.674,
    "zh": "这时",
    "vi": "Lúc này."
  },
  {
    "idx": 10430,
    "start": "04:51:13,674",
    "end": "04:51:15,074",
    "start_sec": 17473.674,
    "end_sec": 17475.074,
    "zh": "夏青园猛的起身",
    "vi": "Hạ Thanh Viên đột ngột đứng dậy."
  },
  {
    "idx": 10431,
    "start": "04:51:15,074",
    "end": "04:51:16,074",
    "start_sec": 17475.074,
    "end_sec": 17476.074,
    "zh": "吵起人逼近",
    "vi": "Tiến lại gần bọn họ."
  },
  {
    "idx": 10432,
    "start": "04:51:16,074",
    "end": "04:51:18,534",
    "start_sec": 17476.074,
    "end_sec": 17478.534,
    "zh": "不是说要吃肉饭团吗",
    "vi": "Không phải nói muốn ăn cơm nắm thịt sao."
  },
  {
    "idx": 10433,
    "start": "04:51:18,534",
    "end": "04:51:20,094",
    "start_sec": 17478.534,
    "end_sec": 17480.094,
    "zh": "怎么又要走了",
    "vi": "Sao lại muốn đi rồi."
  },
  {
    "idx": 10434,
    "start": "04:51:20,094",
    "end": "04:51:21,894",
    "start_sec": 17480.094,
    "end_sec": 17481.894,
    "zh": "那的",
    "vi": "Đáng ghét."
  },
  {
    "idx": 10435,
    "start": "04:51:21,894",
    "end": "04:51:24,954",
    "start_sec": 17481.894,
    "end_sec": 17484.954,
    "zh": "你这个牛鼻子老大,不可以活路是吧?",
    "vi": "Lão mũi trâu nhà ngươi, không muốn sống nữa đúng không."
  },
  {
    "idx": 10436,
    "start": "04:51:25,334",
    "end": "04:51:26,854",
    "start_sec": 17485.334,
    "end_sec": 17486.854,
    "zh": "你们,给我拖住他。",
    "vi": "Các ngươi mau giữ chân hắn lại cho ta."
  },
  {
    "idx": 10437,
    "start": "04:51:28,214",
    "end": "04:51:29,794",
    "start_sec": 17488.214,
    "end_sec": 17489.794,
    "zh": "妖孽,懒惰暴刺。",
    "vi": "Yêu nghiệt, xem chiêu."
  },
  {
    "idx": 10438,
    "start": "04:51:30,314",
    "end": "04:51:33,894",
    "start_sec": 17490.314,
    "end_sec": 17493.894,
    "zh": "手就一抖,一串虫拳飙落而入,换成一柄虫拳剑。",
    "vi": "Cổ tay rung lên, một chuỗi tiền xu rơi xuống, hóa thành một thanh kiếm tiền xu."
  },
  {
    "idx": 10439,
    "start": "04:51:39,094",
    "end": "04:51:41,434",
    "start_sec": 17499.094,
    "end_sec": 17501.434,
    "zh": "在夏青园来不及抽出皇甫之剑,",
    "vi": "Khi Hạ Thanh Viên chưa kịp rút kiếm Hoàng Phủ ra."
  },
  {
    "idx": 10440,
    "start": "04:51:41,734",
    "end": "04:51:43,974",
    "start_sec": 17501.734,
    "end_sec": 17503.974,
    "zh": "陆上辉全身竭力挥向夏青园。",
    "vi": "Vật Chướng Quỷ dốc toàn lực lao về phía Hạ Thanh Viên."
  },
  {
    "idx": 10441,
    "start": "04:51:44,594",
    "end": "04:51:45,894",
    "start_sec": 17504.594,
    "end_sec": 17505.894,
    "zh": "忽然,一阵怪笑。",
    "vi": "Bỗng nhiên có tiếng cười quái dị vang lên."
  },
  {
    "idx": 10442,
    "start": "04:51:48,894",
    "end": "04:51:51,194",
    "start_sec": 17508.894,
    "end_sec": 17511.194,
    "zh": "两人听着怪笑,发出相同的声音。",
    "vi": "Hai người nghe tiếng cười quái dị, cùng phát ra âm thanh giống nhau."
  },
  {
    "idx": 10443,
    "start": "04:51:51,894",
    "end": "04:51:54,314",
    "start_sec": 17511.894,
    "end_sec": 17514.314,
    "zh": "难道这船上还有运轨是吗?",
    "vi": "Chẳng lẽ trên con tàu này vẫn còn quỷ sao."
  },
  {
    "idx": 10444,
    "start": "04:51:54,554",
    "end": "04:51:57,094",
    "start_sec": 17514.554,
    "end_sec": 17517.094,
    "zh": "不好,要将消息传递给班级。",
    "vi": "Không xong rồi, phải truyền tin tức này cho lớp học."
  },
  {
    "idx": 10445,
    "start": "04:51:57,654",
    "end": "04:51:59,174",
    "start_sec": 17517.654,
    "end_sec": 17519.174,
    "zh": "你也是,哪里跑?",
    "vi": "Ngươi cũng thế, chạy đi đâu."
  },
  {
    "idx": 10446,
    "start": "04:52:02,274",
    "end": "04:52:05,974",
    "start_sec": 17522.274,
    "end_sec": 17525.974,
    "zh": "不知是哪位道友相助,可否出来一见?",
    "vi": "Không biết là vị đạo hữu nào tương trợ, có thể ra ngoài gặp mặt một lần không."
  },
  {
    "idx": 10447,
    "start": "04:52:06,674",
    "end": "04:52:07,774",
    "start_sec": 17526.674,
    "end_sec": 17527.774,
    "zh": "夏叔,是我。",
    "vi": "Hạ thúc, là cháu."
  },
  {
    "idx": 10448,
    "start": "04:52:08,914",
    "end": "04:52:11,574",
    "start_sec": 17528.914,
    "end_sec": 17531.574,
    "zh": "诶,诚哥,你怎么从桌子底下钻出来了?",
    "vi": "Ơ, anh Thành, sao anh lại chui từ dưới gầm bàn ra thế."
  },
  {
    "idx": 10449,
    "start": "04:52:11,954",
    "end": "04:52:14,254",
    "start_sec": 17531.954,
    "end_sec": 17534.254,
    "zh": "臭小子,你不会是鬼吧?",
    "vi": "Thằng ranh con, cháu không phải là quỷ đấy chứ."
  },
  {
    "idx": 10450,
    "start": "04:52:14,414",
    "end": "04:52:16,274",
    "start_sec": 17534.414,
    "end_sec": 17536.274,
    "zh": "怎么会藏在桌子底下?",
    "vi": "Sao lại trốn dưới gầm bàn thế này."
  },
  {
    "idx": 10451,
    "start": "04:52:16,634",
    "end": "04:52:19,814",
    "start_sec": 17536.634,
    "end_sec": 17539.814,
    "zh": "碰巧罢了,我刚好查清事情,躲在了桌子下面。",
    "vi": "Chỉ là trùng hợp thôi, cháu vừa hay điều tra rõ sự tình nên trốn dưới gầm bàn."
  },
  {
    "idx": 10452,
    "start": "04:52:19,814",
    "end": "04:52:22,514",
    "start_sec": 17539.814,
    "end_sec": 17542.514,
    "zh": "夏青园打亮了橙子皮好一会儿",
    "vi": "Hạ Thanh Viên quan sát Trần Tử Bì một hồi lâu."
  },
  {
    "idx": 10453,
    "start": "04:52:22,514",
    "end": "04:52:23,214",
    "start_sec": 17542.514,
    "end_sec": 17543.214,
    "zh": "脸色红润",
    "vi": "Sắc mặt hồng hào."
  },
  {
    "idx": 10454,
    "start": "04:52:23,214",
    "end": "04:52:24,174",
    "start_sec": 17543.214,
    "end_sec": 17544.174,
    "zh": "中气十足",
    "vi": "Khí sắc tràn đầy."
  },
  {
    "idx": 10455,
    "start": "04:52:24,174",
    "end": "04:52:25,294",
    "start_sec": 17544.174,
    "end_sec": 17545.294,
    "zh": "确实不是鬼",
    "vi": "Quả thực không phải là quỷ."
  },
  {
    "idx": 10456,
    "start": "04:52:25,294",
    "end": "04:52:25,814",
    "start_sec": 17545.294,
    "end_sec": 17545.814,
    "zh": "不是",
    "vi": "Không phải."
  },
  {
    "idx": 10457,
    "start": "04:52:25,814",
    "end": "04:52:26,594",
    "start_sec": 17545.814,
    "end_sec": 17546.594,
    "zh": "夏叔",
    "vi": "Hạ thúc."
  },
  {
    "idx": 10458,
    "start": "04:52:26,594",
    "end": "04:52:28,134",
    "start_sec": 17546.594,
    "end_sec": 17548.134,
    "zh": "咱一见面你就说这些啊",
    "vi": "Chúng ta vừa gặp mặt chú đã nói những lời này rồi."
  },
  {
    "idx": 10459,
    "start": "04:52:28,134",
    "end": "04:52:29,274",
    "start_sec": 17548.134,
    "end_sec": 17549.274,
    "zh": "你不会还在怪我吧",
    "vi": "Chú không phải vẫn còn trách cháu đấy chứ."
  },
  {
    "idx": 10460,
    "start": "04:52:29,274",
    "end": "04:52:30,874",
    "start_sec": 17549.274,
    "end_sec": 17550.874,
    "zh": "我真没碰你闺女啊",
    "vi": "Cháu thực sự không động vào con gái chú mà."
  },
  {
    "idx": 10461,
    "start": "04:52:30,874",
    "end": "04:52:32,014",
    "start_sec": 17550.874,
    "end_sec": 17552.014,
    "zh": "这人坐回桌子上",
    "vi": "Người này ngồi lại vào bàn."
  },
  {
    "idx": 10462,
    "start": "04:52:32,014",
    "end": "04:52:32,934",
    "start_sec": 17552.014,
    "end_sec": 17552.934,
    "zh": "其乐融融的",
    "vi": "Trông rất hòa thuận."
  },
  {
    "idx": 10463,
    "start": "04:52:32,934",
    "end": "04:52:33,774",
    "start_sec": 17552.934,
    "end_sec": 17553.774,
    "zh": "好像一家人",
    "vi": "Giống như một gia đình."
  },
  {
    "idx": 10464,
    "start": "04:52:33,774",
    "end": "04:52:35,554",
    "start_sec": 17553.774,
    "end_sec": 17555.554,
    "zh": "夏竹清歪过脑袋来问",
    "vi": "Hạ Trúc Thanh nghiêng đầu hỏi."
  },
  {
    "idx": 10465,
    "start": "04:52:35,554",
    "end": "04:52:36,374",
    "start_sec": 17555.554,
    "end_sec": 17556.374,
    "zh": "皮哥",
    "vi": "Anh Bì."
  },
  {
    "idx": 10466,
    "start": "04:52:36,374",
    "end": "04:52:38,074",
    "start_sec": 17556.374,
    "end_sec": 17558.074,
    "zh": "你那天打完电话后",
    "vi": "Hôm đó sau khi anh gọi điện xong."
  },
  {
    "idx": 10467,
    "start": "04:52:38,074",
    "end": "04:52:39,534",
    "start_sec": 17558.074,
    "end_sec": 17559.534,
    "zh": "是怎么逃出去的",
    "vi": "Thì đã trốn thoát bằng cách nào vậy."
  },
  {
    "idx": 10468,
    "start": "04:52:39,534",
    "end": "04:52:40,494",
    "start_sec": 17559.534,
    "end_sec": 17560.494,
    "zh": "我跟你说",
    "vi": "Để em nói cho anh nghe."
  },
  {
    "idx": 10469,
    "start": "04:52:40,494",
    "end": "04:52:42,554",
    "start_sec": 17560.494,
    "end_sec": 17562.554,
    "zh": "要不是当时我们一家曹德基",
    "vi": "Nếu không phải lúc đó cả nhà chúng ta chạy nhanh."
  },
  {
    "idx": 10470,
    "start": "04:52:42,554",
    "end": "04:52:43,354",
    "start_sec": 17562.554,
    "end_sec": 17563.354,
    "zh": "没拿手机",
    "vi": "Không mang theo điện thoại."
  },
  {
    "idx": 10471,
    "start": "04:52:43,354",
    "end": "04:52:45,694",
    "start_sec": 17563.354,
    "end_sec": 17565.694,
    "zh": "我姐姐肯定要打报你的电话",
    "vi": "Chị cháu chắc chắn sẽ gọi cháy máy chú đấy."
  },
  {
    "idx": 10472,
    "start": "04:52:45,694",
    "end": "04:52:47,334",
    "start_sec": 17565.694,
    "end_sec": 17567.334,
    "zh": "这个说来话长",
    "vi": "Chuyện này nói ra dài dòng lắm."
  },
  {
    "idx": 10473,
    "start": "04:52:47,334",
    "end": "04:52:49,074",
    "start_sec": 17567.334,
    "end_sec": 17569.074,
    "zh": "我说橙子皮",
    "vi": "Chú nói này Trần Tử Bì."
  },
  {
    "idx": 10474,
    "start": "04:52:49,074",
    "end": "04:52:50,174",
    "start_sec": 17569.074,
    "end_sec": 17570.174,
    "zh": "你很皮啊",
    "vi": "Cháu nghịch ngợm thật đấy."
  },
  {
    "idx": 10475,
    "start": "04:52:50,174",
    "end": "04:52:52,554",
    "start_sec": 17570.174,
    "end_sec": 17572.554,
    "zh": "居然敢说出糟蹋我闺女的话",
    "vi": "Dám nói ra mấy lời làm hại con gái chú."
  },
  {
    "idx": 10476,
    "start": "04:52:52,554",
    "end": "04:52:53,394",
    "start_sec": 17572.554,
    "end_sec": 17573.394,
    "zh": "夏叔",
    "vi": "Chú Hạ."
  },
  {
    "idx": 10477,
    "start": "04:52:53,394",
    "end": "04:52:54,734",
    "start_sec": 17573.394,
    "end_sec": 17574.734,
    "zh": "这也是无奈之举啊",
    "vi": "Cháu cũng bất đắc dĩ thôi mà."
  },
  {
    "idx": 10478,
    "start": "04:52:54,734",
    "end": "04:52:55,634",
    "start_sec": 17574.734,
    "end_sec": 17575.634,
    "zh": "我不这么说的话",
    "vi": "Nếu cháu không nói thế."
  },
  {
    "idx": 10479,
    "start": "04:52:55,634",
    "end": "04:52:56,554",
    "start_sec": 17575.634,
    "end_sec": 17576.554,
    "zh": "就你这暴脾气",
    "vi": "Với cái tính nóng nảy của chú."
  },
  {
    "idx": 10480,
    "start": "04:52:56,554",
    "end": "04:52:58,094",
    "start_sec": 17576.554,
    "end_sec": 17578.094,
    "zh": "谁能留你在家呀",
    "vi": "Ai dám giữ chú ở lại nhà chứ."
  },
  {
    "idx": 10481,
    "start": "04:52:58,094",
    "end": "04:52:58,714",
    "start_sec": 17578.094,
    "end_sec": 17578.714,
    "zh": "这也是",
    "vi": "Cũng đúng."
  },
  {
    "idx": 10482,
    "start": "04:52:58,714",
    "end": "04:53:01,194",
    "start_sec": 17578.714,
    "end_sec": 17581.194,
    "zh": "话说刚才是你小子帮的我",
    "vi": "Mà này, vừa rồi là nhóc cháu giúp chú à."
  },
  {
    "idx": 10483,
    "start": "04:53:01,194",
    "end": "04:53:02,634",
    "start_sec": 17581.194,
    "end_sec": 17582.634,
    "zh": "我皇符都没用上",
    "vi": "Chú còn chưa kịp dùng đến Hoàng Phù."
  },
  {
    "idx": 10484,
    "start": "04:53:02,634",
    "end": "04:53:05,974",
    "start_sec": 17582.634,
    "end_sec": 17585.974,
    "zh": "那幻化成周赫山的诡异便急着要跑",
    "vi": "Thì con quỷ biến thành Chu Hách Sơn đã vội vàng bỏ chạy."
  },
  {
    "idx": 10485,
    "start": "04:53:05,974",
    "end": "04:53:07,214",
    "start_sec": 17585.974,
    "end_sec": 17587.214,
    "zh": "长着皮想了想",
    "vi": "Trần Tử Bì suy nghĩ một lát."
  },
  {
    "idx": 10486,
    "start": "04:53:07,214",
    "end": "04:53:09,274",
    "start_sec": 17587.214,
    "end_sec": 17589.274,
    "zh": "给夏家这女孩子的诡异",
    "vi": "Con quỷ bám theo cô con gái nhà họ Hạ này."
  },
  {
    "idx": 10487,
    "start": "04:53:09,274",
    "end": "04:53:10,314",
    "start_sec": 17589.274,
    "end_sec": 17590.314,
    "zh": "小子",
    "vi": "Nhóc con."
  },
  {
    "idx": 10488,
    "start": "04:53:10,314",
    "end": "04:53:13,354",
    "start_sec": 17590.314,
    "end_sec": 17593.354,
    "zh": "你这诡异的诡异凝结魂后不简单啊",
    "vi": "Con quỷ sau khi ngưng kết hồn của cháu không hề đơn giản đâu."
  },
  {
    "idx": 10489,
    "start": "04:53:13,354",
    "end": "04:53:15,434",
    "start_sec": 17593.354,
    "end_sec": 17595.434,
    "zh": "我也不多问你怎么驾驭的她",
    "vi": "Chú cũng không hỏi nhiều về việc cháu khống chế nó thế nào."
  },
  {
    "idx": 10490,
    "start": "04:53:15,434",
    "end": "04:53:16,834",
    "start_sec": 17595.434,
    "end_sec": 17596.834,
    "zh": "我就给你歇这个吧",
    "vi": "Chú cho cháu mấy thứ này vậy."
  },
  {
    "idx": 10491,
    "start": "04:53:16,834",
    "end": "04:53:18,654",
    "start_sec": 17596.834,
    "end_sec": 17598.654,
    "zh": "应该对你有所帮助",
    "vi": "Chắc là sẽ giúp ích cho cháu."
  },
  {
    "idx": 10492,
    "start": "04:53:18,654",
    "end": "04:53:20,934",
    "start_sec": 17598.654,
    "end_sec": 17600.934,
    "zh": "三张皇符",
    "vi": "Ba lá Hoàng Phù."
  },
  {
    "idx": 10493,
    "start": "04:53:20,934",
    "end": "04:53:22,234",
    "start_sec": 17600.934,
    "end_sec": 17602.234,
    "zh": "这皇符的材质",
    "vi": "Chất liệu của lá Hoàng Phù này."
  },
  {
    "idx": 10494,
    "start": "04:53:22,234",
    "end": "04:53:24,454",
    "start_sec": 17602.234,
    "end_sec": 17604.454,
    "zh": "摸起来跟徐东来的提神纸相似",
    "vi": "Sờ vào thấy giống với giấy tỉnh táo của Từ Đông Lai."
  },
  {
    "idx": 10495,
    "start": "04:53:24,454",
    "end": "04:53:26,094",
    "start_sec": 17604.454,
    "end_sec": 17606.094,
    "zh": "碧铁符",
    "vi": "Bích Thiết Phù."
  },
  {
    "idx": 10496,
    "start": "04:53:26,094",
    "end": "04:53:28,854",
    "start_sec": 17606.094,
    "end_sec": 17608.854,
    "zh": "可小幅度降低诡异的污染",
    "vi": "Có thể giảm nhẹ sự ô nhiễm của quỷ dị."
  },
  {
    "idx": 10497,
    "start": "04:53:28,854",
    "end": "04:53:29,954",
    "start_sec": 17608.854,
    "end_sec": 17609.954,
    "zh": "是否现迹",
    "vi": "Có hiến tế không."
  },
  {
    "idx": 10498,
    "start": "04:53:29,954",
    "end": "04:53:31,414",
    "start_sec": 17609.954,
    "end_sec": 17611.414,
    "zh": "三张碧铁符",
    "vi": "Ba lá Bích Thiết Phù."
  },
  {
    "idx": 10499,
    "start": "04:53:31,414",
    "end": "04:53:33,334",
    "start_sec": 17611.414,
    "end_sec": 17613.334,
    "zh": "可以换取一条信息",
    "vi": "Có thể đổi lấy một thông tin."
  },
  {
    "idx": 10500,
    "start": "04:53:33,334",
    "end": "04:53:34,854",
    "start_sec": 17613.334,
    "end_sec": 17614.854,
    "zh": "或者一道鬼门",
    "vi": "Hoặc một Quỷ Môn."
  },
  {
    "idx": 10501,
    "start": "04:53:34,854",
    "end": "04:53:35,454",
    "start_sec": 17614.854,
    "end_sec": 17615.454,
    "zh": "突然",
    "vi": "Đột nhiên."
  },
  {
    "idx": 10502,
    "start": "04:53:35,454",
    "end": "04:53:37,474",
    "start_sec": 17615.454,
    "end_sec": 17617.474,
    "zh": "许久未曾出现的香炉声音",
    "vi": "Giọng nói của lư hương đã lâu không xuất hiện."
  },
  {
    "idx": 10503,
    "start": "04:53:37,474",
    "end": "04:53:39,134",
    "start_sec": 17617.474,
    "end_sec": 17619.134,
    "zh": "在橙子皮脑海里响响",
    "vi": "Vang lên trong đầu Trần Tử Bì."
  },
  {
    "idx": 10504,
    "start": "04:53:39,134",
    "end": "04:53:40,114",
    "start_sec": 17619.134,
    "end_sec": 17620.114,
    "zh": "果然",
    "vi": "Quả nhiên."
  },
  {
    "idx": 10505,
    "start": "04:53:40,114",
    "end": "04:53:42,514",
    "start_sec": 17620.114,
    "end_sec": 17622.514,
    "zh": "这材质是与徐东来的提神纸一样的",
    "vi": "Chất liệu này giống hệt với giấy thế thân của Từ Đông Lai."
  },
  {
    "idx": 10506,
    "start": "04:53:42,514",
    "end": "04:53:43,774",
    "start_sec": 17622.514,
    "end_sec": 17623.774,
    "zh": "所以达到了现迹标准",
    "vi": "Nên đã đạt tiêu chuẩn hiển linh."
  },
  {
    "idx": 10507,
    "start": "04:53:43,774",
    "end": "04:53:44,454",
    "start_sec": 17623.774,
    "end_sec": 17624.454,
    "zh": "只不过",
    "vi": "Có điều."
  },
  {
    "idx": 10508,
    "start": "04:53:44,454",
    "end": "04:53:45,174",
    "start_sec": 17624.454,
    "end_sec": 17625.174,
    "zh": "这三个符",
    "vi": "Ba lá bùa này."
  },
  {
    "idx": 10509,
    "start": "04:53:45,174",
    "end": "04:53:46,114",
    "start_sec": 17625.174,
    "end_sec": 17626.114,
    "zh": "才换一道鬼门",
    "vi": "Mới đổi được một cánh cửa quỷ."
  },
  {
    "idx": 10510,
    "start": "04:53:46,114",
    "end": "04:53:47,174",
    "start_sec": 17626.114,
    "end_sec": 17627.174,
    "zh": "这也太廉价了吧",
    "vi": "Thế này thì rẻ mạt quá rồi."
  },
  {
    "idx": 10511,
    "start": "04:53:47,174",
    "end": "04:53:48,134",
    "start_sec": 17627.174,
    "end_sec": 17628.134,
    "zh": "夏叔",
    "vi": "Chú Hạ."
  },
  {
    "idx": 10512,
    "start": "04:53:48,134",
    "end": "04:53:49,694",
    "start_sec": 17628.134,
    "end_sec": 17629.694,
    "zh": "你是不是还做过指人啊",
    "vi": "Có phải chú từng làm người giấy không."
  },
  {
    "idx": 10513,
    "start": "04:53:49,694",
    "end": "04:53:51,074",
    "start_sec": 17629.694,
    "end_sec": 17631.074,
    "zh": "你怎么知道的",
    "vi": "Sao cháu biết được."
  },
  {
    "idx": 10514,
    "start": "04:53:51,074",
    "end": "04:53:52,214",
    "start_sec": 17631.074,
    "end_sec": 17632.214,
    "zh": "我见过徐东来",
    "vi": "Cháu từng gặp Từ Đông Lai."
  },
  {
    "idx": 10515,
    "start": "04:53:52,214",
    "end": "04:53:52,934",
    "start_sec": 17632.214,
    "end_sec": 17632.934,
    "zh": "哦",
    "vi": "Ồ."
  },
  {
    "idx": 10516,
    "start": "04:53:52,934",
    "end": "04:53:55,134",
    "start_sec": 17632.934,
    "end_sec": 17635.134,
    "zh": "他的替身指人是我做的",
    "vi": "Người giấy thế thân của cậu ta là do chú làm."
  },
  {
    "idx": 10517,
    "start": "04:53:55,134",
    "end": "04:53:56,294",
    "start_sec": 17635.134,
    "end_sec": 17636.294,
    "zh": "有什么说法吗",
    "vi": "Có bí mật gì trong đó sao."
  },
  {
    "idx": 10518,
    "start": "04:53:56,294",
    "end": "04:53:58,174",
    "start_sec": 17636.294,
    "end_sec": 17638.174,
    "zh": "我怎么觉得指人比较厉害点",
    "vi": "Sao cháu thấy người giấy có vẻ lợi hại hơn."
  },
  {
    "idx": 10519,
    "start": "04:53:58,174",
    "end": "04:53:59,394",
    "start_sec": 17638.174,
    "end_sec": 17639.394,
    "zh": "有说法",
    "vi": "Đúng là có bí mật."
  },
  {
    "idx": 10520,
    "start": "04:53:59,394",
    "end": "04:54:00,794",
    "start_sec": 17639.394,
    "end_sec": 17640.794,
    "zh": "他那指人上的符文",
    "vi": "Phù văn trên người giấy của cậu ta."
  },
  {
    "idx": 10521,
    "start": "04:54:00,794",
    "end": "04:54:03,074",
    "start_sec": 17640.794,
    "end_sec": 17643.074,
    "zh": "是用惨死的婴儿血化的",
    "vi": "Được vẽ bằng máu của trẻ sơ sinh chết oan."
  },
  {
    "idx": 10522,
    "start": "04:54:03,074",
    "end": "04:54:05,794",
    "start_sec": 17643.074,
    "end_sec": 17645.794,
    "zh": "并且我从那些遇鬼者那里听说",
    "vi": "Hơn nữa chú nghe những người gặp quỷ kể lại."
  },
  {
    "idx": 10523,
    "start": "04:54:05,794",
    "end": "04:54:07,034",
    "start_sec": 17645.794,
    "end_sec": 17647.034,
    "zh": "在鬼一降临后",
    "vi": "Sau khi Quỷ Y xuất hiện."
  },
  {
    "idx": 10524,
    "start": "04:54:07,034",
    "end": "04:54:09,034",
    "start_sec": 17647.034,
    "end_sec": 17649.034,
    "zh": "那些婴儿都变成了鬼一",
    "vi": "Những đứa trẻ đó đều biến thành Quỷ Y."
  },
  {
    "idx": 10525,
    "start": "04:54:09,034",
    "end": "04:54:09,554",
    "start_sec": 17649.034,
    "end_sec": 17649.554,
    "zh": "这么说",
    "vi": "Nói như vậy."
  },
  {
    "idx": 10526,
    "start": "04:54:09,554",
    "end": "04:54:11,314",
    "start_sec": 17649.554,
    "end_sec": 17651.314,
    "zh": "其实不是替身指人厉害",
    "vi": "Thực ra không phải người giấy thế thân lợi hại."
  },
  {
    "idx": 10527,
    "start": "04:54:11,314",
    "end": "04:54:13,014",
    "start_sec": 17651.314,
    "end_sec": 17653.014,
    "zh": "而是岁月的主人变成了鬼一",
    "vi": "Mà là chủ nhân của dòng máu đã biến thành Quỷ Y."
  },
  {
    "idx": 10528,
    "start": "04:54:13,014",
    "end": "04:54:14,154",
    "start_sec": 17653.014,
    "end_sec": 17654.154,
    "zh": "才有了大效果",
    "vi": "Mới mang lại hiệu quả lớn."
  },
  {
    "idx": 10529,
    "start": "04:54:14,154",
    "end": "04:54:15,294",
    "start_sec": 17654.154,
    "end_sec": 17655.294,
    "zh": "可以这么理解",
    "vi": "Có thể hiểu như vậy."
  },
  {
    "idx": 10530,
    "start": "04:54:15,294",
    "end": "04:54:18,694",
    "start_sec": 17655.294,
    "end_sec": 17658.694,
    "zh": "其实气深指人本就需要阴气重的东西为引",
    "vi": "Thực ra người giấy thế thân vốn cần thứ có âm khí nặng làm vật dẫn."
  },
  {
    "idx": 10531,
    "start": "04:54:18,694",
    "end": "04:54:21,274",
    "start_sec": 17658.694,
    "end_sec": 17661.274,
    "zh": "这样才方便吸引那些鬼异",
    "vi": "Như vậy mới dễ thu hút những con Quỷ Dị đó."
  },
  {
    "idx": 10532,
    "start": "04:54:21,274",
    "end": "04:54:22,274",
    "start_sec": 17661.274,
    "end_sec": 17662.274,
    "zh": "现在想来",
    "vi": "Bây giờ nghĩ lại."
  },
  {
    "idx": 10533,
    "start": "04:54:22,274",
    "end": "04:54:23,654",
    "start_sec": 17662.274,
    "end_sec": 17663.654,
    "zh": "自从鬼异降临后",
    "vi": "Kể từ khi Quỷ Dị giáng thế."
  },
  {
    "idx": 10534,
    "start": "04:54:23,654",
    "end": "04:54:25,174",
    "start_sec": 17663.654,
    "end_sec": 17665.174,
    "zh": "鬼异一直在变强",
    "vi": "Quỷ Dị vẫn luôn mạnh lên."
  },
  {
    "idx": 10535,
    "start": "04:54:25,174",
    "end": "04:54:28,734",
    "start_sec": 17665.174,
    "end_sec": 17668.734,
    "zh": "所以这一死鹰血化的符录自然也变强了",
    "vi": "Nên lá bùa hóa từ máu chim ưng chết này tự nhiên cũng mạnh lên theo."
  },
  {
    "idx": 10536,
    "start": "04:54:28,734",
    "end": "04:54:29,654",
    "start_sec": 17668.734,
    "end_sec": 17669.654,
    "zh": "原来如此",
    "vi": "Hóa ra là vậy."
  },
  {
    "idx": 10537,
    "start": "04:54:29,654",
    "end": "04:54:31,894",
    "start_sec": 17669.654,
    "end_sec": 17671.894,
    "zh": "到头来还是要用鬼异对付鬼异",
    "vi": "Suy cho cùng vẫn phải dùng Quỷ Dị để đối phó Quỷ Dị."
  },
  {
    "idx": 10538,
    "start": "04:54:31,894",
    "end": "04:54:32,694",
    "start_sec": 17671.894,
    "end_sec": 17672.694,
    "zh": "对了",
    "vi": "Đúng rồi."
  },
  {
    "idx": 10539,
    "start": "04:54:32,694",
    "end": "04:54:33,234",
    "start_sec": 17672.694,
    "end_sec": 17673.234,
    "zh": "夏叔",
    "vi": "Chú Hạ."
  },
  {
    "idx": 10540,
    "start": "04:54:33,234",
    "end": "04:54:34,674",
    "start_sec": 17673.234,
    "end_sec": 17674.674,
    "zh": "有件事要拜托你",
    "vi": "Cháu có việc muốn nhờ chú."
  },
  {
    "idx": 10541,
    "start": "04:54:34,674",
    "end": "04:54:35,274",
    "start_sec": 17674.674,
    "end_sec": 17675.274,
    "zh": "什么事",
    "vi": "Chuyện gì thế."
  },
  {
    "idx": 10542,
    "start": "04:54:35,274",
    "end": "04:54:36,574",
    "start_sec": 17675.274,
    "end_sec": 17676.574,
    "zh": "026你知道吧",
    "vi": "Số 026 chú biết chứ."
  },
  {
    "idx": 10543,
    "start": "04:54:36,574",
    "end": "04:54:38,434",
    "start_sec": 17676.574,
    "end_sec": 17678.434,
    "zh": "就是船上能驾驭水鬼的遇鬼者",
    "vi": "Chính là người ngự quỷ có thể điều khiển thủy quỷ trên tàu."
  },
  {
    "idx": 10544,
    "start": "04:54:38,434",
    "end": "04:54:40,554",
    "start_sec": 17678.434,
    "end_sec": 17680.554,
    "zh": "我担心鬼异会通过他叔叔徐天志",
    "vi": "Cháu lo Quỷ Dị sẽ thông qua chú của cậu ta là Từ Thiên Chí."
  },
  {
    "idx": 10545,
    "start": "04:54:40,554",
    "end": "04:54:41,474",
    "start_sec": 17680.554,
    "end_sec": 17681.474,
    "zh": "对他下黑手",
    "vi": "Để ra tay hãm hại cậu ta."
  },
  {
    "idx": 10546,
    "start": "04:54:41,474",
    "end": "04:54:42,914",
    "start_sec": 17681.474,
    "end_sec": 17682.914,
    "zh": "要是他一个人落单的时候",
    "vi": "Nếu lúc cậu ta đi một mình."
  },
  {
    "idx": 10547,
    "start": "04:54:42,914",
    "end": "04:54:44,214",
    "start_sec": 17682.914,
    "end_sec": 17684.214,
    "zh": "还要麻烦你跟下他",
    "vi": "Thì phiền chú đi theo bảo vệ cậu ta nhé."
  },
  {
    "idx": 10548,
    "start": "04:54:44,214",
    "end": "04:54:45,334",
    "start_sec": 17684.214,
    "end_sec": 17685.334,
    "zh": "我跟了他",
    "vi": "Chú đi theo cậu ta."
  },
  {
    "idx": 10549,
    "start": "04:54:45,334",
    "end": "04:54:46,734",
    "start_sec": 17685.334,
    "end_sec": 17686.734,
    "zh": "我孩子怎么办",
    "vi": "Thế còn con của chú thì sao."
  },
  {
    "idx": 10550,
    "start": "04:54:46,734",
    "end": "04:54:47,574",
    "start_sec": 17686.734,
    "end_sec": 17687.574,
    "zh": "跟你啊",
    "vi": "Đi theo cháu chứ sao."
  },
  {
    "idx": 10551,
    "start": "04:54:47,574",
    "end": "04:54:48,514",
    "start_sec": 17687.574,
    "end_sec": 17688.514,
    "zh": "这个你放心",
    "vi": "Chuyện này chú cứ yên tâm."
  },
  {
    "idx": 10552,
    "start": "04:54:48,514",
    "end": "04:54:49,954",
    "start_sec": 17688.514,
    "end_sec": 17689.954,
    "zh": "他俩必然不会有事",
    "vi": "Hai đứa nhỏ chắc chắn sẽ không sao đâu."
  },
  {
    "idx": 10553,
    "start": "04:54:49,954",
    "end": "04:54:50,614",
    "start_sec": 17689.954,
    "end_sec": 17690.614,
    "zh": "好吧",
    "vi": "Được rồi."
  },
  {
    "idx": 10554,
    "start": "04:54:50,614",
    "end": "04:54:53,134",
    "start_sec": 17690.614,
    "end_sec": 17693.134,
    "zh": "也不知道你小子哪来的自信",
    "vi": "Cũng không biết nhóc con cháu lấy đâu ra tự tin thế."
  },
  {
    "idx": 10555,
    "start": "04:54:53,134",
    "end": "04:54:59,442",
    "start_sec": 17693.134,
    "end_sec": 17699.442,
    "zh": "但你说的事有时候真的让人不得不信天色渐亮陆续有常客来到打听夏道长又几早吃肉饭团啊夏道长早啊不断的公威声传来",
    "vi": "Nhưng những gì cháu nói đôi khi thực sự khiến người ta phải tin"
  },
  {
    "idx": 10555,
    "start": "04:54:59,442",
    "end": "04:55:05,751",
    "start_sec": 17699.442,
    "end_sec": 17705.751,
    "zh": "但你说的事有时候真的让人不得不信天色渐亮陆续有常客来到打听夏道长又几早吃肉饭团啊夏道长早啊不断的公威声传来",
    "vi": "Trời dần sáng, khách quen lần lượt kéo đến chào hỏi Đạo trưởng Hạ"
  },
  {
    "idx": 10556,
    "start": "04:55:05,751",
    "end": "04:55:06,431",
    "start_sec": 17705.751,
    "end_sec": 17706.431,
    "zh": "不得不说",
    "vi": "Phải thừa nhận rằng."
  },
  {
    "idx": 10557,
    "start": "04:55:06,431",
    "end": "04:55:07,891",
    "start_sec": 17706.431,
    "end_sec": 17707.891,
    "zh": "身为道士的夏清源",
    "vi": "Với tư cách là một đạo sĩ, Hạ Thanh Nguyên."
  },
  {
    "idx": 10558,
    "start": "04:55:07,891",
    "end": "04:55:09,291",
    "start_sec": 17707.891,
    "end_sec": 17709.291,
    "zh": "在蜀光号上的地位",
    "vi": "Địa vị của chú ấy trên tàu Thự Quang."
  },
  {
    "idx": 10559,
    "start": "04:55:09,291",
    "end": "04:55:10,931",
    "start_sec": 17709.291,
    "end_sec": 17710.931,
    "zh": "也仅次于那几个迂回者",
    "vi": "Cũng chỉ đứng sau vài người ngự quỷ kia."
  },
  {
    "idx": 10560,
    "start": "04:55:10,931",
    "end": "04:55:13,311",
    "start_sec": 17710.931,
    "end_sec": 17713.311,
    "zh": "热腾腾的肉饭团被送了上来",
    "vi": "Những nắm cơm thịt nóng hổi được bưng lên."
  },
  {
    "idx": 10561,
    "start": "04:55:13,311",
    "end": "04:55:15,771",
    "start_sec": 17713.311,
    "end_sec": 17715.771,
    "zh": "夏竹青吃的满嘴是由一脸的幸福",
    "vi": "Hạ Trúc Thanh ăn đến dính đầy miệng nhưng gương mặt tràn ngập hạnh phúc."
  },
  {
    "idx": 10562,
    "start": "04:55:15,771",
    "end": "04:55:16,611",
    "start_sec": 17715.771,
    "end_sec": 17716.611,
    "zh": "果然啊",
    "vi": "Quả nhiên là vậy."
  },
  {
    "idx": 10563,
    "start": "04:55:16,611",
    "end": "04:55:17,891",
    "start_sec": 17716.611,
    "end_sec": 17717.891,
    "zh": "有爸的孩子就是不一样",
    "vi": "Đứa trẻ có bố ở bên cạnh quả nhiên rất khác biệt."
  },
  {
    "idx": 10564,
    "start": "04:55:17,891",
    "end": "04:55:19,631",
    "start_sec": 17717.891,
    "end_sec": 17719.631,
    "zh": "相比上次见到的夏竹青",
    "vi": "So với Hạ Trúc Thanh mà tôi gặp lần trước."
  },
  {
    "idx": 10565,
    "start": "04:55:19,631",
    "end": "04:55:20,691",
    "start_sec": 17719.631,
    "end_sec": 17720.691,
    "zh": "简直天壤之毒",
    "vi": "Đúng là khác biệt một trời một vực."
  },
  {
    "idx": 10566,
    "start": "04:55:20,691",
    "end": "04:55:22,151",
    "start_sec": 17720.691,
    "end_sec": 17722.151,
    "zh": "电梯门再次打开",
    "vi": "Cửa thang máy lại mở ra."
  },
  {
    "idx": 10567,
    "start": "04:55:22,151",
    "end": "04:55:24,071",
    "start_sec": 17722.151,
    "end_sec": 17724.071,
    "zh": "026代的徐天志和周扬",
    "vi": "Từ Thiên Chí của thế hệ 026 và Chu Dương."
  },
  {
    "idx": 10568,
    "start": "04:55:24,071",
    "end": "04:55:25,271",
    "start_sec": 17724.071,
    "end_sec": 17725.271,
    "zh": "有说有笑的狗狗",
    "vi": "Vừa đi qua vừa nói cười vui vẻ."
  },
  {
    "idx": 10569,
    "start": "04:55:25,271",
    "end": "04:55:26,731",
    "start_sec": 17725.271,
    "end_sec": 17726.731,
    "zh": "直接忽视掉橙子皮",
    "vi": "Họ trực tiếp phớt lờ Trần Tử Bì."
  },
  {
    "idx": 10570,
    "start": "04:55:26,731",
    "end": "04:55:27,451",
    "start_sec": 17726.731,
    "end_sec": 17727.451,
    "zh": "获得一桌",
    "vi": "Đi về phía bàn ăn."
  },
  {
    "idx": 10571,
    "start": "04:55:27,451",
    "end": "04:55:29,311",
    "start_sec": 17727.451,
    "end_sec": 17729.311,
    "zh": "真是麻烦周公子了",
    "vi": "Thật là làm phiền Chu công tử quá."
  },
  {
    "idx": 10572,
    "start": "04:55:29,311",
    "end": "04:55:31,291",
    "start_sec": 17729.311,
    "end_sec": 17731.291,
    "zh": "让蜀光号多停几天吧",
    "vi": "Xin hãy để tàu Thục Quang dừng lại thêm vài ngày."
  },
  {
    "idx": 10573,
    "start": "04:55:31,291",
    "end": "04:55:33,211",
    "start_sec": 17731.291,
    "end_sec": 17733.211,
    "zh": "东来那孩子要是能回来",
    "vi": "Nếu thằng bé Đông Lai có thể trở về."
  },
  {
    "idx": 10574,
    "start": "04:55:33,211",
    "end": "04:55:35,091",
    "start_sec": 17733.211,
    "end_sec": 17735.091,
    "zh": "我高低让他给您磕几个",
    "vi": "Tôi nhất định sẽ bảo nó dập đầu tạ ơn cậu."
  },
  {
    "idx": 10575,
    "start": "04:55:35,091",
    "end": "04:55:36,071",
    "start_sec": 17735.091,
    "end_sec": 17736.071,
    "zh": "哪里哪里",
    "vi": "Không có gì đâu."
  },
  {
    "idx": 10576,
    "start": "04:55:36,071",
    "end": "04:55:37,151",
    "start_sec": 17736.071,
    "end_sec": 17737.151,
    "zh": "就是提一句的事",
    "vi": "Tôi chỉ nói giúp một câu thôi."
  },
  {
    "idx": 10577,
    "start": "04:55:37,151",
    "end": "04:55:38,531",
    "start_sec": 17737.151,
    "end_sec": 17738.531,
    "zh": "023停不停船",
    "vi": "Còn việc số 023 có dừng tàu hay không."
  },
  {
    "idx": 10578,
    "start": "04:55:38,531",
    "end": "04:55:39,871",
    "start_sec": 17738.531,
    "end_sec": 17739.871,
    "zh": "还是要看他自己的意思",
    "vi": "Thì vẫn phải xem ý của anh ta thế nào."
  },
  {
    "idx": 10579,
    "start": "04:55:39,871",
    "end": "04:55:40,591",
    "start_sec": 17739.871,
    "end_sec": 17740.591,
    "zh": "周公子",
    "vi": "Chu công tử."
  },
  {
    "idx": 10580,
    "start": "04:55:40,591",
    "end": "04:55:42,411",
    "start_sec": 17740.591,
    "end_sec": 17742.411,
    "zh": "你可是古今的维尔纪成人",
    "vi": "Cậu là người thừa kế của tập đoàn Cổ Kim Vệ Nhĩ Kỷ."
  },
  {
    "idx": 10581,
    "start": "04:55:42,411",
    "end": "04:55:44,131",
    "start_sec": 17742.411,
    "end_sec": 17744.131,
    "zh": "多少还是比我们有分量",
    "vi": "Dù sao lời nói của cậu vẫn có trọng lượng hơn chúng tôi."
  },
  {
    "idx": 10582,
    "start": "04:55:44,131",
    "end": "04:55:48,091",
    "start_sec": 17744.131,
    "end_sec": 17748.091,
    "zh": "你妈妈还不开船",
    "vi": "Sao anh vẫn chưa cho tàu chạy hả."
  },
  {
    "idx": 10583,
    "start": "04:55:48,091",
    "end": "04:55:49,591",
    "start_sec": 17748.091,
    "end_sec": 17749.591,
    "zh": "谁给你的胆子",
    "vi": "Ai cho anh cái gan đó."
  },
  {
    "idx": 10584,
    "start": "04:55:49,591",
    "end": "04:55:50,331",
    "start_sec": 17749.591,
    "end_sec": 17750.331,
    "zh": "023",
    "vi": "Số 023."
  },
  {
    "idx": 10585,
    "start": "04:55:50,331",
    "end": "04:55:51,751",
    "start_sec": 17750.331,
    "end_sec": 17751.751,
    "zh": "我说蜀光号的航行",
    "vi": "Tôi thấy chuyến hành trình của tàu Thục Quang."
  },
  {
    "idx": 10586,
    "start": "04:55:51,751",
    "end": "04:55:53,011",
    "start_sec": 17751.751,
    "end_sec": 17753.011,
    "zh": "也不差这一两天吧",
    "vi": "Cũng không trễ nải gì một hai ngày này."
  },
  {
    "idx": 10587,
    "start": "04:55:53,011",
    "end": "04:55:55,251",
    "start_sec": 17753.011,
    "end_sec": 17755.251,
    "zh": "怎么周公子也要帮他们",
    "vi": "Sao thế, Chu công tử cũng muốn giúp họ à."
  },
  {
    "idx": 10588,
    "start": "04:55:55,251",
    "end": "04:55:56,291",
    "start_sec": 17755.251,
    "end_sec": 17756.291,
    "zh": "我只是觉得",
    "vi": "Tôi chỉ cảm thấy."
  },
  {
    "idx": 10589,
    "start": "04:55:56,291",
    "end": "04:55:59,131",
    "start_sec": 17756.291,
    "end_sec": 17759.131,
    "zh": "反正这艘船只要有026在都能开",
    "vi": "Dù sao con tàu này chỉ cần có số 026 là có thể chạy được."
  },
  {
    "idx": 10590,
    "start": "04:55:59,131",
    "end": "04:56:01,411",
    "start_sec": 17759.131,
    "end_sec": 17761.411,
    "zh": "你是不是该考虑下他的心情了",
    "vi": "Anh có nên cân nhắc đến cảm xúc của ông ấy không."
  },
  {
    "idx": 10591,
    "start": "04:56:01,411",
    "end": "04:56:01,771",
    "start_sec": 17761.411,
    "end_sec": 17761.771,
    "zh": "哼",
    "vi": "Hừ."
  },
  {
    "idx": 10592,
    "start": "04:56:01,771",
    "end": "04:56:03,491",
    "start_sec": 17761.771,
    "end_sec": 17763.491,
    "zh": "玉鬼者组织的任务",
    "vi": "Nhiệm vụ của tổ chức Ngọc Quỷ Giả."
  },
  {
    "idx": 10593,
    "start": "04:56:03,491",
    "end": "04:56:04,931",
    "start_sec": 17763.491,
    "end_sec": 17764.931,
    "zh": "你和我谈心情",
    "vi": "Mà bạn lại đi nói chuyện tình cảm với tôi."
  },
  {
    "idx": 10594,
    "start": "04:56:04,931",
    "end": "04:56:06,851",
    "start_sec": 17764.931,
    "end_sec": 17766.851,
    "zh": "任务说要最快速度回去",
    "vi": "Nhiệm vụ yêu cầu phải quay về với tốc độ nhanh nhất."
  },
  {
    "idx": 10595,
    "start": "04:56:06,851",
    "end": "04:56:08,191",
    "start_sec": 17766.851,
    "end_sec": 17768.191,
    "zh": "别说死了徐东来",
    "vi": "Đừng nói là Từ Đông Lai chết."
  },
  {
    "idx": 10596,
    "start": "04:56:08,191",
    "end": "04:56:09,351",
    "start_sec": 17768.191,
    "end_sec": 17769.351,
    "zh": "就是死了你",
    "vi": "Cho dù là bạn chết."
  },
  {
    "idx": 10597,
    "start": "04:56:09,351",
    "end": "04:56:10,131",
    "start_sec": 17769.351,
    "end_sec": 17770.131,
    "zh": "死了我",
    "vi": "Tôi chết."
  },
  {
    "idx": 10598,
    "start": "04:56:10,131",
    "end": "04:56:11,551",
    "start_sec": 17770.131,
    "end_sec": 17771.551,
    "zh": "这船都不能停",
    "vi": "Thì con tàu này cũng không được dừng lại."
  },
  {
    "idx": 10599,
    "start": "04:56:11,551",
    "end": "04:56:14,331",
    "start_sec": 17771.551,
    "end_sec": 17774.331,
    "zh": "怎么周公子不急着去孔布纳",
    "vi": "Sao công tử Chu lại không vội vã đến Khổng Bố Nạp."
  },
  {
    "idx": 10600,
    "start": "04:56:14,331",
    "end": "04:56:15,491",
    "start_sec": 17774.331,
    "end_sec": 17775.491,
    "zh": "是不想去吗",
    "vi": "Là không muốn đi sao."
  },
  {
    "idx": 10601,
    "start": "04:56:15,491",
    "end": "04:56:17,071",
    "start_sec": 17775.491,
    "end_sec": 17777.071,
    "zh": "周扬被一句话呛了",
    "vi": "Chu Dương bị một câu nói chặn họng."
  },
  {
    "idx": 10602,
    "start": "04:56:17,071",
    "end": "04:56:17,471",
    "start_sec": 17777.071,
    "end_sec": 17777.471,
    "zh": "低下头",
    "vi": "Cúi đầu xuống."
  },
  {
    "idx": 10603,
    "start": "04:56:17,471",
    "end": "04:56:18,251",
    "start_sec": 17777.471,
    "end_sec": 17778.251,
    "zh": "徐校长",
    "vi": "Hiệu trưởng Từ."
  },
  {
    "idx": 10604,
    "start": "04:56:18,251",
    "end": "04:56:19,651",
    "start_sec": 17778.251,
    "end_sec": 17779.651,
    "zh": "026你们也看到了",
    "vi": "026 bạn cũng thấy rồi đấy."
  },
  {
    "idx": 10605,
    "start": "04:56:19,651",
    "end": "04:56:20,391",
    "start_sec": 17779.651,
    "end_sec": 17780.391,
    "zh": "不是我不帮吧",
    "vi": "Không phải tôi không giúp."
  },
  {
    "idx": 10606,
    "start": "04:56:20,391",
    "end": "04:56:22,051",
    "start_sec": 17780.391,
    "end_sec": 17782.051,
    "zh": "是023总指挥不乐意啊",
    "vi": "Mà là tổng chỉ huy 023 không muốn đấy chứ."
  },
  {
    "idx": 10607,
    "start": "04:56:22,051",
    "end": "04:56:24,471",
    "start_sec": 17782.051,
    "end_sec": 17784.471,
    "zh": "026你他妈还愣着干嘛",
    "vi": "026 bạn còn đứng ngẩn ra đó làm gì."
  },
  {
    "idx": 10608,
    "start": "04:56:24,471",
    "end": "04:56:25,671",
    "start_sec": 17784.471,
    "end_sec": 17785.671,
    "zh": "还不去开船",
    "vi": "Còn không mau đi lái tàu."
  },
  {
    "idx": 10609,
    "start": "04:56:25,671",
    "end": "04:56:27,971",
    "start_sec": 17785.671,
    "end_sec": 17787.971,
    "zh": "哎小海去吧",
    "vi": "Được rồi Tiểu Hải đi đi."
  },
  {
    "idx": 10610,
    "start": "04:56:27,971",
    "end": "04:56:29,531",
    "start_sec": 17787.971,
    "end_sec": 17789.531,
    "zh": "东来他没这份命",
    "vi": "Đông Lai cậu ấy không có cái số này đâu."
  },
  {
    "idx": 10611,
    "start": "04:56:29,531",
    "end": "04:56:30,871",
    "start_sec": 17789.531,
    "end_sec": 17790.871,
    "zh": "徐天志捶着脑袋",
    "vi": "Từ Thiên Chí ôm lấy đầu."
  },
  {
    "idx": 10612,
    "start": "04:56:30,871",
    "end": "04:56:32,351",
    "start_sec": 17790.871,
    "end_sec": 17792.351,
    "zh": "起身往电梯方向走",
    "vi": "Đứng dậy đi về phía thang máy."
  },
  {
    "idx": 10613,
    "start": "04:56:32,351",
    "end": "04:56:33,851",
    "start_sec": 17792.351,
    "end_sec": 17793.851,
    "zh": "下书",
    "vi": "Rõ rồi."
  },
  {
    "idx": 10614,
    "start": "04:56:33,851",
    "end": "04:56:35,531",
    "start_sec": 17793.851,
    "end_sec": 17795.531,
    "zh": "明白了",
    "vi": "Đã hiểu."
  },
  {
    "idx": 10615,
    "start": "04:56:35,531",
    "end": "04:56:38,591",
    "start_sec": 17795.531,
    "end_sec": 17798.591,
    "zh": "接着026黑着脸",
    "vi": "Sau đó 026 với khuôn mặt đen sì."
  },
  {
    "idx": 10616,
    "start": "04:56:38,591",
    "end": "04:56:39,671",
    "start_sec": 17798.591,
    "end_sec": 17799.671,
    "zh": "也走向甲板区",
    "vi": "Cũng đi về phía khu vực boong tàu."
  },
  {
    "idx": 10617,
    "start": "04:56:39,671",
    "end": "04:56:41,671",
    "start_sec": 17799.671,
    "end_sec": 17801.671,
    "zh": "023和程子迪对着眼",
    "vi": "023 và Trình Tử Địch nhìn nhau."
  },
  {
    "idx": 10618,
    "start": "04:56:41,671",
    "end": "04:56:43,811",
    "start_sec": 17801.671,
    "end_sec": 17803.811,
    "zh": "程子迪当即起身往甲板区",
    "vi": "Trình Tử Địch lập tức đứng dậy đi về phía boong tàu."
  },
  {
    "idx": 10619,
    "start": "04:56:43,811",
    "end": "04:56:45,471",
    "start_sec": 17803.811,
    "end_sec": 17805.471,
    "zh": "023也匆匆跟上",
    "vi": "023 cũng vội vã đi theo."
  },
  {
    "idx": 10620,
    "start": "04:56:45,471",
    "end": "04:56:47,671",
    "start_sec": 17805.471,
    "end_sec": 17807.671,
    "zh": "哎南河桥",
    "vi": "Này Nam Hà Kiều."
  },
  {
    "idx": 10621,
    "start": "04:56:48,471",
    "end": "04:56:50,531",
    "start_sec": 17808.471,
    "end_sec": 17810.531,
    "zh": "026",
    "vi": "026."
  },
  {
    "idx": 10622,
    "start": "04:56:50,531",
    "end": "04:56:52,431",
    "start_sec": 17810.531,
    "end_sec": 17812.431,
    "zh": "话说你也不用这么善办吧",
    "vi": "Nói thật thì anh cũng không cần phải lo lắng như vậy đâu."
  },
  {
    "idx": 10623,
    "start": "04:56:52,431",
    "end": "04:56:54,111",
    "start_sec": 17812.431,
    "end_sec": 17814.111,
    "zh": "毕竟你徐叔还在不是",
    "vi": "Dù sao thì chú Từ của anh vẫn còn ở đây mà."
  },
  {
    "idx": 10624,
    "start": "04:56:54,111",
    "end": "04:56:54,891",
    "start_sec": 17814.111,
    "end_sec": 17814.891,
    "zh": "是你",
    "vi": "Là cậu."
  },
  {
    "idx": 10625,
    "start": "04:56:54,891",
    "end": "04:56:56,231",
    "start_sec": 17814.891,
    "end_sec": 17816.231,
    "zh": "你竟然还敢来找我",
    "vi": "Cậu mà cũng dám đến tìm tôi sao."
  },
  {
    "idx": 10626,
    "start": "04:56:56,231",
    "end": "04:56:56,731",
    "start_sec": 17816.231,
    "end_sec": 17816.731,
    "zh": "023",
    "vi": "023."
  },
  {
    "idx": 10627,
    "start": "04:56:56,731",
    "end": "04:56:57,671",
    "start_sec": 17816.731,
    "end_sec": 17817.671,
    "zh": "你什么意思",
    "vi": "Cậu có ý gì đây."
  },
  {
    "idx": 10628,
    "start": "04:56:57,671",
    "end": "04:56:58,891",
    "start_sec": 17817.671,
    "end_sec": 17818.891,
    "zh": "和这小子一起来",
    "vi": "Lại đi cùng với tên nhóc này."
  },
  {
    "idx": 10629,
    "start": "04:56:58,891",
    "end": "04:56:59,391",
    "start_sec": 17818.891,
    "end_sec": 17819.391,
    "zh": "怎么",
    "vi": "Sao thế."
  },
  {
    "idx": 10630,
    "start": "04:56:59,391",
    "end": "04:57:00,451",
    "start_sec": 17819.391,
    "end_sec": 17820.451,
    "zh": "你偏向的",
    "vi": "Cậu đứng về phía cậu ta à."
  },
  {
    "idx": 10631,
    "start": "04:57:00,451",
    "end": "04:57:01,151",
    "start_sec": 17820.451,
    "end_sec": 17821.151,
    "zh": "想对付我",
    "vi": "Muốn đối phó với tôi sao."
  },
  {
    "idx": 10632,
    "start": "04:57:01,151",
    "end": "04:57:01,891",
    "start_sec": 17821.151,
    "end_sec": 17821.891,
    "zh": "对付你",
    "vi": "Đối phó với anh á."
  },
  {
    "idx": 10633,
    "start": "04:57:01,891",
    "end": "04:57:02,571",
    "start_sec": 17821.891,
    "end_sec": 17822.571,
    "zh": "不不不",
    "vi": "Không không không."
  },
  {
    "idx": 10634,
    "start": "04:57:02,571",
    "end": "04:57:03,711",
    "start_sec": 17822.571,
    "end_sec": 17823.711,
    "zh": "我们星城对了呢",
    "vi": "Đội Tinh Thành chúng tôi ấy mà."
  },
  {
    "idx": 10635,
    "start": "04:57:03,711",
    "end": "04:57:04,931",
    "start_sec": 17823.711,
    "end_sec": 17824.931,
    "zh": "保护你还来不及呢",
    "vi": "Bảo vệ anh còn không kịp nữa là."
  },
  {
    "idx": 10636,
    "start": "04:57:04,931",
    "end": "04:57:06,071",
    "start_sec": 17824.931,
    "end_sec": 17826.071,
    "zh": "你什么意思",
    "vi": "Ý cậu là sao."
  },
  {
    "idx": 10637,
    "start": "04:57:06,071",
    "end": "04:57:06,751",
    "start_sec": 17826.071,
    "end_sec": 17826.751,
    "zh": "026",
    "vi": "026."
  },
  {
    "idx": 10638,
    "start": "04:57:06,751",
    "end": "04:57:07,931",
    "start_sec": 17826.751,
    "end_sec": 17827.931,
    "zh": "你是不是没想过",
    "vi": "Có phải anh chưa từng nghĩ tới."
  },
  {
    "idx": 10639,
    "start": "04:57:07,931",
    "end": "04:57:09,071",
    "start_sec": 17827.931,
    "end_sec": 17829.071,
    "zh": "自己的重要性啊",
    "vi": "Tầm quan trọng của bản thân mình không."
  },
  {
    "idx": 10640,
    "start": "04:57:09,071",
    "end": "04:57:10,091",
    "start_sec": 17829.071,
    "end_sec": 17830.091,
    "zh": "我来给你分析一下",
    "vi": "Để tôi phân tích cho anh nghe nhé."
  },
  {
    "idx": 10641,
    "start": "04:57:10,091",
    "end": "04:57:10,851",
    "start_sec": 17830.091,
    "end_sec": 17830.851,
    "zh": "诡异第一步",
    "vi": "Bước đầu tiên của thế lực quỷ dị."
  },
  {
    "idx": 10642,
    "start": "04:57:10,851",
    "end": "04:57:11,991",
    "start_sec": 17830.851,
    "end_sec": 17831.991,
    "zh": "就是替换了船长",
    "vi": "Chính là thay thế thuyền trưởng."
  },
  {
    "idx": 10643,
    "start": "04:57:11,991",
    "end": "04:57:13,511",
    "start_sec": 17831.991,
    "end_sec": 17833.511,
    "zh": "曙光号只有你能驱动",
    "vi": "Tàu Bình Minh chỉ có anh mới khởi động được."
  },
  {
    "idx": 10644,
    "start": "04:57:13,511",
    "end": "04:57:15,151",
    "start_sec": 17833.511,
    "end_sec": 17835.151,
    "zh": "如果诡异要控制曙光号",
    "vi": "Nếu thế lực quỷ dị muốn kiểm soát tàu Bình Minh."
  },
  {
    "idx": 10645,
    "start": "04:57:15,151",
    "end": "04:57:16,171",
    "start_sec": 17835.151,
    "end_sec": 17836.171,
    "zh": "接下来会怎么做",
    "vi": "Thì tiếp theo chúng sẽ làm gì."
  },
  {
    "idx": 10646,
    "start": "04:57:16,171",
    "end": "04:57:17,351",
    "start_sec": 17836.171,
    "end_sec": 17837.351,
    "zh": "你的意思是",
    "vi": "Ý của cậu là."
  },
  {
    "idx": 10647,
    "start": "04:57:17,351",
    "end": "04:57:18,251",
    "start_sec": 17837.351,
    "end_sec": 17838.251,
    "zh": "那些诡异要动",
    "vi": "Những thứ quỷ dị đó muốn ra tay sao."
  },
  {
    "idx": 10648,
    "start": "04:57:18,251",
    "end": "04:57:18,911",
    "start_sec": 17838.251,
    "end_sec": 17838.911,
    "zh": "就他们",
    "vi": "Chỉ dựa vào chúng."
  },
  {
    "idx": 10649,
    "start": "04:57:18,911",
    "end": "04:57:19,931",
    "start_sec": 17838.911,
    "end_sec": 17839.931,
    "zh": "能对我怎样",
    "vi": "Thì làm gì được tôi chứ."
  },
  {
    "idx": 10650,
    "start": "04:57:19,931",
    "end": "04:57:21,171",
    "start_sec": 17839.931,
    "end_sec": 17841.171,
    "zh": "对你不能怎样",
    "vi": "Đúng là không làm gì được anh."
  },
  {
    "idx": 10651,
    "start": "04:57:21,171",
    "end": "04:57:22,051",
    "start_sec": 17841.171,
    "end_sec": 17842.051,
    "zh": "你就没想过",
    "vi": "Cậu chưa từng nghĩ tới sao."
  },
  {
    "idx": 10652,
    "start": "04:57:22,051",
    "end": "04:57:23,071",
    "start_sec": 17842.051,
    "end_sec": 17843.071,
    "zh": "对你徐叔怎么样",
    "vi": "nếu chúng làm gì chú Từ của cậu thì sao."
  },
  {
    "idx": 10653,
    "start": "04:57:23,071",
    "end": "04:57:24,211",
    "start_sec": 17843.071,
    "end_sec": 17844.211,
    "zh": "变成你徐叔",
    "vi": "Biến thành chú Từ của cậu."
  },
  {
    "idx": 10654,
    "start": "04:57:24,211",
    "end": "04:57:25,331",
    "start_sec": 17844.211,
    "end_sec": 17845.331,
    "zh": "然后对着你来一刀",
    "vi": "Rồi đâm cậu một nhát."
  },
  {
    "idx": 10655,
    "start": "04:57:25,331",
    "end": "04:57:27,031",
    "start_sec": 17845.331,
    "end_sec": 17847.031,
    "zh": "试问你会躲你徐叔吗",
    "vi": "Thử hỏi cậu có đề phòng chú Từ của mình không."
  },
  {
    "idx": 10656,
    "start": "04:57:27,031",
    "end": "04:57:27,731",
    "start_sec": 17847.031,
    "end_sec": 17847.731,
    "zh": "不可能",
    "vi": "Không thể nào."
  },
  {
    "idx": 10657,
    "start": "04:57:27,731",
    "end": "04:57:28,731",
    "start_sec": 17847.731,
    "end_sec": 17848.731,
    "zh": "徐叔住二楼",
    "vi": "Chú Từ ở tầng hai."
  },
  {
    "idx": 10658,
    "start": "04:57:28,731",
    "end": "04:57:29,431",
    "start_sec": 17848.731,
    "end_sec": 17849.431,
    "zh": "那些鬼",
    "vi": "Những con quỷ đó."
  },
  {
    "idx": 10659,
    "start": "04:57:29,431",
    "end": "04:57:30,271",
    "start_sec": 17849.431,
    "end_sec": 17850.271,
    "zh": "那些鬼异",
    "vi": "Những thế lực kỳ quái đó."
  },
  {
    "idx": 10660,
    "start": "04:57:30,271",
    "end": "04:57:31,451",
    "start_sec": 17850.271,
    "end_sec": 17851.451,
    "zh": "要是也住二楼呢",
    "vi": "Nếu chúng cũng ở tầng hai thì sao."
  },
  {
    "idx": 10661,
    "start": "04:57:31,451",
    "end": "04:57:32,311",
    "start_sec": 17851.451,
    "end_sec": 17852.311,
    "zh": "准确来说",
    "vi": "Nói chính xác hơn."
  },
  {
    "idx": 10662,
    "start": "04:57:32,311",
    "end": "04:57:33,111",
    "start_sec": 17852.311,
    "end_sec": 17853.111,
    "zh": "要是鬼异",
    "vi": "Nếu thế lực kỳ quái đó."
  },
  {
    "idx": 10663,
    "start": "04:57:33,111",
    "end": "04:57:34,291",
    "start_sec": 17853.111,
    "end_sec": 17854.291,
    "zh": "就是周家父子呢",
    "vi": "Chính là cha con nhà họ Chu thì sao."
  },
  {
    "idx": 10664,
    "start": "04:57:34,291",
    "end": "04:57:35,671",
    "start_sec": 17854.291,
    "end_sec": 17855.671,
    "zh": "026顿时沉默时",
    "vi": "Số 026 lập tức im lặng."
  },
  {
    "idx": 10665,
    "start": "04:57:35,671",
    "end": "04:57:37,251",
    "start_sec": 17855.671,
    "end_sec": 17857.251,
    "zh": "只觉得背后凉嗖嗖的",
    "vi": "Chỉ cảm thấy sống lưng lạnh toát."
  },
  {
    "idx": 10666,
    "start": "04:57:37,251",
    "end": "04:57:37,811",
    "start_sec": 17857.251,
    "end_sec": 17857.811,
    "zh": "023",
    "vi": "Số 023."
  },
  {
    "idx": 10667,
    "start": "04:57:37,811",
    "end": "04:57:39,351",
    "start_sec": 17857.811,
    "end_sec": 17859.351,
    "zh": "也绝对不是绝对",
    "vi": "Cũng tuyệt đối không phải là tuyệt đối."
  },
  {
    "idx": 10668,
    "start": "04:57:39,351",
    "end": "04:57:40,691",
    "start_sec": 17859.351,
    "end_sec": 17860.691,
    "zh": "我亲眼看到了",
    "vi": "Tôi đã tận mắt nhìn thấy rồi."
  },
  {
    "idx": 10669,
    "start": "04:57:40,691",
    "end": "04:57:41,251",
    "start_sec": 17860.691,
    "end_sec": 17861.251,
    "zh": "不对",
    "vi": "Không đúng."
  },
  {
    "idx": 10670,
    "start": "04:57:41,251",
    "end": "04:57:42,731",
    "start_sec": 17861.251,
    "end_sec": 17862.731,
    "zh": "要是你们才去讲什么",
    "vi": "Nếu các người mới là kẻ nói nhảm thì sao."
  },
  {
    "idx": 10671,
    "start": "04:57:42,731",
    "end": "04:57:44,591",
    "start_sec": 17862.731,
    "end_sec": 17864.591,
    "zh": "026警惕的最后两步",
    "vi": "Số 026 cảnh giác lùi lại hai bước."
  },
  {
    "idx": 10672,
    "start": "04:57:44,591",
    "end": "04:57:46,291",
    "start_sec": 17864.591,
    "end_sec": 17866.291,
    "zh": "023刚想有所动作",
    "vi": "Số 023 vừa định hành động."
  },
  {
    "idx": 10673,
    "start": "04:57:46,291",
    "end": "04:57:47,391",
    "start_sec": 17866.291,
    "end_sec": 17867.391,
    "zh": "徐天志的身影",
    "vi": "Thì bóng dáng của Từ Thiên Chí."
  },
  {
    "idx": 10674,
    "start": "04:57:47,391",
    "end": "04:57:48,711",
    "start_sec": 17867.391,
    "end_sec": 17868.711,
    "zh": "却亮相着逃了过来",
    "vi": "Lại lảo đảo chạy trốn tới đây."
  },
  {
    "idx": 10675,
    "start": "04:57:48,711",
    "end": "04:57:49,451",
    "start_sec": 17868.711,
    "end_sec": 17869.451,
    "zh": "别忘了",
    "vi": "Đừng quên."
  },
  {
    "idx": 10676,
    "start": "04:57:49,451",
    "end": "04:57:50,291",
    "start_sec": 17869.451,
    "end_sec": 17870.291,
    "zh": "我对你说的话",
    "vi": "Những lời tôi đã nói với cậu."
  },
  {
    "idx": 10677,
    "start": "04:57:50,291",
    "end": "04:57:51,731",
    "start_sec": 17870.291,
    "end_sec": 17871.731,
    "zh": "小海",
    "vi": "Tiểu Hải."
  },
  {
    "idx": 10678,
    "start": "04:57:51,731",
    "end": "04:57:52,511",
    "start_sec": 17871.731,
    "end_sec": 17872.511,
    "zh": "徐叔",
    "vi": "Chú Từ."
  },
  {
    "idx": 10679,
    "start": "04:57:52,511",
    "end": "04:57:54,351",
    "start_sec": 17872.511,
    "end_sec": 17874.351,
    "zh": "你",
    "vi": "Chú."
  },
  {
    "idx": 10680,
    "start": "04:57:54,351",
    "end": "04:58:01,791",
    "start_sec": 17874.351,
    "end_sec": 17881.791,
    "zh": "橙子皮",
    "vi": "Trần Tử Bì."
  },
  {
    "idx": 10681,
    "start": "04:58:01,791",
    "end": "04:58:04,271",
    "start_sec": 17881.791,
    "end_sec": 17884.271,
    "zh": "你确定你刚刚只是举了个例子吗",
    "vi": "Bạn có chắc vừa rồi bạn chỉ lấy ví dụ không."
  },
  {
    "idx": 10682,
    "start": "04:58:04,271",
    "end": "04:58:07,131",
    "start_sec": 17884.271,
    "end_sec": 17887.131,
    "zh": "你说徐天志拿着刀对026来一下",
    "vi": "Bạn nói Từ Thiên Chí cầm dao đâm số 026 một nhát."
  },
  {
    "idx": 10683,
    "start": "04:58:07,131",
    "end": "04:58:08,631",
    "start_sec": 17887.131,
    "end_sec": 17888.631,
    "zh": "结果真就应验了",
    "vi": "Kết quả là nó linh nghiệm thật rồi."
  },
  {
    "idx": 10684,
    "start": "04:58:08,631",
    "end": "04:58:11,651",
    "start_sec": 17888.631,
    "end_sec": 17891.651,
    "zh": "你不会是古希腊掌管乌鸦嘴的神吧",
    "vi": "Bạn không phải là vị thần cai quản cái miệng quạ đen của Hy Lạp cổ đại đấy chứ."
  },
  {
    "idx": 10685,
    "start": "04:58:11,651",
    "end": "04:58:13,151",
    "start_sec": 17891.651,
    "end_sec": 17893.151,
    "zh": "不要这么奇怪的看着我",
    "vi": "Đừng nhìn tôi bằng ánh mắt kỳ lạ như thế."
  },
  {
    "idx": 10686,
    "start": "04:58:13,151",
    "end": "04:58:14,791",
    "start_sec": 17893.151,
    "end_sec": 17894.791,
    "zh": "我只是觉得我要是诡异",
    "vi": "Tôi chỉ nghĩ nếu tôi là thế lực quỷ dị."
  },
  {
    "idx": 10687,
    "start": "04:58:14,791",
    "end": "04:58:15,611",
    "start_sec": 17894.791,
    "end_sec": 17895.611,
    "zh": "也会这么做",
    "vi": "Tôi cũng sẽ làm như vậy."
  },
  {
    "idx": 10688,
    "start": "04:58:15,611",
    "end": "04:58:16,191",
    "start_sec": 17895.611,
    "end_sec": 17896.191,
    "zh": "凑巧",
    "vi": "Trùng hợp thôi."
  },
  {
    "idx": 10689,
    "start": "04:58:16,191",
    "end": "04:58:17,031",
    "start_sec": 17896.191,
    "end_sec": 17897.031,
    "zh": "凑巧吧",
    "vi": "Trùng hợp thôi mà."
  },
  {
    "idx": 10690,
    "start": "04:58:17,031",
    "end": "04:58:17,671",
    "start_sec": 17897.031,
    "end_sec": 17897.671,
    "zh": "高",
    "vi": "Cao tay thật."
  },
  {
    "idx": 10691,
    "start": "04:58:17,671",
    "end": "04:58:18,291",
    "start_sec": 17897.671,
    "end_sec": 17898.291,
    "zh": "徐叔",
    "vi": "Chú Từ."
  },
  {
    "idx": 10692,
    "start": "04:58:18,291",
    "end": "04:58:24,251",
    "start_sec": 17898.291,
    "end_sec": 17904.251,
    "zh": "跟我走",
    "vi": "Đi theo cháu."
  },
  {
    "idx": 10693,
    "start": "04:58:24,251",
    "end": "04:58:27,991",
    "start_sec": 17904.251,
    "end_sec": 17907.991,
    "zh": "小海",
    "vi": "Tiểu Hải."
  },
  {
    "idx": 10694,
    "start": "04:58:27,991",
    "end": "04:58:29,571",
    "start_sec": 17907.991,
    "end_sec": 17909.571,
    "zh": "你不是去开船了吗",
    "vi": "Cháu không phải đi lái tàu rồi sao."
  },
  {
    "idx": 10695,
    "start": "04:58:29,571",
    "end": "04:58:30,511",
    "start_sec": 17909.571,
    "end_sec": 17910.511,
    "zh": "怎么回来了",
    "vi": "Sao lại quay lại rồi."
  },
  {
    "idx": 10696,
    "start": "04:58:30,511",
    "end": "04:58:31,191",
    "start_sec": 17910.511,
    "end_sec": 17911.191,
    "zh": "徐叔",
    "vi": "Chú Từ."
  },
  {
    "idx": 10697,
    "start": "04:58:31,191",
    "end": "04:58:32,691",
    "start_sec": 17911.191,
    "end_sec": 17912.691,
    "zh": "你没事就好",
    "vi": "Chú không sao là tốt rồi."
  },
  {
    "idx": 10698,
    "start": "04:58:32,691",
    "end": "04:58:33,431",
    "start_sec": 17912.691,
    "end_sec": 17913.431,
    "zh": "夏叔",
    "vi": "Chú Hạ."
  },
  {
    "idx": 10699,
    "start": "04:58:33,431",
    "end": "04:58:34,731",
    "start_sec": 17913.431,
    "end_sec": 17914.731,
    "zh": "刚刚没发生什么吗",
    "vi": "Vừa rồi không xảy ra chuyện gì sao."
  },
  {
    "idx": 10700,
    "start": "04:58:34,731",
    "end": "04:58:35,291",
    "start_sec": 17914.731,
    "end_sec": 17915.291,
    "zh": "没有",
    "vi": "Không có."
  },
  {
    "idx": 10701,
    "start": "04:58:35,291",
    "end": "04:58:37,091",
    "start_sec": 17915.291,
    "end_sec": 17917.091,
    "zh": "不过那个周扬来了一趟",
    "vi": "Nhưng tên Chu Dương đó có đến một chuyến."
  },
  {
    "idx": 10702,
    "start": "04:58:37,091",
    "end": "04:58:38,111",
    "start_sec": 17917.091,
    "end_sec": 17918.111,
    "zh": "见我在屋里",
    "vi": "Thấy tôi ở trong phòng."
  },
  {
    "idx": 10703,
    "start": "04:58:38,111",
    "end": "04:58:39,331",
    "start_sec": 17918.111,
    "end_sec": 17919.331,
    "zh": "笑了笑又走了",
    "vi": "Hắn cười một cái rồi lại đi."
  },
  {
    "idx": 10704,
    "start": "04:58:39,331",
    "end": "04:58:40,031",
    "start_sec": 17919.331,
    "end_sec": 17920.031,
    "zh": "看来",
    "vi": "Xem ra."
  },
  {
    "idx": 10705,
    "start": "04:58:40,031",
    "end": "04:58:41,971",
    "start_sec": 17920.031,
    "end_sec": 17921.971,
    "zh": "刚才那个周扬是误障鬼子分身",
    "vi": "Chu Dương vừa rồi là phân thân của Ngộ Chướng Quỷ."
  },
  {
    "idx": 10706,
    "start": "04:58:41,971",
    "end": "04:58:43,711",
    "start_sec": 17921.971,
    "end_sec": 17923.711,
    "zh": "来杀徐天志取而代之的",
    "vi": "Đến để giết Từ Thiên Chí rồi thay thế ông ấy."
  },
  {
    "idx": 10707,
    "start": "04:58:43,711",
    "end": "04:58:45,651",
    "start_sec": 17923.711,
    "end_sec": 17925.651,
    "zh": "一道分身吗",
    "vi": "Là một phân thân sao."
  },
  {
    "idx": 10708,
    "start": "04:58:45,651",
    "end": "04:58:46,991",
    "start_sec": 17925.651,
    "end_sec": 17926.991,
    "zh": "你小子可以啊",
    "vi": "Cháu khá đấy chứ."
  },
  {
    "idx": 10709,
    "start": "04:58:46,991",
    "end": "04:58:48,131",
    "start_sec": 17926.991,
    "end_sec": 17928.131,
    "zh": "嗅觉这么敏锐",
    "vi": "Khứu giác nhạy bén thật."
  },
  {
    "idx": 10710,
    "start": "04:58:48,131",
    "end": "04:58:49,991",
    "start_sec": 17928.131,
    "end_sec": 17929.991,
    "zh": "要不是你提前让我过来",
    "vi": "Nếu không nhờ cháu bảo tôi qua đây trước."
  },
  {
    "idx": 10711,
    "start": "04:58:49,991",
    "end": "04:58:52,651",
    "start_sec": 17929.991,
    "end_sec": 17932.651,
    "zh": "徐校长估计现在凶多吉少了",
    "vi": "Hiệu trưởng Từ e là lành ít dữ nhiều rồi."
  },
  {
    "idx": 10712,
    "start": "04:58:52,651",
    "end": "04:58:53,131",
    "start_sec": 17932.651,
    "end_sec": 17933.131,
    "zh": "文言",
    "vi": "Nghe vậy."
  },
  {
    "idx": 10713,
    "start": "04:58:53,131",
    "end": "04:58:55,371",
    "start_sec": 17933.131,
    "end_sec": 17935.371,
    "zh": "屋里中人难以置信的看向橙子皮",
    "vi": "Mọi người trong phòng nhìn Trần Tử Bì với vẻ không thể tin nổi."
  },
  {
    "idx": 10714,
    "start": "04:58:55,371",
    "end": "04:58:56,931",
    "start_sec": 17935.371,
    "end_sec": 17936.931,
    "zh": "别这么看着我",
    "vi": "Đừng nhìn tôi như thế."
  },
  {
    "idx": 10715,
    "start": "04:58:56,931",
    "end": "04:58:58,271",
    "start_sec": 17936.931,
    "end_sec": 17938.271,
    "zh": "我预判了他的预判",
    "vi": "Tôi chỉ đoán trước được bước đi của hắn thôi."
  },
  {
    "idx": 10716,
    "start": "04:58:58,271",
    "end": "04:59:00,131",
    "start_sec": 17938.271,
    "end_sec": 17940.131,
    "zh": "这不难吧",
    "vi": "Việc này không khó chứ."
  },
  {
    "idx": 10717,
    "start": "04:59:00,131",
    "end": "04:59:02,011",
    "start_sec": 17940.131,
    "end_sec": 17942.011,
    "zh": "看不出来",
    "vi": "Không thể nhận ra đấy."
  },
  {
    "idx": 10718,
    "start": "04:59:02,011",
    "end": "04:59:04,371",
    "start_sec": 17942.011,
    "end_sec": 17944.371,
    "zh": "你小子心思可真够细腻的",
    "vi": "Đầu óc cháu thật là nhạy bén đấy."
  },
  {
    "idx": 10719,
    "start": "04:59:04,371",
    "end": "04:59:05,271",
    "start_sec": 17944.371,
    "end_sec": 17945.271,
    "zh": "也就是说",
    "vi": "Nghĩa là."
  },
  {
    "idx": 10720,
    "start": "04:59:05,271",
    "end": "04:59:07,911",
    "start_sec": 17945.271,
    "end_sec": 17947.911,
    "zh": "那个贾志阳只是来门口看徐叔一眼",
    "vi": "Tên Giả Chí Dương đó chỉ đến cửa nhìn chú Từ một cái."
  },
  {
    "idx": 10721,
    "start": "04:59:07,911",
    "end": "04:59:09,111",
    "start_sec": 17947.911,
    "end_sec": 17949.111,
    "zh": "就能复刻徐叔",
    "vi": "Là có thể sao chép được chú Từ sao."
  },
  {
    "idx": 10722,
    "start": "04:59:09,111",
    "end": "04:59:11,491",
    "start_sec": 17949.111,
    "end_sec": 17951.491,
    "zh": "这诡异的复刻能力堪称恐怖",
    "vi": "Năng lực sao chép quỷ dị này thật đáng sợ."
  },
  {
    "idx": 10723,
    "start": "04:59:11,491",
    "end": "04:59:12,611",
    "start_sec": 17951.491,
    "end_sec": 17952.611,
    "zh": "橙子皮",
    "vi": "Trần Tử Bì."
  },
  {
    "idx": 10724,
    "start": "04:59:12,611",
    "end": "04:59:14,211",
    "start_sec": 17952.611,
    "end_sec": 17954.211,
    "zh": "虽然我对你没什么好感",
    "vi": "Dù tôi không có cảm tình gì với cậu."
  },
  {
    "idx": 10725,
    "start": "04:59:14,211",
    "end": "04:59:16,111",
    "start_sec": 17954.211,
    "end_sec": 17956.111,
    "zh": "但毕竟这次是你救了徐叔",
    "vi": "Nhưng dù sao lần này cậu cũng đã cứu chú Từ."
  },
  {
    "idx": 10726,
    "start": "04:59:16,111",
    "end": "04:59:17,151",
    "start_sec": 17956.111,
    "end_sec": 17957.151,
    "zh": "算我欠你的",
    "vi": "Coi như tôi nợ cậu một lần."
  },
  {
    "idx": 10727,
    "start": "04:59:17,151",
    "end": "04:59:17,971",
    "start_sec": 17957.151,
    "end_sec": 17957.971,
    "zh": "谢谢",
    "vi": "Cảm ơn cậu."
  },
  {
    "idx": 10728,
    "start": "04:59:17,971",
    "end": "04:59:19,751",
    "start_sec": 17957.971,
    "end_sec": 17959.751,
    "zh": "周赫山已经死了",
    "vi": "Chu Hách Sơn đã chết rồi."
  },
  {
    "idx": 10729,
    "start": "04:59:19,751",
    "end": "04:59:21,351",
    "start_sec": 17959.751,
    "end_sec": 17961.351,
    "zh": "如果周扬再死的话",
    "vi": "Nếu Chu Dương cũng chết."
  },
  {
    "idx": 10730,
    "start": "04:59:21,351",
    "end": "04:59:22,911",
    "start_sec": 17961.351,
    "end_sec": 17962.911,
    "zh": "就没人能开启古镜",
    "vi": "Sẽ không còn ai có thể mở gương cổ."
  },
  {
    "idx": 10731,
    "start": "04:59:22,911",
    "end": "04:59:25,291",
    "start_sec": 17962.911,
    "end_sec": 17965.291,
    "zh": "但他现在是我们最大的敌人",
    "vi": "Nhưng hiện tại hắn lại là kẻ thù lớn nhất của chúng ta."
  },
  {
    "idx": 10732,
    "start": "04:59:25,291",
    "end": "04:59:26,831",
    "start_sec": 17965.291,
    "end_sec": 17966.831,
    "zh": "这难搞啊",
    "vi": "Việc này khó giải quyết đây."
  },
  {
    "idx": 10733,
    "start": "04:59:26,831",
    "end": "04:59:27,311",
    "start_sec": 17966.831,
    "end_sec": 17967.311,
    "zh": "简单",
    "vi": "Đơn giản thôi."
  },
  {
    "idx": 10734,
    "start": "04:59:27,311",
    "end": "04:59:29,511",
    "start_sec": 17967.311,
    "end_sec": 17969.511,
    "zh": "让他只变成古镜掌握者就好了",
    "vi": "Chỉ cần khiến hắn trở thành người nắm giữ gương cổ là được."
  },
  {
    "idx": 10735,
    "start": "04:59:29,511",
    "end": "04:59:31,031",
    "start_sec": 17969.511,
    "end_sec": 17971.031,
    "zh": "你这话什么意思",
    "vi": "Cậu nói thế có ý gì."
  },
  {
    "idx": 10736,
    "start": "04:59:31,031",
    "end": "04:59:32,091",
    "start_sec": 17971.031,
    "end_sec": 17972.091,
    "zh": "实不相瞒",
    "vi": "Thật không giấu gì mọi người."
  },
  {
    "idx": 10737,
    "start": "04:59:32,091",
    "end": "04:59:33,411",
    "start_sec": 17972.091,
    "end_sec": 17973.411,
    "zh": "其实我的残死鬼",
    "vi": "Thật ra Tàn Tử Quỷ của tôi."
  },
  {
    "idx": 10738,
    "start": "04:59:33,411",
    "end": "04:59:34,311",
    "start_sec": 17973.411,
    "end_sec": 17974.311,
    "zh": "还有个能力",
    "vi": "Vẫn còn một năng lực nữa."
  },
  {
    "idx": 10739,
    "start": "04:59:34,311",
    "end": "04:59:34,691",
    "start_sec": 17974.311,
    "end_sec": 17974.691,
    "zh": "就是",
    "vi": "Đó là."
  },
  {
    "idx": 10740,
    "start": "04:59:34,691",
    "end": "04:59:35,831",
    "start_sec": 17974.691,
    "end_sec": 17975.831,
    "zh": "吃鬼",
    "vi": "Ăn quỷ."
  },
  {
    "idx": 10741,
    "start": "04:59:35,831",
    "end": "04:59:36,691",
    "start_sec": 17975.831,
    "end_sec": 17976.691,
    "zh": "什么",
    "vi": "Cái gì"
  },
  {
    "idx": 10742,
    "start": "04:59:36,691",
    "end": "04:59:37,571",
    "start_sec": 17976.691,
    "end_sec": 17977.571,
    "zh": "吃鬼",
    "vi": "Ăn quỷ"
  },
  {
    "idx": 10743,
    "start": "04:59:37,571",
    "end": "04:59:39,951",
    "start_sec": 17977.571,
    "end_sec": 17979.951,
    "zh": "只要我把周扬的物账鬼吃了",
    "vi": "Chỉ cần tôi ăn con quỷ vật chất của Chu Dương"
  },
  {
    "idx": 10744,
    "start": "04:59:39,951",
    "end": "04:59:41,051",
    "start_sec": 17979.951,
    "end_sec": 17981.051,
    "zh": "一切都不成问题",
    "vi": "Mọi thứ sẽ không còn là vấn đề"
  },
  {
    "idx": 10745,
    "start": "04:59:41,051",
    "end": "04:59:42,311",
    "start_sec": 17981.051,
    "end_sec": 17982.311,
    "zh": "橙子皮",
    "vi": "Trần Tử Bì"
  },
  {
    "idx": 10746,
    "start": "04:59:42,311",
    "end": "04:59:43,971",
    "start_sec": 17982.311,
    "end_sec": 17983.971,
    "zh": "你这诡异真奇怪",
    "vi": "Con quỷ của bạn thật kỳ lạ"
  },
  {
    "idx": 10747,
    "start": "04:59:43,971",
    "end": "04:59:46,451",
    "start_sec": 17983.971,
    "end_sec": 17986.451,
    "zh": "我觉得你要是注册遇鬼者信息",
    "vi": "Tôi nghĩ nếu bạn đăng ký thông tin người gặp quỷ"
  },
  {
    "idx": 10748,
    "start": "04:59:46,451",
    "end": "04:59:47,891",
    "start_sec": 17986.451,
    "end_sec": 17987.891,
    "zh": "序列号应该不低",
    "vi": "Số seri sẽ không thấp đâu"
  },
  {
    "idx": 10749,
    "start": "04:59:47,891",
    "end": "04:59:52,511",
    "start_sec": 17987.891,
    "end_sec": 17992.511,
    "zh": "差不多这个时间点",
    "vi": "Khoảng thời gian này"
  },
  {
    "idx": 10750,
    "start": "04:59:52,511",
    "end": "04:59:53,811",
    "start_sec": 17992.511,
    "end_sec": 17993.811,
    "zh": "周扬要动手了",
    "vi": "Chu Dương sắp ra tay rồi"
  },
  {
    "idx": 10751,
    "start": "04:59:53,811",
    "end": "04:59:55,271",
    "start_sec": 17993.811,
    "end_sec": 17995.271,
    "zh": "屋内众人没再多说什么",
    "vi": "Mọi người trong nhà không nói thêm gì nữa"
  },
  {
    "idx": 10752,
    "start": "04:59:55,271",
    "end": "04:59:56,671",
    "start_sec": 17995.271,
    "end_sec": 17996.671,
    "zh": "琪琪太像橙子皮",
    "vi": "Kiki giống Trần Tử Bì quá"
  },
  {
    "idx": 10753,
    "start": "04:59:56,671",
    "end": "04:59:58,171",
    "start_sec": 17996.671,
    "end_sec": 17998.171,
    "zh": "似乎只有橙子皮在",
    "vi": "Dường như chỉ có Trần Tử Bì ở đây"
  },
  {
    "idx": 10754,
    "start": "04:59:58,171",
    "end": "04:59:59,891",
    "start_sec": 17998.171,
    "end_sec": 17999.891,
    "zh": "一切问题都会有解决的",
    "vi": "Mọi vấn đề sẽ được giải quyết"
  },
  {
    "idx": 10755,
    "start": "05:00:00,500",
    "end": "05:00:03,320",
    "start_sec": 18000.5,
    "end_sec": 18003.32,
    "zh": "这次要保护的目标全都保了下来",
    "vi": "Mục tiêu cần bảo vệ lần này đều đã được bảo toàn"
  },
  {
    "idx": 10756,
    "start": "05:00:03,320",
    "end": "05:00:04,840",
    "start_sec": 18003.32,
    "end_sec": 18004.84,
    "zh": "周扬接下来会怎么做",
    "vi": "Chu Dương sẽ làm gì tiếp theo"
  },
  {
    "idx": 10757,
    "start": "05:00:04,840",
    "end": "05:00:07,160",
    "start_sec": 18004.84,
    "end_sec": 18007.16,
    "zh": "要他下令了",
    "vi": "Ra lệnh cho hắn đi"
  },
  {
    "idx": 10758,
    "start": "05:00:07,160",
    "end": "05:00:08,080",
    "start_sec": 18007.16,
    "end_sec": 18008.08,
    "zh": "请准死",
    "vi": "Xin hãy chết"
  },
  {
    "idx": 10759,
    "start": "05:00:08,080",
    "end": "05:00:09,160",
    "start_sec": 18008.08,
    "end_sec": 18009.16,
    "zh": "那个开川的",
    "vi": "Cái kẻ mở mang đó"
  },
  {
    "idx": 10760,
    "start": "05:00:09,160",
    "end": "05:00:10,260",
    "start_sec": 18009.16,
    "end_sec": 18010.26,
    "zh": "无论代价",
    "vi": "Bất kể giá nào"
  },
  {
    "idx": 10761,
    "start": "05:00:10,260",
    "end": "05:00:13,940",
    "start_sec": 18010.26,
    "end_sec": 18013.94,
    "zh": "看来周扬的下一步棋已经很明确了",
    "vi": "Xem ra nước cờ tiếp theo của Chu Dương đã rất rõ ràng"
  },
  {
    "idx": 10762,
    "start": "05:00:13,940",
    "end": "05:00:15,460",
    "start_sec": 18013.94,
    "end_sec": 18015.46,
    "zh": "什么",
    "vi": "Cái gì"
  },
  {
    "idx": 10763,
    "start": "05:00:15,460",
    "end": "05:00:16,680",
    "start_sec": 18015.46,
    "end_sec": 18016.68,
    "zh": "就这一拳杂碎",
    "vi": "Chỉ một cú đấm này thôi sao"
  },
  {
    "idx": 10764,
    "start": "05:00:16,680",
    "end": "05:00:18,820",
    "start_sec": 18016.68,
    "end_sec": 18018.82,
    "zh": "周扬是前驴进熊了吗",
    "vi": "Chu Dương hết bài rồi sao"
  },
  {
    "idx": 10765,
    "start": "05:00:18,820",
    "end": "05:00:21,280",
    "start_sec": 18018.82,
    "end_sec": 18021.28,
    "zh": "没意思",
    "vi": "Chán quá"
  },
  {
    "idx": 10766,
    "start": "05:00:21,280",
    "end": "05:00:22,660",
    "start_sec": 18021.28,
    "end_sec": 18022.66,
    "zh": "026你来",
    "vi": "026, đến lượt cậu"
  },
  {
    "idx": 10767,
    "start": "05:00:22,660",
    "end": "05:00:23,960",
    "start_sec": 18022.66,
    "end_sec": 18023.96,
    "zh": "好好好",
    "vi": "Được rồi, được rồi"
  },
  {
    "idx": 10768,
    "start": "05:00:23,960",
    "end": "05:00:25,980",
    "start_sec": 18023.96,
    "end_sec": 18025.98,
    "zh": "真当我026是徒有虚名的吗",
    "vi": "Cậu nghĩ tôi 026 chỉ là hư danh sao"
  },
  {
    "idx": 10769,
    "start": "05:00:25,980",
    "end": "05:00:28,120",
    "start_sec": 18025.98,
    "end_sec": 18028.12,
    "zh": "来波涛老子精心杀多少",
    "vi": "Đến đây, tôi sẽ giết bao nhiêu người đây"
  },
  {
    "idx": 10770,
    "start": "05:00:30,000",
    "end": "05:00:33,320",
    "start_sec": 18030.0,
    "end_sec": 18033.32,
    "zh": "密集的射击声持续许久",
    "vi": "Tiếng súng liên thanh kéo dài một lúc"
  },
  {
    "idx": 10771,
    "start": "05:00:33,320",
    "end": "05:00:35,420",
    "start_sec": 18033.32,
    "end_sec": 18035.42,
    "zh": "026才苍白着脸回到屋里",
    "vi": "026 mặt mày nhợt nhạt trở về phòng"
  },
  {
    "idx": 10772,
    "start": "05:00:35,420",
    "end": "05:00:37,680",
    "start_sec": 18035.42,
    "end_sec": 18037.68,
    "zh": "这周扬下手也是狠啊",
    "vi": "Chu Dương này ra tay cũng thật tàn nhẫn"
  },
  {
    "idx": 10773,
    "start": "05:00:37,680",
    "end": "05:00:40,640",
    "start_sec": 18037.68,
    "end_sec": 18040.64,
    "zh": "若是刚才026会假徐天志商道",
    "vi": "Nếu vừa rồi 026 đối phó với Từ Thiên Chí giả"
  },
  {
    "idx": 10774,
    "start": "05:00:40,640",
    "end": "05:00:42,320",
    "start_sec": 18040.64,
    "end_sec": 18042.32,
    "zh": "在与那么多分身战斗",
    "vi": "Lại còn phải chiến đấu với nhiều phân thân như vậy"
  },
  {
    "idx": 10775,
    "start": "05:00:42,320",
    "end": "05:00:44,340",
    "start_sec": 18042.32,
    "end_sec": 18044.34,
    "zh": "恐怕水鬼早就复苏了",
    "vi": "E rằng thủy quỷ đã sớm thức tỉnh rồi"
  },
  {
    "idx": 10776,
    "start": "05:00:44,340",
    "end": "05:00:46,560",
    "start_sec": 18044.34,
    "end_sec": 18046.56,
    "zh": "026",
    "vi": "026"
  },
  {
    "idx": 10777,
    "start": "05:00:46,560",
    "end": "05:00:47,800",
    "start_sec": 18046.56,
    "end_sec": 18047.8,
    "zh": "你待在这屋里",
    "vi": "Cậu ở lại trong căn phòng này đi"
  },
  {
    "idx": 10778,
    "start": "05:00:47,800",
    "end": "05:00:49,760",
    "start_sec": 18047.8,
    "end_sec": 18049.76,
    "zh": "下到打麻烦帮忙照看下",

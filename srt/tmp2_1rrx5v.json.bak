    "end_sec": 169.72,
    "zh": "口之冲击后响",
    "vi": "Chúng lao thẳng về phía hẻm sau."
  },
  {
    "idx": 119,
    "start": "00:02:49,720",
    "end": "00:02:50,440",
    "start_sec": 169.72,
    "end_sec": 170.44,
    "zh": "超市里",
    "vi": "Bên trong siêu thị."
  },
  {
    "idx": 120,
    "start": "00:02:50,440",
    "end": "00:02:52,100",
    "start_sec": 170.44,
    "end_sec": 172.1,
    "zh": "咆哮和撞击声乱成一片",
    "vi": "Tiếng gầm rú và va đập vang lên hỗn loạn."
  },
  {
    "idx": 121,
    "start": "00:02:52,100",
    "end": "00:02:52,720",
    "start_sec": 172.1,
    "end_sec": 172.72,
    "zh": "成了",
    "vi": "Xong rồi"
  },
  {
    "idx": 122,
    "start": "00:02:52,720",
    "end": "00:02:54,200",
    "start_sec": 172.72,
    "end_sec": 174.2,
    "zh": "狗盛从墙上跳下来",
    "vi": "Gấu nhảy xuống từ tường"
  },
  {
    "idx": 123,
    "start": "00:02:54,200",
    "end": "00:02:55,300",
    "start_sec": 174.2,
    "end_sec": 175.3,
    "zh": "拍了拍爪子上的灰",
    "vi": "Vỗ bụi trên chân"
  },
  {
    "idx": 124,
    "start": "00:02:55,300",
    "end": "00:02:58,420",
    "start_sec": 175.3,
    "end_sec": 178.42,
    "zh": "爆炸会把超市里大部分活尸引过去",
    "vi": "Vụ nổ sẽ thu hút hầu hết xác sống trong siêu thị"
  },
  {
    "idx": 125,
    "start": "00:02:58,420",
    "end": "00:02:59,980",
    "start_sec": 178.42,
    "end_sec": 179.98,
    "zh": "他们会围在爆炸点",
    "vi": "Chúng sẽ tập trung ở điểm nổ"
  },
  {
    "idx": 126,
    "start": "00:02:59,980",
    "end": "00:03:00,960",
    "start_sec": 179.98,
    "end_sec": 180.96,
    "zh": "门口对八只",
    "vi": "Tám con ở cửa"
  },
  {
    "idx": 127,
    "start": "00:03:00,960",
    "end": "00:03:02,300",
    "start_sec": 180.96,
    "end_sec": 182.3,
    "zh": "我们速战速决",
    "vi": "Chúng ta giải quyết nhanh gọn"
  },
  {
    "idx": 128,
    "start": "00:03:02,300",
    "end": "00:03:03,960",
    "start_sec": 182.3,
    "end_sec": 183.96,
    "zh": "这脑子太好用了",
    "vi": "Cái đầu này thật hữu dụng"
  },
  {
    "idx": 129,
    "start": "00:03:03,960",
    "end": "00:03:04,740",
    "start_sec": 183.96,
    "end_sec": 184.74,
    "zh": "我们躲在巷口",
    "vi": "Chúng ta ẩn ở góc hẻm"
  },
  {
    "idx": 130,
    "start": "00:03:04,740",
    "end": "00:03:06,120",
    "start_sec": 184.74,
    "end_sec": 186.12,
    "zh": "等那八只活士冲进来",
    "vi": "Chờ tám con xác sống lao vào"
  },
  {
    "idx": 131,
    "start": "00:03:06,120",
    "end": "00:03:06,840",
    "start_sec": 186.12,
    "end_sec": 186.84,
    "zh": "我顶前面",
    "vi": "Tôi sẽ chặn đầu"
  },
  {
    "idx": 132,
    "start": "00:03:06,840",
    "end": "00:03:07,640",
    "start_sec": 186.84,
    "end_sec": 187.64,
    "zh": "狗圣偷袭",
    "vi": "Gấu sẽ tấn công bất ngờ"
  },
  {
    "idx": 133,
    "start": "00:03:07,640",
    "end": "00:03:08,440",
    "start_sec": 187.64,
    "end_sec": 188.44,
    "zh": "不到五分钟",
    "vi": "Không đầy năm phút"
  },
  {
    "idx": 134,
    "start": "00:03:08,440",
    "end": "00:03:10,520",
    "start_sec": 188.44,
    "end_sec": 190.52,
    "zh": "八具无头尸体倒在巷子里",
    "vi": "Tám xác chết không đầu nằm trong hẻm"
  },
  {
    "idx": 135,
    "start": "00:03:10,520",
    "end": "00:03:11,080",
    "start_sec": 190.52,
    "end_sec": 191.08,
    "zh": "收东西",
    "vi": "Thu dọn đồ đạc"
  },
  {
    "idx": 136,
    "start": "00:03:11,080",
    "end": "00:03:11,940",
    "start_sec": 191.08,
    "end_sec": 191.94,
    "zh": "然后进场",
    "vi": "Rồi vào trong"
  },
  {
    "idx": 137,
    "start": "00:03:11,940",
    "end": "00:03:13,460",
    "start_sec": 191.94,
    "end_sec": 193.46,
    "zh": "狗圣叼起跟学家说着",
    "vi": "Gấu ngậm đồ vật nói với nhà khoa học"
  },
  {
    "idx": 138,
    "start": "00:03:13,460",
    "end": "00:03:14,860",
    "start_sec": 193.46,
    "end_sec": 194.86,
    "zh": "超市里浓烟弥漫",
    "vi": "Siêu thị khói mù mịt"
  },
  {
    "idx": 139,
    "start": "00:03:14,860",
    "end": "00:03:17,280",
    "start_sec": 194.86,
    "end_sec": 197.28,
    "zh": "大部分活士果然被引到了后方爆炸点",
    "vi": "Hầu hết xác sống quả nhiên bị dẫn đến điểm nổ phía sau"
  },
  {
    "idx": 140,
    "start": "00:03:17,280",
    "end": "00:03:18,220",
    "start_sec": 197.28,
    "end_sec": 198.22,
    "zh": "就没站得好",
    "vi": "Không đứng đúng chỗ"
  },
  {
    "idx": 141,
    "start": "00:03:18,220",
    "end": "00:03:19,720",
    "start_sec": 198.22,
    "end_sec": 199.72,
    "zh": "只有几只还在护甲间晃悠",
    "vi": "Chỉ còn vài con lảng vảng giữa các kệ hàng"
  },
  {
    "idx": 142,
    "start": "00:03:19,720",
    "end": "00:03:21,040",
    "start_sec": 199.72,
    "end_sec": 201.04,
    "zh": "我跟狗圣对了个手势",
    "vi": "Tôi và Gấu ra hiệu cho nhau"
  },
  {
    "idx": 143,
    "start": "00:03:21,040",
    "end": "00:03:21,980",
    "start_sec": 201.04,
    "end_sec": 201.98,
    "zh": "开始凌连斗",
    "vi": "Bắt đầu cuộc chiến"
  },
  {
    "idx": 144,
    "start": "00:03:21,980",
    "end": "00:03:23,920",
    "start_sec": 201.98,
    "end_sec": 203.92,
    "zh": "三大箱火腿肠三百多根",
    "vi": "Ba thùng xúc xích, hơn ba trăm cây"
  },
  {
    "idx": 145,
    "start": "00:03:23,920",
    "end": "00:03:25,200",
    "start_sec": 203.92,
    "end_sec": 205.2,
    "zh": "我全塞进登山包",
    "vi": "Tôi nhét hết vào ba lô leo núi"
  },
  {
    "idx": 146,
    "start": "00:03:25,200",
    "end": "00:03:26,480",
    "start_sec": 205.2,
    "end_sec": 206.48,
    "zh": "接着是矿泉水",
    "vi": "Tiếp theo là nước khoáng"
  },
  {
    "idx": 147,
    "start": "00:03:26,480",
    "end": "00:03:27,280",
    "start_sec": 206.48,
    "end_sec": 207.28,
    "zh": "压锁饼干",
    "vi": "Bánh quy ép khô"
  },
  {
    "idx": 148,
    "start": "00:03:27,280",
    "end": "00:03:27,820",
    "start_sec": 207.28,
    "end_sec": 207.82,
    "zh": "罐头",
    "vi": "Đồ hộp"
  },
  {
    "idx": 149,
    "start": "00:03:27,820",
    "end": "00:03:28,340",
    "start_sec": 207.82,
    "end_sec": 208.34,
    "zh": "去二楼",
    "vi": "Lên tầng hai"
  },
  {
    "idx": 150,
    "start": "00:03:28,340",
    "end": "00:03:29,920",
    "start_sec": 208.34,
    "end_sec": 209.92,
    "zh": "奶粉比这些值钱",
    "vi": "Sữa bột còn giá trị hơn mấy thứ này"
  },
  {
    "idx": 151,
    "start": "00:03:29,920",
    "end": "00:03:31,160",
    "start_sec": 209.92,
    "end_sec": 211.16,
    "zh": "我们猫着腰上了二楼",
    "vi": "Chúng tôi khom lưng đi lên tầng hai."
  },
  {
    "idx": 152,
    "start": "00:03:31,160",
    "end": "00:03:32,460",
    "start_sec": 211.16,
    "end_sec": 212.46,
    "zh": "母婴区一片死寂",
    "vi": "Khu đồ mẹ và bé im lặng như tờ."
  },
  {
    "idx": 153,
    "start": "00:03:32,460",
    "end": "00:03:33,920",
    "start_sec": 212.46,
    "end_sec": 213.92,
    "zh": "我刚要冲向奶粉货架",
    "vi": "Tôi vừa định lao về phía kệ sữa bột."
  },
  {
    "idx": 154,
    "start": "00:03:33,920",
    "end": "00:03:34,900",
    "start_sec": 213.92,
    "end_sec": 214.9,
    "zh": "是被狗声拦住",
    "vi": "Thì bị Cẩu Thanh cản lại."
  },
  {
    "idx": 155,
    "start": "00:03:34,900",
    "end": "00:03:35,540",
    "start_sec": 214.9,
    "end_sec": 215.54,
    "zh": "等等",
    "vi": "Chờ đã."
  },
  {
    "idx": 156,
    "start": "00:03:35,540",
    "end": "00:03:36,680",
    "start_sec": 215.54,
    "end_sec": 216.68,
    "zh": "有活人的影",
    "vi": "Có bóng người sống."
  },
  {
    "idx": 157,
    "start": "00:03:36,680",
    "end": "00:03:37,440",
    "start_sec": 216.68,
    "end_sec": 217.44,
    "zh": "他压低声音",
    "vi": "Cậu ta hạ thấp giọng."
  },
  {
    "idx": 158,
    "start": "00:03:37,440",
    "end": "00:03:38,140",
    "start_sec": 217.44,
    "end_sec": 218.14,
    "zh": "笛子闻了闻",
    "vi": "Địch Tử ngửi ngửi."
  },
  {
    "idx": 159,
    "start": "00:03:38,140",
    "end": "00:03:39,080",
    "start_sec": 218.14,
    "end_sec": 219.08,
    "zh": "朝着前面指去",
    "vi": "Rồi chỉ về phía trước."
  },
  {
    "idx": 160,
    "start": "00:03:39,080",
    "end": "00:03:39,660",
    "start_sec": 219.08,
    "end_sec": 219.66,
    "zh": "我一愣",
    "vi": "Tôi ngẩn người."
  },
  {
    "idx": 161,
    "start": "00:03:39,660",
    "end": "00:03:41,100",
    "start_sec": 219.66,
    "end_sec": 221.1,
    "zh": "顺着他指的方向看去",
    "vi": "Nhìn theo hướng cậu ta chỉ."
  },
  {
    "idx": 162,
    "start": "00:03:41,100",
    "end": "00:03:42,940",
    "start_sec": 221.1,
    "end_sec": 222.94,
    "zh": "在一个堆满纸尿裤的货架后头",
    "vi": "Phía sau một chiếc kệ chất đầy tã giấy."
  },
  {
    "idx": 163,
    "start": "00:03:42,940",
    "end": "00:03:44,060",
    "start_sec": 222.94,
    "end_sec": 224.06,
    "zh": "有轻微的动静",
    "vi": "Có tiếng động nhẹ."
  },
  {
    "idx": 164,
    "start": "00:03:44,060",
    "end": "00:03:44,720",
    "start_sec": 224.06,
    "end_sec": 224.72,
    "zh": "谁在那",
    "vi": "Ai ở đó thế."
  },
  {
    "idx": 165,
    "start": "00:03:44,720",
    "end": "00:03:45,600",
    "start_sec": 224.72,
    "end_sec": 225.6,
    "zh": "我抓紧战刀",
    "vi": "Tôi siết chặt thanh đao."
  },
  {
    "idx": 166,
    "start": "00:03:45,600",
    "end": "00:03:46,080",
    "start_sec": 225.6,
    "end_sec": 226.08,
    "zh": "低喝",
    "vi": "Khẽ quát."
  },
  {
    "idx": 167,
    "start": "00:03:46,080",
    "end": "00:03:47,560",
    "start_sec": 226.08,
    "end_sec": 227.56,
    "zh": "货架后安静了几秒",
    "vi": "Phía sau kệ hàng im lặng vài giây."
  },
  {
    "idx": 168,
    "start": "00:03:47,560",
    "end": "00:03:49,020",
    "start_sec": 227.56,
    "end_sec": 229.02,
    "zh": "一个发抖的女声响起",
    "vi": "Một giọng nữ run rẩy vang lên."
  },
  {
    "idx": 169,
    "start": "00:03:49,020",
    "end": "00:03:49,640",
    "start_sec": 229.02,
    "end_sec": 229.64,
    "zh": "李重九",
    "vi": "Lý Trọng Cửu."
  },
  {
    "idx": 170,
    "start": "00:03:49,640",
    "end": "00:03:51,820",
    "start_sec": 229.64,
    "end_sec": 231.82,
    "zh": "别 别杀我 我不是怪物",
    "vi": "Đừng đừng giết tôi tôi không phải quái vật."
  },
  {
    "idx": 171,
    "start": "00:03:51,820",
    "end": "00:03:54,660",
    "start_sec": 231.82,
    "end_sec": 234.66,
    "zh": "一个女孩看出头 脸很白 长得挺漂亮",
    "vi": "Một cô gái thò đầu ra khuôn mặt trắng bệch trông rất xinh đẹp."
  },
  {
    "idx": 172,
    "start": "00:03:54,660",
    "end": "00:03:55,520",
    "start_sec": 234.66,
    "end_sec": 235.52,
    "zh": "你怎么在这",
    "vi": "Sao bạn lại ở đây."
  },
  {
    "idx": 173,
    "start": "00:03:55,520",
    "end": "00:03:58,360",
    "start_sec": 235.52,
    "end_sec": 238.36,
    "zh": "是我们学校的校花 柳如烟 出了名的高冷",
    "vi": "Đó là hoa khôi trường chúng tôi Liễu Như Yên nổi tiếng lạnh lùng."
  },
  {
    "idx": 174,
    "start": "00:03:58,360",
    "end": "00:04:01,180",
    "start_sec": 238.36,
    "end_sec": 241.18,
    "zh": "身边总围着一帮富二代 跟我是两个世界的人",
    "vi": "Xung quanh cô ấy luôn có một đám công tử nhà giàu chúng tôi là người của hai thế giới khác nhau."
  },
  {
    "idx": 175,
    "start": "00:04:01,180",
    "end": "00:04:02,600",
    "start_sec": 241.18,
    "end_sec": 242.6,
    "zh": "我 我家就在附近",
    "vi": "Nhà nhà tôi ở ngay gần đây."
  },
  {
    "idx": 176,
    "start": "00:04:02,600",
    "end": "00:04:04,860",
    "start_sec": 242.6,
    "end_sec": 244.86,
    "zh": "出事的时候 我正好来超市买东西",
    "vi": "Lúc xảy ra chuyện tôi vừa hay đến siêu thị mua đồ."
  },
  {
    "idx": 177,
    "start": "00:04:04,860",
    "end": "00:04:06,140",
    "start_sec": 244.86,
    "end_sec": 246.14,
    "zh": "然后就被困住了",
    "vi": "Sau đó thì bị kẹt lại."
  },
  {
    "idx": 178,
    "start": "00:04:06,140",
    "end": "00:04:08,400",
    "start_sec": 246.14,
    "end_sec": 248.4,
    "zh": "我好怕 这里到处都是怪物",
    "vi": "Tôi sợ lắm ở đây đâu đâu cũng là quái vật."
  },
  {
    "idx": 179,
    "start": "00:04:08,400",
    "end": "00:04:09,920",
    "start_sec": 248.4,
    "end_sec": 249.92,
    "zh": "这 这是什么",
    "vi": "Đây đây là cái gì."
  },
  {
    "idx": 180,
    "start": "00:04:09,920",
    "end": "00:04:10,980",
    "start_sec": 249.92,
    "end_sec": 250.98,
    "zh": "我火气",
    "vi": "Tôi nổi giận."
  },
  {
    "idx": 181,
    "start": "00:04:10,980",
    "end": "00:04:12,220",
    "start_sec": 250.98,
    "end_sec": 252.22,
    "zh": "狗圣对她自了自压",
    "vi": "Cẩu Thánh nhìn cô ta đầy chán ghét."
  },
  {
    "idx": 182,
    "start": "00:04:12,220",
    "end": "00:04:14,240",
    "start_sec": 252.22,
    "end_sec": 254.24,
    "zh": "对这个打扰我们进货的女人很不爽",
    "vi": "Hắn rất khó chịu với người phụ nữ cản trở việc lấy hàng."
  },
  {
    "idx": 183,
    "start": "00:04:14,240",
    "end": "00:04:16,740",
    "start_sec": 254.24,
    "end_sec": 256.74,
    "zh": "赌人别跟她废话 拿了奶粉就走",
    "vi": "Đừng nói nhảm với cô ta nữa lấy sữa bột rồi đi thôi."
  },
  {
    "idx": 184,
    "start": "00:04:16,740",
    "end": "00:04:17,940",
    "start_sec": 256.74,
    "end_sec": 257.94,
    "zh": "女人比活是麻烦",
    "vi": "Phụ nữ đúng là phiền phức."
  },
  {
    "idx": 185,
    "start": "00:04:17,940",
    "end": "00:04:18,640",
    "start_sec": 257.94,
    "end_sec": 258.64,
    "zh": "他低声说",
    "vi": "Hắn thì thầm."
  },
  {
    "idx": 186,
    "start": "00:04:18,640",
    "end": "00:04:19,960",
    "start_sec": 258.64,
    "end_sec": 259.96,
    "zh": "我刚想绕开他拿奶粉",
    "vi": "Tôi vừa định lách qua hắn để lấy sữa bột."
  },
  {
    "idx": 187,
    "start": "00:04:19,960",
    "end": "00:04:21,980",
    "start_sec": 259.96,
    "end_sec": 261.98,
    "zh": "柳若烟突然冲过来抓住我的胳膊",
    "vi": "Liễu Nhược Yên đột nhiên lao tới nắm lấy cánh tay tôi."
  },
  {
    "idx": 188,
    "start": "00:04:21,980",
    "end": "00:04:22,560",
    "start_sec": 261.98,
    "end_sec": 262.56,
    "zh": "李冲久",
    "vi": "Lý Xung Cửu."
  },
  {
    "idx": 189,
    "start": "00:04:22,560",
    "end": "00:04:23,480",
    "start_sec": 262.56,
    "end_sec": 263.48,
    "zh": "带我一起走吧",
    "vi": "Hãy đưa tôi đi cùng với."
  },
  {
    "idx": 190,
    "start": "00:04:23,480",
    "end": "00:04:24,900",
    "start_sec": 263.48,
    "end_sec": 264.9,
    "zh": "我什么都能做",
    "vi": "Tôi có thể làm bất cứ việc gì."
  },
  {
    "idx": 191,
    "start": "00:04:24,900",
    "end": "00:04:25,860",
    "start_sec": 264.9,
    "end_sec": 265.86,
    "zh": "他哭着",
    "vi": "Cô ta khóc lóc."
  },
  {
    "idx": 192,
    "start": "00:04:25,860",
    "end": "00:04:27,620",
    "start_sec": 265.86,
    "end_sec": 267.62,
    "zh": "胸口紧紧贴着我的手臂",
    "vi": "Ngực cô ta ép chặt vào cánh tay tôi."
  },
  {
    "idx": 193,
    "start": "00:04:27,620",
    "end": "00:04:28,320",
    "start_sec": 267.62,
    "end_sec": 268.32,
    "zh": "放手",
    "vi": "Buông ra."
  },
  {
    "idx": 194,
    "start": "00:04:28,320",
    "end": "00:04:28,640",
    "start_sec": 268.32,
    "end_sec": 268.64,
    "zh": "不",
    "vi": "Không."
  },
  {
    "idx": 195,
    "start": "00:04:28,640",
    "end": "00:04:29,680",
    "start_sec": 268.64,
    "end_sec": 269.68,
    "zh": "你带我走",
    "vi": "Anh phải đưa tôi đi."
  },
  {
    "idx": 196,
    "start": "00:04:29,680",
    "end": "00:04:31,440",
    "start_sec": 269.68,
    "end_sec": 271.44,
    "zh": "我送给女朋友都行",
    "vi": "Tôi làm bạn gái anh cũng được."
  },
  {
    "idx": 197,
    "start": "00:04:31,440",
    "end": "00:04:32,440",
    "start_sec": 271.44,
    "end_sec": 272.44,
    "zh": "就在这时",
    "vi": "Đúng lúc này."
  },
  {
    "idx": 198,
    "start": "00:04:32,440",
    "end": "00:04:33,700",
    "start_sec": 272.44,
    "end_sec": 273.7,
    "zh": "楼下传来一阵骚动",
    "vi": "Dưới lầu truyền đến tiếng động lạ."
  },
  {
    "idx": 199,
    "start": "00:04:33,700",
    "end": "00:04:34,440",
    "start_sec": 273.7,
    "end_sec": 274.44,
    "zh": "放手",
    "vi": "Buông ra."
  },
  {
    "idx": 200,
    "start": "00:04:34,440",
    "end": "00:04:34,840",
    "start_sec": 274.44,
    "end_sec": 274.84,
    "zh": "不",
    "vi": "Không."
  },
  {
    "idx": 201,
    "start": "00:04:34,840",
    "end": "00:04:35,820",
    "start_sec": 274.84,
    "end_sec": 275.82,
    "zh": "你带我走",
    "vi": "Anh phải đưa tôi đi."
  },
  {
    "idx": 202,
    "start": "00:04:35,820",
    "end": "00:04:37,580",
    "start_sec": 275.82,
    "end_sec": 277.58,
    "zh": "我送给女朋友都行",
    "vi": "Tôi làm bạn gái anh cũng được."
  },
  {
    "idx": 203,
    "start": "00:04:37,580",
    "end": "00:04:38,580",
    "start_sec": 277.58,
    "end_sec": 278.58,
    "zh": "就在这时",
    "vi": "Đúng lúc này."
  },
  {
    "idx": 204,
    "start": "00:04:38,580",
    "end": "00:04:39,840",
    "start_sec": 278.58,
    "end_sec": 279.84,
    "zh": "楼下传来一阵骚动",
    "vi": "Dưới lầu truyền đến tiếng động lạ."
  },
  {
    "idx": 205,
    "start": "00:04:39,840",
    "end": "00:04:41,400",
    "start_sec": 279.84,
    "end_sec": 281.4,
    "zh": "几只被我们漏掉的活尸",
    "vi": "Vài con xác sống mà chúng tôi bỏ sót."
  },
  {
    "idx": 206,
    "start": "00:04:41,400",
    "end": "00:04:42,680",
    "start_sec": 281.4,
    "end_sec": 282.68,
    "zh": "发现了这间的洞前",
    "vi": "Đã phát hiện ra vị trí này."
  },
  {
    "idx": 207,
    "start": "00:04:42,680",
    "end": "00:04:44,380",
    "start_sec": 282.68,
    "end_sec": 284.38,
    "zh": "正吼着朝楼梯口冲来",
    "vi": "Đang gầm rú lao về phía cầu thang."
  },
  {
    "idx": 208,
    "start": "00:04:44,380",
    "end": "00:04:45,220",
    "start_sec": 284.38,
    "end_sec": 285.22,
    "zh": "狗声低吼",
    "vi": "Cẩu Thánh gầm nhẹ."
  },
  {
    "idx": 209,
    "start": "00:04:45,220",
    "end": "00:04:45,780",
    "start_sec": 285.22,
    "end_sec": 285.78,
    "zh": "不好",
    "vi": "Không ổn rồi."
  },
  {
    "idx": 210,
    "start": "00:04:45,780",
    "end": "00:04:46,740",
    "start_sec": 285.78,
    "end_sec": 286.74,
    "zh": "快走",
    "vi": "Mau chạy đi."
  },
  {
    "idx": 211,
    "start": "00:04:46,740",
    "end": "00:04:48,620",
    "start_sec": 286.74,
    "end_sec": 288.62,
    "zh": "这儿的活石被惊动了",
    "vi": "Xác sống ở đây đã bị đánh động rồi."
  },
  {
    "idx": 212,
    "start": "00:04:48,620",
    "end": "00:04:49,780",
    "start_sec": 288.62,
    "end_sec": 289.78,
    "zh": "我一把甩开柳如烟",
    "vi": "Tôi gạt phắt Liễu Như Yên ra."
  },
  {
    "idx": 213,
    "start": "00:04:49,780",
    "end": "00:04:52,680",
    "start_sec": 289.78,
    "end_sec": 292.68,
    "zh": "抓起货架上几罐最贵的进口奶粉就往包里塞",
    "vi": "Vơ lấy mấy hộp sữa bột nhập khẩu đắt nhất trên kệ nhét vào túi."
  },
  {
    "idx": 214,
    "start": "00:04:52,680",
    "end": "00:04:53,400",
    "start_sec": 292.68,
    "end_sec": 293.4,
    "zh": "李同学",
    "vi": "Bạn Lý."
  },
  {
    "idx": 215,
    "start": "00:04:53,400",
    "end": "00:04:54,840",
    "start_sec": 293.4,
    "end_sec": 294.84,
    "zh": "你不能丢下我",
    "vi": "Bạn không thể bỏ rơi tôi."
  },
  {
    "idx": 216,
    "start": "00:04:54,840",
    "end": "00:04:58,308",
    "start_sec": 294.84,
    "end_sec": 298.308,
    "zh": "柳如烟尖叫又扑了上来她抱着我的腿我走不动你疯了我弄吼活石已经冲上楼梯离我们不到十米带我走不然我们一起死妈的",
    "vi": "Liễu Như Yên hét lên rồi lại lao tới ôm chặt lấy chân tôi làm tôi không đi được"
  },
  {
    "idx": 216,
    "start": "00:04:58,308",
    "end": "00:05:02,323",
    "start_sec": 298.308,
    "end_sec": 302.323,
    "zh": "柳如烟尖叫又扑了上来她抱着我的腿我走不动你疯了我弄吼活石已经冲上楼梯离我们不到十米带我走不然我们一起死妈的",
    "vi": "Tôi gầm lên rằng cô điên rồi sao, xác sống đã lao lên cầu thang cách chúng ta chưa đầy mười mét"
  },
  {
    "idx": 216,
    "start": "00:05:02,323",
    "end": "00:05:05,061",
    "start_sec": 302.323,
    "end_sec": 305.061,
    "zh": "柳如烟尖叫又扑了上来她抱着我的腿我走不动你疯了我弄吼活石已经冲上楼梯离我们不到十米带我走不然我们一起死妈的",
    "vi": "Cô ta hét lên hãy đưa tôi đi cùng nếu không chúng ta cùng chết"
  },
  {
    "idx": 216,
    "start": "00:05:05,061",
    "end": "00:05:05,426",
    "start_sec": 305.061,
    "end_sec": 305.426,
    "zh": "柳如烟尖叫又扑了上来她抱着我的腿我走不动你疯了我弄吼活石已经冲上楼梯离我们不到十米带我走不然我们一起死妈的",
    "vi": "Mẹ kiếp"
  },
  {
    "idx": 217,
    "start": "00:05:05,426",
    "end": "00:05:06,426",
    "start_sec": 305.426,
    "end_sec": 306.426,
    "zh": "我低骂一声",
    "vi": "Tôi chửi thề một tiếng."
  },
  {
    "idx": 218,
    "start": "00:05:06,426",
    "end": "00:05:08,306",
    "start_sec": 306.426,
    "end_sec": 308.306,
    "zh": "这个女人真比活石还烦",
    "vi": "Người đàn bà này còn phiền phức hơn cả xác sống."
  },
  {
    "idx": 219,
    "start": "00:05:08,306",
    "end": "00:05:10,126",
    "start_sec": 308.306,
    "end_sec": 310.126,
    "zh": "最近的活石已经扑到面前",
    "vi": "Con xác sống gần nhất đã lao đến trước mặt."
  },
  {
    "idx": 220,
    "start": "00:05:10,126",
    "end": "00:05:11,666",
    "start_sec": 310.126,
    "end_sec": 311.666,
    "zh": "臭口水都要滴到我脸上",
    "vi": "Nước dãi hôi thối sắp nhỏ giọt lên mặt tôi."
  },
  {
    "idx": 221,
    "start": "00:05:11,666",
    "end": "00:05:13,106",
    "start_sec": 311.666,
    "end_sec": 313.106,
    "zh": "我抬脚想踹开柳如烟",
    "vi": "Tôi nhấc chân muốn đá văng Liễu Như Yên ra."
  },
  {
    "idx": 222,
    "start": "00:05:13,106",
    "end": "00:05:14,126",
    "start_sec": 313.106,
    "end_sec": 314.126,
    "zh": "但她抱得太紧",
    "vi": "Nhưng cô ta ôm quá chặt."
  },
  {
    "idx": 223,
    "start": "00:05:14,126",
    "end": "00:05:15,746",
    "start_sec": 314.126,
    "end_sec": 315.746,
    "zh": "关键时候狗盛动了",
    "vi": "Vào thời khắc quyết định Cẩu Thịnh đã ra tay."
  },
  {
    "idx": 224,
    "start": "00:05:15,746",
    "end": "00:05:17,306",
    "start_sec": 315.746,
    "end_sec": 317.306,
    "zh": "黑影撞在柳如烟腰上",
    "vi": "Bóng đen tông thẳng vào eo Liễu Như Yên."
  },
  {
    "idx": 225,
    "start": "00:05:17,306",
    "end": "00:05:19,286",
    "start_sec": 317.306,
    "end_sec": 319.286,
    "zh": "柳如烟惨叫一声滚到一边",
    "vi": "Liễu Như Yên hét thảm một tiếng rồi lăn ra một bên."
  },
  {
    "idx": 226,
    "start": "00:05:19,286",
    "end": "00:05:20,766",
    "start_sec": 319.286,
    "end_sec": 320.766,
    "zh": "我的乐空反手一刀",
    "vi": "Tôi vung tay chém ngược một dao."
  },
  {
    "idx": 227,
    "start": "00:05:20,766",
    "end": "00:05:22,446",
    "start_sec": 320.766,
    "end_sec": 322.446,
    "zh": "砍下扑上来那活石的脑袋",
    "vi": "Chém bay đầu con xác sống đang lao tới."
  },
  {
    "idx": 228,
    "start": "00:05:22,446",
    "end": "00:05:23,966",
    "start_sec": 322.446,
    "end_sec": 323.966,
    "zh": "黑雪见了他满脸",
    "vi": "Máu đen bắn tung tóe đầy mặt cô ta."
  },
  {
    "idx": 229,
    "start": "00:05:23,966",
    "end": "00:05:25,666",
    "start_sec": 323.966,
    "end_sec": 325.666,
    "zh": "他尖叫着瘫在地上发抖",
    "vi": "Cô ta hét lên rồi ngã quỵ xuống đất run rẩy."
  },
  {
    "idx": 230,
    "start": "00:05:25,666",
    "end": "00:05:26,846",
    "start_sec": 325.666,
    "end_sec": 326.846,
    "zh": "脱后嘴的玩意儿",
    "vi": "Kẻ ngáng đường vô dụng."
  },
  {
    "idx": 231,
    "start": "00:05:26,846",
    "end": "00:05:28,066",
    "start_sec": 326.846,
    "end_sec": 328.066,
    "zh": "狗圣不屑催了一口",
    "vi": "Cẩu Thịnh khinh bỉ nhổ một bãi."
  },
  {
    "idx": 232,
    "start": "00:05:28,066",
    "end": "00:05:28,646",
    "start_sec": 328.066,
    "end_sec": 328.646,
    "zh": "主人",
    "vi": "Chủ nhân."
  },
  {
    "idx": 233,
    "start": "00:05:28,646",
    "end": "00:05:29,566",
    "start_sec": 328.646,
    "end_sec": 329.566,
    "zh": "别管他",
    "vi": "Đừng quan tâm cô ta."
  },
  {
    "idx": 234,
    "start": "00:05:29,566",
    "end": "00:05:30,306",
    "start_sec": 329.566,
    "end_sec": 330.306,
    "zh": "我们走",
    "vi": "Chúng ta đi thôi."
  },
  {
    "idx": 235,
    "start": "00:05:30,306",
    "end": "00:05:31,786",
    "start_sec": 330.306,
    "end_sec": 331.786,
    "zh": "又有两只活石冲了上来",
    "vi": "Lại có thêm hai con xác sống lao lên."
  },
  {
    "idx": 236,
    "start": "00:05:31,786",
    "end": "00:05:32,686",
    "start_sec": 331.786,
    "end_sec": 332.686,
    "zh": "火灰刀挡住",
    "vi": "Tôi vung dao chặn lại."
  },
  {
    "idx": 237,
    "start": "00:05:32,686",
    "end": "00:05:33,586",
    "start_sec": 332.686,
    "end_sec": 333.586,
    "zh": "但空间太小",
    "vi": "Nhưng không gian quá hẹp."
  },
  {
    "idx": 238,
    "start": "00:05:33,586",
    "end": "00:05:34,186",
    "start_sec": 333.586,
    "end_sec": 334.186,
    "zh": "不好动手",
    "vi": "Khó mà xoay xở."
  },
  {
    "idx": 239,
    "start": "00:05:34,186",
    "end": "00:05:35,246",
    "start_sec": 334.186,
    "end_sec": 335.246,
    "zh": "被逼得之后退",
    "vi": "Bị ép phải lùi lại phía sau."
  },
  {
    "idx": 240,
    "start": "00:05:35,246",
    "end": "00:05:36,006",
    "start_sec": 335.246,
    "end_sec": 336.006,
    "zh": "李初九",
    "vi": "Lý Sơ Cửu."
  },
  {
    "idx": 241,
    "start": "00:05:36,006",
    "end": "00:05:36,886",
    "start_sec": 336.006,
    "end_sec": 336.886,
    "zh": "是我",
    "vi": "Là tôi."
  },
  {
    "idx": 242,
    "start": "00:05:36,886",
    "end": "00:05:38,466",
    "start_sec": 336.886,
    "end_sec": 338.466,
    "zh": "刘如燕还在尖叫",
    "vi": "Lưu Như Yến vẫn đang la hét."
  },
  {
    "idx": 243,
    "start": "00:05:38,466",
    "end": "00:05:39,586",
    "start_sec": 338.466,
    "end_sec": 339.586,
    "zh": "把奶粉给我",
    "vi": "Đưa hộp sữa bột cho tôi."
  },
  {
    "idx": 244,
    "start": "00:05:39,586",
    "end": "00:05:40,506",
    "start_sec": 339.586,
    "end_sec": 340.506,
    "zh": "狗圣突然喊",
    "vi": "Cẩu Thánh đột nhiên hét lên."
  },
  {
    "idx": 245,
    "start": "00:05:40,506",
    "end": "00:05:41,246",
    "start_sec": 340.506,
    "end_sec": 341.246,
    "zh": "我愣了一下",
    "vi": "Tôi ngẩn người ra một lúc."
  },
  {
    "idx": 246,
    "start": "00:05:41,246",
    "end": "00:05:42,166",
    "start_sec": 341.246,
    "end_sec": 342.166,
    "zh": "立刻从背包里",
    "vi": "Lập tức lấy từ trong ba lô ra"
  },
  {
    "idx": 247,
    "start": "00:05:42,166",
    "end": "00:05:43,386",
    "start_sec": 342.166,
    "end_sec": 343.386,
    "zh": "掏出一罐奶粉扔给他",
    "vi": "một hộp sữa bột rồi ném cho nó."
  },
  {
    "idx": 248,
    "start": "00:05:43,386",
    "end": "00:05:44,986",
    "start_sec": 343.386,
    "end_sec": 344.986,
    "zh": "狗圣用爪子拧开袋子",
    "vi": "Cẩu Thánh dùng móng vuốt xé mở túi."
  },
  {
    "idx": 249,
    "start": "00:05:44,986",
    "end": "00:05:46,306",
    "start_sec": 344.986,
    "end_sec": 346.306,
    "zh": "不知从哪摸出一样东西",
    "vi": "Không biết nó móc từ đâu ra một thứ."
  },
  {
    "idx": 250,
    "start": "00:05:46,306",
    "end": "00:05:47,546",
    "start_sec": 346.306,
    "end_sec": 347.546,
    "zh": "一颗能量精盒被入",
    "vi": "Một viên tinh hạch năng lượng."
  },
  {
    "idx": 251,
    "start": "00:05:47,546",
    "end": "00:05:49,086",
    "start_sec": 347.546,
    "end_sec": 349.086,
    "zh": "他把精盒扔进奶粉罐",
    "vi": "Nó ném viên tinh hạch vào hộp sữa bột."
  },
  {
    "idx": 252,
    "start": "00:05:49,086",
    "end": "00:05:49,986",
    "start_sec": 349.086,
    "end_sec": 349.986,
    "zh": "发动了能力",
    "vi": "Rồi kích hoạt năng lực."
  },
  {
    "idx": 253,
    "start": "00:05:49,986",
    "end": "00:05:51,726",
    "start_sec": 349.986,
    "end_sec": 351.726,
    "zh": "进口奶粉加能量精盒",
    "vi": "Sữa bột nhập khẩu cộng với tinh hạch năng lượng."
  },
  {
    "idx": 254,
    "start": "00:05:51,726",
    "end": "00:05:52,386",
    "start_sec": 351.726,
    "end_sec": 352.386,
    "zh": "光一闪",
    "vi": "Một luồng sáng lóe lên."
  },
  {
    "idx": 255,
    "start": "00:05:52,386",
    "end": "00:05:53,586",
    "start_sec": 352.386,
    "end_sec": 353.586,
    "zh": "奶粉罐剧烈抖动",
    "vi": "Hộp sữa bột rung lắc dữ dội."
  },
  {

    "vi": "Cấu trúc kho vững chắc."
  },
  {
    "idx": 553,
    "start": "00:12:23,212",
    "end": "00:12:23,812",
    "start_sec": 743.212,
    "end_sec": 743.812,
    "zh": "好手",
    "vi": "Tuyệt vời."
  },
  {
    "idx": 554,
    "start": "00:12:23,812",
    "end": "00:12:25,432",
    "start_sec": 743.812,
    "end_sec": 745.432,

    "start_sec": 733.612,
    "end_sec": 735.092,
    "zh": "城西五金仓库",
    "vi": "Đến kho kim khí phía Tây thành phố."
  },
  {
    "idx": 547,
    "start": "00:12:15,092",
    "end": "00:12:15,872",
    "start_sec": 735.092,
    "end_sec": 735.872,
    "zh": "哪儿人少",
    "vi": "Chỗ nào ít người."
  },
  {
    "idx": 548,
    "start": "00:12:15,872",
    "end": "00:12:16,912",
    "start_sec": 735.872,
    "end_sec": 736.912,
    "zh": "活尸密度低",
    "vi": "Mật độ xác sống thấp."
  },
  {
    "idx": 549,
    "start": "00:12:16,912",
    "end": "00:12:17,812",
    "start_sec": 736.912,
    "end_sec": 737.812,
    "zh": "最重要的是",
    "vi": "Quan trọng nhất là."
  },
  {
    "idx": 550,
    "start": "00:12:17,812",
    "end": "00:12:19,892",
    "start_sec": 737.812,
    "end_sec": 739.892,
    "zh": "有大量的金属原材料",
    "vi": "Có nguồn nguyên liệu kim loại dồi dào."
  },
  {
    "idx": 551,
    "start": "00:12:19,892",
    "end": "00:12:21,912",
    "start_sec": 739.892,
    "end_sec": 741.912,
    "zh": "对你的能力用处很大",
    "vi": "Rất có ích cho năng lực của bạn."
  },
  {
    "idx": 552,
    "start": "00:12:21,912",
    "end": "00:12:23,212",
    "start_sec": 741.912,
    "end_sec": 743.212,

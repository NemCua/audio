    "end": "06:58:39,371",
    "start_sec": 25118.191,
    "end_sec": 25119.371,
    "zh": "前二十的御鬼者",
    "vi": "Trong số hai mươi Ngự Quỷ Giả hàng đầu"
  },
  {

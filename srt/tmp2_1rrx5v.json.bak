    "end": "06:58:42,151",
    "start_sec": 25120.951,
    "end_sec": 25122.151,
    "zh": "冷前铁了橙子弹",
    "vi": "Lãnh Tuyền vỗ vai Cam Tử"
  },
  {
    "idx": 14996,
    "start": "06:58:42,151",
    "end": "06:58:43,031",
    "start_sec": 25122.151,
    "end_sec": 25123.031,
    "zh": "随后",
    "vi": "Sau đó"
  },
  {
    "idx": 14997,
    "start": "06:58:43,031",
    "end": "06:58:44,711",
    "start_sec": 25123.031,
    "end_sec": 25124.711,
    "zh": "走到靠外的一座桌子",
    "vi": "Đi đến một chiếc bàn ở phía ngoài"
  },
  {
    "idx": 14998,
    "start": "06:58:44,711",
    "end": "06:58:46,931",
    "start_sec": 25124.711,
    "end_sec": 25126.931,
    "zh": "看来这些林玉的部下",
    "vi": "Xem ra những thuộc hạ này của Lâm Ngọc"

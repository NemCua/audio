    "end": "05:12:36,512",
    "start_sec": 18755.872,
    "end_sec": 18756.512,
    "zh": "但是",
    "vi": "Nhưng mà."
  },
  {
    "idx": 11209,
    "start": "05:12:36,512",
    "end": "05:12:38,412",
    "start_sec": 18756.512,
    "end_sec": 18758.412,
    "zh": "诚哥凭什么帮我们呢",
    "vi": "Tại sao anh Thành phải giúp chúng ta chứ."
  },
  {
    "idx": 11210,

    "start_sec": 18751.712,
    "end_sec": 18753.052,
    "zh": "只能打砸狗活着",
    "vi": "Chỉ có thể làm chân sai vặt để sống."
  },
  {
    "idx": 11206,
    "start": "05:12:33,052",
    "end": "05:12:34,312",
    "start_sec": 18753.052,
    "end_sec": 18754.312,
    "zh": "诚哥那么厉害",
    "vi": "Anh Thành lợi hại như vậy."
  },
  {
    "idx": 11207,
    "start": "05:12:34,312",
    "end": "05:12:35,872",
    "start_sec": 18754.312,
    "end_sec": 18755.872,
    "zh": "应该可以帮帮我们一家的吧",
    "vi": "Chắc là có thể giúp đỡ gia đình chúng ta."
  },
  {
    "idx": 11208,

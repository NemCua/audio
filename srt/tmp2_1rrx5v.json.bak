    "start": "05:01:07,360",
    "end": "05:01:08,500",
    "start_sec": 18067.36,
    "end_sec": 18068.5,
    "zh": "你什么意思",
    "vi": "Ý cậu là sao."
  },
  {
    "idx": 10792,
    "start": "05:01:08,500",
    "end": "05:01:10,140",
    "start_sec": 18068.5,
    "end_sec": 18070.14,
    "zh": "那屋里有条黑狗",
    "vi": "Trong phòng đó có một con chó đen"
  },
  {
    "idx": 10793,
    "start": "05:01:10,140",
    "end": "05:01:12,260",
    "start_sec": 18070.14,
    "end_sec": 18072.26,
    "zh": "没有和026过多解释",
    "vi": "Không giải thích nhiều với 026"
  },
  {
    "idx": 10794,
    "start": "05:01:12,260",
    "end": "05:01:13,980",
    "start_sec": 18072.26,
    "end_sec": 18073.98,
    "zh": "两人来到三楼船长室",
    "vi": "Hai người đi tới phòng thuyền trưởng ở tầng ba"
  },
  {
    "idx": 10795,
    "start": "05:01:13,980",
    "end": "05:01:15,100",
    "start_sec": 18073.98,
    "end_sec": 18075.1,
    "zh": "和上次一样",
    "vi": "Giống như lần trước"
  },
  {
    "idx": 10796,
    "start": "05:01:15,100",
    "end": "05:01:16,540",
    "start_sec": 18075.1,
    "end_sec": 18076.54,
    "zh": "程子提带着023",
    "vi": "Trình Tử Đề dẫn theo 023"
  },
  {
    "idx": 10797,
    "start": "05:01:16,540",
    "end": "05:01:18,160",
    "start_sec": 18076.54,
    "end_sec": 18078.16,
    "zh": "悄无声息的进入古镜",
    "vi": "Lặng lẽ tiến vào bên trong chiếc gương cổ"
  },
  {
    "idx": 10798,
    "start": "05:01:18,160",
    "end": "05:01:19,460",
    "start_sec": 18078.16,
    "end_sec": 18079.46,
    "zh": "来到那片湖河去",
    "vi": "Đi tới khu vực hồ nước đó"
  },
  {
    "idx": 10799,
    "start": "05:01:19,460",
    "end": "05:01:20,640",
    "start_sec": 18079.46,
    "end_sec": 18080.64,
    "zh": "真是无趣",
    "vi": "Thật là vô vị"
  },
  {
    "idx": 10800,
    "start": "05:01:20,640",
    "end": "05:01:22,860",
    "start_sec": 18080.64,
    "end_sec": 18082.86,
    "zh": "妇葬鬼一脸疲惫的看着周扬",
    "vi": "Phụ Táng Quỷ vẻ mặt mệt mỏi nhìn Chu Dương"
  },
  {
    "idx": 10801,
    "start": "05:01:22,860",
    "end": "05:01:23,960",
    "start_sec": 18082.86,
    "end_sec": 18083.96,
    "zh": "你不说小子",
    "vi": "Không ngờ đấy nhóc"
  },
  {
    "idx": 10802,
    "start": "05:01:23,960",
    "end": "05:01:26,280",
    "start_sec": 18083.96,
    "end_sec": 18086.28,
    "zh": "竟然超空一脸去对付那只衰鬼",
    "vi": "Lại dám phân thân đi đối phó con quỷ xui xẻo đó"
  },
  {
    "idx": 10803,
    "start": "05:01:26,280",
    "end": "05:01:27,140",
    "start_sec": 18086.28,
    "end_sec": 18087.14,
    "zh": "你真的好吗",
    "vi": "Ngươi thật sự ổn chứ"
  },
  {
    "idx": 10804,
    "start": "05:01:27,140",
    "end": "05:01:28,920",
    "start_sec": 18087.14,
    "end_sec": 18088.92,
    "zh": "成大事者不拘小节",
    "vi": "Người làm việc lớn không câu nệ tiểu tiết"
  },
  {
    "idx": 10805,
    "start": "05:01:28,920",
    "end": "05:01:31,540",
    "start_sec": 18088.92,
    "end_sec": 18091.54,
    "zh": "这船上就023和026两个御鬼者",
    "vi": "Trên thuyền này chỉ có hai Ngự Quỷ Giả là 023 và 026"
  },
  {
    "idx": 10806,
    "start": "05:01:31,540",
    "end": "05:01:33,080",
    "start_sec": 18091.54,
    "end_sec": 18093.08,
    "zh": "先让026的水鬼复苏",
    "vi": "Trước tiên cứ để Thủy Quỷ của 026 hồi sinh"
  },
  {
    "idx": 10807,
    "start": "05:01:33,080",
    "end": "05:01:35,580",
    "start_sec": 18093.08,
    "end_sec": 18095.58,
    "zh": "023肯定会想尽一切办法控制水鬼",
    "vi": "023 chắc chắn sẽ nghĩ đủ mọi cách để khống chế Thủy Quỷ"

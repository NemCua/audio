    "idx": 536,
    "start": "00:12:02,832",
    "end": "00:12:03,292",
    "start_sec": 722.832,
    "end_sec": 723.292,
    "zh": "糟",
    "vi": "Hỏng bét."
  },
  {
    "idx": 537,
    "start": "00:12:03,292",
    "end": "00:12:04,012",
    "start_sec": 723.292,
    "end_sec": 724.012,
    "zh": "我没再看",
    "vi": "Tôi không nhìn thêm nữa."
  },
  {

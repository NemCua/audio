    "start": "05:00:57,080",
    "end": "05:00:57,820",
    "start_sec": 18057.08,
    "end_sec": 18057.82,
    "zh": "趁现在",
    "vi": "Nhân lúc này"
  },
  {
    "idx": 10785,
    "start": "05:00:57,820",
    "end": "05:00:59,020",
    "start_sec": 18057.82,
    "end_sec": 18059.02,
    "zh": "我们去拿下他",
    "vi": "Chúng ta đi bắt hắn"
  },
  {
    "idx": 10786,
    "start": "05:00:59,020",
    "end": "05:01:01,760",
    "start_sec": 18059.02,
    "end_sec": 18061.76,
    "zh": "对了",
    "vi": "Đúng rồi"
  },
  {
    "idx": 10787,
    "start": "05:01:01,760",
    "end": "05:01:02,300",
    "start_sec": 18061.76,
    "end_sec": 18062.3,
    "zh": "026",
    "vi": "026"
  },
  {
    "idx": 10788,
    "start": "05:01:02,300",
    "end": "05:01:03,720",
    "start_sec": 18062.3,
    "end_sec": 18063.72,
    "zh": "如果你恢复好了的话",
    "vi": "Nếu cậu đã hồi phục xong"
  },
  {
    "idx": 10789,
    "start": "05:01:03,720",
    "end": "05:01:05,480",
    "start_sec": 18063.72,
    "end_sec": 18065.48,
    "zh": "我建议你去023那屋待着",
    "vi": "Tôi khuyên cậu nên sang phòng của 023 ở"
  },
  {
    "idx": 10790,
    "start": "05:01:05,480",
    "end": "05:01:07,360",
    "start_sec": 18065.48,
    "end_sec": 18067.36,
    "zh": "说不定你之后能立下大功",
    "vi": "Biết đâu sau này cậu lại lập được công lớn"
  },
  {

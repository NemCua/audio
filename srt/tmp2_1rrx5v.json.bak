    "vi": "Trời sáng chúng tôi tới nơi."
  },
  {
    "idx": 558,
    "start": "00:12:28,492",
    "end": "00:12:30,312",
    "start_sec": 748.492,
    "end_sec": 750.312,
    "zh": "一座巨大的蓝色铁皮仓库",
    "vi": "Một nhà kho bằng tôn màu xanh khổng lồ."
  },
  {
    "idx": 559,
    "start": "00:12:30,312",
    "end": "00:12:31,752",
    "start_sec": 750.312,
    "end_sec": 751.752,
    "zh": "坐落在荒凉的工业区",
    "vi": "Nằm giữa khu công nghiệp hoang vắng."
  },
  {
    "idx": 560,
    "start": "00:12:31,752",
    "end": "00:12:33,432",
    "start_sec": 751.752,
    "end_sec": 753.432,
    "zh": "周围果然看不到几只活尸",
    "vi": "Quả nhiên xung quanh không thấy mấy con xác sống."
  },
  {
    "idx": 561,
    "start": "00:12:33,432",
    "end": "00:12:35,112",
    "start_sec": 753.432,
    "end_sec": 755.112,
    "zh": "仓库大门被铁链锁着",
    "vi": "Cửa kho bị khóa bằng dây xích."
  },
  {
    "idx": 562,
    "start": "00:12:35,112",
    "end": "00:12:36,472",
    "start_sec": 755.112,
    "end_sec": 756.472,
    "zh": "我直接用钢筋夹上",
    "vi": "Tôi dùng thanh thép kẹp nó ra."
  },
  {
    "idx": 563,
    "start": "00:12:36,472",
    "end": "00:12:37,412",
    "start_sec": 756.472,
    "end_sec": 757.412,
    "zh": "否则扣下锤",
    "vi": "Nếu không thì tôi sẽ đập nó."
  },
  {
    "idx": 564,
    "start": "00:12:37,412",
    "end": "00:12:38,272",
    "start_sec": 757.412,
    "end_sec": 758.272,
    "zh": "急事发开",
    "vi": "Cần gấp thì mở ra."
  },
  {
    "idx": 565,
    "start": "00:12:38,272",
    "end": "00:12:40,072",
    "start_sec": 758.272,
    "end_sec": 760.072,
    "zh": "仓库里全是金属材料",
    "vi": "Bên trong kho toàn vật liệu kim loại."
  },
  {
    "idx": 566,
    "start": "00:12:40,072",
    "end": "00:12:41,052",
    "start_sec": 760.072,
    "end_sec": 761.052,
    "zh": "零件和工具",
    "vi": "Phụ tùng và công cụ."
  },
  {
    "idx": 567,
    "start": "00:12:41,052",
    "end": "00:12:42,072",
    "start_sec": 761.052,
    "end_sec": 762.072,

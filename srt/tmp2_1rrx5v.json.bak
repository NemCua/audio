    "end": "05:00:50,500",
    "start_sec": 18049.76,
    "end_sec": 18050.5,
    "zh": "成此提",
    "vi": "Trình Tử Đề"
  },
  {
    "idx": 10780,
    "start": "05:00:50,500",
    "end": "05:00:51,180",
    "start_sec": 18050.5,
    "end_sec": 18051.18,
    "zh": "我们走",
    "vi": "Chúng ta đi thôi"
  },
  {
    "idx": 10781,
    "start": "05:00:51,180",
    "end": "05:00:53,260",
    "start_sec": 18051.18,
    "end_sec": 18053.26,
    "zh": "就算周扬驾驭双轨翼",
    "vi": "Cho dù Chu Dương có điều khiển song quỷ"
  },
  {
    "idx": 10782,

    "start_sec": 18096.78,
    "end_sec": 18097.8,
    "zh": "我们坐收余力",
    "vi": "Chúng ta sẽ ngư ông đắc lợi"
  },
  {
    "idx": 10810,
    "start": "05:01:37,800",
    "end": "05:01:39,600",
    "start_sec": 18097.8,
    "end_sec": 18099.6,
    "zh": "接着我就可以尝试驾驭四只鬼",
    "vi": "Tiếp đó ta có thể thử ngự trị bốn con quỷ"
  },

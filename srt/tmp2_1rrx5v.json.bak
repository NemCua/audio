    "vi": "Cô ấy bám chặt lấy tôi."
  },
  {
    "idx": 545,
    "start": "00:12:12,912",
    "end": "00:12:13,612",
    "start_sec": 732.912,
    "end_sec": 733.612,
    "zh": "去哪儿",
    "vi": "Đi đâu vậy."
  },
  {
    "idx": 546,
    "start": "00:12:13,612",

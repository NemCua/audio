    "start": "08:02:09,840",
    "end": "08:02:11,440",
    "start_sec": 28929.84,
    "end_sec": 28931.44,
    "zh": "请大家做好防护",
    "vi": "Xin mọi người hãy thực hiện tốt các biện pháp phòng hộ."
  },
  {
    "idx": 16878,
    "start": "08:02:11,440",
    "end": "08:02:11,900",
    "start_sec": 28931.44,
    "end_sec": 28931.9,
    "zh": "切记",
    "vi": "Hãy nhớ kỹ."
  },
  {
    "idx": 16879,
    "start": "08:02:11,900",
    "end": "08:02:12,800",
    "start_sec": 28931.9,
    "end_sec": 28932.8,
    "zh": "不要出门",
    "vi": "Không được ra ngoài."
  },
  {
    "idx": 16880,
    "start": "08:02:12,800",
    "end": "08:02:13,720",
    "start_sec": 28932.8,
    "end_sec": 28933.72,
    "zh": "不要出门",
    "vi": "Không được ra ngoài."
  },
  {
    "idx": 16881,
    "start": "08:02:13,720",
    "end": "08:02:14,900",
    "start_sec": 28933.72,
    "end_sec": 28934.9,
    "zh": "特殊时期",
    "vi": "Trong thời kỳ đặc biệt này."
  },
  {
    "idx": 16882,
    "start": "08:02:14,900",
    "end": "08:02:15,960",
    "start_sec": 28934.9,
    "end_sec": 28935.96,
    "zh": "特殊时期",
    "vi": "Trong thời kỳ đặc biệt này."
  },
  {
    "idx": 16883,
    "start": "08:02:15,960",
    "end": "08:02:17,740",
    "start_sec": 28935.96,
    "end_sec": 28937.74,
    "zh": "请各位居民在家监赏",
    "vi": "Xin các cư dân hãy ở yên trong nhà."
  },
  {
    "idx": 16884,
    "start": "08:02:17,740",
    "end": "08:02:18,980",
    "start_sec": 28937.74,
    "end_sec": 28938.98,
    "zh": "务必不要外出",
    "vi": "Tuyệt đối không được đi ra ngoài."
  },
  {
    "idx": 16885,
    "start": "08:02:18,980",
    "end": "08:02:20,840",
    "start_sec": 28938.98,
    "end_sec": 28940.84,
    "zh": "请务必不要外出",
    "vi": "Xin tuyệt đối không được đi ra ngoài."
  },
  {
    "idx": 16886,
    "start": "08:02:20,840",
    "end": "08:02:22,960",
    "start_sec": 28940.84,
    "end_sec": 28942.96,
    "zh": "头好疼",
    "vi": "Đầu đau quá."
  },
  {
    "idx": 16887,
    "start": "08:02:22,960",
    "end": "08:02:25,160",
    "start_sec": 28942.96,
    "end_sec": 28945.16,
    "zh": "我怎么睡在地上了",
    "vi": "Sao tôi lại nằm ngủ trên sàn thế này."
  },
  {
    "idx": 16888,
    "start": "08:02:25,240",
    "end": "08:02:33,440",
    "start_sec": 28945.24,
    "end_sec": 28953.44,
    "zh": "这么大雾",
    "vi": "Sương mù dày đặc thế này."
  },
  {
    "idx": 16889,
    "start": "08:02:33,440",
    "end": "08:02:35,240",
    "start_sec": 28953.44,
    "end_sec": 28955.24,
    "zh": "谁敢出门啊",
    "vi": "Ai mà dám ra ngoài chứ."
  },
  {
    "idx": 16890,
    "start": "08:02:35,240",
    "end": "08:02:35,480",
    "start_sec": 28955.24,
    "end_sec": 28955.48,
    "zh": "哎",
    "vi": "Ôi."
  },
  {
    "idx": 16891,
    "start": "08:02:35,480",
    "end": "08:02:37,540",
    "start_sec": 28955.48,
    "end_sec": 28957.54,
    "zh": "也不知道要居家隔离多久",
    "vi": "Cũng không biết phải cách ly tại nhà bao lâu nữa."
  },
  {
    "idx": 16892,
    "start": "08:02:37,540",
    "end": "08:02:38,820",
    "start_sec": 28957.54,
    "end_sec": 28958.82,
    "zh": "食物还够不够",
    "vi": "Thức ăn có còn đủ không đây."
  },
  {
    "idx": 16893,
    "start": "08:02:38,820",
    "end": "08:02:42,200",
    "start_sec": 28958.82,
    "end_sec": 28962.2,
    "zh": "小墨鸡",
    "vi": "Tiểu Mặc Kê."
  },
  {
    "idx": 16894,
    "start": "08:02:42,200",
    "end": "08:02:43,380",
    "start_sec": 28962.2,
    "end_sec": 28963.38,
    "zh": "饿了是不是",
    "vi": "Đói bụng rồi đúng không."
  },
  {
    "idx": 16895,
    "start": "08:02:43,380",
    "end": "08:02:46,120",
    "start_sec": 28963.38,
    "end_sec": 28966.12,
    "zh": "我带你吃东西去",
    "vi": "Tôi dẫn bạn đi ăn đồ ăn nhé."
  },
  {
    "idx": 16896,
    "start": "08:02:46,120",
    "end": "08:02:49,640",
    "start_sec": 28966.12,
    "end_sec": 28969.64,
    "zh": "还好冰箱里的食物还挺多的",
    "vi": "May mà thức ăn trong tủ lạnh vẫn còn khá nhiều."
  },
  {
    "idx": 16897,
    "start": "08:02:49,640",
    "end": "08:02:50,660",
    "start_sec": 28969.64,
    "end_sec": 28970.66,
    "zh": "喂",
    "vi": "Alo."
  },
  {
    "idx": 16898,
    "start": "08:02:50,660",
    "end": "08:02:51,960",
    "start_sec": 28970.66,
    "end_sec": 28971.96,
    "zh": "你怎么样了",
    "vi": "Bạn thế nào rồi."
  },
  {
    "idx": 16899,
    "start": "08:02:51,960",
    "end": "08:02:52,1000",
    "start_sec": 28971.96,
    "end_sec": 28973.0,
    "zh": "我操",
    "vi": "Trời đất ơi."
  },
  {
    "idx": 16900,
    "start": "08:02:52,1000",
    "end": "08:02:54,220",
    "start_sec": 28973.0,
    "end_sec": 28974.22,
    "zh": "这是什么鬼啊",
    "vi": "这是什么鬼啊"
  },
  {
    "idx": 16901,
    "start": "08:02:54,220",
    "end": "08:02:55,880",
    "start_sec": 28974.22,
    "end_sec": 28975.88,
    "zh": "我自己给自己发信息了",
    "vi": "Tự tôi gửi tin nhắn cho chính mình sao."
  },
  {
    "idx": 16902,
    "start": "08:02:55,880",
    "end": "08:02:57,000",
    "start_sec": 28975.88,
    "end_sec": 28977.0,
    "zh": "我号背到了吗",
    "vi": "Có phải tài khoản của tôi bị hack rồi không."
  },
  {
    "idx": 16903,
    "start": "08:02:57,000",
    "end": "08:02:58,420",
    "start_sec": 28977.0,
    "end_sec": 28978.42,
    "zh": "快回信息啊",
    "vi": "Mau trả lời tin nhắn đi chứ."
  },
  {
    "idx": 16904,
    "start": "08:02:58,420",
    "end": "08:03:00,180",
    "start_sec": 28978.42,
    "end_sec": 28980.18,
    "zh": "你到底有没有事啊",
    "vi": "Rốt cuộc bạn có sao không thế."
  },
  {
    "idx": 16905,
    "start": "08:03:00,180",
    "end": "08:03:00,480",
    "start_sec": 28980.18,
    "end_sec": 28980.48,
    "zh": "你",
    "vi": "Bạn."
  },
  {
    "idx": 16906,
    "start": "08:03:00,480",
    "end": "08:03:01,280",
    "start_sec": 28980.48,
    "end_sec": 28981.28,
    "zh": "你是谁",
    "vi": "Bạn là ai."
  },
  {
    "idx": 16907,
    "start": "08:03:01,280",
    "end": "08:03:02,380",
    "start_sec": 28981.28,
    "end_sec": 28982.38,
    "zh": "我是谁",
    "vi": "Tôi là ai á."
  },
  {
    "idx": 16908,
    "start": "08:03:02,380",
    "end": "08:03:03,940",
    "start_sec": 28982.38,
    "end_sec": 28983.94,
    "zh": "我是你啊",
    "vi": "Tôi chính là bạn đây."
  },
  {
    "idx": 16909,
    "start": "08:03:03,940",
    "end": "08:03:04,880",
    "start_sec": 28983.94,
    "end_sec": 28984.88,
    "zh": "小墨迹你忘了",
    "vi": "Tiểu Mặc Kê mà bạn cũng quên rồi sao."
  },
  {
    "idx": 16910,
    "start": "08:03:04,880",
    "end": "08:03:05,860",
    "start_sec": 28984.88,
    "end_sec": 28985.86,
    "zh": "我你也能忘",
    "vi": "Đến tôi mà bạn cũng quên được à."
  },
  {
    "idx": 16911,
    "start": "08:03:05,860",
    "end": "08:03:06,780",
    "start_sec": 28985.86,
    "end_sec": 28986.78,
    "zh": "你呀",
    "vi": "Bạn đó."
  },
  {
    "idx": 16912,
    "start": "08:03:06,780",
    "end": "08:03:08,860",
    "start_sec": 28986.78,
    "end_sec": 28988.86,
    "zh": "是不是驾驭了老年痴呆鬼一啊",
    "vi": "Có phải bạn bị con quỷ lú lẫn khống chế rồi không."
  },
  {
    "idx": 16913,
    "start": "08:03:08,860",
    "end": "08:03:10,040",
    "start_sec": 28988.86,
    "end_sec": 28990.04,
    "zh": "你才老年痴呆",
    "vi": "Bạn mới bị lú lẫn thì có."
  },
  {
    "idx": 16914,
    "start": "08:03:10,040",
    "end": "08:03:11,660",
    "start_sec": 28990.04,
    "end_sec": 28991.66,
    "zh": "你是新型诈骗犯吧",
    "vi": "Bạn là kẻ lừa đảo công nghệ mới đúng không."
  },
  {
    "idx": 16915,
    "start": "08:03:11,660",
    "end": "08:03:12,760",
    "start_sec": 28991.66,
    "end_sec": 28992.76,
    "zh": "你傻了",
    "vi": "Bạn ngốc à."
  },
  {
    "idx": 16916,
    "start": "08:03:12,760",
    "end": "08:03:14,040",
    "start_sec": 28992.76,
    "end_sec": 28994.04,
    "zh": "我们一直可以联系的",
    "vi": "Chúng ta luôn có thể liên lạc với nhau mà."
  },
  {
    "idx": 16917,
    "start": "08:03:14,040",
    "end": "08:03:16,380",
    "start_sec": 28994.04,
    "end_sec": 28996.38,
    "zh": "我是一个月前的你啊",
    "vi": "Tôi là bạn của một tháng trước đây."
  },
  {
    "idx": 16918,
    "start": "08:03:16,380",
    "end": "08:03:17,880",
    "start_sec": 28996.38,
    "end_sec": 28997.88,
    "zh": "现在是鬼一降临第二天",
    "vi": "Bây giờ là ngày thứ hai sau khi quỷ dị giáng lâm."
  },
  {
    "idx": 16919,
    "start": "08:03:17,880",
    "end": "08:03:19,000",
    "start_sec": 28997.88,
    "end_sec": 28999.0,
    "zh": "我躲在家里",
    "vi": "Tôi đang trốn ở trong nhà."
  },
  {
    "idx": 16920,
    "start": "08:03:19,000",
    "end": "08:03:21,540",
    "start_sec": 28999.0,
    "end_sec": 29001.54,
    "zh": "明天尝试带着小墨迹出门",
    "vi": "Ngày mai tôi sẽ thử dẫn Tiểu Mặc Kê ra ngoài."
  },
  {
    "idx": 16921,
    "start": "08:03:21,540",
    "end": "08:03:23,000",
    "start_sec": 29001.54,
    "end_sec": 29003.0,
    "zh": "神他妈鬼一降临",
    "vi": "Quỷ dị giáng lâm cái quái gì chứ."
  },
  {
    "idx": 16922,
    "start": "08:03:23,000",
    "end": "08:03:24,480",
    "start_sec": 29003.0,
    "end_sec": 29004.48,
    "zh": "小说看多了吧你",
    "vi": "Bạn đọc nhiều tiểu thuyết quá rồi đấy."
  },
  {
    "idx": 16923,
    "start": "08:03:24,480",
    "end": "08:03:25,300",
    "start_sec": 29004.48,
    "end_sec": 29005.3,
    "zh": "喂",
    "vi": "Alo."
  },
  {
    "idx": 16924,
    "start": "08:03:25,300",
    "end": "08:03:26,140",
    "start_sec": 29005.3,
    "end_sec": 29006.14,
    "zh": "你和我说",
    "vi": "Bạn nghe tôi nói này."
  },
  {
    "idx": 16925,
    "start": "08:03:26,140",
    "end": "08:03:27,840",
    "start_sec": 29006.14,
    "end_sec": 29007.84,
    "zh": "你正处于一个七层空间",
    "vi": "Bạn đang ở trong một không gian bảy tầng."
  },
  {
    "idx": 16926,
    "start": "08:03:27,840",
    "end": "08:03:29,420",
    "start_sec": 29007.84,
    "end_sec": 29009.42,
    "zh": "你会不断失去记忆",
    "vi": "Bạn sẽ liên tục bị mất ký ức."
  },
  {
    "idx": 16927,
    "start": "08:03:29,420",
    "end": "08:03:32,180",
    "start_sec": 29009.42,
    "end_sec": 29012.18,
    "zh": "你现在是不是连我们可以相互联系都忘了",
    "vi": "Có phải bây giờ bạn đã quên mất việc chúng ta có thể liên lạc với nhau rồi không."
  },
  {
    "idx": 16928,
    "start": "08:03:32,180",
    "end": "08:03:33,520",
    "start_sec": 29012.18,
    "end_sec": 29013.52,
    "zh": "什么七层空间",
    "vi": "Không gian bảy tầng gì chứ."
  },
  {
    "idx": 16929,
    "start": "08:03:33,520",
    "end": "08:03:34,660",
    "start_sec": 29013.52,
    "end_sec": 29014.66,
    "zh": "你的意思是说",
    "vi": "Ý của bạn là."
  },
  {
    "idx": 16930,
    "start": "08:03:34,660",
    "end": "08:03:35,940",
    "start_sec": 29014.66,
    "end_sec": 29015.94,
    "zh": "我忘了我自己是谁",
    "vi": "Tôi đã quên mất mình là ai."
  },
  {
    "idx": 16931,
    "start": "08:03:35,940",
    "end": "08:03:37,680",
    "start_sec": 29015.94,
    "end_sec": 29017.68,
    "zh": "我的这个世界是假的",
    "vi": "Và thế giới này của tôi là giả sao."
  },
  {
    "idx": 16932,
    "start": "08:03:37,680",
    "end": "08:03:38,380",
    "start_sec": 29017.68,
    "end_sec": 29018.38,
    "zh": "对",
    "vi": "Đúng vậy."
  },
  {
    "idx": 16933,
    "start": "08:03:38,380",
    "end": "08:03:39,760",
    "start_sec": 29018.38,
    "end_sec": 29019.76,
    "zh": "你现在很危险",
    "vi": "Hiện tại bạn đang rất nguy hiểm."
  },
  {
    "idx": 16934,
    "start": "08:03:39,760",
    "end": "08:03:40,680",
    "start_sec": 29019.76,
    "end_sec": 29020.68,
    "zh": "你信我",
    "vi": "Hãy tin tôi đi."
  },
  {
    "idx": 16935,
    "start": "08:03:40,680",
    "end": "08:03:41,700",
    "start_sec": 29020.68,
    "end_sec": 29021.7,
    "zh": "你这样一直下去",
    "vi": "Nếu bạn cứ tiếp tục như thế này."
  },
  {
    "idx": 16936,
    "start": "08:03:41,700",
    "end": "08:03:43,800",
    "start_sec": 29021.7,
    "end_sec": 29023.8,
    "zh": "会沉沦在虚假世界里的",
    "vi": "Bạn sẽ bị chìm đắm trong thế giới giả tạo đó."
  },
  {
    "idx": 16937,
    "start": "08:03:43,800",
    "end": "08:03:45,120",
    "start_sec": 29023.8,
    "end_sec": 29025.12,
    "zh": "沉沦啥",
    "vi": "Chìm đắm cái gì chứ."
  },
  {
    "idx": 16938,
    "start": "08:03:45,120",
    "end": "08:03:46,840",
    "start_sec": 29025.12,
    "end_sec": 29026.84,
    "zh": "天天宅家有什么不好",
    "vi": "Suốt ngày ở nhà thì có gì không tốt chứ."
  },
  {
    "idx": 16939,
    "start": "08:03:46,840",
    "end": "08:03:49,000",
    "start_sec": 29026.84,
    "end_sec": 29029.0,
    "zh": "无聊的骗子",
    "vi": "Kẻ lừa đảo vô vị."
  },
  {
    "idx": 16940,
    "start": "08:03:53,000",
    "end": "08:03:54,120",
    "start_sec": 29033.0,
    "end_sec": 29034.12,
    "zh": "谁啊",
    "vi": "Ai thế."
  },
  {
    "idx": 16941,
    "start": "08:03:54,120",
    "end": "08:03:54,480",
    "start_sec": 29034.12,
    "end_sec": 29034.48,
    "zh": "哦",
    "vi": "Ồ."
  },
  {
    "idx": 16942,
    "start": "08:03:54,480",
    "end": "08:03:56,500",
    "start_sec": 29034.48,
    "end_sec": 29036.5,
    "zh": "我是这片社区的防护人员",
    "vi": "Tôi là nhân viên bảo vệ của khu dân cư này."
  },
  {
    "idx": 16943,
    "start": "08:03:56,500",
    "end": "08:03:57,540",
    "start_sec": 29036.5,
    "end_sec": 29037.54,
    "zh": "我来确认一下",
    "vi": "Tôi đến để xác nhận một chút."
  },
  {
    "idx": 16944,
    "start": "08:03:57,540",
    "end": "08:03:59,000",
    "start_sec": 29037.54,
    "end_sec": 29039.0,
    "zh": "你最近没有出门吧",
    "vi": "Gần đây bạn không ra ngoài chứ."
  },
  {
    "idx": 16945,
    "start": "08:03:59,000",
    "end": "08:03:59,840",
    "start_sec": 29039.0,
    "end_sec": 29039.84,
    "zh": "没有啊",
    "vi": "Không có."
  },
  {
    "idx": 16946,
    "start": "08:03:59,840",
    "end": "08:04:00,460",
    "start_sec": 29039.84,
    "end_sec": 29040.46,
    "zh": "那就好",
    "vi": "Vậy thì tốt rồi."
  },
  {
    "idx": 16947,
    "start": "08:04:00,460",
    "end": "08:04:01,680",
    "start_sec": 29040.46,
    "end_sec": 29041.68,
    "zh": "我告诉你啊",
    "vi": "Tôi nói cho bạn biết nhé."
  },
  {
    "idx": 16948,
    "start": "08:04:01,680",
    "end": "08:04:02,660",
    "start_sec": 29041.68,
    "end_sec": 29042.66,
    "zh": "千万不要出门",
    "vi": "Tuyệt đối đừng ra ngoài."
  },
  {
    "idx": 16949,
    "start": "08:04:02,660",
    "end": "08:04:04,300",
    "start_sec": 29042.66,
    "end_sec": 29044.3,
    "zh": "听说一旦感染病毒",
    "vi": "Nghe nói một khi bị nhiễm virus."
  },
  {
    "idx": 16950,
    "start": "08:04:04,300",
    "end": "08:04:06,300",
    "start_sec": 29044.3,
    "end_sec": 29046.3,
    "zh": "就会成为咬人失去理智",
    "vi": "Sẽ cắn người và mất đi lý trí."
  },
  {
    "idx": 16951,
    "start": "08:04:06,300",
    "end": "08:04:09,320",
    "start_sec": 29046.3,
    "end_sec": 29049.32,
    "zh": "对血腥味产生浓厚兴趣的怪物",
    "vi": "Quái vật cực kỳ nhạy cảm với mùi máu tươi."
  },
  {
    "idx": 16952,
    "start": "08:04:09,320",
    "end": "08:04:09,760",
    "start_sec": 29049.32,
    "end_sec": 29049.76,
    "zh": "啊",
    "vi": "À."
  },
  {
    "idx": 16953,
    "start": "08:04:09,760",
    "end": "08:04:10,740",
    "start_sec": 29049.76,
    "end_sec": 29050.74,
    "zh": "丧尸吗",
    "vi": "Là xác sống sao."
  },
  {
    "idx": 16954,
    "start": "08:04:10,740",
    "end": "08:04:11,580",
    "start_sec": 29050.74,
    "end_sec": 29051.58,
    "zh": "对对对",
    "vi": "Đúng đúng đúng."
  },
  {
    "idx": 16955,
    "start": "08:04:11,580",
    "end": "08:04:13,660",
    "start_sec": 29051.58,
    "end_sec": 29053.66,
    "zh": "目前不能确定是水域感染",
    "vi": "Hiện tại vẫn chưa xác định được là lây qua nguồn nước."
  },
  {
    "idx": 16956,
    "start": "08:04:13,660",
    "end": "08:04:14,780",
    "start_sec": 29053.66,
    "end_sec": 29054.78,
    "zh": "还是空气感染",
    "vi": "Hay là lây qua không khí."
  },
  {
    "idx": 16957,
    "start": "08:04:14,780",
    "end": "08:04:16,680",
    "start_sec": 29054.78,
    "end_sec": 29056.68,
    "zh": "所以千万别出门啊",
    "vi": "Cho nên bạn tuyệt đối đừng ra ngoài nhé."
  },
  {
    "idx": 16958,
    "start": "08:04:16,680",
    "end": "08:04:18,760",
    "start_sec": 29056.68,
    "end_sec": 29058.76,
    "zh": "至于食物方面不用担心",
    "vi": "Còn về phần thức ăn thì bạn không cần lo lắng."
  },
  {
    "idx": 16959,
    "start": "08:04:18,760",
    "end": "08:04:20,200",
    "start_sec": 29058.76,
    "end_sec": 29060.2,
    "zh": "每家都会分配的",
    "vi": "Mỗi nhà đều sẽ được phân phát."
  },
  {
    "idx": 16960,
    "start": "08:04:20,200",
    "end": "08:04:20,840",
    "start_sec": 29060.2,
    "end_sec": 29060.84,
    "zh": "哦",
    "vi": "Ồ."
  },
  {
    "idx": 16961,
    "start": "08:04:20,840",
    "end": "08:04:22,280",
    "start_sec": 29060.84,
    "end_sec": 29062.28,
    "zh": "真是谢谢你了",
    "vi": "Thật sự cảm ơn bạn nhiều."
  },
  {
    "idx": 16962,
    "start": "08:04:22,280",
    "end": "08:04:30,160",
    "start_sec": 29062.28,
    "end_sec": 29070.16,
    "zh": "打打游戏",
    "vi": "Chơi vài ván game."
  },
  {
    "idx": 16963,
    "start": "08:04:30,160",
    "end": "08:04:30,920",
    "start_sec": 29070.16,
    "end_sec": 29070.92,
    "zh": "追追剧",
    "vi": "Cày vài bộ phim."
  },
  {
    "idx": 16964,
    "start": "08:04:30,920",
    "end": "08:04:32,200",
    "start_sec": 29070.92,
    "end_sec": 29072.2,
    "zh": "不用上班当牛马",
    "vi": "Không phải đi làm như trâu như ngựa."
  },
  {
    "idx": 16965,
    "start": "08:04:32,200",
    "end": "08:04:34,080",
    "start_sec": 29072.2,
    "end_sec": 29074.08,
    "zh": "这一天过得真是舒坦",
    "vi": "Một ngày trôi qua thật là thoải mái."
  },
  {
    "idx": 16966,
    "start": "08:04:34,080",
    "end": "08:04:35,380",
    "start_sec": 29074.08,
    "end_sec": 29075.38,
    "zh": "可是",
    "vi": "Thế nhưng."
  },
  {
    "idx": 16967,
    "start": "08:04:35,380",
    "end": "08:04:36,580",
    "start_sec": 29075.38,
    "end_sec": 29076.58,
    "zh": "我怎么觉得",
    "vi": "Tại sao tôi lại cảm thấy."
  },
  {
    "idx": 16968,
    "start": "08:04:36,580",
    "end": "08:04:38,620",
    "start_sec": 29076.58,
    "end_sec": 29078.62,
    "zh": "我以前过的不是这样的生活呢",
    "vi": "Cuộc sống trước đây của tôi không phải như thế này."
  },
  {
    "idx": 16969,
    "start": "08:04:38,620",
    "end": "08:04:41,460",
    "start_sec": 29078.62,
    "end_sec": 29081.46,
    "zh": "你的记忆被篡改了",
    "vi": "Ký ức của bạn đã bị thay đổi rồi."
  },
  {
    "idx": 16970,
    "start": "08:04:41,460",
    "end": "08:04:43,080",
    "start_sec": 29081.46,
    "end_sec": 29083.08,
    "zh": "你之前先后失去了以前",
    "vi": "Trước đó bạn đã lần lượt đánh mất quá khứ."
  },
  {
    "idx": 16971,
    "start": "08:04:43,080",
    "end": "08:04:44,820",
    "start_sec": 29083.08,
    "end_sec": 29084.82,
    "zh": "现在还有未来的记忆",
    "vi": "Hiện tại và cả ký ức về tương lai."
  },
  {
    "idx": 16972,
    "start": "08:04:44,820",
    "end": "08:04:47,020",
    "start_sec": 29084.82,
    "end_sec": 29087.02,
    "zh": "你估计现在在第四重世界",
    "vi": "Tôi đoán là bạn đang ở trong thế giới thứ tư."
  },
  {
    "idx": 16973,
    "start": "08:04:47,020",
    "end": "08:04:47,680",
    "start_sec": 29087.02,
    "end_sec": 29087.68,
    "zh": "沉沦",
    "vi": "Chìm đắm."
  },
  {
    "idx": 16974,
    "start": "08:04:47,680",
    "end": "08:04:48,680",
    "start_sec": 29087.68,
    "end_sec": 29088.68,
    "zh": "搞什么",
    "vi": "Làm cái gì vậy."
  },
  {
    "idx": 16975,
    "start": "08:04:48,680",
    "end": "08:04:50,500",
    "start_sec": 29088.68,
    "end_sec": 29090.5,
    "zh": "骗子还不死心啊",
    "vi": "Đồ lừa đảo vẫn chưa chịu bỏ cuộc sao."
  },
  {
    "idx": 16976,
    "start": "08:04:50,500",
    "end": "08:04:52,220",
    "start_sec": 29090.5,
    "end_sec": 29092.22,
    "zh": "你先别急着关手机",
    "vi": "Bạn đừng vội tắt điện thoại."
  },
  {
    "idx": 16977,
    "start": "08:04:52,220",
    "end": "08:04:53,920",
    "start_sec": 29092.22,
    "end_sec": 29093.92,
    "zh": "你的记忆被篡改",
    "vi": "Ký ức của bạn đã bị thay đổi."
  },
  {
    "idx": 16978,
    "start": "08:04:53,920",
    "end": "08:04:56,787",
    "start_sec": 29093.92,
    "end_sec": 29096.787,
    "zh": "但一定不会被完全篡改我能证明你的第一次暗恋对象是最时髦的英语老师还有你是孤儿父母出车祸了你上大学时你的室友有一个会打嗨",
    "vi": "Nhưng chắc chắn không thể bị thay đổi hoàn toàn, tôi có thể chứng minh,"
  },
  {
    "idx": 16978,
    "start": "08:04:56,787",
    "end": "08:04:59,654",
    "start_sec": 29096.787,
    "end_sec": 29099.654,
    "zh": "但一定不会被完全篡改我能证明你的第一次暗恋对象是最时髦的英语老师还有你是孤儿父母出车祸了你上大学时你的室友有一个会打嗨",
    "vi": "người bạn thầm thương trộm nhớ đầu tiên là cô giáo tiếng Anh sành điệu,"
  },
  {
    "idx": 16978,
    "start": "08:04:59,654",
    "end": "08:05:02,330",
    "start_sec": 29099.654,
    "end_sec": 29102.33,
    "zh": "但一定不会被完全篡改我能证明你的第一次暗恋对象是最时髦的英语老师还有你是孤儿父母出车祸了你上大学时你的室友有一个会打嗨",
    "vi": "bạn là trẻ mồ côi, bố mẹ bạn mất vì tai nạn xe, khi"
  },
  {
    "idx": 16978,
    "start": "08:05:02,330",
    "end": "08:05:05,006",
    "start_sec": 29102.33,
    "end_sec": 29105.006,
    "zh": "但一定不会被完全篡改我能证明你的第一次暗恋对象是最时髦的英语老师还有你是孤儿父母出车祸了你上大学时你的室友有一个会打嗨",
    "vi": "học đại học bạn cùng phòng của bạn có một người biết chơi game."
  },
  {
    "idx": 16979,
    "start": "08:05:05,006",
    "end": "08:05:07,406",
    "start_sec": 29105.006,
    "end_sec": 29107.406,
    "zh": "你你怎么什么都知道",
    "vi": "Bạn, tại sao bạn lại biết hết mọi thứ."
  },
  {
    "idx": 16980,
    "start": "08:05:07,406",
    "end": "08:05:09,826",
    "start_sec": 29107.406,
    "end_sec": 29109.826,
    "zh": "我说了我是一个月前的你",
    "vi": "Tôi đã nói rồi, tôi chính là bạn của một tháng trước."
  },
  {
    "idx": 16981,
    "start": "08:05:09,826",
    "end": "08:05:12,746",
    "start_sec": 29109.826,
    "end_sec": 29112.746,
    "zh": "你给我说过你现在正处于七层鬼屋",
    "vi": "Bạn đã nói với tôi rằng bạn đang ở trong một ngôi nhà ma bảy tầng"
  },
  {
    "idx": 16982,
    "start": "08:05:12,746",
    "end": "08:05:14,226",
    "start_sec": 29112.746,
    "end_sec": 29114.226,
    "zh": "你要赶紧找到带数字的门",
    "vi": "Bạn phải nhanh chóng tìm cánh cửa có số"
  },
  {
    "idx": 16983,
    "start": "08:05:14,226",
    "end": "08:05:16,426",
    "start_sec": 29114.226,
    "end_sec": 29116.426,
    "zh": "逃离这第四层沉沦世界",
    "vi": "Để thoát khỏi tầng thứ tư của thế giới đọa đày này"
  },
  {
    "idx": 16984,
    "start": "08:05:16,426",
    "end": "08:05:18,786",
    "start_sec": 29116.426,
    "end_sec": 29118.786,
    "zh": "带数字的门",
    "vi": "Cánh cửa có số"
  },
  {
    "idx": 16985,
    "start": "08:05:18,786",
    "end": "08:05:21,566",
    "start_sec": 29118.786,
    "end_sec": 29121.566,
    "zh": "哎我的房门不就带数字吗",
    "vi": "Này, cửa phòng tôi chẳng phải có số sao"
  },
  {
    "idx": 16986,
    "start": "08:05:23,146",
    "end": "08:05:24,866",
    "start_sec": 29123.146,
    "end_sec": 29124.866,
    "zh": "可是防护人员说有丧尸",
    "vi": "Nhưng nhân viên bảo vệ nói có zombie"
  },
  {
    "idx": 16987,
    "start": "08:05:24,866",
    "end": "08:05:27,366",
    "start_sec": 29124.866,
    "end_sec": 29127.366,
    "zh": "我就打开门看一眼",
    "vi": "Tôi mở cửa ra xem một chút thôi"
  },
  {
    "idx": 16988,
    "start": "08:05:27,366",
    "end": "08:05:28,546",
    "start_sec": 29127.366,
    "end_sec": 29128.546,
    "zh": "应该不会有事吧",
    "vi": "Chắc không sao đâu nhỉ"
  },
  {
    "idx": 16989,
    "start": "08:05:28,546",
    "end": "08:05:31,166",
    "start_sec": 29128.546,
    "end_sec": 29131.166,
    "zh": "重大消息",
    "vi": "Tin tức quan trọng"
  },
  {
    "idx": 16990,
    "start": "08:05:31,166",
    "end": "08:05:32,266",
    "start_sec": 29131.166,
    "end_sec": 29132.266,
    "zh": "重大消息",
    "vi": "Tin tức quan trọng"
  },
  {
    "idx": 16991,
    "start": "08:05:32,266",
    "end": "08:05:33,546",
    "start_sec": 29132.266,
    "end_sec": 29133.546,
    "zh": "我是临江小区内",
    "vi": "Tôi đang ở trong khu dân cư Linjiang"
  },
  {
    "idx": 16992,
    "start": "08:05:33,546",
    "end": "08:05:35,706",
    "start_sec": 29133.546,
    "end_sec": 29135.706,
    "zh": "已发现十几例患者感染",
    "vi": "Đã phát hiện hơn chục ca nhiễm bệnh"
  },
  {
    "idx": 16993,
    "start": "08:05:35,706",
    "end": "08:05:36,946",
    "start_sec": 29135.706,
    "end_sec": 29136.946,
    "zh": "因为农牧效应",
    "vi": "Do hiệu ứng nông nghiệp"
  },
  {
    "idx": 16994,
    "start": "08:05:36,946",
    "end": "08:05:38,846",
    "start_sec": 29136.946,
    "end_sec": 29138.846,
    "zh": "无法观测到更多感染者",
    "vi": "Không thể quan sát thêm người nhiễm bệnh"
  },
  {
    "idx": 16995,
    "start": "08:05:38,846",
    "end": "08:05:41,046",
    "start_sec": 29138.846,
    "end_sec": 29141.046,
    "zh": "请各位居民千万不要出门",
    "vi": "Xin tất cả cư dân tuyệt đối không ra ngoài"
  },
  {
    "idx": 16996,
    "start": "08:05:41,046",
    "end": "08:05:42,286",
    "start_sec": 29141.046,
    "end_sec": 29142.286,
    "zh": "千万不要出门",
    "vi": "Tuyệt đối không ra ngoài"
  },
  {
    "idx": 16997,
    "start": "08:05:42,286",
    "end": "08:05:43,046",
    "start_sec": 29142.286,
    "end_sec": 29143.046,
    "zh": "我操",
    "vi": "Đệt"
  },
  {
    "idx": 16998,
    "start": "08:05:43,046",
    "end": "08:05:44,166",
    "start_sec": 29143.046,
    "end_sec": 29144.166,
    "zh": "十几例了",
    "vi": "Hơn chục ca rồi"
  },
  {
    "idx": 16999,
    "start": "08:05:44,166",
    "end": "08:05:45,586",
    "start_sec": 29144.166,
    "end_sec": 29145.586,
    "zh": "这是谁敢出门啊",
    "vi": "Ai dám ra ngoài chứ"
  },
  {
    "idx": 17000,
    "start": "08:05:45,586",
    "end": "08:05:46,986",
    "start_sec": 29145.586,
    "end_sec": 29146.986,
    "zh": "算了算了",
    "vi": "Thôi thôi"
  },
  {
    "idx": 17001,
    "start": "08:05:46,986",
    "end": "08:05:47,546",
    "start_sec": 29146.986,
    "end_sec": 29147.546,
    "zh": "不出去了",
    "vi": "Không ra nữa"
  },
  {
    "idx": 17002,
    "start": "08:05:47,546",
    "end": "08:05:48,426",
    "start_sec": 29147.546,
    "end_sec": 29148.426,
    "zh": "爱谁谁",
    "vi": "Ai mặc kệ ai"
  },
  {
    "idx": 17003,
    "start": "08:05:48,426",
    "end": "08:05:51,286",
    "start_sec": 29148.426,
    "end_sec": 29151.286,
    "zh": "怎么样了",
    "vi": "Thế nào rồi"
  },
  {
    "idx": 17004,
    "start": "08:05:51,286",
    "end": "08:05:52,426",
    "start_sec": 29151.286,
    "end_sec": 29152.426,
    "zh": "你找到线索了吗",
    "vi": "Bạn tìm được manh mối gì chưa"
  },
  {
    "idx": 17005,
    "start": "08:05:52,426",
    "end": "08:05:53,426",
    "start_sec": 29152.426,
    "end_sec": 29153.426,
    "zh": "找个屁",
    "vi": "Tìm cái đéo gì"
  },
  {
    "idx": 17006,
    "start": "08:05:53,426",
    "end": "08:05:54,346",
    "start_sec": 29153.426,
    "end_sec": 29154.346,
    "zh": "你知道吗",
    "vi": "Bạn biết không"
  },
  {
    "idx": 17007,
    "start": "08:05:54,346",
    "end": "08:05:56,506",
    "start_sec": 29154.346,
    "end_sec": 29156.506,
    "zh": "我这有丧尸病毒,我哪敢出门。",
    "vi": "Tôi có virus zombie ở đây, tôi đâu dám ra ngoài."
  },
  {
    "idx": 17008,
    "start": "08:05:57,126",
    "end": "08:05:58,886",
    "start_sec": 29157.126,
    "end_sec": 29158.886,
    "zh": "丧尸?不是诡异吗?",
    "vi": "Zombie? Không phải là kỳ dị sao?"
  },
  {
    "idx": 17009,
    "start": "08:05:59,426",
    "end": "08:06:00,426",
    "start_sec": 29159.426,
    "end_sec": 29160.426,
    "zh": "你不是遇鬼者吗?",
    "vi": "Bạn không phải là người gặp ma sao?"
  },
  {
    "idx": 17010,
    "start": "08:06:00,826",
    "end": "08:06:01,846",
    "start_sec": 29160.826,
    "end_sec": 29161.846,
    "zh": "不会怕这玩意儿的吧?",
    "vi": "Chắc không sợ thứ này chứ?"
  },
  {
    "idx": 17011,
    "start": "08:06:02,226",
    "end": "08:06:04,206",
    "start_sec": 29162.226,
    "end_sec": 29164.206,
    "zh": "你现在肯定连自己的能力都忘了。",
    "vi": "Chắc là bạn đã quên mất năng lực của mình rồi."
  },
  {
    "idx": 17012,
    "start": "08:06:04,606",
    "end": "08:06:07,126",
    "start_sec": 29164.606,
    "end_sec": 29167.126,
    "zh": "你再身上找找,你肯定还带着香炉,",
    "vi": "Bạn tìm trên người mình xem, chắc chắn bạn vẫn còn mang theo lư hương."
  },
  {
    "idx": 17013,
    "start": "08:06:07,526",
    "end": "08:06:09,146",
    "start_sec": 29167.526,
    "end_sec": 29169.146,
    "zh": "有那玩意儿你什么都不用怕。",
    "vi": "Có thứ đó trong tay thì bạn chẳng cần sợ gì cả."
  },
  {
    "idx": 17014,
    "start": "08:06:12,206",
    "end": "08:06:13,666",
    "start_sec": 29172.206,
    "end_sec": 29173.666,
    "zh": "哎,还真有个香炉,",
    "vi": "Ơ, đúng là có một cái lư hương thật."
  },
  {
    "idx": 17015,
    "start": "08:06:13,986",
    "end": "08:06:15,326",
    "start_sec": 29173.986,
    "end_sec": 29175.326,
    "zh": "我怎么随身带了这个玩意儿?",
    "vi": "Sao tôi lại mang theo thứ này bên người nhỉ."
  },
  {
    "idx": 17016,
    "start": "08:06:16,046",
    "end": "08:06:17,646",
    "start_sec": 29176.046,
    "end_sec": 29177.646,
    "zh": "这香炉真有那么神奇,",
    "vi": "Cái lư hương này thực sự thần kỳ đến thế sao."
  },
  {
    "idx": 17017,
    "start": "08:06:18,026",
    "end": "08:06:18,966",
    "start_sec": 29178.026,
    "end_sec": 29178.966,
    "zh": "我开门试试。",
    "vi": "Để tôi mở cửa thử xem."
  },
  {
    "idx": 17018,
    "start": "08:06:24,346",
    "end": "08:06:25,386",
    "start_sec": 29184.346,
    "end_sec": 29185.386,
    "zh": "谁?谁啊?",
    "vi": "Ai đó. Ai vậy."
  },
  {
    "idx": 17019,
    "start": "08:06:29,986",
    "end": "08:06:31,686",
    "start_sec": 29189.986,
    "end_sec": 29191.686,
    "zh": "救命!救命啊!",
    "vi": "Cứu tôi với. Cứu tôi với."
  },
  {
    "idx": 17020,
    "start": "08:06:32,026",
    "end": "08:06:32,586",
    "start_sec": 29192.026,
    "end_sec": 29192.586,
    "zh": "快开门!",
    "vi": "Mở cửa nhanh lên."
  },
  {
    "idx": 17021,
    "start": "08:06:32,906",
    "end": "08:06:33,586",
    "start_sec": 29192.906,
    "end_sec": 29193.586,
    "zh": "开门啊!",
    "vi": "Mở cửa ra."
  },
  {
    "idx": 17022,
    "start": "08:06:34,006",
    "end": "08:06:34,986",
    "start_sec": 29194.006,
    "end_sec": 29194.986,
    "zh": "为你有丧尸!",
    "vi": "Vì bên ngoài có zombie."
  },
  {
    "idx": 17023,
    "start": "08:06:54,346",
    "end": "08:06:57,806",
    "start_sec": 29214.346,
    "end_sec": 29217.806,
    "zh": "开门啊",
    "vi": "Mở cửa ra đi."
  },
  {
    "idx": 17024,
    "start": "08:06:57,806",
    "end": "08:06:59,086",
    "start_sec": 29217.806,
    "end_sec": 29219.086,
    "zh": "外面有丧尸",
    "vi": "Bên ngoài có zombie."
  },
  {
    "idx": 17025,
    "start": "08:06:59,086",
    "end": "08:07:00,226",
    "start_sec": 29219.086,
    "end_sec": 29220.226,
    "zh": "丧尸",
    "vi": "Zombie."
  },
  {
    "idx": 17026,
    "start": "08:07:00,226",
    "end": "08:07:01,526",
    "start_sec": 29220.226,
    "end_sec": 29221.526,
    "zh": "真的有丧尸",
    "vi": "Thật sự có zombie."
  },
  {
    "idx": 17027,
    "start": "08:07:01,526",
    "end": "08:07:03,146",
    "start_sec": 29221.526,
    "end_sec": 29223.146,
    "zh": "你身上这么多血",
    "vi": "Trên người bạn đầy máu kìa."
  },
  {
    "idx": 17028,
    "start": "08:07:03,146",
    "end": "08:07:04,306",
    "start_sec": 29223.146,
    "end_sec": 29224.306,
    "zh": "有伤吗",
    "vi": "Bạn có bị thương không."
  },
  {
    "idx": 17029,
    "start": "08:07:04,306",
    "end": "08:07:04,946",
    "start_sec": 29224.306,
    "end_sec": 29224.946,
    "zh": "没有",
    "vi": "Không có."
  },
  {
    "idx": 17030,
    "start": "08:07:04,946",
    "end": "08:07:06,446",
    "start_sec": 29224.946,
    "end_sec": 29226.446,
    "zh": "你先开门",
    "vi": "Bạn mở cửa trước đi."
  },
  {
    "idx": 17031,
    "start": "08:07:06,446",
    "end": "08:07:07,406",
    "start_sec": 29226.446,
    "end_sec": 29227.406,
    "zh": "再不了",
    "vi": "Không kịp nữa rồi."
  },
  {
    "idx": 17032,
    "start": "08:07:07,406",
    "end": "08:07:08,226",
    "start_sec": 29227.406,
    "end_sec": 29228.226,
    "zh": "我进去后",
    "vi": "Sau khi tôi vào trong."
  },
  {
    "idx": 17033,
    "start": "08:07:08,226",
    "end": "08:07:10,186",
    "start_sec": 29228.226,
    "end_sec": 29230.186,
    "zh": "你帮我绑起来就是了",
    "vi": "Bạn cứ trói tôi lại là được."
  },
  {
    "idx": 17034,
    "start": "08:07:10,186",
    "end": "08:07:11,406",
    "start_sec": 29230.186,
    "end_sec": 29231.406,
    "zh": "奇怪",
    "vi": "Lạ thật."
  },
  {
    "idx": 17035,
    "start": "08:07:11,406",
    "end": "08:07:13,626",
    "start_sec": 29231.406,
    "end_sec": 29233.626,
    "zh": "我以前有这么好心吗",
    "vi": "Trước đây tôi có tốt bụng như vậy không nhỉ."
  },
  {
    "idx": 17036,
    "start": "08:07:13,626",
    "end": "08:07:16,846",
    "start_sec": 29233.626,
    "end_sec": 29236.846,
    "zh": "起来",
    "vi": "Đứng dậy đi."
  },
  {
    "idx": 17037,
    "start": "08:07:16,846",
    "end": "08:07:18,166",
    "start_sec": 29236.846,
    "end_sec": 29238.166,
    "zh": "老婆扑托下来",
    "vi": "Cởi đồ ra."
  },
  {
    "idx": 17038,
    "start": "08:07:18,166",
    "end": "08:07:20,026",
    "start_sec": 29238.166,
    "end_sec": 29240.026,
    "zh": "我要检查你有没有被伤伤",
    "vi": "Tôi phải kiểm tra xem bạn có bị thương không."
  },
  {
    "idx": 17039,
    "start": "08:07:20,026",
    "end": "08:07:21,166",
    "start_sec": 29240.026,
    "end_sec": 29241.166,
    "zh": "你",
    "vi": "Bạn."
  },
  {
    "idx": 17040,
    "start": "08:07:21,166",
    "end": "08:07:22,546",
    "start_sec": 29241.166,
    "end_sec": 29242.546,
    "zh": "你去洗一下吧",
    "vi": "Bạn đi rửa sạch đi."
  },
  {
    "idx": 17041,
    "start": "08:07:22,546",
    "end": "08:07:23,746",
    "start_sec": 29242.546,
    "end_sec": 29243.746,
    "zh": "我等你",
    "vi": "Tôi đợi bạn"
  },
  {
    "idx": 17042,
    "start": "08:07:23,746",
    "end": "08:07:29,066",
    "start_sec": 29243.746,
    "end_sec": 29249.066,
    "zh": "还需要检查胸部吗",
    "vi": "Còn cần kiểm tra ngực nữa không"
  },
  {
    "idx": 17043,
    "start": "08:07:29,066",
    "end": "08:07:30,626",
    "start_sec": 29249.066,
    "end_sec": 29250.626,
    "zh": "不用了",
    "vi": "Không cần đâu"
  },
  {
    "idx": 17044,
    "start": "08:07:30,626",
    "end": "08:07:31,946",
    "start_sec": 29250.626,
    "end_sec": 29251.946,
    "zh": "你告诉我",
    "vi": "Bạn nói cho tôi biết đi"
  },
  {
    "idx": 17045,
    "start": "08:07:31,946",
    "end": "08:07:33,746",
    "start_sec": 29251.946,
    "end_sec": 29253.746,
    "zh": "你到底经历了什么",
    "vi": "Rốt cuộc bạn đã trải qua chuyện gì"
  },
  {
    "idx": 17046,
    "start": "08:07:33,746",
    "end": "08:07:35,466",
    "start_sec": 29253.746,
    "end_sec": 29255.466,
    "zh": "我来林平小区找我妈",
    "vi": "Tôi đến khu dân cư Lâm Bình tìm mẹ tôi"
  },
  {
    "idx": 17047,
    "start": "08:07:35,466",
    "end": "08:07:37,666",
    "start_sec": 29255.466,
    "end_sec": 29257.666,
    "zh": "结果我就看见一堆人在相互撕咬",
    "vi": "Kết quả tôi thấy một đám người đang cắn xé lẫn nhau"
  },
  {
    "idx": 17048,
    "start": "08:07:37,666",
    "end": "08:07:39,386",
    "start_sec": 29257.666,
    "end_sec": 29259.386,
    "zh": "我被一个丧尸追击",
    "vi": "Tôi bị một con zombie đuổi theo"
  },
  {
    "idx": 17049,
    "start": "08:07:39,386",
    "end": "08:07:40,366",
    "start_sec": 29259.386,
    "end_sec": 29260.366,
    "zh": "慌乱之下",
    "vi": "Trong lúc hoảng loạn"
  },
  {
    "idx": 17050,
    "start": "08:07:40,366",
    "end": "08:07:42,306",
    "start_sec": 29260.366,
    "end_sec": 29262.306,
    "zh": "穿越血污之后来到你家门口",
    "vi": "Tôi chạy qua vũng máu đến trước cửa nhà bạn"
  },
  {
    "idx": 17051,
    "start": "08:07:42,306",
    "end": "08:07:43,426",
    "start_sec": 29262.306,
    "end_sec": 29263.426,
    "zh": "行了行了",
    "vi": "Thôi thôi thôi"
  },
  {
    "idx": 17052,
    "start": "08:07:43,426",
    "end": "08:07:44,226",
    "start_sec": 29263.426,
    "end_sec": 29264.226,
    "zh": "别哭了",
    "vi": "Đừng khóc nữa"
  },
  {
    "idx": 17053,
    "start": "08:07:44,226",
    "end": "08:07:46,246",
    "start_sec": 29264.226,
    "end_sec": 29266.246,
    "zh": "你要是怕就暂时待我这里",
    "vi": "Nếu bạn sợ thì tạm thời cứ ở chỗ tôi đi"
  },
  {
    "idx": 17054,
    "start": "08:07:46,246",
    "end": "08:07:48,086",
    "start_sec": 29266.246,
    "end_sec": 29268.086,
    "zh": "那太好了",
    "vi": "Tuyệt quá"
  },
  {
    "idx": 17055,
    "start": "08:07:48,086",
    "end": "08:07:49,586",
    "start_sec": 29268.086,
    "end_sec": 29269.586,
    "zh": "松开我",
    "vi": "Buông tôi ra"
  },
  {
    "idx": 17056,
    "start": "08:07:49,586",
    "end": "08:07:50,426",
    "start_sec": 29269.586,
    "end_sec": 29270.426,
    "zh": "拜托",
    "vi": "Làm ơn đi"
  },
  {
    "idx": 17057,
    "start": "08:07:50,426",
    "end": "08:07:52,726",
    "start_sec": 29270.426,
    "end_sec": 29272.726,
    "zh": "就抱一会儿",
    "vi": "Ôm một lát thôi"
  },
  {
    "idx": 17058,
    "start": "08:07:52,726",
    "end": "08:07:53,326",
    "start_sec": 29272.726,
    "end_sec": 29273.326,
    "zh": "谢谢你",
    "vi": "Cảm ơn bạn"
  },
  {
    "idx": 17059,
    "start": "08:07:53,326",
    "end": "08:07:54,606",
    "start_sec": 29273.326,
    "end_sec": 29274.606,
    "zh": "你家什么人在",
    "vi": "Nhà bạn có ai không"
  },
  {
    "idx": 17060,
    "start": "08:07:54,606",
    "end": "08:07:56,406",
    "start_sec": 29274.606,
    "end_sec": 29276.406,
    "zh": "程子皮",
    "vi": "Trình Tử Bì"
  },
  {
    "idx": 17061,
    "start": "08:07:56,406",
    "end": "08:07:57,666",
    "start_sec": 29276.406,
    "end_sec": 29277.666,
    "zh": "我家柳穗",
    "vi": "Nhà tôi Liễu Tuệ"
  },
  {
    "idx": 17062,
    "start": "08:07:57,666",
    "end": "08:08:01,306",
    "start_sec": 29277.666,
    "end_sec": 29281.306,
    "zh": "临江市正在被病毒扩张感染",
    "vi": "Thành phố Lâm Giang đang bị virus lây lan"
  },
  {
    "idx": 17063,
    "start": "08:08:01,306",
    "end": "08:08:04,246",
    "start_sec": 29281.306,
    "end_sec": 29284.246,
    "zh": "人类将迎来一场空前绝后的浩劫",
    "vi": "Nhân loại sẽ phải đối mặt với một tai họa chưa từng có"
  },
  {
    "idx": 17064,
    "start": "08:08:04,246",
    "end": "08:08:05,766",
    "start_sec": 29284.246,
    "end_sec": 29285.766,
    "zh": "请大家不要出门",
    "vi": "Mọi người xin đừng ra ngoài"
  },
  {
    "idx": 17065,
    "start": "08:08:05,766",
    "end": "08:08:08,066",
    "start_sec": 29285.766,
    "end_sec": 29288.066,
    "zh": "政府会尽全力清缴丧尸",
    "vi": "Chính phủ sẽ cố gắng hết sức để tiêu diệt zombie"
  },
  {
    "idx": 17066,
    "start": "08:08:08,066",
    "end": "08:08:10,366",
    "start_sec": 29288.066,
    "end_sec": 29290.366,
    "zh": "你说这里会安全吗",
    "vi": "Bạn nói ở đây có an toàn không"
  },
  {
    "idx": 17067,
    "start": "08:08:10,366",
    "end": "08:08:11,306",
    "start_sec": 29290.366,
    "end_sec": 29291.306,
    "zh": "应该会吧",
    "vi": "Chắc là có"
  },
  {
    "idx": 17068,
    "start": "08:08:11,306",
    "end": "08:08:15,666",
    "start_sec": 29291.306,
    "end_sec": 29295.666,
    "zh": "你现在怎么样了",
    "vi": "Bây giờ bạn thế nào rồi"
  },
  {
    "idx": 17069,
    "start": "08:08:15,666",
    "end": "08:08:17,326",
    "start_sec": 29295.666,
    "end_sec": 29297.326,
    "zh": "我今天已经出门了",
    "vi": "Hôm nay tôi đã ra ngoài rồi"
  },
  {
    "idx": 17070,
    "start": "08:08:17,326",
    "end": "08:08:19,006",
    "start_sec": 29297.326,
    "end_sec": 29299.006,
    "zh": "你",
    "vi": "Bạn"
  },
  {
    "idx": 17071,
    "start": "08:08:19,006",
    "end": "08:08:19,906",
    "start_sec": 29299.006,
    "end_sec": 29299.906,
    "zh": "你是",
    "vi": "Bạn là"
  },
  {
    "idx": 17072,
    "start": "08:08:19,906",
    "end": "08:08:21,106",
    "start_sec": 29299.906,
    "end_sec": 29301.106,
    "zh": "过去的我",
    "vi": "tôi của quá khứ."
  },
  {
    "idx": 17073,
    "start": "08:08:21,106",
    "end": "08:08:22,346",
    "start_sec": 29301.106,
    "end_sec": 29302.346,
    "zh": "我惨了",
    "vi": "Tôi tiêu rồi."
  },
  {
    "idx": 17074,
    "start": "08:08:22,346",
    "end": "08:08:23,346",
    "start_sec": 29302.346,
    "end_sec": 29303.346,
    "zh": "你又失忆了?",
    "vi": "Bạn lại mất trí nhớ rồi à."
  },
  {
    "idx": 17075,
    "start": "08:08:24,166",
    "end": "08:08:25,986",
    "start_sec": 29304.166,
    "end_sec": 29305.986,
    "zh": "没有,只是脑子很恍惚。",
    "vi": "Không có, chỉ là đầu óc rất mơ hồ."
  },
  {
    "idx": 17076,
    "start": "08:08:26,666",
    "end": "08:08:31,186",
    "start_sec": 29306.666,
    "end_sec": 29311.186,
    "zh": "你赶紧想办法逃离所在的世界,不然我看你迟早要变傻子。",
    "vi": "Bạn mau nghĩ cách trốn khỏi thế giới đó đi, nếu không tôi thấy sớm muộn gì bạn cũng thành kẻ ngốc."
  },
  {
    "idx": 17077,
    "start": "08:08:31,826",
    "end": "08:08:35,109",
    "start_sec": 29311.826,
    "end_sec": 29315.109,
    "zh": "可是,我这有丧尸啊,我屋里有吃的喝的完的,还有,还有一个女人,没必要出去吧。",
    "vi": "Nhưng chỗ tôi có thây ma mà, trong phòng tôi có đồ ăn thức uống đồ chơi,"
  },
  {
    "idx": 17077,
    "start": "08:08:35,109",
    "end": "08:08:38,006",
    "start_sec": 29315.109,
    "end_sec": 29318.006,
    "zh": "可是,我这有丧尸啊,我屋里有吃的喝的完的,还有,还有一个女人,没必要出去吧。",
    "vi": "lại còn có một người phụ nữ nữa, không cần thiết phải ra ngoài đâu."
  },
  {
    "idx": 17078,
    "start": "08:08:38,906",
    "end": "08:08:43,546",
    "start_sec": 29318.906,
    "end_sec": 29323.546,
    "zh": "我操了,这诡异给你安排的挺周到达,你赶紧带着香炉离开。",
    "vi": "Chết tiệt, thế lực quỷ dị này sắp xếp cho bạn chu đáo quá đấy, bạn mau mang lư hương rời đi đi."
  },
  {
    "idx": 17079,
    "start": "08:08:44,246",
    "end": "08:08:46,386",
    "start_sec": 29324.246,
    "end_sec": 29326.386,
    "zh": "放心,有香炉你肯定不会害怕。",
    "vi": "Yên tâm đi, có lư hương bạn chắc chắn sẽ không sợ hãi."
  },
  {
    "idx": 17080,
    "start": "08:08:46,966",
    "end": "08:08:50,166",
    "start_sec": 29326.966,
    "end_sec": 29330.166,
    "zh": "香炉,香炉不是我们家传给老祖宗烧香的吗?",
    "vi": "Lư hương, không phải lư hương là đồ gia truyền nhà chúng ta để thắp hương cho tổ tiên sao."
  },
  {
    "idx": 17081,
    "start": "08:08:50,566",
    "end": "08:08:51,546",
    "start_sec": 29330.566,
    "end_sec": 29331.546,
    "zh": "它能打丧尸吗?",
    "vi": "Nó có thể đánh thây ma được không."
  },
  {
    "idx": 17082,
    "start": "08:08:51,546",
    "end": "08:08:52,706",
    "start_sec": 29331.546,
    "end_sec": 29332.706,
    "zh": "坏了",
    "vi": "Hỏng rồi"
  },
  {
    "idx": 17083,
    "start": "08:08:52,706",
    "end": "08:08:54,406",
    "start_sec": 29332.706,
    "end_sec": 29334.406,
    "zh": "你的记忆又被篡改了",
    "vi": "Ký ức của bạn lại bị thay đổi rồi"
  },
  {
    "idx": 17084,
    "start": "08:08:54,406",
    "end": "08:08:55,806",
    "start_sec": 29334.406,
    "end_sec": 29335.806,
    "zh": "你这样",
    "vi": "Bạn làm thế này đi"
  },
  {
    "idx": 17085,
    "start": "08:08:55,806",
    "end": "08:08:56,866",
    "start_sec": 29335.806,
    "end_sec": 29336.866,
    "zh": "每隔十分钟",
    "vi": "Cứ mỗi mười phút"
  },
  {
    "idx": 17086,
    "start": "08:08:56,866",
    "end": "08:08:58,786",
    "start_sec": 29336.866,
    "end_sec": 29338.786,
    "zh": "就翻看我们的聊天记录一次",
    "vi": "lại xem lại lịch sử trò chuyện của chúng ta một lần"
  },
  {
    "idx": 17087,
    "start": "08:08:58,786",
    "end": "08:09:00,226",
    "start_sec": 29338.786,
    "end_sec": 29340.226,
    "zh": "我大致想明白了",
    "vi": "Tôi đại khái đã hiểu ra rồi"
  },
  {
    "idx": 17088,
    "start": "08:09:00,226",
    "end": "08:09:01,426",
    "start_sec": 29340.226,
    "end_sec": 29341.426,
    "zh": "你的记忆会被篡改",
    "vi": "Ký ức của bạn sẽ bị thay đổi"
  },
  {
    "idx": 17089,
    "start": "08:09:01,426",
    "end": "08:09:03,006",
    "start_sec": 29341.426,
    "end_sec": 29343.006,
    "zh": "但是我们的聊天记录不会",
    "vi": "Nhưng lịch sử trò chuyện của chúng ta thì không"
  },
  {
    "idx": 17090,
    "start": "08:09:03,006",
    "end": "08:09:05,006",
    "start_sec": 29343.006,
    "end_sec": 29345.006,
    "zh": "你是要时刻警醒自己",
    "vi": "Bạn phải luôn cảnh tỉnh bản thân"
  },
  {
    "idx": 17091,
    "start": "08:09:05,006",
    "end": "08:09:06,706",
    "start_sec": 29345.006,
    "end_sec": 29346.706,
    "zh": "不要沉溺在安全的小屋里",
    "vi": "Không được chìm đắm trong căn phòng an toàn này"
  },
  {
    "idx": 17092,
    "start": "08:09:06,706",
    "end": "08:09:08,266",
    "start_sec": 29346.706,
    "end_sec": 29348.266,
    "zh": "聊天记录吗",
    "vi": "Lịch sử trò chuyện sao."
  },
  {
    "idx": 17093,
    "start": "08:09:08,266",
    "end": "08:09:10,166",
    "start_sec": 29348.266,
    "end_sec": 29350.166,
    "zh": "还真是",
    "vi": "Đúng là thế thật"
  },
  {
    "idx": 17094,
    "start": "08:09:10,166",
    "end": "08:09:10,886",
    "start_sec": 29350.166,
    "end_sec": 29350.886,
    "zh": "原来",
    "vi": "Hóa ra"
  },
  {
    "idx": 17095,
    "start": "08:09:10,886",
    "end": "08:09:12,506",
    "start_sec": 29350.886,
    "end_sec": 29352.506,
    "zh": "我还可以给过去的自己报备",
    "vi": "tôi còn có thể báo cáo cho bản thân trong quá khứ"
  },
  {
    "idx": 17096,
    "start": "08:09:12,506",
    "end": "08:09:13,886",
    "start_sec": 29352.506,
    "end_sec": 29353.886,
    "zh": "然后去死吗",
    "vi": "rồi đi chết sao."
  },
  {
    "idx": 17097,
    "start": "08:09:13,886",
    "end": "08:09:15,246",
    "start_sec": 29353.886,
    "end_sec": 29355.246,
    "zh": "朋友们",
    "vi": "Các bạn ơi"
  },
  {
    "idx": 17098,
    "start": "08:09:15,246",
    "end": "08:09:16,226",
    "start_sec": 29355.246,
    "end_sec": 29356.226,
    "zh": "一定待在屋里",
    "vi": "Nhất định phải ở trong phòng"
  },
  {
    "idx": 17099,
    "start": "08:09:16,226",
    "end": "08:09:16,766",
    "start_sec": 29356.226,
    "end_sec": 29356.766,
    "zh": "别出来",
    "vi": "Đừng ra ngoài"
  },
  {
    "idx": 17100,
    "start": "08:09:16,766",
    "end": "08:09:18,306",
    "start_sec": 29356.766,
    "end_sec": 29358.306,
    "zh": "外面的丧尸还在清脚",
    "vi": "Thây ma bên ngoài vẫn đang lùng sục."
  },
  {
    "idx": 17101,
    "start": "08:09:18,306",
    "end": "08:09:19,626",
    "start_sec": 29358.306,
    "end_sec": 29359.626,
    "zh": "我负责给你们送火石",
    "vi": "Tôi chịu trách nhiệm mang đá lửa đến cho các bạn."
  },
  {
    "idx": 17102,
    "start": "08:09:19,626",
    "end": "08:09:20,266",
    "start_sec": 29359.626,
    "end_sec": 29360.266,
    "zh": "别担心",
    "vi": "Đừng lo lắng."
  },
  {
    "idx": 17103,
    "start": "08:09:20,266",
    "end": "08:09:21,526",
    "start_sec": 29360.266,
    "end_sec": 29361.526,
    "zh": "局势会控制住的",
    "vi": "Tình hình sẽ được kiểm soát thôi."
  },
  {
    "idx": 17104,
    "start": "08:09:21,526",
    "end": "08:09:22,606",
    "start_sec": 29361.526,
    "end_sec": 29362.606,
    "zh": "食物",
    "vi": "Thức ăn."
  },
  {
    "idx": 17105,
    "start": "08:09:22,606",
    "end": "08:09:23,206",
    "start_sec": 29362.606,
    "end_sec": 29363.206,
    "zh": "女人",
    "vi": "Phụ nữ."
  },
  {
    "idx": 17106,
    "start": "08:09:23,206",
    "end": "08:09:24,026",
    "start_sec": 29363.206,
    "end_sec": 29364.026,
    "zh": "屋里安全",
    "vi": "Trong nhà rất an toàn."
  },
  {
    "idx": 17107,
    "start": "08:09:24,026",
    "end": "08:09:24,966",
    "start_sec": 29364.026,
    "end_sec": 29364.966,
    "zh": "屋外危险",
    "vi": "Bên ngoài rất nguy hiểm."
  },
  {
    "idx": 17108,
    "start": "08:09:24,966",
    "end": "08:09:26,266",
    "start_sec": 29364.966,
    "end_sec": 29366.266,
    "zh": "好一个陈文向",
    "vi": "Khá khen cho Trần Văn Hướng."
  },
  {
    "idx": 17109,
    "start": "08:09:26,266",
    "end": "08:09:27,686",
    "start_sec": 29366.266,
    "end_sec": 29367.686,
    "zh": "要是没有过去的我",
    "vi": "Nếu không có tôi của quá khứ."
  },
  {
    "idx": 17110,
    "start": "08:09:27,686",
    "end": "08:09:29,846",
    "start_sec": 29367.686,
    "end_sec": 29369.846,
    "zh": "我还真就被困在这里了",
    "vi": "Thì tôi đã thực sự bị kẹt ở đây rồi."
  },
  {
    "idx": 17111,
    "start": "08:09:29,846",
    "end": "08:09:35,306",
    "start_sec": 29369.846,
    "end_sec": 29375.306,
    "zh": "你干什么",
    "vi": "Bạn đang làm gì thế."
  },
  {
    "idx": 17112,
    "start": "08:09:35,306",
    "end": "08:09:36,066",
    "start_sec": 29375.306,
    "end_sec": 29376.066,
    "zh": "外面",
    "vi": "Bên ngoài."
  },
  {
    "idx": 17113,
    "start": "08:09:36,066",
    "end": "08:09:37,366",
    "start_sec": 29376.066,
    "end_sec": 29377.366,
    "zh": "外面有丧尸",
    "vi": "Bên ngoài có thây ma."
  },
  {
    "idx": 17114,
    "start": "08:09:37,366",
    "end": "08:09:38,386",
    "start_sec": 29377.366,
    "end_sec": 29378.386,
    "zh": "不要出门",
    "vi": "Đừng ra ngoài."
  },
  {
    "idx": 17115,
    "start": "08:09:38,386",
    "end": "08:09:40,166",
    "start_sec": 29378.386,
    "end_sec": 29380.166,
    "zh": "我没猜错",
    "vi": "Tôi đoán không sai."
  },
  {
    "idx": 17116,
    "start": "08:09:40,166",
    "end": "08:09:41,646",
    "start_sec": 29380.166,
    "end_sec": 29381.646,
    "zh": "这个设计是虚假的吧",
    "vi": "Thiết kế này là giả tạo đúng không."
  },
  {
    "idx": 17117,
    "start": "08:09:41,646",
    "end": "08:09:43,126",
    "start_sec": 29381.646,
    "end_sec": 29383.126,
    "zh": "包括你",
    "vi": "Bao gồm cả bạn nữa."
  },
  {
    "idx": 17118,
    "start": "08:09:43,126",
    "end": "08:09:45,266",
    "start_sec": 29383.126,
    "end_sec": 29385.266,
    "zh": "你为什么不进来",
    "vi": "Tại sao bạn không vào đây."
  },
  {
    "idx": 17119,
    "start": "08:09:45,266",
    "end": "08:09:46,226",
    "start_sec": 29385.266,
    "end_sec": 29386.226,
    "zh": "为什么",
    "vi": "Tại sao chứ."
  },
  {
    "idx": 17120,
    "start": "08:09:46,226",
    "end": "08:09:47,786",
    "start_sec": 29386.226,
    "end_sec": 29387.786,
    "zh": "糟了",
    "vi": "Hỏng bét rồi."
  },
  {
    "idx": 17121,
    "start": "08:09:47,786",
    "end": "08:09:49,166",
    "start_sec": 29387.786,
    "end_sec": 29389.166,
    "zh": "原形毕露了",
    "vi": "Đã lộ nguyên hình rồi."
  },
  {
    "idx": 17122,
    "start": "08:09:49,166",
    "end": "08:09:49,986",
    "start_sec": 29389.166,
    "end_sec": 29389.986,
    "zh": "香炉香炉",
    "vi": "Lư hương ơi lư hương."
  },
  {
    "idx": 17123,
    "start": "08:09:49,986",
    "end": "08:09:51,786",
    "start_sec": 29389.986,
    "end_sec": 29391.786,
    "zh": "你可一定要有用啊",
    "vi": "Bạn nhất định phải có tác dụng đấy nhé."
  },
  {
    "idx": 17124,
    "start": "08:09:51,786",
    "end": "08:09:54,846",
    "start_sec": 29391.786,
    "end_sec": 29394.846,
    "zh": "不是吧",
    "vi": "Không thể nào."
  },
  {
    "idx": 17125,
    "start": "08:09:54,846",
    "end": "08:09:57,120",
    "start_sec": 29394.846,
    "end_sec": 29397.12,
    "zh": "你这畜生别敢动手这不是我从来记忆平凡的结局的存在小墨记你你明明是假的却潜意识里也要保护我你放心",
    "vi": "Con súc sinh này sao dám ra tay chứ"
  },
  {
    "idx": 17125,
    "start": "08:09:57,120",
    "end": "08:10:00,405",
    "start_sec": 29397.12,
    "end_sec": 29400.405,
    "zh": "你这畜生别敢动手这不是我从来记忆平凡的结局的存在小墨记你你明明是假的却潜意识里也要保护我你放心",
    "vi": "Đây không phải là kết cục bình thường trong ký ức của tôi"
  },
  {
    "idx": 17125,
    "start": "08:10:00,405",
    "end": "08:10:04,701",
    "start_sec": 29400.405,
    "end_sec": 29404.701,
    "zh": "你这畜生别敢动手这不是我从来记忆平凡的结局的存在小墨记你你明明是假的却潜意识里也要保护我你放心",
    "vi": "Tiểu Mặc à, bạn rõ ràng là giả nhưng trong tiềm thức vẫn muốn bảo vệ tôi"
  },
  {
    "idx": 17125,
    "start": "08:10:04,701",
    "end": "08:10:05,712",
    "start_sec": 29404.701,
    "end_sec": 29405.712,
    "zh": "你这畜生别敢动手这不是我从来记忆平凡的结局的存在小墨记你你明明是假的却潜意识里也要保护我你放心",
    "vi": "Bạn yên tâm đi"
  },
  {
    "idx": 17126,
    "start": "08:10:05,712",
    "end": "08:10:07,752",
    "start_sec": 29405.712,
    "end_sec": 29407.752,
    "zh": "我一定会逃出去的",
    "vi": "Tôi nhất định sẽ trốn thoát được."
  },
  {
    "idx": 17127,
    "start": "08:10:07,752",
    "end": "08:10:09,812",
    "start_sec": 29407.752,
    "end_sec": 29409.812,
    "zh": "长得比杰力跑的",
    "vi": "Chạy nhanh như bay."
  },
  {
    "idx": 17128,
    "start": "08:10:09,812",
    "end": "08:10:12,612",
    "start_sec": 29409.812,
    "end_sec": 29412.612,
    "zh": "突然前方出现一个木偶的人影",
    "vi": "Đột nhiên phía trước xuất hiện bóng dáng của một con rối."
  },
  {
    "idx": 17129,
    "start": "08:10:12,612",
    "end": "08:10:13,892",
    "start_sec": 29412.612,
    "end_sec": 29413.892,
    "zh": "喂",
    "vi": "Này."
  },
  {
    "idx": 17130,
    "start": "08:10:13,892",
    "end": "08:10:14,892",
    "start_sec": 29413.892,
    "end_sec": 29414.892,
    "zh": "你在干什么",
    "vi": "Bạn đang làm gì thế."
  },
  {
    "idx": 17131,
    "start": "08:10:14,892",
    "end": "08:10:17,472",
    "start_sec": 29414.892,
    "end_sec": 29417.472,
    "zh": "我在等食物啊",
    "vi": "Tôi đang đợi thức ăn mà."
  },
  {
    "idx": 17132,
    "start": "08:10:17,472",
    "end": "08:10:18,772",
    "start_sec": 29417.472,
    "end_sec": 29418.772,
    "zh": "这里会掉落食物",
    "vi": "Thức ăn sẽ rơi xuống ở đây."
  },
  {
    "idx": 17133,
    "start": "08:10:18,772",
    "end": "08:10:21,532",
    "start_sec": 29418.772,
    "end_sec": 29421.532,
    "zh": "我的任务就是带食物给你",
    "vi": "Nhiệm vụ của tôi là mang thức ăn cho cô."
  },
  {
    "idx": 17134,
    "start": "08:10:21,532",
    "end": "08:10:23,272",
    "start_sec": 29421.532,
    "end_sec": 29423.272,
    "zh": "告诉你屋外很危险",
    "vi": "Và nói với cô rằng bên ngoài ngôi nhà rất nguy hiểm."
  },
  {
    "idx": 17135,
    "start": "08:10:25,012",
    "end": "08:10:28,852",
    "start_sec": 29425.012,
    "end_sec": 29428.852,
    "zh": "这触感难道你也是人",
    "vi": "Cảm giác chạm này, lẽ nào cô cũng là con người."
  },
  {
    "idx": 17136,
    "start": "08:10:28,852",
    "end": "08:10:30,092",
    "start_sec": 29428.852,
    "end_sec": 29430.092,
    "zh": "记忆被篡改",
    "vi": "Ký ức đã bị thay đổi."
  },
  {
    "idx": 17137,
    "start": "08:10:30,092",
    "end": "08:10:32,312",
    "start_sec": 29430.092,
    "end_sec": 29432.312,
    "zh": "和我一样被困在这虚假世界",
    "vi": "Cũng bị mắc kẹt trong thế giới giả tạo này giống như tôi."
  },
  {
    "idx": 17138,
    "start": "08:10:32,312",
    "end": "08:10:35,372",
    "start_sec": 29432.312,
    "end_sec": 29435.372,
    "zh": "眼下这人能独自来到第五层世界",
    "vi": "Người trước mắt này có thể một mình đến được thế giới tầng thứ năm."
  },
  {
    "idx": 17139,
    "start": "08:10:35,372",
    "end": "08:10:36,652",
    "start_sec": 29435.372,
    "end_sec": 29436.652,
    "zh": "能力肯定不凡",
    "vi": "Năng lực chắc chắn không tầm thường."
  },
  {
    "idx": 17140,
    "start": "08:10:36,652",
    "end": "08:10:38,252",
    "start_sec": 29436.652,
    "end_sec": 29438.252,
    "zh": "长者提冷不丁的",
    "vi": "Nhân lúc cô ấy không để ý."
  },
  {
    "idx": 17141,
    "start": "08:10:38,252",
    "end": "08:10:39,672",
    "start_sec": 29438.252,
    "end_sec": 29439.672,
    "zh": "我拍他的防护头头",
    "vi": "Tôi vỗ vào mũ bảo hộ của cô ấy."
  },
  {
    "idx": 17142,
    "start": "08:10:39,672",
    "end": "08:10:41,412",
    "start_sec": 29439.672,
    "end_sec": 29441.412,
    "zh": "我曹怎么是你",
    "vi": "Trời đất, sao lại là cô."
  },
  {
    "idx": 17143,
    "start": "08:10:41,412",
    "end": "08:10:42,612",
    "start_sec": 29441.412,
    "end_sec": 29442.612,
    "zh": "你认识我",
    "vi": "Cô quen tôi sao."
  },
  {
    "idx": 17144,
    "start": "08:10:42,612",
    "end": "08:10:43,852",
    "start_sec": 29442.612,
    "end_sec": 29443.852,
    "zh": "如果你是真的",
    "vi": "Nếu cô là thật."
  },
  {
    "idx": 17145,
    "start": "08:10:43,852",
    "end": "08:10:44,852",
    "start_sec": 29443.852,
    "end_sec": 29444.852,
    "zh": "那屋里那个",
    "vi": "Vậy người ở trong nhà kia."
  },
  {
    "idx": 17146,
    "start": "08:10:44,852",
    "end": "08:10:46,012",
    "start_sec": 29444.852,
    "end_sec": 29446.012,
    "zh": "我曹",
    "vi": "Trời đất."
  },
  {
    "idx": 17147,
    "start": "08:10:46,012",
    "end": "08:10:48,232",
    "start_sec": 29446.012,
    "end_sec": 29448.232,
    "zh": "如果我真和屋里那个柳醉发生关系",
    "vi": "Nếu tôi thực sự phát sinh quan hệ với Liễu Túy ở trong nhà kia."
  },
  {
    "idx": 17148,
    "start": "08:10:48,232",
    "end": "08:10:49,792",
    "start_sec": 29448.232,
    "end_sec": 29449.792,
    "zh": "那岂不是热的鬼了",
    "vi": "Thì chẳng phải là gặp ma rồi sao."
  },
  {
    "idx": 17149,
    "start": "08:10:55,012",
    "end": "08:11:11,472",
    "start_sec": 29455.012,
    "end_sec": 29471.472,
    "zh": "跟我走",
    "vi": "Đi theo tôi."
  },
  {
    "idx": 17150,
    "start": "08:11:11,472",
    "end": "08:11:12,712",
    "start_sec": 29471.472,
    "end_sec": 29472.712,
    "zh": "一起去找出口",
    "vi": "Cùng đi tìm lối ra."
  },
  {
    "idx": 17151,
    "start": "08:11:12,712",
    "end": "08:11:13,512",
    "start_sec": 29472.712,
    "end_sec": 29473.512,
    "zh": "然而",
    "vi": "Tuy nhiên."
  },
  {
    "idx": 17152,
    "start": "08:11:13,512",
    "end": "08:11:15,332",
    "start_sec": 29473.512,
    "end_sec": 29475.332,
    "zh": "长期被困在第四空间",
    "vi": "Bị mắc kẹt trong không gian thứ tư suốt thời gian dài."
  },
  {
    "idx": 17153,
    "start": "08:11:15,332",
    "end": "08:11:18,392",
    "start_sec": 29475.332,
    "end_sec": 29478.392,
    "zh": "柳碎已经没了当初要离开的决心和记忆",
    "vi": "Liễu Túy đã không còn quyết tâm muốn rời đi và ký ức ban đầu nữa."
  },
  {
    "idx": 17154,
    "start": "08:11:18,392",
    "end": "08:11:19,992",
    "start_sec": 29478.392,
    "end_sec": 29479.992,
    "zh": "只剩下木讷的眼神",
    "vi": "Chỉ còn lại ánh mắt đờ đẫn."
  },
  {
    "idx": 17155,
    "start": "08:11:19,992",
    "end": "08:11:21,852",
    "start_sec": 29479.992,
    "end_sec": 29481.852,
    "zh": "没多久",
    "vi": "Không lâu sau."
  },
  {
    "idx": 17156,
    "start": "08:11:21,852",
    "end": "08:11:23,052",
    "start_sec": 29481.852,
    "end_sec": 29483.052,
    "zh": "烟雾逐渐淡薄",
    "vi": "Khói sương dần tan đi."
  },
  {
    "idx": 17157,
    "start": "08:11:23,052",
    "end": "08:11:25,072",
    "start_sec": 29483.052,
    "end_sec": 29485.072,
    "zh": "一条通风管道出现眼前",
    "vi": "Một đường ống thông gió xuất hiện trước mắt."
  },
  {
    "idx": 17158,
    "start": "08:11:25,072",
    "end": "08:11:28,052",
    "start_sec": 29485.072,
    "end_sec": 29488.052,
    "zh": "这里会是通往第五世界的通道吗",
    "vi": "Nơi này liệu có phải là lối đi dẫn đến thế giới thứ năm."
  },
  {
    "idx": 17159,
    "start": "08:11:28,052",
    "end": "08:11:30,832",
    "start_sec": 29488.052,
    "end_sec": 29490.832,
    "zh": "一路顺着通道往上爬",
    "vi": "Cứ thế leo lên theo đường ống."
  },
  {
    "idx": 17160,
    "start": "08:11:30,832",
    "end": "08:11:31,792",
    "start_sec": 29490.832,
    "end_sec": 29491.792,
    "zh": "奇怪的是",
    "vi": "Điều kỳ lạ là."
  },
  {
    "idx": 17161,
    "start": "08:11:31,792",
    "end": "08:11:33,312",
    "start_sec": 29491.792,
    "end_sec": 29493.312,
    "zh": "管道里仿佛没有重力",
    "vi": "Trong đường ống dường như không có trọng lực."
  },
  {
    "idx": 17162,
    "start": "08:11:33,312",
    "end": "08:11:34,292",
    "start_sec": 29493.312,
    "end_sec": 29494.292,
    "zh": "突起的声响",
    "vi": "Tiếng động đột ngột vang lên."
  },
  {
    "idx": 17163,
    "start": "08:11:34,292",
    "end": "08:11:37,452",
    "start_sec": 29494.292,
    "end_sec": 29497.452,
    "zh": "这里是哪里",
    "vi": "Đây là nơi nào thế."
  },
  {
    "idx": 17164,
    "start": "08:11:37,452",
    "end": "08:11:39,792",
    "start_sec": 29497.452,
    "end_sec": 29499.792,
    "zh": "我的记忆似乎在逐渐恢复",
    "vi": "Ký ức của tôi dường như đang dần hồi phục."
  },
  {
    "idx": 17165,
    "start": "08:11:39,792",
    "end": "08:11:42,812",
    "start_sec": 29499.792,
    "end_sec": 29502.812,
    "zh": "这里好像是普宁街道的一间小作坊",
    "vi": "Nơi này hình như là một xưởng nhỏ trên phố Phổ Ninh."
  },
  {
    "idx": 17166,
    "start": "08:11:42,812",
    "end": "08:11:44,232",
    "start_sec": 29502.812,
    "end_sec": 29504.232,
    "zh": "你恢复记忆了",
    "vi": "Bạn đã khôi phục ký ức rồi sao."
  },
  {
    "idx": 17167,
    "start": "08:11:44,232",
    "end": "08:11:45,772",
    "start_sec": 29504.232,
    "end_sec": 29505.772,
    "zh": "牛仔看着橙子皮",
    "vi": "Cowboy nhìn Trần Tử Bì."
  },
  {
    "idx": 17168,
    "start": "08:11:45,772",
    "end": "08:11:47,092",
    "start_sec": 29505.772,
    "end_sec": 29507.092,
    "zh": "不禁一阵脸红",
    "vi": "Không khỏi đỏ mặt."
  },
  {
    "idx": 17169,
    "start": "08:11:47,092",
    "end": "08:11:48,972",
    "start_sec": 29507.092,
    "end_sec": 29508.972,
    "zh": "忌讳幻化成他的样子",
    "vi": "Kỵ Húy hóa thân thành hình dáng của anh ta."
  },
  {
    "idx": 17170,
    "start": "08:11:48,972",
    "end": "08:11:51,312",
    "start_sec": 29508.972,
    "end_sec": 29511.312,
    "zh": "和橙子皮轻易的画面也在恢复",
    "vi": "Cảnh tượng thân mật với Trần Tử Bì cũng đang hiện về."
  },
  {
    "idx": 17171,
    "start": "08:11:51,312",
    "end": "08:11:52,072",
    "start_sec": 29511.312,
    "end_sec": 29512.072,
    "zh": "橙子皮",
    "vi": "Trần Tử Bì."
  },
  {
    "idx": 17172,
    "start": "08:11:52,072",
    "end": "08:11:53,672",
    "start_sec": 29512.072,
    "end_sec": 29513.672,
    "zh": "你挺厉害的",
    "vi": "Bạn khá lợi hại đấy."
  },
  {
    "idx": 17173,
    "start": "08:11:53,672",
    "end": "08:11:55,732",
    "start_sec": 29513.672,
    "end_sec": 29515.732,
    "zh": "你是怎么知道记忆被篡改了吗",
    "vi": "Làm sao bạn biết ký ức đã bị thay đổi."
  },
  {
    "idx": 17174,
    "start": "08:11:55,732",
    "end": "08:11:57,052",
    "start_sec": 29515.732,
    "end_sec": 29517.052,
    "zh": "而且还能跑出来",
    "vi": "Và lại còn thoát ra được nữa."
  },
  {
    "idx": 17175,
    "start": "08:11:57,052",
    "end": "08:11:59,852",
    "start_sec": 29517.052,
    "end_sec": 29519.852,
    "zh": "因为我不是一个人",
    "vi": "Bởi vì tôi không đơn độc."
  },
  {
    "idx": 17176,
    "start": "08:11:59,852",
    "end": "08:12:00,432",
    "start_sec": 29519.852,
    "end_sec": 29520.432,
    "zh": "对了",
    "vi": "Đúng rồi."
  },
  {
    "idx": 17177,
    "start": "08:12:00,432",
    "end": "08:12:01,812",
    "start_sec": 29520.432,
    "end_sec": 29521.812,
    "zh": "你说这是普宁街道",
    "vi": "Bạn nói đây là phố Phổ Ninh sao."
  },
  {
    "idx": 17178,
    "start": "08:12:01,812",
    "end": "08:12:03,632",
    "start_sec": 29521.812,
    "end_sec": 29523.632,
    "zh": "难道我们兜兜转转一圈",
    "vi": "Chẳng lẽ chúng ta đi vòng quanh một hồi."
  },
  {
    "idx": 17179,
    "start": "08:12:03,632",
    "end": "08:12:05,212",
    "start_sec": 29523.632,
    "end_sec": 29525.212,
    "zh": "最后又回到了起点",
    "vi": "Cuối cùng lại quay về điểm xuất phát sao."
  },
  {
    "idx": 17180,
    "start": "08:12:05,212",
    "end": "08:12:06,772",
    "start_sec": 29525.212,
    "end_sec": 29526.772,
    "zh": "这我也不确定",
    "vi": "Điều này tôi cũng không chắc chắn."
  },
  {
    "idx": 17181,
    "start": "08:12:06,772",
    "end": "08:12:08,692",
    "start_sec": 29526.772,
    "end_sec": 29528.692,
    "zh": "出去看看不就知道了",
    "vi": "Ra ngoài xem thử là biết ngay mà."
  },
  {
    "idx": 17182,
    "start": "08:12:08,692",
    "end": "08:12:12,472",
    "start_sec": 29528.692,
    "end_sec": 29532.472,
    "zh": "看着门后普宁街道的景象",
    "vi": "Nhìn thấy cảnh tượng phố Phổ Ninh sau cánh cửa."
  },
  {
    "idx": 17183,
    "start": "08:12:12,472",
    "end": "08:12:13,992",
    "start_sec": 29532.472,
    "end_sec": 29533.992,
    "zh": "长子皮无语了",
    "vi": "Trần Tử Bì cạn lời."
  },
  {
    "idx": 17184,
    "start": "08:12:13,992",
    "end": "08:12:15,632",
    "start_sec": 29533.992,
    "end_sec": 29535.632,
    "zh": "卧槽还真回来了",
    "vi": "Trời đất quay lại thật rồi sao."
  },
  {
    "idx": 17185,
    "start": "08:12:15,632",
    "end": "08:12:16,912",
    "start_sec": 29535.632,
    "end_sec": 29536.912,
    "zh": "不对啊",
    "vi": "Không đúng."
  },
  {
    "idx": 17186,
    "start": "08:12:16,912",
    "end": "08:12:18,472",
    "start_sec": 29536.912,
    "end_sec": 29538.472,
    "zh": "相如说有七层空间",
    "vi": "Tương Như nói có bảy tầng không gian."
  },
  {
    "idx": 17187,
    "start": "08:12:18,472",
    "end": "08:12:19,792",
    "start_sec": 29538.472,
    "end_sec": 29539.792,
    "zh": "那就一定是七层",
    "vi": "Thì chắc chắn phải là bảy tầng."
  },
  {
    "idx": 17188,
    "start": "08:12:19,792",
    "end": "08:12:22,572",
    "start_sec": 29539.792,
    "end_sec": 29542.572,
    "zh": "难道眼前的普宁街道也是虚构的",
    "vi": "Chẳng lẽ phố Phổ Ninh trước mắt cũng là giả tạo sao."
  },
  {
    "idx": 17189,
    "start": "08:12:22,572",
    "end": "08:12:24,452",
    "start_sec": 29542.572,
    "end_sec": 29544.452,
    "zh": "这里到底是不是真的",
    "vi": "Nơi này rốt cuộc có phải là thật không."
  },
  {
    "idx": 17190,
    "start": "08:12:24,452",
    "end": "08:12:26,232",
    "start_sec": 29544.452,
    "end_sec": 29546.232,
    "zh": "我想我们可以验证一下",
    "vi": "Tôi nghĩ chúng ta có thể kiểm chứng xem sao."
  },
  {
    "idx": 17191,
    "start": "08:12:26,232",
    "end": "08:12:30,352",
    "start_sec": 29546.232,
    "end_sec": 29550.352,
    "zh": "我们去找魏昌盛",
    "vi": "Chúng ta đi tìm Ngụy Xương Thịnh."
  },
  {
    "idx": 17192,
    "start": "08:12:30,352",
    "end": "08:12:32,892",
    "start_sec": 29550.352,
    "end_sec": 29552.892,
    "zh": "大宝二宝",
    "vi": "Đại Bảo, Nhị Bảo."
  },
  {
    "idx": 17193,
    "start": "08:12:32,892",
    "end": "08:12:33,672",
    "start_sec": 29552.892,
    "end_sec": 29553.672,
    "zh": "慢点",
    "vi": "Chậm thôi."
  },
  {
    "idx": 17194,
    "start": "08:12:33,672",
    "end": "08:12:34,592",
    "start_sec": 29553.672,
    "end_sec": 29554.592,
    "zh": "你拆开",
    "vi": "Anh mở ra đi."
  },
  {
    "idx": 17195,
    "start": "08:12:34,592",
    "end": "08:12:41,112",
    "start_sec": 29554.592,
    "end_sec": 29561.112,
    "zh": "刘队长",
    "vi": "Đội trưởng Lưu."
  },
  {
    "idx": 17196,
    "start": "08:12:41,112",
    "end": "08:12:41,692",
    "start_sec": 29561.112,
    "end_sec": 29561.692,
    "zh": "你怎么",
    "vi": "Sao anh lại."
  },
  {
    "idx": 17197,
    "start": "08:12:41,692",
    "end": "08:12:43,292",
    "start_sec": 29561.692,
    "end_sec": 29563.292,
    "zh": "怎么和程先生在一起",
    "vi": "Sao lại đi cùng Trình tiên sinh thế này."
  },
  {
    "idx": 17198,
    "start": "08:12:43,292",
    "end": "08:12:45,992",
    "start_sec": 29563.292,
    "end_sec": 29565.992,
    "zh": "是不是很意外",
    "vi": "Có phải rất bất ngờ không."
  },
  {
    "idx": 17199,
    "start": "08:12:45,992",
    "end": "08:12:47,032",
    "start_sec": 29565.992,
    "end_sec": 29567.032,
    "zh": "我还能出来",
    "vi": "Tôi vẫn có thể ra ngoài được."
  },
  {
    "idx": 17200,
    "start": "08:12:47,032",
    "end": "08:12:49,712",
    "start_sec": 29567.032,
    "end_sec": 29569.712,
    "zh": "看他反应",
    "vi": "Nhìn phản ứng của ông ta xem."
  },
  {
    "idx": 17201,
    "start": "08:12:49,712",
    "end": "08:12:52,152",
    "start_sec": 29569.712,
    "end_sec": 29572.152,
    "zh": "不用猜了,这里就是普宁街道。",
    "vi": "Không cần đoán nữa, nơi này chính là phố Phổ Ninh."
  },
  {
    "idx": 17202,
    "start": "08:12:52,552",
    "end": "08:12:55,272",
    "start_sec": 29572.552,
    "end_sec": 29575.272,
    "zh": "柳队长,你是之前接任务的御鬼者小队?",
    "vi": "Đội trưởng Lưu, anh là đội Ngự Quỷ Giả nhận nhiệm vụ trước đó sao."
  },
  {
    "idx": 17203,
    "start": "08:12:55,872",
    "end": "08:12:59,986",
    "start_sec": 29575.872,
    "end_sec": 29579.986,
    "zh": "没错,摩世派遣小队一共来了五个人,但是其他人我估计已经变成白沙了。",
    "vi": "Đúng vậy, đội do Ma Thế phái đến có tổng cộng năm người, nhưng"
  },
  {
    "idx": 17203,
    "start": "08:12:59,986",
    "end": "08:13:03,512",
    "start_sec": 29579.986,
    "end_sec": 29583.512,
    "zh": "没错,摩世派遣小队一共来了五个人,但是其他人我估计已经变成白沙了。",
    "vi": "những người khác tôi đoán là đã biến thành cát trắng rồi."
  },
  {
    "idx": 17204,
    "start": "08:13:05,912",
    "end": "08:13:10,432",
    "start_sec": 29585.912,
    "end_sec": 29590.432,
    "zh": "魏昌盛,告诉我怎么离开这里,不然……",
    "vi": "Ngụy Xương Thịnh, mau nói cho tôi biết làm sao để rời khỏi đây, nếu không thì."
  },
  {
    "idx": 17205,
    "start": "08:13:10,432",
    "end": "08:13:13,973",
    "start_sec": 29590.432,
    "end_sec": 29593.973,
    "zh": "摩世特产的恶鬼子弹,每一发子弹里都有恶死鬼的气息,会吞噬一定的诡异力量。",
    "vi": "Đạn ác quỷ đặc sản của Ma Thế, mỗi một viên đạn đều mang hơi thở"
  },
  {
    "idx": 17205,
    "start": "08:13:13,973",
    "end": "08:13:17,292",
    "start_sec": 29593.973,
    "end_sec": 29597.292,
    "zh": "摩世特产的恶鬼子弹,每一发子弹里都有恶死鬼的气息,会吞噬一定的诡异力量。",
    "vi": "của Ác Tử Quỷ, sẽ nuốt chửng một lượng sức mạnh quỷ dị nhất định."
  },
  {
    "idx": 17206,
    "start": "08:13:17,292",
    "end": "08:13:20,552",
    "start_sec": 29597.292,
    "end_sec": 29600.552,
    "zh": "你也不想你养育的孩子被子弹吞是吧",
    "vi": "Ông cũng không muốn đứa trẻ mình nuôi nấng bị đạn nuốt chửng đúng không."
  },
  {
    "idx": 17207,
    "start": "08:13:20,552",
    "end": "08:13:21,492",
    "start_sec": 29600.552,
    "end_sec": 29601.492,
    "zh": "别开笑",
    "vi": "Đừng đùa thế chứ."
  },
  {
    "idx": 17208,
    "start": "08:13:21,492",
    "end": "08:13:21,972",
    "start_sec": 29601.492,
    "end_sec": 29601.972,
    "zh": "你们",
    "vi": "Các người."
  },
  {
    "idx": 17209,
    "start": "08:13:21,972",
    "end": "08:13:24,312",
    "start_sec": 29601.972,
    "end_sec": 29604.312,
    "zh": "你们现在可以出是吧",
    "vi": "Bây giờ các người có thể ra ngoài đúng không."
  },
  {
    "idx": 17210,
    "start": "08:13:24,312",
    "end": "08:13:24,952",
    "start_sec": 29604.312,
    "end_sec": 29604.952,
    "zh": "我不信",
    "vi": "Tôi không tin."
  },
  {
    "idx": 17211,
    "start": "08:13:24,952",
    "end": "08:13:26,832",
    "start_sec": 29604.952,
    "end_sec": 29606.832,
    "zh": "把你其中一个孩子给我",
    "vi": "Giao một đứa con của ông cho tôi."
  },
  {
    "idx": 17212,
    "start": "08:13:26,832",
    "end": "08:13:28,452",
    "start_sec": 29606.832,
    "end_sec": 29608.452,
    "zh": "一旦有任何异常",
    "vi": "Chỉ cần có bất kỳ điều gì bất thường."
  },
  {
    "idx": 17213,
    "start": "08:13:28,452",
    "end": "08:13:29,852",
    "start_sec": 29608.452,
    "end_sec": 29609.852,
    "zh": "我直接毙了他",
    "vi": "Tôi sẽ bắn chết nó ngay lập tức."
  },
  {
    "idx": 17214,
    "start": "08:13:29,852",
    "end": "08:13:31,592",
    "start_sec": 29609.852,
    "end_sec": 29611.592,
    "zh": "雷昌盛内心挣扎之下",
    "vi": "Trong sự đấu tranh nội tâm, Ngụy Xương Thịnh."
  },
  {
    "idx": 17215,
    "start": "08:13:31,592",
    "end": "08:13:32,912",
    "start_sec": 29611.592,
    "end_sec": 29612.912,
    "zh": "把大宝交给刘遂",
    "vi": "Đã giao Đại Bảo cho Lưu Toại."
  },
  {
    "idx": 17216,
    "start": "08:13:32,912",
    "end": "08:13:36,352",
    "start_sec": 29612.912,
    "end_sec": 29616.352,
    "zh": "刘遂小心翼翼的把大宝装进麻袋里",
    "vi": "Lưu Toại cẩn thận bỏ Đại Bảo vào trong bao tải."
  },
  {
    "idx": 17217,
    "start": "08:13:36,352",
    "end": "08:13:37,272",
    "start_sec": 29616.352,
    "end_sec": 29617.272,
    "zh": "陈子皮",
    "vi": "Trần Tử Bì."
  },
  {
    "idx": 17218,
    "start": "08:13:37,272",
    "end": "08:13:38,212",
    "start_sec": 29617.272,
    "end_sec": 29618.212,
    "zh": "你怎么说",
    "vi": "Anh thấy thế nào."
  },
  {
    "idx": 17219,
    "start": "08:13:38,212",
    "end": "08:13:40,092",
    "start_sec": 29618.212,
    "end_sec": 29620.092,
    "zh": "要不一起吧",
    "vi": "Hay là đi cùng nhau đi."
  },
  {
    "idx": 17220,
    "start": "08:13:40,092",
    "end": "08:13:40,792",
    "start_sec": 29620.092,
    "end_sec": 29620.792,
    "zh": "行",
    "vi": "Được rồi."
  },
  {
    "idx": 17221,
    "start": "08:13:40,792",
    "end": "08:13:42,352",
    "start_sec": 29620.792,
    "end_sec": 29622.352,
    "zh": "反正我现在也没什么思路",
    "vi": "Dù sao bây giờ tôi cũng chưa có manh mối gì."
  },
  {
    "idx": 17222,
    "start": "08:13:42,352",
    "end": "08:13:45,052",
    "start_sec": 29622.352,
    "end_sec": 29625.052,
    "zh": "来到普宁街道入口处",
    "vi": "Đi đến lối vào phố Phổ Ninh."
  },
  {
    "idx": 17223,
    "start": "08:13:45,052",
    "end": "08:13:48,352",
    "start_sec": 29625.052,
    "end_sec": 29628.352,
    "zh": "橙子皮伸手摸了摸得到无形的空间屏障",
    "vi": "Trần Tử Bì đưa tay ra chạm vào bức tường không gian vô hình."
  },
  {
    "idx": 17224,
    "start": "08:13:48,352",
    "end": "08:13:50,152",
    "start_sec": 29628.352,
    "end_sec": 29630.152,
    "zh": "真的能穿过屏障",
    "vi": "Thực sự có thể đi xuyên qua bức tường này."
  },
  {
    "idx": 17225,
    "start": "08:13:50,152",
    "end": "08:13:52,092",
    "start_sec": 29630.152,
    "end_sec": 29632.092,
    "zh": "难道这就可以离开了",
    "vi": "Chẳng lẽ như vậy là có thể rời đi rồi."
  },
  {
    "idx": 17226,
    "start": "08:13:52,092",
    "end": "08:13:52,972",
    "start_sec": 29632.092,
    "end_sec": 29632.972,
    "zh": "不对",
    "vi": "Không đúng."
  },
  {
    "idx": 17227,
    "start": "08:13:52,972",
    "end": "08:13:54,612",
    "start_sec": 29632.972,
    "end_sec": 29634.612,
    "zh": "这才五层空间啊",
    "vi": "Đây mới là không gian tầng thứ năm mà."
  },
  {
    "idx": 17228,
    "start": "08:13:54,612",
    "end": "08:13:55,492",
    "start_sec": 29634.612,
    "end_sec": 29635.492,
    "zh": "怎么了",
    "vi": "Có chuyện gì thế."
  },
  {
    "idx": 17229,
    "start": "08:13:55,492",
    "end": "08:13:56,512",
    "start_sec": 29635.492,
    "end_sec": 29636.512,
    "zh": "你不走吗",
    "vi": "Cô không đi sao."
  },
  {
    "idx": 17230,
    "start": "08:13:56,512",
    "end": "08:13:58,312",
    "start_sec": 29636.512,
    "end_sec": 29638.312,
    "zh": "我总觉得有古怪",
    "vi": "Tôi cứ cảm thấy có gì đó kỳ lạ."
  },
  {
    "idx": 17231,
    "start": "08:13:58,312",
    "end": "08:13:59,152",
    "start_sec": 29638.312,
    "end_sec": 29639.152,
    "zh": "哦",
    "vi": "Ồ."
  },
  {
    "idx": 17232,
    "start": "08:13:59,152",
    "end": "08:14:00,332",
    "start_sec": 29639.152,
    "end_sec": 29640.332,
    "zh": "那我也不走了",
    "vi": "Vậy tôi cũng không đi nữa."
  },
  {
    "idx": 17233,
    "start": "08:14:00,332",
    "end": "08:14:02,412",
    "start_sec": 29640.332,
    "end_sec": 29642.412,
    "zh": "你都能把我从那地方带出来",
    "vi": "Anh đã có thể đưa tôi ra khỏi nơi đó."
  },
  {
    "idx": 17234,
    "start": "08:14:02,412",
    "end": "08:14:04,052",
    "start_sec": 29642.412,
    "end_sec": 29644.052,
    "zh": "我相信你的直觉",
    "vi": "Tôi tin vào trực giác của anh."
  },
  {
    "idx": 17235,
    "start": "08:14:04,052",
    "end": "08:14:05,592",
    "start_sec": 29644.052,
    "end_sec": 29645.592,
    "zh": "由于这一番操作",
    "vi": "Vì hành động này."
  },
  {
    "idx": 17236,
    "start": "08:14:05,592",
    "end": "08:14:07,732",
    "start_sec": 29645.592,
    "end_sec": 29647.732,
    "zh": "让橙子皮一时间有些不知所措",
    "vi": "Khiến Trần Tử Bì nhất thời có chút lúng túng."
  },
  {
    "idx": 17237,
    "start": "08:14:07,732",
    "end": "08:14:09,892",
    "start_sec": 29647.732,
    "end_sec": 29649.892,
    "zh": "如果没有完成七层循环",
    "vi": "Nếu không hoàn thành vòng lặp bảy tầng."
  },
  {
    "idx": 17238,
    "start": "08:14:09,892",
    "end": "08:14:11,332",
    "start_sec": 29649.892,
    "end_sec": 29651.332,
    "zh": "就这样离开普宁街道",
    "vi": "Mà cứ thế rời khỏi phố Phổ Ninh."
  },
  {
    "idx": 17239,
    "start": "08:14:11,332",
    "end": "08:14:13,032",
    "start_sec": 29651.332,
    "end_sec": 29653.032,
    "zh": "或许会受到记忆上的惩罚",
    "vi": "Có lẽ sẽ phải chịu hình phạt về ký ức."
  },
  {
    "idx": 17240,
    "start": "08:14:13,032",
    "end": "08:14:14,072",
    "start_sec": 29653.032,
    "end_sec": 29654.072,
    "zh": "日了",
    "vi": "Phiền thật."
  },
  {
    "idx": 17241,
    "start": "08:14:14,072",
    "end": "08:14:14,872",
    "start_sec": 29654.072,
    "end_sec": 29654.872,
    "zh": "本来想看看",
    "vi": "Vốn dĩ muốn xem thử."
  },
  {
    "idx": 17242,
    "start": "08:14:14,872",
    "end": "08:14:16,552",
    "start_sec": 29654.872,
    "end_sec": 29656.552,
    "zh": "扭碎出去会不会有异常",
    "vi": "Nếu bóp nát để ra ngoài thì có gì bất thường không."
  },
  {
    "idx": 17243,
    "start": "08:14:16,552",
    "end": "08:14:17,812",
    "start_sec": 29656.552,
    "end_sec": 29657.812,
    "zh": "结果这女人来了",
    "vi": "Kết quả là người phụ nữ này lại đến."
  },
  {
    "idx": 17244,
    "start": "08:14:17,812",
    "end": "08:14:18,712",
    "start_sec": 29657.812,
    "end_sec": 29658.712,
    "zh": "这么一般操作",
    "vi": "Với tình huống này."
  },
  {
    "idx": 17245,
    "start": "08:14:18,712",
    "end": "08:14:20,752",
    "start_sec": 29658.712,
    "end_sec": 29660.752,
    "zh": "程子提在心里慢慢分析",
    "vi": "Trần Tử Bì âm thầm phân tích trong lòng."
  },
  {
    "idx": 17246,
    "start": "08:14:20,752",
    "end": "08:14:21,632",
    "start_sec": 29660.752,
    "end_sec": 29661.632,
    "zh": "现在",
    "vi": "Bây giờ."
  },
  {
    "idx": 17247,
    "start": "08:14:21,632",
    "end": "08:14:23,872",
    "start_sec": 29661.632,
    "end_sec": 29663.872,
    "zh": "如果楚家兄妹能出来的话就好了",
    "vi": "Nếu anh em nhà họ Sở có thể ra ngoài thì tốt rồi."
  },
  {
    "idx": 17248,
    "start": "08:14:23,872",
    "end": "08:14:25,512",
    "start_sec": 29663.872,
    "end_sec": 29665.512,
    "zh": "不然可以拿他们做实验",
    "vi": "Nếu không thì có thể dùng họ để làm thí nghiệm."
  },
  {
    "idx": 17249,
    "start": "08:14:25,512",
    "end": "08:14:26,392",
    "start_sec": 29665.512,
    "end_sec": 29666.392,
    "zh": "白旭的话",
    "vi": "Còn về Bạch Húc."
  },
  {
    "idx": 17250,
    "start": "08:14:26,392",
    "end": "08:14:27,892",
    "start_sec": 29666.392,
    "end_sec": 29667.892,
    "zh": "他没经过四层空间",
    "vi": "Cậu ta chưa từng đi qua không gian tầng thứ tư."
  },
  {
    "idx": 17251,
    "start": "08:14:27,892",
    "end": "08:14:29,892",
    "start_sec": 29667.892,
    "end_sec": 29669.892,
    "zh": "大概率会被空气墙阻隔",
    "vi": "Khả năng cao là sẽ bị bức tường không khí chặn lại."
  },
  {
    "idx": 17252,
    "start": "08:14:29,892",
    "end": "08:14:31,832",
    "start_sec": 29669.892,
    "end_sec": 29671.832,
    "zh": "第一层鬼屋雕塑人说",
    "vi": "Bức tượng người ở tầng một nhà ma đã nói."
  },
  {
    "idx": 17253,
    "start": "08:14:31,832",
    "end": "08:14:32,852",
    "start_sec": 29671.832,
    "end_sec": 29672.852,
    "zh": "有五层空间",
    "vi": "Có năm tầng không gian."
  },
  {
    "idx": 17254,
    "start": "08:14:32,852",
    "end": "08:14:34,132",
    "start_sec": 29672.852,
    "end_sec": 29674.132,
    "zh": "要是按照他所说",
    "vi": "Nếu đúng như lời hắn nói."
  },
  {
    "idx": 17255,
    "start": "08:14:34,132",
    "end": "08:14:35,992",
    "start_sec": 29674.132,
    "end_sec": 29675.992,
    "zh": "现在的确可以离开",
    "vi": "Bây giờ quả thực có thể rời đi rồi."
  },
  {
    "idx": 17256,
    "start": "08:14:35,992",
    "end": "08:14:37,412",
    "start_sec": 29675.992,
    "end_sec": 29677.412,
    "zh": "我去",
    "vi": "Trời đất ơi."
  },
  {
    "idx": 17257,
    "start": "08:14:37,412",
    "end": "08:14:38,832",
    "start_sec": 29677.412,
    "end_sec": 29678.832,
    "zh": "程子提你可以啊",
    "vi": "Trình Tử Bình, cậu giỏi thật đấy."
  },
  {
    "idx": 17258,
    "start": "08:14:38,832",
    "end": "08:14:40,032",
    "start_sec": 29678.832,
    "end_sec": 29680.032,
    "zh": "这么快就通关了",
    "vi": "Vượt ải nhanh như vậy sao."
  },
  {
    "idx": 17259,
    "start": "08:14:40,032",
    "end": "08:14:40,872",
    "start_sec": 29680.032,
    "end_sec": 29680.872,
    "zh": "楚刚",
    "vi": "Sở Cương."
  },
  {
    "idx": 17260,
    "start": "08:14:40,872",
    "end": "08:14:41,492",
    "start_sec": 29680.872,
    "end_sec": 29681.492,
    "zh": "楚柔",
    "vi": "Sở Nhu."
  },
  {
    "idx": 17261,
    "start": "08:14:41,492",
    "end": "08:14:43,092",
    "start_sec": 29681.492,
    "end_sec": 29683.092,
    "zh": "你们是怎么出来的",
    "vi": "Hai người làm sao mà ra được đây."
  },
  {
    "idx": 17262,
    "start": "08:14:44,872",
    "end": "08:14:45,992",
    "start_sec": 29684.872,
    "end_sec": 29685.992,
    "zh": "这个嘛",
    "vi": "Chuyện này ấy à."
  },
  {
    "idx": 17263,
    "start": "08:14:45,992",
    "end": "08:14:47,272",
    "start_sec": 29685.992,
    "end_sec": 29687.272,
    "zh": "巧意思了",
    "vi": "Cũng là tình cờ thôi."
  },
  {
    "idx": 17264,
    "start": "08:14:47,272",
    "end": "08:14:48,852",
    "start_sec": 29687.272,
    "end_sec": 29688.852,
    "zh": "你不是知道我的能力吗",
    "vi": "Bạn không biết năng lực của tôi sao."
  },
  {
    "idx": 17265,
    "start": "08:14:48,852",
    "end": "08:14:49,932",
    "start_sec": 29688.852,
    "end_sec": 29689.932,
    "zh": "伤害转移",
    "vi": "Chuyển đổi sát thương."
  },
  {
    "idx": 17266,
    "start": "08:14:49,932",
    "end": "08:14:53,612",
    "start_sec": 29689.932,
    "end_sec": 29693.612,
    "zh": "还有我提前把所有的记忆点都记在了手机上",
    "vi": "Với lại tôi đã ghi chú tất cả các điểm ghi nhớ vào điện thoại từ trước rồi."
  },
  {
    "idx": 17267,
    "start": "08:14:53,612",
    "end": "08:14:55,646",
    "start_sec": 29693.612,
    "end_sec": 29695.646,
    "zh": "玩着玩着就通关了哦简单真这么简单吗对了你们怎啊?我等白旭,要不你们先走吧。那好我不走了,第二关欠你的人情就下次还了。",
    "vi": "Chơi một hồi là vượt ải thôi"
  },
  {
    "idx": 17267,
    "start": "08:14:55,646",
    "end": "08:14:57,970",
    "start_sec": 29695.646,
    "end_sec": 29697.97,
    "zh": "玩着玩着就通关了哦简单真这么简单吗对了你们怎啊?我等白旭,要不你们先走吧。那好我不走了,第二关欠你的人情就下次还了。",
    "vi": "Đơn giản thật đấy, đơn giản vậy sao"
  },
  {
    "idx": 17267,
    "start": "08:14:57,970",
    "end": "08:14:59,713",
    "start_sec": 29697.97,
    "end_sec": 29699.713,
    "zh": "玩着玩着就通关了哦简单真这么简单吗对了你们怎啊?我等白旭,要不你们先走吧。那好我不走了,第二关欠你的人情就下次还了。",
    "vi": "Đúng rồi, sao các bạn lại"
  },
  {
    "idx": 17267,
    "start": "08:14:59,713",
    "end": "08:15:02,909",
    "start_sec": 29699.713,
    "end_sec": 29702.909,
    "zh": "玩着玩着就通关了哦简单真这么简单吗对了你们怎啊?我等白旭,要不你们先走吧。那好我不走了,第二关欠你的人情就下次还了。",
    "vi": "Tôi đợi Bạch Húc, hay là các bạn đi trước đi"
  },
  {
    "idx": 17267,
    "start": "08:15:02,909",
    "end": "08:15:07,558",
    "start_sec": 29702.909,
    "end_sec": 29707.558,
    "zh": "玩着玩着就通关了哦简单真这么简单吗对了你们怎啊?我等白旭,要不你们先走吧。那好我不走了,第二关欠你的人情就下次还了。",
    "vi": "Được thôi, tôi không đi nữa, ân tình ở ải hai lần sau tôi sẽ trả"
  },
  {
    "idx": 17268,
    "start": "08:15:08,018",
    "end": "08:15:11,478",
    "start_sec": 29708.018,
    "end_sec": 29711.478,
    "zh": "独家兄妹的身影越走越远,直到消失在视线里。",
    "vi": "Bóng dáng hai anh em nhà họ Độc Cô dần xa khuất cho đến khi biến mất khỏi tầm mắt."
  },
  {
    "idx": 17269,
    "start": "08:15:12,218",
    "end": "08:15:15,338",
    "start_sec": 29712.218,
    "end_sec": 29715.338,
    "zh": "陈子平,你看这,是不是彻底安全了?",
    "vi": "Trình Tử Bình, bạn xem chỗ này đã hoàn toàn an toàn chưa."
  },
  {
    "idx": 17270,
    "start": "08:15:15,758",
    "end": "08:15:17,938",
    "start_sec": 29715.758,
    "end_sec": 29717.938,
    "zh": "你不觉得他们来得太及时了吗?",
    "vi": "Bạn không thấy họ xuất hiện quá đúng lúc sao."
  },
  {
    "idx": 17271,
    "start": "08:15:18,378",
    "end": "08:15:21,558",
    "start_sec": 29718.378,
    "end_sec": 29721.558,
    "zh": "你的意思是说,这是作戏在诱导我们出去?",
    "vi": "Ý của bạn là, đây là màn kịch để dụ chúng ta ra ngoài."
  },
  {
    "idx": 17272,
    "start": "08:15:21,558",
    "end": "08:15:22,598",
    "start_sec": 29721.558,
    "end_sec": 29722.598,
    "zh": "没错",
    "vi": "Không sai."
  },
  {
    "idx": 17273,
    "start": "08:15:22,598",
    "end": "08:15:23,998",
    "start_sec": 29722.598,
    "end_sec": 29723.998,
    "zh": "鼠刚能出来",
    "vi": "Sở Cương có thể ra ngoài."
  },
  {
    "idx": 17274,
    "start": "08:15:23,998",
    "end": "08:15:25,198",
    "start_sec": 29723.998,
    "end_sec": 29725.198,
    "zh": "我还勉强相信",
    "vi": "Tôi còn miễn cưỡng tin được."
  },
  {
    "idx": 17275,
    "start": "08:15:25,198",
    "end": "08:15:26,758",
    "start_sec": 29725.198,
    "end_sec": 29726.758,
    "zh": "但是他妹妹能出来",
    "vi": "Nhưng em gái hắn mà cũng ra được."
  },
  {
    "idx": 17276,
    "start": "08:15:26,758",
    "end": "08:15:27,638",
    "start_sec": 29726.758,
    "end_sec": 29727.638,
    "zh": "我不太信",
    "vi": "Tôi không tin lắm."
  },
  {
    "idx": 17277,
    "start": "08:15:27,638",
    "end": "08:15:29,038",
    "start_sec": 29727.638,
    "end_sec": 29729.038,
    "zh": "我严重怀疑",
    "vi": "Tôi nghi ngờ nghiêm trọng rằng."
  },
  {
    "idx": 17278,
    "start": "08:15:29,038",
    "end": "08:15:31,058",
    "start_sec": 29729.038,
    "end_sec": 29731.058,
    "zh": "他们是机体假扮的",
    "vi": "Họ là do máy móc giả dạng."
  },
  {
    "idx": 17279,
    "start": "08:15:31,058",
    "end": "08:15:32,738",
    "start_sec": 29731.058,
    "end_sec": 29732.738,
    "zh": "那现在怎么办",
    "vi": "Vậy bây giờ phải làm sao."
  },
  {
    "idx": 17280,
    "start": "08:15:32,738",
    "end": "08:15:34,978",
    "start_sec": 29732.738,
    "end_sec": 29734.978,
    "zh": "把你手里的孩子丢出去",
    "vi": "Hãy ném đứa trẻ trong tay bạn ra ngoài."
  },
  {
    "idx": 17281,
    "start": "08:15:34,978",
    "end": "08:15:39,038",
    "start_sec": 29734.978,
    "end_sec": 29739.038,
    "zh": "这也没用",
    "vi": "Việc này cũng vô ích thôi."
  },
  {
    "idx": 17282,
    "start": "08:15:39,038",
    "end": "08:15:40,458",
    "start_sec": 29739.038,
    "end_sec": 29740.458,
    "zh": "长子皮思索着",
    "vi": "Đường Tử Bì đang suy nghĩ."
  },
  {
    "idx": 17283,
    "start": "08:15:40,458",
    "end": "08:15:41,998",
    "start_sec": 29740.458,
    "end_sec": 29741.998,
    "zh": "目光锁定有罪",
    "vi": "Ánh mắt khóa chặt vào Liễu Tuệ."
  },
  {
    "idx": 17284,
    "start": "08:15:41,998",
    "end": "08:15:42,598",
    "start_sec": 29741.998,
    "end_sec": 29742.598,
    "zh": "可惜",
    "vi": "Thật đáng tiếc."
  },
  {
    "idx": 17285,
    "start": "08:15:42,598",
    "end": "08:15:43,998",
    "start_sec": 29742.598,
    "end_sec": 29743.998,
    "zh": "你相信我吗",
    "vi": "Bạn có tin tôi không."
  },
  {
    "idx": 17286,
    "start": "08:15:43,998",
    "end": "08:15:45,018",
    "start_sec": 29743.998,
    "end_sec": 29745.018,
    "zh": "你信我的话",
    "vi": "Nếu bạn tin tôi."
  },
  {
    "idx": 17287,
    "start": "08:15:45,018",
    "end": "08:15:45,978",
    "start_sec": 29745.018,
    "end_sec": 29745.978,
    "zh": "你可以出去一趟",
    "vi": "Bạn có thể đi ra ngoài một chuyến."
  },
  {
    "idx": 17288,
    "start": "08:15:45,978",
    "end": "08:15:46,738",
    "start_sec": 29745.978,
    "end_sec": 29746.738,
    "zh": "我保证",
    "vi": "Tôi đảm bảo."
  },
  {
    "idx": 17289,
    "start": "08:15:46,738",
    "end": "08:15:47,858",
    "start_sec": 29746.738,
    "end_sec": 29747.858,
    "zh": "你会没事的",
    "vi": "Bạn sẽ không sao đâu."
  },
  {
    "idx": 17290,
    "start": "08:15:47,858",
    "end": "08:15:48,938",
    "start_sec": 29747.858,
    "end_sec": 29748.938,
    "zh": "我信你",
    "vi": "Tôi tin bạn."
  },
  {
    "idx": 17291,
    "start": "08:15:48,938",
    "end": "08:15:51,338",
    "start_sec": 29748.938,
    "end_sec": 29751.338,
    "zh": "毕竟我的命是你捞出来的",
    "vi": "Dù sao thì mạng của tôi cũng là do bạn cứu về."
  },
  {
    "idx": 17292,
    "start": "08:15:51,338",
    "end": "08:15:53,658",
    "start_sec": 29751.338,
    "end_sec": 29753.658,
    "zh": "唐子皮很是诧异",
    "vi": "Đường Tử Bì vô cùng ngạc nhiên."
  },
  {
    "idx": 17293,
    "start": "08:15:53,658",
    "end": "08:15:56,398",
    "start_sec": 29753.658,
    "end_sec": 29756.398,
    "zh": "柳穗明明知道唐子皮是在拿他做实验",
    "vi": "Liễu Tuệ rõ ràng biết Đường Tử Bì đang lấy mình ra làm thí nghiệm."
  },
  {
    "idx": 17294,
    "start": "08:15:56,398",
    "end": "08:15:58,118",
    "start_sec": 29756.398,
    "end_sec": 29758.118,
    "zh": "他还如此果断的答应",
    "vi": "Nhưng anh ta vẫn đồng ý một cách dứt khoát như vậy."
  },
  {
    "idx": 17295,
    "start": "08:15:58,118",
    "end": "08:15:59,258",
    "start_sec": 29758.118,
    "end_sec": 29759.258,
    "zh": "十米",
    "vi": "Mười mét."
  },
  {
    "idx": 17296,
    "start": "08:15:59,258",
    "end": "08:16:00,558",
    "start_sec": 29759.258,
    "end_sec": 29760.558,
    "zh": "二十米",
    "vi": "Hai mươi mét."
  },
  {
    "idx": 17297,
    "start": "08:16:00,558",
    "end": "08:16:01,098",
    "start_sec": 29760.558,
    "end_sec": 29761.098,
    "zh": "难道",
    "vi": "Chẳng lẽ."
  },
  {
    "idx": 17298,
    "start": "08:16:01,098",
    "end": "08:16:02,598",
    "start_sec": 29761.098,
    "end_sec": 29762.598,
    "zh": "真的是我多虑了",
    "vi": "Thực sự là tôi đã lo lắng quá nhiều rồi sao."
  },
  {
    "idx": 17299,
    "start": "08:16:02,598",
    "end": "08:16:03,158",
    "start_sec": 29762.598,
    "end_sec": 29763.158,
    "zh": "突然",
    "vi": "Đột nhiên."
  },
  {
    "idx": 17300,
    "start": "08:16:03,158",
    "end": "08:16:04,218",
    "start_sec": 29763.158,
    "end_sec": 29764.218,
    "zh": "柳穗肚子一顿",
    "vi": "Liễu Tuệ khựng lại."
  },
  {
    "idx": 17301,
    "start": "08:16:04,218",
    "end": "08:16:05,418",
    "start_sec": 29764.218,
    "end_sec": 29765.418,
    "zh": "改来的转过身",
    "vi": "Rồi quay người lại."
  },
  {
    "idx": 17302,
    "start": "08:16:05,418",
    "end": "08:16:07,378",
    "start_sec": 29765.418,
    "end_sec": 29767.378,
    "zh": "又朝普宁街道走过来",
    "vi": "Lại đi về phía phố Phổ Ninh."
  },
  {
    "idx": 17303,
    "start": "08:16:07,378",
    "end": "08:16:08,558",
    "start_sec": 29767.378,
    "end_sec": 29768.558,
    "zh": "喂",
    "vi": "Này."
  },
  {
    "idx": 17304,
    "start": "08:16:08,558",
    "end": "08:16:10,838",
    "start_sec": 29768.558,
    "end_sec": 29770.838,
    "zh": "你就是普宁街道的负责人吗",
    "vi": "Bạn chính là người phụ trách của phố Phổ Ninh phải không."
  },
  {
    "idx": 17305,
    "start": "08:16:10,838",
    "end": "08:16:12,678",
    "start_sec": 29770.838,
    "end_sec": 29772.678,
    "zh": "我是摩世派潜队的柳穗",
    "vi": "Tôi là Liễu Tuệ thuộc đội biệt kích Ma Thế."
  },
  {
    "idx": 17306,
    "start": "08:16:12,678",
    "end": "08:16:13,598",
    "start_sec": 29772.678,
    "end_sec": 29773.598,
    "zh": "前来调查",
    "vi": "Đến đây để điều tra."
  },
  {
    "idx": 17307,
    "start": "08:16:13,598",
    "end": "08:16:15,218",
    "start_sec": 29773.598,
    "end_sec": 29775.218,
    "zh": "你和我说说什么情况",
    "vi": "Bạn hãy nói cho tôi biết tình hình thế nào đi."
  },
  {
    "idx": 17308,
    "start": "08:16:15,218",
    "end": "08:16:16,078",
    "start_sec": 29775.218,
    "end_sec": 29776.078,
    "zh": "你",
    "vi": "Bạn."
  },
  {
    "idx": 17309,
    "start": "08:16:16,078",
    "end": "08:16:17,658",
    "start_sec": 29776.078,
    "end_sec": 29777.658,
    "zh": "你不认识我吗",
    "vi": "Bạn không nhận ra tôi sao."
  },
  {
    "idx": 17310,
    "start": "08:16:21,338",
    "end": "08:16:39,198",
    "start_sec": 29781.338,
    "end_sec": 29799.198,
    "zh": "你不记得我了",
    "vi": "Bạn không nhớ tôi nữa sao."
  },
  {
    "idx": 17311,
    "start": "08:16:39,198",
    "end": "08:16:40,578",
    "start_sec": 29799.198,
    "end_sec": 29800.578,
    "zh": "我可不记得",
    "vi": "Tôi không nhớ là mình có quen biết ngài."
  },
  {
    "idx": 17312,
    "start": "08:16:40,578",
    "end": "08:16:42,298",
    "start_sec": 29800.578,
    "end_sec": 29802.298,
    "zh": "和阁下有什么交集",
    "vi": "Tôi không nhớ là mình có quen biết ngài."
  },
  {
    "idx": 17313,
    "start": "08:16:42,298",
    "end": "08:16:44,258",
    "start_sec": 29802.298,
    "end_sec": 29804.258,
    "zh": "柳岁这时",
    "vi": "Lúc này Liễu Tuế"
  },
  {
    "idx": 17314,
    "start": "08:16:44,258",
    "end": "08:16:45,938",
    "start_sec": 29804.258,
    "end_sec": 29805.938,
    "zh": "被完全抹除了记忆",
    "vi": "bị xóa sạch ký ức."
  },
  {
    "idx": 17315,
    "start": "08:16:45,938",
    "end": "08:16:46,818",
    "start_sec": 29805.938,
    "end_sec": 29806.818,
    "zh": "让他以为",
    "vi": "Khiến anh ta nghĩ"
  },
  {
    "idx": 17316,
    "start": "08:16:46,818",
    "end": "08:16:48,698",
    "start_sec": 29806.818,
    "end_sec": 29808.698,
    "zh": "自己是第一次来执行任务",
    "vi": "mình lần đầu thực hiện nhiệm vụ."
  },
  {
    "idx": 17317,
    "start": "08:16:48,698",
    "end": "08:16:49,718",
    "start_sec": 29808.698,
    "end_sec": 29809.718,
    "zh": "记忆重置",
    "vi": "Đặt lại ký ức."
  },
  {
    "idx": 17318,
    "start": "08:16:49,718",
    "end": "08:16:51,578",
    "start_sec": 29809.718,
    "end_sec": 29811.578,
    "zh": "就算现在走出普宁街道",
    "vi": "Dù bây giờ có rời khỏi phố Phổ Ninh"
  },
  {
    "idx": 17319,
    "start": "08:16:51,578",
    "end": "08:16:53,118",
    "start_sec": 29811.578,
    "end_sec": 29813.118,
    "zh": "也会重新进来调查",
    "vi": "cũng sẽ quay lại điều tra."
  },
  {
    "idx": 17320,
    "start": "08:16:53,118",
    "end": "08:16:54,358",
    "start_sec": 29813.118,
    "end_sec": 29814.358,
    "zh": "陷入此循环",
    "vi": "Mắc kẹt trong vòng lặp này."
  },
  {
    "idx": 17321,
    "start": "08:16:54,358",
    "end": "08:16:55,378",
    "start_sec": 29814.358,
    "end_sec": 29815.378,
    "zh": "难怪",
    "vi": "Thảo nào"
  },
  {
    "idx": 17322,
    "start": "08:16:55,378",
    "end": "08:16:57,138",
    "start_sec": 29815.378,
    "end_sec": 29817.138,
    "zh": "将走不出去的普宁街道",
    "vi": "phố Phổ Ninh không thể thoát ra."
  },
  {
    "idx": 17323,
    "start": "08:16:57,138",
    "end": "08:16:58,718",
    "start_sec": 29817.138,
    "end_sec": 29818.718,
    "zh": "看着柳碎那张脸",
    "vi": "Nhìn khuôn mặt Liễu Tuế"
  },
  {
    "idx": 17324,
    "start": "08:16:58,718",
    "end": "08:17:00,898",
    "start_sec": 29818.718,
    "end_sec": 29820.898,
    "zh": "橙子皮最终选择了重开",
    "vi": "Cam Bì cuối cùng đã chọn bắt đầu lại."
  },
  {
    "idx": 17325,
    "start": "08:17:00,898",
    "end": "08:17:03,538",
    "start_sec": 29820.898,
    "end_sec": 29823.538,
    "zh": "他掏出手机和过去的自己报备完",
    "vi": "Anh ta rút điện thoại báo cáo với chính mình trong quá khứ."
  },
  {
    "idx": 17326,
    "start": "08:17:03,538",
    "end": "08:17:05,118",
    "start_sec": 29823.538,
    "end_sec": 29825.118,
    "zh": "这一片时间开始扭曲",
    "vi": "Thời gian bắt đầu bị bóp méo."
  },
  {
    "idx": 17327,
    "start": "08:17:05,118",
    "end": "08:17:07,458",
    "start_sec": 29825.118,
    "end_sec": 29827.458,
    "zh": "橙子皮",
    "vi": "Cam Bì"
  },
  {
    "idx": 17328,
    "start": "08:17:07,458",
    "end": "08:17:08,758",
    "start_sec": 29827.458,
    "end_sec": 29828.758,
    "zh": "现在我们怎么办",
    "vi": "Bây giờ chúng ta phải làm gì?"
  },
  {
    "idx": 17329,
    "start": "08:17:08,758",
    "end": "08:17:10,778",
    "start_sec": 29828.758,
    "end_sec": 29830.778,
    "zh": "橙子皮恍惚睁开眼",
    "vi": "Cam Bì mơ màng mở mắt."
  },
  {
    "idx": 17330,
    "start": "08:17:10,778",
    "end": "08:17:13,778",
    "start_sec": 29830.778,
    "end_sec": 29833.778,
    "zh": "他回溯到了柳碎离开普宁街道前",
    "vi": "Anh ta đã quay ngược thời gian về trước khi Liễu Tuế rời phố Phổ Ninh."
  },
  {
    "idx": 17331,
    "start": "08:17:13,778",
    "end": "08:17:14,858",
    "start_sec": 29833.778,
    "end_sec": 29834.858,
    "zh": "整理完资讯",
    "vi": "Sau khi sắp xếp thông tin,"
  },
  {
    "idx": 17332,
    "start": "08:17:14,858",
    "end": "08:17:17,318",
    "start_sec": 29834.858,
    "end_sec": 29837.318,
    "zh": "橙子皮心里已经有了主意",
    "vi": "Cam Bì đã có ý tưởng trong đầu."
  },
  {
    "idx": 17333,
    "start": "08:17:17,318",
    "end": "08:17:17,858",
    "start_sec": 29837.318,
    "end_sec": 29837.858,
    "zh": "嗯",
    "vi": "Ừm."
  },
  {
    "idx": 17334,
    "start": "08:17:17,858",
    "end": "08:17:18,418",
    "start_sec": 29837.858,
    "end_sec": 29838.418,
    "zh": "等等",
    "vi": "Đợi đã."
  },
  {
    "idx": 17335,
    "start": "08:17:18,418",
    "end": "08:17:19,398",
    "start_sec": 29838.418,
    "end_sec": 29839.398,
    "zh": "啊",
    "vi": "A."
  },
  {
    "idx": 17336,
    "start": "08:17:19,398",
    "end": "08:17:20,278",
    "start_sec": 29839.398,
    "end_sec": 29840.278,
    "zh": "等什么",
    "vi": "Đợi gì?"
  },
  {
    "idx": 17337,
    "start": "08:17:20,278",
    "end": "08:17:21,758",
    "start_sec": 29840.278,
    "end_sec": 29841.758,
    "zh": "陈子迪",
    "vi": "Trần Tử Địch."
  },
  {
    "idx": 17338,
    "start": "08:17:21,758",
    "end": "08:17:22,618",
    "start_sec": 29841.758,
    "end_sec": 29842.618,
    "zh": "你们也来了",
    "vi": "Các bạn cũng đến rồi."
  },
  {
    "idx": 17339,
    "start": "08:17:22,618",
    "end": "08:17:24,598",
    "start_sec": 29842.618,
    "end_sec": 29844.598,
    "zh": "这个雕塑人说",
    "vi": "Người điêu khắc này nói"
  },
  {
    "idx": 17340,
    "start": "08:17:24,598",
    "end": "08:17:25,738",
    "start_sec": 29844.598,
    "end_sec": 29845.738,
    "zh": "这里就五层",
    "vi": "ở đây chỉ có năm tầng."
  },
  {
    "idx": 17341,
    "start": "08:17:25,738",
    "end": "08:17:26,838",
    "start_sec": 29845.738,
    "end_sec": 29846.838,
    "zh": "看来是对的",
    "vi": "Có vẻ đúng rồi."
  },
  {
    "idx": 17342,
    "start": "08:17:26,838",
    "end": "08:17:27,938",
    "start_sec": 29846.838,
    "end_sec": 29847.938,
    "zh": "要不一起弄",
    "vi": "Hay là cùng làm đi."
  },
  {
    "idx": 17343,
    "start": "08:17:27,938",
    "end": "08:17:29,298",
    "start_sec": 29847.938,
    "end_sec": 29849.298,
    "zh": "我等白区一起",
    "vi": "Tôi đợi Bạch Khu đi cùng."
  },
  {
    "idx": 17344,
    "start": "08:17:29,298",
    "end": "08:17:30,418",
    "start_sec": 29849.298,
    "end_sec": 29850.418,
    "zh": "你们先走吧",
    "vi": "Các bạn đi trước đi."
  },
  {
    "idx": 17345,
    "start": "08:17:30,418",
    "end": "08:17:31,278",
    "start_sec": 29850.418,
    "end_sec": 29851.278,
    "zh": "那好",
    "vi": "Vậy được."
  },
  {
    "idx": 17346,
    "start": "08:17:31,278",
    "end": "08:17:32,478",
    "start_sec": 29851.278,
    "end_sec": 29852.478,
    "zh": "借你的人情有务",
    "vi": "Nợ ân tình của bạn."
  },
  {
    "idx": 17347,
    "start": "08:17:32,478",
    "end": "08:17:33,238",
    "start_sec": 29852.478,
    "end_sec": 29853.238,
    "zh": "来上广市",
    "vi": "Đến thành phố Thượng Quảng."
  },
  {
    "idx": 17348,
    "start": "08:17:33,238",
    "end": "08:17:33,798",
    "start_sec": 29853.238,
    "end_sec": 29853.798,
    "zh": "我还你",
    "vi": "Tôi sẽ trả lại bạn."
  },
  {
    "idx": 17349,
    "start": "08:17:33,798",
    "end": "08:17:34,918",
    "start_sec": 29853.798,
    "end_sec": 29854.918,
    "zh": "喂",
    "vi": "Alo."
  },
  {
    "idx": 17350,
    "start": "08:17:34,918",
    "end": "08:17:36,598",
    "start_sec": 29854.918,
    "end_sec": 29856.598,
    "zh": "你在出去的路上",
    "vi": "Bạn đang trên đường ra ngoài."
  },
  {
    "idx": 17351,
    "start": "08:17:36,598",
    "end": "08:17:38,258",
    "start_sec": 29856.598,
    "end_sec": 29858.258,
    "zh": "能看到什么吗",
    "vi": "Có nhìn thấy gì không."
  },
  {
    "idx": 17352,
    "start": "08:17:38,258",
    "end": "08:17:38,878",
    "start_sec": 29858.258,
    "end_sec": 29858.878,
    "zh": "看到什么",
    "vi": "Nhìn thấy gì cơ."
  },
  {
    "idx": 17353,
    "start": "08:17:38,878",
    "end": "08:17:40,018",
    "start_sec": 29858.878,
    "end_sec": 29860.018,
    "zh": "不就是",
    "vi": "Không phải là."
  },
  {
    "idx": 17354,
    "start": "08:17:40,018",
    "end": "08:17:41,198",
    "start_sec": 29860.018,
    "end_sec": 29861.198,
    "zh": "自由吗",
    "vi": "Tự do sao."
  },
  {
    "idx": 17355,
    "start": "08:17:41,198",
    "end": "08:17:42,258",
    "start_sec": 29861.198,
    "end_sec": 29862.258,
    "zh": "还有什么",
    "vi": "Còn gì nữa chứ."
  },
  {
    "idx": 17356,
    "start": "08:17:42,258",
    "end": "08:17:43,558",
    "start_sec": 29862.258,
    "end_sec": 29863.558,
    "zh": "指示牌吗",
    "vi": "Biển chỉ dẫn sao."
  },
  {
    "idx": 17357,
    "start": "08:17:43,558",
    "end": "08:17:44,758",
    "start_sec": 29863.558,
    "end_sec": 29864.758,
    "zh": "指示牌",
    "vi": "Biển chỉ dẫn."
  },
  {
    "idx": 17358,
    "start": "08:17:44,758",
    "end": "08:17:46,818",
    "start_sec": 29864.758,
    "end_sec": 29866.818,
    "zh": "摇海市第五富裕街道",
    "vi": "Phố Phú Dụ số năm thành phố Dao Hải."
  },
  {
    "idx": 17359,
    "start": "08:17:46,818",
    "end": "08:17:47,678",
    "start_sec": 29866.818,
    "end_sec": 29867.678,
    "zh": "不",
    "vi": "Không."
  },
  {
    "idx": 17360,
    "start": "08:17:47,678",
    "end": "08:17:48,718",
    "start_sec": 29867.678,
    "end_sec": 29868.718,
    "zh": "原来",
    "vi": "Hóa ra."
  },
  {
    "idx": 17361,
    "start": "08:17:48,718",
    "end": "08:17:50,018",
    "start_sec": 29868.718,
    "end_sec": 29870.018,
    "zh": "原来如此",
    "vi": "Hóa ra là vậy."
  },
  {
    "idx": 17362,
    "start": "08:17:50,018",
    "end": "08:17:52,178",
    "start_sec": 29870.018,
    "end_sec": 29872.178,
    "zh": "这里就是第五层空间",
    "vi": "Nơi này chính là không gian tầng thứ năm."
  },
  {
    "idx": 17363,
    "start": "08:17:52,178",
    "end": "08:17:53,218",
    "start_sec": 29872.178,
    "end_sec": 29873.218,
    "zh": "也就是说",
    "vi": "Nói cách khác."
  },
  {
    "idx": 17364,
    "start": "08:17:53,218",
    "end": "08:17:54,398",
    "start_sec": 29873.218,
    "end_sec": 29874.398,
    "zh": "我们从一开始",
    "vi": "Chúng ta ngay từ đầu."
  },
  {
    "idx": 17365,
    "start": "08:17:54,398",
    "end": "08:17:57,258",
    "start_sec": 29874.398,
    "end_sec": 29877.258,
    "zh": "进入的就是记忆鬼的第五空间",
    "vi": "Đã tiến vào không gian thứ năm của Quỷ Ký Ức."
  },
  {
    "idx": 17366,
    "start": "08:17:57,258",
    "end": "08:18:00,338",
    "start_sec": 29877.258,
    "end_sec": 29880.338,
    "zh": "那第六层空间又在那里呢",
    "vi": "Vậy không gian tầng thứ sáu lại ở đâu chứ."
  },
  {
    "idx": 17367,
    "start": "08:18:00,338",
    "end": "08:18:02,218",
    "start_sec": 29880.338,
    "end_sec": 29882.218,
    "zh": "橙子提心中足见明了",
    "vi": "Trong lòng Cam Tử Bì dần sáng tỏ."
  },
  {
    "idx": 17368,
    "start": "08:18:02,218",
    "end": "08:18:03,898",
    "start_sec": 29882.218,
    "end_sec": 29883.898,
    "zh": "他站在普宁街道里",
    "vi": "Anh ta đứng trên phố Phổ Ninh."
  },
  {
    "idx": 17369,
    "start": "08:18:03,898",
    "end": "08:18:07,158",
    "start_sec": 29883.898,
    "end_sec": 29887.158,
    "zh": "目光不自觉的锁定在街道不远处的那种荒野",
    "vi": "Ánh mắt vô thức khóa chặt vào vùng hoang dã không xa trên con phố."
  },
  {
    "idx": 17370,
    "start": "08:18:07,158",
    "end": "08:18:10,118",
    "start_sec": 29887.158,
    "end_sec": 29890.118,
    "zh": "橙子皮",
    "vi": "Cam Tử Bì."
  },
  {
    "idx": 17371,
    "start": "08:18:10,118",
    "end": "08:18:10,738",
    "start_sec": 29890.118,
    "end_sec": 29890.738,
    "zh": "你去哪",
    "vi": "Bạn đi đâu vậy"
  },
  {
    "idx": 17372,
    "start": "08:18:10,738",
    "end": "08:18:15,358",
    "start_sec": 29890.738,
    "end_sec": 29895.358,
    "zh": "鬼运窗",
    "vi": "Cửa quỷ"
  },
  {
    "idx": 17373,
    "start": "08:18:15,358",
    "end": "08:18:17,198",
    "start_sec": 29895.358,
    "end_sec": 29897.198,
    "zh": "无效化加持下",
    "vi": "Dưới sự vô hiệu hóa"
  },
  {
    "idx": 17374,
    "start": "08:18:17,198",
    "end": "08:18:23,398",
    "start_sec": 29897.198,
    "end_sec": 29903.398,
    "zh": "后面的植被堆置散落,荒芜空地上出现一间与鬼屋差不多的房屋,上面写着00。",
    "vi": "Thảm thực vật phía sau chất đống lộn xộn, trên khoảng đất hoang xuất hiện một ngôi nhà giống nhà ma, trên đó ghi 00."
  },
  {
    "idx": 17375,
    "start": "08:18:24,078",
    "end": "08:18:27,295",
    "start_sec": 29904.078,
    "end_sec": 29907.295,
    "zh": "果然如此,我猜的没错,不穿越前面四层空间,是不会在普宁街道看到这间屋子的。",
    "vi": "Đúng như dự đoán, tôi đoán không sai, không vượt qua bốn tầng không gian"
  },
  {
    "idx": 17375,
    "start": "08:18:27,295",
    "end": "08:18:30,298",
    "start_sec": 29907.295,
    "end_sec": 29910.298,
    "zh": "果然如此,我猜的没错,不穿越前面四层空间,是不会在普宁街道看到这间屋子的。",
    "vi": "phía trước thì sẽ không nhìn thấy ngôi nhà này trên phố Phổ Ninh."
  },
  {
    "idx": 17376,
    "start": "08:18:30,738",
    "end": "08:18:34,838",
    "start_sec": 29910.738,
    "end_sec": 29914.838,
    "zh": "这是第六层,实体,这里就是诡异源头吗?",
    "vi": "Đây là tầng sáu, thực thể, đây chính là nguồn gốc của sự kỳ dị sao."
  },
  {
    "idx": 17377,
    "start": "08:18:35,278",
    "end": "08:18:38,518",
    "start_sec": 29915.278,
    "end_sec": 29918.518,
    "zh": "没错,柳穗,你的诡异能力是什么?",
    "vi": "Đúng vậy, Liễu Tuệ, năng lực kỳ dị của bạn là gì."
  },
  {
    "idx": 17378,
    "start": "08:18:39,078",
    "end": "08:18:42,318",
    "start_sec": 29919.078,
    "end_sec": 29922.318,
    "zh": "我的能力是短暂让一个区域内的时间静止。",
    "vi": "Năng lực của tôi là tạm thời làm thời gian ngừng lại trong một khu vực."
  },
  {
    "idx": 17379,
    "start": "08:18:42,918",
    "end": "08:18:45,798",
    "start_sec": 29922.918,
    "end_sec": 29925.798,
    "zh": "时间静止?难怪你能闯过前四关。",
    "vi": "Thời gian ngừng lại. Thảo nào bạn có thể vượt qua bốn cửa ải đầu."
  },
  {
    "idx": 17380,
    "start": "08:18:47,198",
    "end": "08:18:49,958",
    "start_sec": 29927.198,
    "end_sec": 29929.958,
    "zh": "有点本事啊",
    "vi": "Có chút bản lĩnh đấy."
  },
  {
    "idx": 17381,
    "start": "08:18:49,958",
    "end": "08:18:51,158",
    "start_sec": 29929.958,
    "end_sec": 29931.158,
    "zh": "能找来这里",
    "vi": "Tìm được đến đây."
  },
  {
    "idx": 17382,
    "start": "08:18:51,158",
    "end": "08:18:53,118",
    "start_sec": 29931.158,
    "end_sec": 29933.118,
    "zh": "你没办",
    "vi": "Bạn không có cách nào."
  },
  {
    "idx": 17383,
    "start": "08:18:53,118",
    "end": "08:18:55,538",
    "start_sec": 29933.118,
    "end_sec": 29935.538,
    "zh": "我们好好谈谈",
    "vi": "Chúng ta nói chuyện cho tốt."
  },
  {
    "idx": 17384,
    "start": "08:18:55,538",
    "end": "08:18:57,398",
    "start_sec": 29935.538,
    "end_sec": 29937.398,
    "zh": "你就是记忆鬼",
    "vi": "Bạn chính là Ký Ức Quỷ."
  },
  {
    "idx": 17385,
    "start": "08:18:57,398",
    "end": "08:18:58,738",
    "start_sec": 29937.398,
    "end_sec": 29938.738,
    "zh": "对",
    "vi": "Đúng."
  },
  {
    "idx": 17386,
    "start": "08:18:58,738",
    "end": "08:19:00,598",
    "start_sec": 29938.738,
    "end_sec": 29940.598,
    "zh": "我就是记忆鬼",
    "vi": "Tôi chính là Ký Ức Quỷ."
  },
  {
    "idx": 17387,
    "start": "08:19:00,598",
    "end": "08:19:01,438",
    "start_sec": 29940.598,
    "end_sec": 29941.438,
    "zh": "小朋友",
    "vi": "Nhóc con."
  },
  {
    "idx": 17388,
    "start": "08:19:01,438",
    "end": "08:19:02,558",
    "start_sec": 29941.438,
    "end_sec": 29942.558,
    "zh": "你很厉害",
    "vi": "Bạn rất lợi hại."
  },
  {
    "idx": 17389,
    "start": "08:19:02,558",
    "end": "08:19:05,318",
    "start_sec": 29942.558,
    "end_sec": 29945.318,
    "zh": "我觉得我们可以谈一谈",
    "vi": "Tôi nghĩ chúng ta có thể nói chuyện."
  },
  {
    "idx": 17390,
    "start": "08:19:05,318",
    "end": "08:19:06,018",
    "start_sec": 29945.318,
    "end_sec": 29946.018,
    "zh": "有一后",
    "vi": "Có một lần."
  },
  {
    "idx": 17391,
    "start": "08:19:06,018",
    "end": "08:19:07,938",
    "start_sec": 29946.018,
    "end_sec": 29947.938,
    "zh": "程子皮选择进入房间",
    "vi": "Cam Tử Bì chọn vào phòng."
  },
  {
    "idx": 17392,
    "start": "08:19:07,938",
    "end": "08:19:10,858",
    "start_sec": 29947.938,
    "end_sec": 29950.858,
    "zh": "房间内是林平小区101两",
    "vi": "Trong phòng là nhà Lâm Bình 101 hai."
  },
  {
    "idx": 17393,
    "start": "08:19:10,858",
    "end": "08:19:12,898",
    "start_sec": 29950.858,
    "end_sec": 29952.898,
    "zh": "真是恶趣味",
    "vi": "Thật là ác thú vị."
  },
  {
    "idx": 17394,
    "start": "08:19:12,898",
    "end": "08:19:16,698",
    "start_sec": 29952.898,
    "end_sec": 29956.698,
    "zh": "你应该庆幸",
    "vi": "Bạn nên cảm thấy may mắn."
  },
  {
    "idx": 17395,
    "start": "08:19:16,698",
    "end": "08:19:19,438",
    "start_sec": 29956.698,
    "end_sec": 29959.438,
    "zh": "换做其他人他们的记忆",
    "vi": "Nếu là người khác thì ký ức của họ."
  },
  {
    "idx": 17396,
    "start": "08:19:19,438",
    "end": "08:19:21,378",
    "start_sec": 29959.438,
    "end_sec": 29961.378,
    "zh": "我还不稀罕用呢",
    "vi": "Tôi còn chẳng thèm dùng."
  },
  {
    "idx": 17397,
    "start": "08:19:21,378",
    "end": "08:19:22,378",
    "start_sec": 29961.378,
    "end_sec": 29962.378,
    "zh": "说吧",
    "vi": "Nói đi."
  },
  {
    "idx": 17398,
    "start": "08:19:22,378",
    "end": "08:19:23,718",
    "start_sec": 29962.378,
    "end_sec": 29963.718,
    "zh": "你想和我聊什么",
    "vi": "Bạn muốn nói chuyện gì với tôi."
  },
  {
    "idx": 17399,
    "start": "08:19:23,718",
    "end": "08:19:26,678",
    "start_sec": 29963.718,
    "end_sec": 29966.678,
    "zh": "作为第一个来到我这里面",
    "vi": "Là người đầu tiên đến chỗ tôi."
  },
  {
    "idx": 17400,
    "start": "08:19:26,678",
    "end": "08:19:29,298",
    "start_sec": 29966.678,
    "end_sec": 29969.298,
    "zh": "我给你三个选择",
    "vi": "Tôi cho bạn ba lựa chọn."
  },
  {
    "idx": 17401,
    "start": "08:19:29,298",
    "end": "08:19:31,198",
    "start_sec": 29969.298,
    "end_sec": 29971.198,
    "zh": "第一告诉我",
    "vi": "Thứ nhất, hãy nói cho ta biết."
  },
  {
    "idx": 17402,
    "start": "08:19:31,198",
    "end": "08:19:33,038",
    "start_sec": 29971.198,
    "end_sec": 29973.038,
    "zh": "中元节那天你干了什么",
    "vi": "Vào ngày Tết Trung Nguyên ngươi đã làm gì."
  },
  {
    "idx": 17403,
    "start": "08:19:33,038",
    "end": "08:19:34,558",
    "start_sec": 29973.038,
    "end_sec": 29974.558,
    "zh": "这一条记忆",
    "vi": "Ký ức đó."
  },
  {
    "idx": 17404,
    "start": "08:19:34,558",
    "end": "08:19:36,578",
    "start_sec": 29974.558,
    "end_sec": 29976.578,
    "zh": "我无论如何都捕捉不到",
    "vi": "Ta dù thế nào cũng không thể nắm bắt được."
  },
  {
    "idx": 17405,
    "start": "08:19:36,578",
    "end": "08:19:39,898",
    "start_sec": 29976.578,
    "end_sec": 29979.898,
    "zh": "你身上似乎有很奇妙的存在啊",
    "vi": "Trên người ngươi dường như có một sự tồn tại rất kỳ diệu."
  },
  {
    "idx": 17406,
    "start": "08:19:39,898",
    "end": "08:19:41,098",
    "start_sec": 29979.898,
    "end_sec": 29981.098,
    "zh": "无可奉告",
    "vi": "Không có gì để nói."
  },
  {
    "idx": 17407,
    "start": "08:19:41,098",
    "end": "08:19:43,858",
    "start_sec": 29981.098,
    "end_sec": 29983.858,
    "zh": "只要你告诉我你干了什么",
    "vi": "Chỉ cần ngươi nói cho ta biết ngươi đã làm gì."
  },
  {
    "idx": 17408,
    "start": "08:19:43,858",
    "end": "08:19:45,578",
    "start_sec": 29983.858,
    "end_sec": 29985.578,
    "zh": "我可以勉为其来",
    "vi": "Ta có thể miễn cưỡng."
  },
  {
    "idx": 17409,
    "start": "08:19:45,578",
    "end": "08:19:47,898",
    "start_sec": 29985.578,
    "end_sec": 29987.898,
    "zh": "让你驾驭我的一个分身",
    "vi": "Cho ngươi điều khiển một phân thân của ta."
  },
  {
    "idx": 17410,
    "start": "08:19:47,898",
    "end": "08:19:48,938",
    "start_sec": 29987.898,
    "end_sec": 29988.938,
    "zh": "如何",
    "vi": "Thế nào."
  },
  {
    "idx": 17411,
    "start": "08:19:48,938",
    "end": "08:19:50,938",
    "start_sec": 29988.938,
    "end_sec": 29990.938,
    "zh": "哪怕是我的分身",
    "vi": "Cho dù chỉ là phân thân của ta."
  },
  {
    "idx": 17412,
    "start": "08:19:50,938",
    "end": "08:19:52,298",
    "start_sec": 29990.938,
    "end_sec": 29992.298,
    "zh": "能让人失去记忆",
    "vi": "Cũng có thể khiến người khác mất đi ký ức."
  },
  {
    "idx": 17413,
    "start": "08:19:52,298",
    "end": "08:19:53,398",
    "start_sec": 29992.298,
    "end_sec": 29993.398,
    "zh": "也很强势",
    "vi": "Vô cùng mạnh mẽ."
  },
  {
    "idx": 17414,
    "start": "08:19:53,398",
    "end": "08:19:55,418",
    "start_sec": 29993.398,
    "end_sec": 29995.418,
    "zh": "我能联系过去这个秘密",
    "vi": "Bí mật ta có thể liên lạc với quá khứ."
  },
  {
    "idx": 17415,
    "start": "08:19:55,418",
    "end": "08:19:56,878",
    "start_sec": 29995.418,
    "end_sec": 29996.878,
    "zh": "绝不能让别人知道",
    "vi": "Tuyệt đối không thể để kẻ khác biết."
  },
  {
    "idx": 17416,
    "start": "08:19:56,878",
    "end": "08:19:57,898",
    "start_sec": 29996.878,
    "end_sec": 29997.898,
    "zh": "不行",
    "vi": "Không được."
  },
  {
    "idx": 17417,
    "start": "08:19:57,898",
    "end": "08:19:58,738",
    "start_sec": 29997.898,
    "end_sec": 29998.738,
    "zh": "下一个",
    "vi": "Điều tiếp theo đi."
  },
  {
    "idx": 17418,
    "start": "08:20:00,000",
    "end": "08:20:04,672",
    "start_sec": 30000.0,
    "end_sec": 30004.672,
    "zh": "好吧,第二我放你和你的伙伴们走,你甚至也可以驾驭我的一个分身,但是你要定期送一百个人来普宁街道。",
    "vi": "Được rồi, thứ hai là ta thả ngươi và các bạn của ngươi đi, ngươi thậm chí cũng có thể điều"
  },
  {
    "idx": 17418,
    "start": "08:20:04,672",
    "end": "08:20:08,900",
    "start_sec": 30004.672,
    "end_sec": 30008.9,
    "zh": "好吧,第二我放你和你的伙伴们走,你甚至也可以驾驭我的一个分身,但是你要定期送一百个人来普宁街道。",
    "vi": "khiển một phân thân của ta, nhưng ngươi phải định kỳ gửi một trăm người đến phố Phổ Ninh."
  },
  {
    "idx": 17419,
    "start": "08:20:09,460",
    "end": "08:20:13,787",
    "start_sec": 30009.46,
    "end_sec": 30013.787,
    "zh": "定期送一百人给你吃,倒是和当初老庙住洋鬼树有一曲同工之处,但是忽有一百个人来普宁街道,我先麻烦。",
    "vi": "Định kỳ gửi một trăm người cho ngươi ăn, quả thực có điểm tương đồng với cây quỷ ngoại quốc ở ngôi"
  },
  {
    "idx": 17419,
    "start": "08:20:13,787",
    "end": "08:20:17,720",
    "start_sec": 30013.787,
    "end_sec": 30017.72,
    "zh": "定期送一百人给你吃,倒是和当初老庙住洋鬼树有一曲同工之处,但是忽有一百个人来普宁街道,我先麻烦。",
    "vi": "miếu cổ năm xưa, nhưng dụ dỗ một trăm người đến phố Phổ Ninh thì ta thấy phiền phức lắm."
  },
  {
    "idx": 17420,
    "start": "08:20:18,060",
    "end": "08:20:18,420",
    "start_sec": 30018.06,
    "end_sec": 30018.42,
    "zh": "下一个。",
    "vi": "Điều tiếp theo đi."
  },
  {
    "idx": 17421,
    "start": "08:20:20,140",
    "end": "08:20:26,540",
    "start_sec": 30020.14,
    "end_sec": 30026.54,
    "zh": "你还真是见久不知,吃法久,既然如此你们就也留下来吧。",
    "vi": "Ngươi đúng là rượu mời không uống lại muốn uống rượu phạt, đã vậy thì các ngươi cũng ở lại đây luôn đi."
  },
  {
    "idx": 17422,
    "start": "08:20:27,140",
    "end": "08:20:27,560",
    "start_sec": 30027.14,
    "end_sec": 30027.56,
    "zh": "六岁。",
    "vi": "Liễu Thúy."
  },
  {
    "idx": 17423,
    "start": "08:20:28,440",
    "end": "08:20:28,840",
    "start_sec": 30028.44,
    "end_sec": 30028.84,
    "zh": "明白。",
    "vi": "Rõ rồi."
  },
  {
    "idx": 17424,
    "start": "08:20:30,000",
    "end": "08:20:31,140",
    "start_sec": 30030.0,
    "end_sec": 30031.14,
    "zh": "时间定值",
    "vi": "Thời gian ngưng đọng."
  },
  {
    "idx": 17425,
    "start": "08:20:31,140",
    "end": "08:20:32,740",
    "start_sec": 30031.14,
    "end_sec": 30032.74,
    "zh": "静止灵一下",
    "vi": "Ngưng đọng trong chốc lát."
  },
  {
    "idx": 17426,
    "start": "08:20:32,740",
    "end": "08:20:34,160",
    "start_sec": 30032.74,
    "end_sec": 30034.16,
    "zh": "只有柳翠能活动",
    "vi": "Chỉ có Liễu Thúy là có thể cử động."
  },
  {
    "idx": 17427,
    "start": "08:20:34,160",
    "end": "08:20:35,320",
    "start_sec": 30034.16,
    "end_sec": 30035.32,
    "zh": "东北啊",
    "vi": "Không đúng chứ."
  },
  {
    "idx": 17428,
    "start": "08:20:35,320",
    "end": "08:20:37,600",
    "start_sec": 30035.32,
    "end_sec": 30037.6,
    "zh": "但是为什么时间定值下",
    "vi": "Nhưng tại sao dưới trạng thái thời gian ngưng đọng."
  },
  {
    "idx": 17429,
    "start": "08:20:37,600",
    "end": "08:20:38,500",
    "start_sec": 30037.6,
    "end_sec": 30038.5,
    "zh": "我却能自拷",
    "vi": "Ta lại có thể suy nghĩ."
  },
  {
    "idx": 17430,
    "start": "08:20:38,500",
    "end": "08:20:41,040",
    "start_sec": 30038.5,
    "end_sec": 30041.04,
    "zh": "这时柳翠取出一把软刀",
    "vi": "Lúc này Liễu Thúy rút ra một thanh nhuyễn đao."
  },
  {
    "idx": 17431,
    "start": "08:20:41,040",
    "end": "08:20:42,640",
    "start_sec": 30041.04,
    "end_sec": 30042.64,
    "zh": "然而她没走向记忆鬼",
    "vi": "Thế nhưng cô ấy không đi về phía Ký Ức Quỷ."
  },
  {
    "idx": 17432,
    "start": "08:20:42,640",
    "end": "08:20:44,340",
    "start_sec": 30042.64,
    "end_sec": 30044.34,
    "zh": "而是来到橙子皮身前",
    "vi": "Mà đi đến trước mặt Trần Tử Bì."
  },
  {
    "idx": 17433,
    "start": "08:20:44,340",
    "end": "08:20:45,900",
    "start_sec": 30044.34,
    "end_sec": 30045.9,
    "zh": "我想啊",
    "vi": "Tôi nghĩ là"
  },
  {
    "idx": 17434,
    "start": "08:20:45,900",
    "end": "08:20:47,660",
    "start_sec": 30045.9,
    "end_sec": 30047.66,
    "zh": "柳翠这是被记忆鬼控制了",
    "vi": "Liễu Thúy đã bị Ký Ức Quỷ khống chế rồi."
  },
  {
    "idx": 17435,
    "start": "08:20:47,660",
    "end": "08:20:50,040",
    "start_sec": 30047.66,
    "end_sec": 30050.04,
    "zh": "记忆鬼什么时候给她穿买的记忆",
    "vi": "Ký Ức Quỷ đã cấy ký ức giả vào đầu cô ấy từ lúc nào thế."
  },
  {
    "idx": 17436,
    "start": "08:20:50,040",
    "end": "08:20:52,440",
    "start_sec": 30050.04,
    "end_sec": 30052.44,
    "zh": "该死还是没有胜算吗",
    "vi": "Chết tiệt, vẫn không có cơ hội thắng sao."
  },
  {
    "idx": 17437,
    "start": "08:20:52,440",
    "end": "08:20:55,060",
    "start_sec": 30052.44,
    "end_sec": 30055.06,
    "zh": "橙子皮只能眼睁睁看着软刀",
    "vi": "Trần Tử Bì chỉ có thể trơ mắt nhìn thanh nhuyễn đao"
  },
  {
    "idx": 17438,
    "start": "08:20:55,060",
    "end": "08:20:56,480",
    "start_sec": 30055.06,
    "end_sec": 30056.48,
    "zh": "向自己喉咙刺来",
    "vi": "đâm về phía cổ họng mình."
  },
  {
    "idx": 17439,
    "start": "08:20:56,480",
    "end": "08:20:58,120",
    "start_sec": 30056.48,
    "end_sec": 30058.12,
    "zh": "突然她惊奇的发现",
    "vi": "Đột nhiên cô kinh ngạc phát hiện"
  },
  {
    "idx": 17440,
    "start": "08:20:58,120",
    "end": "08:21:00,200",
    "start_sec": 30058.12,
    "end_sec": 30060.2,
    "zh": "自己的手指怎么就不还能活动",
    "vi": "ngón tay của mình tại sao vẫn có thể cử động được."
  },
  {
    "idx": 17441,
    "start": "08:21:00,200",
    "end": "08:21:02,600",
    "start_sec": 30060.2,
    "end_sec": 30062.6,
    "zh": "鬼面窗",
    "vi": "Quỷ Diện Song."
  },
  {
    "idx": 17442,
    "start": "08:21:02,600",
    "end": "08:21:07,600",
    "start_sec": 30062.6,
    "end_sec": 30067.6,
    "zh": "主人抱歉",
    "vi": "Chủ nhân, xin lỗi."
  },
  {
    "idx": 17443,
    "start": "08:21:07,600",
    "end": "08:21:09,060",
    "start_sec": 30067.6,
    "end_sec": 30069.06,
    "zh": "行动失败了",
    "vi": "Hành động thất bại rồi."
  },
  {
    "idx": 17444,
    "start": "08:21:09,060",
    "end": "08:21:10,900",
    "start_sec": 30069.06,
    "end_sec": 30070.9,
    "zh": "我猜也是",
    "vi": "Ta cũng đoán thế."
  },
  {
    "idx": 17445,
    "start": "08:21:10,900",
    "end": "08:21:12,420",
    "start_sec": 30070.9,
    "end_sec": 30072.42,
    "zh": "真抱歉呀",
    "vi": "Thật xin lỗi nhé."
  },
  {
    "idx": 17446,
    "start": "08:21:12,420",
    "end": "08:21:13,720",
    "start_sec": 30072.42,
    "end_sec": 30073.72,
    "zh": "那身上到底有什么",
    "vi": "Trên người hắn rốt cuộc có cái gì."
  },
  {
    "idx": 17447,
    "start": "08:21:13,720",
    "end": "08:21:16,360",
    "start_sec": 30073.72,
    "end_sec": 30076.36,
    "zh": "为什么能履行化解威力",
    "vi": "Tại sao có thể liên tục hóa giải uy lực như vậy."
  },
  {
    "idx": 17448,
    "start": "08:21:28,120",
    "end": "08:21:41,580",
    "start_sec": 30088.12,
    "end_sec": 30101.58,
    "zh": "继回隐匿在角落里",
    "vi": "Ký Ức Quỷ ẩn nấp trong góc tối."
  },
  {
    "idx": 17449,
    "start": "08:21:41,580",
    "end": "08:21:42,760",
    "start_sec": 30101.58,
    "end_sec": 30102.76,
    "zh": "他阉冷的笑着",
    "vi": "Hắn cười lạnh lùng."
  },
  {
    "idx": 17450,
    "start": "08:21:42,760",
    "end": "08:21:43,660",
    "start_sec": 30102.76,
    "end_sec": 30103.66,
    "zh": "拿了个响指",
    "vi": "rồi búng tay một cái."
  },
  {
    "idx": 17451,
    "start": "08:21:43,660",
    "end": "08:21:44,380",
    "start_sec": 30103.66,
    "end_sec": 30104.38,
    "zh": "一时间",
    "vi": "Ngay lập tức"
  },
  {
    "idx": 17452,
    "start": "08:21:44,380",
    "end": "08:21:46,280",
    "start_sec": 30104.38,
    "end_sec": 30106.28,
    "zh": "橙子皮脑袋混沌起来",
    "vi": "đầu óc Trần Tử Bì trở nên mơ hồ."
  },
  {
    "idx": 17453,
    "start": "08:21:46,280",
    "end": "08:21:47,240",
    "start_sec": 30106.28,
    "end_sec": 30107.24,
    "zh": "双眼无神",
    "vi": "Ánh mắt đờ đẫn."
  },
  {
    "idx": 17454,
    "start": "08:21:47,240",
    "end": "08:21:48,820",
    "start_sec": 30107.24,
    "end_sec": 30108.82,
    "zh": "告诉我",
    "vi": "Nói cho ta biết."
  },
  {
    "idx": 17455,
    "start": "08:21:48,820",
    "end": "08:21:49,700",
    "start_sec": 30108.82,
    "end_sec": 30109.7,
    "zh": "你在中元节",
    "vi": "Vào ngày Tết Trung Nguyên"
  },
  {
    "idx": 17456,
    "start": "08:21:49,700",
    "end": "08:21:50,720",
    "start_sec": 30109.7,
    "end_sec": 30110.72,
    "zh": "到底干了什么",
    "vi": "ngươi rốt cuộc đã làm gì."
  },
  {
    "idx": 17457,
    "start": "08:21:50,720",
    "end": "08:21:52,040",
    "start_sec": 30110.72,
    "end_sec": 30112.04,
    "zh": "中元节",
    "vi": "Tết Trung Nguyên."
  },
  {
    "idx": 17458,
    "start": "08:21:52,040",
    "end": "08:21:52,760",
    "start_sec": 30112.04,
    "end_sec": 30112.76,
    "zh": "我",
    "vi": "Tôi"
  },
  {
    "idx": 17459,
    "start": "08:21:52,760",
    "end": "08:21:53,880",
    "start_sec": 30112.76,
    "end_sec": 30113.88,
    "zh": "我",
    "vi": "Tôi"
  },
  {
    "idx": 17460,
    "start": "08:21:53,880",
    "end": "08:21:55,020",
    "start_sec": 30113.88,
    "end_sec": 30115.02,
    "zh": "这时",
    "vi": "Lúc này"
  },
  {
    "idx": 17461,
    "start": "08:21:55,020",
    "end": "08:21:56,440",
    "start_sec": 30115.02,
    "end_sec": 30116.44,
    "zh": "橙子皮脑海里",
    "vi": "Trong đầu Trần Tử Bì"
  },
  {
    "idx": 17462,
    "start": "08:21:56,440",
    "end": "08:21:58,160",
    "start_sec": 30116.44,
    "end_sec": 30118.16,
    "zh": "突然响起一道消息提示音",
    "vi": "bỗng vang lên một tiếng chuông báo tin nhắn"
  },
  {
    "idx": 17463,
    "start": "08:21:58,160",
    "end": "08:22:00,840",
    "start_sec": 30118.16,
    "end_sec": 30120.84,
    "zh": "脑子里显现出一个消息对话框",
    "vi": "Trong đầu hiện ra một khung chat tin nhắn"
  },
  {
    "idx": 17464,
    "start": "08:22:00,840",
    "end": "08:22:01,320",
    "start_sec": 30120.84,
    "end_sec": 30121.32,
    "zh": "喂",
    "vi": "Này"
  },
  {
    "idx": 17465,
    "start": "08:22:01,320",
    "end": "08:22:03,280",
    "start_sec": 30121.32,
    "end_sec": 30123.28,
    "zh": "你现在到底怎么样了",
    "vi": "Ngươi hiện tại rốt cuộc thế nào rồi"
  },
  {
    "idx": 17466,
    "start": "08:22:03,280",
    "end": "08:22:05,780",
    "start_sec": 30123.28,
    "end_sec": 30125.78,
    "zh": "我已经找到遇鬼者037了",
    "vi": "Ta đã tìm thấy người gặp quỷ 037 rồi"
  },
  {
    "idx": 17467,
    "start": "08:22:05,780",
    "end": "08:22:06,520",
    "start_sec": 30125.78,
    "end_sec": 30126.52,
    "zh": "你呢",
    "vi": "Còn ngươi"
  },
  {
    "idx": 17468,
    "start": "08:22:06,520",
    "end": "08:22:08,420",
    "start_sec": 30126.52,
    "end_sec": 30128.42,
    "zh": "是不是又忘记了什么",
    "vi": "Có phải lại quên mất chuyện gì rồi không"
  },
  {
    "idx": 17469,
    "start": "08:22:08,420",
    "end": "08:22:10,840",
    "start_sec": 30128.42,
    "end_sec": 30130.84,
    "zh": "忘记了就看聊天记录",
    "vi": "Quên rồi thì xem lịch sử trò chuyện đi"
  },
  {
    "idx": 17470,
    "start": "08:22:10,840",
    "end": "08:22:12,760",
    "start_sec": 30130.84,
    "end_sec": 30132.76,
    "zh": "聊天记录",
    "vi": "Lịch sử trò chuyện"
  },
  {
    "idx": 17471,
    "start": "08:22:12,760",
    "end": "08:22:14,960",
    "start_sec": 30132.76,
    "end_sec": 30134.96,
    "zh": "当看着聊天记录",
    "vi": "Khi nhìn vào lịch sử trò chuyện"
  },
  {
    "idx": 17472,
    "start": "08:22:14,960",
    "end": "08:22:17,020",
    "start_sec": 30134.96,
    "end_sec": 30137.02,
    "zh": "橙子皮的记忆在一点点恢复",
    "vi": "ký ức của Trần Tử Bì đang dần hồi phục"
  },
  {
    "idx": 17473,
    "start": "08:22:17,020",
    "end": "08:22:18,740",
    "start_sec": 30137.02,
    "end_sec": 30138.74,
    "zh": "我是橙子皮",
    "vi": "Tôi là Trần Tử Bì"
  },
  {
    "idx": 17474,
    "start": "08:22:18,740",
    "end": "08:22:21,600",
    "start_sec": 30138.74,
    "end_sec": 30141.6,
    "zh": "我正在找记忆鬼的第七层空间",
    "vi": "Tôi đang tìm kiếm không gian tầng thứ bảy của Quỷ Ký Ức"
  },
  {
    "idx": 17475,
    "start": "08:22:21,600",
    "end": "08:22:24,080",
    "start_sec": 30141.6,
    "end_sec": 30144.08,
    "zh": "记忆鬼还在橙子皮脑海里",
    "vi": "Quỷ Ký Ức vẫn ở trong đầu Trần Tử Bì"
  },
  {
    "idx": 17476,
    "start": "08:22:24,080",
    "end": "08:22:25,080",
    "start_sec": 30144.08,
    "end_sec": 30145.08,
    "zh": "探查他的记忆",
    "vi": "dò xét ký ức của hắn"
  },
  {
    "idx": 17477,
    "start": "08:22:25,080",
    "end": "08:22:26,720",
    "start_sec": 30145.08,
    "end_sec": 30146.72,
    "zh": "奇怪啊",
    "vi": "Lạ thật"
  },
  {
    "idx": 17478,
    "start": "08:22:26,720",
    "end": "08:22:28,860",
    "start_sec": 30146.72,
    "end_sec": 30148.86,
    "zh": "你的记忆到底被藏哪去了",
    "vi": "Ký ức của ngươi rốt cuộc bị giấu ở đâu rồi"
  },
  {
    "idx": 17479,
    "start": "08:22:28,860",
    "end": "08:22:31,100",
    "start_sec": 30148.86,
    "end_sec": 30151.1,
    "zh": "难不成还能凑到别的世界",
    "vi": "Chẳng lẽ còn có thể lạc sang thế giới khác"
  },
  {
    "idx": 17480,
    "start": "08:22:31,100",
    "end": "08:22:33,620",
    "start_sec": 30151.1,
    "end_sec": 30153.62,
    "zh": "或者说凑到别的时间里了",
    "vi": "Hoặc là lạc sang khoảng thời gian khác rồi"
  },
  {
    "idx": 17481,
    "start": "08:22:33,620",
    "end": "08:22:36,320",
    "start_sec": 30153.62,
    "end_sec": 30156.32,
    "zh": "鬼面铛",
    "vi": "Quỷ Diện Đang"
  },
  {
    "idx": 17482,
    "start": "08:22:36,320",
    "end": "08:22:37,660",
    "start_sec": 30156.32,
    "end_sec": 30157.66,
    "zh": "是吧",
    "vi": "Phải không"
  },
  {
    "idx": 17483,
    "start": "08:22:37,660",
    "end": "08:22:39,500",
    "start_sec": 30157.66,
    "end_sec": 30159.5,
    "zh": "你不是被我抹出记忆了吗",
    "vi": "Không phải ngươi đã bị ta xóa bỏ ký ức rồi sao"
  },
  {
    "idx": 17484,
    "start": "08:22:39,500",
    "end": "08:22:39,900",
    "start_sec": 30159.5,
    "end_sec": 30159.9,
    "zh": "为什么",
    "vi": "Tại sao"
  },
  {
    "idx": 17485,
    "start": "08:22:39,900",
    "end": "08:22:41,260",
    "start_sec": 30159.9,
    "end_sec": 30161.26,
    "zh": "为什么还能行动",
    "vi": "Tại sao vẫn có thể hành động"
  },
  {
    "idx": 17486,
    "start": "08:22:41,260",
    "end": "08:22:42,700",
    "start_sec": 30161.26,
    "end_sec": 30162.7,
    "zh": "不过无所谓了",
    "vi": "Nhưng không sao cả"
  },
  {
    "idx": 17487,
    "start": "08:22:42,700",
    "end": "08:22:44,040",
    "start_sec": 30162.7,
    "end_sec": 30164.04,
    "zh": "你还会失去记忆的",
    "vi": "Ngươi sẽ lại mất đi ký ức thôi"
  },
  {
    "idx": 17488,
    "start": "08:22:44,040",
    "end": "08:22:45,160",
    "start_sec": 30164.04,
    "end_sec": 30165.16,
    "zh": "无效化",
    "vi": "Vô hiệu hóa"
  },
  {
    "idx": 17489,
    "start": "08:22:45,160",
    "end": "08:22:47,660",
    "start_sec": 30165.16,
    "end_sec": 30167.66,
    "zh": "该死你小子",
    "vi": "Đáng chết, tên nhóc ngươi"
  },
  {
    "idx": 17490,
    "start": "08:22:47,660",
    "end": "08:22:48,880",
    "start_sec": 30167.66,
    "end_sec": 30168.88,
    "zh": "到底是什么怪物",
    "vi": "rốt cuộc là quái vật gì thế"
  },
  {
    "idx": 17491,
    "start": "08:22:48,880",
    "end": "08:22:50,040",
    "start_sec": 30168.88,
    "end_sec": 30170.04,
    "zh": "鬼面铛",
    "vi": "Chuông mặt quỷ"
  },
  {
    "idx": 17492,
    "start": "08:22:50,040",
    "end": "08:22:50,860",
    "start_sec": 30170.04,
    "end_sec": 30170.86,
    "zh": "震慑",
    "vi": "Áp chế"
  },
  {
    "idx": 17493,
    "start": "08:22:50,860",
    "end": "08:22:51,660",
    "start_sec": 30170.86,
    "end_sec": 30171.66,
    "zh": "鬼口",
    "vi": "Miệng quỷ"
  },
  {
    "idx": 17494,
    "start": "08:22:51,660",
    "end": "08:22:53,160",
    "start_sec": 30171.66,
    "end_sec": 30173.16,
    "zh": "震慑是吧",
    "vi": "Áp chế sao"
  },
  {
    "idx": 17495,
    "start": "08:22:53,160",
    "end": "08:22:55,720",
    "start_sec": 30173.16,
    "end_sec": 30175.72,
    "zh": "一股强大的压力凌驾这帮士兵",
    "vi": "Một luồng áp lực mạnh mẽ đè nặng lên đám binh lính này"
  },
  {
    "idx": 17496,
    "start": "08:22:55,720",
    "end": "08:22:57,640",
    "start_sec": 30175.72,
    "end_sec": 30177.64,
    "zh": "刘瑟被吓得瘫倒在地",
    "vi": "Lưu Sắt bị dọa đến mức ngã quỵ xuống đất"
  },
  {
    "idx": 17497,
    "start": "08:22:57,640",
    "end": "08:22:59,080",
    "start_sec": 30177.64,
    "end_sec": 30179.08,
    "zh": "寄鬼浑身站起",
    "vi": "Ký Quỷ đứng bật dậy"
  },
  {
    "idx": 17498,
    "start": "08:22:59,080",
    "end": "08:22:59,840",
    "start_sec": 30179.08,
    "end_sec": 30179.84,
    "zh": "无法吸收",
    "vi": "Không thể hấp thu"
  },
  {
    "idx": 17499,
    "start": "08:22:59,840",
    "end": "08:23:01,840",
    "start_sec": 30179.84,
    "end_sec": 30181.84,
    "zh": "无数记忆颗粒沙沙落下",
    "vi": "Vô số hạt ký ức rơi xuống rào rào"
  },
  {
    "idx": 17500,
    "start": "08:23:01,840",
    "end": "08:23:03,260",
    "start_sec": 30181.84,
    "end_sec": 30183.26,
    "zh": "寄鬼仍想挣扎",
    "vi": "Ký Quỷ vẫn muốn giãy giụa"
  },
  {
    "idx": 17501,
    "start": "08:23:03,260",
    "end": "08:23:05,120",
    "start_sec": 30183.26,
    "end_sec": 30185.12,
    "zh": "你也就这点手段了吧",
    "vi": "Ngươi cũng chỉ có bấy nhiêu bản lĩnh thôi sao"
  },
  {
    "idx": 17502,
    "start": "08:23:05,120",
    "end": "08:23:06,600",
    "start_sec": 30185.12,
    "end_sec": 30186.6,
    "zh": "在第三层空间",
    "vi": "Tại không gian tầng thứ ba"
  },
  {
    "idx": 17503,
    "start": "08:23:06,600",
    "end": "08:23:08,440",
    "start_sec": 30186.6,
    "end_sec": 30188.44,
    "zh": "程子平遇见未来的自己",
    "vi": "Trình Tử Bình gặp được chính mình trong tương lai"
  },
  {
    "idx": 17504,
    "start": "08:23:08,440",
    "end": "08:23:09,580",
    "start_sec": 30188.44,
    "end_sec": 30189.58,
    "zh": "他深受启发",
    "vi": "Anh ấy được truyền cảm hứng lớn"
  },
  {
    "idx": 17505,
    "start": "08:23:09,580",
    "end": "08:23:11,780",
    "start_sec": 30189.58,
    "end_sec": 30191.78,
    "zh": "竟然开始尝试释放更多鬼口",
    "vi": "Cậu ấy bắt đầu thử giải phóng thêm nhiều miệng quỷ"
  },
  {
    "idx": 17506,
    "start": "08:23:11,780",
    "end": "08:23:14,340",
    "start_sec": 30191.78,
    "end_sec": 30194.34,
    "zh": "随即又是三张鬼魂炸开",
    "vi": "Ngay sau đó lại có ba hồn ma nổ tung"
  },
  {
    "idx": 17507,
    "start": "08:23:14,340",
    "end": "08:23:16,140",
    "start_sec": 30194.34,
    "end_sec": 30196.14,
    "zh": "寄鬼被咬得浑身溃烂",
    "vi": "Ký Quỷ bị cắn đến mức toàn thân thối rữa"
  },
  {
    "idx": 17508,
    "start": "08:23:16,140",
    "end": "08:23:17,740",
    "start_sec": 30196.14,
    "end_sec": 30197.74,
    "zh": "开心啊",
    "vi": "Vui vẻ chứ"
  },
  {
    "idx": 17509,
    "start": "08:23:17,740",
    "end": "08:23:18,700",
    "start_sec": 30197.74,
    "end_sec": 30198.7,
    "zh": "你想杀我",
    "vi": "Ngươi muốn giết ta sao"
  },
  {
    "idx": 17510,
    "start": "08:23:18,700",
    "end": "08:23:19,940",
    "start_sec": 30198.7,
    "end_sec": 30199.94,
    "zh": "别以为你有无效果",
    "vi": "Đừng tưởng ngươi có khả năng vô hiệu hóa"
  },
  {
    "idx": 17511,
    "start": "08:23:19,940",
    "end": "08:23:20,620",
    "start_sec": 30199.94,
    "end_sec": 30200.62,
    "zh": "我就怕你",
    "vi": "Thì ta sẽ sợ ngươi"
  },
  {
    "idx": 17512,
    "start": "08:23:20,620",
    "end": "08:23:22,120",
    "start_sec": 30200.62,
    "end_sec": 30202.12,
    "zh": "你觉得我这群玉鬼者吗",
    "vi": "Ngươi nghĩ đám ngự quỷ giả này của ta thế nào"
  },
  {
    "idx": 17513,
    "start": "08:23:22,120",
    "end": "08:23:24,620",
    "start_sec": 30202.12,
    "end_sec": 30204.62,
    "zh": "还是楚康,楚康,对,都给我上。",
    "vi": "Hay là Sở Khang, Sở Khang, đúng thế, tất cả lên cho ta"
  },
  {
    "idx": 17514,
    "start": "08:23:25,280",
    "end": "08:23:29,282",
    "start_sec": 30205.28,
    "end_sec": 30209.282,
    "zh": "我操,倒是忘了这茬,只要还在普宁街道,记忆鬼能抹除篡改记忆,这次同行的几人反倒成了他的帮手了。",
    "vi": "Chết tiệt, mình quên mất chuyện này, chỉ cần còn ở phố Phổ Ninh, Quỷ Ký Ức có thể xóa bỏ và"
  },
  {
    "idx": 17514,
    "start": "08:23:29,282",
    "end": "08:23:32,920",
    "start_sec": 30209.282,
    "end_sec": 30212.92,
    "zh": "我操,倒是忘了这茬,只要还在普宁街道,记忆鬼能抹除篡改记忆,这次同行的几人反倒成了他的帮手了。",
    "vi": "sửa đổi ký ức, mấy người đi cùng lần này ngược lại đã trở thành trợ thủ của nó rồi"
  },
  {
    "idx": 17515,
    "start": "08:23:33,460",
    "end": "08:23:38,820",
    "start_sec": 30213.46,
    "end_sec": 30218.82,
    "zh": "这时,地面开裂,楚方把鬼面窗对记忆鬼造成的伤害压制到地面上。",
    "vi": "Lúc này, mặt đất nứt ra, Sở Phương đè nén sát thương do Chuông Mặt Quỷ gây ra cho Quỷ Ký Ức xuống mặt đất"
  },
  {
    "idx": 17516,
    "start": "08:23:39,380",
    "end": "08:23:43,580",
    "start_sec": 30219.38,
    "end_sec": 30223.58,
    "zh": "鬼面窗,扩大无效化领域,黑云鬼域。",
    "vi": "Chuông Mặt Quỷ, mở rộng lĩnh vực vô hiệu hóa, Hắc Vân Quỷ Vực"
  },
  {
    "idx": 17517,
    "start": "08:23:43,580",
    "end": "08:23:47,700",
    "start_sec": 30223.58,
    "end_sec": 30227.7,
    "zh": "刘志尚要动用时间进步",
    "vi": "Lưu Chí Thượng muốn sử dụng bước nhảy thời gian"
  },
  {
    "idx": 17518,
    "start": "08:23:47,700",
    "end": "08:23:49,180",
    "start_sec": 30227.7,
    "end_sec": 30229.18,
    "zh": "但在无效化面前",
    "vi": "Nhưng trước khả năng vô hiệu hóa"
  },
  {
    "idx": 17519,
    "start": "08:23:49,180",
    "end": "08:23:51,420",
    "start_sec": 30229.18,
    "end_sec": 30231.42,
    "zh": "他的诡异能力起不到任何作用",
    "vi": "Năng lực quỷ dị của anh ta không thể phát huy bất kỳ tác dụng nào"
  },
  {
    "idx": 17520,
    "start": "08:23:51,420",
    "end": "08:23:52,800",
    "start_sec": 30231.42,
    "end_sec": 30232.8,
    "zh": "我倒要看看",
    "vi": "Ta muốn xem thử"
  },
  {
    "idx": 17521,
    "start": "08:23:52,800",
    "end": "08:23:54,400",
    "start_sec": 30232.8,
    "end_sec": 30234.4,
    "zh": "你还能叫来多少帮手",
    "vi": "Ngươi còn có thể gọi thêm bao nhiêu trợ thủ nữa."
  },
  {
    "idx": 17522,
    "start": "08:23:54,400",
    "end": "08:23:57,640",
    "start_sec": 30234.4,
    "end_sec": 30237.64,
    "zh": "玉洁黑线从橙子皮深舟炸住",
    "vi": "Những sợi chỉ đen của Ngọc Khiết bộc phát từ cơ thể Trình Tử Đề."
  },
  {
    "idx": 17523,
    "start": "08:23:57,640",
    "end": "08:23:58,920",
    "start_sec": 30237.64,
    "end_sec": 30238.92,
    "zh": "他一人成军",
    "vi": "Một mình hắn tựa như cả một đội quân."
  },
  {
    "idx": 17524,
    "start": "08:23:58,920",
    "end": "08:24:01,160",
    "start_sec": 30238.92,
    "end_sec": 30241.16,
    "zh": "面对忌讳与四名御诡者",
    "vi": "Đối mặt với Kỵ Húy và bốn Ngự Quỷ Giả."
  },
  {
    "idx": 17525,
    "start": "08:24:01,160",
    "end": "08:24:02,520",
    "start_sec": 30241.16,
    "end_sec": 30242.52,
    "zh": "丝毫不落下风",
    "vi": "Nhưng không hề rơi vào thế hạ phong."
  },
  {
    "idx": 17526,
    "start": "08:24:02,520",
    "end": "08:24:03,480",
    "start_sec": 30242.52,
    "end_sec": 30243.48,
    "zh": "此时",
    "vi": "Lúc này."
  },
  {
    "idx": 17527,
    "start": "08:24:03,480",
    "end": "08:24:05,680",
    "start_sec": 30243.48,
    "end_sec": 30245.68,
    "zh": "橙子皮从怀里取出香炉",
    "vi": "Trình Tử Đề lấy từ trong ngực ra một chiếc lư hương."
  },
  {
    "idx": 17528,
    "start": "08:24:05,680",
    "end": "08:24:06,720",
    "start_sec": 30245.68,
    "end_sec": 30246.72,
    "zh": "放心",
    "vi": "Yên tâm đi."
  },
  {
    "idx": 17529,
    "start": "08:24:06,720",
    "end": "08:24:08,020",
    "start_sec": 30246.72,
    "end_sec": 30248.02,
    "zh": "我可不会杀你",
    "vi": "Ta sẽ không giết ngươi đâu."
  },
  {
    "idx": 17530,
    "start": "08:24:08,020",
    "end": "08:24:08,940",
    "start_sec": 30248.02,
    "end_sec": 30248.94,
    "zh": "还要多亏你",
    "vi": "Còn phải cảm ơn ngươi nữa."
  },
  {
    "idx": 17531,
    "start": "08:24:08,940",
    "end": "08:24:10,560",
    "start_sec": 30248.94,
    "end_sec": 30250.56,
    "zh": "让我从未来的自己那里",
    "vi": "Đã giúp ta học được từ bản thân trong tương lai."
  },
  {
    "idx": 17532,
    "start": "08:24:10,560",
    "end": "08:24:11,880",
    "start_sec": 30250.56,
    "end_sec": 30251.88,
    "zh": "学来了香炉的使用方法",
    "vi": "Cách sử dụng chiếc lư hương này."
  },
  {
    "idx": 17533,
    "start": "08:24:11,880",
    "end": "08:24:13,460",
    "start_sec": 30251.88,
    "end_sec": 30253.46,
    "zh": "把你先记给香炉",
    "vi": "Đem ngươi hiến tế cho lư hương."
  },
  {
    "idx": 17534,
    "start": "08:24:13,460",
    "end": "08:24:14,540",
    "start_sec": 30253.46,
    "end_sec": 30254.54,
    "zh": "岂不是更好",
    "vi": "Chẳng phải là tốt hơn sao."
  },
  {
    "idx": 17535,
    "start": "08:24:14,540",
    "end": "08:24:16,020",
    "start_sec": 30254.54,
    "end_sec": 30256.02,
    "zh": "记忆鬼彻底慌",
    "vi": "Quỷ Ký Ức hoàn toàn hoảng loạn."
  },
  {
    "idx": 17536,
    "start": "08:24:16,020",
    "end": "08:24:18,020",
    "start_sec": 30256.02,
    "end_sec": 30258.02,
    "zh": "他窥探过程子提的记忆",
    "vi": "Nó từng nhìn trộm ký ức của Trình Tử Đề."
  },
  {
    "idx": 17537,
    "start": "08:24:18,020",
    "end": "08:24:20,460",
    "start_sec": 30258.02,
    "end_sec": 30260.46,
    "zh": "深知这尊香炉的历史",
    "vi": "Nên biết rất rõ lịch sử của chiếc lư hương này."
  },
  {
    "idx": 17538,
    "start": "08:24:20,460",
    "end": "08:24:22,380",
    "start_sec": 30260.46,
    "end_sec": 30262.38,
    "zh": "可献记",
    "vi": "Có thể hiến tế."
  },
  {
    "idx": 17539,
    "start": "08:24:22,380",
    "end": "08:24:23,700",
    "start_sec": 30262.38,
    "end_sec": 30263.7,
    "zh": "本次献记",
    "vi": "Lần hiến tế này."
  },
  {
    "idx": 17540,
    "start": "08:24:23,700",
    "end": "08:24:25,060",
    "start_sec": 30263.7,
    "end_sec": 30265.06,
    "zh": "一只记忆鬼",
    "vi": "Một con Quỷ Ký Ức."
  },
  {
    "idx": 17541,
    "start": "08:24:25,060",
    "end": "08:24:27,040",
    "start_sec": 30265.06,
    "end_sec": 30267.04,
    "zh": "等价于信息五条",
    "vi": "Tương đương với năm thông tin."
  },
  {
    "idx": 17542,
    "start": "08:24:27,040",
    "end": "08:24:28,640",
    "start_sec": 30267.04,
    "end_sec": 30268.64,
    "zh": "或者对等权利",
    "vi": "Hoặc quyền lợi tương đương."
  },
  {
    "idx": 17543,
    "start": "08:24:28,640",
    "end": "08:24:29,920",
    "start_sec": 30268.64,
    "end_sec": 30269.92,
    "zh": "诡异又在",
    "vi": "Âm thanh quỷ dị hỏi."
  },
  {
    "idx": 17544,
    "start": "08:24:29,920",
    "end": "08:24:31,380",
    "start_sec": 30269.92,
    "end_sec": 30271.38,
    "zh": "是否献记",
    "vi": "Có hiến tế hay không."
  },
  {
    "idx": 17545,
    "start": "08:24:31,380",
    "end": "08:24:32,480",
    "start_sec": 30271.38,
    "end_sec": 30272.48,
    "zh": "献记",
    "vi": "Hiến tế."
  },
  {
    "idx": 17546,
    "start": "08:24:32,480",
    "end": "08:24:35,380",
    "start_sec": 30272.48,
    "end_sec": 30275.38,
    "zh": "仰看记忆鬼身体不断被吸入香炉",
    "vi": "Tận mắt thấy cơ thể Quỷ Ký Ức liên tục bị hút vào lư hương."
  },
  {
    "idx": 17547,
    "start": "08:24:35,380",
    "end": "08:24:36,980",
    "start_sec": 30275.38,
    "end_sec": 30276.98,
    "zh": "他突然大声喊着",
    "vi": "Nó đột nhiên hét lớn."
  },
  {
    "idx": 17548,
    "start": "08:24:36,980",
    "end": "08:24:38,200",
    "start_sec": 30276.98,
    "end_sec": 30278.2,
    "zh": "程子提",
    "vi": "Trình Tử Đề."
  },
  {
    "idx": 17549,
    "start": "08:24:38,200",
    "end": "08:24:39,740",
    "start_sec": 30278.2,
    "end_sec": 30279.74,
    "zh": "你要杀我",
    "vi": "Ngươi muốn giết ta."
  },
  {
    "idx": 17550,
    "start": "08:24:39,740",
    "end": "08:24:41,140",
    "start_sec": 30279.74,
    "end_sec": 30281.14,
    "zh": "我就在临死前",
    "vi": "Thì trước khi chết ta sẽ."
  },
  {
    "idx": 17551,
    "start": "08:24:41,140",
    "end": "08:24:43,120",
    "start_sec": 30281.14,
    "end_sec": 30283.12,
    "zh": "抹除所有人的人格记忆",
    "vi": "Ta sẽ xóa sạch ký ức nhân cách của tất cả mọi người."
  },
  {
    "idx": 17552,
    "start": "08:24:43,120",
    "end": "08:24:45,160",
    "start_sec": 30283.12,
    "end_sec": 30285.16,
    "zh": "让他们全部变成白痴",
    "vi": "Khiến cho bọn họ biến thành kẻ ngốc hết."
  },
  {
    "idx": 17553,
    "start": "08:24:45,160",
    "end": "08:24:46,400",
    "start_sec": 30285.16,
    "end_sec": 30286.4,
    "zh": "如此一来",
    "vi": "Như vậy thì."
  },
  {
    "idx": 17554,
    "start": "08:24:46,400",
    "end": "08:24:47,960",
    "start_sec": 30286.4,
    "end_sec": 30287.96,
    "zh": "就是你渐渐杀了他们",
    "vi": "Chính là ngươi đã gián tiếp giết chết họ."
  },
  {
    "idx": 17555,
    "start": "08:24:47,960",
    "end": "08:24:49,080",
    "start_sec": 30287.96,
    "end_sec": 30289.08,
    "zh": "没事",
    "vi": "Không sao cả."
  },
  {
    "idx": 17556,
    "start": "08:24:49,080",
    "end": "08:24:50,940",
    "start_sec": 30289.08,
    "end_sec": 30290.94,
    "zh": "我可以让他们去基地",
    "vi": "Ta có thể đưa họ đến căn cứ."
  },
  {
    "idx": 17557,
    "start": "08:24:50,940",
    "end": "08:24:52,520",
    "start_sec": 30290.94,
    "end_sec": 30292.52,
    "zh": "治不好是医护的问题",
    "vi": "Chữa không khỏi là vấn đề của y bác sĩ."
  },
  {
    "idx": 17558,
    "start": "08:24:52,520",
    "end": "08:24:53,820",
    "start_sec": 30292.52,
    "end_sec": 30293.82,
    "zh": "你害了他们",
    "vi": "Ngươi đã hại chết họ rồi."
  },
  {
    "idx": 17559,
    "start": "08:24:53,820",
    "end": "08:24:54,900",
    "start_sec": 30293.82,
    "end_sec": 30294.9,
    "zh": "关我屁事",
    "vi": "Liên quan gì đến ta."
  },
  {
    "idx": 17560,
    "start": "08:24:54,900",
    "end": "08:24:56,704",
    "start_sec": 30294.9,
    "end_sec": 30296.704,
    "zh": "你妈你也是个狠人我们和解和解行不行我凭什么和解啊?我给你一个条件,你可以自由出入普林街道,我会保护你的安全,你仔细想想,以后你总会有麻烦的吧!",
    "vi": "Mẹ kiếp ngươi đúng là kẻ tàn nhẫn"
  },
  {
    "idx": 17560,
    "start": "08:24:56,704",
    "end": "08:24:58,057",
    "start_sec": 30296.704,
    "end_sec": 30298.057,
    "zh": "你妈你也是个狠人我们和解和解行不行我凭什么和解啊?我给你一个条件,你可以自由出入普林街道,我会保护你的安全,你仔细想想,以后你总会有麻烦的吧!",
    "vi": "Chúng ta hòa giải được không"
  },
  {
    "idx": 17560,
    "start": "08:24:58,057",
    "end": "08:24:59,861",
    "start_sec": 30298.057,
    "end_sec": 30299.861,
    "zh": "你妈你也是个狠人我们和解和解行不行我凭什么和解啊?我给你一个条件,你可以自由出入普林街道,我会保护你的安全,你仔细想想,以后你总会有麻烦的吧!",
    "vi": "Tại sao ta phải hòa giải với ngươi"
  },
  {
    "idx": 17560,
    "start": "08:24:59,861",
    "end": "08:25:05,048",
    "start_sec": 30299.861,
    "end_sec": 30305.048,
    "zh": "你妈你也是个狠人我们和解和解行不行我凭什么和解啊?我给你一个条件,你可以自由出入普林街道,我会保护你的安全,你仔细想想,以后你总会有麻烦的吧!",
    "vi": "Ta cho ngươi một điều kiện, ngươi có thể tự do ra vào phố Pulin, ta sẽ bảo vệ an toàn cho ngươi"
  },
  {
    "idx": 17560,
    "start": "08:25:05,048",
    "end": "08:25:08,657",
    "start_sec": 30305.048,
    "end_sec": 30308.657,
    "zh": "你妈你也是个狠人我们和解和解行不行我凭什么和解啊?我给你一个条件,你可以自由出入普林街道,我会保护你的安全,你仔细想想,以后你总会有麻烦的吧!",
    "vi": "Ngươi suy nghĩ kỹ đi, sau này thế nào ngươi cũng sẽ gặp rắc rối thôi"
  },
  {
    "idx": 17561,
    "start": "08:25:09,237",
    "end": "08:25:12,259",
    "start_sec": 30309.237,
    "end_sec": 30312.259,
    "zh": "把仇人带过来,或者来我这里避难,七层空间,七层空间啊,我可以绝对保证你的安全!",
    "vi": "Mang kẻ thù đến đây, hoặc đến chỗ ta để lánh nạn"
  },
  {
    "idx": 17561,
    "start": "08:25:12,259",
    "end": "08:25:17,297",
    "start_sec": 30312.259,
    "end_sec": 30317.297,
    "zh": "把仇人带过来,或者来我这里避难,七层空间,七层空间啊,我可以绝对保证你的安全!",
    "vi": "Không gian tầng bảy, không gian tầng bảy đấy, ta tuyệt đối có thể đảm bảo an toàn cho ngươi"
  },
  {
    "idx": 17562,
    "start": "08:25:17,997",
    "end": "08:25:21,617",
    "start_sec": 30317.997,
    "end_sec": 30321.617,
    "zh": "长者提思否证,如果有第二个安全地,倒也不错。",
    "vi": "Trình Tử Đề suy nghĩ, nếu có thêm một nơi an toàn thì cũng tốt."
  },
  {
    "idx": 17563,
    "start": "08:25:21,617",
    "end": "08:25:24,217",
    "start_sec": 30321.617,
    "end_sec": 30324.217,
    "zh": "可是我要是带着敌人进来",
    "vi": "Nhưng nếu ta dẫn kẻ thù vào."
  },
  {
    "idx": 17564,
    "start": "08:25:24,217",
    "end": "08:25:25,137",
    "start_sec": 30324.217,
    "end_sec": 30325.137,
    "zh": "你控制他们",
    "vi": "Ngươi khống chế bọn họ."
  },
  {
    "idx": 17565,
    "start": "08:25:25,137",
    "end": "08:25:26,497",
    "start_sec": 30325.137,
    "end_sec": 30326.497,
    "zh": "合伙对付我怎么办",
    "vi": "Rồi hợp tác đối phó ta thì sao."
  },
  {
    "idx": 17566,
    "start": "08:25:26,497",
    "end": "08:25:27,957",
    "start_sec": 30326.497,
    "end_sec": 30327.957,
    "zh": "不会的",
    "vi": "Sẽ không đâu."
  },
  {
    "idx": 17567,
    "start": "08:25:27,957",
    "end": "08:25:29,397",
    "start_sec": 30327.957,
    "end_sec": 30329.397,
    "zh": "我给你一张我的本体皮",
    "vi": "Ta sẽ đưa ngươi một mảnh da của bản thể ta."
  },
  {
    "idx": 17568,
    "start": "08:25:29,397",
    "end": "08:25:30,437",
    "start_sec": 30329.397,
    "end_sec": 30330.437,
    "zh": "只要它在你手里",
    "vi": "Chỉ cần nó nằm trong tay ngươi."
  },
  {
    "idx": 17569,
    "start": "08:25:30,437",
    "end": "08:25:31,717",
    "start_sec": 30330.437,
    "end_sec": 30331.717,
    "zh": "你可以自由进出这里",
    "vi": "Ngươi có thể tự do ra vào nơi này."
  },
  {
    "idx": 17570,
    "start": "08:25:31,717",
    "end": "08:25:33,017",
    "start_sec": 30331.717,
    "end_sec": 30333.017,
    "zh": "只要它在你手里",
    "vi": "Chỉ cần nó nằm trong tay ngươi."
  },
  {
    "idx": 17571,
    "start": "08:25:33,017",
    "end": "08:25:34,397",
    "start_sec": 30333.017,
    "end_sec": 30334.397,
    "zh": "我绝对不敢攻击你",
    "vi": "Ta tuyệt đối không dám tấn công ngươi."
  },
  {
    "idx": 17572,
    "start": "08:25:34,397",
    "end": "08:25:35,097",
    "start_sec": 30334.397,
    "end_sec": 30335.097,
    "zh": "好",
    "vi": "Được."
  },
  {
    "idx": 17573,
    "start": "08:25:35,097",
    "end": "08:25:36,177",
    "start_sec": 30335.097,
    "end_sec": 30336.177,
    "zh": "拿来看看",
    "vi": "Lấy ra xem thử đi."
  },
  {
    "idx": 17574,
    "start": "08:25:36,177",
    "end": "08:25:38,017",
    "start_sec": 30336.177,
    "end_sec": 30338.017,
    "zh": "记忆鬼急忙地身上",
    "vi": "Quỷ Ký Ức vội vàng trên người."
  },
  {
    "idx": 17575,
    "start": "08:25:38,017",
    "end": "08:25:39,077",
    "start_sec": 30338.017,
    "end_sec": 30339.077,
    "zh": "扶下了一块皮肤",
    "vi": "Xé xuống một mảnh da."
  },
  {
    "idx": 17576,
    "start": "08:25:39,077",
    "end": "08:25:39,577",
    "start_sec": 30339.077,
    "end_sec": 30339.577,
    "zh": "哗",
    "vi": "Xoẹt."
  },
  {
    "idx": 17577,
    "start": "08:25:39,577",
    "end": "08:25:42,077",
    "start_sec": 30339.577,
    "end_sec": 30342.077,
    "zh": "记忆鬼之皮",
    "vi": "Da của Quỷ Ký Ức."
  },
  {
    "idx": 17578,
    "start": "08:25:42,077",
    "end": "08:25:43,997",
    "start_sec": 30342.077,
    "end_sec": 30343.997,
    "zh": "记忆鬼本体的肌肤",
    "vi": "Lớp da của bản thể Quỷ Ký Ức."
  },
  {
    "idx": 17579,
    "start": "08:25:43,997",
    "end": "08:25:45,677",
    "start_sec": 30343.997,
    "end_sec": 30345.677,
    "zh": "拥有者可以免疫",
    "vi": "Người sở hữu có thể miễn nhiễm."
  },
  {
    "idx": 17580,
    "start": "08:25:45,677",
    "end": "08:25:46,717",
    "start_sec": 30345.677,
    "end_sec": 30346.717,
    "zh": "记忆鬼的攻击",
    "vi": "Với đòn tấn công của Quỷ Ký Ức."
  },
  {
    "idx": 17581,
    "start": "08:25:46,717",
    "end": "08:25:47,717",
    "start_sec": 30346.717,
    "end_sec": 30347.717,
    "zh": "有点意思",
    "vi": "Thú vị đấy."
  },
  {
    "idx": 17582,
    "start": "08:25:47,717",
    "end": "08:25:49,237",
    "start_sec": 30347.717,
    "end_sec": 30349.237,
    "zh": "我还有个要求",
    "vi": "Tôi còn một yêu cầu nữa."
  },
  {
    "idx": 17583,
    "start": "08:25:49,237",
    "end": "08:25:50,877",
    "start_sec": 30349.237,
    "end_sec": 30350.877,
    "zh": "把我的这些朋友都放了",
    "vi": "Hãy thả hết những người bạn này của tôi ra."
  },
  {
    "idx": 17584,
    "start": "08:25:50,877",
    "end": "08:25:52,497",
    "start_sec": 30350.877,
    "end_sec": 30352.497,
    "zh": "顺带恢复记忆",
    "vi": "Đồng thời khôi phục ký ức cho họ."
  },
  {
    "idx": 17585,
    "start": "08:25:52,497",
    "end": "08:25:53,217",
    "start_sec": 30352.497,
    "end_sec": 30353.217,
    "zh": "秦始祥",
    "vi": "Tần Thủy Tường."
  },
  {
    "idx": 17586,
    "start": "08:25:53,217",
    "end": "08:25:54,237",
    "start_sec": 30353.217,
    "end_sec": 30354.237,
    "zh": "你是我爹",
    "vi": "Ông là bố tôi."
  },
  {
    "idx": 17587,
    "start": "08:25:54,237",
    "end": "08:25:55,097",
    "start_sec": 30354.237,
    "end_sec": 30355.097,
    "zh": "行了吧",
    "vi": "Được chưa thế."
  },
  {
    "idx": 17588,
    "start": "08:25:55,097",
    "end": "08:26:16,357",
    "start_sec": 30355.097,
    "end_sec": 30376.357,
    "zh": "秦始祥",
    "vi": "Tần Thủy Tường."
  },
  {
    "idx": 17589,
    "start": "08:26:16,357",
    "end": "08:26:17,417",
    "start_sec": 30376.357,
    "end_sec": 30377.417,
    "zh": "你是我爹",
    "vi": "Ông là bố tôi."
  },
  {
    "idx": 17590,
    "start": "08:26:17,417",
    "end": "08:26:18,257",
    "start_sec": 30377.417,
    "end_sec": 30378.257,
    "zh": "行了吧",
    "vi": "Được chưa thế."
  },
  {
    "idx": 17591,
    "start": "08:26:18,257",
    "end": "08:26:20,217",
    "start_sec": 30378.257,
    "end_sec": 30380.217,
    "zh": "长子蹄收回香炉",
    "vi": "Trưởng Tử Đề thu hồi lư hương."
  },
  {
    "idx": 17592,
    "start": "08:26:20,217",
    "end": "08:26:22,437",
    "start_sec": 30380.217,
    "end_sec": 30382.437,
    "zh": "记归扭曲的身体开始恢复",
    "vi": "Cơ thể vặn vẹo của Cơ Quy bắt đầu khôi phục."
  },
  {
    "idx": 17593,
    "start": "08:26:22,437",
    "end": "08:26:24,297",
    "start_sec": 30382.437,
    "end_sec": 30384.297,
    "zh": "本次献祭中断",
    "vi": "Lần hiến tế này bị gián đoạn."
  },
  {
    "idx": 17594,
    "start": "08:26:24,297",
    "end": "08:26:26,197",
    "start_sec": 30384.297,
    "end_sec": 30386.197,
    "zh": "献祭记忆归五分之一",
    "vi": "Ký ức hiến tế trả lại một phần năm."
  },
  {
    "idx": 17595,
    "start": "08:26:26,197",
    "end": "08:26:27,557",
    "start_sec": 30386.197,
    "end_sec": 30387.557,
    "zh": "无法得到回馈",
    "vi": "Không thể nhận được phản hồi."
  },
  {
    "idx": 17596,
    "start": "08:26:27,557",
    "end": "08:26:29,537",
    "start_sec": 30387.557,
    "end_sec": 30389.537,
    "zh": "算作一次献祭次数",
    "vi": "Nhưng vẫn tính là một lần hiến tế."
  },
  {
    "idx": 17597,
    "start": "08:26:29,537",
    "end": "08:26:30,897",
    "start_sec": 30389.537,
    "end_sec": 30390.897,
    "zh": "香炉啊香炉",
    "vi": "Lư hương à lư hương."
  },
  {
    "idx": 17598,
    "start": "08:26:30,897",
    "end": "08:26:31,777",
    "start_sec": 30390.897,
    "end_sec": 30391.777,
    "zh": "你还挺黑",
    "vi": "Mày cũng gian xảo thật đấy."
  },
  {
    "idx": 17599,
    "start": "08:26:31,777",
    "end": "08:26:34,517",
    "start_sec": 30391.777,
    "end_sec": 30394.517,
    "zh": "五分之一不该是给一个信息吗",
    "vi": "Một phần năm không phải nên cho một thông tin sao."
  },
  {
    "idx": 17600,
    "start": "08:26:34,517",
    "end": "08:26:36,637",
    "start_sec": 30394.517,
    "end_sec": 30396.637,
    "zh": "居然只算一次献祭次数",
    "vi": "Thế mà chỉ tính là một lần hiến tế."
  },
  {
    "idx": 17601,
    "start": "08:26:36,637",
    "end": "08:26:37,877",
    "start_sec": 30396.637,
    "end_sec": 30397.877,
    "zh": "吐槽着",
    "vi": "Vừa lẩm bẩm than phiền."
  },
  {
    "idx": 17602,
    "start": "08:26:37,877",
    "end": "08:26:40,517",
    "start_sec": 30397.877,
    "end_sec": 30400.517,
    "zh": "白雪扭碎他们的记忆也在恢复",
    "vi": "Ký ức bị Bạch Tuyết bóp nát của họ cũng đang khôi phục."
  },
  {
    "idx": 17603,
    "start": "08:26:40,517",
    "end": "08:26:42,017",
    "start_sec": 30400.517,
    "end_sec": 30402.017,
    "zh": "卧槽",
    "vi": "Vãi thật."
  },
  {
    "idx": 17604,
    "start": "08:26:42,017",
    "end": "08:26:43,597",
    "start_sec": 30402.017,
    "end_sec": 30403.597,
    "zh": "你个臭傻波衣",
    "vi": "Cái thằng ngu này."
  },
  {
    "idx": 17605,
    "start": "08:26:43,597",
    "end": "08:26:45,537",
    "start_sec": 30403.597,
    "end_sec": 30405.537,
    "zh": "你没事把我抱起来干嘛",
    "vi": "Tự dưng mày ôm tao lên làm gì."
  },
  {
    "idx": 17606,
    "start": "08:26:45,537",
    "end": "08:26:47,017",
    "start_sec": 30405.537,
    "end_sec": 30407.017,
    "zh": "我约了",
    "vi": "Tao chóng mặt quá."
  },
  {
    "idx": 17607,
    "start": "08:26:47,017",
    "end": "08:26:47,957",
    "start_sec": 30407.017,
    "end_sec": 30407.957,
    "zh": "我怎么知道",
    "vi": "Sao tao biết được."
  },
  {
    "idx": 17608,
    "start": "08:26:47,957",
    "end": "08:26:49,497",
    "start_sec": 30407.957,
    "end_sec": 30409.497,
    "zh": "白菊和祖刚",
    "vi": "Bạch Cúc và Tổ Cương."
  },
  {
    "idx": 17609,
    "start": "08:26:49,497",
    "end": "08:26:50,737",
    "start_sec": 30409.497,
    "end_sec": 30410.737,
    "zh": "骂骂咧咧的走了过来",
    "vi": "Vừa chửi bới vừa đi tới."
  },
  {
    "idx": 17610,
    "start": "08:26:50,737",
    "end": "08:26:51,477",
    "start_sec": 30410.737,
    "end_sec": 30411.477,
    "zh": "此时",
    "vi": "Lúc này."
  },
  {
    "idx": 17611,
    "start": "08:26:51,477",
    "end": "08:26:53,797",
    "start_sec": 30411.477,
    "end_sec": 30413.797,
    "zh": "虎宁接到所有的遇鬼者齐聚",
    "vi": "Phố Phổ Ninh tập hợp tất cả những người ngự quỷ."
  },
  {
    "idx": 17612,
    "start": "08:26:53,797",
    "end": "08:26:54,537",
    "start_sec": 30413.797,
    "end_sec": 30414.537,
    "zh": "诶",
    "vi": "Ồ."
  },
  {
    "idx": 17613,
    "start": "08:26:54,537",
    "end": "08:26:55,437",
    "start_sec": 30414.537,
    "end_sec": 30415.437,
    "zh": "程泽平",
    "vi": "Trình Trạch Bình."
  },
  {
    "idx": 17614,
    "start": "08:26:55,437",
    "end": "08:26:56,997",
    "start_sec": 30415.437,
    "end_sec": 30416.997,
    "zh": "你打赢记忆鬼了",
    "vi": "Bạn đã đánh bại Quỷ Ký Ức rồi sao."
  },
  {
    "idx": 17615,
    "start": "08:26:56,997",
    "end": "08:26:58,997",
    "start_sec": 30416.997,
    "end_sec": 30418.997,
    "zh": "程泽平不认识记忆鬼",
    "vi": "Trình Trạch Bình không quen biết Quỷ Ký Ức."
  },
  {
    "idx": 17616,
    "start": "08:26:58,997",
    "end": "08:27:00,397",
    "start_sec": 30418.997,
    "end_sec": 30420.397,
    "zh": "他在心里盘子里",
    "vi": "Trong lòng anh đang tính toán."
  },
  {
    "idx": 17617,
    "start": "08:27:00,397",
    "end": "08:27:02,077",
    "start_sec": 30420.397,
    "end_sec": 30422.077,
    "zh": "与其逼迫记忆鬼",
    "vi": "Thay vì ép buộc Quỷ Ký Ức."
  },
  {
    "idx": 17618,
    "start": "08:27:02,077",
    "end": "08:27:03,137",
    "start_sec": 30422.077,
    "end_sec": 30423.137,
    "zh": "强行驾驭他",
    "vi": "Cưỡng ép điều khiển nó."
  },
  {
    "idx": 17619,
    "start": "08:27:03,137",
    "end": "08:27:04,317",
    "start_sec": 30423.137,
    "end_sec": 30424.317,
    "zh": "或者献祭给香炉",
    "vi": "Hoặc hiến tế cho lư hương."
  },
  {
    "idx": 17620,
    "start": "08:27:04,317",
    "end": "08:27:05,517",
    "start_sec": 30424.317,
    "end_sec": 30425.517,
    "zh": "记忆鬼临死前",
    "vi": "Trước khi chết Quỷ Ký Ức."
  },
  {
    "idx": 17621,
    "start": "08:27:05,517",
    "end": "08:27:06,457",
    "start_sec": 30425.517,
    "end_sec": 30426.457,
    "zh": "肯定会发难",
    "vi": "Chắc chắn sẽ phản kháng."
  },
  {
    "idx": 17622,
    "start": "08:27:06,457",
    "end": "08:27:07,877",
    "start_sec": 30426.457,
    "end_sec": 30427.877,
    "zh": "还是他们变白痴",
    "vi": "Khiến họ trở thành kẻ ngốc."
  },
  {
    "idx": 17623,
    "start": "08:27:07,877",
    "end": "08:27:09,197",
    "start_sec": 30427.877,
    "end_sec": 30429.197,
    "zh": "肯定没跑了",
    "vi": "Là điều chắc chắn rồi."
  },
  {
    "idx": 17624,
    "start": "08:27:09,197",
    "end": "08:27:09,797",
    "start_sec": 30429.197,
    "end_sec": 30429.797,
    "zh": "于是网破",
    "vi": "Cá chết lưới rách."
  },
  {
    "idx": 17625,
    "start": "08:27:09,797",
    "end": "08:27:11,317",
    "start_sec": 30429.797,
    "end_sec": 30431.317,
    "zh": "倒不如现在这个局面好",
    "vi": "Chi bằng giữ nguyên cục diện như bây giờ."
  },
  {
    "idx": 17626,
    "start": "08:27:11,317",
    "end": "08:27:12,757",
    "start_sec": 30431.317,
    "end_sec": 30432.757,
    "zh": "还能给自己留下后路",
    "vi": "Vẫn có thể để lại đường lui cho mình."
  },
  {
    "idx": 17627,
    "start": "08:27:12,757",
    "end": "08:27:13,797",
    "start_sec": 30432.757,
    "end_sec": 30433.797,
    "zh": "喂",
    "vi": "Này."
  },
  {
    "idx": 17628,
    "start": "08:27:13,797",
    "end": "08:27:15,557",
    "start_sec": 30433.797,
    "end_sec": 30435.557,
    "zh": "打开第七扇门",
    "vi": "Hãy mở cánh cửa thứ bảy ra."
  },
  {
    "idx": 17629,
    "start": "08:27:15,557",
    "end": "08:27:16,417",
    "start_sec": 30435.557,
    "end_sec": 30436.417,
    "zh": "现实",
    "vi": "Hiện thực."
  },
  {
    "idx": 17630,
    "start": "08:27:16,417",
    "end": "08:27:18,777",
    "start_sec": 30436.417,
    "end_sec": 30438.777,
    "zh": "程子提命令着寄轨",
    "vi": "Trình Tử Đề ra lệnh cho Quỷ Ký Ức."
  },
  {
    "idx": 17631,
    "start": "08:27:18,777",
    "end": "08:27:20,317",
    "start_sec": 30438.777,
    "end_sec": 30440.317,
    "zh": "寄轨心里在难受",
    "vi": "Dù trong lòng Quỷ Ký Ức rất khó chịu."
  },
  {
    "idx": 17632,
    "start": "08:27:20,317",
    "end": "08:27:22,057",
    "start_sec": 30440.317,
    "end_sec": 30442.057,
    "zh": "他也不敢有任何反应",
    "vi": "Nó cũng không dám có bất kỳ phản ứng nào."
  },
  {
    "idx": 17633,
    "start": "08:27:22,057",
    "end": "08:27:23,577",
    "start_sec": 30442.057,
    "end_sec": 30443.577,
    "zh": "一道白光浮现",
    "vi": "Một luồng ánh sáng trắng hiện lên."
  },
  {
    "idx": 17634,
    "start": "08:27:23,577",
    "end": "08:27:25,057",
    "start_sec": 30443.577,
    "end_sec": 30445.057,
    "zh": "林七号房门打开",
    "vi": "Cánh cửa phòng số bảy mở ra."
  },
  {
    "idx": 17635,
    "start": "08:27:25,057",
    "end": "08:27:26,557",
    "start_sec": 30445.057,
    "end_sec": 30446.557,
    "zh": "回到现实",
    "vi": "Trở về hiện thực."
  },
  {
    "idx": 17636,
    "start": "08:27:26,557",
    "end": "08:27:29,577",
    "start_sec": 30446.557,
    "end_sec": 30449.577,
    "zh": "眼前的普宁街道露出本来面目",
    "vi": "Phố Phổ Ninh trước mắt hiện ra bộ dạng vốn có."
  },
  {
    "idx": 17637,
    "start": "08:27:29,577",
    "end": "08:27:32,277",
    "start_sec": 30449.577,
    "end_sec": 30452.277,
    "zh": "程子提虽然不知道发生了什么",
    "vi": "Trình Tử Đề tuy không biết đã xảy ra chuyện gì."
  },
  {
    "idx": 17638,
    "start": "08:27:32,277",
    "end": "08:27:35,257",
    "start_sec": 30452.277,
    "end_sec": 30455.257,
    "zh": "但是还是要感谢你将我们带了出来",
    "vi": "Nhưng vẫn muốn cảm ơn bạn đã đưa chúng tôi ra ngoài."
  },
  {
    "idx": 17639,
    "start": "08:27:35,257",
    "end": "08:27:38,877",
    "start_sec": 30455.257,
    "end_sec": 30458.877,
    "zh": "以后来上广市报我的名字",
    "vi": "Sau này đến thành phố Thượng Quảng cứ đọc tên tôi."
  },
  {
    "idx": 17640,
    "start": "08:27:38,877",
    "end": "08:27:40,477",
    "start_sec": 30458.877,
    "end_sec": 30460.477,
    "zh": "我一定会报答你的",
    "vi": "Tôi nhất định sẽ báo đáp bạn."
  },
  {
    "idx": 17641,
    "start": "08:27:40,477",
    "end": "08:27:42,297",
    "start_sec": 30460.477,
    "end_sec": 30462.297,
    "zh": "你有这个心就成",
    "vi": "Bạn có lòng như vậy là được rồi."
  },
  {
    "idx": 17642,
    "start": "08:27:42,297",
    "end": "08:27:43,837",
    "start_sec": 30462.297,
    "end_sec": 30463.837,
    "zh": "那个程子提",
    "vi": "Này Trình Tử Đề."
  },
  {
    "idx": 17643,
    "start": "08:27:43,837",
    "end": "08:27:45,557",
    "start_sec": 30463.837,
    "end_sec": 30465.557,
    "zh": "你考不考虑来摩世发展",
    "vi": "Bạn có cân nhắc đến Ma Thế phát triển không."
  },
  {
    "idx": 17644,
    "start": "08:27:45,557",
    "end": "08:27:47,457",
    "start_sec": 30465.557,
    "end_sec": 30467.457,
    "zh": "以你的实力来我们这",
    "vi": "Với thực lực của bạn mà đến chỗ chúng tôi."
  },
  {
    "idx": 17645,
    "start": "08:27:47,457",
    "end": "08:27:48,857",
    "start_sec": 30467.457,
    "end_sec": 30468.857,
    "zh": "一定是高层的",
    "vi": "Chắc chắn sẽ làm cấp cao."
  },
  {
    "idx": 17646,
    "start": "08:27:48,857",
    "end": "08:27:50,377",
    "start_sec": 30468.857,
    "end_sec": 30470.377,
    "zh": "暂时不会去的",
    "vi": "Tạm thời tôi sẽ không đi đâu."
  },
  {
    "idx": 17647,
    "start": "08:27:50,377",
    "end": "08:27:51,157",
    "start_sec": 30470.377,
    "end_sec": 30471.157,
    "zh": "不过",
    "vi": "Nhưng mà."
  },
  {
    "idx": 17648,
    "start": "08:27:51,157",
    "end": "08:27:52,257",
    "start_sec": 30471.157,
    "end_sec": 30472.257,
    "zh": "以后不好说",
    "vi": "Sau này thì chưa biết được."
  },
  {
    "idx": 17649,
    "start": "08:27:52,257",
    "end": "08:27:53,057",
    "start_sec": 30472.257,
    "end_sec": 30473.057,
    "zh": "我去了",
    "vi": "Nếu tôi đi."
  },
  {
    "idx": 17650,
    "start": "08:27:53,057",
    "end": "08:27:54,537",
    "start_sec": 30473.057,
    "end_sec": 30474.537,
    "zh": "你能给我当手下吗",
    "vi": "Bạn có thể làm cấp dưới của tôi không."
  },
  {
    "idx": 17651,
    "start": "08:27:54,537",
    "end": "08:27:55,277",
    "start_sec": 30474.537,
    "end_sec": 30475.277,
    "zh": "可以",
    "vi": "Được chứ."
  },
  {
    "idx": 17652,
    "start": "08:27:55,277",
    "end": "08:28:00,717",
    "start_sec": 30475.277,
    "end_sec": 30480.717,
    "zh": "哎呦喂",
    "vi": "Ái chà chà."
  },
  {
    "idx": 17653,
    "start": "08:28:00,717",
    "end": "08:28:03,297",
    "start_sec": 30480.717,
    "end_sec": 30483.297,
    "zh": "那妹妹看你的眼神都要拉丝了",
    "vi": "Ánh mắt cô em đó nhìn bạn đắm đuối quá kìa."
  },
  {
    "idx": 17654,
    "start": "08:28:03,297",
    "end": "08:28:04,497",
    "start_sec": 30483.297,
    "end_sec": 30484.497,
    "zh": "你行啊你",
    "vi": "Bạn được đấy chứ."
  },
  {
    "idx": 17655,
    "start": "08:28:04,497",
    "end": "08:28:07,337",
    "start_sec": 30484.497,
    "end_sec": 30487.337,
    "zh": "呼声不响就掉了个魔式的迂回者",
    "vi": "Im hơi lặng tiếng mà đã câu được một Ngự Quỷ Giả của Ma Thế rồi."
  },
  {
    "idx": 17656,
    "start": "08:28:07,337",
    "end": "08:28:08,237",
    "start_sec": 30487.337,
    "end_sec": 30488.237,
    "zh": "不浅",
    "vi": "Thật không đơn giản."
  },
  {
    "idx": 17657,
    "start": "08:28:08,237",
    "end": "08:28:09,317",
    "start_sec": 30488.237,
    "end_sec": 30489.317,
    "zh": "怎么",
    "vi": "Sao thế."
  },
  {
    "idx": 17658,
    "start": "08:28:09,317",
    "end": "08:28:10,877",
    "start_sec": 30489.317,
    "end_sec": 30490.877,
    "zh": "她长得也不赖",
    "vi": "Cô ấy trông cũng không tệ."
  },
  {
    "idx": 17659,
    "start": "08:28:10,877",
    "end": "08:28:12,257",
    "start_sec": 30490.877,
    "end_sec": 30492.257,
    "zh": "你这都没想法",
    "vi": "Thế mà bạn không có ý kiến gì sao."
  },
  {
    "idx": 17660,
    "start": "08:28:12,257",
    "end": "08:28:14,277",
    "start_sec": 30492.257,
    "end_sec": 30494.277,
    "zh": "你不懂就别乱说",
    "vi": "Bạn không hiểu thì đừng nói bừa."
  },
  {
    "idx": 17661,
    "start": "08:28:14,277",
    "end": "08:28:15,437",
    "start_sec": 30494.277,
    "end_sec": 30495.437,
    "zh": "我问你",
    "vi": "Tôi hỏi bạn."
  },
  {
    "idx": 17662,
    "start": "08:28:15,437",
    "end": "08:28:19,537",
    "start_sec": 30495.437,
    "end_sec": 30499.537,
    "zh": "你觉得我们金氏玉鬼者基地当真就是固入金汤吗",
    "vi": "Bạn nghĩ căn cứ Ngự Quỷ Giả Kim Thị của chúng ta thực sự kiên cố như thành đồng vách sắt sao."
  },
  {
    "idx": 17663,
    "start": "08:28:19,537",
    "end": "08:28:21,617",
    "start_sec": 30499.537,
    "end_sec": 30501.617,
    "zh": "你的意思是",
    "vi": "Ý của bạn là."
  },
  {
    "idx": 17664,
    "start": "08:28:21,617",
    "end": "08:28:22,917",
    "start_sec": 30501.617,
    "end_sec": 30502.917,
    "zh": "未雨绸缪",
    "vi": "Lo trước tính sau."
  },
  {
    "idx": 17665,
    "start": "08:28:22,917",
    "end": "08:28:25,477",
    "start_sec": 30502.917,
    "end_sec": 30505.477,
    "zh": "金氏玉鬼者虽然人才丰富",
    "vi": "Ngự Quỷ Giả Kim Thị tuy rằng có nhiều nhân tài."
  },
  {
    "idx": 17666,
    "start": "08:28:25,477",
    "end": "08:28:26,317",
    "start_sec": 30505.477,
    "end_sec": 30506.317,
    "zh": "最为权威",
    "vi": "Và có uy quyền nhất."
  },
  {
    "idx": 17667,
    "start": "08:28:26,317",
    "end": "08:28:27,817",
    "start_sec": 30506.317,
    "end_sec": 30507.817,
    "zh": "但是内动内患也多",
    "vi": "Nhưng đấu đá nội bộ và hiểm họa bên trong cũng nhiều."
  },
  {
    "idx": 17668,
    "start": "08:28:27,817",
    "end": "08:28:30,377",
    "start_sec": 30507.817,
    "end_sec": 30510.377,
    "zh": "这你倒是想得多",
    "vi": "Chuyện này bạn lại nghĩ nhiều quá rồi."
  },
  {
    "idx": 17669,
    "start": "08:28:30,377",
    "end": "08:28:33,077",
    "start_sec": 30510.377,
    "end_sec": 30513.077,
    "zh": "这些事不是我该想的",
    "vi": "Những chuyện này không phải việc tôi nên nghĩ."
  },
  {
    "idx": 17670,
    "start": "08:28:33,077",
    "end": "08:28:35,537",
    "start_sec": 30513.077,
    "end_sec": 30515.537,
    "zh": "我还是想想怎么汇报工作吧",
    "vi": "Tôi vẫn nên nghĩ xem báo cáo công việc thế nào thì hơn."
  },
  {
    "idx": 17671,
    "start": "08:28:35,537",
    "end": "08:28:36,937",
    "start_sec": 30515.537,
    "end_sec": 30516.937,
    "zh": "白玉奇说走机",
    "vi": "Bạch Ngọc Kỳ cất điện thoại đi."
  },
  {
    "idx": 17672,
    "start": "08:28:36,937",
    "end": "08:28:38,237",
    "start_sec": 30516.937,
    "end_sec": 30518.237,
    "zh": "一通汇报完后",
    "vi": "Sau khi báo cáo xong một lượt."
  },
  {
    "idx": 17673,
    "start": "08:28:38,237",
    "end": "08:28:39,757",
    "start_sec": 30518.237,
    "end_sec": 30519.757,
    "zh": "挂了电话按下什么",
    "vi": "Cúp điện thoại rồi nhấn nút gì đó."
  },
  {
    "idx": 17674,
    "start": "08:28:39,757",
    "end": "08:28:42,437",
    "start_sec": 30519.757,
    "end_sec": 30522.437,
    "zh": "程子皮回基地后",
    "vi": "Trình Tử Bì, sau khi về căn cứ."
  },
  {
    "idx": 17675,
    "start": "08:28:42,437",
    "end": "08:28:44,057",
    "start_sec": 30522.437,
    "end_sec": 30524.057,
    "zh": "银一要见你",
    "vi": "Ngân Nhất muốn gặp bạn."
  },
  {
    "idx": 17676,
    "start": "08:28:44,057",
    "end": "08:28:45,797",
    "start_sec": 30524.057,
    "end_sec": 30525.797,
    "zh": "他见我干嘛",
    "vi": "Anh ta gặp tôi làm gì."
  },
  {
    "idx": 17677,
    "start": "08:28:45,797",
    "end": "08:28:48,397",
    "start_sec": 30525.797,
    "end_sec": 30528.397,
    "zh": "应该是想和你说说",
    "vi": "Chắc là muốn nói với bạn."
  },
  {
    "idx": 17678,
    "start": "08:28:48,397",
    "end": "08:28:50,257",
    "start_sec": 30528.397,
    "end_sec": 30530.257,
    "zh": "这次任务的细节吧",
    "vi": "Về chi tiết của nhiệm vụ lần này."
  },
  {
    "idx": 17679,
    "start": "08:28:50,257",
    "end": "08:28:51,597",
    "start_sec": 30530.257,
    "end_sec": 30531.597,
    "zh": "车子摇摇晃晃",
    "vi": "Chiếc xe lắc lư."
  },
  {
    "idx": 17680,
    "start": "08:28:51,597",
    "end": "08:28:53,177",
    "start_sec": 30531.597,
    "end_sec": 30533.177,
    "zh": "还想惊世御回者基地",
    "vi": "Hướng về phía căn cứ Ngự Quỷ Giả."
  },
  {
    "idx": 17681,
    "start": "08:28:53,177",
    "end": "08:28:54,157",
    "start_sec": 30533.177,
    "end_sec": 30534.157,
    "zh": "这一场任务",
    "vi": "Nhiệm vụ lần này."
  },
  {
    "idx": 17682,
    "start": "08:28:54,157",
    "end": "08:28:55,817",
    "start_sec": 30534.157,
    "end_sec": 30535.817,
    "zh": "比想象中要更麻烦",
    "vi": "Rắc rối hơn so với tưởng tượng."
  },
  {
    "idx": 17683,
    "start": "08:28:55,817",
    "end": "08:28:57,737",
    "start_sec": 30535.817,
    "end_sec": 30537.737,
    "zh": "橙子皮衣在后座上",
    "vi": "Trình Tử Bì tựa vào ghế sau."
  },
  {
    "idx": 17684,
    "start": "08:28:57,737",
    "end": "08:28:59,437",
    "start_sec": 30537.737,
    "end_sec": 30539.437,
    "zh": "迷迷糊糊睡了不住",
    "vi": "Mơ màng ngủ thiếp đi."
  },
  {
    "idx": 17685,
    "start": "08:28:59,437",
    "end": "08:29:01,437",
    "start_sec": 30539.437,
    "end_sec": 30541.437,
    "zh": "醒醒",
    "vi": "Tỉnh dậy đi."
  },
  {
    "idx": 17686,
    "start": "08:29:01,437",
    "end": "08:29:02,017",
    "start_sec": 30541.437,
    "end_sec": 30542.017,
    "zh": "起来了",
    "vi": "Dậy thôi nào."
  },
  {
    "idx": 17687,
    "start": "08:29:02,017",
    "end": "08:29:06,977",
    "start_sec": 30542.017,
    "end_sec": 30546.977,
    "zh": "怎么",
    "vi": "Sao thế."
  },
  {
    "idx": 17688,
    "start": "08:29:06,977",
    "end": "08:29:08,757",
    "start_sec": 30546.977,
    "end_sec": 30548.757,
    "zh": "我有这么好看吗",
    "vi": "Tôi trông đẹp thế sao."
  },
  {
    "idx": 17689,
    "start": "08:29:08,757",
    "end": "08:29:09,597",
    "start_sec": 30548.757,
    "end_sec": 30549.597,
    "zh": "别说屁了",
    "vi": "Đừng nói nhảm nữa."
  },
  {
    "idx": 17690,
    "start": "08:29:10,257",
    "end": "08:29:10,537",
    "start_sec": 30550.257,
    "end_sec": 30550.537,
    "zh": "走吧",
    "vi": "Đi thôi."
  },
  {
    "idx": 17691,
    "start": "08:29:10,537",
    "end": "08:29:11,597",
    "start_sec": 30550.537,
    "end_sec": 30551.597,
    "zh": "林依依在等你呢",
    "vi": "Lâm Y Y đang đợi bạn đó."
  },
  {
    "idx": 17692,
    "start": "08:29:14,057",
    "end": "08:29:20,997",
    "start_sec": 30554.057,
    "end_sec": 30560.997,
    "zh": "这次去地下七楼",
    "vi": "Lần này đi xuống tầng hầm thứ bảy."
  },
  {
    "idx": 17693,
    "start": "08:29:20,997",
    "end": "08:29:21,937",
    "start_sec": 30560.997,
    "end_sec": 30561.937,
    "zh": "别动",
    "vi": "Đừng cử động."
  },
  {
    "idx": 17694,
    "start": "08:29:21,937",
    "end": "08:29:23,517",
    "start_sec": 30561.937,
    "end_sec": 30563.517,
    "zh": "一会儿电梯门打开",
    "vi": "Lát nữa cửa thang máy mở ra."
  },
  {
    "idx": 17695,
    "start": "08:29:23,517",
    "end": "08:29:24,437",
    "start_sec": 30563.517,
    "end_sec": 30564.437,
    "zh": "你自己进去",
    "vi": "Bạn tự đi vào nhé."
  },
  {
    "idx": 17696,
    "start": "08:29:24,437",
    "end": "08:29:25,257",
    "start_sec": 30564.437,
    "end_sec": 30565.257,
    "zh": "我就不去了",
    "vi": "Tôi không đi cùng đâu."
  },
  {
    "idx": 17697,
    "start": "08:29:25,257",
    "end": "08:29:26,757",
    "start_sec": 30565.257,
    "end_sec": 30566.757,
    "zh": "林一不喜欢人多",
    "vi": "Lâm Nhất không thích nơi đông người."
  },
  {
    "idx": 17698,
    "start": "08:29:26,757",
    "end": "08:29:28,497",
    "start_sec": 30566.757,
    "end_sec": 30568.497,
    "zh": "随着电梯下降",
    "vi": "Theo sự đi xuống của thang máy."
  },
  {
    "idx": 17699,
    "start": "08:29:28,497",
    "end": "08:29:30,777",
    "start_sec": 30568.497,
    "end_sec": 30570.777,
    "zh": "空气中多了几分诡谲的安静",
    "vi": "Không khí bỗng trở nên yên tĩnh đến kỳ lạ."
  },
  {
    "idx": 17700,
    "start": "08:29:30,777",
    "end": "08:29:35,817",
    "start_sec": 30570.777,
    "end_sec": 30575.817,
    "zh": "地下七层",
    "vi": "Tầng hầm thứ bảy."
  },
  {
    "idx": 17701,
    "start": "08:29:35,817",
    "end": "08:29:36,997",
    "start_sec": 30575.817,
    "end_sec": 30576.997,
    "zh": "竟然是个土洞",
    "vi": "Hóa ra là một cái hang"
  },
  {
    "idx": 17702,
    "start": "08:29:36,997",
    "end": "08:29:38,077",
    "start_sec": 30576.997,
    "end_sec": 30578.077,
    "zh": "我吵",
    "vi": "Tôi ồn ào"
  },
  {
    "idx": 17703,
    "start": "08:29:38,077",
    "end": "08:29:39,917",
    "start_sec": 30578.077,
    "end_sec": 30579.917,
    "zh": "不会是要我钻洞吧",
    "vi": "Chẳng lẽ bắt tôi chui xuống hang sao"
  },
  {
    "idx": 17704,
    "start": "08:29:39,917",
    "end": "08:29:42,497",
    "start_sec": 30579.917,
    "end_sec": 30582.497,
    "zh": "喂喂喂",
    "vi": "Này này này"
  },
  {
    "idx": 17705,
    "start": "08:29:42,497",
    "end": "08:29:43,117",
    "start_sec": 30582.497,
    "end_sec": 30583.117,
    "zh": "有人吗",
    "vi": "Có ai không"
  },
  {
    "idx": 17706,
    "start": "08:29:43,117",
    "end": "08:29:44,237",
    "start_sec": 30583.117,
    "end_sec": 30584.237,
    "zh": "话音落下",
    "vi": "Lời nói vừa dứt"
  },
  {
    "idx": 17707,
    "start": "08:29:44,237",
    "end": "08:29:45,397",
    "start_sec": 30584.237,
    "end_sec": 30585.397,
    "zh": "碎到墙壁内",
    "vi": "Vỡ vụn vào trong tường"
  },
  {
    "idx": 17708,
    "start": "08:29:45,397",
    "end": "08:29:47,337",
    "start_sec": 30585.397,
    "end_sec": 30587.337,
    "zh": "一朵朵火帘燃烧起来",
    "vi": "Từng màn lửa bùng cháy lên"
  },
  {
    "idx": 17709,
    "start": "08:29:47,337",
    "end": "08:29:48,917",
    "start_sec": 30587.337,
    "end_sec": 30588.917,
    "zh": "竟然在对橙子皮带路",
    "vi": "Hóa ra là dẫn đường cho Chửng Tử Bì"
  },
  {
    "idx": 17710,
    "start": "08:29:48,917",
    "end": "08:29:50,977",
    "start_sec": 30588.917,
    "end_sec": 30590.977,
    "zh": "默默跟着火帘前行",
    "vi": "Lặng lẽ đi theo màn lửa"
  },
  {
    "idx": 17711,
    "start": "08:29:50,977",
    "end": "08:29:53,417",
    "start_sec": 30590.977,
    "end_sec": 30593.417,
    "zh": "一路上不知多少弯弯绕绕",
    "vi": "Trên đường đi không biết bao nhiêu khúc quanh co"
  },
  {
    "idx": 17712,
    "start": "08:29:53,417",
    "end": "08:29:53,897",
    "start_sec": 30593.417,
    "end_sec": 30593.897,
    "zh": "卧槽",
    "vi": "Đệt"
  },
  {
    "idx": 17713,
    "start": "08:29:53,897",
    "end": "08:29:57,929",
    "start_sec": 30593.897,
    "end_sec": 30597.929,
    "zh": "一般人进了这里不得被困上一辈子终于一扇铁门出现在眼前程子皮走上前犹豫天可最终还是敲了敲门请进",
    "vi": "Người bình thường vào đây thì có mà bị kẹt cả đời"
  },
  {
    "idx": 17713,
    "start": "08:29:57,929",
    "end": "08:30:01,289",
    "start_sec": 30597.929,
    "end_sec": 30601.289,
    "zh": "一般人进了这里不得被困上一辈子终于一扇铁门出现在眼前程子皮走上前犹豫天可最终还是敲了敲门请进",
    "vi": "Cuối cùng một cánh cửa sắt xuất hiện trước mắt"
  },
  {
    "idx": 17713,
    "start": "08:30:01,289",
    "end": "08:30:03,641",
    "start_sec": 30601.289,
    "end_sec": 30603.641,
    "zh": "一般人进了这里不得被困上一辈子终于一扇铁门出现在眼前程子皮走上前犹豫天可最终还是敲了敲门请进",
    "vi": "Chửng Tử Bì bước tới, do dự"
  },
  {
    "idx": 17713,
    "start": "08:30:03,641",
    "end": "08:30:05,321",
    "start_sec": 30603.641,
    "end_sec": 30605.321,
    "zh": "一般人进了这里不得被困上一辈子终于一扇铁门出现在眼前程子皮走上前犹豫天可最终还是敲了敲门请进",
    "vi": "Cuối cùng vẫn gõ cửa"
  },
  {
    "idx": 17713,
    "start": "08:30:05,321",
    "end": "08:30:05,994",
    "start_sec": 30605.321,
    "end_sec": 30605.994,
    "zh": "一般人进了这里不得被困上一辈子终于一扇铁门出现在眼前程子皮走上前犹豫天可最终还是敲了敲门请进",
    "vi": "Mời vào"
  },
  {
    "idx": 17714,
    "start": "08:30:05,994",
    "end": "08:30:11,094",
    "start_sec": 30605.994,
    "end_sec": 30611.094,
    "zh": "你好",
    "vi": "Xin chào"
  },
  {
    "idx": 17715,
    "start": "08:30:11,094",
    "end": "08:30:11,954",
    "start_sec": 30611.094,
    "end_sec": 30611.954,
    "zh": "程子皮",
    "vi": "Chửng Tử Bì"
  },
  {
    "idx": 17716,
    "start": "08:30:11,954",
    "end": "08:30:13,874",
    "start_sec": 30611.954,
    "end_sec": 30613.874,
    "zh": "你好",
    "vi": "Xin chào"
  },
  {
    "idx": 17717,
    "start": "08:30:13,874",
    "end": "08:30:15,414",
    "start_sec": 30613.874,
    "end_sec": 30615.414,
    "zh": "林玉",
    "vi": "Lâm Ngọc"
  },
  {
    "idx": 17718,
    "start": "08:30:24,994",
    "end": "08:30:37,074",
    "start_sec": 30624.994,
    "end_sec": 30637.074,
    "zh": "进来坐吧",
    "vi": "Mời vào ngồi đi"
  },
  {
    "idx": 17719,
    "start": "08:30:37,074",
    "end": "08:30:41,294",
    "start_sec": 30637.074,
    "end_sec": 30641.294,
    "zh": "我听说",
    "vi": "Tôi nghe nói"
  },
  {
    "idx": 17720,
    "start": "08:30:41,294",
    "end": "08:30:44,214",
    "start_sec": 30641.294,
    "end_sec": 30644.214,
    "zh": "普宁街道其实是机翼鬼做的局",
    "vi": "Phổ Ninh Nhai thực chất là do Quỷ Cánh Máy tạo ra"
  },
  {
    "idx": 17721,
    "start": "08:30:44,214",
    "end": "08:30:45,294",
    "start_sec": 30644.214,
    "end_sec": 30645.294,
    "zh": "没错",
    "vi": "Đúng vậy"
  },
  {
    "idx": 17722,
    "start": "08:30:45,294",
    "end": "08:30:47,714",
    "start_sec": 30645.294,
    "end_sec": 30647.714,
    "zh": "那里被分割了七层空间",
    "vi": "Nơi đó bị chia thành bảy tầng không gian"
  },
  {
    "idx": 17723,
    "start": "08:30:47,714",
    "end": "08:30:49,494",
    "start_sec": 30647.714,
    "end_sec": 30649.494,
    "zh": "普宁街道之所以走不出去",
    "vi": "Lý do Phổ Ninh Nhai không thể thoát ra"
  },
  {
    "idx": 17724,
    "start": "08:30:49,494",
    "end": "08:30:52,174",
    "start_sec": 30649.494,
    "end_sec": 30652.174,
    "zh": "那是因为它本身就是第五层空间",
    "vi": "Là vì nó vốn là tầng không gian thứ năm"
  },
  {
    "idx": 17725,
    "start": "08:30:52,174",
    "end": "08:30:54,114",
    "start_sec": 30652.174,
    "end_sec": 30654.114,
    "zh": "很有趣啊",
    "vi": "Thật thú vị"
  },
  {
    "idx": 17726,
    "start": "08:30:54,114",
    "end": "08:30:57,734",
    "start_sec": 30654.114,
    "end_sec": 30657.734,
    "zh": "那你能告诉我你是怎么逃出来的呢",
    "vi": "Vậy anh có thể cho tôi biết anh đã thoát ra bằng cách nào không"
  },
  {
    "idx": 17727,
    "start": "08:30:57,734",
    "end": "08:31:01,754",
    "start_sec": 30657.734,
    "end_sec": 30661.754,
    "zh": "报告上说不同空间存在着记忆的不同问题",
    "vi": "Báo cáo nói rằng các không gian khác nhau tồn tại các vấn đề về ký ức khác nhau"
  },
  {
    "idx": 17728,
    "start": "08:31:01,754",
    "end": "08:31:04,694",
    "start_sec": 30661.754,
    "end_sec": 30664.694,
    "zh": "白旭在这次行动中基本没有作为",
    "vi": "Bạch Húc trong hành động lần này cơ bản không có tác dụng"
  },
  {
    "idx": 17729,
    "start": "08:31:04,694",
    "end": "08:31:07,854",
    "start_sec": 30664.694,
    "end_sec": 30667.854,
    "zh": "所以我可以判定他在第一关就落马了",
    "vi": "Vì vậy tôi có thể phán đoán anh ta đã bị loại ngay từ cửa ải đầu tiên"
  },
  {
    "idx": 17730,
    "start": "08:31:07,854",
    "end": "08:31:11,774",
    "start_sec": 30667.854,
    "end_sec": 30671.774,
    "zh": "而你居然是带着三世的御鬼者全部逃出来了",
    "vi": "Còn anh lại mang theo cả ba đời người điều khiển quỷ thoát ra được"
  },
  {
    "idx": 17731,
    "start": "08:31:11,774",
    "end": "08:31:13,674",
    "start_sec": 30671.774,
    "end_sec": 30673.674,
    "zh": "我如果猜的不错的话",
    "vi": "Nếu tôi đoán không lầm"
  },
  {
    "idx": 17732,
    "start": "08:31:13,674",
    "end": "08:31:16,794",
    "start_sec": 30673.674,
    "end_sec": 30676.794,
    "zh": "最后一关你得是直面记忆鬼了",
    "vi": "Ở ải cuối cùng anh đã phải đối mặt trực tiếp với quỷ ký ức"
  },
  {
    "idx": 17733,
    "start": "08:31:16,794",
    "end": "08:31:20,534",
    "start_sec": 30676.794,
    "end_sec": 30680.534,
    "zh": "那么你到底是和他达成了什么契约",
    "vi": "Vậy rốt cuộc anh đã lập khế ước gì với nó"
  },
  {
    "idx": 17734,
    "start": "08:31:20,534",
    "end": "08:31:21,774",
    "start_sec": 30680.534,
    "end_sec": 30681.774,
    "zh": "他放你出来",
    "vi": "Để nó thả anh ra"
  },
  {
    "idx": 17735,
    "start": "08:31:21,774",
    "end": "08:31:24,474",
    "start_sec": 30681.774,
    "end_sec": 30684.474,
    "zh": "还是你打赢了他呢",
    "vi": "Hay là anh đã đánh thắng nó"
  },
  {
    "idx": 17736,
    "start": "08:31:24,474",
    "end": "08:31:25,174",
    "start_sec": 30684.474,
    "end_sec": 30685.174,
    "zh": "呵呵",
    "vi": "Ha ha"
  },
  {
    "idx": 17737,
    "start": "08:31:25,174",
    "end": "08:31:26,594",
    "start_sec": 30685.174,
    "end_sec": 30686.594,
    "zh": "不愧是领头人",
    "vi": "Không hổ danh là người dẫn đầu"
  },
  {
    "idx": 17738,
    "start": "08:31:26,594",
    "end": "08:31:28,094",
    "start_sec": 30686.594,
    "end_sec": 30688.094,
    "zh": "其实很简单",
    "vi": "Thực ra rất đơn giản"
  },
  {
    "idx": 17739,
    "start": "08:31:28,094",
    "end": "08:31:29,914",
    "start_sec": 30688.094,
    "end_sec": 30689.914,
    "zh": "我的能力是无效化",
    "vi": "Năng lực của tôi là vô hiệu hóa"
  },
  {
    "idx": 17740,
    "start": "08:31:29,914",
    "end": "08:31:31,854",
    "start_sec": 30689.914,
    "end_sec": 30691.854,
    "zh": "从头到尾都开着无效化",
    "vi": "Kích hoạt vô hiệu hóa từ đầu đến cuối"
  },
  {
    "idx": 17741,
    "start": "08:31:31,854",
    "end": "08:31:33,294",
    "start_sec": 30691.854,
    "end_sec": 30693.294,
    "zh": "不就通关了吗",
    "vi": "Như vậy là qua ải rồi"
  },
  {
    "idx": 17742,
    "start": "08:31:33,294",
    "end": "08:31:34,574",
    "start_sec": 30693.294,
    "end_sec": 30694.574,
    "zh": "是吗",
    "vi": "Vậy sao"
  },
  {
    "idx": 17743,
    "start": "08:31:34,574",
    "end": "08:31:38,434",
    "start_sec": 30694.574,
    "end_sec": 30698.434,
    "zh": "难道你惨死鬼的记忆就没被消除吗",
    "vi": "Chẳng lẽ ký ức về quỷ thảm tử của anh không bị xóa bỏ sao"
  },
  {
    "idx": 17744,
    "start": "08:31:38,434",
    "end": "08:31:42,414",
    "start_sec": 30698.434,
    "end_sec": 30702.414,
    "zh": "看来你到底是成为不了大集体的人了",
    "vi": "Xem ra anh rốt cuộc vẫn không thể trở thành người của tập thể lớn được"
  },
  {
    "idx": 17745,
    "start": "08:31:42,414",
    "end": "08:31:44,794",
    "start_sec": 30702.414,
    "end_sec": 30704.794,
    "zh": "你能以一己之力读完狂澜",
    "vi": "Anh có thể tự mình xoay chuyển tình thế"
  },
  {
    "idx": 17746,
    "start": "08:31:44,794",
    "end": "08:31:46,914",
    "start_sec": 30704.794,
    "end_sec": 30706.914,
    "zh": "也证明了你自己的能力",
    "vi": "Cũng đã chứng minh được năng lực của bản thân"
  },
  {
    "idx": 17747,
    "start": "08:31:46,914",
    "end": "08:31:49,754",
    "start_sec": 30706.914,
    "end_sec": 30709.754,
    "zh": "我不管你最后和记忆鬼干了什么",
    "vi": "Tôi không quan tâm rốt cuộc anh đã làm gì với quỷ ký ức"
  },
  {
    "idx": 17748,
    "start": "08:31:49,754",
    "end": "08:31:51,974",
    "start_sec": 30709.754,
    "end_sec": 30711.974,
    "zh": "只要你没干危害基地的事",
    "vi": "Chỉ cần anh không làm gì gây hại cho căn cứ"
  },
  {
    "idx": 17749,
    "start": "08:31:51,974",
    "end": "08:31:53,354",
    "start_sec": 30711.974,
    "end_sec": 30713.354,
    "zh": "我都无所谓",
    "vi": "Tôi đều không bận tâm"
  },
  {
    "idx": 17750,
    "start": "08:31:53,354",
    "end": "08:31:54,214",
    "start_sec": 30713.354,
    "end_sec": 30714.214,
    "zh": "我知道",
    "vi": "Tôi biết"
  },
  {
    "idx": 17751,
    "start": "08:31:54,214",
    "end": "08:31:56,294",
    "start_sec": 30714.214,
    "end_sec": 30716.294,
    "zh": "你肯定给自己留了后路",
    "vi": "Anh chắc chắn đã để lại đường lui cho mình"
  },
  {
    "idx": 17752,
    "start": "08:31:56,294",
    "end": "08:31:57,274",
    "start_sec": 30716.294,
    "end_sec": 30717.274,
    "zh": "如果是这样",
    "vi": "Nếu đã như vậy"
  },
  {
    "idx": 17753,
    "start": "08:31:57,274",
    "end": "08:32:00,294",
    "start_sec": 30717.274,
    "end_sec": 30720.294,
    "zh": "我希望如果到时候真的出现什么事",
    "vi": "Tôi hy vọng nếu đến lúc đó thực sự xảy ra chuyện"
  },
  {
    "idx": 17754,
    "start": "08:32:00,294",
    "end": "08:32:02,954",
    "start_sec": 30720.294,
    "end_sec": 30722.954,
    "zh": "你能带我的几个手下逃走",
    "vi": "Anh có thể đưa vài cấp dưới của tôi trốn thoát"
  },
  {
    "idx": 17755,
    "start": "08:32:02,954",
    "end": "08:32:04,574",
    "start_sec": 30722.954,
    "end_sec": 30724.574,
    "zh": "熟的我考虑考虑",
    "vi": "Người quen thì tôi sẽ cân nhắc"
  },
  {
    "idx": 17756,
    "start": "08:32:04,574",
    "end": "08:32:06,734",
    "start_sec": 30724.574,
    "end_sec": 30726.734,
    "zh": "不熟的就算了",
    "vi": "Còn không quen thì bỏ đi"
  },
  {
    "idx": 17757,
    "start": "08:32:06,734",
    "end": "08:32:08,094",
    "start_sec": 30726.734,
    "end_sec": 30728.094,
    "zh": "你肯帮就行",
    "vi": "Anh chịu giúp là được rồi"
  },
  {
    "idx": 17758,
    "start": "08:32:08,094",
    "end": "08:32:09,074",
    "start_sec": 30728.094,
    "end_sec": 30729.074,
    "zh": "对了",
    "vi": "Đúng rồi"
  },
  {
    "idx": 17759,
    "start": "08:32:09,074",
    "end": "08:32:10,894",
    "start_sec": 30729.074,
    "end_sec": 30730.894,
    "zh": "这次的任务虽然没完成",
    "vi": "Nhiệm vụ lần này tuy chưa hoàn thành"
  },
  {
    "idx": 17760,
    "start": "08:32:10,894",
    "end": "08:32:13,594",
    "start_sec": 30730.894,
    "end_sec": 30733.594,
    "zh": "但也算超出奖励报酬的危险任务",
    "vi": "Nhưng cũng được coi là nhiệm vụ nguy hiểm vượt mức phần thưởng"
  },
  {
    "idx": 17761,
    "start": "08:32:13,594",
    "end": "08:32:15,514",
    "start_sec": 30733.594,
    "end_sec": 30735.514,
    "zh": "我将你和白旭的任务奖励",
    "vi": "Tôi đã tăng phần thưởng nhiệm vụ của cậu và Bạch Húc"
  },
  {
    "idx": 17762,
    "start": "08:32:15,514",
    "end": "08:32:17,594",
    "start_sec": 30735.514,
    "end_sec": 30737.594,
    "zh": "上调到一万点功勋点",
    "vi": "lên mười nghìn điểm công trạng"
  },
  {
    "idx": 17763,
    "start": "08:32:17,594",
    "end": "08:32:20,534",
    "start_sec": 30737.594,
    "end_sec": 30740.534,
    "zh": "还有你独自完成了主要探索",
    "vi": "Ngoài ra cậu đã tự mình hoàn thành cuộc thám hiểm chính"
  },
  {
    "idx": 17764,
    "start": "08:32:20,534",
    "end": "08:32:22,714",
    "start_sec": 30740.534,
    "end_sec": 30742.714,
    "zh": "我还可以给你一个附加条件",
    "vi": "tôi có thể cho cậu thêm một điều kiện đi kèm"
  },
  {
    "idx": 17765,
    "start": "08:32:22,714",
    "end": "08:32:24,614",
    "start_sec": 30742.714,
    "end_sec": 30744.614,
    "zh": "哦是吗",
    "vi": "Ồ vậy sao"
  },
  {
    "idx": 17766,
    "start": "08:32:24,614",
    "end": "08:32:25,794",
    "start_sec": 30744.614,
    "end_sec": 30745.794,
    "zh": "那我要盖玉鬼",
    "vi": "Vậy tôi muốn có Ngự Quỷ"
  },
  {
    "idx": 17767,
    "start": "08:32:25,794",
    "end": "08:32:29,934",
    "start_sec": 30745.794,
    "end_sec": 30749.934,
    "zh": "你当时狮子大开口啊",
    "vi": "Cậu đúng là sư tử ngoác mồm đòi hỏi quá đấy"
  },
  {
    "idx": 17768,
    "start": "08:32:29,934",
    "end": "08:32:31,914",
    "start_sec": 30749.934,
    "end_sec": 30751.914,
    "zh": "那玩意儿是随便给你",
    "vi": "Thứ đó làm sao tùy tiện đưa cho cậu được"
  },
  {
    "idx": 17769,
    "start": "08:32:31,914",
    "end": "08:32:33,214",
    "start_sec": 30751.914,
    "end_sec": 30753.214,
    "zh": "十万的功勋点",
    "vi": "mười vạn điểm công trạng"
  },
  {
    "idx": 17770,
    "start": "08:32:33,214",
    "end": "08:32:34,454",
    "start_sec": 30753.214,
    "end_sec": 30754.454,
    "zh": "我自己都舍不得",
    "vi": "Đến tôi còn không nỡ dùng"
  },
  {
    "idx": 17771,
    "start": "08:32:34,454",
    "end": "08:32:36,654",
    "start_sec": 30754.454,
    "end_sec": 30756.654,
    "zh": "那这条件也没意思啊",
    "vi": "Vậy thì điều kiện này chẳng có ý nghĩa gì cả"
  },
  {
    "idx": 17772,
    "start": "08:32:36,654",
    "end": "08:32:38,054",
    "start_sec": 30756.654,
    "end_sec": 30758.054,
    "zh": "不如多给我点功勋点",
    "vi": "Chi bằng cho tôi thêm ít điểm công trạng đi"
  },
  {
    "idx": 17773,
    "start": "08:32:38,054",
    "end": "08:32:39,734",
    "start_sec": 30758.054,
    "end_sec": 30759.734,
    "zh": "你就没别的想法",
    "vi": "Cậu không có suy nghĩ nào khác sao"
  },
  {
    "idx": 17774,
    "start": "08:32:39,734",
    "end": "08:32:42,794",
    "start_sec": 30759.734,
    "end_sec": 30762.794,
    "zh": "比如帮你的亲人变成玉鬼者",
    "vi": "Ví dụ như giúp người thân của cậu trở thành Ngự Quỷ Giả"
  },
  {
    "idx": 17775,
    "start": "08:32:42,794",
    "end": "08:32:44,854",
    "start_sec": 30762.794,
    "end_sec": 30764.854,
    "zh": "这个嘛",
    "vi": "Chuyện này à"
  },
  {
    "idx": 17776,
    "start": "08:32:44,854",
    "end": "08:32:45,614",
    "start_sec": 30764.854,
    "end_sec": 30765.614,
    "zh": "但是不急",
    "vi": "Nhưng không vội"
  },
  {
    "idx": 17777,
    "start": "08:32:45,614",
    "end": "08:32:47,154",
    "start_sec": 30765.614,
    "end_sec": 30767.154,
    "zh": "我倒是有个别的要求",
    "vi": "Tôi lại có một yêu cầu khác"
  },
  {
    "idx": 17778,
    "start": "08:32:47,154",
    "end": "08:32:49,154",
    "start_sec": 30767.154,
    "end_sec": 30769.154,
    "zh": "什么要求",
    "vi": "Yêu cầu gì"
  },
  {
    "idx": 17779,
    "start": "08:32:49,154",
    "end": "08:32:50,514",
    "start_sec": 30769.154,
    "end_sec": 30770.514,
    "zh": "让我见见周扬",
    "vi": "Cho tôi gặp Chu Dương"
  },
  {
    "idx": 17780,
    "start": "08:32:50,514",
    "end": "08:32:51,634",
    "start_sec": 30770.514,
    "end_sec": 30771.634,
    "zh": "行",
    "vi": "Được"
  },
  {
    "idx": 17781,
    "start": "08:32:51,634",
    "end": "08:32:53,654",
    "start_sec": 30771.634,
    "end_sec": 30773.654,
    "zh": "他也被关在地下七层",
    "vi": "Hắn ta cũng bị giam ở tầng bảy dưới lòng đất"
  },
  {
    "idx": 17782,
    "start": "08:32:53,654",
    "end": "08:32:56,634",
    "start_sec": 30773.654,
    "end_sec": 30776.634,
    "zh": "待会我会让火莲引导你去的",
    "vi": "Lát nữa tôi sẽ bảo Hỏa Liên dẫn cậu đi"
  },
  {
    "idx": 17783,
    "start": "08:32:56,634",
    "end": "08:32:57,314",
    "start_sec": 30776.634,
    "end_sec": 30777.314,
    "zh": "他",
    "vi": "Hắn"
  },
  {
    "idx": 17784,
    "start": "08:32:57,314",
    "end": "08:32:57,814",
    "start_sec": 30777.314,
    "end_sec": 30777.814,
    "zh": "爷",
    "vi": "Cũng"
  },
  {
    "idx": 17785,
    "start": "08:32:57,814",
    "end": "08:32:59,214",
    "start_sec": 30777.814,
    "end_sec": 30779.214,
    "zh": "为什么这么说",
    "vi": "Tại sao lại nói như vậy"
  },
  {
    "idx": 17786,
    "start": "08:32:59,214",
    "end": "08:33:02,714",
    "start_sec": 30779.214,
    "end_sec": 30782.714,
    "zh": "我何尝不是被困在这里呢",
    "vi": "Tôi chẳng phải cũng đang bị kẹt ở đây sao"
  },
  {
    "idx": 17787,
    "start": "08:33:02,714",
    "end": "08:33:04,154",
    "start_sec": 30782.714,
    "end_sec": 30784.154,
    "zh": "长子皮",
    "vi": "Trương Tử Bì"
  },
  {
    "idx": 17788,
    "start": "08:33:04,154",
    "end": "08:33:06,774",
    "start_sec": 30784.154,
    "end_sec": 30786.774,
    "zh": "你知道人体极限是什么吗",
    "vi": "Cậu có biết giới hạn của cơ thể con người là gì không"
  },
  {
    "idx": 17789,
    "start": "08:33:06,774",
    "end": "08:33:07,434",
    "start_sec": 30786.774,
    "end_sec": 30787.434,
    "zh": "什么意思",
    "vi": "Ý gì thế"
  },
  {
    "idx": 17790,
    "start": "08:33:07,434",
    "end": "08:33:10,914",
    "start_sec": 30787.434,
    "end_sec": 30790.914,
    "zh": "一个人驾驭诡异的极限是六个",
    "vi": "Giới hạn để một người chế ngự quỷ dị là sáu con"
  },
  {
    "idx": 17791,
    "start": "08:33:10,914",
    "end": "08:33:12,634",
    "start_sec": 30790.914,
    "end_sec": 30792.634,
    "zh": "你拿来研究过",
    "vi": "Bạn đã từng mang nó đi nghiên cứu rồi."
  },
  {
    "idx": 17792,
    "start": "08:33:12,634",
    "end": "08:33:13,414",
    "start_sec": 30792.634,
    "end_sec": 30793.414,
    "zh": "当然",
    "vi": "Đương nhiên."
  },
  {
    "idx": 17793,
    "start": "08:33:13,414",
    "end": "08:33:15,654",
    "start_sec": 30793.414,
    "end_sec": 30795.654,
    "zh": "当初那么多惊世遇鬼者",
    "vi": "Ngày trước bao nhiêu người ngự quỷ tài giỏi."
  },
  {
    "idx": 17794,
    "start": "08:33:15,654",
    "end": "08:33:17,314",
    "start_sec": 30795.654,
    "end_sec": 30797.314,
    "zh": "一窝蜂冲进鬼界",
    "vi": "Đổ xô vào cõi quỷ."
  },
  {
    "idx": 17795,
    "start": "08:33:17,314",
    "end": "08:33:19,174",
    "start_sec": 30797.314,
    "end_sec": 30799.174,
    "zh": "单纯是为了找鬼吗",
    "vi": "Chẳng lẽ chỉ đơn thuần là để tìm quỷ."
  },
  {
    "idx": 17796,
    "start": "08:33:19,174",
    "end": "08:33:21,194",
    "start_sec": 30799.174,
    "end_sec": 30801.194,
    "zh": "当时前五的御鬼者",
    "vi": "Khi đó năm người ngự quỷ đứng đầu."
  },
  {
    "idx": 17797,
    "start": "08:33:21,194",
    "end": "08:33:23,374",
    "start_sec": 30801.194,
    "end_sec": 30803.374,
    "zh": "哪个不是掌管五个鬼役的大人",
    "vi": "Ai mà chẳng là bậc thầy nắm giữ năm quỷ dịch."
  },
  {
    "idx": 17798,
    "start": "08:33:23,374",
    "end": "08:33:26,654",
    "start_sec": 30803.374,
    "end_sec": 30806.654,
    "zh": "只不过他们每每尝试驾驭第六只鬼役时",
    "vi": "Chỉ là mỗi khi họ cố gắng ngự thêm con quỷ thứ sáu."
  },
  {
    "idx": 17799,
    "start": "08:33:26,654",
    "end": "08:33:29,214",
    "start_sec": 30806.654,
    "end_sec": 30809.214,
    "zh": "自己的意识就会扛不住消散",
    "vi": "Ý thức của họ sẽ không chịu nổi mà tan biến."
  },
  {
    "idx": 17800,
    "start": "08:33:29,214",
    "end": "08:33:31,194",
    "start_sec": 30809.214,
    "end_sec": 30811.194,
    "zh": "被体内五鬼吞噬",
    "vi": "Bị năm con quỷ trong người nuốt chửng."
  },
  {
    "idx": 17801,
    "start": "08:33:31,194",
    "end": "08:33:32,214",
    "start_sec": 30811.194,
    "end_sec": 30812.214,
    "zh": "六只",
    "vi": "Sáu con."
  },
  {
    "idx": 17802,
    "start": "08:33:32,214",
    "end": "08:33:34,194",
    "start_sec": 30812.214,
    "end_sec": 30814.194,
    "zh": "六只鬼役就受不了了",
    "vi": "Sáu con quỷ dịch đã không chịu nổi rồi sao."
  },
  {
    "idx": 17803,
    "start": "08:33:34,194",
    "end": "08:33:35,734",
    "start_sec": 30814.194,
    "end_sec": 30815.734,
    "zh": "那我胸口的七星花",
    "vi": "Vậy hoa thất tinh trên ngực tôi."
  },
  {
    "idx": 17804,
    "start": "08:33:35,734",
    "end": "08:33:37,534",
    "start_sec": 30815.734,
    "end_sec": 30817.534,
    "zh": "起码要再驾驭五只鬼役吧",
    "vi": "Ít nhất phải ngự thêm năm con quỷ dịch nữa nhỉ."
  },
  {
    "idx": 17805,
    "start": "08:33:37,534",
    "end": "08:33:40,754",
    "start_sec": 30817.534,
    "end_sec": 30820.754,
    "zh": "所以当初的御鬼者进入鬼界",
    "vi": "Vậy nên những người ngự quỷ ngày trước vào cõi quỷ."
  },
  {
    "idx": 17806,
    "start": "08:33:40,754",
    "end": "08:33:42,954",
    "start_sec": 30820.754,
    "end_sec": 30822.954,
    "zh": "是想在鬼界突破六只鬼役",
    "vi": "Là muốn đột phá giới hạn sáu con quỷ dịch ở đó."
  },
  {
    "idx": 17807,
    "start": "08:33:42,954",
    "end": "08:33:43,534",
    "start_sec": 30822.954,
    "end_sec": 30823.534,
    "zh": "对",
    "vi": "Đúng vậy."
  },
  {
    "idx": 17808,
    "start": "08:33:43,534",
    "end": "08:33:45,314",
    "start_sec": 30823.534,
    "end_sec": 30825.314,
    "zh": "虽然只是个念想",
    "vi": "Dù chỉ là một ý niệm."
  },
  {
    "idx": 17809,
    "start": "08:33:45,314",
    "end": "08:33:46,534",
    "start_sec": 30825.314,
    "end_sec": 30826.534,
    "zh": "但也要尝试",
    "vi": "Nhưng vẫn phải thử."
  },
  {
    "idx": 17810,
    "start": "08:33:46,534",
    "end": "08:33:48,194",
    "start_sec": 30826.534,
    "end_sec": 30828.194,
    "zh": "过了这么久了",
    "vi": "Đã lâu như vậy rồi."
  },
  {
    "idx": 17811,
    "start": "08:33:48,194",
    "end": "08:33:49,974",
    "start_sec": 30828.194,
    "end_sec": 30829.974,
    "zh": "我也驾驭了五只鬼翼",
    "vi": "Tôi cũng đã ngự được năm con quỷ dịch."
  },
  {
    "idx": 17812,
    "start": "08:33:49,974",
    "end": "08:33:52,094",
    "start_sec": 30829.974,
    "end_sec": 30832.094,
    "zh": "我这次组织人员去鬼界",
    "vi": "Lần này tôi tổ chức người vào cõi quỷ."
  },
  {
    "idx": 17813,
    "start": "08:33:52,094",
    "end": "08:33:54,334",
    "start_sec": 30832.094,
    "end_sec": 30834.334,
    "zh": "就是想驾驭第六只鬼翼",
    "vi": "Chính là muốn ngự con quỷ dịch thứ sáu."
  },
  {
    "idx": 17814,
    "start": "08:33:54,334",
    "end": "08:33:56,914",
    "start_sec": 30834.334,
    "end_sec": 30836.914,
    "zh": "这样我才能彻底让其他人服气",
    "vi": "Như vậy tôi mới có thể khiến người khác tâm phục khẩu phục."
  },
  {
    "idx": 17815,
    "start": "08:33:56,914",
    "end": "08:33:58,854",
    "start_sec": 30836.914,
    "end_sec": 30838.854,
    "zh": "这样金石御鬼者基地",
    "vi": "Như vậy căn cứ ngự quỷ Kim Thạch."
  },
  {
    "idx": 17816,
    "start": "08:33:58,854",
    "end": "08:34:00,374",
    "start_sec": 30838.854,
    "end_sec": 30840.374,
    "zh": "才会永远健存",
    "vi": "Mới có thể tồn tại mãi mãi."
  },
  {
    "idx": 17817,
    "start": "08:34:00,374",
    "end": "08:34:01,514",
    "start_sec": 30840.374,
    "end_sec": 30841.514,
    "zh": "所以呢",
    "vi": "Vậy thì sao."
  },
  {
    "idx": 17818,
    "start": "08:34:01,514",
    "end": "08:34:02,894",
    "start_sec": 30841.514,
    "end_sec": 30842.894,
    "zh": "这和我有什么关系",
    "vi": "Việc đó thì liên quan gì đến tôi."
  },
  {
    "idx": 17819,
    "start": "08:34:02,894",
    "end": "08:34:04,234",
    "start_sec": 30842.894,
    "end_sec": 30844.234,
    "zh": "我希望你",
    "vi": "Tôi hy vọng bạn."
  },
  {
    "idx": 17820,
    "start": "08:34:04,234",
    "end": "08:34:06,494",
    "start_sec": 30844.234,
    "end_sec": 30846.494,
    "zh": "在我成功找到匹配的鬼翼后",
    "vi": "Sau khi tôi tìm được quỷ dịch phù hợp."
  },
  {
    "idx": 17821,
    "start": "08:34:06,494",
    "end": "08:34:08,054",
    "start_sec": 30846.494,
    "end_sec": 30848.054,
    "zh": "尝试驾驭期间",
    "vi": "Trong thời gian tôi cố gắng chế ngự nó."
  },
  {
    "idx": 17822,
    "start": "08:34:08,054",
    "end": "08:34:10,734",
    "start_sec": 30848.054,
    "end_sec": 30850.734,
    "zh": "去帮忙遏制其余两派的御鬼者",
    "vi": "Bạn hãy giúp tôi kiềm chế ngự quỷ nhân của hai phe còn lại."
  },
  {
    "idx": 17823,
    "start": "08:34:10,734",
    "end": "08:34:13,014",
    "start_sec": 30850.734,
    "end_sec": 30853.014,
    "zh": "我担心我驾驭鬼翼期间",
    "vi": "Tôi lo rằng trong lúc tôi chế ngự quỷ dực."
  },
  {
    "idx": 17824,
    "start": "08:34:13,014",
    "end": "08:34:14,474",
    "start_sec": 30853.014,
    "end_sec": 30854.474,
    "zh": "他们会捣乱",
    "vi": "Bọn họ sẽ gây rối."
  },
  {
    "idx": 17825,
    "start": "08:34:14,474",
    "end": "08:34:15,314",
    "start_sec": 30854.474,
    "end_sec": 30855.314,
    "zh": "就这",
    "vi": "Chỉ có vậy thôi sao."
  },
  {
    "idx": 17826,
    "start": "08:34:15,314",
    "end": "08:34:16,354",
    "start_sec": 30855.314,
    "end_sec": 30856.354,
    "zh": "就是这",
    "vi": "Đúng vậy."
  },
  {
    "idx": 17827,
    "start": "08:34:16,354",
    "end": "08:34:18,114",
    "start_sec": 30856.354,
    "end_sec": 30858.114,
    "zh": "那好吧",
    "vi": "Vậy được rồi."
  },
  {
    "idx": 17828,
    "start": "08:34:18,114",
    "end": "08:34:19,094",
    "start_sec": 30858.114,
    "end_sec": 30859.094,
    "zh": "我尽力",
    "vi": "Tôi sẽ cố gắng hết sức."
  },
  {
    "idx": 17829,
    "start": "08:34:19,094",
    "end": "08:34:20,294",
    "start_sec": 30859.094,
    "end_sec": 30860.294,
    "zh": "行啊",
    "vi": "Được thôi."
  },
  {
    "idx": 17830,
    "start": "08:34:20,294",
    "end": "08:34:21,274",
    "start_sec": 30860.294,
    "end_sec": 30861.274,
    "zh": "你歇着吧",
    "vi": "Bạn nghỉ ngơi đi."
  },
  {
    "idx": 17831,
    "start": "08:34:21,274",
    "end": "08:34:22,974",
    "start_sec": 30861.274,
    "end_sec": 30862.974,
    "zh": "程子提离开房间",
    "vi": "Trình Tử Đề rời khỏi phòng."
  },
  {
    "idx": 17832,
    "start": "08:34:22,974",
    "end": "08:34:24,974",
    "start_sec": 30862.974,
    "end_sec": 30864.974,
    "zh": "吐到旁的火莲再次了解",
    "vi": "Hỏa Liên đi bên cạnh lại hiểu ra."
  },
  {
    "idx": 17833,
    "start": "08:34:24,974",
    "end": "08:34:27,354",
    "start_sec": 30864.974,
    "end_sec": 30867.354,
    "zh": "虽说这次和林一接触很愉快",
    "vi": "Dù lần này tiếp xúc với Lâm Nhất rất vui vẻ."
  },
  {
    "idx": 17834,
    "start": "08:34:27,354",
    "end": "08:34:28,354",
    "start_sec": 30867.354,
    "end_sec": 30868.354,
    "zh": "但总觉得",
    "vi": "Nhưng cô luôn cảm thấy."
  },
  {
    "idx": 17835,
    "start": "08:34:28,354",
    "end": "08:34:29,794",
    "start_sec": 30868.354,
    "end_sec": 30869.794,
    "zh": "他那瘦肉的区区里",
    "vi": "Bên trong cơ thể gầy yếu của anh ta."
  },
  {
    "idx": 17836,
    "start": "08:34:29,794",
    "end": "08:34:31,534",
    "start_sec": 30869.794,
    "end_sec": 30871.534,
    "zh": "隐藏着一种可怕的力量",
    "vi": "Đang ẩn chứa một sức mạnh đáng sợ."
  },
  {
    "idx": 17837,
    "start": "08:34:31,534",
    "end": "08:34:33,094",
    "start_sec": 30871.534,
    "end_sec": 30873.094,
    "zh": "火莲七招八招",
    "vi": "Hỏa Liên dẫn đường đi vòng vèo."
  },
  {
    "idx": 17838,
    "start": "08:34:33,094",
    "end": "08:34:34,814",
    "start_sec": 30873.094,
    "end_sec": 30874.814,
    "zh": "带着程子提来到一间",
    "vi": "Đưa Trình Tử Đề đến trước một căn phòng."
  },
  {
    "idx": 17839,
    "start": "08:34:34,814",
    "end": "08:34:36,314",
    "start_sec": 30874.814,
    "end_sec": 30876.314,
    "zh": "满是铜锈的铁炸了间",
    "vi": "Đầy những chấn song sắt gỉ sét."
  },
  {
    "idx": 17840,
    "start": "08:34:36,314",
    "end": "08:34:37,714",
    "start_sec": 30876.314,
    "end_sec": 30877.714,
    "zh": "铁炸了里",
    "vi": "Bên trong chấn song sắt."
  },
  {
    "idx": 17841,
    "start": "08:34:37,714",
    "end": "08:34:39,514",
    "start_sec": 30877.714,
    "end_sec": 30879.514,
    "zh": "那个熟悉的身影勾搂着",
    "vi": "Bóng dáng quen thuộc đó đang khom lưng."
  },
  {
    "idx": 17842,
    "start": "08:34:39,514",
    "end": "08:34:41,534",
    "start_sec": 30879.514,
    "end_sec": 30881.534,
    "zh": "依然不复先前的俊俏风姿",
    "vi": "Đã không còn vẻ tuấn tú như trước kia."
  },
  {
    "idx": 17843,
    "start": "08:34:41,534",
    "end": "08:34:42,394",
    "start_sec": 30881.534,
    "end_sec": 30882.394,
    "zh": "周扬",
    "vi": "Chu Dương."
  },
  {
    "idx": 17844,
    "start": "08:34:42,394",
    "end": "08:34:45,914",
    "start_sec": 30882.394,
    "end_sec": 30885.914,
    "zh": "你 橙子皮",
    "vi": "Bạn, Trình Tử Đề."
  },
  {
    "idx": 17845,
    "start": "08:34:45,914",
    "end": "08:34:47,214",
    "start_sec": 30885.914,
    "end_sec": 30887.214,
    "zh": "你来干什么",
    "vi": "Bạn đến đây làm gì."
  },
  {
    "idx": 17846,
    "start": "08:34:54,991",
    "end": "08:35:24,971",
    "start_sec": 30894.991,
    "end_sec": 30924.971,
    "zh": "请不吝点赞 订阅 转发 打赏支持明镜与点点栏目",
    "vi": "Xin vui lòng nhấn thích, đăng ký, chia sẻ và ủng hộ kênh."
  },
  {
    "idx": 17847,
    "start": "08:35:24,991",
    "end": "08:35:27,851",
    "start_sec": 30924.991,
    "end_sec": 30927.851,
    "zh": "这诡异,这样的话才能持续研究吧。",
    "vi": "Sự kỳ quái này, có như vậy mới tiếp tục nghiên cứu được."
  },
  {
    "idx": 17848,
    "start": "08:35:28,431",
    "end": "08:35:32,660",
    "start_sec": 30928.431,
    "end_sec": 30932.66,
    "zh": "哈哈哈哈,橙子皮啊橙子皮,没想到你也是个狠人,不过这样也好,虚伪的人没意思,我的身体已经病危了,普通的诡异没用,好的诡异,你们极地舍不得,我啊,不过是可有可无的妻子罢了。",
    "vi": "Ha ha ha ha, Trình Tử Đề à Trình Tử Đề, không ngờ bạn cũng là một kẻ tàn nhẫn."
  },
  {
    "idx": 17848,
    "start": "08:35:32,660",
    "end": "08:35:35,197",
    "start_sec": 30932.66,
    "end_sec": 30935.197,
    "zh": "哈哈哈哈,橙子皮啊橙子皮,没想到你也是个狠人,不过这样也好,虚伪的人没意思,我的身体已经病危了,普通的诡异没用,好的诡异,你们极地舍不得,我啊,不过是可有可无的妻子罢了。",
    "vi": "Nhưng như vậy cũng tốt, kẻ đạo đức giả thật vô vị."
  },
  {
    "idx": 17848,
    "start": "08:35:35,197",
    "end": "08:35:38,580",
    "start_sec": 30935.197,
    "end_sec": 30938.58,
    "zh": "哈哈哈哈,橙子皮啊橙子皮,没想到你也是个狠人,不过这样也好,虚伪的人没意思,我的身体已经病危了,普通的诡异没用,好的诡异,你们极地舍不得,我啊,不过是可有可无的妻子罢了。",
    "vi": "Cơ thể tôi đã nguy kịch rồi, sự kỳ quái thông thường không có tác dụng."
  },
  {
    "idx": 17848,
    "start": "08:35:38,580",
    "end": "08:35:41,540",
    "start_sec": 30938.58,
    "end_sec": 30941.54,
    "zh": "哈哈哈哈,橙子皮啊橙子皮,没想到你也是个狠人,不过这样也好,虚伪的人没意思,我的身体已经病危了,普通的诡异没用,好的诡异,你们极地舍不得,我啊,不过是可有可无的妻子罢了。",
    "vi": "Sự kỳ quái tốt thì căn cứ các người lại không nỡ bỏ ra."
  },
  {
    "idx": 17848,
    "start": "08:35:41,540",
    "end": "08:35:44,711",
    "start_sec": 30941.54,
    "end_sec": 30944.711,
    "zh": "哈哈哈哈,橙子皮啊橙子皮,没想到你也是个狠人,不过这样也好,虚伪的人没意思,我的身体已经病危了,普通的诡异没用,好的诡异,你们极地舍不得,我啊,不过是可有可无的妻子罢了。",
    "vi": "Tôi chỉ là một quân cờ có cũng được mà không có cũng chẳng sao."
  },
  {
    "idx": 17849,
    "start": "08:35:45,111",
    "end": "08:35:48,704",
    "start_sec": 30945.111,
    "end_sec": 30948.704,
    "zh": "看着欧阳无神的眼睛,橙子皮神色复杂,要知道,当时的他,是多么的不可一世啊。",
    "vi": "Nhìn vào đôi mắt vô hồn của Chu Dương, Trình Tử Đề có vẻ mặt phức tạp."
  },
  {
    "idx": 17849,
    "start": "08:35:48,704",
    "end": "08:35:51,451",
    "start_sec": 30948.704,
    "end_sec": 30951.451,
    "zh": "看着欧阳无神的眼睛,橙子皮神色复杂,要知道,当时的他,是多么的不可一世啊。",
    "vi": "Phải biết rằng, lúc đó anh ta đã kiêu ngạo đến mức nào."
  },
  {
    "idx": 17850,
    "start": "08:35:51,711",
    "end": "08:35:54,231",
    "start_sec": 30951.711,
    "end_sec": 30954.231,
    "zh": "你来找我,不会就是想和我聊天吧?",
    "vi": "Bạn đến tìm tôi, không phải chỉ là muốn trò chuyện với tôi đấy chứ."
  },
  {
    "idx": 17851,
    "start": "08:35:54,991",
    "end": "08:35:57,171",
    "start_sec": 30954.991,
    "end_sec": 30957.171,
    "zh": "你觉得什么才是最安全的",
    "vi": "Cậu nghĩ cái gì mới là an toàn nhất."
  },
  {
    "idx": 17852,
    "start": "08:35:57,171",
    "end": "08:35:58,071",
    "start_sec": 30957.171,
    "end_sec": 30958.071,
    "zh": "安全",
    "vi": "An toàn sao."
  },
  {
    "idx": 17853,
    "start": "08:35:58,071",
    "end": "08:36:00,431",
    "start_sec": 30958.071,
    "end_sec": 30960.431,
    "zh": "现在有安全可言吗",
    "vi": "Bây giờ làm gì có cái gọi là an toàn chứ."
  },
  {
    "idx": 17854,
    "start": "08:36:00,431",
    "end": "08:36:01,951",
    "start_sec": 30960.431,
    "end_sec": 30961.951,
    "zh": "我以为我是御鬼者",
    "vi": "Tôi cứ nghĩ mình là Ngự Quỷ Giả."
  },
  {
    "idx": 17855,
    "start": "08:36:01,951",
    "end": "08:36:02,791",
    "start_sec": 30961.951,
    "end_sec": 30962.791,
    "zh": "我会安全",
    "vi": "Thì tôi sẽ được an toàn."
  },
  {
    "idx": 17856,
    "start": "08:36:02,791",
    "end": "08:36:06,051",
    "start_sec": 30962.791,
    "end_sec": 30966.051,
    "zh": "实际上御鬼者也不过是他人的玩物",
    "vi": "Nhưng thực tế Ngự Quỷ Giả cũng chỉ là món đồ chơi của kẻ khác mà thôi."
  },
  {
    "idx": 17857,
    "start": "08:36:06,051",
    "end": "08:36:08,851",
    "start_sec": 30966.051,
    "end_sec": 30968.851,
    "zh": "我以为大鸡皮是安全的",
    "vi": "Tôi cứ nghĩ căn cứ lớn là nơi an toàn."
  },
  {
    "idx": 17858,
    "start": "08:36:08,851",
    "end": "08:36:10,491",
    "start_sec": 30968.851,
    "end_sec": 30970.491,
    "zh": "实际上人心叵测",
    "vi": "Nhưng thực tế lòng người khó đoán."
  },
  {
    "idx": 17859,
    "start": "08:36:10,491",
    "end": "08:36:12,231",
    "start_sec": 30970.491,
    "end_sec": 30972.231,
    "zh": "你要问我何为安全",
    "vi": "Nếu cậu muốn hỏi tôi thế nào là an toàn."
  },
  {
    "idx": 17860,
    "start": "08:36:12,231",
    "end": "08:36:13,491",
    "start_sec": 30972.231,
    "end_sec": 30973.491,
    "zh": "我只能这么说",
    "vi": "Tôi chỉ có thể nói thế này."
  },
  {
    "idx": 17861,
    "start": "08:36:13,491",
    "end": "08:36:14,811",
    "start_sec": 30973.491,
    "end_sec": 30974.811,
    "zh": "求人不如求己",
    "vi": "Cầu người không bằng cầu mình."
  },
  {
    "idx": 17862,
    "start": "08:36:14,811",
    "end": "08:36:18,431",
    "start_sec": 30974.811,
    "end_sec": 30978.431,
    "zh": "突然周扬冷漠的脸上多出一次笑容",
    "vi": "Đột nhiên trên khuôn mặt lạnh lùng của Chu Dương xuất hiện một nụ cười."
  },
  {
    "idx": 17863,
    "start": "08:36:18,431",
    "end": "08:36:20,111",
    "start_sec": 30978.431,
    "end_sec": 30980.111,
    "zh": "长者鼻心灵神会",
    "vi": "Trương Triết Binh hiểu ý ngay."
  },
  {
    "idx": 17864,
    "start": "08:36:20,111",
    "end": "08:36:21,091",
    "start_sec": 30980.111,
    "end_sec": 30981.091,
    "zh": "勾勾手指",
    "vi": "Ngoắc ngoắc ngón tay."
  },
  {
    "idx": 17865,
    "start": "08:36:21,091",
    "end": "08:36:22,231",
    "start_sec": 30981.091,
    "end_sec": 30982.231,
    "zh": "开嘴无笑话",
    "vi": "Mở miệng không nói đùa."
  },
  {
    "idx": 17866,
    "start": "08:36:22,231",
    "end": "08:36:24,651",
    "start_sec": 30982.231,
    "end_sec": 30984.651,
    "zh": "周围的那种控制感瞬间脱了",
    "vi": "Cảm giác bị khống chế xung quanh lập tức biến mất."
  },
  {
    "idx": 17867,
    "start": "08:36:24,651",
    "end": "08:36:26,131",
    "start_sec": 30984.651,
    "end_sec": 30986.131,
    "zh": "该说不说",
    "vi": "Không thể không nói."
  },
  {
    "idx": 17868,
    "start": "08:36:26,131",
    "end": "08:36:28,271",
    "start_sec": 30986.131,
    "end_sec": 30988.271,
    "zh": "我们之间还是有默契的",
    "vi": "Giữa chúng ta vẫn có sự ăn ý đấy chứ."
  },
  {
    "idx": 17869,
    "start": "08:36:28,271",
    "end": "08:36:29,331",
    "start_sec": 30988.271,
    "end_sec": 30989.331,
    "zh": "你来找我",
    "vi": "Cậu đến tìm tôi."
  },
  {
    "idx": 17870,
    "start": "08:36:29,331",
    "end": "08:36:30,631",
    "start_sec": 30989.331,
    "end_sec": 30990.631,
    "zh": "是为了找个后路吧",
    "vi": "Là để tìm một đường lui đúng không."
  },
  {
    "idx": 17871,
    "start": "08:36:30,631",
    "end": "08:36:32,351",
    "start_sec": 30990.631,
    "end_sec": 30992.351,
    "zh": "你怎么知道",
    "vi": "Sao cậu biết được."
  },
  {
    "idx": 17872,
    "start": "08:36:32,351",
    "end": "08:36:34,811",
    "start_sec": 30992.351,
    "end_sec": 30994.811,
    "zh": "你以为我坐在这里",
    "vi": "Cậu nghĩ tôi ngồi ở đây."
  },
  {
    "idx": 17873,
    "start": "08:36:34,811",
    "end": "08:36:35,831",
    "start_sec": 30994.811,
    "end_sec": 30995.831,
    "zh": "就什么都不知道",
    "vi": "Thì sẽ không biết gì sao."
  },
  {
    "idx": 17874,
    "start": "08:36:35,831",
    "end": "08:36:38,551",
    "start_sec": 30995.831,
    "end_sec": 30998.551,
    "zh": "御鬼者网站我还可以登录",
    "vi": "Tôi vẫn có thể đăng nhập vào trang web Ngự Quỷ Giả."
  },
  {
    "idx": 17875,
    "start": "08:36:38,551",
    "end": "08:36:40,111",
    "start_sec": 30998.551,
    "end_sec": 31000.111,
    "zh": "你最近的风头可不小",
    "vi": "Dạo này cậu nổi tiếng lắm đấy."
  },
  {
    "idx": 17876,
    "start": "08:36:40,111",
    "end": "08:36:42,031",
    "start_sec": 31000.111,
    "end_sec": 31002.031,
    "zh": "零一一派要是出了事",
    "vi": "Nếu phe không một một xảy ra chuyện."
  },
  {
    "idx": 17877,
    "start": "08:36:42,031",
    "end": "08:36:43,471",
    "start_sec": 31002.031,
    "end_sec": 31003.471,
    "zh": "你绝对要被盯上",
    "vi": "Cậu chắc chắn sẽ bị nhắm vào."
  },
  {
    "idx": 17878,
    "start": "08:36:43,471",
    "end": "08:36:47,351",
    "start_sec": 31003.471,
    "end_sec": 31007.351,
    "zh": "那你知道我找你到底要干嘛吗",
    "vi": "Vậy cậu có biết tôi tìm cậu rốt cuộc là muốn làm gì không."
  },
  {
    "idx": 17879,
    "start": "08:36:47,351",
    "end": "08:36:48,251",
    "start_sec": 31007.351,
    "end_sec": 31008.251,
    "zh": "要我帮你",
    "vi": "Muốn tôi giúp cậu."
  },
  {
    "idx": 17880,
    "start": "08:36:48,251",
    "end": "08:36:49,531",
    "start_sec": 31008.251,
    "end_sec": 31009.531,
    "zh": "你就得拿出诚意",
    "vi": "Thì cậu phải thể hiện lòng thành."
  },
  {
    "idx": 17881,
    "start": "08:36:49,531",
    "end": "08:36:51,351",
    "start_sec": 31009.531,
    "end_sec": 31011.351,
    "zh": "你吃了我的物账鬼",
    "vi": "Ngươi đã ăn con quỷ vật chất của ta"
  },
  {
    "idx": 17882,
    "start": "08:36:51,351",
    "end": "08:36:52,791",
    "start_sec": 31011.351,
    "end_sec": 31012.791,
    "zh": "就得再给我找个诡异",
    "vi": "thì phải tìm cho ta một con quỷ khác"
  },
  {
    "idx": 17883,
    "start": "08:36:52,791",
    "end": "08:36:53,611",
    "start_sec": 31012.791,
    "end_sec": 31013.611,
    "zh": "另外",
    "vi": "Ngoài ra"
  },
  {
    "idx": 17884,
    "start": "08:36:53,611",
    "end": "08:36:55,111",
    "start_sec": 31013.611,
    "end_sec": 31015.111,
    "zh": "我能感觉到",
    "vi": "ta có thể cảm nhận được"
  },
  {
    "idx": 17885,
    "start": "08:36:55,111",
    "end": "08:36:57,571",
    "start_sec": 31015.111,
    "end_sec": 31017.571,
    "zh": "我的轨迹被放在了地下五楼的位置",
    "vi": "vết tích của ta đang ở tầng hầm thứ năm"
  },
  {
    "idx": 17886,
    "start": "08:36:57,571",
    "end": "08:36:59,111",
    "start_sec": 31017.571,
    "end_sec": 31019.111,
    "zh": "你想要躲到尽忠世界",
    "vi": "Ngươi muốn trốn đến tận thế giới"
  },
  {
    "idx": 17887,
    "start": "08:36:59,111",
    "end": "08:37:00,611",
    "start_sec": 31019.111,
    "end_sec": 31020.611,
    "zh": "就需要把它给我带来",
    "vi": "thì cũng phải mang nó đến cho ta"
  },
  {
    "idx": 17888,
    "start": "08:37:00,611",
    "end": "08:37:02,471",
    "start_sec": 31020.611,
    "end_sec": 31022.471,
    "zh": "不愧是你",
    "vi": "Đúng là ngươi"
  },
  {
    "idx": 17889,
    "start": "08:37:02,471",
    "end": "08:37:09,571",
    "start_sec": 31022.471,
    "end_sec": 31029.571,
    "zh": "到了基地内乱的那一步",
    "vi": "đến bước làm loạn căn cứ rồi"
  },
  {
    "idx": 17890,
    "start": "08:37:09,571",
    "end": "08:37:10,791",
    "start_sec": 31029.571,
    "end_sec": 31030.791,
    "zh": "我会来找你的",
    "vi": "Ta sẽ đến tìm ngươi"
  },
  {
    "idx": 17891,
    "start": "08:37:10,791",
    "end": "08:37:12,451",
    "start_sec": 31030.791,
    "end_sec": 31032.451,
    "zh": "呵呵",
    "vi": "Heh"
  },
  {
    "idx": 17892,
    "start": "08:37:12,451",
    "end": "08:37:14,371",
    "start_sec": 31032.451,
    "end_sec": 31034.371,
    "zh": "你最好快点",
    "vi": "Tốt nhất ngươi nên nhanh lên"
  },
  {
    "idx": 17893,
    "start": "08:37:14,371",
    "end": "08:37:18,211",
    "start_sec": 31034.371,
    "end_sec": 31038.211,
    "zh": "周扬跳了敲身后的指笔",
    "vi": "Chu Dương nhảy lên, chỉ vào thứ sau lưng"
  },
  {
    "idx": 17894,
    "start": "08:37:18,211",
    "end": "08:37:19,231",
    "start_sec": 31038.211,
    "end_sec": 31039.231,
    "zh": "传途杂落",
    "vi": "Một bóng người mờ ảo"
  },
  {
    "idx": 17895,
    "start": "08:37:19,351",
    "end": "08:37:21,691",
    "start_sec": 31039.351,
    "end_sec": 31041.691,
    "zh": "一个人形轮廓出现在墙壁上",
    "vi": "Một bóng người xuất hiện trên tường"
  },
  {
    "idx": 17896,
    "start": "08:37:21,691",
    "end": "08:37:22,531",
    "start_sec": 31041.691,
    "end_sec": 31042.531,
    "zh": "真的",
    "vi": "Thật sao"
  },
  {
    "idx": 17897,
    "start": "08:37:22,531",
    "end": "08:37:23,531",
    "start_sec": 31042.531,
    "end_sec": 31043.531,
    "zh": "这是",
    "vi": "Đây là"
  },
  {
    "idx": 17898,
    "start": "08:37:23,531",
    "end": "08:37:25,211",
    "start_sec": 31043.531,
    "end_sec": 31045.211,
    "zh": "如你所见",
    "vi": "Như ngươi thấy"
  },
  {
    "idx": 17899,
    "start": "08:37:25,211",
    "end": "08:37:26,271",
    "start_sec": 31045.211,
    "end_sec": 31046.271,
    "zh": "这里是坟堆",
    "vi": "Đây là một nấm mồ"
  },
  {
    "idx": 17900,
    "start": "08:37:26,271",
    "end": "08:37:28,171",
    "start_sec": 31046.271,
    "end_sec": 31048.171,
    "zh": "准确来说",
    "vi": "Chính xác hơn"
  },
  {
    "idx": 17901,
    "start": "08:37:28,171",
    "end": "08:37:30,691",
    "start_sec": 31048.171,
    "end_sec": 31050.691,
    "zh": "是所有不受控制的御鬼者坟堆",
    "vi": "là nấm mồ của tất cả những người điều khiển quỷ mất kiểm soát"
  },
  {
    "idx": 17902,
    "start": "08:37:30,691",
    "end": "08:37:31,931",
    "start_sec": 31050.691,
    "end_sec": 31051.931,
    "zh": "这些天",
    "vi": "Mấy ngày nay"
  },
  {
    "idx": 17903,
    "start": "08:37:31,931",
    "end": "08:37:33,231",
    "start_sec": 31051.931,
    "end_sec": 31053.231,
    "zh": "我可是看见不少",
    "vi": "ta đã thấy không ít"
  },
  {
    "idx": 17904,
    "start": "08:37:33,231",
    "end": "08:37:34,611",
    "start_sec": 31053.231,
    "end_sec": 31054.611,
    "zh": "疯疯癫癫的御鬼者",
    "vi": "người điều khiển quỷ phát điên"
  },
  {
    "idx": 17905,
    "start": "08:37:34,611",
    "end": "08:37:36,111",
    "start_sec": 31054.611,
    "end_sec": 31056.111,
    "zh": "被送到那个灵医那里",
    "vi": "được đưa đến chỗ Linh Y"
  },
  {
    "idx": 17906,
    "start": "08:37:36,111",
    "end": "08:37:36,851",
    "start_sec": 31056.111,
    "end_sec": 31056.851,
    "zh": "每去一次",
    "vi": "Mỗi lần đi"
  },
  {
    "idx": 17907,
    "start": "08:37:36,851",
    "end": "08:37:38,811",
    "start_sec": 31056.851,
    "end_sec": 31058.811,
    "zh": "这里的地形就会改变一次",
    "vi": "địa hình ở đây lại thay đổi một lần"
  },
  {
    "idx": 17908,
    "start": "08:37:38,811",
    "end": "08:37:40,831",
    "start_sec": 31058.811,
    "end_sec": 31060.831,
    "zh": "直到灵医的房间里恢复平静",
    "vi": "Cho đến khi căn phòng của Linh Y trở lại yên bình"
  },
  {
    "idx": 17909,
    "start": "08:37:40,831",
    "end": "08:37:42,771",
    "start_sec": 31060.831,
    "end_sec": 31062.771,
    "zh": "他在干什么我不清楚",
    "vi": "Ta không rõ hắn đang làm gì"
  },
  {
    "idx": 17910,
    "start": "08:37:42,771",
    "end": "08:37:44,751",
    "start_sec": 31062.771,
    "end_sec": 31064.751,
    "zh": "但是那些失控的御鬼者",
    "vi": "Nhưng những người điều khiển quỷ mất kiểm soát đó"
  },
  {
    "idx": 17911,
    "start": "08:37:44,751",
    "end": "08:37:47,131",
    "start_sec": 31064.751,
    "end_sec": 31067.131,
    "zh": "大抵是被榨干所有价值",
    "vi": "Có lẽ là bị vắt kiệt mọi giá trị."
  },
  {
    "idx": 17912,
    "start": "08:37:47,131",
    "end": "08:37:48,591",
    "start_sec": 31067.131,
    "end_sec": 31068.591,
    "zh": "我埋在这里了",
    "vi": "Rồi bị chôn ở đây."
  },
  {
    "idx": 17913,
    "start": "08:37:48,591",
    "end": "08:37:49,971",
    "start_sec": 31068.591,
    "end_sec": 31069.971,
    "zh": "这地下七层里",
    "vi": "Trong tầng hầm thứ bảy này."
  },
  {
    "idx": 17914,
    "start": "08:37:49,971",
    "end": "08:37:52,091",
    "start_sec": 31069.971,
    "end_sec": 31072.091,
    "zh": "不存在有人能逃过他的控制",
    "vi": "Không một ai có thể thoát khỏi sự kiểm soát của hắn."
  },
  {
    "idx": 17915,
    "start": "08:37:52,091",
    "end": "08:37:54,011",
    "start_sec": 31072.091,
    "end_sec": 31074.011,
    "zh": "这样吗",
    "vi": "Ra là vậy sao."
  },
  {
    "idx": 17916,
    "start": "08:37:54,011",
    "end": "08:37:55,111",
    "start_sec": 31074.011,
    "end_sec": 31075.111,
    "zh": "目前看来",
    "vi": "Theo như hiện tại."
  },
  {
    "idx": 17917,
    "start": "08:37:55,111",
    "end": "08:37:55,791",
    "start_sec": 31075.111,
    "end_sec": 31075.791,
    "zh": "灵异的能力",
    "vi": "Năng lực của Linh Y."
  },
  {
    "idx": 17918,
    "start": "08:37:55,791",
    "end": "08:37:56,671",
    "start_sec": 31075.791,
    "end_sec": 31076.671,
    "zh": "一个是控火",
    "vi": "Một cái là điều khiển lửa."
  },
  {
    "idx": 17919,
    "start": "08:37:56,671",
    "end": "08:37:57,651",
    "start_sec": 31076.671,
    "end_sec": 31077.651,
    "zh": "一个是控土",
    "vi": "Một cái là điều khiển đất."
  },
  {
    "idx": 17920,
    "start": "08:37:57,651",
    "end": "08:37:58,871",
    "start_sec": 31077.651,
    "end_sec": 31078.871,
    "zh": "也就是说",
    "vi": "Nói cách khác."
  },
  {
    "idx": 17921,
    "start": "08:37:58,871",
    "end": "08:38:00,311",
    "start_sec": 31078.871,
    "end_sec": 31080.311,
    "zh": "整个玉鬼者基地地下",
    "vi": "Toàn bộ tầng hầm của căn cứ Ngự Quỷ Giả."
  },
  {
    "idx": 17922,
    "start": "08:38:00,311",
    "end": "08:38:01,511",
    "start_sec": 31080.311,
    "end_sec": 31081.511,
    "zh": "七层都是他的宫殿",
    "vi": "Cả bảy tầng đều là cung điện của hắn."
  },
  {
    "idx": 17923,
    "start": "08:38:01,511",
    "end": "08:38:03,411",
    "start_sec": 31081.511,
    "end_sec": 31083.411,
    "zh": "只要他乐意来一个",
    "vi": "Chỉ cần hắn muốn bắt một người."
  },
  {
    "idx": 17924,
    "start": "08:38:03,411",
    "end": "08:38:05,051",
    "start_sec": 31083.411,
    "end_sec": 31085.051,
    "zh": "他能买一个",
    "vi": "Hắn có thể chôn một người."
  },
  {
    "idx": 17925,
    "start": "08:38:05,051",
    "end": "08:38:06,751",
    "start_sec": 31085.051,
    "end_sec": 31086.751,
    "zh": "话虽如此",
    "vi": "Dù nói thế."
  },
  {
    "idx": 17926,
    "start": "08:38:06,751",
    "end": "08:38:08,811",
    "start_sec": 31086.751,
    "end_sec": 31088.811,
    "zh": "灵异控制那些失控的玉鬼者",
    "vi": "Nhưng việc Linh Y kiểm soát những Ngự Quỷ Giả mất kiểm soát đó."
  },
  {
    "idx": 17927,
    "start": "08:38:08,811",
    "end": "08:38:10,311",
    "start_sec": 31088.811,
    "end_sec": 31090.311,
    "zh": "和我快速做出选择",
    "vi": "Với việc ta nhanh chóng đưa ra lựa chọn."
  },
  {
    "idx": 17928,
    "start": "08:38:10,311",
    "end": "08:38:11,231",
    "start_sec": 31090.311,
    "end_sec": 31091.231,
    "zh": "有什么关系",
    "vi": "Thì có liên quan gì chứ."
  },
  {
    "idx": 17929,
    "start": "08:38:11,231",
    "end": "08:38:12,231",
    "start_sec": 31091.231,
    "end_sec": 31092.231,
    "zh": "那如果",
    "vi": "Vậy nếu như."
  },
  {
    "idx": 17930,
    "start": "08:38:12,231",
    "end": "08:38:13,911",
    "start_sec": 31092.231,
    "end_sec": 31093.911,
    "zh": "那位灵异先生",
    "vi": "Vị Linh Y tiên sinh đó."
  },
  {
    "idx": 17931,
    "start": "08:38:13,911",
    "end": "08:38:15,331",
    "start_sec": 31093.911,
    "end_sec": 31095.331,
    "zh": "连自己也控制不了",
    "vi": "Ngay cả bản thân cũng không kiểm soát được."
  },
  {
    "idx": 17932,
    "start": "08:38:15,331",
    "end": "08:38:17,911",
    "start_sec": 31095.331,
    "end_sec": 31097.911,
    "zh": "你是说",
    "vi": "Ý ngươi là."
  },
  {
    "idx": 17933,
    "start": "08:38:17,911",
    "end": "08:38:20,631",
    "start_sec": 31097.911,
    "end_sec": 31100.631,
    "zh": "没错",
    "vi": "Đúng vậy."
  },
  {
    "idx": 17934,
    "start": "08:38:20,631",
    "end": "08:38:21,731",
    "start_sec": 31100.631,
    "end_sec": 31101.731,
    "zh": "你也知道",
    "vi": "Ngươi cũng biết đấy."
  },
  {
    "idx": 17935,
    "start": "08:38:21,731",
    "end": "08:38:23,111",
    "start_sec": 31101.731,
    "end_sec": 31103.111,
    "zh": "鬼异驾驭的越多",
    "vi": "Càng chế ngự nhiều quỷ dị."
  },
  {
    "idx": 17936,
    "start": "08:38:23,111",
    "end": "08:38:24,751",
    "start_sec": 31103.111,
    "end_sec": 31104.751,
    "zh": "身体就越承受不住",
    "vi": "Cơ thể sẽ càng không chịu đựng nổi."
  },
  {
    "idx": 17937,
    "start": "08:38:24,751",
    "end": "08:38:26,031",
    "start_sec": 31104.751,
    "end_sec": 31106.031,
    "zh": "那位灵异先生",
    "vi": "Vị Linh Y tiên sinh đó."
  },
  {
    "idx": 17938,
    "start": "08:38:26,031",
    "end": "08:38:27,911",
    "start_sec": 31106.031,
    "end_sec": 31107.911,
    "zh": "虽然控制了五只鬼异",
    "vi": "Tuy đã kiểm soát được năm con quỷ dị."
  },
  {
    "idx": 17939,
    "start": "08:38:27,911",
    "end": "08:38:29,931",
    "start_sec": 31107.911,
    "end_sec": 31109.931,
    "zh": "但看来他的资质并不好",
    "vi": "Nhưng xem ra tư chất của hắn không tốt lắm."
  },
  {
    "idx": 17940,
    "start": "08:38:29,931",
    "end": "08:38:31,071",
    "start_sec": 31109.931,
    "end_sec": 31111.071,
    "zh": "每到深夜",
    "vi": "Mỗi khi đêm muộn."
  },
  {
    "idx": 17941,
    "start": "08:38:31,071",
    "end": "08:38:33,451",
    "start_sec": 31111.071,
    "end_sec": 31113.451,
    "zh": "这地下七层都会失控你的虚子",
    "vi": "Tầng hầm thứ bảy này sẽ khiến hư tử của anh mất kiểm soát."
  },
  {
    "idx": 17942,
    "start": "08:38:33,451",
    "end": "08:38:34,171",
    "start_sec": 31113.451,
    "end_sec": 31114.171,
    "zh": "你想想",
    "vi": "Anh nghĩ xem."
  },
  {
    "idx": 17943,
    "start": "08:38:34,171",
    "end": "08:38:36,111",
    "start_sec": 31114.171,
    "end_sec": 31116.111,
    "zh": "他难道是觉得好玩吗",
    "vi": "Lẽ nào anh ta lại nghĩ trò này vui lắm sao."
  },
  {
    "idx": 17944,
    "start": "08:38:36,111",
    "end": "08:38:37,391",
    "start_sec": 31116.111,
    "end_sec": 31117.391,
    "zh": "难怪",
    "vi": "Thảo nào."
  },
  {
    "idx": 17945,
    "start": "08:38:37,391",
    "end": "08:38:40,211",
    "start_sec": 31117.391,
    "end_sec": 31120.211,
    "zh": "难怪他把自己锁在地下七层",
    "vi": "Thảo nào anh ta lại tự khóa mình ở tầng hầm thứ bảy."
  },
  {
    "idx": 17946,
    "start": "08:38:40,211",
    "end": "08:38:41,791",
    "start_sec": 31120.211,
    "end_sec": 31121.791,
    "zh": "是怕自己失控",
    "vi": "Là vì sợ bản thân mất kiểm soát."
  },
  {
    "idx": 17947,
    "start": "08:38:41,791",
    "end": "08:38:43,991",
    "start_sec": 31121.791,
    "end_sec": 31123.991,
    "zh": "所以用土发泄和控制自己吗",
    "vi": "Nên mới dùng đất để giải tỏa và kiểm soát bản thân sao."
  },
  {
    "idx": 17948,
    "start": "08:38:43,991",
    "end": "08:38:45,731",
    "start_sec": 31123.991,
    "end_sec": 31125.731,
    "zh": "就他现在这个样子",
    "vi": "Với tình trạng hiện tại của anh ta."
  },
  {
    "idx": 17949,
    "start": "08:38:45,731",
    "end": "08:38:47,371",
    "start_sec": 31125.731,
    "end_sec": 31127.371,
    "zh": "还想驾驭第六只鬼异吗",
    "vi": "Mà vẫn muốn chế ngự con quỷ thứ sáu sao."
  },
  {
    "idx": 17950,
    "start": "08:38:47,371",
    "end": "08:38:49,031",
    "start_sec": 31127.371,
    "end_sec": 31129.031,
    "zh": "以现在的情况来看",
    "vi": "Nhìn vào tình hình hiện tại."
  },
  {
    "idx": 17951,
    "start": "08:38:49,031",
    "end": "08:38:50,671",
    "start_sec": 31129.031,
    "end_sec": 31130.671,
    "zh": "灵异随时都在失控边缘",
    "vi": "Sức mạnh tâm linh đang ở trên bờ vực mất kiểm soát bất cứ lúc nào."
  },
  {
    "idx": 17952,
    "start": "08:38:50,671",
    "end": "08:38:52,571",
    "start_sec": 31130.671,
    "end_sec": 31132.571,
    "zh": "如果强行驾驭第六只鬼异",
    "vi": "Nếu gượng ép chế ngự con quỷ thứ sáu."
  },
  {
    "idx": 17953,
    "start": "08:38:52,571",
    "end": "08:38:53,971",
    "start_sec": 31132.571,
    "end_sec": 31133.971,
    "zh": "从而镇压0103",
    "vi": "Để từ đó trấn áp không một không ba."
  },
  {
    "idx": 17954,
    "start": "08:38:53,971",
    "end": "08:38:55,311",
    "start_sec": 31133.971,
    "end_sec": 31135.311,
    "zh": "那绝对是大冒险",
    "vi": "Thì đó chắc chắn là một canh bạc lớn."
  },
  {
    "idx": 17955,
    "start": "08:38:55,311",
    "end": "08:38:57,631",
    "start_sec": 31135.311,
    "end_sec": 31137.631,
    "zh": "真是难搞啊",
    "vi": "Thật là nan giải quá đi."
  },
  {
    "idx": 17956,
    "start": "08:38:57,631",
    "end": "08:38:59,291",
    "start_sec": 31137.631,
    "end_sec": 31139.291,
    "zh": "与周扬对峙一言",
    "vi": "Sau khi nhìn Chu Dương một cái."
  },
  {
    "idx": 17957,
    "start": "08:38:59,291",
    "end": "08:39:00,751",
    "start_sec": 31139.291,
    "end_sec": 31140.751,
    "zh": "程子提犹豫片刻",
    "vi": "Trình Tử Đề do dự một lát."
  },
  {
    "idx": 17958,
    "start": "08:39:00,751",
    "end": "08:39:03,251",
    "start_sec": 31140.751,
    "end_sec": 31143.251,
    "zh": "如果真有事在失控的那一天",
    "vi": "Nếu thực sự có ngày mọi chuyện mất kiểm soát."
  },
  {
    "idx": 17959,
    "start": "08:39:03,251",
    "end": "08:39:04,391",
    "start_sec": 31143.251,
    "end_sec": 31144.391,
    "zh": "我会来找你的",
    "vi": "Tôi sẽ đến tìm anh."
  },
  {
    "idx": 17960,
    "start": "08:39:04,391",
    "end": "08:39:05,651",
    "start_sec": 31144.391,
    "end_sec": 31145.651,
    "zh": "行啊",
    "vi": "Được thôi."
  },
  {
    "idx": 17961,
    "start": "08:39:05,651",
    "end": "08:39:07,111",
    "start_sec": 31145.651,
    "end_sec": 31147.111,
    "zh": "记住了",
    "vi": "Nhớ kỹ đấy."
  },
  {
    "idx": 17962,
    "start": "08:39:07,111",
    "end": "08:39:08,311",
    "start_sec": 31147.111,
    "end_sec": 31148.311,
    "zh": "求我办事",
    "vi": "Muốn nhờ tôi giúp đỡ."
  },
  {
    "idx": 17963,
    "start": "08:39:08,311",
    "end": "08:39:10,551",
    "start_sec": 31148.311,
    "end_sec": 31150.551,
    "zh": "给我准备好编号0536的鬼异",
    "vi": "Thì hãy chuẩn bị sẵn con quỷ số hiệu không năm ba sáu cho tôi."
  },
  {
    "idx": 17964,
    "start": "08:39:10,551",
    "end": "08:39:13,031",
    "start_sec": 31150.551,
    "end_sec": 31153.031,
    "zh": "不然我也懒得再去活动了",
    "vi": "Bằng không tôi cũng lười hoạt động tiếp."
  },
  {
    "idx": 17965,
    "start": "08:39:13,031",
    "end": "08:39:14,631",
    "start_sec": 31153.031,
    "end_sec": 31154.631,
    "zh": "死这里算了",
    "vi": "Thà chết ở đây cho xong."
  },
  {
    "idx": 17966,
    "start": "08:39:14,631",
    "end": "08:39:16,671",
    "start_sec": 31154.631,
    "end_sec": 31156.671,
    "zh": "这句无笑话",
    "vi": "Đây không phải là trò đùa đâu."
  },
  {
    "idx": 17967,
    "start": "08:39:16,671",
    "end": "08:39:17,911",
    "start_sec": 31156.671,
    "end_sec": 31157.911,
    "zh": "我连弹跳着",
    "vi": "Tôi liền đi cùng."
  },
  {
    "idx": 17968,
    "start": "08:39:17,911",
    "end": "08:39:19,771",
    "start_sec": 31157.911,
    "end_sec": 31159.771,
    "zh": "带着长子蹄来到电梯前",
    "vi": "Dẫn Trình Tử Đề đến trước thang máy."
  },
  {
    "idx": 17969,
    "start": "08:39:19,771",
    "end": "08:39:21,851",
    "start_sec": 31159.771,
    "end_sec": 31161.851,
    "zh": "按下地下四棚",
    "vi": "Nhấn nút xuống tầng hầm thứ tư."
  },
  {
    "idx": 17970,
    "start": "08:39:21,851",
    "end": "08:39:23,991",
    "start_sec": 31161.851,
    "end_sec": 31163.991,
    "zh": "回到022别墅",
    "vi": "Trở về biệt thự không hai hai."
  },
  {
    "idx": 17971,
    "start": "08:39:23,991",
    "end": "08:39:25,631",
    "start_sec": 31163.991,
    "end_sec": 31165.631,
    "zh": "夏叔",
    "vi": "Chú Hạ"
  },
  {
    "idx": 17972,
    "start": "08:39:25,631",
    "end": "08:39:26,511",
    "start_sec": 31165.631,
    "end_sec": 31166.511,
    "zh": "我回来了",
    "vi": "Cháu về rồi đây"
  },
  {
    "idx": 17973,
    "start": "08:39:46,671",
    "end": "08:39:48,071",
    "start_sec": 31186.671,
    "end_sec": 31188.071,
    "zh": "夏叔",
    "vi": "Chú Hạ"
  },
  {
    "idx": 17974,
    "start": "08:39:48,071",
    "end": "08:39:48,971",
    "start_sec": 31188.071,
    "end_sec": 31188.971,
    "zh": "我回来了",
    "vi": "Cháu về rồi đây"
  },
  {
    "idx": 17975,
    "start": "08:39:48,971",
    "end": "08:39:50,451",
    "start_sec": 31188.971,
    "end_sec": 31190.451,
    "zh": "小程",
    "vi": "Tiểu Trình"
  },
  {
    "idx": 17976,
    "start": "08:39:50,451",
    "end": "08:39:51,891",
    "start_sec": 31190.451,
    "end_sec": 31191.891,
    "zh": "你终于回来了",
    "vi": "Cuối cùng cháu cũng về rồi"
  },
  {
    "idx": 17977,
    "start": "08:39:51,891",
    "end": "08:39:53,251",
    "start_sec": 31191.891,
    "end_sec": 31193.251,
    "zh": "这次回来了",
    "vi": "Lần này về rồi"
  },
  {
    "idx": 17978,
    "start": "08:39:53,251",
    "end": "08:39:54,851",
    "start_sec": 31193.251,
    "end_sec": 31194.851,
    "zh": "就不用急着出去了",
    "vi": "Thì không cần vội đi ngay nữa chứ"
  },
  {
    "idx": 17979,
    "start": "08:39:54,851",
    "end": "08:39:56,111",
    "start_sec": 31194.851,
    "end_sec": 31196.111,
    "zh": "不用了",
    "vi": "Dạ không cần nữa ạ"
  },
  {
    "idx": 17980,
    "start": "08:39:56,111",
    "end": "08:39:57,571",
    "start_sec": 31196.111,
    "end_sec": 31197.571,
    "zh": "得歇上几天",
    "vi": "Cháu phải nghỉ ngơi vài ngày"
  },
  {
    "idx": 17981,
    "start": "08:39:57,571",
    "end": "08:39:59,391",
    "start_sec": 31197.571,
    "end_sec": 31199.391,
    "zh": "那就好",
    "vi": "Thế thì tốt quá"
  },
  {
    "idx": 17982,
    "start": "08:40:00,720",
    "end": "08:40:06,860",
    "start_sec": 31200.72,
    "end_sec": 31206.86,
    "zh": "夏叔满脸笑意,突然脸色又变得凝重起来,成小子,你,你的面相。",
    "vi": "Chú Hạ đầy mặt cười vui, đột nhiên sắc mặt lại trở nên nghiêm trọng, nhóc Trình, tướng mạo của cháu."
  },
  {
    "idx": 17983,
    "start": "08:40:07,700",
    "end": "08:40:08,820",
    "start_sec": 31207.7,
    "end_sec": 31208.82,
    "zh": "我的面相怎么了吗?",
    "vi": "Tướng mạo của cháu bị sao thế ạ."
  },
  {
    "idx": 17984,
    "start": "08:40:09,440",
    "end": "08:40:14,240",
    "start_sec": 31209.44,
    "end_sec": 31214.24,
    "zh": "夏叔,我看你的面相好像有点不入世啊。",
    "vi": "Chú thấy tướng mạo của cháu dường như có chút không thuộc về thế gian này."
  },
  {
    "idx": 17985,
    "start": "08:40:14,460",
    "end": "08:40:16,400",
    "start_sec": 31214.46,
    "end_sec": 31216.4,
    "zh": "不入世?有什么说法吗?",
    "vi": "Không thuộc về thế gian này. Có cách giải thích nào không chú."
  },
  {
    "idx": 17986,
    "start": "08:40:17,300",
    "end": "08:40:19,280",
    "start_sec": 31217.3,
    "end_sec": 31219.28,
    "zh": "就是,就是不像个人。",
    "vi": "Nghĩa là, nghĩa là không giống một con người."
  },
  {
    "idx": 17987,
    "start": "08:40:20,020",
    "end": "08:40:24,618",
    "start_sec": 31220.02,
    "end_sec": 31224.618,
    "zh": "啊,别误会,我说的不像个人,是指你的面相现在没有普通人的面板推测。",
    "vi": "À, đừng hiểu lầm, chú nói không giống con người là ý chỉ tướng mạo của cháu hiện tại"
  },
  {
    "idx": 17987,
    "start": "08:40:24,618",
    "end": "08:40:27,280",
    "start_sec": 31224.618,
    "end_sec": 31227.28,
    "zh": "啊,别误会,我说的不像个人,是指你的面相现在没有普通人的面板推测。",
    "vi": "không có vận mệnh để suy đoán như người bình thường."
  },
  {
    "idx": 17988,
    "start": "08:40:27,280",
    "end": "08:40:30,660",
    "start_sec": 31227.28,
    "end_sec": 31230.66,
    "zh": "三情十六风可以看出人的气韵走向",
    "vi": "Tam đình thập lục phong có thể nhìn ra hướng đi của khí vận con người"
  },
  {
    "idx": 17989,
    "start": "08:40:30,660",
    "end": "08:40:31,220",
    "start_sec": 31230.66,
    "end_sec": 31231.22,
    "zh": "和你",
    "vi": "Nhưng cháu"
  },
  {
    "idx": 17990,
    "start": "08:40:31,220",
    "end": "08:40:33,020",
    "start_sec": 31231.22,
    "end_sec": 31233.02,
    "zh": "就像是被抹去了什么",
    "vi": "Giống như đã bị xóa đi thứ gì đó"
  },
  {
    "idx": 17991,
    "start": "08:40:33,020",
    "end": "08:40:34,500",
    "start_sec": 31233.02,
    "end_sec": 31234.5,
    "zh": "面相一片空白",
    "vi": "Tướng mạo hoàn toàn trống rỗng"
  },
  {
    "idx": 17992,
    "start": "08:40:34,500",
    "end": "08:40:36,860",
    "start_sec": 31234.5,
    "end_sec": 31236.86,
    "zh": "你是经历了什么吗",
    "vi": "Cháu đã trải qua chuyện gì sao"
  },
  {
    "idx": 17993,
    "start": "08:40:36,860",
    "end": "08:40:39,400",
    "start_sec": 31236.86,
    "end_sec": 31239.4,
    "zh": "想到普宁街道疫情发生的事",
    "vi": "Nghĩ đến chuyện xảy ra trong dịch bệnh ở phố Phổ Ninh"
  },
  {
    "idx": 17994,
    "start": "08:40:39,400",
    "end": "08:40:40,920",
    "start_sec": 31239.4,
    "end_sec": 31240.92,
    "zh": "橙子皮若有所资",
    "vi": "Trình Tử Bì như suy nghĩ điều gì"
  },
  {
    "idx": 17995,
    "start": "08:40:40,920",
    "end": "08:40:42,180",
    "start_sec": 31240.92,
    "end_sec": 31242.18,
    "zh": "没事的",
    "vi": "Không sao đâu ạ"
  },
  {
    "idx": 17996,
    "start": "08:40:42,180",
    "end": "08:40:44,080",
    "start_sec": 31242.18,
    "end_sec": 31244.08,
    "zh": "可能是我跟鬼一气出多了吧",
    "vi": "Có lẽ là do cháu tiếp xúc với quỷ nhiều quá thôi"
  },
  {
    "idx": 17997,
    "start": "08:40:44,080",
    "end": "08:40:45,100",
    "start_sec": 31244.08,
    "end_sec": 31245.1,
    "zh": "好吧",
    "vi": "Được rồi"
  },
  {
    "idx": 17998,
    "start": "08:40:45,100",
    "end": "08:40:48,120",
    "start_sec": 31245.1,
    "end_sec": 31248.12,
    "zh": "听说你们下个月就要去什么鬼界了",
    "vi": "Nghe nói tháng sau các cháu phải đến quỷ giới gì đó rồi"
  },
  {
    "idx": 17999,
    "start": "08:40:48,120",
    "end": "08:40:49,960",
    "start_sec": 31248.12,
    "end_sec": 31249.96,
    "zh": "你这面相都消失了",
    "vi": "Tướng mạo này của cháu đã biến mất rồi"
  },
  {
    "idx": 18000,
    "start": "08:40:49,960",
    "end": "08:40:51,380",
    "start_sec": 31249.96,
    "end_sec": 31251.38,
    "zh": "一定要小心啊",
    "vi": "Nhất định phải cẩn thận đấy"
  },
  {
    "idx": 18001,
    "start": "08:40:51,380",
    "end": "08:40:52,560",
    "start_sec": 31251.38,
    "end_sec": 31252.56,
    "zh": "放心吧",
    "vi": "Chú yên tâm đi."
  },
  {
    "idx": 18002,
    "start": "08:40:52,560",
    "end": "08:40:53,960",
    "start_sec": 31252.56,
    "end_sec": 31253.96,
    "zh": "我会注意的",
    "vi": "Cháu sẽ chú ý."
  },
  {
    "idx": 18003,
    "start": "08:40:53,960",
    "end": "08:40:54,660",
    "start_sec": 31253.96,
    "end_sec": 31254.66,
    "zh": "夏叔",
    "vi": "Chú Hạ."
  },
  {
    "idx": 18004,
    "start": "08:40:54,660",
    "end": "08:40:56,260",
    "start_sec": 31254.66,
    "end_sec": 31256.26,
    "zh": "好久没吃你的酥粥了",
    "vi": "Lâu rồi cháu không được ăn cháo sữa của chú."
  },
  {
    "idx": 18005,
    "start": "08:40:56,260",
    "end": "08:40:57,960",
    "start_sec": 31256.26,
    "end_sec": 31257.96,
    "zh": "你能去做点吗",
    "vi": "Chú có thể nấu một ít được không."
  },
  {
    "idx": 18006,
    "start": "08:40:57,960",
    "end": "08:40:59,040",
    "start_sec": 31257.96,
    "end_sec": 31259.04,
    "zh": "没问题",
    "vi": "Không vấn đề gì."
  },
  {
    "idx": 18007,
    "start": "08:40:59,040",
    "end": "08:41:01,880",
    "start_sec": 31259.04,
    "end_sec": 31261.88,
    "zh": "待会我会让曹红给你送去的",
    "vi": "Lát nữa chú sẽ bảo Tào Hồng mang qua cho cháu."
  },
  {
    "idx": 18008,
    "start": "08:41:01,880",
    "end": "08:41:03,020",
    "start_sec": 31261.88,
    "end_sec": 31263.02,
    "zh": "只还夏叔",
    "vi": "Sau khi tiễn chú Hạ đi."
  },
  {
    "idx": 18009,
    "start": "08:41:03,020",
    "end": "08:41:05,500",
    "start_sec": 31263.02,
    "end_sec": 31265.5,
    "zh": "长子提回到我身边",
    "vi": "Suy nghĩ của tôi lại quay về thực tại."
  },
  {
    "idx": 18010,
    "start": "08:41:05,500",
    "end": "08:41:07,820",
    "start_sec": 31265.5,
    "end_sec": 31267.82,
    "zh": "在普宁街道面对记忆鬼的时候",
    "vi": "Khi đối mặt với quỷ ký ức ở phố Phổ Ninh."
  },
  {
    "idx": 18011,
    "start": "08:41:07,820",
    "end": "08:41:09,320",
    "start_sec": 31267.82,
    "end_sec": 31269.32,
    "zh": "我和过去的我联系",
    "vi": "Tôi đã liên lạc với bản thân trong quá khứ."
  },
  {
    "idx": 18012,
    "start": "08:41:09,320",
    "end": "08:41:10,500",
    "start_sec": 31269.32,
    "end_sec": 31270.5,
    "zh": "不用通过手机",
    "vi": "Mà không cần thông qua điện thoại."
  },
  {
    "idx": 18013,
    "start": "08:41:10,500",
    "end": "08:41:11,840",
    "start_sec": 31270.5,
    "end_sec": 31271.84,
    "zh": "在脑海里就能对话",
    "vi": "Chỉ cần đối thoại trong đầu."
  },
  {
    "idx": 18014,
    "start": "08:41:11,840",
    "end": "08:41:14,600",
    "start_sec": 31271.84,
    "end_sec": 31274.6,
    "zh": "难道我的体内真的还有什么",
    "vi": "Chẳng lẽ trong cơ thể tôi thực sự còn thứ gì đó."
  },
  {
    "idx": 18015,
    "start": "08:41:14,600",
    "end": "08:41:15,880",
    "start_sec": 31274.6,
    "end_sec": 31275.88,
    "zh": "穿越时间",
    "vi": "Vượt qua thời gian."
  },
  {
    "idx": 18016,
    "start": "08:41:15,880",
    "end": "08:41:17,720",
    "start_sec": 31275.88,
    "end_sec": 31277.72,
    "zh": "如果真的有这股力量",
    "vi": "Nếu thực sự có nguồn sức mạnh này."
  },
  {
    "idx": 18017,
    "start": "08:41:17,720",
    "end": "08:41:19,640",
    "start_sec": 31277.72,
    "end_sec": 31279.64,
    "zh": "我能控制它去做什么吗",
    "vi": "Tôi có thể kiểm soát nó để làm gì không."
  },
  {
    "idx": 18018,
    "start": "08:41:19,640",
    "end": "08:41:21,600",
    "start_sec": 31279.64,
    "end_sec": 31281.6,
    "zh": "夏叔说我的面相变了",
    "vi": "Chú Hạ nói tướng mạo của tôi đã thay đổi."
  },
  {
    "idx": 18019,
    "start": "08:41:21,600",
    "end": "08:41:22,340",
    "start_sec": 31281.6,
    "end_sec": 31282.34,
    "zh": "是因为",
    "vi": "Có phải là vì."
  },
  {
    "idx": 18020,
    "start": "08:41:22,340",
    "end": "08:41:24,040",
    "start_sec": 31282.34,
    "end_sec": 31284.04,
    "zh": "这次我开始可以不用手机",
    "vi": "Lần này tôi bắt đầu có thể không dùng điện thoại."
  },
  {
    "idx": 18021,
    "start": "08:41:24,040",
    "end": "08:41:25,600",
    "start_sec": 31284.04,
    "end_sec": 31285.6,
    "zh": "联系过去导致的吗",
    "vi": "Mà vẫn liên lạc được với quá khứ gây ra không."
  },
  {
    "idx": 18022,
    "start": "08:41:25,600",
    "end": "08:41:27,160",
    "start_sec": 31285.6,
    "end_sec": 31287.16,
    "zh": "思绪打乱间",
    "vi": "Trong lúc suy nghĩ đang hỗn loạn."
  },
  {
    "idx": 18023,
    "start": "08:41:27,160",
    "end": "08:41:28,700",
    "start_sec": 31287.16,
    "end_sec": 31288.7,
    "zh": "白旭发了一条私信",
    "vi": "Bạch Húc đã gửi một tin nhắn riêng."
  },
  {
    "idx": 18024,
    "start": "08:41:28,700",
    "end": "08:41:29,840",
    "start_sec": 31288.7,
    "end_sec": 31289.84,
    "zh": "我靠",
    "vi": "Trời đất ơi."
  },
  {
    "idx": 18025,
    "start": "08:41:29,840",
    "end": "08:41:30,480",
    "start_sec": 31289.84,
    "end_sec": 31290.48,
    "zh": "发了",
    "vi": "Giàu to rồi."
  },
  {
    "idx": 18026,
    "start": "08:41:30,480",
    "end": "08:41:32,980",
    "start_sec": 31290.48,
    "end_sec": 31292.98,
    "zh": "这次任务给了一万点功勋点",
    "vi": "Nhiệm vụ lần này được tặng mười nghìn điểm công huân."
  },
  {
    "idx": 18027,
    "start": "08:41:32,980",
    "end": "08:41:33,720",
    "start_sec": 31292.98,
    "end_sec": 31293.72,
    "zh": "卧槽",
    "vi": "Vãi thật."
  },
  {
    "idx": 18028,
    "start": "08:41:33,720",
    "end": "08:41:34,500",
    "start_sec": 31293.72,
    "end_sec": 31294.5,
    "zh": "兄弟",
    "vi": "Người anh em."
  },
  {
    "idx": 18029,
    "start": "08:41:34,500",
    "end": "08:41:36,340",
    "start_sec": 31294.5,
    "end_sec": 31296.34,
    "zh": "老子算是抱对大腿了",
    "vi": "Tao đúng là ôm đùi chuẩn rồi."
  },
  {
    "idx": 18030,
    "start": "08:41:36,340",
    "end": "08:41:37,860",
    "start_sec": 31296.34,
    "end_sec": 31297.86,
    "zh": "不行不行",
    "vi": "Không được không được."
  },
  {
    "idx": 18031,
    "start": "08:41:37,860",
    "end": "08:41:39,300",
    "start_sec": 31297.86,
    "end_sec": 31299.3,
    "zh": "这次跟你后面躺赢",
    "vi": "Lần này đi theo cậu được gánh dễ dàng."
  },
  {
    "idx": 18032,
    "start": "08:41:39,300",
    "end": "08:41:40,360",
    "start_sec": 31299.3,
    "end_sec": 31300.36,
    "zh": "还赚了这么多",
    "vi": "Lại còn kiếm được nhiều thế này."
  },
  {
    "idx": 18033,
    "start": "08:41:40,360",
    "end": "08:41:41,520",
    "start_sec": 31300.36,
    "end_sec": 31301.52,
    "zh": "你这样的",
    "vi": "Người như cậu."
  },
  {
    "idx": 18034,
    "start": "08:41:41,520",
    "end": "08:41:43,100",
    "start_sec": 31301.52,
    "end_sec": 31303.1,
    "zh": "晚上和我出去一趟",
    "vi": "Tối nay ra ngoài với tớ một chuyến."
  },
  {
    "idx": 18035,
    "start": "08:41:43,100",
    "end": "08:41:44,540",
    "start_sec": 31303.1,
    "end_sec": 31304.54,
    "zh": "我给你找五个嫩模",
    "vi": "Tớ tìm cho cậu năm người mẫu trẻ đẹp."
  },
  {
    "idx": 18036,
    "start": "08:41:44,540",
    "end": "08:41:45,760",
    "start_sec": 31304.54,
    "end_sec": 31305.76,
    "zh": "卧槽",
    "vi": "Chết tiệt."
  },
  {
    "idx": 18037,
    "start": "08:41:45,760",
    "end": "08:41:46,620",
    "start_sec": 31305.76,
    "end_sec": 31306.62,
    "zh": "无语了",
    "vi": "Cạn lời luôn."
  },
  {
    "idx": 18038,
    "start": "08:41:46,620",
    "end": "08:41:47,800",
    "start_sec": 31306.62,
    "end_sec": 31307.8,
    "zh": "白旭最后下面",
    "vi": "Bạch Húc cuối cùng."
  },
  {
    "idx": 18039,
    "start": "08:41:47,800",
    "end": "08:41:49,200",
    "start_sec": 31307.8,
    "end_sec": 31309.2,
    "zh": "是不是长脑子了",
    "vi": "Có phải là đã thông minh hơn rồi không."
  },
  {
    "idx": 18040,
    "start": "08:41:49,200",
    "end": "08:41:51,900",
    "start_sec": 31309.2,
    "end_sec": 31311.9,
    "zh": "六万六的功勋点",
    "vi": "Sáu mươi sáu nghìn điểm công huân."
  },
  {
    "idx": 18041,
    "start": "08:41:51,900",
    "end": "08:41:53,760",
    "start_sec": 31311.9,
    "end_sec": 31313.76,
    "zh": "离开玉鬼越来越近了",
    "vi": "Ngày càng đến gần việc rời khỏi Ngọc Quỷ rồi."
  },
  {
    "idx": 18042,
    "start": "08:41:53,760",
    "end": "08:41:55,300",
    "start_sec": 31313.76,
    "end_sec": 31315.3,
    "zh": "还有猪羊那个家伙",
    "vi": "Còn có tên Chu Dương kia nữa."
  },
  {
    "idx": 18043,
    "start": "08:41:55,300",
    "end": "08:41:57,260",
    "start_sec": 31315.3,
    "end_sec": 31317.26,
    "zh": "要什么编号0536的诡异",
    "vi": "Đòi cái thứ quỷ dị số hiệu không năm ba sáu gì đó."
  },
  {
    "idx": 18044,
    "start": "08:41:57,260",
    "end": "08:41:59,660",
    "start_sec": 31317.26,
    "end_sec": 31319.66,
    "zh": "我倒要看看是什么玩意",
    "vi": "Tớ phải xem thử đó là cái thứ gì."
  },
  {
    "idx": 18045,
    "start": "08:41:59,660",
    "end": "08:42:02,160",
    "start_sec": 31319.66,
    "end_sec": 31322.16,
    "zh": "我草",
    "vi": "Trời đất ơi."
  },
  {
    "idx": 18046,
    "start": "08:42:02,160",
    "end": "08:42:02,980",
    "start_sec": 31322.16,
    "end_sec": 31322.98,
    "zh": "复制鬼",
    "vi": "Quỷ sao chép."
  },
  {
    "idx": 18047,
    "start": "08:42:02,980",
    "end": "08:42:04,240",
    "start_sec": 31322.98,
    "end_sec": 31324.24,
    "zh": "三分钟复制",
    "vi": "Sao chép trong ba phút."
  },
  {
    "idx": 18048,
    "start": "08:42:04,240",
    "end": "08:42:05,360",
    "start_sec": 31324.24,
    "end_sec": 31325.36,
    "zh": "八万公顷点",
    "vi": "Tám mươi nghìn điểm công huân."
  },
  {
    "idx": 18049,
    "start": "08:42:05,360",
    "end": "08:42:07,600",
    "start_sec": 31325.36,
    "end_sec": 31327.6,
    "zh": "周扬也推狮子大菜口了吧",
    "vi": "Chu Dương cũng đòi hỏi quá đáng quá rồi đó."
  },
  {
    "idx": 18050,
    "start": "08:42:07,600",
    "end": "08:42:09,620",
    "start_sec": 31327.6,
    "end_sec": 31329.62,
    "zh": "橙子皮",
    "vi": "Trần Tử Bì."
  },
  {
    "idx": 18051,
    "start": "08:42:09,620",
    "end": "08:42:10,960",
    "start_sec": 31329.62,
    "end_sec": 31330.96,
    "zh": "你在家吗",
    "vi": "Cậu có nhà không."
  },
  {
    "idx": 18052,
    "start": "08:42:10,960",
    "end": "08:42:12,400",
    "start_sec": 31330.96,
    "end_sec": 31332.4,
    "zh": "你在家吧",
    "vi": "Cậu đang ở nhà đúng không."
  },
  {
    "idx": 18053,
    "start": "08:42:12,400",
    "end": "08:42:15,400",
    "start_sec": 31332.4,
    "end_sec": 31335.4,
    "zh": "你干嘛",
    "vi": "Cậu làm gì thế."
  },
  {
    "idx": 18054,
    "start": "08:42:15,400",
    "end": "08:42:17,380",
    "start_sec": 31335.4,
    "end_sec": 31337.38,
    "zh": "我跟你说",
    "vi": "Tớ nói cho cậu nghe này."
  },
  {
    "idx": 18055,
    "start": "08:42:17,380",
    "end": "08:42:19,780",
    "start_sec": 31337.38,
    "end_sec": 31339.78,
    "zh": "二楼新来了不少京市以前的模特",
    "vi": "Tầng hai mới đến không ít người mẫu trước đây ở Kinh Thị."
  },
  {
    "idx": 18056,
    "start": "08:42:19,780",
    "end": "08:42:21,020",
    "start_sec": 31339.78,
    "end_sec": 31341.02,
    "zh": "走走走",
    "vi": "Đi thôi đi thôi."
  },
  {
    "idx": 18057,
    "start": "08:42:21,020",
    "end": "08:42:22,420",
    "start_sec": 31341.02,
    "end_sec": 31342.42,
    "zh": "今天所有的消费",
    "vi": "Hôm nay mọi chi phí tiêu dùng."
  },
  {
    "idx": 18058,
    "start": "08:42:22,420",
    "end": "08:42:23,520",
    "start_sec": 31342.42,
    "end_sec": 31343.52,
    "zh": "我白去买单",
    "vi": "Bạch Húc tớ sẽ bao hết."
  },
  {
    "idx": 18059,
    "start": "08:42:23,520",
    "end": "08:42:24,700",
    "start_sec": 31343.52,
    "end_sec": 31344.7,
    "zh": "好好放松下",
    "vi": "Hãy thư giãn thật tốt đi."
  },
  {
    "idx": 18060,
    "start": "08:42:24,700",
    "end": "08:42:27,820",
    "start_sec": 31344.7,
    "end_sec": 31347.82,
    "zh": "哼 不去 我想多睡会儿",
    "vi": "Hừ không đi đâu tớ muốn ngủ thêm một lát."
  },
  {
    "idx": 18061,
    "start": "08:42:27,820",
    "end": "08:42:29,100",
    "start_sec": 31347.82,
    "end_sec": 31349.1,
    "zh": "哎哟 你客气什么",
    "vi": "Này, khách sáo làm gì."
  },
  {
    "idx": 18062,
    "start": "08:42:29,100",
    "end": "08:42:31,980",
    "start_sec": 31349.1,
    "end_sec": 31351.98,
    "zh": "我给你点十个 十个脱衣女郎",
    "vi": "Tôi gọi cho bạn mười cô vũ nữ thoát y."
  },
  {
    "idx": 18063,
    "start": "08:42:31,980",
    "end": "08:42:33,440",
    "start_sec": 31351.98,
    "end_sec": 31353.44,
    "zh": "享享这次机",
    "vi": "Tận hưởng cơ hội này đi."
  },
  {
    "idx": 18064,
    "start": "08:42:33,440",
    "end": "08:42:35,100",
    "start_sec": 31353.44,
    "end_sec": 31355.1,
    "zh": "滚犊子",
    "vi": "Cút đi cho khuất mắt."
  },
  {
    "idx": 18065,
    "start": "08:42:35,100",
    "end": "08:42:39,020",
    "start_sec": 31355.1,
    "end_sec": 31359.02,
    "zh": "我草 橙子皮 你没想昏昏",
    "vi": "Chết tiệt, Trần Tử Bì, bạn không định ngủ đấy chứ."
  },
  {
    "idx": 18066,
    "start": "08:42:39,020",
    "end": "08:42:43,160",
    "start_sec": 31359.02,
    "end_sec": 31363.16,
    "zh": "回到房间 橙子皮躺床上眯了一会儿",
    "vi": "Trở về phòng, Trần Tử Bì nằm trên giường chợp mắt một lúc."
  },
  {
    "idx": 18067,
    "start": "08:42:43,160",
    "end": "08:42:45,580",
    "start_sec": 31363.16,
    "end_sec": 31365.58,
    "zh": "直到傍晚 她的房门被轻声敲响",
    "vi": "Đến tận chập tối, cửa phòng cô mới vang lên tiếng gõ nhẹ."
  },
  {
    "idx": 18068,
    "start": "08:42:45,580",
    "end": "08:42:47,340",
    "start_sec": 31365.58,
    "end_sec": 31367.34,
    "zh": "是桃红吗",
    "vi": "Là Đào Hồng phải không."
  },
  {
    "idx": 18069,
    "start": "08:42:47,340",
    "end": "08:42:49,660",
    "start_sec": 31367.34,
    "end_sec": 31369.66,
    "zh": "只有你放在门口 我带回去拿",
    "vi": "Bạn cứ để ở cửa đi, tôi sẽ ra lấy."
  },
  {
    "idx": 18070,
    "start": "08:42:49,660",
    "end": "08:42:51,680",
    "start_sec": 31369.66,
    "end_sec": 31371.68,
    "zh": "那个 橙哥 我",
    "vi": "Cái đó, anh Cam, tôi."
  },
  {
    "idx": 18071,
    "start": "08:42:51,680",
    "end": "08:42:53,880",
    "start_sec": 31371.68,
    "end_sec": 31373.88,
    "zh": "我听说白先生找你",
    "vi": "Tôi nghe nói ông Bạch tìm anh."
  },
  {
    "idx": 18072,
    "start": "08:42:53,880",
    "end": "08:42:54,860",
    "start_sec": 31373.88,
    "end_sec": 31374.86,
    "zh": "找你去那个",
    "vi": "Tìm anh để làm cái việc đó."
  },
  {
    "idx": 18073,
    "start": "08:42:54,860",
    "end": "08:42:55,920",
    "start_sec": 31374.86,
    "end_sec": 31375.92,
    "zh": "不用管他",
    "vi": "Không cần quan tâm đến ông ta."
  },
  {
    "idx": 18074,
    "start": "08:42:55,920",
    "end": "08:42:56,800",
    "start_sec": 31375.92,
    "end_sec": 31376.8,
    "zh": "他是傻逼",
    "vi": "Ông ta là đồ ngốc."
  },
  {
    "idx": 18075,
    "start": "08:42:56,800",
    "end": "08:42:57,960",
    "start_sec": 31376.8,
    "end_sec": 31377.96,
    "zh": "诚哥",
    "vi": "Anh Cam."
  },
  {
    "idx": 18076,
    "start": "08:42:57,960",
    "end": "08:42:58,680",
    "start_sec": 31377.96,
    "end_sec": 31378.68,
    "zh": "其实",
    "vi": "Thật ra."
  },
  {
    "idx": 18077,
    "start": "08:42:58,680",
    "end": "08:42:59,900",
    "start_sec": 31378.68,
    "end_sec": 31379.9,
    "zh": "其实我",
    "vi": "Thật ra tôi."
  },
  {
    "idx": 18078,
    "start": "08:42:59,900",
    "end": "08:43:01,700",
    "start_sec": 31379.9,
    "end_sec": 31381.7,
    "zh": "我买了件很性感的内衣",
    "vi": "Tôi đã mua một bộ đồ lót rất gợi cảm."
  },
  {
    "idx": 18079,
    "start": "08:43:01,700",
    "end": "08:43:02,620",
    "start_sec": 31381.7,
    "end_sec": 31382.62,
    "zh": "你要不要",
    "vi": "Anh có muốn không."
  },
  {
    "idx": 18080,
    "start": "08:43:02,620",
    "end": "08:43:04,620",
    "start_sec": 31382.62,
    "end_sec": 31384.62,
    "zh": "桃红",
    "vi": "Đào Hồng."
  },
  {
    "idx": 18081,
    "start": "08:43:04,620",
    "end": "08:43:06,300",
    "start_sec": 31384.62,
    "end_sec": 31386.3,
    "zh": "我知道你可能是不好意思",
    "vi": "Tôi biết có thể bạn thấy ngại."
  },
  {
    "idx": 18082,
    "start": "08:43:06,300",
    "end": "08:43:06,960",
    "start_sec": 31386.3,
    "end_sec": 31386.96,
    "zh": "待在这里",
    "vi": "Khi ở đây."
  },
  {
    "idx": 18083,
    "start": "08:43:06,960",
    "end": "08:43:08,320",
    "start_sec": 31386.96,
    "end_sec": 31388.32,
    "zh": "想要为我做些什么",
    "vi": "Bạn muốn làm gì đó cho tôi."
  },
  {
    "idx": 18084,
    "start": "08:43:08,320",
    "end": "08:43:09,140",
    "start_sec": 31388.32,
    "end_sec": 31389.14,
    "zh": "不是的",
    "vi": "Không phải đâu."
  },
  {
    "idx": 18085,
    "start": "08:43:09,140",
    "end": "08:43:09,680",
    "start_sec": 31389.14,
    "end_sec": 31389.68,
    "zh": "诚哥",
    "vi": "Anh Cam."
  },
  {
    "idx": 18086,
    "start": "08:43:09,680",
    "end": "08:43:10,380",
    "start_sec": 31389.68,
    "end_sec": 31390.38,
    "zh": "其实",
    "vi": "Thật ra."
  },
  {
    "idx": 18087,
    "start": "08:43:10,380",
    "end": "08:43:12,240",
    "start_sec": 31390.38,
    "end_sec": 31392.24,
    "zh": "其实我也喜欢你来着",
    "vi": "Thật ra tôi cũng thích anh."
  },
  {
    "idx": 18088,
    "start": "08:43:12,240",
    "end": "08:43:14,420",
    "start_sec": 31392.24,
    "end_sec": 31394.42,
    "zh": "这样啊",
    "vi": "Ra là vậy."
  },
  {
    "idx": 18089,
    "start": "08:43:14,420",
    "end": "08:43:16,040",
    "start_sec": 31394.42,
    "end_sec": 31396.04,
    "zh": "这样的话就更不行了",
    "vi": "Nếu vậy thì lại càng không được."
  },
  {
    "idx": 18090,
    "start": "08:43:16,040",
    "end": "08:43:17,560",
    "start_sec": 31396.04,
    "end_sec": 31397.56,
    "zh": "白旭主张及时行乐",
    "vi": "Bạch Húc chủ trương sống cho hiện tại."
  },
  {
    "idx": 18091,
    "start": "08:43:17,560",
    "end": "08:43:18,600",
    "start_sec": 31397.56,
    "end_sec": 31398.6,
    "zh": "和我不一样",
    "vi": "Không giống như tôi."
  },
  {
    "idx": 18092,
    "start": "08:43:18,600",
    "end": "08:43:19,660",
    "start_sec": 31398.6,
    "end_sec": 31399.66,
    "zh": "生死未卜",
    "vi": "Sống chết chưa rõ."
  },
  {
    "idx": 18093,
    "start": "08:43:19,660",
    "end": "08:43:20,820",
    "start_sec": 31399.66,
    "end_sec": 31400.82,
    "zh": "前路坎坷",
    "vi": "Đường phía trước gập ghềnh."
  },
  {
    "idx": 18094,
    "start": "08:43:20,820",
    "end": "08:43:22,680",
    "start_sec": 31400.82,
    "end_sec": 31402.68,
    "zh": "大家现在都是如履薄冰",
    "vi": "Mọi người bây giờ đều như đi trên băng mỏng."
  },
  {
    "idx": 18095,
    "start": "08:43:22,680",
    "end": "08:43:23,880",
    "start_sec": 31402.68,
    "end_sec": 31403.88,
    "zh": "能否走到最后",
    "vi": "Liệu có thể đi đến cuối cùng."
  },
  {
    "idx": 18096,
    "start": "08:43:23,880",
    "end": "08:43:25,040",
    "start_sec": 31403.88,
    "end_sec": 31405.04,
    "zh": "谁也不敢肯定",
    "vi": "Không ai dám chắc chắn."
  },
  {
    "idx": 18097,
    "start": "08:43:25,040",
    "end": "08:43:27,840",
    "start_sec": 31405.04,
    "end_sec": 31407.84,
    "zh": "我现在不配成为任何一个人的精神寄托",
    "vi": "Tôi bây giờ không xứng đáng làm chỗ dựa tinh thần cho bất kỳ ai."
  },
  {
    "idx": 18098,
    "start": "08:43:27,840",
    "end": "08:43:31,120",
    "start_sec": 31407.84,
    "end_sec": 31411.12,
    "zh": "陶红去歇着吧",
    "vi": "Đào Hồng đi nghỉ ngơi đi."
  },
  {
    "idx": 18099,
    "start": "08:43:31,120",
    "end": "08:43:32,400",
    "start_sec": 31411.12,
    "end_sec": 31412.4,
    "zh": "长子提观赏你",
    "vi": "Trần Tử Bì nhìn cô."
  },
  {
    "idx": 18100,
    "start": "08:43:32,400",
    "end": "08:43:34,800",
    "start_sec": 31412.4,
    "end_sec": 31414.8,
    "zh": "夏陶红眼神幽怨又委屈的女人",
    "vi": "Đào Hồng nhìn anh với ánh mắt oán hận và uất ức."
  },
  {
    "idx": 18101,
    "start": "08:43:34,800",
    "end": "08:43:37,940",
    "start_sec": 31414.8,
    "end_sec": 31417.94,
    "zh": "喂",
    "vi": "Này."
  },
  {
    "idx": 18102,
    "start": "08:43:37,940",
    "end": "08:43:38,900",
    "start_sec": 31417.94,
    "end_sec": 31418.9,
    "zh": "小子",
    "vi": "Nhóc con."
  },
  {
    "idx": 18103,
    "start": "08:43:38,900",
    "end": "08:43:41,200",
    "start_sec": 31418.9,
    "end_sec": 31421.2,
    "zh": "你是真不喜欢女人吗",
    "vi": "Cậu thật sự không thích phụ nữ sao."
  },
  {
    "idx": 18104,
    "start": "08:43:41,200",
    "end": "08:43:42,060",
    "start_sec": 31421.2,
    "end_sec": 31422.06,
    "zh": "鬼面窗",
    "vi": "Quỷ Diện Song."
  },
  {
    "idx": 18105,
    "start": "08:43:42,060",
    "end": "08:43:42,640",
    "start_sec": 31422.06,
    "end_sec": 31422.64,
    "zh": "怎么",
    "vi": "Sao thế."
  },
  {
    "idx": 18106,
    "start": "08:43:42,640",
    "end": "08:43:45,160",
    "start_sec": 31422.64,
    "end_sec": 31425.16,
    "zh": "你们鬼异也喜欢研究这些了",
    "vi": "Bọn quỷ dị các ông cũng thích nghiên cứu chuyện này à."
  },
  {
    "idx": 18107,
    "start": "08:43:45,160",
    "end": "08:43:47,580",
    "start_sec": 31425.16,
    "end_sec": 31427.58,
    "zh": "我是怕你精神失常了",
    "vi": "Ta chỉ sợ đầu óc cậu có vấn đề thôi."
  },
  {
    "idx": 18108,
    "start": "08:43:47,580",
    "end": "08:43:48,520",
    "start_sec": 31427.58,
    "end_sec": 31428.52,
    "zh": "比起这个",
    "vi": "So với chuyện đó."
  },
  {
    "idx": 18109,
    "start": "08:43:48,520",
    "end": "08:43:50,060",
    "start_sec": 31428.52,
    "end_sec": 31430.06,
    "zh": "你还是好好帮我想想",
    "vi": "Ông lo mà giúp tôi nghĩ xem."
  },
  {
    "idx": 18110,
    "start": "08:43:50,060",
    "end": "08:43:52,320",
    "start_sec": 31430.06,
    "end_sec": 31432.32,
    "zh": "你在鬼界的寺庙到底在哪吧",
    "vi": "Ngôi đền của ông ở Quỷ giới rốt cuộc là ở đâu đi."
  },
  {
    "idx": 18111,
    "start": "08:43:52,320",
    "end": "08:43:53,840",
    "start_sec": 31432.32,
    "end_sec": 31433.84,
    "zh": "鬼界",
    "vi": "Quỷ giới."
  },
  {
    "idx": 18112,
    "start": "08:43:53,840",
    "end": "08:43:56,280",
    "start_sec": 31433.84,
    "end_sec": 31436.28,
    "zh": "鬼面窗的声音沉寂下来",
    "vi": "Giọng của Quỷ Diện Song im bặt."
  },
  {
    "idx": 18113,
    "start": "08:43:56,280",
    "end": "08:43:57,140",
    "start_sec": 31436.28,
    "end_sec": 31437.14,
    "zh": "以来四五天",
    "vi": "Bốn năm ngày trôi qua."
  },
  {
    "idx": 18114,
    "start": "08:43:57,140",
    "end": "08:43:59,360",
    "start_sec": 31437.14,
    "end_sec": 31439.36,
    "zh": "橙子皮每天都睡得很充足",
    "vi": "Trần Tử Bì mỗi ngày đều ngủ rất đủ giấc."
  },
  {
    "idx": 18115,
    "start": "08:43:59,360",
    "end": "08:44:00,420",
    "start_sec": 31439.36,
    "end_sec": 31440.42,
    "zh": "过得很平静",
    "vi": "Sống rất bình yên."
  },
  {
    "idx": 18116,
    "start": "08:44:00,420",
    "end": "08:44:02,260",
    "start_sec": 31440.42,
    "end_sec": 31442.26,
    "zh": "直到月初的第三天",
    "vi": "Cho đến ngày thứ ba đầu tháng."
  },
  {
    "idx": 18117,
    "start": "08:44:02,260",
    "end": "08:44:04,500",
    "start_sec": 31442.26,
    "end_sec": 31444.5,
    "zh": "橙子皮收到一条消息",
    "vi": "Trần Tử Bì nhận được một tin nhắn."
  },
  {
    "idx": 18118,
    "start": "08:44:04,500",
    "end": "08:44:05,780",
    "start_sec": 31444.5,
    "end_sec": 31445.78,
    "zh": "紧急事件",
    "vi": "Sự kiện khẩn cấp."
  },
  {
    "idx": 18119,
    "start": "08:44:05,780",
    "end": "08:44:07,800",
    "start_sec": 31445.78,
    "end_sec": 31447.8,
    "zh": "请速来六楼会议大厅集合",
    "vi": "Xin vui lòng nhanh chóng đến tập hợp tại hội trường tầng sáu."
  },
  {
    "idx": 18120,
    "start": "08:44:20,060",
    "end": "08:44:33,245",
    "start_sec": 31460.06,
    "end_sec": 31473.245,
    "zh": "请不吝点赞 订阅 转发 打赏支持明镜与点点栏目长子皮来到六楼会议厅时",
    "vi": "Khi Trần Tử Bì đến hội trường tầng sáu."
  },
  {
    "idx": 18121,
    "start": "08:44:33,245",
    "end": "08:44:35,125",
    "start_sec": 31473.245,
    "end_sec": 31475.125,
    "zh": "这里已经分别站了四排人",
    "vi": "Ở đây đã đứng sẵn bốn hàng người rồi."
  },
  {
    "idx": 18122,
    "start": "08:44:35,125",
    "end": "08:44:40,565",
    "start_sec": 31475.125,
    "end_sec": 31480.565,
    "zh": "05带领的是01派",
    "vi": "Số 05 dẫn đầu phe 01."
  },
  {
    "idx": 18123,
    "start": "08:44:40,565",
    "end": "08:44:41,425",
    "start_sec": 31480.565,
    "end_sec": 31481.425,
    "zh": "那两个是",
    "vi": "Hai người kia là."
  },
  {
    "idx": 18124,
    "start": "08:44:41,425",
    "end": "08:44:42,745",
    "start_sec": 31481.425,
    "end_sec": 31482.745,
    "zh": "02",
    "vi": "Số 02."
  },
  {
    "idx": 18125,
    "start": "08:44:42,745",
    "end": "08:44:43,685",
    "start_sec": 31482.745,
    "end_sec": 31483.685,
    "zh": "和01",
    "vi": "Và số 01."
  },
  {
    "idx": 18126,
    "start": "08:44:43,685",
    "end": "08:44:46,905",
    "start_sec": 31483.685,
    "end_sec": 31486.905,
    "zh": "原来他们长这样啊",
    "vi": "Hóa ra họ trông như thế này."
  },
  {
    "idx": 18127,
    "start": "08:44:46,905",
    "end": "08:44:47,665",
    "start_sec": 31486.905,
    "end_sec": 31487.665,
    "zh": "剩下的一些",
    "vi": "Những người còn lại."
  },
  {
    "idx": 18128,
    "start": "08:44:47,665",
    "end": "08:44:49,925",
    "start_sec": 31487.665,
    "end_sec": 31489.925,
    "zh": "是没加入任何派对的御鬼者吧",
    "vi": "Chắc là những Ngự Quỷ Giả chưa gia nhập phe phái nào."
  },
  {
    "idx": 18129,
    "start": "08:44:49,925",
    "end": "08:44:51,925",
    "start_sec": 31489.925,
    "end_sec": 31491.925,
    "zh": "总共也就四十来个人",
    "vi": "Tổng cộng cũng chỉ có khoảng bốn mươi người."
  },
  {
    "idx": 18130,
    "start": "08:44:51,925",
    "end": "08:44:53,785",
    "start_sec": 31491.925,
    "end_sec": 31493.785,
    "zh": "看来五十二名御鬼者",
    "vi": "Xem ra trong số năm mươi hai Ngự Quỷ Giả."
  },
  {
    "idx": 18131,
    "start": "08:44:53,785",
    "end": "08:44:55,305",
    "start_sec": 31493.785,
    "end_sec": 31495.305,
    "zh": "夭折了不少啊",
    "vi": "Đã bỏ mạng không ít rồi."
  },
  {
    "idx": 18132,
    "start": "08:44:55,305",
    "end": "08:44:56,325",
    "start_sec": 31495.305,
    "end_sec": 31496.325,
    "zh": "喂",
    "vi": "Này."
  },
  {
    "idx": 18133,
    "start": "08:44:56,325",
    "end": "08:44:57,545",
    "start_sec": 31496.325,
    "end_sec": 31497.545,
    "zh": "橙子皮",
    "vi": "Trần Tử Bì."
  },
  {
    "idx": 18134,
    "start": "08:44:57,545",
    "end": "08:44:59,405",
    "start_sec": 31497.545,
    "end_sec": 31499.405,
    "zh": "你怎么站那呢",
    "vi": "Sao ngươi lại đứng đó thế."
  },
  {
    "idx": 18135,
    "start": "08:44:59,405",
    "end": "08:45:00,265",
    "start_sec": 31499.405,
    "end_sec": 31500.265,
    "zh": "过来啊",
    "vi": "Qua đây đi."
  },
  {
    "idx": 18136,
    "start": "08:45:00,265",
    "end": "08:45:02,325",
    "start_sec": 31500.265,
    "end_sec": 31502.325,
    "zh": "大家刚刚还在说你呢",
    "vi": "Mọi người vừa mới nhắc đến ngươi đấy."
  },
  {
    "idx": 18137,
    "start": "08:45:02,325",
    "end": "08:45:06,725",
    "start_sec": 31502.325,
    "end_sec": 31506.725,
    "zh": "他就是那个012",
    "vi": "Hắn chính là số 012 đó sao."
  },
  {
    "idx": 18138,
    "start": "08:45:06,725",
    "end": "08:45:09,565",
    "start_sec": 31506.725,
    "end_sec": 31509.565,
    "zh": "听说他一个人打爆了016和019",
    "vi": "Nghe nói một mình hắn đã đánh bại cả số 016 và 019."
  },
  {
    "idx": 18139,
    "start": "08:45:09,565",
    "end": "08:45:10,765",
    "start_sec": 31509.565,
    "end_sec": 31510.765,
    "zh": "不止呢",
    "vi": "Không chỉ vậy đâu."
  },
  {
    "idx": 18140,
    "start": "08:45:10,765",
    "end": "08:45:12,145",
    "start_sec": 31510.765,
    "end_sec": 31512.145,
    "zh": "他连续三次任务",
    "vi": "Hắn đã làm ba nhiệm vụ liên tiếp."
  },
  {
    "idx": 18141,
    "start": "08:45:12,145",
    "end": "08:45:14,105",
    "start_sec": 31512.145,
    "end_sec": 31514.105,
    "zh": "都是超额完成的",
    "vi": "Và đều hoàn thành vượt mức chỉ tiêu."
  },
  {
    "idx": 18142,
    "start": "08:45:14,105",
    "end": "08:45:15,645",
    "start_sec": 31514.105,
    "end_sec": 31515.645,
    "zh": "金白雪这么一看",
    "vi": "Kim Bạch Tuyết vừa nhìn qua."
  },
  {
    "idx": 18143,
    "start": "08:45:15,645",
    "end": "08:45:16,825",
    "start_sec": 31515.645,
    "end_sec": 31516.825,
    "zh": "会一听你所有人",
    "vi": "Liền thu hút tất cả mọi người."
  },
  {
    "idx": 18144,
    "start": "08:45:16,825",
    "end": "08:45:18,305",
    "start_sec": 31516.825,
    "end_sec": 31518.305,
    "zh": "齐刷刷朝城府一看",
    "vi": "Đồng loạt nhìn về phía Trần Tử Bì."
  },
  {
    "idx": 18145,
    "start": "08:45:18,305",
    "end": "08:45:20,065",
    "start_sec": 31518.305,
    "end_sec": 31520.065,
    "zh": "有崇拜羡慕嫉妒的",
    "vi": "Trong đó có cả sự sùng bái, ngưỡng mộ và ghen tị."
  },
  {
    "idx": 18146,
    "start": "08:45:20,065",
    "end": "08:45:22,905",
    "start_sec": 31520.065,
    "end_sec": 31522.905,
    "zh": "你就是零一二成几",
    "vi": "Ngươi chính là số 012 Trần Tử Bì phải không."
  },
  {
    "idx": 18147,
    "start": "08:45:22,905",
    "end": "08:45:24,285",
    "start_sec": 31522.905,
    "end_sec": 31524.285,
    "zh": "怎么了",
    "vi": "Sao thế."
  },
  {
    "idx": 18148,
    "start": "08:45:24,285",
    "end": "08:45:25,705",
    "start_sec": 31524.285,
    "end_sec": 31525.705,
    "zh": "没见过帅哥",
    "vi": "Chưa từng thấy trai đẹp à."
  },
  {
    "idx": 18149,
    "start": "08:45:25,705",
    "end": "08:45:27,425",
    "start_sec": 31525.705,
    "end_sec": 31527.425,
    "zh": "小子",
    "vi": "Nhóc con."
  },
  {
    "idx": 18150,
    "start": "08:45:27,425",
    "end": "08:45:28,845",
    "start_sec": 31527.425,
    "end_sec": 31528.845,
    "zh": "你很狂啊",
    "vi": "Ngươi ngông cuồng thật đấy."
  },
  {
    "idx": 18151,
    "start": "08:45:28,845",
    "end": "08:45:29,865",
    "start_sec": 31528.845,
    "end_sec": 31529.865,
    "zh": "不是哥们",
    "vi": "Không phải bạn bè"
  },
  {
    "idx": 18152,
    "start": "08:45:29,865",
    "end": "08:45:31,365",
    "start_sec": 31529.865,
    "end_sec": 31531.365,
    "zh": "你哪看出我狂啊",
    "vi": "Sao bạn thấy tôi ngạo mạn vậy"
  },
  {
    "idx": 18153,
    "start": "08:45:31,365",
    "end": "08:45:32,745",
    "start_sec": 31531.365,
    "end_sec": 31532.745,
    "zh": "你就是这么和",
    "vi": "Bạn nói chuyện với"
  },
  {
    "idx": 18154,
    "start": "08:45:32,745",
    "end": "08:45:33,945",
    "start_sec": 31532.745,
    "end_sec": 31533.945,
    "zh": "尚未遇鬼者招呼",
    "vi": "người chưa từng gặp ma như vậy sao"
  },
  {
    "idx": 18155,
    "start": "08:45:33,945",
    "end": "08:45:35,045",
    "start_sec": 31533.945,
    "end_sec": 31535.045,
    "zh": "呵呵",
    "vi": "Hehe"
  },
  {
    "idx": 18156,
    "start": "08:45:35,045",
    "end": "08:45:36,665",
    "start_sec": 31535.045,
    "end_sec": 31536.665,
    "zh": "我可对打我主意的人",
    "vi": "Tôi không lịch sự với những kẻ"
  },
  {
    "idx": 18157,
    "start": "08:45:36,665",
    "end": "08:45:37,645",
    "start_sec": 31536.665,
    "end_sec": 31537.645,
    "zh": "没什么礼貌",
    "vi": "nhắm vào tôi đâu"
  },
  {
    "idx": 18158,
    "start": "08:45:37,645",
    "end": "08:45:46,405",
    "start_sec": 31537.645,
    "end_sec": 31546.405,
    "zh": "想不到这小哥脾气还挺骚的",
    "vi": "Không ngờ cậu nhóc này lại có tính khí kỳ lạ vậy"
  },
  {
    "idx": 18159,
    "start": "08:45:46,405",
    "end": "08:45:49,165",
    "start_sec": 31546.405,
    "end_sec": 31549.165,
    "zh": "你也不是什么好东西",
    "vi": "Bạn cũng chẳng tốt đẹp gì"
  },
  {
    "idx": 18160,
    "start": "08:45:49,165",
    "end": "08:45:50,785",
    "start_sec": 31549.165,
    "end_sec": 31550.785,
    "zh": "骚浪骚浪的",
    "vi": "Thật là lẳng lơ"
  },
  {
    "idx": 18161,
    "start": "08:45:50,785",
    "end": "08:45:52,645",
    "start_sec": 31550.785,
    "end_sec": 31552.645,
    "zh": "你小子",
    "vi": "Cậu nhóc kia"
  },
  {
    "idx": 18162,
    "start": "08:45:52,645",
    "end": "08:45:54,225",
    "start_sec": 31552.645,
    "end_sec": 31554.225,
    "zh": "我操",
    "vi": "Đệt"
  },
  {
    "idx": 18163,
    "start": "08:45:54,225",
    "end": "08:45:55,065",
    "start_sec": 31554.225,
    "end_sec": 31555.065,
    "zh": "橙子皮",
    "vi": "Trần Tử Bì"
  },
  {
    "idx": 18164,
    "start": "08:45:55,065",
    "end": "08:45:57,945",
    "start_sec": 31555.065,
    "end_sec": 31557.945,
    "zh": "你这是要把020三两派人全得罪了",
    "vi": "Bạn định làm phật lòng toàn bộ phái 020 ba lạng sao"
  },
  {
    "idx": 18165,
    "start": "08:45:57,945",
    "end": "08:45:59,525",
    "start_sec": 31557.945,
    "end_sec": 31559.525,
    "zh": "反正他们又没对",
    "vi": "Dù sao họ cũng chưa từng"
  },
  {
    "idx": 18166,
    "start": "08:45:59,525",
    "end": "08:46:00,565",
    "start_sec": 31559.525,
    "end_sec": 31560.565,
    "zh": "我还什么好意",
    "vi": "có ý tốt với tôi"
  },
  {
    "idx": 18167,
    "start": "08:46:00,565",
    "end": "08:46:02,085",
    "start_sec": 31560.565,
    "end_sec": 31562.085,
    "zh": "拉仇恨是早晚的事",
    "vi": "Việc thu hút sự thù địch sớm muộn cũng xảy ra"
  },
  {
    "idx": 18168,
    "start": "08:46:02,085",
    "end": "08:46:04,625",
    "start_sec": 31562.085,
    "end_sec": 31564.625,
    "zh": "况且这里可是灵异的场子",
    "vi": "Hơn nữa đây là nơi tâm linh"
  },
  {
    "idx": 18169,
    "start": "08:46:04,625",
    "end": "08:46:06,005",
    "start_sec": 31564.625,
    "end_sec": 31566.005,
    "zh": "让他们也不敢对我怎么样",
    "vi": "Nên họ cũng không dám làm gì tôi"
  },
  {
    "idx": 18170,
    "start": "08:46:06,005",
    "end": "08:46:08,065",
    "start_sec": 31566.005,
    "end_sec": 31568.065,
    "zh": "锁紧",
    "vi": "Khóa chặt"
  },
  {
    "idx": 18171,
    "start": "08:46:08,065",
    "end": "08:46:09,625",
    "start_sec": 31568.065,
    "end_sec": 31569.625,
    "zh": "不知何时",
    "vi": "Không biết từ lúc nào"
  },
  {
    "idx": 18172,
    "start": "08:46:09,625",
    "end": "08:46:12,105",
    "start_sec": 31569.625,
    "end_sec": 31572.105,
    "zh": "林一悄无声息的出现在讲台上",
    "vi": "Lâm Nhất đã lặng lẽ xuất hiện trên bục giảng"
  },
  {
    "idx": 18173,
    "start": "08:46:12,105",
    "end": "08:46:14,145",
    "start_sec": 31572.105,
    "end_sec": 31574.145,
    "zh": "这次他并没有坐轮椅",
    "vi": "Lần này anh không ngồi xe lăn"
  },
  {
    "idx": 18174,
    "start": "08:46:14,145",
    "end": "08:46:15,665",
    "start_sec": 31574.145,
    "end_sec": 31575.665,
    "zh": "直挺挺的站着",
    "vi": "Anh đứng thẳng"
  },
  {
    "idx": 18175,
    "start": "08:46:15,665",
    "end": "08:46:16,885",
    "start_sec": 31575.665,
    "end_sec": 31576.885,
    "zh": "好家伙",
    "vi": "Trời ạ"
  },
  {
    "idx": 18176,
    "start": "08:46:16,885",
    "end": "08:46:18,345",
    "start_sec": 31576.885,
    "end_sec": 31578.345,
    "zh": "这气势直不压",
    "vi": "Khí thế này thật áp đảo"
  },
  {
    "idx": 18177,
    "start": "08:46:18,345",
    "end": "08:46:19,445",
    "start_sec": 31578.345,
    "end_sec": 31579.445,
    "zh": "不愧是林一",
    "vi": "Đúng là Lâm Nhất"
  },
  {
    "idx": 18178,
    "start": "08:46:19,445",
    "end": "08:46:20,305",
    "start_sec": 31579.445,
    "end_sec": 31580.305,
    "zh": "喂",
    "vi": "Này"
  },
  {
    "idx": 18179,
    "start": "08:46:20,305",
    "end": "08:46:21,045",
    "start_sec": 31580.305,
    "end_sec": 31581.045,
    "zh": "白旭",
    "vi": "Bạch Húc"
  },
  {
    "idx": 18180,
    "start": "08:46:21,045",
    "end": "08:46:22,525",
    "start_sec": 31581.045,
    "end_sec": 31582.525,
    "zh": "他到底全没瘸啊",
    "vi": "Anh ta có bị què thật không"
  },
  {
    "idx": 18181,
    "start": "08:46:22,525",
    "end": "08:46:23,525",
    "start_sec": 31582.525,
    "end_sec": 31583.525,
    "zh": "不是",
    "vi": "Không phải chứ."
  },
  {
    "idx": 18182,
    "start": "08:46:23,525",
    "end": "08:46:24,965",
    "start_sec": 31583.525,
    "end_sec": 31584.965,
    "zh": "老大哥给你解围",
    "vi": "Đại ca giải vây cho cậu."
  },
  {
    "idx": 18183,
    "start": "08:46:24,965",
    "end": "08:46:26,725",
    "start_sec": 31584.965,
    "end_sec": 31586.725,
    "zh": "你关心老大哥谁没瘸",
    "vi": "Cậu lại đi quan tâm người ta có què hay không."
  },
  {
    "idx": 18184,
    "start": "08:46:26,725",
    "end": "08:46:28,545",
    "start_sec": 31586.725,
    "end_sec": 31588.545,
    "zh": "今天他看上去",
    "vi": "Hôm nay trông anh ta"
  },
  {
    "idx": 18185,
    "start": "08:46:28,545",
    "end": "08:46:30,265",
    "start_sec": 31588.545,
    "end_sec": 31590.265,
    "zh": "气色不错啊",
    "vi": "sắc mặt có vẻ tốt đấy."
  },
  {
    "idx": 18186,
    "start": "08:46:30,265",
    "end": "08:46:31,205",
    "start_sec": 31590.265,
    "end_sec": 31591.205,
    "zh": "林一一反常态",
    "vi": "Lâm Nhất khác hẳn mọi khi."
  },
  {
    "idx": 18187,
    "start": "08:46:31,205",
    "end": "08:46:32,105",
    "start_sec": 31591.205,
    "end_sec": 31592.105,
    "zh": "不仅站得稳",
    "vi": "Không chỉ đứng rất vững"
  },
  {
    "idx": 18188,
    "start": "08:46:32,105",
    "end": "08:46:33,805",
    "start_sec": 31592.105,
    "end_sec": 31593.805,
    "zh": "脸色也不过之前的苍白",
    "vi": "mà sắc mặt cũng không còn nhợt nhạt như trước."
  },
  {
    "idx": 18189,
    "start": "08:46:33,805",
    "end": "08:46:35,325",
    "start_sec": 31593.805,
    "end_sec": 31595.325,
    "zh": "他平静的看着长线",
    "vi": "Anh ta bình thản nhìn mọi người."
  },
  {
    "idx": 18190,
    "start": "08:46:35,325",
    "end": "08:46:36,885",
    "start_sec": 31595.325,
    "end_sec": 31596.885,
    "zh": "没有一个人在法发生",
    "vi": "Không một ai lên tiếng."
  },
  {
    "idx": 18191,
    "start": "08:46:36,885",
    "end": "08:46:38,325",
    "start_sec": 31596.885,
    "end_sec": 31598.325,
    "zh": "各位",
    "vi": "Mọi người."
  },
  {
    "idx": 18192,
    "start": "08:46:38,325",
    "end": "08:46:39,585",
    "start_sec": 31598.325,
    "end_sec": 31599.585,
    "zh": "今天请各位来这里",
    "vi": "Hôm nay mời mọi người đến đây"
  },
  {
    "idx": 18193,
    "start": "08:46:39,585",
    "end": "08:46:41,145",
    "start_sec": 31599.585,
    "end_sec": 31601.145,
    "zh": "大家也都知道什么情况",
    "vi": "chắc mọi người cũng đã biết rõ tình hình."
  },
  {
    "idx": 18194,
    "start": "08:46:41,145",
    "end": "08:46:42,865",
    "start_sec": 31601.145,
    "end_sec": 31602.865,
    "zh": "此次鬼界之行",
    "vi": "Chuyến đi đến Quỷ Giới lần này"
  },
  {
    "idx": 18195,
    "start": "08:46:42,865",
    "end": "08:46:45,085",
    "start_sec": 31602.865,
    "end_sec": 31605.085,
    "zh": "只有两个目的",
    "vi": "chỉ có hai mục đích."
  },
  {
    "idx": 18196,
    "start": "08:46:45,085",
    "end": "08:46:45,665",
    "start_sec": 31605.085,
    "end_sec": 31605.665,
    "zh": "其一",
    "vi": "Một là"
  },
  {
    "idx": 18197,
    "start": "08:46:45,665",
    "end": "08:46:48,045",
    "start_sec": 31605.665,
    "end_sec": 31608.045,
    "zh": "找寻驾驭第六鬼役的奇迹",
    "vi": "tìm kiếm cơ hội để ngự trị Quỷ Dịch thứ sáu."
  },
  {
    "idx": 18198,
    "start": "08:46:48,045",
    "end": "08:46:49,405",
    "start_sec": 31608.045,
    "end_sec": 31609.405,
    "zh": "其二",
    "vi": "Hai là"
  },
  {
    "idx": 18199,
    "start": "08:46:49,405",
    "end": "08:46:51,465",
    "start_sec": 31609.405,
    "end_sec": 31611.465,
    "zh": "找回之前十位前辈的踪迹",
    "vi": "tìm lại tung tích của mười vị tiền bối trước đó."
  },
  {
    "idx": 18200,
    "start": "08:46:51,465",
    "end": "08:46:53,065",
    "start_sec": 31611.465,
    "end_sec": 31613.065,
    "zh": "此行危险程度",
    "vi": "Độ nguy hiểm của chuyến đi này"
  },
  {
    "idx": 18201,
    "start": "08:46:53,065",
    "end": "08:46:54,705",
    "start_sec": 31613.065,
    "end_sec": 31614.705,
    "zh": "也不用我多说了",
    "vi": "tôi cũng không cần phải nói nhiều nữa."
  },
  {
    "idx": 18202,
    "start": "08:46:54,705",
    "end": "08:46:55,445",
    "start_sec": 31614.705,
    "end_sec": 31615.445,
    "zh": "S级任务",
    "vi": "Nhiệm vụ cấp S"
  },
  {
    "idx": 18203,
    "start": "08:46:55,445",
    "end": "08:46:57,365",
    "start_sec": 31615.445,
    "end_sec": 31617.365,
    "zh": "探查鬼界将正式开启",
    "vi": "thám hiểm Quỷ Giới sẽ chính thức bắt đầu."
  },
  {
    "idx": 18204,
    "start": "08:46:57,365",
    "end": "08:46:59,605",
    "start_sec": 31617.365,
    "end_sec": 31619.605,
    "zh": "本次任务是自愿参与模式",
    "vi": "Nhiệm vụ lần này dựa trên tinh thần tự nguyện."
  },
  {
    "idx": 18205,
    "start": "08:46:59,605",
    "end": "08:47:01,205",
    "start_sec": 31619.605,
    "end_sec": 31621.205,
    "zh": "有意愿的尽管报名",
    "vi": "Ai có ý muốn đi thì cứ đăng ký."
  },
  {
    "idx": 18206,
    "start": "08:47:01,205",
    "end": "08:47:03,725",
    "start_sec": 31621.205,
    "end_sec": 31623.725,
    "zh": "我01将带头走在最前面",
    "vi": "Tôi, Không Một, sẽ dẫn đầu đi phía trước."
  },
  {
    "idx": 18207,
    "start": "08:47:03,725",
    "end": "08:47:04,945",
    "start_sec": 31623.725,
    "end_sec": 31624.945,
    "zh": "话也落下",
    "vi": "Lời vừa dứt"
  },
  {
    "idx": 18208,
    "start": "08:47:04,945",
    "end": "08:47:06,325",
    "start_sec": 31624.945,
    "end_sec": 31626.325,
    "zh": "长间一片死寂",
    "vi": "toàn trường chìm vào im lặng như tờ."
  },
  {
    "idx": 18209,
    "start": "08:47:06,325",
    "end": "08:47:08,845",
    "start_sec": 31626.325,
    "end_sec": 31628.845,
    "zh": "大家都知道去鬼界意味着什么",
    "vi": "Ai cũng biết đến Quỷ Giới có nghĩa là gì."
  },
  {
    "idx": 18210,
    "start": "08:47:08,845",
    "end": "08:47:11,265",
    "start_sec": 31628.845,
    "end_sec": 31631.265,
    "zh": "这领导者也不是那么好当的",
    "vi": "Làm người dẫn đầu này cũng chẳng dễ dàng gì."
  },
  {
    "idx": 18211,
    "start": "08:47:11,265",
    "end": "08:47:12,645",
    "start_sec": 31631.265,
    "end_sec": 31632.645,
    "zh": "要么驾驭第六鬼",
    "vi": "Hoặc là chế ngự con quỷ thứ sáu"
  },
  {
    "idx": 18212,
    "start": "08:47:12,645",
    "end": "08:47:14,465",
    "start_sec": 31632.645,
    "end_sec": 31634.465,
    "zh": "用绝对的实力震慑群众",
    "vi": "Dùng thực lực tuyệt đối để trấn áp đám đông"
  },
  {
    "idx": 18213,
    "start": "08:47:14,465",
    "end": "08:47:16,845",
    "start_sec": 31634.465,
    "end_sec": 31636.845,
    "zh": "要么只能找到以前的遇鬼者",
    "vi": "Hoặc là chỉ có thể tìm những người từng gặp quỷ trước đây"
  },
  {
    "idx": 18214,
    "start": "08:47:16,845",
    "end": "08:47:19,045",
    "start_sec": 31636.845,
    "end_sec": 31639.045,
    "zh": "用规则道义重新掌控之面",
    "vi": "Dùng quy tắc đạo nghĩa để kiểm soát lại tình hình"
  },
  {
    "idx": 18215,
    "start": "08:47:19,045",
    "end": "08:47:21,345",
    "start_sec": 31639.045,
    "end_sec": 31641.345,
    "zh": "两手抓就怕都抓不到",
    "vi": "Tham lam cả hai thì sợ chẳng được gì cả"
  },
  {
    "idx": 18216,
    "start": "08:47:21,345",
    "end": "08:47:23,785",
    "start_sec": 31641.345,
    "end_sec": 31643.785,
    "zh": "老朽也陪同大人前往",
    "vi": "Lão hủ cũng xin đi cùng đại nhân"
  },
  {
    "idx": 18217,
    "start": "08:47:23,785",
    "end": "08:47:25,105",
    "start_sec": 31643.785,
    "end_sec": 31645.105,
    "zh": "05代头后",
    "vi": "Sau khi thế hệ 05 đứng ra"
  },
  {
    "idx": 18218,
    "start": "08:47:25,105",
    "end": "08:47:26,585",
    "start_sec": 31645.105,
    "end_sec": 31646.585,
    "zh": "废物中又有两人站出来",
    "vi": "Trong đám người lại có hai người bước ra"
  },
  {
    "idx": 18219,
    "start": "08:47:26,585",
    "end": "08:47:28,985",
    "start_sec": 31646.585,
    "end_sec": 31648.985,
    "zh": "分别是014和01级",
    "vi": "Đó là 014 và 01 cấp"
  },
  {
    "idx": 18220,
    "start": "08:47:28,985",
    "end": "08:47:30,005",
    "start_sec": 31648.985,
    "end_sec": 31650.005,
    "zh": "白旭冷玄",
    "vi": "Bạch Húc Lãnh Huyền"
  },
  {
    "idx": 18221,
    "start": "08:47:30,005",
    "end": "08:47:32,225",
    "start_sec": 31650.005,
    "end_sec": 31652.225,
    "zh": "以及那个09都没有参加的意思",
    "vi": "Cùng với kẻ 09 kia đều không có ý định tham gia"
  },
  {
    "idx": 18222,
    "start": "08:47:32,225",
    "end": "08:47:33,425",
    "start_sec": 31652.225,
    "end_sec": 31653.425,
    "zh": "是怕钱出去了",
    "vi": "Là sợ tiền đã chi ra"
  },
  {
    "idx": 18223,
    "start": "08:47:33,425",
    "end": "08:47:34,125",
    "start_sec": 31653.425,
    "end_sec": 31654.125,
    "zh": "被投价",
    "vi": "Bị kẻ khác chiếm mất"
  },
  {
    "idx": 18224,
    "start": "08:47:34,125",
    "end": "08:47:36,285",
    "start_sec": 31654.125,
    "end_sec": 31656.285,
    "zh": "所以留下一部分人马",
    "vi": "Nên mới để lại một phần nhân mã"
  },
  {
    "idx": 18225,
    "start": "08:47:36,285",
    "end": "08:47:37,105",
    "start_sec": 31656.285,
    "end_sec": 31657.105,
    "zh": "想了想",
    "vi": "Suy nghĩ một chút"
  },
  {
    "idx": 18226,
    "start": "08:47:37,105",
    "end": "08:47:38,585",
    "start_sec": 31657.105,
    "end_sec": 31658.585,
    "zh": "橙子皮也站了出来",
    "vi": "Trần Tử Bì cũng bước ra ngoài"
  },
  {
    "idx": 18227,
    "start": "08:47:38,585",
    "end": "08:47:39,745",
    "start_sec": 31658.585,
    "end_sec": 31659.745,
    "zh": "橙子皮",
    "vi": "Trần Tử Bì"
  },
  {
    "idx": 18228,
    "start": "08:47:39,745",
    "end": "08:47:42,185",
    "start_sec": 31659.745,
    "end_sec": 31662.185,
    "zh": "你知道去那里意味着什么吗",
    "vi": "Bạn có biết đến đó nghĩa là gì không"
  },
  {
    "idx": 18229,
    "start": "08:47:42,185",
    "end": "08:47:42,525",
    "start_sec": 31662.185,
    "end_sec": 31662.525,
    "zh": "没事",
    "vi": "Không sao"
  },
  {
    "idx": 18230,
    "start": "08:47:42,525",
    "end": "08:47:43,565",
    "start_sec": 31662.525,
    "end_sec": 31663.565,
    "zh": "我也想看看",
    "vi": "Tôi cũng muốn xem thử"
  },
  {
    "idx": 18231,
    "start": "08:47:43,565",
    "end": "08:47:44,505",
    "start_sec": 31663.565,
    "end_sec": 31664.505,
    "zh": "所谓的诡计",
    "vi": "Cái gọi là quỷ kế"
  },
  {
    "idx": 18232,
    "start": "08:47:44,505",
    "end": "08:47:45,505",
    "start_sec": 31664.505,
    "end_sec": 31665.505,
    "zh": "到底是什么",
    "vi": "Rốt cuộc là thứ gì"
  },
  {
    "idx": 18233,
    "start": "08:47:45,505",
    "end": "08:47:48,165",
    "start_sec": 31665.505,
    "end_sec": 31668.165,
    "zh": "还有人吗",
    "vi": "Còn ai nữa không"
  },
  {
    "idx": 18234,
    "start": "08:47:48,165",
    "end": "08:47:48,685",
    "start_sec": 31668.165,
    "end_sec": 31668.685,
    "zh": "有",
    "vi": "Có"
  },
  {
    "idx": 18235,
    "start": "08:47:48,685",
    "end": "08:47:50,325",
    "start_sec": 31668.685,
    "end_sec": 31670.325,
    "zh": "怎么会没人呢",
    "vi": "Sao lại không có ai được chứ"
  },
  {
    "idx": 18236,
    "start": "08:47:50,325",
    "end": "08:47:51,445",
    "start_sec": 31670.325,
    "end_sec": 31671.445,
    "zh": "02站出来后",
    "vi": "Sau khi 02 bước ra"
  },
  {
    "idx": 18237,
    "start": "08:47:51,445",
    "end": "08:47:53,665",
    "start_sec": 31671.445,
    "end_sec": 31673.665,
    "zh": "03队伍里也将计站出来几人",
    "vi": "Trong đội 03 cũng có vài người bước ra"
  },
  {
    "idx": 18238,
    "start": "08:47:53,665",
    "end": "08:47:55,065",
    "start_sec": 31673.665,
    "end_sec": 31675.065,
    "zh": "像是提前计划好的",
    "vi": "Giống như đã lên kế hoạch từ trước"
  },
  {
    "idx": 18239,
    "start": "08:47:55,065",
    "end": "08:47:57,565",
    "start_sec": 31675.065,
    "end_sec": 31677.565,
    "zh": "三队人马也不过十几人",
    "vi": "Ba đội nhân mã cũng chỉ có hơn mười người"
  },
  {
    "idx": 18240,
    "start": "08:47:57,565",
    "end": "08:47:58,905",
    "start_sec": 31677.565,
    "end_sec": 31678.905,
    "zh": "比起上次清朝出动",
    "vi": "So với lần xuất quân trước đó"
  },
  {
    "idx": 18241,
    "start": "08:47:58,905",
    "end": "08:48:00,725",
    "start_sec": 31678.905,
    "end_sec": 31680.725,
    "zh": "这次可算是无比谨慎啊",
    "vi": "Lần này đúng là vô cùng cẩn thận."
  },
  {
    "idx": 18242,
    "start": "08:48:00,725",
    "end": "08:48:01,585",
    "start_sec": 31680.725,
    "end_sec": 31681.585,
    "zh": "好",
    "vi": "Tốt."
  },
  {
    "idx": 18243,
    "start": "08:48:01,585",
    "end": "08:48:05,105",
    "start_sec": 31681.585,
    "end_sec": 31685.105,
    "zh": "那我们这批人将即刻分三辆车出发",
    "vi": "Vậy thì nhóm chúng ta sẽ chia làm ba xe để xuất phát."
  },
  {
    "idx": 18244,
    "start": "08:48:05,105",
    "end": "08:48:08,885",
    "start_sec": 31685.105,
    "end_sec": 31688.885,
    "zh": "于恒兴市渤海大桥轨街入口集合",
    "vi": "Tập trung tại lối vào đường ray cầu Bột Hải, thành phố Hằng Hưng."
  },
  {
    "idx": 18245,
    "start": "08:48:08,885",
    "end": "08:48:10,705",
    "start_sec": 31688.885,
    "end_sec": 31690.705,
    "zh": "参与本次行动者",
    "vi": "Những người tham gia hành động lần này"
  },
  {
    "idx": 18246,
    "start": "08:48:10,705",
    "end": "08:48:12,625",
    "start_sec": 31690.705,
    "end_sec": 31692.625,
    "zh": "网站任务会自动绑定",
    "vi": "sẽ tự động được liên kết với nhiệm vụ trên trang web."
  },
  {
    "idx": 18247,
    "start": "08:48:12,625",
    "end": "08:48:14,685",
    "start_sec": 31692.625,
    "end_sec": 31694.685,
    "zh": "半个小时后停车场集合",
    "vi": "Nửa tiếng nữa tập trung tại bãi đỗ xe."
  },
  {
    "idx": 18248,
    "start": "08:48:14,685",
    "end": "08:48:16,285",
    "start_sec": 31694.685,
    "end_sec": 31696.285,
    "zh": "散会",
    "vi": "Hết giờ giải lao."
  },
  {
    "idx": 18249,
    "start": "08:48:16,285",
    "end": "08:48:18,285",
    "start_sec": 31696.285,
    "end_sec": 31698.285,
    "zh": "林玉疯疯活活的下了讲台",
    "vi": "Lâm Ngọc điên cuồng bước xuống bục giảng."
  },
  {
    "idx": 18250,
    "start": "08:48:18,285",
    "end": "08:48:21,745",
    "start_sec": 31698.285,
    "end_sec": 31701.745,
    "zh": "其他参与本次任务的人也相继离开",
    "vi": "Những người khác tham gia nhiệm vụ lần này cũng lần lượt rời đi."
  },
  {
    "idx": 18251,
    "start": "08:48:21,745",
    "end": "08:48:23,585",
    "start_sec": 31701.745,
    "end_sec": 31703.585,
    "zh": "喂",
    "vi": "Này."
  },
  {
    "idx": 18252,
    "start": "08:48:23,585",
    "end": "08:48:25,065",
    "start_sec": 31703.585,
    "end_sec": 31705.065,
    "zh": "你别栽了",
    "vi": "Cậu đừng có ngã đấy."
  },
  {
    "idx": 18253,
    "start": "08:48:25,065",
    "end": "08:48:26,685",
    "start_sec": 31705.065,
    "end_sec": 31706.685,
    "zh": "你是在关心我",
    "vi": "Cậu đang quan tâm đến tôi à."
  },
  {
    "idx": 18254,
    "start": "08:48:26,685",
    "end": "08:48:28,945",
    "start_sec": 31706.685,
    "end_sec": 31708.945,
    "zh": "你实力不错",
    "vi": "Sức mạnh của cậu không tệ."
  },
  {
    "idx": 18255,
    "start": "08:48:28,945",
    "end": "08:48:30,865",
    "start_sec": 31708.945,
    "end_sec": 31710.865,
    "zh": "我不想你要这了",
    "vi": "Tôi không muốn cậu gặp nguy hiểm."
  },
  {
    "idx": 18256,
    "start": "08:48:30,865",
    "end": "08:48:31,585",
    "start_sec": 31710.865,
    "end_sec": 31711.585,
    "zh": "什么",
    "vi": "Gì cơ."
  },
  {
    "idx": 18257,
    "start": "08:48:31,585",
    "end": "08:49:02,390",
    "start_sec": 31711.585,
    "end_sec": 31742.39,
    "zh": "这一节请不吝点赞 订阅 转发 打赏支持明镜与点点栏目",
    "vi": "Xin mọi người đừng tiếc nút like, đăng ký, chia sẻ và ủng hộ cho chuyên mục Minh Kính và Điểm Điểm."
  },
  {
    "idx": 18258,
    "start": "08:49:02,410",
    "end": "08:49:05,650",
    "start_sec": 31742.41,
    "end_sec": 31745.65,
    "zh": "自身越发的诡异难以控制",
    "vi": "Bản thân ngày càng trở nên kỳ lạ và khó kiểm soát."
  },
  {
    "idx": 18259,
    "start": "08:49:05,650",
    "end": "08:49:07,770",
    "start_sec": 31745.65,
    "end_sec": 31747.77,
    "zh": "所以我们必须在有限的时间内",
    "vi": "Vì vậy, chúng ta phải trong thời gian có hạn"
  },
  {
    "idx": 18260,
    "start": "08:49:07,770",
    "end": "08:49:09,610",
    "start_sec": 31747.77,
    "end_sec": 31749.61,
    "zh": "尽可能朝着诡计深入",
    "vi": "tiến sâu vào cạm bẫy nhất có thể."
  },
  {
    "idx": 18261,
    "start": "08:49:09,610",
    "end": "08:49:11,570",
    "start_sec": 31749.61,
    "end_sec": 31751.57,
    "zh": "但是相对越是深入",
    "vi": "Nhưng càng đi sâu vào"
  },
  {
    "idx": 18262,
    "start": "08:49:11,570",
    "end": "08:49:13,450",
    "start_sec": 31751.57,
    "end_sec": 31753.45,
    "zh": "自身清洗就会越严重",
    "vi": "thì sự thanh tẩy bản thân sẽ càng nghiêm trọng."
  },
  {
    "idx": 18263,
    "start": "08:49:13,450",
    "end": "08:49:14,910",
    "start_sec": 31753.45,
    "end_sec": 31754.91,
    "zh": "大家一定要量力而为",
    "vi": "Mọi người hãy cố gắng hết sức."
  },
  {
    "idx": 18264,
    "start": "08:49:14,910",
    "end": "08:49:16,910",
    "start_sec": 31754.91,
    "end_sec": 31756.91,
    "zh": "你的权力很大",
    "vi": "Quyền lực của cậu rất lớn."
  },
  {
    "idx": 18265,
    "start": "08:49:16,910",
    "end": "08:49:17,750",
    "start_sec": 31756.91,
    "end_sec": 31757.75,
    "zh": "务必小心",
    "vi": "Nhất định phải cẩn thận."
  },
  {
    "idx": 18266,
    "start": "08:49:17,750",
    "end": "08:49:18,790",
    "start_sec": 31757.75,
    "end_sec": 31758.79,
    "zh": "不用你说",
    "vi": "Không cần cậu nói."
  },
  {
    "idx": 18267,
    "start": "08:49:18,790",
    "end": "08:49:20,130",
    "start_sec": 31758.79,
    "end_sec": 31760.13,
    "zh": "我有分寸",
    "vi": "Tôi biết chừng mực."
  },
  {
    "idx": 18268,
    "start": "08:49:20,130",
    "end": "08:49:21,570",
    "start_sec": 31760.13,
    "end_sec": 31761.57,
    "zh": "长子皮操作生机",
    "vi": "Con trai cả điều khiển sinh mạng."
  },
  {
    "idx": 18269,
    "start": "08:49:21,570",
    "end": "08:49:23,070",
    "start_sec": 31761.57,
    "end_sec": 31763.07,
    "zh": "翻看着御鬼者网站",
    "vi": "Xem trang web của người điều khiển quỷ."
  },
  {
    "idx": 18270,
    "start": "08:49:23,070",
    "end": "08:49:24,610",
    "start_sec": 31763.07,
    "end_sec": 31764.61,
    "zh": "不愧是玩命的任务",
    "vi": "Đúng là nhiệm vụ liều mạng."
  },
  {
    "idx": 18271,
    "start": "08:49:24,610",
    "end": "08:49:26,170",
    "start_sec": 31764.61,
    "end_sec": 31766.17,
    "zh": "接着任务奖励就这么高",
    "vi": "Thế nên phần thưởng nhiệm vụ mới cao như vậy."
  },
  {
    "idx": 18272,
    "start": "08:49:26,170",
    "end": "08:49:28,070",
    "start_sec": 31766.17,
    "end_sec": 31768.07,
    "zh": "商务车悄无声息",
    "vi": "Chiếc xe thương mại im lặng di chuyển."
  },
  {
    "idx": 18273,
    "start": "08:49:28,070",
    "end": "08:49:29,910",
    "start_sec": 31768.07,
    "end_sec": 31769.91,
    "zh": "像幽灵般在街道上穿梭",
    "vi": "Như một bóng ma len lỏi qua các con phố."
  },
  {
    "idx": 18274,
    "start": "08:49:29,910",
    "end": "08:49:32,870",
    "start_sec": 31769.91,
    "end_sec": 31772.87,
    "zh": "直到开进一座被黑暗笼罩的城市",
    "vi": "Cho đến khi đi vào một thành phố bị bóng tối bao trùm."
  },
  {
    "idx": 18275,
    "start": "08:49:32,870",
    "end": "08:49:37,810",
    "start_sec": 31772.87,
    "end_sec": 31777.81,
    "zh": "卧槽",
    "vi": "Vãi thật."
  },
  {
    "idx": 18276,
    "start": "08:49:37,810",
    "end": "08:49:48,810",
    "start_sec": 31777.81,
    "end_sec": 31788.81,
    "zh": "看着障碍上的血迹",
    "vi": "Nhìn những vệt máu trên chướng ngại vật."
  },
  {
    "idx": 18277,
    "start": "08:49:48,810",
    "end": "08:49:50,390",
    "start_sec": 31788.81,
    "end_sec": 31790.39,
    "zh": "当时到底有多少诡异",
    "vi": "Lúc đó rốt cuộc đã có bao nhiêu con quỷ."
  },
  {
    "idx": 18278,
    "start": "08:49:50,390",
    "end": "08:49:51,570",
    "start_sec": 31790.39,
    "end_sec": 31791.57,
    "zh": "顶着高压电流",
    "vi": "Bất chấp dòng điện cao thế."
  },
  {
    "idx": 18279,
    "start": "08:49:51,570",
    "end": "08:49:53,070",
    "start_sec": 31791.57,
    "end_sec": 31793.07,
    "zh": "爬出了这堵封闭栅栏",
    "vi": "Để trèo qua hàng rào phong tỏa này."
  },
  {
    "idx": 18280,
    "start": "08:49:53,070",
    "end": "08:49:56,350",
    "start_sec": 31793.07,
    "end_sec": 31796.35,
    "zh": "说来上一次来鬼界",
    "vi": "Nhắc mới nhớ lần trước đến quỷ giới."
  },
  {
    "idx": 18281,
    "start": "08:49:56,350",
    "end": "08:49:58,090",
    "start_sec": 31796.35,
    "end_sec": 31798.09,
    "zh": "我们可都是兴奋的",
    "vi": "Chúng ta ai nấy đều rất hào hứng."
  },
  {
    "idx": 18282,
    "start": "08:49:58,090",
    "end": "08:50:01,030",
    "start_sec": 31798.09,
    "end_sec": 31801.03,
    "zh": "当时有十位御规者大哥打头阵",
    "vi": "Lúc đó có mười đại ca điều khiển quỷ đi tiên phong."
  },
  {
    "idx": 18283,
    "start": "08:50:01,030",
    "end": "08:50:02,450",
    "start_sec": 31801.03,
    "end_sec": 31802.45,
    "zh": "多威风啊",
    "vi": "Trông oai phong biết bao."
  },
  {
    "idx": 18284,
    "start": "08:50:02,450",
    "end": "08:50:02,730",
    "start_sec": 31802.45,
    "end_sec": 31802.73,
    "zh": "现在",
    "vi": "Còn bây giờ."
  },
  {
    "idx": 18285,
    "start": "08:50:02,730",
    "end": "08:50:04,790",
    "start_sec": 31802.73,
    "end_sec": 31804.79,
    "zh": "走吧",
    "vi": "Đi thôi."
  },
  {
    "idx": 18286,
    "start": "08:50:04,790",
    "end": "08:50:05,890",
    "start_sec": 31804.79,
    "end_sec": 31805.89,
    "zh": "到了里面",
    "vi": "Vào đến bên trong."
  },
  {
    "idx": 18287,
    "start": "08:50:05,890",
    "end": "08:50:07,390",
    "start_sec": 31805.89,
    "end_sec": 31807.39,
    "zh": "各自安好",
    "vi": "Ai nấy tự lo liệu nhé."
  },
  {
    "idx": 18288,
    "start": "08:50:07,390",
    "end": "08:50:10,250",
    "start_sec": 31807.39,
    "end_sec": 31810.25,
    "zh": "一行十几人将其走进炸岛",
    "vi": "Nhóm mười mấy người cùng bước vào khu vực đổ nát."
  },
  {
    "idx": 18289,
    "start": "08:50:10,250",
    "end": "08:50:11,510",
    "start_sec": 31810.25,
    "end_sec": 31811.51,
    "zh": "身后的商务车",
    "vi": "Chiếc xe thương mại phía sau."
  },
  {
    "idx": 18290,
    "start": "08:50:11,510",
    "end": "08:50:13,330",
    "start_sec": 31811.51,
    "end_sec": 31813.33,
    "zh": "闪烁着隐匿在黑暗里",
    "vi": "Nhấp nháy rồi biến mất vào bóng tối."
  },
  {
    "idx": 18291,
    "start": "08:50:13,330",
    "end": "08:50:17,690",
    "start_sec": 31813.33,
    "end_sec": 31817.69,
    "zh": "这个黑色虚空漩涡",
    "vi": "Vòng xoáy hư vô màu đen này."
  },
  {
    "idx": 18292,
    "start": "08:50:17,690",
    "end": "08:50:20,410",
    "start_sec": 31817.69,
    "end_sec": 31820.41,
    "zh": "这是穿过了诡计的空间点吗",
    "vi": "Đây là điểm không gian đi xuyên qua quỷ giới sao."
  },
  {
    "idx": 18293,
    "start": "08:50:20,410",
    "end": "08:50:21,550",
    "start_sec": 31820.41,
    "end_sec": 31821.55,
    "zh": "适应着光线",
    "vi": "Dần thích nghi với ánh sáng."
  },
  {
    "idx": 18294,
    "start": "08:50:21,550",
    "end": "08:50:23,450",
    "start_sec": 31821.55,
    "end_sec": 31823.45,
    "zh": "橙子皮看向眼前的世界",
    "vi": "Trần Tử Bì nhìn thế giới trước mắt."
  },
  {
    "idx": 18295,
    "start": "08:50:23,450",
    "end": "08:50:25,370",
    "start_sec": 31823.45,
    "end_sec": 31825.37,
    "zh": "是一件灰白色的白化零",
    "vi": "Đó là một khu rừng bạch hóa màu xám trắng."
  },
  {
    "idx": 18296,
    "start": "08:50:25,370",
    "end": "08:50:27,990",
    "start_sec": 31825.37,
    "end_sec": 31827.99,
    "zh": "老庙主的档案里有记录",
    "vi": "Trong hồ sơ của lão miếu chủ có ghi chép."
  },
  {
    "idx": 18297,
    "start": "08:50:27,990",
    "end": "08:50:29,690",
    "start_sec": 31827.99,
    "end_sec": 31829.69,
    "zh": "虽说大家一起进入鬼界",
    "vi": "Mặc dù mọi người cùng tiến vào quỷ giới."
  },
  {
    "idx": 18298,
    "start": "08:50:29,690",
    "end": "08:50:32,110",
    "start_sec": 31829.69,
    "end_sec": 31832.11,
    "zh": "但会被随机传送到某个空间节点",
    "vi": "Nhưng sẽ bị dịch chuyển ngẫu nhiên đến một điểm không gian nào đó."
  },
  {
    "idx": 18299,
    "start": "08:50:32,110",
    "end": "08:50:33,170",
    "start_sec": 31832.11,
    "end_sec": 31833.17,
    "zh": "说是节队",
    "vi": "Nói là đi chung nhóm."
  },
  {
    "idx": 18300,
    "start": "08:50:33,170",
    "end": "08:50:35,310",
    "start_sec": 31833.17,
    "end_sec": 31835.31,
    "zh": "最后还是要看自己啊",
    "vi": "Nhưng cuối cùng vẫn phải tự dựa vào chính mình thôi."
  },
  {
    "idx": 18301,
    "start": "08:50:35,310",
    "end": "08:50:36,990",
    "start_sec": 31835.31,
    "end_sec": 31836.99,
    "zh": "鬼面窗",
    "vi": "Quỷ Diện Song."
  },
  {
    "idx": 18302,
    "start": "08:50:36,990",
    "end": "08:50:38,030",
    "start_sec": 31836.99,
    "end_sec": 31838.03,
    "zh": "醒醒",
    "vi": "Tỉnh lại đi."
  },
  {
    "idx": 18303,
    "start": "08:50:38,030",
    "end": "08:50:39,230",
    "start_sec": 31838.03,
    "end_sec": 31839.23,
    "zh": "你认识这里吗",
    "vi": "Ngươi có nhận ra nơi này không."
  },
  {
    "idx": 18304,
    "start": "08:50:39,230",
    "end": "08:50:42,230",
    "start_sec": 31839.23,
    "end_sec": 31842.23,
    "zh": "好怀念的气息啊",
    "vi": "Hơi thở thật hoài niệm làm sao."
  },
  {
    "idx": 18305,
    "start": "08:50:42,230",
    "end": "08:50:42,730",
    "start_sec": 31842.23,
    "end_sec": 31842.73,
    "zh": "不对",
    "vi": "Không đúng."
  },
  {
    "idx": 18306,
    "start": "08:50:42,730",
    "end": "08:50:45,490",
    "start_sec": 31842.73,
    "end_sec": 31845.49,
    "zh": "你这里有点陌生啊",
    "vi": "Nơi này của ngươi có chút xa lạ."
  },
  {
    "idx": 18307,
    "start": "08:50:45,490",
    "end": "08:50:45,870",
    "start_sec": 31845.49,
    "end_sec": 31845.87,
    "zh": "卡尔",
    "vi": "Carl."
  },
  {
    "idx": 18308,
    "start": "08:50:45,870",
    "end": "08:50:46,890",
    "start_sec": 31845.87,
    "end_sec": 31846.89,
    "zh": "你行不行啊",
    "vi": "Ngươi có được không thế."
  },
  {
    "idx": 18309,
    "start": "08:50:46,890",
    "end": "08:50:48,230",
    "start_sec": 31846.89,
    "end_sec": 31848.23,
    "zh": "回家的路都不认识吗",
    "vi": "Đến đường về nhà cũng không nhận ra sao."
  },
  {
    "idx": 18310,
    "start": "08:50:48,230",
    "end": "08:50:49,730",
    "start_sec": 31848.23,
    "end_sec": 31849.73,
    "zh": "长子皮骂了一句",
    "vi": "Trưởng Tử Bì mắng một câu."
  },
  {
    "idx": 18311,
    "start": "08:50:49,730",
    "end": "08:50:51,930",
    "start_sec": 31849.73,
    "end_sec": 31851.93,
    "zh": "鬼面窗飞出长子皮的脖子",
    "vi": "Quỷ Diện Song bay ra khỏi cổ của Trưởng Tử Bì."
  },
  {
    "idx": 18312,
    "start": "08:50:51,930",
    "end": "08:50:53,250",
    "start_sec": 31851.93,
    "end_sec": 31853.25,
    "zh": "朝上空探进",
    "vi": "Dò xét hướng lên không trung."
  },
  {
    "idx": 18313,
    "start": "08:50:53,250",
    "end": "08:50:54,630",
    "start_sec": 31853.25,
    "end_sec": 31854.63,
    "zh": "熟悉的气息",
    "vi": "Hơi thở quen thuộc."
  },
  {
    "idx": 18314,
    "start": "08:50:54,630",
    "end": "08:50:56,990",
    "start_sec": 31854.63,
    "end_sec": 31856.99,
    "zh": "我的一些记忆好像在复苏",
    "vi": "Một số ký ức của ta dường như đang thức tỉnh."
  },
  {
    "idx": 18315,
    "start": "08:50:56,990",
    "end": "08:50:58,650",
    "start_sec": 31856.99,
    "end_sec": 31858.65,
    "zh": "等我想想",
    "vi": "Đợi ta nghĩ xem."
  },
  {
    "idx": 18316,
    "start": "08:50:58,650",
    "end": "08:51:00,310",
    "start_sec": 31858.65,
    "end_sec": 31860.31,
    "zh": "喂 你干嘛呢",
    "vi": "Này, ngươi đang làm gì thế."
  },
  {
    "idx": 18317,
    "start": "08:51:00,310",
    "end": "08:51:02,730",
    "start_sec": 31860.31,
    "end_sec": 31862.73,
    "zh": "下来 脖子都要被你扯断了",
    "vi": "Đi xuống đi, cổ ta sắp bị ngươi kéo đứt rồi."
  },
  {
    "idx": 18318,
    "start": "08:51:02,730",
    "end": "08:51:06,390",
    "start_sec": 31862.73,
    "end_sec": 31866.39,
    "zh": "不对 体内的御节黑线",
    "vi": "Không đúng, ngự tiết hắc tuyến trong cơ thể."
  },
  {
    "idx": 18319,
    "start": "08:51:06,390",
    "end": "08:51:07,790",
    "start_sec": 31866.39,
    "end_sec": 31867.79,
    "zh": "竟然也在自主蠕动",
    "vi": "Lại cũng đang tự ngọ nguậy."
  },
  {
    "idx": 18320,
    "start": "08:51:07,790",
    "end": "08:51:09,850",
    "start_sec": 31867.79,
    "end_sec": 31869.85,
    "zh": "看来这就是当案里记载的精神",
    "vi": "Xem ra đây chính là tinh thần được ghi chép trong hồ sơ."
  },
  {
    "idx": 18321,
    "start": "08:51:09,850",
    "end": "08:51:11,450",
    "start_sec": 31869.85,
    "end_sec": 31871.45,
    "zh": "无法控制诡异嘛",
    "vi": "Không thể khống chế sự quỷ dị sao."
  },
  {
    "idx": 18322,
    "start": "08:51:11,450",
    "end": "08:51:12,770",
    "start_sec": 31871.45,
    "end_sec": 31872.77,
    "zh": "鬼面窗",
    "vi": "Quỷ Diện Song."
  },
  {
    "idx": 18323,
    "start": "08:51:12,770",
    "end": "08:51:14,090",
    "start_sec": 31872.77,
    "end_sec": 31874.09,
    "zh": "无效化",
    "vi": "Vô hiệu hóa."
  },
  {
    "idx": 18324,
    "start": "08:51:14,090",
    "end": "08:51:15,750",
    "start_sec": 31874.09,
    "end_sec": 31875.75,
    "zh": "长子提大喊一声",
    "vi": "Trưởng Tử Bì hét lớn một tiếng."
  },
  {
    "idx": 18325,
    "start": "08:51:15,750",
    "end": "08:51:17,310",
    "start_sec": 31875.75,
    "end_sec": 31877.31,
    "zh": "鬼面窗却才回到肩头",
    "vi": "Quỷ Diện Song lúc này mới trở lại trên vai."
  },
  {
    "idx": 18326,
    "start": "08:51:17,310",
    "end": "08:51:19,550",
    "start_sec": 31877.31,
    "end_sec": 31879.55,
    "zh": "御节黑线也缓缓回到体内",
    "vi": "Ngự tiết hắc tuyến cũng từ từ quay lại trong cơ thể."
  },
  {
    "idx": 18327,
    "start": "08:51:19,550",
    "end": "08:51:21,330",
    "start_sec": 31879.55,
    "end_sec": 31881.33,
    "zh": "这诡计着实凶险啊",
    "vi": "Sự quỷ dị này quả thực rất nguy hiểm."
  },
  {
    "idx": 18328,
    "start": "08:51:21,330",
    "end": "08:51:22,190",
    "start_sec": 31881.33,
    "end_sec": 31882.19,
    "zh": "这要是一个不注意",
    "vi": "Nếu sơ sẩy một chút."
  },
  {
    "idx": 18329,
    "start": "08:51:22,190",
    "end": "08:51:23,470",
    "start_sec": 31882.19,
    "end_sec": 31883.47,
    "zh": "不自他的诡异复苏",
    "vi": "Chưa nói tới việc sự quỷ dị của bản thân thức tỉnh."
  },
  {
    "idx": 18330,
    "start": "08:51:23,470",
    "end": "08:51:24,810",
    "start_sec": 31883.47,
    "end_sec": 31884.81,
    "zh": "就把自己玩死了吧",
    "vi": "Mà còn tự hại chết chính mình rồi."
  },
  {
    "idx": 18331,
    "start": "08:51:24,810",
    "end": "08:51:29,444",
    "start_sec": 31884.81,
    "end_sec": 31889.444,
    "zh": "小子,我想起来了,空气中有能让鬼一兴奋的气味,这东西叫鬼煞,鬼界独有的气味",
    "vi": "Nhóc con, ta nhớ ra rồi, trong không khí có mùi hương có thể khiến quỷ phấn khích,"
  },
  {
    "idx": 18331,
    "start": "08:51:29,444",
    "end": "08:51:32,790",
    "start_sec": 31889.444,
    "end_sec": 31892.79,
    "zh": "小子,我想起来了,空气中有能让鬼一兴奋的气味,这东西叫鬼煞,鬼界独有的气味",
    "vi": "thứ này gọi là Quỷ Sát, mùi hương độc nhất của Quỷ giới."
  },
  {
    "idx": 18332,
    "start": "08:51:32,790",
    "end": "08:51:37,430",
    "start_sec": 31892.79,
    "end_sec": 31897.43,
    "zh": "行,无效化你就一直开着吧,我会想办法给你找到补充食物的",
    "vi": "Được rồi, ông cứ bật trạng thái vô hiệu hóa liên tục đi, tôi sẽ nghĩ cách tìm thức ăn bổ sung cho ông."
  },
  {
    "idx": 18333,
    "start": "08:51:37,430",
    "end": "08:51:41,030",
    "start_sec": 31897.43,
    "end_sec": 31901.03,
    "zh": "不用,因为这里是鬼界,消耗并不大",
    "vi": "Không cần đâu, vì đây là Quỷ giới nên tiêu hao không lớn lắm."
  },
  {
    "idx": 18334,
    "start": "08:51:41,030",
    "end": "08:51:46,110",
    "start_sec": 31901.03,
    "end_sec": 31906.11,
    "zh": "对了,小子,向南走,我刚刚飞起来看到南边有建筑",
    "vi": "Đúng rồi nhóc con, đi về phía nam đi, ta vừa bay lên thì thấy phía nam có kiến trúc."
  },
  {
    "idx": 18335,
    "start": "08:51:46,110",
    "end": "08:51:49,350",
    "start_sec": 31906.11,
    "end_sec": 31909.35,
    "zh": "建筑,不是你们鬼界也有建筑吗?",
    "vi": "Kiến trúc sao. Không phải Quỷ giới của các ông cũng có kiến trúc à."
  },
  {
    "idx": 18336,
    "start": "08:51:49,390",
    "end": "08:51:54,270",
    "start_sec": 31909.39,
    "end_sec": 31914.27,
    "zh": "鬼会盖牢,长者皮还是不紧,但还是轻松鬼面疮的往南走",
    "vi": "Quỷ mà cũng biết xây nhà sao. Trần Tử Bì tuy vẫn cảnh giác nhưng vẫn đi về phía nam."
  },
  {
    "idx": 18337,
    "start": "08:51:54,270",
    "end": "08:51:56,710",
    "start_sec": 31914.27,
    "end_sec": 31916.71,
    "zh": "树林里有黑影在乱窜乱跳",
    "vi": "Trong rừng có những bóng đen đang chạy nhảy loạn xạ."
  },
  {
    "idx": 18338,
    "start": "08:51:56,710",
    "end": "08:51:58,730",
    "start_sec": 31916.71,
    "end_sec": 31918.73,
    "zh": "或许是碍于无效化的危压",
    "vi": "Có lẽ là do e ngại uy áp của vô hiệu hóa."
  },
  {
    "idx": 18339,
    "start": "08:51:58,730",
    "end": "08:52:00,250",
    "start_sec": 31918.73,
    "end_sec": 31920.25,
    "zh": "黑影没敢出来发作",
    "vi": "Nên những bóng đen không dám lao ra tấn công."
  },
  {
    "idx": 18340,
    "start": "08:52:00,250",
    "end": "08:52:02,070",
    "start_sec": 31920.25,
    "end_sec": 31922.07,
    "zh": "这月往南",
    "vi": "Càng đi về phía nam."
  },
  {
    "idx": 18341,
    "start": "08:52:02,070",
    "end": "08:52:03,710",
    "start_sec": 31922.07,
    "end_sec": 31923.71,
    "zh": "十月走到树林深处了",
    "vi": "Trần Tử Bì đã đi vào sâu trong rừng."
  },
  {
    "idx": 18342,
    "start": "08:52:03,710",
    "end": "08:52:04,230",
    "start_sec": 31923.71,
    "end_sec": 31924.23,
    "zh": "突然",
    "vi": "Bỗng nhiên."
  },
  {
    "idx": 18343,
    "start": "08:52:04,230",
    "end": "08:52:05,430",
    "start_sec": 31924.23,
    "end_sec": 31925.43,
    "zh": "橙子皮发现",
    "vi": "Trần Tử Bì phát hiện."
  },
  {
    "idx": 18344,
    "start": "08:52:05,430",
    "end": "08:52:08,090",
    "start_sec": 31925.43,
    "end_sec": 31928.09,
    "zh": "一片巨大的建筑出现的原本",
    "vi": "Một khu kiến trúc khổng lồ xuất hiện."
  },
  {
    "idx": 18345,
    "start": "08:52:08,090",
    "end": "08:52:09,870",
    "start_sec": 31928.09,
    "end_sec": 31929.87,
    "zh": "恒星市福利院",
    "vi": "Viện mồ côi thành phố Hằng Tinh."
  },
  {
    "idx": 18346,
    "start": "08:52:09,870",
    "end": "08:52:11,770",
    "start_sec": 31929.87,
    "end_sec": 31931.77,
    "zh": "看起来这么有爱的福利院",
    "vi": "Một viện mồ côi trông đầy tình thương thế này."
  },
  {
    "idx": 18347,
    "start": "08:52:11,770",
    "end": "08:52:13,670",
    "start_sec": 31931.77,
    "end_sec": 31933.67,
    "zh": "出现在这阴森死寂的树林里",
    "vi": "Lại xuất hiện trong khu rừng âm u chết chóc này."
  },
  {
    "idx": 18348,
    "start": "08:52:13,670",
    "end": "08:52:14,610",
    "start_sec": 31933.67,
    "end_sec": 31934.61,
    "zh": "太诡异了吧",
    "vi": "Thật là quá kỳ dị."
  },
  {
    "idx": 18349,
    "start": "08:52:14,610",
    "end": "08:52:15,270",
    "start_sec": 31934.61,
    "end_sec": 31935.27,
    "zh": "不对",
    "vi": "Không đúng."
  },
  {
    "idx": 18350,
    "start": "08:52:15,270",
    "end": "08:52:16,870",
    "start_sec": 31935.27,
    "end_sec": 31936.87,
    "zh": "那我现在是在恒星市",
    "vi": "Vậy bây giờ tôi đang ở thành phố Hằng Tinh."
  },
  {
    "idx": 18351,
    "start": "08:52:16,870",
    "end": "08:52:18,070",
    "start_sec": 31936.87,
    "end_sec": 31938.07,
    "zh": "还是在鬼界啊",
    "vi": "Hay là đang ở Quỷ giới vậy."
  },
  {
    "idx": 18352,
    "start": "08:52:18,070",
    "end": "08:52:19,990",
    "start_sec": 31938.07,
    "end_sec": 31939.99,
    "zh": "鬼界吞噬了部分空间",
    "vi": "Quỷ giới đã nuốt chửng một phần không gian."
  },
  {
    "idx": 18353,
    "start": "08:52:19,990",
    "end": "08:52:21,330",
    "start_sec": 31939.99,
    "end_sec": 31941.33,
    "zh": "可能这家福利院",
    "vi": "Có lẽ viện mồ côi này."
  },
  {
    "idx": 18354,
    "start": "08:52:21,330",
    "end": "08:52:22,910",
    "start_sec": 31941.33,
    "end_sec": 31942.91,
    "zh": "也被吞到了鬼界之内",
    "vi": "Cũng bị hút vào trong Quỷ giới rồi."
  },
  {
    "idx": 18355,
    "start": "08:52:22,910",
    "end": "08:52:24,570",
    "start_sec": 31942.91,
    "end_sec": 31944.57,
    "zh": "那我还有进去的必要吗",
    "vi": "Vậy tôi có cần thiết phải đi vào trong không."
  },
  {
    "idx": 18356,
    "start": "08:52:24,570",
    "end": "08:52:25,650",
    "start_sec": 31944.57,
    "end_sec": 31945.65,
    "zh": "进去吧",
    "vi": "Vào đi."
  },
  {
    "idx": 18357,
    "start": "08:52:25,650",
    "end": "08:52:27,250",
    "start_sec": 31945.65,
    "end_sec": 31947.25,
    "zh": "我刚刚飞到半空",
    "vi": "Ta vừa bay lên không trung."
  },
  {
    "idx": 18358,
    "start": "08:52:27,250",
    "end": "08:52:29,150",
    "start_sec": 31947.25,
    "end_sec": 31949.15,
    "zh": "附近只能看到这个建筑",
    "vi": "Xung quanh chỉ nhìn thấy mỗi tòa nhà này."
  },
  {
    "idx": 18359,
    "start": "08:52:29,150",
    "end": "08:52:30,910",
    "start_sec": 31949.15,
    "end_sec": 31950.91,
    "zh": "应该是鬼域限制",
    "vi": "Chắc là do giới hạn của Quỷ vực."
  },
  {
    "idx": 18360,
    "start": "08:52:30,910",
    "end": "08:52:32,090",
    "start_sec": 31950.91,
    "end_sec": 31952.09,
    "zh": "鬼域吗",
    "vi": "Quỷ vực sao."
  },
  {
    "idx": 18361,
    "start": "08:52:32,090",
    "end": "08:52:33,350",
    "start_sec": 31952.09,
    "end_sec": 31953.35,
    "zh": "看来报告里说的",
    "vi": "Xem ra những gì báo cáo nói"
  },
  {
    "idx": 18362,
    "start": "08:52:33,350",
    "end": "08:52:34,790",
    "start_sec": 31953.35,
    "end_sec": 31954.79,
    "zh": "不同人进入不同的世界",
    "vi": "những người khác nhau đi vào các thế giới khác nhau"
  },
  {
    "idx": 18363,
    "start": "08:52:34,790",
    "end": "08:52:36,710",
    "start_sec": 31954.79,
    "end_sec": 31956.71,
    "zh": "其实是进入了不同鬼域",
    "vi": "thực chất là đã đi vào các Quỷ vực khác nhau."
  },
  {
    "idx": 18364,
    "start": "08:52:36,710",
    "end": "08:52:37,230",
    "start_sec": 31956.71,
    "end_sec": 31957.23,
    "zh": "这么说",
    "vi": "Nói như vậy"
  },
  {
    "idx": 18365,
    "start": "08:52:37,230",
    "end": "08:52:39,970",
    "start_sec": 31957.23,
    "end_sec": 31959.97,
    "zh": "鬼界其实是由不同鬼域组建而成的吗",
    "vi": "Quỷ giới thực chất được cấu thành từ các Quỷ vực khác nhau sao."
  },
  {
    "idx": 18366,
    "start": "08:52:39,970",
    "end": "08:52:41,390",
    "start_sec": 31959.97,
    "end_sec": 31961.39,
    "zh": "你也可以这么想",
    "vi": "Ngươi cũng có thể nghĩ như vậy."
  },
  {
    "idx": 18367,
    "start": "08:52:41,390",
    "end": "08:52:44,590",
    "start_sec": 31961.39,
    "end_sec": 31964.59,
    "zh": "毕竟鬼界里有实力的鬼异太多了",
    "vi": "Dù sao thì trong Quỷ giới có quá nhiều quỷ dị mạnh mẽ."
  },
  {
    "idx": 18368,
    "start": "08:52:44,590",
    "end": "08:52:45,490",
    "start_sec": 31964.59,
    "end_sec": 31965.49,
    "zh": "他们的鬼域",
    "vi": "Quỷ vực của bọn chúng"
  },
  {
    "idx": 18369,
    "start": "08:52:45,490",
    "end": "08:52:48,350",
    "start_sec": 31965.49,
    "end_sec": 31968.35,
    "zh": "应该早就把鬼界分割得七零八落了",
    "vi": "chắc là đã sớm chia cắt Quỷ giới thành trăm mảnh rồi."
  },
  {
    "idx": 18370,
    "start": "08:52:48,350",
    "end": "08:52:54,128",
    "start_sec": 31968.35,
    "end_sec": 31974.128,
    "zh": "橙子皮无奈地来到恒星市福利院大门前试图用手去推那秀气斑斑的铁门推不动啊府立院建这么高的门干嘛吐槽一番层子提深周三车预结风险一跃翻过高墙进入院内",
    "vi": "Trần Tử Bì bất lực đi đến trước cổng Viện mồ côi thành phố Hằng Tinh, cố dùng tay đẩy cánh cổng sắt hoen gỉ"
  },
  {
    "idx": 18370,
    "start": "08:52:54,128",
    "end": "08:52:57,133",
    "start_sec": 31974.128,
    "end_sec": 31977.133,
    "zh": "橙子皮无奈地来到恒星市福利院大门前试图用手去推那秀气斑斑的铁门推不动啊府立院建这么高的门干嘛吐槽一番层子提深周三车预结风险一跃翻过高墙进入院内",
    "vi": "Không đẩy nổi, viện mồ côi xây cổng cao thế này làm gì"
  },
  {
    "idx": 18370,
    "start": "08:52:57,133",
    "end": "08:53:01,755",
    "start_sec": 31977.133,
    "end_sec": 31981.755,
    "zh": "橙子皮无奈地来到恒星市福利院大门前试图用手去推那秀气斑斑的铁门推不动啊府立院建这么高的门干嘛吐槽一番层子提深周三车预结风险一跃翻过高墙进入院内",
    "vi": "Sau khi phàn nàn một hồi, Trần Tử Bì lấy đà nhảy qua bức tường cao để vào trong viện"
  },
  {
    "idx": 18371,
    "start": "08:53:21,115",
    "end": "08:53:25,335",
    "start_sec": 32001.115,
    "end_sec": 32005.335,
    "zh": "该死",
    "vi": "Đáng chết."
  },
  {
    "idx": 18372,
    "start": "08:53:25,335",
    "end": "08:53:26,675",
    "start_sec": 32005.335,
    "end_sec": 32006.675,
    "zh": "怎么突然有点耳鸣",
    "vi": "Sao tự nhiên tai lại hơi ù thế này."
  },
  {
    "idx": 18373,
    "start": "08:53:26,675",
    "end": "08:53:29,315",
    "start_sec": 32006.675,
    "end_sec": 32009.315,
    "zh": "教室楼",
    "vi": "Tòa nhà học."
  },
  {
    "idx": 18374,
    "start": "08:53:29,315",
    "end": "08:53:30,155",
    "start_sec": 32009.315,
    "end_sec": 32010.155,
    "zh": "住宿楼",
    "vi": "Tòa nhà ký túc xá."
  },
  {
    "idx": 18375,
    "start": "08:53:30,155",
    "end": "08:53:30,955",
    "start_sec": 32010.155,
    "end_sec": 32010.955,
    "zh": "食堂",
    "vi": "Nhà ăn."
  },
  {
    "idx": 18376,
    "start": "08:53:30,955",
    "end": "08:53:34,295",
    "start_sec": 32010.955,
    "end_sec": 32014.295,
    "zh": "先去教学楼看看吧",
    "vi": "Đến tòa nhà học xem trước đã."
  },
  {
    "idx": 18377,
    "start": "08:53:34,295",
    "end": "08:53:38,055",
    "start_sec": 32014.295,
    "end_sec": 32018.055,
    "zh": "这里",
    "vi": "Nơi này"
  },
  {
    "idx": 18378,
    "start": "08:53:38,055",
    "end": "08:53:39,975",
    "start_sec": 32018.055,
    "end_sec": 32019.975,
    "zh": "这里是哪里",
    "vi": "nơi này là đâu thế."
  },
  {
    "idx": 18379,
    "start": "08:53:39,975",
    "end": "08:53:40,775",
    "start_sec": 32019.975,
    "end_sec": 32020.775,
    "zh": "不错",
    "vi": "Đúng vậy."
  },
  {
    "idx": 18380,
    "start": "08:53:40,775",
    "end": "08:53:41,675",
    "start_sec": 32020.775,
    "end_sec": 32021.675,
    "zh": "教室",
    "vi": "Lớp học."
  },
  {
    "idx": 18381,
    "start": "08:53:41,675",
    "end": "08:53:43,075",
    "start_sec": 32021.675,
    "end_sec": 32023.075,
    "zh": "我怎么会在这里",
    "vi": "Sao ta lại ở đây."
  },
  {
    "idx": 18382,
    "start": "08:53:43,075",
    "end": "08:53:44,595",
    "start_sec": 32023.075,
    "end_sec": 32024.595,
    "zh": "不对",
    "vi": "Không đúng."
  },
  {
    "idx": 18383,
    "start": "08:53:44,595",
    "end": "08:53:45,835",
    "start_sec": 32024.595,
    "end_sec": 32025.835,
    "zh": "林一",
    "vi": "Lâm Nhất."
  },
  {
    "idx": 18384,
    "start": "08:53:45,835",
    "end": "08:53:47,535",
    "start_sec": 32025.835,
    "end_sec": 32027.535,
    "zh": "你怎么也在这里啊",
    "vi": "Sao ngươi cũng ở đây thế."
  },
  {
    "idx": 18385,
    "start": "08:53:47,535",
    "end": "08:53:48,695",
    "start_sec": 32027.535,
    "end_sec": 32028.695,
    "zh": "我怎么知道",
    "vi": "Sao ta biết được."
  },
  {
    "idx": 18386,
    "start": "08:53:48,695",
    "end": "08:53:49,695",
    "start_sec": 32028.695,
    "end_sec": 32029.695,
    "zh": "我还好奇",
    "vi": "Ta còn đang thắc mắc"
  },
  {
    "idx": 18387,
    "start": "08:53:49,695",
    "end": "08:53:51,515",
    "start_sec": 32029.695,
    "end_sec": 32031.515,
    "zh": "你怎么和我一起出现在这里呢",
    "vi": "sao ngươi lại xuất hiện ở đây cùng ta đấy."
  },
  {
    "idx": 18388,
    "start": "08:53:51,515",
    "end": "08:53:53,915",
    "start_sec": 32031.515,
    "end_sec": 32033.915,
    "zh": "你上次不是来过一趟吗",
    "vi": "Không phải lần trước ngươi đã đến đây một chuyến rồi sao."
  },
  {
    "idx": 18389,
    "start": "08:53:53,915",
    "end": "08:53:55,835",
    "start_sec": 32033.915,
    "end_sec": 32035.835,
    "zh": "现在是个什么情况",
    "vi": "Bây giờ là tình hình thế nào rồi."
  },
  {
    "idx": 18390,
    "start": "08:53:55,835",
    "end": "08:53:58,595",
    "start_sec": 32035.835,
    "end_sec": 32038.595,
    "zh": "我大概明白了",
    "vi": "Ta đại khái hiểu rồi."
  },
  {
    "idx": 18391,
    "start": "08:53:58,595",
    "end": "08:54:00,235",
    "start_sec": 32038.595,
    "end_sec": 32040.235,
    "zh": "我们俩被吸进同一个鬼域了",
    "vi": "Hai chúng ta bị hút vào cùng một vùng quỷ dị rồi."
  },
  {
    "idx": 18392,
    "start": "08:54:00,235",
    "end": "08:54:01,375",
    "start_sec": 32040.235,
    "end_sec": 32041.375,
    "zh": "如果是这样的话",
    "vi": "Nếu đúng là vậy."
  },
  {
    "idx": 18393,
    "start": "08:54:01,375",
    "end": "08:54:04,035",
    "start_sec": 32041.375,
    "end_sec": 32044.035,
    "zh": "那么这只鬼域的强度可不低啊",
    "vi": "Thì vùng quỷ dị này có sức mạnh không hề tầm thường."
  },
  {
    "idx": 18394,
    "start": "08:54:04,035",
    "end": "08:54:05,435",
    "start_sec": 32044.035,
    "end_sec": 32045.435,
    "zh": "不是说好了",
    "vi": "Chẳng phải đã thống nhất là."
  },
  {
    "idx": 18395,
    "start": "08:54:05,435",
    "end": "08:54:08,235",
    "start_sec": 32045.435,
    "end_sec": 32048.235,
    "zh": "优先解决01一派吗",
    "vi": "Ưu tiên giải quyết phe 01 trước sao."
  },
  {
    "idx": 18396,
    "start": "08:54:08,235",
    "end": "08:54:09,615",
    "start_sec": 32048.235,
    "end_sec": 32049.615,
    "zh": "这鬼域这么强",
    "vi": "Vùng quỷ dị này mạnh thế này."
  },
  {
    "idx": 18397,
    "start": "08:54:09,615",
    "end": "08:54:11,275",
    "start_sec": 32049.615,
    "end_sec": 32051.275,
    "zh": "我们不会栽在这吧",
    "vi": "Liệu chúng ta có bỏ mạng ở đây không."
  },
  {
    "idx": 18398,
    "start": "08:54:11,275",
    "end": "08:54:13,295",
    "start_sec": 32051.275,
    "end_sec": 32053.295,
    "zh": "优先注定01的人吗",
    "vi": "Ưu tiên giải quyết người của 01 sao."
  },
  {
    "idx": 18399,
    "start": "08:54:13,295",
    "end": "08:54:15,575",
    "start_sec": 32053.295,
    "end_sec": 32055.575,
    "zh": "看来这俩或是0203的人",
    "vi": "Xem ra hai kẻ này là người của 02 hoặc 03."
  },
  {
    "idx": 18400,
    "start": "08:54:15,575",
    "end": "08:54:17,275",
    "start_sec": 32055.575,
    "end_sec": 32057.275,
    "zh": "今世于鬼者基地",
    "vi": "Căn cứ Ngự Quỷ Giả hiện tại."
  },
  {
    "idx": 18401,
    "start": "08:54:17,275",
    "end": "08:54:19,355",
    "start_sec": 32057.275,
    "end_sec": 32059.355,
    "zh": "迟早要被你们这群二五仔玩烂",
    "vi": "Sớm muộn gì cũng bị lũ phản bội các người phá nát."
  },
  {
    "idx": 18402,
    "start": "08:54:19,355",
    "end": "08:54:21,315",
    "start_sec": 32059.355,
    "end_sec": 32061.315,
    "zh": "进入教学楼",
    "vi": "Bước vào tòa nhà giảng đường."
  },
  {
    "idx": 18403,
    "start": "08:54:21,315",
    "end": "08:54:23,955",
    "start_sec": 32061.315,
    "end_sec": 32063.955,
    "zh": "橙子皮紧急的走进其中一间教室",
    "vi": "Trần Tử Bì vội vã đi vào một trong những phòng học."
  },
  {
    "idx": 18404,
    "start": "08:54:23,955",
    "end": "08:54:27,635",
    "start_sec": 32063.955,
    "end_sec": 32067.635,
    "zh": "他现在并不想这么快和这两个御鬼者发生冲突",
    "vi": "Cậu ta hiện tại không muốn xung đột với hai Ngự Quỷ Giả này quá sớm."
  },
  {
    "idx": 18405,
    "start": "08:54:27,635",
    "end": "08:54:32,875",
    "start_sec": 32067.635,
    "end_sec": 32072.875,
    "zh": "黑板上的三个猴子脑袋像是被人擦去了",
    "vi": "Ba cái đầu khỉ trên bảng đen dường như đã bị ai đó xóa đi."
  },
  {
    "idx": 18406,
    "start": "08:54:32,875",
    "end": "08:54:34,815",
    "start_sec": 32072.875,
    "end_sec": 32074.815,
    "zh": "是为了掩饰什么吗",
    "vi": "Là để che giấu điều gì đó sao."
  },
  {
    "idx": 18407,
    "start": "08:54:34,815",
    "end": "08:54:35,855",
    "start_sec": 32074.815,
    "end_sec": 32075.855,
    "zh": "奇怪了",
    "vi": "Lạ thật."
  },
  {
    "idx": 18408,
    "start": "08:54:35,855",
    "end": "08:54:38,555",
    "start_sec": 32075.855,
    "end_sec": 32078.555,
    "zh": "为什么我会对这里有种莫名的熟悉感",
    "vi": "Tại sao tôi lại có cảm giác quen thuộc khó hiểu ở đây."
  },
  {
    "idx": 18409,
    "start": "08:54:38,555",
    "end": "08:54:41,595",
    "start_sec": 32078.555,
    "end_sec": 32081.595,
    "zh": "突然橙子皮再次耳鸣",
    "vi": "Đột nhiên Trần Tử Bì lại bị ù tai lần nữa."
  },
  {
    "idx": 18410,
    "start": "08:54:41,595",
    "end": "08:54:44,635",
    "start_sec": 32081.595,
    "end_sec": 32084.635,
    "zh": "耳膜似要被刺穿般的疼痛起来",
    "vi": "Màng nhĩ đau nhức như sắp bị đâm thủng."
  },
  {
    "idx": 18411,
    "start": "08:54:44,635",
    "end": "08:54:46,175",
    "start_sec": 32084.635,
    "end_sec": 32086.175,
    "zh": "为什么",
    "vi": "Tại sao."
  },
  {
    "idx": 18412,
    "start": "08:54:46,175",
    "end": "08:54:48,535",
    "start_sec": 32086.175,
    "end_sec": 32088.535,
    "zh": "你还要回来",
    "vi": "Bạn còn quay lại đây làm gì."
  },
  {
    "idx": 18413,
    "start": "08:54:49,355",
    "end": "08:54:53,055",
    "start_sec": 32089.355,
    "end_sec": 32093.055,
    "zh": "该死",
    "vi": "Chết tiệt."
  },
  {
    "idx": 18414,
    "start": "08:54:53,055",
    "end": "08:54:55,095",
    "start_sec": 32093.055,
    "end_sec": 32095.095,
    "zh": "这诡异在破坏我的听觉",
    "vi": "Thứ quỷ dị này đang phá hủy thính giác của tôi."
  },
  {
    "idx": 18415,
    "start": "08:54:55,095",
    "end": "08:54:57,055",
    "start_sec": 32095.095,
    "end_sec": 32097.055,
    "zh": "无效化一直在开着",
    "vi": "Khả năng vô hiệu hóa vẫn đang bật."
  },
  {
    "idx": 18416,
    "start": "08:54:57,055",
    "end": "08:54:57,935",
    "start_sec": 32097.055,
    "end_sec": 32097.935,
    "zh": "只能说明",
    "vi": "Chỉ có thể giải thích là."
  },
  {
    "idx": 18417,
    "start": "08:54:57,935",
    "end": "08:54:59,035",
    "start_sec": 32097.935,
    "end_sec": 32099.035,
    "zh": "这诡异的能力",
    "vi": "Năng lực của thứ quỷ dị này."
  },
  {
    "idx": 18418,
    "start": "08:54:59,035",
    "end": "08:55:00,435",
    "start_sec": 32099.035,
    "end_sec": 32100.435,
    "zh": "无法被无效化",
    "vi": "Không thể bị vô hiệu hóa."
  },
  {
    "idx": 18419,
    "start": "08:55:00,435",
    "end": "08:55:02,935",
    "start_sec": 32100.435,
    "end_sec": 32102.935,
    "zh": "在橙子皮逐渐失去听觉时",
    "vi": "Khi Trần Tử Bì dần mất đi thính giác."
  },
  {
    "idx": 18420,
    "start": "08:55:02,935",
    "end": "08:55:04,595",
    "start_sec": 32102.935,
    "end_sec": 32104.595,
    "zh": "门外迅速飞来一个星",
    "vi": "Một ngôi sao nhanh chóng bay từ ngoài cửa vào."
  },
  {
    "idx": 18421,
    "start": "08:55:04,595",
    "end": "08:55:06,275",
    "start_sec": 32104.595,
    "end_sec": 32106.275,
    "zh": "撞向橙子皮的影子",
    "vi": "Lao vào cái bóng của Trần Tử Bì."
  },
  {
    "idx": 18422,
    "start": "08:55:06,275",
    "end": "08:55:07,835",
    "start_sec": 32106.275,
    "end_sec": 32107.835,
    "zh": "明明是影子被撞",
    "vi": "Rõ ràng là cái bóng bị va trúng."
  },
  {
    "idx": 18423,
    "start": "08:55:07,835",
    "end": "08:55:09,135",
    "start_sec": 32107.835,
    "end_sec": 32109.135,
    "zh": "橙子皮的身体",
    "vi": "Nhưng cơ thể của Trần Tử Bì."
  },
  {
    "idx": 18424,
    "start": "08:55:09,135",
    "end": "08:55:10,495",
    "start_sec": 32109.135,
    "end_sec": 32110.495,
    "zh": "却也奔着影子摔不起",
    "vi": "Cũng ngã nhào theo cái bóng đó."
  },
  {
    "idx": 18425,
    "start": "08:55:10,495",
    "end": "08:55:11,455",
    "start_sec": 32110.495,
    "end_sec": 32111.455,
    "zh": "该死",
    "vi": "Khốn kiếp."
  },
  {
    "idx": 18426,
    "start": "08:55:11,455",
    "end": "08:55:12,555",
    "start_sec": 32111.455,
    "end_sec": 32112.555,
    "zh": "这时候被偷袭",
    "vi": "Lại bị đánh lén vào lúc này."
  },
  {
    "idx": 18427,
    "start": "08:55:12,555",
    "end": "08:55:13,755",
    "start_sec": 32112.555,
    "end_sec": 32113.755,
    "zh": "是林一吗",
    "vi": "Là Lâm Nhất sao."
  },
  {
    "idx": 18428,
    "start": "08:55:13,755",
    "end": "08:55:14,975",
    "start_sec": 32113.755,
    "end_sec": 32114.975,
    "zh": "哦",
    "vi": "Ồ."
  },
  {
    "idx": 18429,
    "start": "08:55:14,975",
    "end": "08:55:16,515",
    "start_sec": 32114.975,
    "end_sec": 32116.515,
    "zh": "你觉得发现了",
    "vi": "Ngươi nghĩ là đã phát hiện ra rồi sao."
  },
  {
    "idx": 18430,
    "start": "08:55:16,515",
    "end": "08:55:17,615",
    "start_sec": 32116.515,
    "end_sec": 32117.615,
    "zh": "好",
    "vi": "Được lắm."
  },
  {
    "idx": 18431,
    "start": "08:55:17,615",
    "end": "08:55:19,255",
    "start_sec": 32117.615,
    "end_sec": 32119.255,
    "zh": "暗地里应该还有个女的",
    "vi": "Trong bóng tối chắc vẫn còn một đứa con gái."
  },
  {
    "idx": 18432,
    "start": "08:55:19,255",
    "end": "08:55:20,395",
    "start_sec": 32119.255,
    "end_sec": 32120.395,
    "zh": "真要打起来",
    "vi": "Nếu thực sự đánh nhau."
  },
  {
    "idx": 18433,
    "start": "08:55:20,395",
    "end": "08:55:21,635",
    "start_sec": 32120.395,
    "end_sec": 32121.635,
    "zh": "加上那个未知的诡异",
    "vi": "Cộng thêm thế lực quỷ dị chưa biết kia."
  },
  {
    "idx": 18434,
    "start": "08:55:21,635",
    "end": "08:55:23,335",
    "start_sec": 32121.635,
    "end_sec": 32123.335,
    "zh": "现在我会是一对三的局面",
    "vi": "Bây giờ mình sẽ rơi vào thế một đấu ba."
  },
  {
    "idx": 18435,
    "start": "08:55:23,335",
    "end": "08:55:27,755",
    "start_sec": 32123.335,
    "end_sec": 32127.755,
    "zh": "我本来以为这里就我和013的",
    "vi": "Ta vốn tưởng ở đây chỉ có ta và không một ba."
  },
  {
    "idx": 18436,
    "start": "08:55:27,755",
    "end": "08:55:29,335",
    "start_sec": 32127.755,
    "end_sec": 32129.335,
    "zh": "没想到啊",
    "vi": "Không ngờ được."
  },
  {
    "idx": 18437,
    "start": "08:55:29,335",
    "end": "08:55:30,235",
    "start_sec": 32129.335,
    "end_sec": 32130.235,
    "zh": "橙子皮你也在",
    "vi": "Trần Tử Bì ngươi cũng ở đây."
  },
  {
    "idx": 18438,
    "start": "08:55:30,235",
    "end": "08:55:32,395",
    "start_sec": 32130.235,
    "end_sec": 32132.395,
    "zh": "你最近风头很瘦啊",
    "vi": "Dạo này ngươi nổi tiếng lắm mà."
  },
  {
    "idx": 18439,
    "start": "08:55:32,395",
    "end": "08:55:33,575",
    "start_sec": 32132.395,
    "end_sec": 32133.575,
    "zh": "要是把你宰了",
    "vi": "Nếu ta giết chết ngươi."
  },
  {
    "idx": 18440,
    "start": "08:55:33,575",
    "end": "08:55:35,915",
    "start_sec": 32133.575,
    "end_sec": 32135.915,
    "zh": "你猜我能从上头那里拿多少好处呢",
    "vi": "Ngươi đoán xem ta sẽ nhận được bao nhiêu lợi ích từ cấp trên đây."
  },
  {
    "idx": 18441,
    "start": "08:55:35,915",
    "end": "08:55:37,415",
    "start_sec": 32135.915,
    "end_sec": 32137.415,
    "zh": "看01这架势",
    "vi": "Nhìn thế trận này của không một."
  },
  {
    "idx": 18442,
    "start": "08:55:37,415",
    "end": "08:55:38,595",
    "start_sec": 32137.415,
    "end_sec": 32138.595,
    "zh": "一点影响都没有",
    "vi": "Không hề bị ảnh hưởng chút nào."
  },
  {
    "idx": 18443,
    "start": "08:55:38,595",
    "end": "08:55:40,775",
    "start_sec": 32138.595,
    "end_sec": 32140.775,
    "zh": "为什么这诡异会针对我呢",
    "vi": "Tại sao thế lực quỷ dị này lại nhắm vào mình chứ."
  },
  {
    "idx": 18444,
    "start": "08:55:40,775",
    "end": "08:55:43,055",
    "start_sec": 32140.775,
    "end_sec": 32143.055,
    "zh": "突然一抹白光炸裂",
    "vi": "Đột nhiên một luồng ánh sáng trắng bùng nổ."
  },
  {
    "idx": 18445,
    "start": "08:55:43,055",
    "end": "08:55:45,415",
    "start_sec": 32143.055,
    "end_sec": 32145.415,
    "zh": "向橙子皮飞速起来",
    "vi": "Lao nhanh về phía Trần Tử Bì."
  },
  {
    "idx": 18446,
    "start": "08:55:45,415",
    "end": "08:55:46,935",
    "start_sec": 32145.415,
    "end_sec": 32146.935,
    "zh": "遇见鬼了",
    "vi": "Gặp quỷ rồi."
  },
  {
    "idx": 18447,
    "start": "08:55:46,935",
    "end": "08:55:47,875",
    "start_sec": 32146.935,
    "end_sec": 32147.875,
    "zh": "黑云鬼月",
    "vi": "Hắc Vân Quỷ Nguyệt."
  },
  {
    "idx": 18448,
    "start": "08:55:47,875",
    "end": "08:55:52,015",
    "start_sec": 32147.875,
    "end_sec": 32152.015,
    "zh": "该死又消失了",
    "vi": "Khốn kiếp lại biến mất rồi."
  },
  {
    "idx": 18449,
    "start": "08:55:52,015",
    "end": "08:55:53,375",
    "start_sec": 32152.015,
    "end_sec": 32153.375,
    "zh": "这家伙的能力",
    "vi": "Năng lực của tên này."
  },
  {
    "idx": 18450,
    "start": "08:55:53,375",
    "end": "08:55:54,155",
    "start_sec": 32153.375,
    "end_sec": 32154.155,
    "zh": "一个是云",
    "vi": "Một cái là mây."
  },
  {
    "idx": 18451,
    "start": "08:55:54,155",
    "end": "08:55:55,015",
    "start_sec": 32154.155,
    "end_sec": 32155.015,
    "zh": "另一个是光",
    "vi": "Cái còn lại là ánh sáng."
  },
  {
    "idx": 18452,
    "start": "08:55:55,015",
    "end": "08:55:56,915",
    "start_sec": 32155.015,
    "end_sec": 32156.915,
    "zh": "整个教室内",
    "vi": "Trong cả phòng học."
  },
  {
    "idx": 18453,
    "start": "08:55:56,915",
    "end": "08:55:58,835",
    "start_sec": 32156.915,
    "end_sec": 32158.835,
    "zh": "已经下起了密集的黑影",
    "vi": "Đã bắt đầu rơi xuống những bóng đen dày đặc."
  },
  {
    "idx": 18454,
    "start": "08:55:58,835",
    "end": "08:55:59,455",
    "start_sec": 32158.835,
    "end_sec": 32159.455,
    "zh": "一气呵欠",
    "vi": "Trong chớp mắt."
  },
  {
    "idx": 18455,
    "start": "08:55:59,455",
    "end": "08:56:01,555",
    "start_sec": 32159.455,
    "end_sec": 32161.555,
    "zh": "淋浴的阵营在雨四中穿梭",
    "vi": "Lâm Nhất Nguyên di chuyển nhanh trong làn mưa."
  },
  {
    "idx": 18456,
    "start": "08:56:11,855",
    "end": "08:56:12,875",
    "start_sec": 32171.855,
    "end_sec": 32172.875,
    "zh": "不愧是雨节鬼",
    "vi": "Không hổ danh là Vũ Tiết Quỷ."
  },
  {
    "idx": 18457,
    "start": "08:56:12,875",
    "end": "08:56:14,275",
    "start_sec": 32172.875,
    "end_sec": 32174.275,
    "zh": "光速一击都能挡住",
    "vi": "Đến đòn tấn công tốc độ ánh sáng cũng đỡ được."
  },
  {
    "idx": 18458,
    "start": "08:56:14,275",
    "end": "08:56:16,015",
    "start_sec": 32174.275,
    "end_sec": 32176.015,
    "zh": "强度可不低啊",
    "vi": "Sức mạnh không hề nhỏ đâu."
  },
  {
    "idx": 18459,
    "start": "08:56:16,015",
    "end": "08:56:17,575",
    "start_sec": 32176.015,
    "end_sec": 32177.575,
    "zh": "为什么",
    "vi": "Tại sao."
  },
  {
    "idx": 18460,
    "start": "08:56:17,575",
    "end": "08:56:19,655",
    "start_sec": 32177.575,
    "end_sec": 32179.655,
    "zh": "大家都死了",
    "vi": "Mọi người đều chết rồi."
  },
  {
    "idx": 18461,
    "start": "08:56:19,655",
    "end": "08:56:20,995",
    "start_sec": 32179.655,
    "end_sec": 32180.995,
    "zh": "都死了",
    "vi": "Đều chết hết rồi."
  },
  {
    "idx": 18462,
    "start": "08:56:20,995",
    "end": "08:56:21,995",
    "start_sec": 32180.995,
    "end_sec": 32181.995,
    "zh": "傻时间",
    "vi": "Trong khoảnh khắc đó."
  },
  {
    "idx": 18463,
    "start": "08:56:21,995",
    "end": "08:56:24,015",
    "start_sec": 32181.995,
    "end_sec": 32184.015,
    "zh": "七律的叫喊再次传来",
    "vi": "Tiếng hét của Thất Luật lại vang lên."
  },
  {
    "idx": 18464,
    "start": "08:56:24,015",
    "end": "08:56:26,035",
    "start_sec": 32184.015,
    "end_sec": 32186.035,
    "zh": "橙子皮的耳朵血流不止",
    "vi": "Tai của Trần Tử Bì chảy máu không ngừng."
  },
  {
    "idx": 18465,
    "start": "08:56:26,035",
    "end": "08:56:28,055",
    "start_sec": 32186.035,
    "end_sec": 32188.055,
    "zh": "他生什么",
    "vi": "Chuyện gì thế này."
  },
  {
    "idx": 18466,
    "start": "08:56:28,055",
    "end": "08:56:29,495",
    "start_sec": 32188.055,
    "end_sec": 32189.495,
    "zh": "我的耳朵",
    "vi": "Tai của tôi."
  },
  {
    "idx": 18467,
    "start": "08:56:29,495",
    "end": "08:56:32,455",
    "start_sec": 32189.495,
    "end_sec": 32192.455,
    "zh": "林一元",
    "vi": "Lâm Nhất Nguyên."
  },
  {
    "idx": 18468,
    "start": "08:56:32,455",
    "end": "08:56:33,355",
    "start_sec": 32192.455,
    "end_sec": 32193.355,
    "zh": "这不得去",
    "vi": "Không ổn rồi."
  },
  {
    "idx": 18469,
    "start": "08:56:33,355",
    "end": "08:56:34,395",
    "start_sec": 32193.355,
    "end_sec": 32194.395,
    "zh": "这里的鬼运",
    "vi": "Quỷ vực ở đây."
  },
  {
    "idx": 18470,
    "start": "08:56:34,395",
    "end": "08:56:35,475",
    "start_sec": 32194.395,
    "end_sec": 32195.475,
    "zh": "我们招人不止",
    "vi": "Chúng ta không khống chế nổi đâu."
  },
  {
    "idx": 18471,
    "start": "08:56:35,475",
    "end": "08:56:37,255",
    "start_sec": 32195.475,
    "end_sec": 32197.255,
    "zh": "用你的闪光鬼",
    "vi": "Hãy dùng Quỷ Chớp Sáng của cậu."
  },
  {
    "idx": 18472,
    "start": "08:56:37,255",
    "end": "08:56:38,195",
    "start_sec": 32197.255,
    "end_sec": 32198.195,
    "zh": "带我走",
    "vi": "Đưa tôi đi đi."
  },
  {
    "idx": 18473,
    "start": "08:56:38,195",
    "end": "08:56:39,535",
    "start_sec": 32198.195,
    "end_sec": 32199.535,
    "zh": "死了",
    "vi": "Chết rồi."
  },
  {
    "idx": 18474,
    "start": "08:56:39,535",
    "end": "08:56:43,035",
    "start_sec": 32199.535,
    "end_sec": 32203.035,
    "zh": "全死了",
    "vi": "Chết hết rồi."
  },
  {
    "idx": 18475,
    "start": "08:56:43,035",
    "end": "08:56:44,255",
    "start_sec": 32203.035,
    "end_sec": 32204.255,
    "zh": "这一次",
    "vi": "Lần này."
  },
  {
    "idx": 18476,
    "start": "08:56:44,255",
    "end": "08:56:45,455",
    "start_sec": 32204.255,
    "end_sec": 32205.455,
    "zh": "七律的惨叫",
    "vi": "Tiếng hét thảm thiết của Thất Luật."
  },
  {
    "idx": 18477,
    "start": "08:56:45,455",
    "end": "08:56:46,975",
    "start_sec": 32205.455,
    "end_sec": 32206.975,
    "zh": "围挡在整个教室内",
    "vi": "Vang vọng khắp phòng học."
  },
  {
    "idx": 18478,
    "start": "08:56:46,975",
    "end": "08:56:48,255",
    "start_sec": 32206.975,
    "end_sec": 32208.255,
    "zh": "谁也没能考虑",
    "vi": "Không ai có thể tránh được."
  },
  {
    "idx": 18479,
    "start": "08:56:48,255",
    "end": "08:56:50,395",
    "start_sec": 32208.255,
    "end_sec": 32210.395,
    "zh": "橙子皮意识逐渐模糊",
    "vi": "Ý thức của Trần Tử Bì dần mơ hồ."
  },
  {
    "idx": 18480,
    "start": "08:56:50,395",
    "end": "08:56:52,555",
    "start_sec": 32210.395,
    "end_sec": 32212.555,
    "zh": "看来只能重开了",
    "vi": "Xem ra chỉ có thể làm lại từ đầu thôi."
  },
  {
    "idx": 18481,
    "start": "08:56:52,555",
    "end": "08:56:54,795",
    "start_sec": 32212.555,
    "end_sec": 32214.795,
    "zh": "消息在脑海里发出",
    "vi": "Tin nhắn vang lên trong đầu"
  },
  {
    "idx": 18482,
    "start": "08:56:54,795",
    "end": "08:56:57,155",
    "start_sec": 32214.795,
    "end_sec": 32217.155,
    "zh": "但橙子皮的身体并未发生感觉",
    "vi": "Nhưng cơ thể Trần Tử Bì không cảm nhận được gì"
  },
  {
    "idx": 18483,
    "start": "08:56:57,155",
    "end": "08:56:59,275",
    "start_sec": 32217.155,
    "end_sec": 32219.275,
    "zh": "突然胸口的小顶飞出",
    "vi": "Bỗng một cái đỉnh nhỏ trên ngực bay ra"
  },
  {
    "idx": 18484,
    "start": "08:56:59,275",
    "end": "08:57:01,095",
    "start_sec": 32219.275,
    "end_sec": 32221.095,
    "zh": "上面出现一个月字",
    "vi": "Trên đó xuất hiện một chữ \"Nguyệt\""
  },
  {
    "idx": 18485,
    "start": "08:57:01,095",
    "end": "08:57:02,635",
    "start_sec": 32221.095,
    "end_sec": 32222.635,
    "zh": "月",
    "vi": "Nguyệt"
  },
  {
    "idx": 18486,
    "start": "08:57:02,635",
    "end": "08:57:03,555",
    "start_sec": 32222.635,
    "end_sec": 32223.555,
    "zh": "这月",
    "vi": "Chữ Nguyệt này"
  },
  {
    "idx": 18487,
    "start": "08:57:03,555",
    "end": "08:57:04,435",
    "start_sec": 32223.555,
    "end_sec": 32224.435,
    "zh": "是",
    "vi": "Là"
  },
  {
    "idx": 18488,
    "start": "08:57:04,435",
    "end": "08:57:06,195",
    "start_sec": 32224.435,
    "end_sec": 32226.195,
    "zh": "是它来了吗",
    "vi": "Là nó đã đến sao"
  },
  {
    "idx": 18489,
    "start": "08:57:06,195",
    "end": "08:57:08,155",
    "start_sec": 32226.195,
    "end_sec": 32228.155,
    "zh": "鬼面窗尘封的记忆开始恢复",
    "vi": "Ký ức bụi bặm của Quỷ Diện bắt đầu hồi phục"
  },
  {
    "idx": 18490,
    "start": "08:57:08,155",
    "end": "08:57:09,475",
    "start_sec": 32228.155,
    "end_sec": 32229.475,
    "zh": "它还在震惊中",
    "vi": "Nó vẫn còn đang sốc"
  },
  {
    "idx": 18491,
    "start": "08:57:09,475",
    "end": "08:57:10,375",
    "start_sec": 32229.475,
    "end_sec": 32230.375,
    "zh": "顷刻间",
    "vi": "Trong khoảnh khắc"
  },
  {
    "idx": 18492,
    "start": "08:57:10,375",
    "end": "08:57:11,715",
    "start_sec": 32230.375,
    "end_sec": 32231.715,
    "zh": "空间开始破碎",
    "vi": "Không gian bắt đầu vỡ vụn"
  },
  {
    "idx": 18493,
    "start": "08:57:11,715",
    "end": "08:57:13,415",
    "start_sec": 32231.715,
    "end_sec": 32233.415,
    "zh": "重组",
    "vi": "Tái tổ hợp"
  }
]
    "idx": 15068,
    "start": "07:00:43,940",
    "end": "07:00:45,320",
    "start_sec": 25243.94,
    "end_sec": 25245.32,
    "zh": "出去代表的是官方,",
    "vi": "Khi ra ngoài bạn sẽ đại diện cho chính quyền."
  },
  {
    "idx": 15069,
    "start": "07:00:45,720",
    "end": "07:00:47,660",
    "start_sec": 25245.72,
    "end_sec": 25247.66,
    "zh": "与零散的预规者团体交涉,",
    "vi": "Dù là giao thiệp với các nhóm người dự quy tự do."
  },
  {
    "idx": 15070,
    "start": "07:00:47,860",
    "end": "07:00:49,940",
    "start_sec": 25247.86,
    "end_sec": 25249.94,
    "zh": "还是和其他城市的预规者接触,",
    "vi": "Hay tiếp xúc với người dự quy ở các thành phố khác."
  },
  {
    "idx": 15071,
    "start": "07:00:50,260",
    "end": "07:00:53,360",
    "start_sec": 25250.26,
    "end_sec": 25253.36,
    "zh": "他们都要掂量掂量我们预规者总部的分量。",
    "vi": "Họ đều phải kiêng dè thế lực của tổng bộ người dự quy chúng tôi."
  },
  {
    "idx": 15072,
    "start": "07:00:53,860",
    "end": "07:00:54,220",
    "start_sec": 25253.86,
    "end_sec": 25254.22,
    "zh": "呵呵,",
    "vi": "Ha ha."
  },
  {
    "idx": 15073,
    "start": "07:00:54,620",
    "end": "07:00:55,480",
    "start_sec": 25254.62,
    "end_sec": 25255.48,
    "zh": "大力化的不错,",
    "vi": "Bánh vẽ này vẽ khéo đấy."
  },
  {
    "idx": 15074,
    "start": "07:00:55,660",
    "end": "07:00:56,320",
    "start_sec": 25255.66,
    "end_sec": 25256.32,
    "zh": "我来了,",
    "vi": "Tôi đã đến đây."
  },
  {
    "idx": 15075,
    "start": "07:00:56,600",
    "end": "07:00:57,800",
    "start_sec": 25256.6,
    "end_sec": 25257.8,
    "zh": "说明我有兴趣加入你们,",
    "vi": "Nghĩa là tôi có hứng thú gia nhập với các anh."
  },
  {
    "idx": 15076,
    "start": "07:00:57,800",
    "end": "07:00:59,640",
    "start_sec": 25257.8,
    "end_sec": 25259.64,
    "zh": "但如果是危险度过高的事",
    "vi": "Nhưng nếu là việc có độ nguy hiểm quá cao."
  },
  {
    "idx": 15077,
    "start": "07:00:59,640",
    "end": "07:01:02,540",
    "start_sec": 25259.64,
    "end_sec": 25262.54,
    "zh": "或者我觉得某件事的价值与风险不对等",
    "vi": "Hoặc tôi cảm thấy giá trị và rủi ro của việc đó không tương xứng."
  },
  {
    "idx": 15078,
    "start": "07:01:02,540",
    "end": "07:01:03,640",
    "start_sec": 25262.54,
    "end_sec": 25263.64,
    "zh": "恕我拒绝你们",
    "vi": "Xin lỗi vì tôi sẽ từ chối các anh."
  },
  {
    "idx": 15079,
    "start": "07:01:03,640",
    "end": "07:01:05,200",
    "start_sec": 25263.64,
    "end_sec": 25265.2,
    "zh": "我有自己的判断",
    "vi": "Tôi có phán đoán của riêng mình."
  },
  {
    "idx": 15080,
    "start": "07:01:05,200",
    "end": "07:01:06,700",
    "start_sec": 25265.2,
    "end_sec": 25266.7,
    "zh": "我不会受你们随意指使",
    "vi": "Tôi sẽ không để các anh tùy ý sai khiến."
  },
  {
    "idx": 15081,
    "start": "07:01:06,700",
    "end": "07:01:07,580",
    "start_sec": 25266.7,
    "end_sec": 25267.58,
    "zh": "可以",
    "vi": "Được chứ."
  },
  {
    "idx": 15082,
    "start": "07:01:07,580",
    "end": "07:01:09,020",
    "start_sec": 25267.58,
    "end_sec": 25269.02,
    "zh": "这次点是对的",
    "vi": "Điều kiện này rất hợp lý."
  },
  {
    "idx": 15083,
    "start": "07:01:09,020",
    "end": "07:01:09,680",
    "start_sec": 25269.02,
    "end_sec": 25269.68,
    "zh": "那么",
    "vi": "Vậy thì."
  },
  {
    "idx": 15084,
    "start": "07:01:09,680",
    "end": "07:01:11,300",
    "start_sec": 25269.68,
    "end_sec": 25271.3,
    "zh": "欢迎你加入我们",
    "vi": "Chào mừng bạn gia nhập với chúng tôi."
  },
  {
    "idx": 15085,
    "start": "07:01:11,300",
    "end": "07:01:12,900",
    "start_sec": 25271.3,
    "end_sec": 25272.9,
    "zh": "012号玉会者",
    "vi": "Người dự quy số 012."
  },
  {
    "idx": 15086,
    "start": "07:01:12,900",
    "end": "07:01:15,020",
    "start_sec": 25272.9,
    "end_sec": 25275.02,
    "zh": "012吗",
    "vi": "Số 012 sao."
  },
  {
    "idx": 15087,
    "start": "07:01:15,020",
    "end": "07:01:15,620",
    "start_sec": 25275.02,
    "end_sec": 25275.62,
    "zh": "大人",
    "vi": "Thưa sếp."
  },
  {
    "idx": 15088,
    "start": "07:01:15,620",
    "end": "07:01:17,720",
    "start_sec": 25275.62,
    "end_sec": 25277.72,
    "zh": "这个强度会不会给高了",
    "vi": "Xếp hạng này có cao quá không."
  },
  {
    "idx": 15089,
    "start": "07:01:17,720",
    "end": "07:01:18,480",
    "start_sec": 25277.72,
    "end_sec": 25278.48,
    "zh": "不高",
    "vi": "Không cao đâu."
  },
  {
    "idx": 15090,
    "start": "07:01:18,480",
    "end": "07:01:20,740",
    "start_sec": 25278.48,
    "end_sec": 25280.74,
    "zh": "要不是011是他们的人",
    "vi": "Nếu không phải số 011 là người của họ."
  },
  {
    "idx": 15091,
    "start": "07:01:20,740",
    "end": "07:01:22,200",
    "start_sec": 25280.74,
    "end_sec": 25282.2,
    "zh": "我就直接给011了",
    "vi": "Tôi sẽ đưa trực tiếp cho 011."
  },
  {
    "idx": 15092,
    "start": "07:01:22,200",
    "end": "07:01:22,940",
    "start_sec": 25282.2,
    "end_sec": 25282.94,
    "zh": "好了",
    "vi": "Được rồi."
  },
  {
    "idx": 15093,
    "start": "07:01:22,940",
    "end": "07:01:24,780",
    "start_sec": 25282.94,
    "end_sec": 25284.78,
    "zh": "012的事情说完",
    "vi": "Chuyện của 012 đã nói xong."
  },
  {
    "idx": 15094,
    "start": "07:01:24,780",
    "end": "07:01:27,160",
    "start_sec": 25284.78,
    "end_sec": 25287.16,
    "zh": "就简单说说下个月诡计的事吧",
    "vi": "Giờ nói đơn giản về chuyện Quỷ giới vào tháng sau đi."
  },
  {
    "idx": 15095,
    "start": "07:01:27,160",
    "end": "07:01:28,020",
    "start_sec": 25287.16,
    "end_sec": 25288.02,
    "zh": "可是大人",
    "vi": "Nhưng thưa ngài."
  },
  {
    "idx": 15096,
    "start": "07:01:28,020",
    "end": "07:01:29,640",
    "start_sec": 25288.02,
    "end_sec": 25289.64,
    "zh": "当断不断",
    "vi": "Do dự không quyết."
  },
  {
    "idx": 15097,
    "start": "07:01:29,640",
    "end": "07:01:30,660",
    "start_sec": 25289.64,
    "end_sec": 25290.66,
    "zh": "必守其乱",
    "vi": "Ắt sẽ gặp họa."
  },
  {
    "idx": 15098,
    "start": "07:01:30,660",
    "end": "07:01:32,980",
    "start_sec": 25290.66,
    "end_sec": 25292.98,
    "zh": "鬼界还是需要探索的",
    "vi": "Quỷ giới vẫn cần phải khám phá."
  },
  {
    "idx": 15099,
    "start": "07:01:32,980",
    "end": "07:01:34,640",
    "start_sec": 25292.98,
    "end_sec": 25294.64,
    "zh": "无论是对于那里的诡异",
    "vi": "Dù là đối với sự kỳ dị ở đó."
  },
  {
    "idx": 15100,
    "start": "07:01:34,640",
    "end": "07:01:36,560",
    "start_sec": 25294.64,
    "end_sec": 25296.56,
    "zh": "还是关于以前的预规者",
    "vi": "Hay là về những Ngự Quỷ Giả trước đây."
  },
  {
    "idx": 15101,
    "start": "07:01:36,560",
    "end": "07:01:37,500",
    "start_sec": 25296.56,
    "end_sec": 25297.5,
    "zh": "下一次",
    "vi": "Lần tới."
  },
  {
    "idx": 15102,
    "start": "07:01:37,500",
    "end": "07:01:39,320",
    "start_sec": 25297.5,
    "end_sec": 25299.32,
    "zh": "我会组织全体大会议",
    "vi": "Tôi sẽ tổ chức một cuộc họp toàn thể."
  },
  {
    "idx": 15103,
    "start": "07:01:39,320",
    "end": "07:01:40,520",
    "start_sec": 25299.32,
    "end_sec": 25300.52,
    "zh": "至于去不去",
    "vi": "Còn việc có đi hay không."
  },
  {
    "idx": 15104,
    "start": "07:01:40,520",
    "end": "07:01:42,140",
    "start_sec": 25300.52,
    "end_sec": 25302.14,
    "zh": "大家自己判断",
    "vi": "Mọi người tự mình quyết định."
  },
  {
    "idx": 15105,
    "start": "07:01:42,140",
    "end": "07:01:42,460",
    "start_sec": 25302.14,
    "end_sec": 25302.46,
    "zh": "这",
    "vi": "Chuyện này."
  },
  {
    "idx": 15106,
    "start": "07:01:42,460",
    "end": "07:01:44,060",
    "start_sec": 25302.46,
    "end_sec": 25304.06,
    "zh": "我明白了",
    "vi": "Tôi hiểu rồi."
  },
  {
    "idx": 15107,
    "start": "07:01:44,060",
    "end": "07:01:44,520",
    "start_sec": 25304.06,
    "end_sec": 25304.52,
    "zh": "说完",
    "vi": "Nói xong."
  },
  {
    "idx": 15108,
    "start": "07:01:44,520",
    "end": "07:01:46,400",
    "start_sec": 25304.52,
    "end_sec": 25306.4,
    "zh": "屏幕毫无征兆的关闭",
    "vi": "Màn hình tắt phụt không một cảnh báo."
  },
  {
    "idx": 15109,
    "start": "07:01:46,400",
    "end": "07:01:47,140",
    "start_sec": 25306.4,
    "end_sec": 25307.14,
    "zh": "一屋子的人",
    "vi": "Những người trong phòng."
  },
  {
    "idx": 15110,
    "start": "07:01:47,140",
    "end": "07:01:48,680",
    "start_sec": 25307.14,
    "end_sec": 25308.68,
    "zh": "纷纷飞着脸凝结",
    "vi": "Ai nấy đều sa sầm nét mặt."
  },
  {
    "idx": 15111,
    "start": "07:01:48,680",
    "end": "07:01:51,520",
    "start_sec": 25308.68,
    "end_sec": 25311.52,
    "zh": "喂",
    "vi": "Này."
  },
  {
    "idx": 15112,
    "start": "07:01:51,520",
    "end": "07:01:52,300",
    "start_sec": 25311.52,
    "end_sec": 25312.3,
    "zh": "我说",
    "vi": "Tôi hỏi này."
  },
  {
    "idx": 15113,
    "start": "07:01:52,300",
    "end": "07:01:53,700",
    "start_sec": 25312.3,
    "end_sec": 25313.7,
    "zh": "鬼界是个什么玩意",
    "vi": "Quỷ giới là cái quái gì thế."
  },
  {
    "idx": 15114,
    "start": "07:01:53,700",
    "end": "07:01:54,860",
    "start_sec": 25313.7,
    "end_sec": 25314.86,
    "zh": "怎么提起鬼界",
    "vi": "Sao cứ nhắc đến Quỷ giới."
  },
  {
    "idx": 15115,
    "start": "07:01:54,860",
    "end": "07:01:56,400",
    "start_sec": 25314.86,
    "end_sec": 25316.4,
    "zh": "一个个都心事重重的",
    "vi": "Là ai nấy đều nặng trĩu tâm sự vậy."
  },
  {
    "idx": 15116,
    "start": "07:01:56,400",
    "end": "07:01:59,700",
    "start_sec": 25316.4,
    "end_sec": 25319.7,
    "zh": "你自己上032的账号就明白了",
    "vi": "Tự bạn đăng nhập vào tài khoản của 032 là hiểu ngay."
  },
  {
    "idx": 15117,
    "start": "07:01:59,700",
    "end": "07:02:00,300",
    "start_sec": 25319.7,
    "end_sec": 25320.3,
    "zh": "还有",
    "vi": "Với lại."
  },
  {
    "idx": 15118,
    "start": "07:02:00,300",
    "end": "07:02:02,960",
    "start_sec": 25320.3,
    "end_sec": 25322.96,
    "zh": "你重新登陆下你的玉鬼者网站",
    "vi": "Bạn đăng nhập lại vào trang web Ngự Quỷ Giả của mình đi."
  },
  {
    "idx": 15119,
    "start": "07:02:02,960",
    "end": "07:02:04,020",
    "start_sec": 25322.96,
    "end_sec": 25324.02,
    "zh": "你的序列号",
    "vi": "Số thứ tự của bạn."
  },
  {
    "idx": 15120,
    "start": "07:02:04,020",
    "end": "07:02:06,720",
    "start_sec": 25324.02,
    "end_sec": 25326.72,
    "zh": "还有016他们赔偿的公讯点",
    "vi": "Và cả điểm tích lũy bồi thường của nhóm 016 nữa."
  },
  {
    "idx": 15121,
    "start": "07:02:06,720",
    "end": "07:02:08,880",
    "start_sec": 25326.72,
    "end_sec": 25328.88,
    "zh": "以及任务的奖励应该都到了",
    "vi": "Và cả phần thưởng nhiệm vụ chắc cũng tới rồi."
  },
  {
    "idx": 15122,
    "start": "07:02:08,880",
    "end": "07:02:09,600",
    "start_sec": 25328.88,
    "end_sec": 25329.6,
    "zh": "说完",
    "vi": "Nói xong."
  },
  {
    "idx": 15123,
    "start": "07:02:09,600",
    "end": "07:02:11,020",
    "start_sec": 25329.6,
    "end_sec": 25331.02,
    "zh": "冷泉也快不理解",
    "vi": "Lãnh Tuyền cũng không hiểu nổi."
  },
  {
    "idx": 15124,
    "start": "07:02:11,020",
    "end": "07:02:12,360",
    "start_sec": 25331.02,
    "end_sec": 25332.36,
    "zh": "打什么哑咪嘛",
    "vi": "Úp úp mở mở cái gì chứ."
  },
  {
    "idx": 15125,
    "start": "07:02:12,360",
    "end": "07:02:13,260",
    "start_sec": 25332.36,
    "end_sec": 25333.26,
    "zh": "还要我自己看",
    "vi": "Lại còn bắt mình tự xem."
  },
  {
    "idx": 15126,
    "start": "07:02:13,260",
    "end": "07:02:15,800",
    "start_sec": 25333.26,
    "end_sec": 25335.8,
    "zh": "程子提默默离开六层会议室",
    "vi": "Trình Tử Đề lẳng lặng rời khỏi phòng họp tầng sáu."
  },
  {
    "idx": 15127,
    "start": "07:02:15,800",
    "end": "07:02:17,480",
    "start_sec": 25335.8,
    "end_sec": 25337.48,
    "zh": "回到四层玉鬼者住宅去",
    "vi": "Quay về khu nhà ở của Ngự Quỷ Giả ở tầng bốn."
  },
  {
    "idx": 15128,
    "start": "07:02:17,480",
    "end": "07:02:20,460",
    "start_sec": 25337.48,
    "end_sec": 25340.46,
    "zh": "路上碰到026徐海带着徐天志前逛",
    "vi": "Trên đường đi cậu gặp Từ Hải số 026 đang dẫn Từ Thiên Chí đi dạo."
  },
  {
    "idx": 15129,
    "start": "07:02:20,460",
    "end": "07:02:21,700",
    "start_sec": 25340.46,
    "end_sec": 25341.7,
    "zh": "一见到程子提",
    "vi": "Vừa nhìn thấy Trình Tử Đề."
  },
  {
    "idx": 15130,
    "start": "07:02:21,700",
    "end": "07:02:23,160",
    "start_sec": 25341.7,
    "end_sec": 25343.16,
    "zh": "徐海神色复杂",
    "vi": "Sắc mặt Từ Hải liền trở nên phức tạp."
  },
  {
    "idx": 15131,
    "start": "07:02:23,160",
    "end": "07:02:24,820",
    "start_sec": 25343.16,
    "end_sec": 25344.82,
    "zh": "看着程子提好一会儿",
    "vi": "Anh ta nhìn Trình Tử Đề một hồi lâu."
  },
  {
    "idx": 15132,
    "start": "07:02:24,820",
    "end": "07:02:26,240",
    "start_sec": 25344.82,
    "end_sec": 25346.24,
    "zh": "拉着徐天志就往回走",
    "vi": "Rồi kéo Từ Thiên Chí đi ngược trở lại."
  },
  {
    "idx": 15133,
    "start": "07:02:26,240",
    "end": "07:02:27,120",
    "start_sec": 25346.24,
    "end_sec": 25347.12,
    "zh": "干嘛",
    "vi": "Làm gì vậy."
  },
  {
    "idx": 15134,
    "start": "07:02:27,120",
    "end": "07:02:28,160",
    "start_sec": 25347.12,
    "end_sec": 25348.16,
    "zh": "见鬼了吗",
    "vi": "Gặp quỷ rồi sao."
  },
  {
    "idx": 15135,
    "start": "07:02:28,160",
    "end": "07:02:29,740",
    "start_sec": 25348.16,
    "end_sec": 25349.74,
    "zh": "我还打算打个招呼呢",
    "vi": "Mình còn đang định chào hỏi một tiếng."
  },
  {
    "idx": 15136,
    "start": "07:02:29,740",
    "end": "07:02:30,640",
    "start_sec": 25349.74,
    "end_sec": 25350.64,
    "zh": "跑这么快",
    "vi": "Mà chạy nhanh thế."
  },
  {
    "idx": 15137,
    "start": "07:02:30,640",

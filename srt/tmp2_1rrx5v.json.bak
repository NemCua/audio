  {
    "idx": 922,
    "start": "00:20:56,360",
    "end": "00:20:59,860",
    "start_sec": 1256.36,
    "end_sec": 1259.86,
    "zh": "我将一块块合成的能量模块和增幅线圈焊接到钢板上",
    "vi": "Tôi hàn từng mô đun năng lượng tổng hợp và cuộn dây khuếch đại lên tấm thép."
  },
  {
    "idx": 923,
    "start": "00:20:59,860",
    "end": "00:21:01,180",
    "start_sec": 1259.86,
    "end_sec": 1261.18,
    "zh": "柳如烟在旁边看着",
    "vi": "Liễu Như Yên đứng bên cạnh quan sát."
  },
  {
    "idx": 924,
    "start": "00:21:01,180",
    "end": "00:21:02,980",
    "start_sec": 1261.18,
    "end_sec": 1262.98,
    "zh": "脸上的恐惧早已化为麻木",
    "vi": "Nỗi sợ hãi trên mặt cô ấy đã sớm chuyển thành sự vô cảm."
  },
  {
    "idx": 925,
    "start": "00:21:02,980",
    "end": "00:21:03,900",
    "start_sec": 1262.98,
    "end_sec": 1263.9,
    "zh": "15分钟后",
    "vi": "Mười lăm phút sau."
  },
  {
    "idx": 926,
    "start": "00:21:03,900",
    "end": "00:21:04,940",
    "start_sec": 1263.9,
    "end_sec": 1264.94,
    "zh": "一个直径两米",
    "vi": "Một bệ kim loại đường kính hai mét."
  },
  {
    "idx": 927,
    "start": "00:21:04,940",
    "end": "00:21:06,680",
    "start_sec": 1264.94,
    "end_sec": 1266.68,
    "zh": "布满线路和晶体的金属平台处",
    "vi": "Đầy dây điện và tinh thể xuất hiện."
  },
  {
    "idx": 928,
    "start": "00:21:06,680",
    "end": "00:21:08,320",
    "start_sec": 1266.68,
    "end_sec": 1268.32,
    "zh": "移动式电子耐冲炮台",
    "vi": "Pháo xung điện di động."
  },
  {
    "idx": 929,
    "start": "00:21:08,320",
    "end": "00:21:09,020",
    "start_sec": 1268.32,
    "end_sec": 1269.02,
    "zh": "未完成",
    "vi": "Vẫn chưa hoàn thành."
  },
  {
    "idx": 930,
    "start": "00:21:09,020",
    "end": "00:21:10,120",
    "start_sec": 1269.02,
    "end_sec": 1270.12,
    "zh": "还差一个核心",
    "vi": "Vẫn còn thiếu một lõi năng lượng."
  },
  {
    "idx": 931,
    "start": "00:21:10,120",
    "end": "00:21:11,800",
    "start_sec": 1270.12,
    "end_sec": 1271.8,
    "zh": "狗圣指着平台中央的凹槽",
    "vi": "Gou Sheng chỉ vào rãnh trên giữa bệ"
  },
  {
    "idx": 932,
    "start": "00:21:11,800",
    "end": "00:21:14,100",
    "start_sec": 1271.8,
    "end_sec": 1274.1,
    "zh": "我拿出了从周扬身上搜到的对象机",
    "vi": "Tôi lấy ra thiết bị định vị tìm được trên người Zhou Yang"
  },
  {
    "idx": 933,
    "start": "00:21:14,100",
    "end": "00:21:15,900",
    "start_sec": 1274.1,
    "end_sec": 1275.9,
    "zh": "会想击下我所有的能量经合",
    "vi": "Nó sẽ bắn hạ toàn bộ năng lượng của tôi"
  },
  {
    "idx": 934,
    "start": "00:21:15,900",
    "end": "00:21:17,360",
    "start_sec": 1275.9,
    "end_sec": 1277.36,
    "zh": "等于高频信号增幅核心",
    "vi": "Tương đương với lõi khuếch đại tín hiệu tần số cao"
  },
  {
    "idx": 935,
    "start": "00:21:17,360",
    "end": "00:21:18,720",
    "start_sec": 1277.36,
    "end_sec": 1278.72,
    "zh": "我将核心装入凹槽",
    "vi": "Tôi lắp lõi vào rãnh"
  },
  {
    "idx": 936,
    "start": "00:21:18,720",
    "end": "00:21:20,200",
    "start_sec": 1278.72,
    "end_sec": 1280.2,
    "zh": "整个平台发出一阵异鸣",
    "vi": "Toàn bộ bệ phát ra một tiếng kêu lạ"
  },
  {
    "idx": 937,
    "start": "00:21:20,200",
    "end": "00:21:22,220",
    "start_sec": 1280.2,
    "end_sec": 1282.22,
    "zh": "所有线路同时亮起蓝光",
    "vi": "Tất cả các đường mạch đồng loạt sáng lên ánh sáng xanh"
  },
  {
    "idx": 938,
    "start": "00:21:22,220",
    "end": "00:21:24,420",
    "start_sec": 1282.22,
    "end_sec": 1284.42,
    "zh": "你都是电子卖充炮台充能中",
    "vi": "Bạn đang được nạp năng lượng cho bệ phóng điện tử"
  },
  {
    "idx": 939,
    "start": "00:21:24,420",
    "end": "00:21:25,420",
    "start_sec": 1284.42,
    "end_sec": 1285.42,
    "zh": "百分之一",
    "vi": "Một phần trăm"
  },
  {
    "idx": 940,
    "start": "00:21:25,420",
    "end": "00:21:25,980",
    "start_sec": 1285.42,
    "end_sec": 1285.98,
    "zh": "成了",
    "vi": "Xong rồi"
  },
  {
    "idx": 941,
    "start": "00:21:25,980",
    "end": "00:21:27,000",
    "start_sec": 1285.98,
    "end_sec": 1287.0,
    "zh": "狗圣看着炮台",
    "vi": "Gou Sheng nhìn bệ phóng"
  },
  {
    "idx": 942,
    "start": "00:21:27,000",
    "end": "00:21:28,200",
    "start_sec": 1287.0,
    "end_sec": 1288.2,
    "zh": "兴奋的直摇尾巴",
    "vi": "Vẫy đuôi mừng rỡ"
  },
  {
    "idx": 943,
    "start": "00:21:28,200",
    "end": "00:21:29,560",
    "start_sec": 1288.2,
    "end_sec": 1289.56,
    "zh": "这东西能大平",
    "vi": "Thứ này có thể san phẳng"
  },
  {
    "idx": 944,
    "start": "00:21:29,560",
    "end": "00:21:31,060",
    "start_sec": 1289.56,
    "end_sec": 1291.06,
    "zh": "五百米内所有地方",
    "vi": "Mọi thứ trong phạm vi năm trăm mét"
  },
  {
    "idx": 945,
    "start": "00:21:31,060",
    "end": "00:21:32,960",
    "start_sec": 1291.06,
    "end_sec": 1292.96,
    "zh": "把电子设备全占废",
    "vi": "Và làm hỏng tất cả các thiết bị điện tử"
  },
  {
    "idx": 946,
    "start": "00:21:32,960",
    "end": "00:21:34,000",
    "start_sec": 1292.96,
    "end_sec": 1294.0,
    "zh": "还能伤到人",
    "vi": "Nó cũng có thể làm bị thương người"
  },
  {
    "idx": 947,
    "start": "00:21:34,000",
    "end": "00:21:35,040",
    "start_sec": 1294.0,
    "end_sec": 1295.04,
    "zh": "缺点是充能万",
    "vi": "Nhược điểm là nạp năng lượng mất nhiều thời gian"
  },
  {
    "idx": 948,
    "start": "00:21:35,040",
    "end": "00:21:35,940",
    "start_sec": 1295.04,
    "end_sec": 1295.94,
    "zh": "只能来一放",
    "vi": "Chỉ có thể bắn một lần"
  },
  {
    "idx": 949,
    "start": "00:21:35,940",
    "end": "00:21:36,580",
    "start_sec": 1295.94,
    "end_sec": 1296.58,
    "zh": "话音刚落",
    "vi": "Vừa dứt lời"
  },
  {
    "idx": 950,
    "start": "00:21:36,580",
    "end": "00:21:38,300",
    "start_sec": 1296.58,
    "end_sec": 1298.3,
    "zh": "仓库外传来汽车的引擎声",
    "vi": "Tiếng động cơ ô tô vang lên từ bên ngoài nhà kho"
  },
  {
    "idx": 951,
    "start": "00:21:38,300",
    "end": "00:21:39,000",
    "start_sec": 1298.3,
    "end_sec": 1299.0,
    "zh": "他们来了",
    "vi": "Họ đến rồi"
  },
  {
    "idx": 952,
    "start": "00:21:39,000",
    "end": "00:21:40,320",
    "start_sec": 1299.0,
    "end_sec": 1300.32,
    "zh": "比我们响得还快",
    "vi": "Nhanh hơn chúng ta nghĩ"
  },
  {
    "idx": 953,
    "start": "00:21:40,320",
    "end": "00:21:41,640",
    "start_sec": 1300.32,
    "end_sec": 1301.64,
    "zh": "监控比五辆越野车",
    "vi": "Giám sát cho thấy năm chiếc xe địa hình"
  },
  {
    "idx": 954,
    "start": "00:21:41,640",
    "end": "00:21:43,540",
    "start_sec": 1301.64,
    "end_sec": 1303.54,
    "zh": "跳下来三十多个拿枪的男人",
    "vi": "Ba mươi người đàn ông cầm súng nhảy ra"
  },
  {
    "idx": 955,
    "start": "00:21:43,540",
    "end": "00:21:45,740",
    "start_sec": 1303.54,
    "end_sec": 1305.74,
    "zh": "带头的八脸男人又望远镜看了一眼",
    "vi": "Người đàn ông dẫn đầu nhìn qua ống nhòm lần nữa"
  },
  {
    "idx": 956,
    "start": "00:21:45,740",
    "end": "00:21:46,960",
    "start_sec": 1305.74,
    "end_sec": 1306.96,
    "zh": "对着对讲机说了几句",
    "vi": "Nói vài câu vào bộ đàm"
  },
  {
    "idx": 957,
    "start": "00:21:46,960",
    "end": "00:21:47,920",
    "start_sec": 1306.96,
    "end_sec": 1307.92,
    "zh": "他们监听了通讯",
    "vi": "Họ đã nghe lén liên lạc"
  },
  {
    "idx": 958,
    "start": "00:21:47,920",
    "end": "00:21:48,820",
    "start_sec": 1307.92,
    "end_sec": 1308.82,
    "zh": "不是来救人",
    "vi": "Không phải đến để cứu người"
  },
  {
    "idx": 959,
    "start": "00:21:48,820",
    "end": "00:21:49,640",
    "start_sec": 1308.82,
    "end_sec": 1309.64,
    "zh": "是来收网的",
    "vi": "Mà là đến để thu lưới"
  },
  {
    "idx": 960,
    "start": "00:21:49,640",
    "end": "00:21:50,860",
    "start_sec": 1309.64,
    "end_sec": 1310.86,
    "zh": "准备战仗",
    "vi": "Chuẩn bị chiến đấu"
  },
  {
    "idx": 961,
    "start": "00:21:50,860",
    "end": "00:21:53,560",
    "start_sec": 1310.86,
    "end_sec": 1313.56,
    "zh": "我抽起一面电磁片导弧盾和高能炼具战斧",
    "vi": "Tôi cầm lấy một tấm khiên điện từ và chiếc rìu chiến năng lượng cao."
  },
  {
    "idx": 962,
    "start": "00:21:53,560",
    "end": "00:21:55,400",
    "start_sec": 1313.56,
    "end_sec": 1315.4,
    "zh": "把另外两枚盾牌扔给狗上",
    "vi": "Tôi ném hai tấm khiên còn lại cho Cẩu Thặng."
  },
  {
    "idx": 963,
    "start": "00:21:55,400",
    "end": "00:21:58,260",
    "start_sec": 1315.4,
    "end_sec": 1318.26,
    "zh": "仓库大门被一辆越野车撞烂",
    "vi": "Cửa kho hàng bị một chiếc xe địa hình đâm nát."
  },
  {
    "idx": 964,
    "start": "00:21:58,260",
    "end": "00:21:59,960",
    "start_sec": 1318.26,
    "end_sec": 1319.96,
    "zh": "八脸男人带人冲了进来",
    "vi": "Gã đàn ông mặt sẹo dẫn người xông vào."
  },
  {
    "idx": 965,
    "start": "00:21:59,960",
    "end": "00:22:00,540",
    "start_sec": 1319.96,
    "end_sec": 1320.54,
    "zh": "周扬呢",
    "vi": "Chu Dương đâu."
  },
  {
    "idx": 966,
    "start": "00:22:00,540",
    "end": "00:22:01,600",
    "start_sec": 1320.54,
    "end_sec": 1321.6,
    "zh": "你们是什么人",
    "vi": "Các người là ai."
  },
  {
    "idx": 967,
    "start": "00:22:01,600",
    "end": "00:22:03,660",
    "start_sec": 1321.6,
    "end_sec": 1323.66,
    "zh": "他看见空荡荡的仓库和柳如烟",
    "vi": "Hắn nhìn thấy kho hàng trống rỗng cùng Liễu Như Yên."
  },
  {
    "idx": 968,
    "start": "00:22:03,660",
    "end": "00:22:04,720",
    "start_sec": 1323.66,
    "end_sec": 1324.72,
    "zh": "马上知道不对劲",
    "vi": "Ngay lập tức biết có điều chẳng lành."
  },
  {
    "idx": 969,
    "start": "00:22:04,720",
    "end": "00:22:05,560",
    "start_sec": 1324.72,
    "end_sec": 1325.56,
    "zh": "回答他的",
    "vi": "Thứ trả lời hắn."
  },
  {
    "idx": 970,
    "start": "00:22:05,560",
    "end": "00:22:07,300",
    "start_sec": 1325.56,
    "end_sec": 1327.3,
    "zh": "是我启动炼剧战斧的翁名",
    "vi": "Chính là tiếng rìu chiến năng lượng của tôi khởi động."
  },
  {
    "idx": 971,
    "start": "00:22:07,300",
    "end": "00:22:09,980",
    "start_sec": 1327.3,
    "end_sec": 1329.98,
    "zh": "我提着战斧",
    "vi": "Tôi cầm rìu chiến."
  },
  {
    "idx": 972,
    "start": "00:22:09,980",
    "end": "00:22:11,340",
    "start_sec": 1329.98,
    "end_sec": 1331.34,
    "zh": "顶着护盾冲了上去",
    "vi": "Giương khiên lên và xông tới."
  },
  {
    "idx": 973,
    "start": "00:22:11,340",
    "end": "00:22:11,860",
    "start_sec": 1331.34,
    "end_sec": 1331.86,
    "zh": "开火",
    "vi": "Bắn đi."
  },
  {
    "idx": 974,
    "start": "00:22:11,860",
    "end": "00:22:12,780",
    "start_sec": 1331.86,
    "end_sec": 1332.78,
    "zh": "八点男人吼道",
    "vi": "Gã mặt sẹo gào lên."
  },
  {
    "idx": 975,
    "start": "00:22:12,780",
    "end": "00:22:14,080",
    "start_sec": 1332.78,
    "end_sec": 1334.08,
    "zh": "子弹打在能量场上",
    "vi": "Đạn bắn vào trường năng lượng."
  },
  {
    "idx": 976,
    "start": "00:22:14,080",
    "end": "00:22:15,140",
    "start_sec": 1334.08,
    "end_sec": 1335.14,
    "zh": "只见起一片涟漪",
    "vi": "Chỉ thấy gợn sóng lan ra."
  },
  {
    "idx": 977,
    "start": "00:22:15,140",
    "end": "00:22:16,320",
    "start_sec": 1335.14,
    "end_sec": 1336.32,
    "zh": "然后就被弹飞了",
    "vi": "Rồi tất cả đều bị bật văng ra ngoài."
  },
  {
    "idx": 978,
    "start": "00:22:16,320",
    "end": "00:22:17,680",
    "start_sec": 1336.32,
    "end_sec": 1337.68,
    "zh": "那帮人都看傻了",
    "vi": "Đám người đó đều ngẩn người ra."
  },
  {
    "idx": 979,
    "start": "00:22:17,680",
    "end": "00:22:18,360",
    "start_sec": 1337.68,
    "end_sec": 1338.36,
    "zh": "我冲击人群",
    "vi": "Tôi lao vào đám đông."
  },
  {
    "idx": 980,
    "start": "00:22:18,360",
    "end": "00:22:19,960",
    "start_sec": 1338.36,
    "end_sec": 1339.96,
    "zh": "炼剧战斧跨出一道弧线",
    "vi": "Rìu chiến vung lên một đường vòng cung."
  },
  {
    "idx": 981,
    "start": "00:22:19,960",
    "end": "00:22:21,160",
    "start_sec": 1339.96,
    "end_sec": 1341.16,
    "zh": "最前面的倒霉蛋",
    "vi": "Tên xui xẻo đứng đầu."
  },
  {
    "idx": 982,
    "start": "00:22:21,160",
    "end": "00:22:22,740",
    "start_sec": 1341.16,
    "end_sec": 1342.74,
    "zh": "连人带枪背提成两半",
    "vi": "Cả người lẫn súng đều bị chém làm đôi."
  },
  {
    "idx": 983,
    "start": "00:22:22,740",
    "end": "00:22:24,120",
    "start_sec": 1342.74,
    "end_sec": 1344.12,
    "zh": "血和内脏洒了一地",
    "vi": "Máu và nội tạng văng tung tóe khắp nơi."
  },
  {
    "idx": 984,
    "start": "00:22:24,120",
    "end": "00:22:26,260",
    "start_sec": 1344.12,
    "end_sec": 1346.26,
    "zh": "惨叫声让这些亡命兔反应过来",
    "vi": "Tiếng thét thảm thiết khiến đám liều mạng này bừng tỉnh."
  },
  {
    "idx": 985,
    "start": "00:22:26,260",
    "end": "00:22:27,460",
    "start_sec": 1346.26,
    "end_sec": 1347.46,
    "zh": "口叫着向我扑来",
    "vi": "Chúng gào thét lao về phía tôi."
  },
  {
    "idx": 986,
    "start": "00:22:27,460",
    "end": "00:22:28,660",
    "start_sec": 1347.46,
    "end_sec": 1348.66,
    "zh": "狗声也顶着盾",
    "vi": "Cẩu Thặng cũng giương khiên."
  },
  {
    "idx": 987,
    "start": "00:22:28,660",
    "end": "00:22:29,660",
    "start_sec": 1348.66,
    "end_sec": 1349.66,
    "zh": "在我侧翼弯撞",
    "vi": "Hỗ trợ tôi ở bên sườn."
  },
  {
    "idx": 988,
    "start": "00:22:29,660",
    "end": "00:22:30,860",
    "start_sec": 1349.66,
    "end_sec": 1350.86,
    "zh": "用带电的盾牌",
    "vi": "Dùng tấm khiên có điện."
  },
  {
    "idx": 989,
    "start": "00:22:35,560",
    "end": "00:22:36,460",
    "start_sec": 1355.56,
    "end_sec": 1356.46,
    "zh": "他们开始绕后",
    "vi": "Chúng bắt đầu vòng ra sau."
  },
  {
    "idx": 990,
    "start": "00:22:36,460",
    "end": "00:22:37,120",
    "start_sec": 1356.46,
    "end_sec": 1357.12,
    "zh": "打我的背",
    "vi": "Đánh vào lưng tôi."
  },
  {
    "idx": 991,
    "start": "00:22:37,120",
    "end": "00:22:38,880",
    "start_sec": 1357.12,
    "end_sec": 1358.88,
    "zh": "我一虎头推开一个偷袭的",
    "vi": "Tôi dùng đầu hổ đẩy lui một kẻ đánh lén."
  },
  {
    "idx": 992,
    "start": "00:22:38,880",
    "end": "00:22:40,180",
    "start_sec": 1358.88,
    "end_sec": 1360.18,
    "zh": "后背也挨了一棍子",
    "vi": "Nhưng lưng cũng bị trúng một gậy."
  },
  {
    "idx": 993,
    "start": "00:22:40,180",
    "end": "00:22:40,560",
    "start_sec": 1360.18,
    "end_sec": 1360.56,
    "zh": "堵人",
    "vi": "Chặn hắn lại."
  },
  {
    "idx": 994,
    "start": "00:22:40,560",
    "end": "00:22:41,160",
    "start_sec": 1360.56,
    "end_sec": 1361.16,
    "zh": "小心",
    "vi": "Cẩn thận."
  },
  {
    "idx": 995,
    "start": "00:22:41,160",
    "end": "00:22:42,500",
    "start_sec": 1361.16,
    "end_sec": 1362.5,
    "zh": "把脸男人看准机会",
    "vi": "Gã tám mặt tìm được cơ hội."
  },
  {
    "idx": 996,
    "start": "00:22:42,500",
    "end": "00:22:43,460",
    "start_sec": 1362.5,
    "end_sec": 1363.46,
    "zh": "掏出一颗手雷",
    "vi": "Lấy ra một quả lựu đạn."
  },
  {
    "idx": 997,
    "start": "00:22:43,460",
    "end": "00:22:44,400",
    "start_sec": 1363.46,
    "end_sec": 1364.4,
    "zh": "他拉开引器",
    "vi": "Hắn rút chốt an toàn."
  },
  {
    "idx": 998,
    "start": "00:22:44,400",
    "end": "00:22:45,740",
    "start_sec": 1364.4,
    "end_sec": 1365.74,
    "zh": "手雷砸向我脚下",
    "vi": "Ném quả lựu đạn xuống chân tôi."
  },
  {
    "idx": 999,
    "start": "00:22:45,740",
    "end": "00:22:46,760",
    "start_sec": 1365.74,
    "end_sec": 1366.76,
    "zh": "我心里一咯噔",
    "vi": "Tim tôi thắt lại."
  },
  {
    "idx": 1000,
    "start": "00:22:46,760",
    "end": "00:22:47,740",
    "start_sec": 1366.76,
    "end_sec": 1367.74,
    "zh": "躲不开了",
    "vi": "Không né kịp rồi."
  },
  {
    "idx": 1001,
    "start": "00:22:47,740",
    "end": "00:22:48,860",
    "start_sec": 1367.74,
    "end_sec": 1368.86,
    "zh": "现在手雷落地的当口",
    "vi": "Ngay khoảnh khắc lựu đạn rơi xuống."
  },
  {
    "idx": 1002,
    "start": "00:22:48,860",
    "end": "00:22:50,100",
    "start_sec": 1368.86,
    "end_sec": 1370.1,
    "zh": "一道黑影扑了过来",
    "vi": "Một bóng đen lao tới."
  },
  {
    "idx": 1003,
    "start": "00:22:50,100",
    "end": "00:22:50,860",
    "start_sec": 1370.1,
    "end_sec": 1370.86,
    "zh": "狗圣撞开我",
    "vi": "Cẩu Thặng đẩy tôi ra."
  },
  {
    "idx": 1004,
    "start": "00:22:50,860",
    "end": "00:22:51,320",
    "start_sec": 1370.86,
    "end_sec": 1371.32,
    "zh": "他自己",
    "vi": "Còn bản thân cậu ấy."
  },
  {
    "idx": 1005,
    "start": "00:22:51,320",
    "end": "00:22:52,980",
    "start_sec": 1371.32,
    "end_sec": 1372.98,
    "zh": "却被那颗手雷砸得正着",
    "vi": "Lại bị quả lựu đạn rơi trúng."
  },
  {
    "idx": 1006,
    "start": "00:22:52,980",
    "end": "00:22:53,560",
    "start_sec": 1372.98,
    "end_sec": 1373.56,
    "zh": "表现",
    "vi": "Cẩu Thặng."
  },
  {
    "idx": 1007,
    "start": "00:22:53,560",
    "end": "00:22:54,660",
    "start_sec": 1373.56,
    "end_sec": 1374.66,
    "zh": "我吼了出来",
    "vi": "Tôi gào lên."
  },
  {
    "idx": 1008,
    "start": "00:22:54,660",
    "end": "00:22:57,180",
    "start_sec": 1374.66,
    "end_sec": 1377.18,
    "zh": "火光和气浪",
    "vi": "Ánh lửa và luồng khí nóng."
  },
  {
    "idx": 1009,
    "start": "00:22:57,180",
    "end": "00:22:58,080",
    "start_sec": 1377.18,
    "end_sec": 1378.08,
    "zh": "把狗圣掀飞",
    "vi": "Thổi bay Cẩu Thặng."
  },
  {
    "idx": 1010,
    "start": "00:22:58,080",
    "end": "00:22:59,860",
    "start_sec": 1378.08,
    "end_sec": 1379.86,
    "zh": "重重撞在远处的货架上",
    "vi": "Đập mạnh vào kệ hàng phía xa."
  },
  {
    "idx": 1011,
    "start": "00:22:59,860",
    "end": "00:23:01,820",
    "start_sec": 1379.86,
    "end_sec": 1381.82,
    "zh": "他哀鸣一声抽出几下就不动了",
    "vi": "Cậu ấy rên rỉ một tiếng, co giật vài cái rồi bất động."
  },
  {
    "idx": 1012,
    "start": "00:23:05,560",
    "end": "00:23:06,700",
    "start_sec": 1385.56,
    "end_sec": 1386.7,
    "zh": "两手握紧面具战斧,",
    "vi": "Tôi dùng hai tay siết chặt cây rìu chiến."
  },
  {
    "idx": 1013,
    "start": "00:23:06,900",
    "end": "00:23:07,500",
    "start_sec": 1386.9,
    "end_sec": 1387.5,
    "zh": "发了疯一样,",
    "vi": "Như một kẻ điên."
  },
  {
    "idx": 1014,
    "start": "00:23:07,580",
    "end": "00:23:08,500",
    "start_sec": 1387.58,
    "end_sec": 1388.5,
    "zh": "睁向那个八脸男人,",
    "vi": "Lao thẳng về phía gã tám mặt đó."
  },
  {
    "idx": 1015,
    "start": "00:23:08,740",
    "end": "00:23:09,100",
    "start_sec": 1388.74,
    "end_sec": 1389.1,
    "zh": "红色,",
    "vi": "Mắt tôi đỏ ngầu."
  },
  {
    "idx": 1016,
    "start": "00:23:09,300",
    "end": "00:23:10,380",
    "start_sec": 1389.3,
    "end_sec": 1390.38,
    "zh": "八脸男人脸都变了,",
    "vi": "Sắc mặt gã tám mặt biến đổi."
  },
  {
    "idx": 1017,
    "start": "00:23:10,600",
    "end": "00:23:11,800",
    "start_sec": 1390.6,
    "end_sec": 1391.8,
    "zh": "他身边的小弟想拦我,",
    "vi": "Đàn em bên cạnh hắn muốn cản tôi."
  },
  {
    "idx": 1018,
    "start": "00:23:12,060",
    "end": "00:23:13,660",
    "start_sec": 1392.06,
    "end_sec": 1393.66,
    "zh": "全被我一斧头剔成两半,",
    "vi": "Đều bị tôi chém làm đôi chỉ bằng một rìu."
  },
  {
    "idx": 1019,
    "start": "00:23:14,100",
    "end": "00:23:14,900",
    "start_sec": 1394.1,
    "end_sec": 1394.9,
    "zh": "血溅了我一脸,",
    "vi": "Máu bắn đầy mặt tôi."
  },
  {
    "idx": 1020,
    "start": "00:23:15,180",
    "end": "00:23:15,940",
    "start_sec": 1395.18,
    "end_sec": 1395.94,
    "zh": "我只想着杀了他,",
    "vi": "Tôi chỉ muốn giết chết hắn."
  },
  {
    "idx": 1021,
    "start": "00:23:16,260",
    "end": "00:23:17,040",
    "start_sec": 1396.26,
    "end_sec": 1397.04,
    "zh": "八脸男人怕了,",
    "vi": "Gã đàn ông tám mặt sợ hãi."
  },
  {
    "idx": 1022,
    "start": "00:23:17,220",
    "end": "00:23:17,780",
    "start_sec": 1397.22,
    "end_sec": 1397.78,
    "zh": "转身就跑,",
    "vi": "Hắn quay người bỏ chạy."
  },
  {
    "idx": 1023,
    "start": "00:23:17,960",
    "end": "00:23:19,560",
    "start_sec": 1397.96,
    "end_sec": 1399.56,
    "zh": "我把面具战斧猛地扔了出去,",
    "vi": "Tôi liền ném mạnh chiếc rìu chiến mặt nạ ra."
  },
  {
    "idx": 1024,
    "start": "00:23:19,840",
    "end": "00:23:21,320",
    "start_sec": 1399.84,
    "end_sec": 1401.32,
    "zh": "旋转的战斧在空中划过,",
    "vi": "Chiếc rìu xoay tròn lao đi trong không trung."
  },
  {
    "idx": 1025,
    "start": "00:23:21,580",
    "end": "00:23:22,360",
    "start_sec": 1401.58,
    "end_sec": 1402.36,
    "zh": "正中他的后心,",
    "vi": "Găm thẳng vào giữa lưng hắn."
  },
  {
    "idx": 1026,
    "start": "00:23:22,580",
    "end": "00:23:23,600",
    "start_sec": 1402.58,
    "end_sec": 1403.6,
    "zh": "他低头看了他胸口,",
    "vi": "Hắn cúi đầu nhìn xuống ngực mình."
  },
  {
    "idx": 1027,
    "start": "00:23:23,840",
    "end": "00:23:24,340",
    "start_sec": 1403.84,
    "end_sec": 1404.34,
    "zh": "倒了下去,",
    "vi": "Rồi ngã gục xuống."
  },
  {
    "idx": 1028,
    "start": "00:23:24,620",
    "end": "00:23:25,220",
    "start_sec": 1404.62,
    "end_sec": 1405.22,
    "zh": "脑袋一死,",
    "vi": "Kẻ cầm đầu đã chết."
  },
  {
    "idx": 1029,
    "start": "00:23:25,460",
    "end": "00:23:26,500",
    "start_sec": 1405.46,
    "end_sec": 1406.5,
    "zh": "剩下的人尖叫着跑,",
    "vi": "Những kẻ còn lại hét lên kinh hãi rồi bỏ chạy."
  },
  {
    "idx": 1030,
    "start": "00:23:26,780",
    "end": "00:23:27,240",
    "start_sec": 1406.78,
    "end_sec": 1407.24,
    "zh": "我没追,",
    "vi": "Tôi không đuổi theo."
  },
  {
    "idx": 1031,
    "start": "00:23:27,240",
    "end": "00:23:29,320",
    "start_sec": 1407.24,
    "end_sec": 1409.32,
    "zh": "我亮相跑到狗圣身边抱起他",
    "vi": "Tôi lảo đảo chạy đến bên Cẩu Thánh và bế nó lên."
  },
  {
    "idx": 1032,
    "start": "00:23:29,320",
    "end": "00:23:30,640",
    "start_sec": 1409.32,
    "end_sec": 1410.64,
    "zh": "他半边身子都烂了",
    "vi": "Nửa thân người của nó đã nát bét."
  },
  {
    "idx": 1033,
    "start": "00:23:30,640",
    "end": "00:23:31,260",
    "start_sec": 1410.64,
    "end_sec": 1411.26,
    "zh": "赌赌人",
    "vi": "Chủ nhân."
  },
  {
    "idx": 1034,
    "start": "00:23:31,260",
    "end": "00:23:32,020",
    "start_sec": 1411.26,
    "end_sec": 1412.02,
    "zh": "算过了",
    "vi": "Tôi đã tính cả rồi."
  },
  {
    "idx": 1035,
    "start": "00:23:32,020",
    "end": "00:23:33,180",
    "start_sec": 1412.02,
    "end_sec": 1413.18,
    "zh": "我 我不行了",
    "vi": "Tôi không xong rồi."
  },
  {
    "idx": 1036,
    "start": "00:23:33,180",
    "end": "00:23:33,760",
    "start_sec": 1413.18,
    "end_sec": 1413.76,
    "zh": "别说话",
    "vi": "Đừng nói nữa."
  },
  {
    "idx": 1037,
    "start": "00:23:33,760",
    "end": "00:23:36,220",
    "start_sec": 1413.76,
    "end_sec": 1416.22,
    "zh": "我能救你",
    "vi": "Tôi có thể cứu cậu."
  },
  {
    "idx": 1038,
    "start": "00:23:36,220",
    "end": "00:23:37,940",
    "start_sec": 1416.22,
    "end_sec": 1417.94,
    "zh": "医疗箱里只有绷带和消毒水",
    "vi": "Trong hộp y tế chỉ có băng gạc và nước sát trùng."
  },
  {
    "idx": 1039,
    "start": "00:23:37,940",
    "end": "00:23:38,660",
    "start_sec": 1417.94,
    "end_sec": 1418.66,
    "zh": "屁用没有",
    "vi": "Chẳng có tác dụng gì cả."
  },
  {
    "idx": 1040,
    "start": "00:23:38,660",
    "end": "00:23:40,060",
    "start_sec": 1418.66,
    "end_sec": 1420.06,
    "zh": "合成工事变成了灰色",
    "vi": "Công thức chế tạo đã chuyển sang màu xám."
  },
  {
    "idx": 1041,
    "start": "00:23:40,060",
    "end": "00:23:41,480",
    "start_sec": 1420.06,
    "end_sec": 1421.48,
    "zh": "赌人别费劲了",
    "vi": "Chủ nhân, đừng tốn sức nữa."
  },
  {
    "idx": 1042,
    "start": "00:23:41,480",
    "end": "00:23:42,180",
    "start_sec": 1421.48,
    "end_sec": 1422.18,
    "zh": "能为你死",
    "vi": "Được chết vì ngài."
  },
  {
    "idx": 1043,
    "start": "00:23:42,180",
    "end": "00:23:43,160",
    "start_sec": 1422.18,
    "end_sec": 1423.16,
    "zh": "我很高兴",
    "vi": "Tôi rất vui."
  },
  {
    "idx": 1044,
    "start": "00:23:43,160",
    "end": "00:23:45,240",
    "start_sec": 1423.16,
    "end_sec": 1425.24,
    "zh": "可惜没看到你当上老大",
    "vi": "Chỉ tiếc là không thể thấy ngài trở thành thủ lĩnh."
  },
  {
    "idx": 1045,
    "start": "00:23:45,240",
    "end": "00:23:46,380",
    "start_sec": 1425.24,
    "end_sec": 1426.38,
    "zh": "他的爪子垂了下去",
    "vi": "Móng vuốt của nó buông thõng xuống."
  },
  {
    "idx": 1046,
    "start": "00:23:46,380",
    "end": "00:23:47,700",
    "start_sec": 1426.38,
    "end_sec": 1427.7,
    "zh": "眼睛彻底闭上了",
    "vi": "Đôi mắt nhắm nghiền lại."
  },
  {
    "idx": 1047,
    "start": "00:23:47,700",
    "end": "00:23:48,400",
    "start_sec": 1427.7,
    "end_sec": 1428.4,
    "zh": "我抱着他",
    "vi": "Tôi ôm lấy nó."
  },
  {
    "idx": 1048,
    "start": "00:23:48,400",
    "end": "00:23:49,240",
    "start_sec": 1428.4,
    "end_sec": 1429.24,
    "zh": "身体在抖",
    "vi": "Cơ thể run rẩy."
  },
  {
    "idx": 1049,
    "start": "00:23:49,240",
    "end": "00:23:50,240",
    "start_sec": 1429.24,
    "end_sec": 1430.24,
    "zh": "却发不出声音",
    "vi": "Nhưng không thể phát ra tiếng khóc."
  },
  {
    "idx": 1050,
    "start": "00:23:50,240",
    "end": "00:23:51,180",
    "start_sec": 1430.24,
    "end_sec": 1431.18,
    "zh": "他是我的造物",
    "vi": "Nó là tạo vật của tôi."
  },
  {
    "idx": 1051,
    "start": "00:23:51,180",
    "end": "00:23:51,820",
    "start_sec": 1431.18,
    "end_sec": 1431.82,
    "zh": "我的战友",
    "vi": "Đồng đội của tôi."
  },
  {
    "idx": 1052,
    "start": "00:23:51,820",
    "end": "00:23:52,440",
    "start_sec": 1431.82,
    "end_sec": 1432.44,
    "zh": "我的伙伴",
    "vi": "Bạn đồng hành của tôi."
  },
  {
    "idx": 1053,
    "start": "00:23:52,440",
    "end": "00:23:53,840",
    "start_sec": 1432.44,
    "end_sec": 1433.84,
    "zh": "现在他死了",
    "vi": "Giờ đây nó đã chết."
  },
  {
    "idx": 1054,
    "start": "00:23:53,840",
    "end": "00:23:56,280",
    "start_sec": 1433.84,
    "end_sec": 1436.28,
    "zh": "我抱着狗圣的尸体",
    "vi": "Tôi ôm thi thể của Cẩu Thánh."
  },
  {
    "idx": 1055,
    "start": "00:23:56,280",
    "end": "00:23:57,840",
    "start_sec": 1436.28,
    "end_sec": 1437.84,
    "zh": "发出了不似人声的咆哮",
    "vi": "Gầm lên những tiếng không giống giọng người."
  },
  {
    "idx": 1056,
    "start": "00:23:57,840",
    "end": "00:23:58,820",
    "start_sec": 1437.84,
    "end_sec": 1438.82,
    "zh": "角落里",
    "vi": "Ở trong góc."
  },
  {
    "idx": 1057,
    "start": "00:23:58,820",
    "end": "00:24:00,380",
    "start_sec": 1438.82,
    "end_sec": 1440.38,
    "zh": "柳如烟吓得脸都白了",
    "vi": "Liễu Như Yên sợ đến mức mặt cắt không còn giọt máu."
  },
  {
    "idx": 1058,
    "start": "00:24:00,380",
    "end": "00:24:01,240",
    "start_sec": 1440.38,
    "end_sec": 1441.24,
    "zh": "我抬起头",
    "vi": "Tôi ngẩng đầu lên."
  },
  {
    "idx": 1059,
    "start": "00:24:01,240",
    "end": "00:24:01,880",
    "start_sec": 1441.24,
    "end_sec": 1441.88,
    "zh": "看向她",
    "vi": "Nhìn về phía cô ta."
  },
  {
    "idx": 1060,
    "start": "00:24:01,880",
    "end": "00:24:03,000",
    "start_sec": 1441.88,
    "end_sec": 1443.0,
    "zh": "如果不是这个女人",
    "vi": "Nếu không phải vì người đàn bà này."
  },
  {
    "idx": 1061,
    "start": "00:24:03,000",
    "end": "00:24:04,020",
    "start_sec": 1443.0,
    "end_sec": 1444.02,
    "zh": "狗圣就不会死",
    "vi": "Cẩu Thánh đã không chết."
  },
  {
    "idx": 1062,
    "start": "00:24:04,020",
    "end": "00:24:04,800",
    "start_sec": 1444.02,
    "end_sec": 1444.8,
    "zh": "我放下狗圣",
    "vi": "Tôi đặt Cẩu Thánh xuống."
  },
  {
    "idx": 1063,
    "start": "00:24:04,800",
    "end": "00:24:05,900",
    "start_sec": 1444.8,
    "end_sec": 1445.9,
    "zh": "一步步向她走去",
    "vi": "Từng bước đi về phía cô ta."
  },
  {
    "idx": 1064,
    "start": "00:24:05,900",
    "end": "00:24:06,280",
    "start_sec": 1445.9,
    "end_sec": 1446.28,
    "zh": "不",
    "vi": "Không."
  },
  {
    "idx": 1065,
    "start": "00:24:06,280",
    "end": "00:24:07,080",
    "start_sec": 1446.28,
    "end_sec": 1447.08,
    "zh": "不是我",
    "vi": "Không phải tôi."
  },
  {
    "idx": 1066,
    "start": "00:24:07,080",
    "end": "00:24:07,940",
    "start_sec": 1447.08,
    "end_sec": 1447.94,
    "zh": "不帮我的事",
    "vi": "Không liên quan đến tôi."
  },
  {
    "idx": 1067,
    "start": "00:24:07,940",
    "end": "00:24:09,520",
    "start_sec": 1447.94,
    "end_sec": 1449.52,
    "zh": "她哆哆嗦嗦地后退",
    "vi": "Cô ta run rẩy lùi lại."
  },
  {
    "idx": 1068,
    "start": "00:24:09,520",
    "end": "00:24:10,940",
    "start_sec": 1449.52,
    "end_sec": 1450.94,
    "zh": "直到靠住冰冷的墙",
    "vi": "Cho đến khi tựa vào bức tường lạnh giá."
  },
  {
    "idx": 1069,
    "start": "00:24:10,940",
    "end": "00:24:12,180",
    "start_sec": 1450.94,
    "end_sec": 1452.18,
    "zh": "我走到她面前",
    "vi": "Tôi đi đến trước mặt cô ta."
  },
  {
    "idx": 1070,
    "start": "00:24:12,180",
    "end": "00:24:13,460",
    "start_sec": 1452.18,
    "end_sec": 1453.46,
    "zh": "举起沾满血的双手",
    "vi": "Giơ đôi bàn tay đẫm máu lên."
  },
  {
    "idx": 1071,
    "start": "00:24:13,460",
    "end": "00:24:13,980",
    "start_sec": 1453.46,
    "end_sec": 1453.98,
    "zh": "是你",
    "vi": "Là cô."
  },
  {
    "idx": 1072,
    "start": "00:24:13,980",
    "end": "00:24:14,700",
    "start_sec": 1453.98,
    "end_sec": 1454.7,
    "zh": "害死了她",
    "vi": "Đã hại chết nó."
  },
  {
    "idx": 1073,
    "start": "00:24:14,700",
    "end": "00:24:15,420",
    "start_sec": 1454.7,
    "end_sec": 1455.42,
    "zh": "是你",
    "vi": "Chính là cô."
  },
  {
    "idx": 1074,
    "start": "00:24:15,420",
    "end": "00:24:16,460",
    "start_sec": 1455.42,
    "end_sec": 1456.46,
    "zh": "我掐住她的脖子",
    "vi": "Tôi bóp cổ cô ta."
  },
  {
    "idx": 1075,
    "start": "00:24:16,460",
    "end": "00:24:17,560",
    "start_sec": 1456.46,
    "end_sec": 1457.56,
    "zh": "把她提了起来",
    "vi": "Nhấc bổng cô ta lên."
  },
  {
    "idx": 1076,
    "start": "00:24:17,560",
    "end": "00:24:18,260",
    "start_sec": 1457.56,
    "end_sec": 1458.26,
    "zh": "柳如烟的脸",
    "vi": "Gương mặt của Liễu Như Yên."
  },
  {
    "idx": 1077,
    "start": "00:24:18,260",
    "end": "00:24:19,040",
    "start_sec": 1458.26,
    "end_sec": 1459.04,
    "zh": "胀成猪肝色",
    "vi": "Tím tái như gan heo."
  },
  {
    "idx": 1078,
    "start": "00:24:19,040",
    "end": "00:24:20,360",
    "start_sec": 1459.04,
    "end_sec": 1460.36,
    "zh": "双脚在空中慢动",
    "vi": "Hai chân giãy giụa trên không trung."
  },
  {
    "idx": 1079,
    "start": "00:24:20,360",
    "end": "00:24:21,220",
    "start_sec": 1460.36,
    "end_sec": 1461.22,
    "zh": "就在我准备",
    "vi": "Ngay khi tôi chuẩn bị."
  },
  {
    "idx": 1080,
    "start": "00:24:21,220",
    "end": "00:24:22,160",
    "start_sec": 1461.22,
    "end_sec": 1462.16,
    "zh": "拧断他脖子时",
    "vi": "Vặn gãy cổ cô ta."
  },
  {
    "idx": 1081,
    "start": "00:24:22,160",
    "end": "00:24:23,680",
    "start_sec": 1462.16,
    "end_sec": 1463.68,
    "zh": "脑子里跳出一个想法",
    "vi": "Trong đầu tôi chợt nảy ra một ý nghĩ."
  },
  {
    "idx": 1082,
    "start": "00:24:23,680",
    "end": "00:24:24,660",
    "start_sec": 1463.68,
    "end_sec": 1464.66,
    "zh": "狗头君是尸体",
    "vi": "Cẩu Thặng đã là một cái xác."
  },
  {
    "idx": 1083,
    "start": "00:24:24,660",
    "end": "00:24:26,000",
    "start_sec": 1464.66,
    "end_sec": 1466.0,
    "zh": "加人类活体会等于什么",
    "vi": "Cộng với một cơ thể người sống thì sẽ ra cái gì."
  },
  {
    "idx": 1084,
    "start": "00:24:26,000",
    "end": "00:24:27,860",
    "start_sec": 1466.0,
    "end_sec": 1467.86,
    "zh": "这是救活狗圣唯一的希望",
    "vi": "Đây là hy vọng duy nhất để cứu sống Cẩu Thặng."
  },
  {
    "idx": 1085,
    "start": "00:24:27,860",
    "end": "00:24:29,500",
    "start_sec": 1467.86,
    "end_sec": 1469.5,
    "zh": "我必须换回我的伙伴",
    "vi": "Tôi phải cứu bằng được người bạn đồng hành của mình."
  },
  {
    "idx": 1086,
    "start": "00:24:29,500",
    "end": "00:24:30,460",
    "start_sec": 1469.5,
    "end_sec": 1470.46,
    "zh": "对 对不起",
    "vi": "Xin lỗi. Xin lỗi."
  },
  {
    "idx": 1087,
    "start": "00:24:30,460",
    "end": "00:24:32,040",
    "start_sec": 1470.46,
    "end_sec": 1472.04,
    "zh": "刘如燕挤出几个字",
    "vi": "Liễu Như Yên thốt ra vài chữ."
  },
  {
    "idx": 1088,
    "start": "00:24:32,040",
    "end": "00:24:33,280",
    "start_sec": 1472.04,
    "end_sec": 1473.28,
    "zh": "眼里全是求饶",
    "vi": "Ánh mắt cô ta đầy vẻ van xin."
  },
  {
    "idx": 1089,
    "start": "00:24:33,280",
    "end": "00:24:34,280",
    "start_sec": 1473.28,
    "end_sec": 1474.28,
    "zh": "我看着她",
    "vi": "Tôi nhìn cô ta."
  },
  {
    "idx": 1090,
    "start": "00:24:34,280",
    "end": "00:24:35,000",
    "start_sec": 1474.28,
    "end_sec": 1475.0,
    "zh": "下了决心",
    "vi": "Rồi hạ quyết tâm."
  },
  {
    "idx": 1091,
    "start": "00:24:35,000",
    "end": "00:24:36,600",
    "start_sec": 1475.0,
    "end_sec": 1476.6,
    "zh": "你的命现在是我的了",
    "vi": "Mạng sống của cô bây giờ là của tôi."
  },
  {
    "idx": 1092,
    "start": "00:24:36,600",
    "end": "00:24:37,320",
    "start_sec": 1476.6,
    "end_sec": 1477.32,
    "zh": "我把她打晕",
    "vi": "Tôi đánh ngất cô ta."
  },
  {
    "idx": 1093,
    "start": "00:24:37,320",
    "end": "00:24:38,420",
    "start_sec": 1477.32,
    "end_sec": 1478.42,
    "zh": "拖到狗圣的尸体旁",
    "vi": "Rồi kéo đến bên xác của Cẩu Thặng."
  },
  {
    "idx": 1094,
    "start": "00:24:38,420",
    "end": "00:24:39,500",
    "start_sec": 1478.42,
    "end_sec": 1479.5,
    "zh": "我深吸一口气",
    "vi": "Tôi hít một hơi thật sâu."
  },
  {
    "idx": 1095,
    "start": "00:24:39,500",
    "end": "00:24:41,180",
    "start_sec": 1479.5,
    "end_sec": 1481.18,
    "zh": "手分别按在他们身上",
    "vi": "Đặt hai tay lên người của bọn họ."
  },
  {
    "idx": 1096,
    "start": "00:24:41,180",
    "end": "00:24:41,720",
    "start_sec": 1481.18,
    "end_sec": 1481.72,
    "zh": "合成",
    "vi": "Dung hợp."
  },
  {
    "idx": 1097,
    "start": "00:24:41,720",
    "end": "00:24:43,200",
    "start_sec": 1481.72,
    "end_sec": 1483.2,
    "zh": "白光通摸了一切",
    "vi": "Ánh sáng trắng nuốt chửng mọi thứ."
  },
  {
    "idx": 1098,
    "start": "00:24:43,200",
    "end": "00:24:44,340",
    "start_sec": 1483.2,
    "end_sec": 1484.34,
    "zh": "光里带着血色",
    "vi": "Trong ánh sáng có lẫn sắc máu."
  },
  {
    "idx": 1099,
    "start": "00:24:44,340",
    "end": "00:24:45,980",
    "start_sec": 1484.34,
    "end_sec": 1485.98,
    "zh": "我的精神力被猛地抽搐",
    "vi": "Sức mạnh tinh thần của tôi bị rút cạn một cách dữ dội."
  },
  {
    "idx": 1100,
    "start": "00:24:45,980",
    "end": "00:24:47,520",
    "start_sec": 1485.98,
    "end_sec": 1487.52,
    "zh": "脑袋像天炸一样寒",
    "vi": "Đầu tôi đau như muốn nổ tung."
  },
  {
    "idx": 1101,
    "start": "00:24:47,520",
    "end": "00:24:48,460",
    "start_sec": 1487.52,
    "end_sec": 1488.46,
    "zh": "光芒散去",
    "vi": "Ánh sáng tan đi."
  },
  {
    "idx": 1102,
    "start": "00:24:48,460",
    "end": "00:24:49,320",
    "start_sec": 1488.46,
    "end_sec": 1489.32,
    "zh": "我跪倒在地",
    "vi": "Tôi quỳ sụp xuống đất."
  },
  {
    "idx": 1103,
    "start": "00:24:49,320",
    "end": "00:24:50,000",
    "start_sec": 1489.32,
    "end_sec": 1490.0,
    "zh": "面前",
    "vi": "Trước mặt tôi."
  },
  {
    "idx": 1104,
    "start": "00:24:50,000",
    "end": "00:24:51,760",
    "start_sec": 1490.0,
    "end_sec": 1491.76,
    "zh": "一个全新的生物静静躺着",
    "vi": "Một sinh vật hoàn toàn mới đang nằm im lìm."
  },
  {
    "idx": 1105,
    "start": "00:24:51,760",
    "end": "00:24:53,000",
    "start_sec": 1491.76,
    "end_sec": 1493.0,
    "zh": "它留着狗剩的狗头",
    "vi": "Nó mang chiếc đầu chó của Cẩu Thặng."
  },
  {
    "idx": 1106,
    "start": "00:24:53,000",
    "end": "00:24:54,720",
    "start_sec": 1493.0,
    "end_sec": 1494.72,
    "zh": "身体是变成了柳如烟的",
    "vi": "Nhưng thân xác lại là của Liễu Như Yên."
  },
  {
    "idx": 1107,
    "start": "00:24:54,720",
    "end": "00:24:58,731",
    "start_sec": 1494.72,
    "end_sec": 1498.731,
    "zh": "狗头人身它慢慢睁开眼神情迷茫又复杂它的声音是柳如烟的女声但语气还是狗声那股味道他低头看了看自己白嫩的手又摸了摸胸口",
    "vi": "Sinh vật đầu chó mình người đó từ từ mở mắt ra, ánh mắt đầy vẻ mơ hồ và phức tạp"
  },
  {
    "idx": 1107,
    "start": "00:24:58,731",
    "end": "00:25:02,742",
    "start_sec": 1498.731,
    "end_sec": 1502.742,
    "zh": "狗头人身它慢慢睁开眼神情迷茫又复杂它的声音是柳如烟的女声但语气还是狗声那股味道他低头看了看自己白嫩的手又摸了摸胸口",
    "vi": "Giọng nói của nó là giọng nữ của Liễu Như Yên, nhưng ngữ điệu vẫn mang phong cách của Cẩu Thặng"
  },
  {
    "idx": 1107,
    "start": "00:25:02,742",
    "end": "00:25:05,797",
    "start_sec": 1502.742,
    "end_sec": 1505.797,
    "zh": "狗头人身它慢慢睁开眼神情迷茫又复杂它的声音是柳如烟的女声但语气还是狗声那股味道他低头看了看自己白嫩的手又摸了摸胸口",
    "vi": "Nó cúi đầu nhìn đôi bàn tay trắng nõn của mình, rồi lại sờ lên ngực"
  },
  {
    "idx": 1108,
    "start": "00:25:05,797",
    "end": "00:25:07,877",
    "start_sec": 1505.797,
    "end_sec": 1507.877,
    "zh": "狗脸上是我从没见过的震惊",
    "vi": "Trên khuôn mặt chó hiện rõ vẻ kinh ngạc mà tôi chưa từng thấy bao giờ."
  },
  {
    "idx": 1109,
    "start": "00:25:07,877",
    "end": "00:25:10,797",
    "start_sec": 1507.877,
    "end_sec": 1510.797,
    "zh": "我 我这是变成狗的吗",
    "vi": "Tôi, tôi biến thành chó rồi sao."
  },
  {
    "idx": 1110,
    "start": "00:25:10,797",
    "end": "00:25:11,597",
    "start_sec": 1510.797,
    "end_sec": 1511.597,
    "zh": "我松了口气",
    "vi": "Tôi thở phào nhẹ nhõm."
  },
  {
    "idx": 1111,
    "start": "00:25:11,597",
    "end": "00:25:12,897",
    "start_sec": 1511.597,
    "end_sec": 1512.897,
    "zh": "意识还是狗声了",
    "vi": "Ý thức vẫn bị con chó lấn át."
  },
  {
    "idx": 1112,
    "start": "00:25:12,897",
    "end": "00:25:13,657",
    "start_sec": 1512.897,
    "end_sec": 1513.657,
    "zh": "欢迎回来",
    "vi": "Chào mừng trở lại."
  },
  {
    "idx": 1113,
    "start": "00:25:13,657",
    "end": "00:25:14,657",
    "start_sec": 1513.657,
    "end_sec": 1514.657,
    "zh": "我虚弱的笑了笑",
    "vi": "Tôi mỉm cười yếu ớt."
  },
  {
    "idx": 1114,
    "start": "00:25:14,657",
    "end": "00:25:16,997",
    "start_sec": 1514.657,
    "end_sec": 1516.997,
    "zh": "他站起身跌跌撞撞冲到一面破镜子前",
    "vi": "Cô ấy đứng dậy loạng choạng lao đến trước một tấm gương vỡ."
  },
  {
    "idx": 1115,
    "start": "00:25:16,997",
    "end": "00:25:18,637",
    "start_sec": 1516.997,
    "end_sec": 1518.637,
    "zh": "他镜子里是一个顶着狗头",
    "vi": "Trong gương là một con quái vật đầu chó."
  },
  {
    "idx": 1116,
    "start": "00:25:18,637",
    "end": "00:25:20,277",
    "start_sec": 1518.637,
    "end_sec": 1520.277,
    "zh": "却有女人曲线的怪物",
    "vi": "Nhưng lại mang thân hình của một người phụ nữ."
  },
  {
    "idx": 1117,
    "start": "00:25:20,277",
    "end": "00:25:21,677",
    "start_sec": 1520.277,
    "end_sec": 1521.677,
    "zh": "他弯下腰杆了",
    "vi": "Cô ấy khom lưng nôn oẹ."
  },
  {
    "idx": 1118,
    "start": "00:25:21,677",
    "end": "00:25:23,337",
    "start_sec": 1521.677,
    "end_sec": 1523.337,
    "zh": "要把五脏六腑都吐出来",
    "vi": "Như muốn nôn ra hết cả ruột gan."
  },
  {
    "idx": 1119,
    "start": "00:25:23,337",
    "end": "00:25:24,177",
    "start_sec": 1523.337,
    "end_sec": 1524.177,
    "zh": "吐了一阵",
    "vi": "Nôn một hồi."
  },
  {
    "idx": 1120,
    "start": "00:25:24,177",
    "end": "00:25:25,197",
    "start_sec": 1524.177,
    "end_sec": 1525.197,
    "zh": "他在蹭着墙杖",
    "vi": "Cô ấy vịn vào tường."
  },
  {
    "idx": 1121,
    "start": "00:25:25,197",
    "end": "00:25:26,497",
    "start_sec": 1525.197,
    "end_sec": 1526.497,
    "zh": "重新看向镜子",
    "vi": "Nhìn lại vào gương."
  },
  {
    "idx": 1122,
    "start": "00:25:26,497",
    "end": "00:25:27,637",
    "start_sec": 1526.497,
    "end_sec": 1527.637,
    "zh": "脸上写满挣扎",
    "vi": "Vẻ mặt đầy sự đấu tranh."
  },
  {
    "idx": 1123,
    "start": "00:25:27,637",
    "end": "00:25:28,237",
    "start_sec": 1527.637,
    "end_sec": 1528.237,
    "zh": "主人",
    "vi": "Chủ nhân."
  },
  {
    "idx": 1124,
    "start": "00:25:28,237",
    "end": "00:25:28,957",
    "start_sec": 1528.237,
    "end_sec": 1528.957,
    "zh": "他转过身",
    "vi": "Cô ấy quay người lại."
  },
  {
    "idx": 1125,
    "start": "00:25:28,957",
    "end": "00:25:29,797",
    "start_sec": 1528.957,
    "end_sec": 1529.797,
    "zh": "声音沙哑",
    "vi": "Giọng nói khàn đặc."
  },
  {
    "idx": 1126,
    "start": "00:25:29,797",
    "end": "00:25:31,457",
    "start_sec": 1529.797,
    "end_sec": 1531.457,
    "zh": "窝道这里全是他的东西",
    "vi": "Trong ổ này toàn là đồ của nó."
  },
  {
    "idx": 1127,
    "start": "00:25:31,457",
    "end": "00:25:32,017",
    "start_sec": 1531.457,
    "end_sec": 1532.017,
    "zh": "他放黑",
    "vi": "Nó sợ bóng tối."
  },
  {
    "idx": 1128,
    "start": "00:25:32,017",
    "end": "00:25:33,237",
    "start_sec": 1532.017,
    "end_sec": 1533.237,
    "zh": "他起火捡钻石",
    "vi": "Nó thích nhặt kim cương."
  },
  {
    "idx": 1129,
    "start": "00:25:33,237",
    "end": "00:25:34,357",
    "start_sec": 1533.237,
    "end_sec": 1534.357,
    "zh": "他觉得你",
    "vi": "Nó thấy anh."
  },
  {
    "idx": 1130,
    "start": "00:25:34,357",
    "end": "00:25:34,997",
    "start_sec": 1534.357,
    "end_sec": 1534.997,
    "zh": "很帅",
    "vi": "Rất đẹp trai."
  },
  {
    "idx": 1131,
    "start": "00:25:34,997",
    "end": "00:25:36,357",
    "start_sec": 1534.997,
    "end_sec": 1536.357,
    "zh": "这些没用的裙式垃圾",
    "vi": "Đống rác rưởi vô dụng này."
  },
  {
    "idx": 1132,
    "start": "00:25:36,357",
    "end": "00:25:37,517",
    "start_sec": 1536.357,
    "end_sec": 1537.517,
    "zh": "在出救我的逻辑",
    "vi": "Đang xung đột với tư duy của tôi."
  },
  {
    "idx": 1133,
    "start": "00:25:37,517",
    "end": "00:25:38,817",
    "start_sec": 1537.517,
    "end_sec": 1538.817,
    "zh": "我的脑子要炸了",
    "vi": "Đầu tôi sắp nổ tung rồi."
  },
  {
    "idx": 1134,
    "start": "00:25:38,817",
    "end": "00:25:39,937",
    "start_sec": 1538.817,
    "end_sec": 1539.937,
    "zh": "他抱着自己的狗头",
    "vi": "Cô ấy ôm lấy cái đầu chó của mình."
  },
  {
    "idx": 1135,
    "start": "00:25:39,937",
    "end": "00:25:40,997",
    "start_sec": 1539.937,
    "end_sec": 1540.997,
    "zh": "痛苦的低吼",
    "vi": "Gầm gừ đau đớn."
  },
  {
    "idx": 1136,
    "start": "00:25:40,997",
    "end": "00:25:42,197",
    "start_sec": 1540.997,
    "end_sec": 1542.197,
    "zh": "那就先控他了",
    "vi": "Vậy thì khống chế nó trước đi."
  },
  {
    "idx": 1137,
    "start": "00:25:42,197",
    "end": "00:25:42,737",
    "start_sec": 1542.197,
    "end_sec": 1542.737,
    "zh": "做不到",
    "vi": "Không làm được."
  },
  {
    "idx": 1138,
    "start": "00:25:42,737",
    "end": "00:25:44,137",
    "start_sec": 1542.737,
    "end_sec": 1544.137,
    "zh": "这些记忆和感情",
    "vi": "Những ký ức và tình cảm này."
  },
  {
    "idx": 1139,
    "start": "00:25:44,137",
    "end": "00:25:45,277",
    "start_sec": 1544.137,
    "end_sec": 1545.277,
    "zh": "像地炉一样扎根了",
    "vi": "Đã cắm rễ sâu như đinh đóng cột."
  },
  {
    "idx": 1140,
    "start": "00:25:45,277",
    "end": "00:25:46,577",
    "start_sec": 1545.277,
    "end_sec": 1546.577,
    "zh": "我能感觉到他的恐惧",
    "vi": "Tôi có thể cảm nhận được nỗi sợ hãi của nó."
  },
  {
    "idx": 1141,
    "start": "00:25:46,577",
    "end": "00:25:47,317",
    "start_sec": 1546.577,
    "end_sec": 1547.317,
    "zh": "他的后悔",
    "vi": "Sự hối hận của anh ta."
  },
  {
    "idx": 1142,
    "start": "00:25:47,317",
    "end": "00:25:47,937",
    "start_sec": 1547.317,
    "end_sec": 1547.937,
    "zh": "甚至",
    "vi": "Thậm chí."
  },
  {
    "idx": 1143,
    "start": "00:25:47,937",
    "end": "00:25:48,937",
    "start_sec": 1547.937,
    "end_sec": 1548.937,
    "zh": "他被你的音乐",
    "vi": "Anh ta bị âm nhạc của bạn."
  },
  {
    "idx": 1144,
    "start": "00:25:48,937",
    "end": "00:25:49,757",
    "start_sec": 1548.937,
    "end_sec": 1549.757,
    "zh": "我虚视我",
    "vi": "Làm cho xao nhãng."
  },
  {
    "idx": 1145,
    "start": "00:25:49,757",
    "end": "00:25:50,377",
    "start_sec": 1549.757,
    "end_sec": 1550.377,
    "zh": "也是他",
    "vi": "Cũng chính là anh ta."
  },
  {
    "idx": 1146,
    "start": "00:25:50,377",
    "end": "00:25:51,397",
    "start_sec": 1550.377,
    "end_sec": 1551.397,
    "zh": "他不说话了",
    "vi": "Anh ta không nói gì nữa."
  },
  {
    "idx": 1147,
    "start": "00:25:51,397",
    "end": "00:25:52,397",
    "start_sec": 1551.397,
    "end_sec": 1552.397,
    "zh": "走到那个被忘掉的",
    "vi": "Đi tới cái thứ đã bị lãng quên."
  },
  {
    "idx": 1148,
    "start": "00:25:52,397",
    "end": "00:25:53,857",
    "start_sec": 1552.397,
    "end_sec": 1553.857,
    "zh": "移动式电子麦程号台前",
    "vi": "Trước bệ phóng xung điện từ di động."
  },
  {
    "idx": 1149,
    "start": "00:25:53,857",
    "end": "00:25:54,897",
    "start_sec": 1553.857,
    "end_sec": 1554.897,
    "zh": "号台的充能进度",
    "vi": "Tiến độ nạp năng lượng của bệ phóng."
  },
  {
    "idx": 1150,
    "start": "00:25:54,897",
    "end": "00:25:56,417",
    "start_sec": 1554.897,
    "end_sec": 1556.417,
    "zh": "已经到了98%",
    "vi": "Đã đạt tới chín mươi tám phần trăm."
  },
  {
    "idx": 1151,
    "start": "00:25:56,417",
    "end": "00:25:57,697",
    "start_sec": 1556.417,
    "end_sec": 1557.697,
    "zh": "周源的团队被灭了",
    "vi": "Đội của Chu Nguyên đã bị tiêu diệt."
  },
  {
    "idx": 1152,
    "start": "00:25:57,697",
    "end": "00:25:59,277",
    "start_sec": 1557.697,
    "end_sec": 1559.277,
    "zh": "消息很快会传回老曹",
    "vi": "Tin tức sẽ sớm truyền về chỗ Lão Tào."
  },
  {
    "idx": 1153,
    "start": "00:25:59,277",
    "end": "00:26:00,297",
    "start_sec": 1559.277,
    "end_sec": 1560.297,
    "zh": "我们必须在他们",
    "vi": "Chúng ta phải ra tay."
  },
  {
    "idx": 1154,
    "start": "00:26:00,297",
    "end": "00:26:01,717",
    "start_sec": 1560.297,
    "end_sec": 1561.717,
    "zh": "反应过来之前动手",
    "vi": "Trước khi bọn họ kịp phản ứng."
  },
  {
    "idx": 1155,
    "start": "00:26:01,717",
    "end": "00:26:02,397",
    "start_sec": 1561.717,
    "end_sec": 1562.397,
    "zh": "我看着他",
    "vi": "Tôi nhìn anh ta."
  },
  {
    "idx": 1156,
    "start": "00:26:02,397",
    "end": "00:26:03,577",
    "start_sec": 1562.397,
    "end_sec": 1563.577,
    "zh": "我需要你的计算",
    "vi": "Tôi cần sự tính toán của bạn."
  },
  {
    "idx": 1157,
    "start": "00:26:03,577",
    "end": "00:26:04,737",
    "start_sec": 1563.577,
    "end_sec": 1564.737,
    "zh": "他心的狗剩",
    "vi": "Cậu ta hít một hơi thật sâu."
  },
  {
    "idx": 1158,
    "start": "00:26:04,737",
    "end": "00:26:05,617",
    "start_sec": 1564.737,
    "end_sec": 1565.617,
    "zh": "深吸一口气",
    "vi": "Lấy lại bình tĩnh."
  },
  {
    "idx": 1159,
    "start": "00:26:05,617",
    "end": "00:26:07,277",
    "start_sec": 1565.617,
    "end_sec": 1567.277,
    "zh": "眼里恢复了些冷静",
    "vi": "Trong ánh mắt đã bớt đi sự hoảng loạn."
  },
  {
    "idx": 1160,
    "start": "00:26:07,277",
    "end": "00:26:07,997",
    "start_sec": 1567.277,
    "end_sec": 1567.997,
    "zh": "负载足心",
    "vi": "Phạm vi mười lăm cây số."
  },
  {
    "idx": 1161,
    "start": "00:26:07,997",
    "end": "00:26:09,057",
    "start_sec": 1567.997,
    "end_sec": 1569.057,
    "zh": "一只15公里",
    "vi": "Số lượng ước tính từ một trăm năm mươi đến hai trăm người."
  },
  {
    "idx": 1162,
    "start": "00:26:09,057",
    "end": "00:26:11,037",
    "start_sec": 1569.057,
    "end_sec": 1571.037,
    "zh": "人数估计150到200人",
    "vi": "Có vài khẩu súng và hai chiếc xe bọc thép."
  },
  {
    "idx": 1163,
    "start": "00:26:11,037",
    "end": "00:26:12,737",
    "start_sec": 1571.037,
    "end_sec": 1572.737,
    "zh": "有几把枪和两辆装甲车",
    "vi": "Nếu đánh trực diện."
  },
  {
    "idx": 1164,
    "start": "00:26:12,737",
    "end": "00:26:13,337",
    "start_sec": 1572.737,
    "end_sec": 1573.337,
    "zh": "正面打",
    "vi": "Sẽ không có cơ hội nào cả."
  },
  {
    "idx": 1165,
    "start": "00:26:13,337",
    "end": "00:26:14,257",
    "start_sec": 1573.337,
    "end_sec": 1574.257,
    "zh": "一点机会没有",
    "vi": "Nhưng điểm yếu lớn nhất của bọn họ."
  },
  {
    "idx": 1166,
    "start": "00:26:14,257",
    "end": "00:26:15,437",
    "start_sec": 1574.257,
    "end_sec": 1575.437,
    "zh": "但他们最大的弱点",
    "vi": "Chính là phụ thuộc vào thiết bị điện tử."
  },
  {
    "idx": 1167,
    "start": "00:26:15,437",
    "end": "00:26:16,997",
    "start_sec": 1575.437,
    "end_sec": 1576.997,
    "zh": "是他约了电子设备了",
    "vi": "Cậu ta nhìn về phía bệ phóng xung điện từ sau lưng tôi."
  },
  {
    "idx": 1168,
    "start": "00:26:16,997",
    "end": "00:26:18,837",
    "start_sec": 1576.997,
    "end_sec": 1578.837,
    "zh": "他看向我身后的电磁脉冲炮台",
    "vi": "Đúng vậy."
  },
  {
    "idx": 1169,
    "start": "00:26:18,837",
    "end": "00:26:19,437",
    "start_sec": 1578.837,
    "end_sec": 1579.437,
    "zh": "没错",
    "vi": "Tôi đã khởi động bệ phóng."
  },
  {
    "idx": 1170,
    "start": "00:26:19,437",
    "end": "00:26:20,477",
    "start_sec": 1579.437,
    "end_sec": 1580.477,
    "zh": "我猜了开炮台",
    "vi": "Đợi lệnh khai hỏa."
  },
  {
    "idx": 1171,
    "start": "00:26:20,477",
    "end": "00:26:22,217",
    "start_sec": 1580.477,
    "end_sec": 1582.217,
    "zh": "我们要给他们送饭大礼",
    "vi": "Chúng ta phải tặng cho bọn chúng một món quà lớn."
  },
  {
    "idx": 1172,
    "start": "00:26:22,217",
    "end": "00:26:23,677",
    "start_sec": 1582.217,
    "end_sec": 1583.677,
    "zh": "我们把炮台搬上越野车",
    "vi": "Chúng tôi chuyển bệ phóng lên xe địa hình."
  },
  {
    "idx": 1173,
    "start": "00:26:23,677",
    "end": "00:26:25,137",
    "start_sec": 1583.677,
    "end_sec": 1585.137,
    "zh": "开向成功的会展中心",
    "vi": "Hướng thẳng đến trung tâm hội nghị Thành Công."
  },
  {
    "idx": 1174,
    "start": "00:26:25,137",
    "end": "00:26:25,717",
    "start_sec": 1585.137,
    "end_sec": 1585.717,
    "zh": "路上",
    "vi": "Trên đường đi."
  },
  {
    "idx": 1175,
    "start": "00:26:25,717",
    "end": "00:26:27,257",
    "start_sec": 1585.717,
    "end_sec": 1587.257,
    "zh": "新的狗生一直不说话",
    "vi": "Cậu ta cứ im lặng mãi."
  },
  {
    "idx": 1176,
    "start": "00:26:27,257",
    "end": "00:26:28,037",
    "start_sec": 1587.257,
    "end_sec": 1588.037,
    "zh": "后悔吗",
    "vi": "Cậu có hối hận không."
  },
  {
    "idx": 1177,
    "start": "00:26:28,037",
    "end": "00:26:28,697",
    "start_sec": 1588.037,
    "end_sec": 1588.697,
    "zh": "他摇摇头",
    "vi": "Cậu ta lắc đầu."
  },
  {
    "idx": 1178,
    "start": "00:26:28,697",
    "end": "00:26:29,637",
    "start_sec": 1588.697,
    "end_sec": 1589.637,
    "zh": "又点了点头",
    "vi": "Rồi lại gật đầu."
  },
  {
    "idx": 1179,
    "start": "00:26:29,637",
    "end": "00:26:30,317",
    "start_sec": 1589.637,
    "end_sec": 1590.317,
    "zh": "不知道",
    "vi": "Tôi không biết."
  },
  {
    "idx": 1180,
    "start": "00:26:30,317",
    "end": "00:26:31,537",
    "start_sec": 1590.317,
    "end_sec": 1591.537,
    "zh": "李奇告诉我",
    "vi": "Lý Kỳ đã bảo tôi."
  },
  {
    "idx": 1181,
    "start": "00:26:31,537",
    "end": "00:26:32,617",
    "start_sec": 1591.537,
    "end_sec": 1592.617,
    "zh": "这是最好的办法",
    "vi": "Đây là cách tốt nhất."
  },
  {
    "idx": 1182,
    "start": "00:26:32,617",
    "end": "00:26:33,657",
    "start_sec": 1592.617,
    "end_sec": 1593.657,
    "zh": "但柳如烟的记忆",
    "vi": "Nhưng ký ức của Liễu Như Yên."
  },
  {
    "idx": 1183,
    "start": "00:26:33,657",
    "end": "00:26:35,157",
    "start_sec": 1593.657,
    "end_sec": 1595.157,
    "zh": "让我觉得恶心和害怕",
    "vi": "Làm tôi thấy ghê tởm và sợ hãi."
  },
  {
    "idx": 1184,
    "start": "00:26:35,157",
    "end": "00:26:36,137",
    "start_sec": 1595.157,
    "end_sec": 1596.137,
    "zh": "你会习惯的",
    "vi": "Cậu sẽ quen thôi."
  },
  {
    "idx": 1185,
    "start": "00:26:36,137",
    "end": "00:26:36,617",
    "start_sec": 1596.137,
    "end_sec": 1596.617,
    "zh": "别喜欢",
    "vi": "Đừng thích nó."
  },
  {
    "idx": 1186,
    "start": "00:26:36,617",
    "end": "00:26:37,097",
    "start_sec": 1596.617,
    "end_sec": 1597.097,
    "zh": "很快",
    "vi": "Rất nhanh thôi."
  },
  {
    "idx": 1187,
    "start": "00:26:37,097",
    "end": "00:26:38,617",
    "start_sec": 1597.097,
    "end_sec": 1598.617,
    "zh": "巨大的会展中心出现了",
    "vi": "Trung tâm hội nghị khổng lồ đã hiện ra."
  },
  {
    "idx": 1188,
    "start": "00:26:38,617",
    "end": "00:26:39,297",
    "start_sec": 1598.617,
    "end_sec": 1599.297,
    "zh": "那里灯火通明",
    "vi": "Nơi đó đèn đuốc sáng trưng."
  },
  {
    "idx": 1189,
    "start": "00:26:39,297",
    "end": "00:26:40,597",
    "start_sec": 1599.297,
    "end_sec": 1600.597,
    "zh": "像个军事基地",
    "vi": "Trông như một căn cứ quân sự."
  },
  {
    "idx": 1190,
    "start": "00:26:40,597",
    "end": "00:26:41,237",
    "start_sec": 1600.597,
    "end_sec": 1601.237,
    "zh": "不用进去",
    "vi": "Không cần vào trong."
  },
  {
    "idx": 1191,
    "start": "00:26:41,237",
    "end": "00:26:42,357",
    "start_sec": 1601.237,
    "end_sec": 1602.357,
    "zh": "他从柳如烟的记忆",
    "vi": "Cậu ta lấy từ ký ức của Liễu Như Yên."
  },
  {
    "idx": 1192,
    "start": "00:26:45,437",
    "end": "00:26:47,117",
    "start_sec": 1605.437,
    "end_sec": 1607.117,
    "zh": "在A管三楼西南角",
    "vi": "Ở góc tây nam tầng ba tòa nhà A."
  },
  {
    "idx": 1193,
    "start": "00:26:47,117",
    "end": "00:26:48,677",
    "start_sec": 1607.117,
    "end_sec": 1608.677,
    "zh": "他指着远处一个烂尾楼",
    "vi": "Cậu ta chỉ tay về phía tòa nhà bỏ hoang đằng xa."
  },
  {
    "idx": 1194,
    "start": "00:26:48,677",
    "end": "00:26:50,677",
    "start_sec": 1608.677,
    "end_sec": 1610.677,
    "zh": "那里是最好的炮击点",
    "vi": "Đó là vị trí pháo kích tốt nhất."
  },
  {
    "idx": 1195,
    "start": "00:26:50,677",
    "end": "00:26:52,117",
    "start_sec": 1610.677,
    "end_sec": 1612.117,
    "zh": "我们合力把炮台搬上楼顶",
    "vi": "Chúng tôi hợp sức chuyển bệ phóng lên sân thượng."
  },
  {
    "idx": 1196,
    "start": "00:26:52,117",
    "end": "00:26:53,817",
    "start_sec": 1612.117,
    "end_sec": 1613.817,
    "zh": "这里能清楚看见A管",
    "vi": "Từ đây có thể nhìn rõ tòa nhà A."
  },
  {
    "idx": 1197,
    "start": "00:26:53,817",
    "end": "00:26:54,637",
    "start_sec": 1613.817,
    "end_sec": 1614.637,
    "zh": "出了碗地",
    "vi": "Đã vào tầm ngắm."
  },
  {
    "idx": 1198,
    "start": "00:26:54,637",
    "end": "00:26:55,397",
    "start_sec": 1614.637,
    "end_sec": 1615.397,
    "zh": "不准锁定",
    "vi": "Chưa được khóa mục tiêu."
  },
  {
    "idx": 1199,
    "start": "00:26:55,397",
    "end": "00:26:56,617",
    "start_sec": 1615.397,
    "end_sec": 1616.617,
    "zh": "他用望远镜叫声",
    "vi": "Cậu ta nhìn qua ống nhòm rồi nói."
  },
  {
    "idx": 1200,
    "start": "00:26:56,617",
    "end": "00:26:56,957",
    "start_sec": 1616.617,
    "end_sec": 1616.957,
    "zh": "那么",
    "vi": "Vậy thì."
  },
  {
    "idx": 1201,
    "start": "00:26:56,957",
    "end": "00:26:58,477",
    "start_sec": 1616.957,
    "end_sec": 1618.477,
    "zh": "我把手放在发射按钮上",
    "vi": "Tôi đặt tay lên nút phóng"
  },
  {
    "idx": 1202,
    "start": "00:26:58,477",
    "end": "00:26:59,357",
    "start_sec": 1618.477,
    "end_sec": 1619.357,
    "zh": "送他们上路",
    "vi": "Tiễn họ lên đường"
  },
  {
    "idx": 1203,
    "start": "00:26:59,357",
    "end": "00:27:00,237",
    "start_sec": 1619.357,
    "end_sec": 1620.237,
    "zh": "我猛地按下",
    "vi": "Tôi ấn mạnh"
  },
  {
    "idx": 1204,
    "start": "00:27:00,237",
    "end": "00:27:01,057",
    "start_sec": 1620.237,
    "end_sec": 1621.057,
    "zh": "没有声音",
    "vi": "Không một tiếng động"
  },
  {
    "idx": 1205,
    "start": "00:27:01,057",
    "end": "00:27:01,717",
    "start_sec": 1621.057,
    "end_sec": 1621.717,
    "zh": "没有火光",
    "vi": "Không một ánh lửa"
  },
  {
    "idx": 1206,
    "start": "00:27:01,717",
    "end": "00:27:03,737",
    "start_sec": 1621.717,
    "end_sec": 1623.737,
    "zh": "一道看不见的能量波扩散开来",
    "vi": "Một làn sóng năng lượng vô hình lan tỏa"
  },
  {
    "idx": 1207,
    "start": "00:27:03,737",
    "end": "00:27:04,417",
    "start_sec": 1623.737,
    "end_sec": 1624.417,
    "zh": "下一秒",
    "vi": "Giây tiếp theo"
  },
  {
    "idx": 1208,
    "start": "00:27:04,417",
    "end": "00:27:05,757",
    "start_sec": 1624.417,
    "end_sec": 1625.757,
    "zh": "春火之灵会点中心",
    "vi": "Linh hồn của Xuân Hỏa sẽ bùng cháy"
  },
  {
    "idx": 1209,
    "start": "00:27:05,757",
    "end": "00:27:07,037",
    "start_sec": 1625.757,
    "end_sec": 1627.037,
    "zh": "所有灯光炸灭",
    "vi": "Tất cả đèn đóm vụt tắt"
  },
  {
    "idx": 1210,
    "start": "00:27:07,037",
    "end": "00:27:08,457",
    "start_sec": 1627.037,
    "end_sec": 1628.457,
    "zh": "高压电网的火花也没了",
    "vi": "Những tia lửa từ lưới điện cao thế cũng biến mất"
  },
  {
    "idx": 1211,
    "start": "00:27:08,457",
    "end": "00:27:10,217",
    "start_sec": 1628.457,
    "end_sec": 1630.217,
    "zh": "整个基地陷入紫气和黑暗",
    "vi": "Toàn bộ căn cứ chìm trong tử khí và bóng tối"
  },
  {
    "idx": 1212,
    "start": "00:27:10,217",
    "end": "00:27:10,917",
    "start_sec": 1630.217,
    "end_sec": 1630.917,
    "zh": "最后",
    "vi": "Cuối cùng"
  },
  {
    "idx": 1213,
    "start": "00:27:10,917",
    "end": "00:27:12,877",
    "start_sec": 1630.917,
    "end_sec": 1632.877,
    "zh": "黑暗里只剩下尖叫和枪声",
    "vi": "Trong bóng tối chỉ còn tiếng hét và tiếng súng"
  },
  {
    "idx": 1214,
    "start": "00:27:15,437",
    "end": "00:27:16,277",
    "start_sec": 1635.437,
    "end_sec": 1636.277,
    "zh": "矛盾和恐慌",
    "vi": "Mâu thuẫn và hoảng loạn"
  },
  {
    "idx": 1215,
    "start": "00:27:16,277",
    "end": "00:27:17,997",
    "start_sec": 1636.277,
    "end_sec": 1637.997,
    "zh": "周围被枪声引来的活尸",
    "vi": "Những xác sống bị tiếng súng thu hút"
  },
  {
    "idx": 1216,
    "start": "00:27:17,997",
    "end": "00:27:18,937",
    "start_sec": 1637.997,
    "end_sec": 1638.937,
    "zh": "像逃水一样",
    "vi": "Như nước lũ tràn về"
  },
  {
    "idx": 1217,
    "start": "00:27:18,937",
    "end": "00:27:20,397",
    "start_sec": 1638.937,
    "end_sec": 1640.397,
    "zh": "用像失去电网的会展登场",
    "vi": "Xuất hiện như những người mất điện"
  },
  {
    "idx": 1218,
    "start": "00:27:20,397",
    "end": "00:27:21,797",
    "start_sec": 1640.397,
    "end_sec": 1641.797,
    "zh": "走 去收脖子了",
    "vi": "Đi thôi, đi thu dọn cổ rồi"
  },
  {
    "idx": 1219,
    "start": "00:27:21,797",
    "end": "00:27:22,457",
    "start_sec": 1641.797,
    "end_sec": 1642.457,
    "zh": "我带着他",
    "vi": "Tôi dẫn anh ấy"
  },
  {
    "idx": 1220,
    "start": "00:27:22,457",
    "end": "00:27:23,837",
    "start_sec": 1642.457,
    "end_sec": 1643.837,
    "zh": "冲向那片人间地狱",
    "vi": "Lao vào địa ngục trần gian đó"
  },
  {
    "idx": 1221,
    "start": "00:27:23,837",
    "end": "00:27:24,597",
    "start_sec": 1643.837,
    "end_sec": 1644.597,
    "zh": "我们在混乱中",
    "vi": "Giữa sự hỗn loạn"
  },
  {
    "idx": 1222,
    "start": "00:27:24,597",
    "end": "00:27:26,157",
    "start_sec": 1644.597,
    "end_sec": 1646.157,
    "zh": "轻易找到了他们的物资仓库",
    "vi": "Chúng tôi dễ dàng tìm thấy kho vật tư của họ"
  },
  {
    "idx": 1223,
    "start": "00:27:26,157",
    "end": "00:27:28,577",
    "start_sec": 1646.157,
    "end_sec": 1648.577,
    "zh": "粮食 药品 武器 燃油",
    "vi": "Lương thực, thuốc men, vũ khí, nhiên liệu"
  },
  {
    "idx": 1224,
    "start": "00:27:28,577",
    "end": "00:27:29,797",
    "start_sec": 1648.577,
    "end_sec": 1649.797,
    "zh": "堆得像山一样",
    "vi": "Chất cao như núi"
  },
  {
    "idx": 1225,
    "start": "00:27:29,797",
    "end": "00:27:31,197",
    "start_sec": 1649.797,
    "end_sec": 1651.197,
    "zh": "甚至还有一个小军火库",
    "vi": "Thậm chí còn có một kho vũ khí nhỏ"
  },
  {
    "idx": 1226,
    "start": "00:27:31,197",
    "end": "00:27:32,557",
    "start_sec": 1651.197,
    "end_sec": 1652.557,
    "zh": "有十几把自动步枪",
    "vi": "Có mười mấy khẩu súng trường tự động"
  },
  {
    "idx": 1227,
    "start": "00:27:32,557",
    "end": "00:27:33,437",
    "start_sec": 1652.557,
    "end_sec": 1653.437,
    "zh": "和上门发子弹",
    "vi": "Và đạn dược phát tận nơi"
  },
  {
    "idx": 1228,
    "start": "00:27:33,437",
    "end": "00:27:34,197",
    "start_sec": 1653.437,
    "end_sec": 1654.197,
    "zh": "发财了",
    "vi": "Trúng mánh rồi"
  },
  {
    "idx": 1229,
    "start": "00:27:34,197",
    "end": "00:27:34,617",
    "start_sec": 1654.197,
    "end_sec": 1654.617,
    "zh": "主人",
    "vi": "Chủ nhân"
  },
  {
    "idx": 1230,
    "start": "00:27:34,617",
    "end": "00:27:36,377",
    "start_sec": 1654.617,
    "end_sec": 1656.377,
    "zh": "我们该考虑一下自己的事业了",
    "vi": "Chúng ta nên nghĩ về sự nghiệp của mình rồi"
  },
  {
    "idx": 1231,
    "start": "00:27:36,377",
    "end": "00:27:36,917",
    "start_sec": 1656.377,
    "end_sec": 1656.917,
    "zh": "我点点头",
    "vi": "Tôi gật đầu."
  },
  {
    "idx": 1232,
    "start": "00:27:36,917",
    "end": "00:27:37,797",
    "start_sec": 1656.917,
    "end_sec": 1657.797,
    "zh": "正准备打包",
    "vi": "Đang chuẩn bị thu dọn."
  },
  {
    "idx": 1233,
    "start": "00:27:37,797",
    "end": "00:27:38,357",
    "start_sec": 1657.797,
    "end_sec": 1658.357,
    "zh": "突然",
    "vi": "Bỗng nhiên."
  },
  {
    "idx": 1234,
    "start": "00:27:38,357",
    "end": "00:27:39,557",
    "start_sec": 1658.357,
    "end_sec": 1659.557,
    "zh": "仓库铁门慢慢打开",
    "vi": "Cửa sắt nhà kho từ từ mở ra."
  },
  {
    "idx": 1235,
    "start": "00:27:39,557",
    "end": "00:27:42,677",
    "start_sec": 1659.557,
    "end_sec": 1662.677,
    "zh": "一个穿白大褂的老头在几个士兵的保护下走了进来",
    "vi": "Một ông lão mặc áo blouse trắng bước vào dưới sự bảo vệ của vài binh lính."
  },
  {
    "idx": 1236,
    "start": "00:27:42,677",
    "end": "00:27:43,357",
    "start_sec": 1662.677,
    "end_sec": 1663.357,
    "zh": "他看着我们",
    "vi": "Ông ta nhìn chúng tôi."
  },
  {
    "idx": 1237,
    "start": "00:27:43,357",
    "end": "00:27:44,377",
    "start_sec": 1663.357,
    "end_sec": 1664.377,
    "zh": "脸上没有害怕",
    "vi": "Vẻ mặt không hề sợ hãi."
  },
  {
    "idx": 1238,
    "start": "00:27:44,377",
    "end": "00:27:45,237",
    "start_sec": 1664.377,
    "end_sec": 1665.237,
    "zh": "反而是新手",
    "vi": "Ngược lại còn tỏ ra phấn khích."
  },
  {
    "idx": 1239,
    "start": "00:27:45,237",
    "end": "00:27:46,817",
    "start_sec": 1665.237,
    "end_sec": 1666.817,
    "zh": "能量射线枪",
    "vi": "Súng bắn tia năng lượng."
  },
  {
    "idx": 1240,
    "start": "00:27:46,817",
    "end": "00:27:48,437",
    "start_sec": 1666.817,
    "end_sec": 1668.437,
    "zh": "电磁脉冲跑台",
    "vi": "Pháo đài xung điện từ."
  },
  {
    "idx": 1241,
    "start": "00:27:48,437",
    "end": "00:27:49,457",
    "start_sec": 1668.437,
    "end_sec": 1669.457,
    "zh": "年轻人",
    "vi": "Chàng trai trẻ."
  },
  {
    "idx": 1242,
    "start": "00:27:49,457",
    "end": "00:27:50,477",
    "start_sec": 1669.457,
    "end_sec": 1670.477,
    "zh": "你的能力",
    "vi": "Năng lực của cậu."
  },
  {
    "idx": 1243,
    "start": "00:27:50,477",
    "end": "00:27:52,237",
    "start_sec": 1670.477,
    "end_sec": 1672.237,
    "zh": "真是让我开了眼界",
    "vi": "Thật sự khiến tôi được mở mang tầm mắt."
  },
  {
    "idx": 1244,
    "start": "00:27:52,237",
    "end": "00:27:53,677",
    "start_sec": 1672.237,
    "end_sec": 1673.677,
    "zh": "我马上举枪对准他",
    "vi": "Tôi lập tức chĩa súng vào ông ta."
  },
  {
    "idx": 1245,
    "start": "00:27:53,677",
    "end": "00:27:54,537",
    "start_sec": 1673.677,
    "end_sec": 1674.537,
    "zh": "你是谁",
    "vi": "Ông là ai."
  },
  {
    "idx": 1246,
    "start": "00:27:54,537",
    "end": "00:27:56,837",
    "start_sec": 1674.537,
    "end_sec": 1676.837,
    "zh": "你可以叫我白教授",
    "vi": "Cậu có thể gọi tôi là Giáo sư Bạch."
  },
  {
    "idx": 1247,
    "start": "00:27:56,837",
    "end": "00:27:57,857",
    "start_sec": 1676.837,
    "end_sec": 1677.857,
    "zh": "他推了个眼镜",
    "vi": "Ông ta đẩy gọng kính."
  },
  {
    "idx": 1248,
    "start": "00:27:57,857",
    "end": "00:28:00,437",
    "start_sec": 1677.857,
    "end_sec": 1680.437,
    "zh": "我是这个基地的首席科学家",
    "vi": "Tôi là nhà khoa học trưởng của căn cứ này."
  },
  {
    "idx": 1249,
    "start": "00:28:00,437",
    "end": "00:28:01,037",
    "start_sec": 1680.437,
    "end_sec": 1681.037,
    "zh": "当然",
    "vi": "Tất nhiên."
  },
  {
    "idx": 1250,
    "start": "00:28:01,037",
    "end": "00:28:03,117",
    "start_sec": 1681.037,
    "end_sec": 1683.117,
    "zh": "现在他已经没了",
    "vi": "Bây giờ nó đã không còn nữa rồi."
  },
  {
    "idx": 1251,
    "start": "00:28:03,117",
    "end": "00:28:04,537",
    "start_sec": 1683.117,
    "end_sec": 1684.537,
    "zh": "你好像一点都不怕",
    "vi": "Trông ông có vẻ không sợ hãi chút nào."
  },
  {
    "idx": 1252,
    "start": "00:28:04,537",
    "end": "00:28:05,737",
    "start_sec": 1684.537,
    "end_sec": 1685.737,
    "zh": "为什么要怕",
    "vi": "Tại sao phải sợ chứ."
  },
  {
    "idx": 1253,
    "start": "00:28:05,737",
    "end": "00:28:06,517",
    "start_sec": 1685.737,
    "end_sec": 1686.517,
    "zh": "他直指我",
    "vi": "Ông ta chỉ thẳng vào tôi."
  },
  {
    "idx": 1254,
    "start": "00:28:06,517",
    "end": "00:28:07,777",
    "start_sec": 1686.517,
    "end_sec": 1687.777,
    "zh": "又直指我身边的他",
    "vi": "Rồi lại chỉ thẳng vào người bên cạnh tôi."
  },
  {
    "idx": 1255,
    "start": "00:28:07,777",
    "end": "00:28:10,717",
    "start_sec": 1687.777,
    "end_sec": 1690.717,
    "zh": "你们是我见过最完美的进化方向",
    "vi": "Các cậu là hướng tiến hóa hoàn hảo nhất mà tôi từng thấy."
  },
  {
    "idx": 1256,
    "start": "00:28:10,717",
    "end": "00:28:12,377",
    "start_sec": 1690.717,
    "end_sec": 1692.377,
    "zh": "一个是公智的旗帜",
    "vi": "Một người là biểu tượng của trí tuệ."
  },
  {
    "idx": 1257,
    "start": "00:28:12,377",
    "end": "00:28:14,357",
    "start_sec": 1692.377,
    "end_sec": 1694.357,
    "zh": "一个是融合的未来",
    "vi": "Một người là tương lai của sự dung hợp."
  },
  {
    "idx": 1258,
    "start": "00:28:14,357",
    "end": "00:28:16,297",
    "start_sec": 1694.357,
    "end_sec": 1696.297,
    "zh": "他神行狂热张开双臂",
    "vi": "Nét mặt ông ta cuồng nhiệt, dang rộng hai tay."
  },
  {
    "idx": 1259,
    "start": "00:28:16,297",
    "end": "00:28:17,217",
    "start_sec": 1696.297,
    "end_sec": 1697.217,
    "zh": "加入我吧",
    "vi": "Hãy gia nhập với tôi đi."
  },
  {
    "idx": 1260,
    "start": "00:28:17,217",
    "end": "00:28:18,077",
    "start_sec": 1697.217,
    "end_sec": 1698.077,
    "zh": "年轻人",
    "vi": "Chàng trai trẻ."
  },
  {
    "idx": 1261,
    "start": "00:28:18,077",
    "end": "00:28:20,277",
    "start_sec": 1698.077,
    "end_sec": 1700.277,
    "zh": "我能给你最好的实验室",
    "vi": "Tôi có thể cho bạn phòng thí nghiệm tốt nhất"
  },
  {
    "idx": 1262,
    "start": "00:28:20,277",
    "end": "00:28:21,577",
    "start_sec": 1700.277,
    "end_sec": 1701.577,
    "zh": "最多的资源",
    "vi": "và nhiều tài nguyên nhất"
  },
  {
    "idx": 1263,
    "start": "00:28:21,577",
    "end": "00:28:23,897",
    "start_sec": 1701.577,
    "end_sec": 1703.897,
    "zh": "让你随便用你的能力",
    "vi": "để bạn tùy ý sử dụng năng lực của mình"
  },
  {
    "idx": 1264,
    "start": "00:28:23,897",
    "end": "00:28:24,577",
    "start_sec": 1703.897,
    "end_sec": 1704.577,
    "zh": "你想想",
    "vi": "Hãy nghĩ xem"
  },
  {
    "idx": 1265,
    "start": "00:28:24,577",
    "end": "00:28:27,297",
    "start_sec": 1704.577,
    "end_sec": 1707.297,
    "zh": "我们可以批量造出最完美的士兵",
    "vi": "chúng ta có thể tạo ra những người lính hoàn hảo nhất hàng loạt"
  },
  {
    "idx": 1266,
    "start": "00:28:27,297",
    "end": "00:28:29,957",
    "start_sec": 1707.297,
    "end_sec": 1709.957,
    "zh": "不再有衰老和死亡",
    "vi": "không còn lão hóa và tử vong"
  },
  {
    "idx": 1267,
    "start": "00:28:29,957",
    "end": "00:28:32,737",
    "start_sec": 1709.957,
    "end_sec": 1712.737,
    "zh": "我们将成为新世界的神",
    "vi": "Chúng ta sẽ trở thành thần của thế giới mới"
  },
  {
    "idx": 1268,
    "start": "00:28:32,737",
    "end": "00:28:34,857",
    "start_sec": 1712.737,
    "end_sec": 1714.857,
    "zh": "我看着他身后那几个面无表情的士兵",
    "vi": "Tôi nhìn những người lính vô cảm phía sau ông ta"
  },
  {
    "idx": 1269,
    "start": "00:28:34,857",
    "end": "00:28:36,097",
    "start_sec": 1714.857,
    "end_sec": 1716.097,
    "zh": "他们皮肤发白",
    "vi": "da họ trắng bệch"
  },
  {
    "idx": 1270,
    "start": "00:28:36,097",
    "end": "00:28:36,897",
    "start_sec": 1716.097,
    "end_sec": 1716.897,
    "zh": "带着死气",
    "vi": "mang theo khí tức của cái chết"
  },
  {
    "idx": 1271,
    "start": "00:28:36,897",
    "end": "00:28:37,657",
    "start_sec": 1716.897,
    "end_sec": 1717.657,
    "zh": "不是活人",
    "vi": "không phải người sống"
  },
  {
    "idx": 1272,
    "start": "00:28:37,657",
    "end": "00:28:38,537",
    "start_sec": 1717.657,
    "end_sec": 1718.537,
    "zh": "改造人",
    "vi": "là người máy"
  },
  {
    "idx": 1273,
    "start": "00:28:38,537",
    "end": "00:28:42,037",
    "start_sec": 1718.537,
    "end_sec": 1722.037,
    "zh": "由人为尸体和机械零件合成的生物兵器",
    "vi": "những vũ khí sinh học được tổng hợp từ xác chết và bộ phận máy móc"
  },
  {
    "idx": 1274,
    "start": "00:28:42,037",
    "end": "00:28:44,197",
    "start_sec": 1722.037,
    "end_sec": 1724.197,
    "zh": "脑子里跳出的信息让我头皮发麻",
    "vi": "Thông tin hiện lên trong đầu khiến tôi rùng mình"
  },
  {
    "idx": 1275,
    "start": "00:28:44,197",
    "end": "00:28:46,637",
    "start_sec": 1724.197,
    "end_sec": 1726.637,
    "zh": "这个白教授是个比我还疯的疯子",
    "vi": "Giáo sư Bạch này còn điên hơn cả tôi"
  },
  {
    "idx": 1276,
    "start": "00:28:46,637",
    "end": "00:28:48,537",
    "start_sec": 1726.637,
    "end_sec": 1728.537,
    "zh": "你在新世界里还有人的位置吗",
    "vi": "Trong thế giới mới, liệu con người có còn chỗ đứng không"
  },
  {
    "idx": 1277,
    "start": "00:28:48,537",
    "end": "00:28:49,117",
    "start_sec": 1728.537,
    "end_sec": 1729.117,
    "zh": "我冷冷问",
    "vi": "Tôi lạnh lùng hỏi"
  },
  {
    "idx": 1278,
    "start": "00:28:49,117",
    "end": "00:28:50,337",
    "start_sec": 1729.117,
    "end_sec": 1730.337,
    "zh": "白教授大笑起来",
    "vi": "Giáo sư Bạch bật cười lớn"
  },
  {
    "idx": 1279,
    "start": "00:28:50,337",
    "end": "00:28:50,777",
    "start_sec": 1730.337,
    "end_sec": 1730.777,
    "zh": "人",
    "vi": "Con người"
  },
  {
    "idx": 1280,
    "start": "00:28:50,777",
    "end": "00:28:51,617",
    "start_sec": 1730.777,
    "end_sec": 1731.617,
    "zh": "催着",
    "vi": "thúc đẩy"
  },
  {
    "idx": 1281,
    "start": "00:28:51,617",
    "end": "00:28:54,277",
    "start_sec": 1731.617,
    "end_sec": 1734.277,
    "zh": "愚蠢充满了没用的感情",
    "vi": "sự ngu xuẩn và đầy cảm xúc vô dụng"
  },
  {
    "idx": 1282,
    "start": "00:28:54,277",
    "end": "00:28:55,837",
    "start_sec": 1734.277,
    "end_sec": 1735.837,
    "zh": "他们是世界的病毒",
    "vi": "Họ là virus của thế giới"
  },
  {
    "idx": 1283,
    "start": "00:28:55,837",
    "end": "00:28:57,677",
    "start_sec": 1735.837,
    "end_sec": 1737.677,
    "zh": "是进化的半小时",
    "vi": "là bước tiến hóa bị trì hoãn"
  },
  {
    "idx": 1284,
    "start": "00:28:57,677",
    "end": "00:29:00,837",
    "start_sec": 1737.677,
    "end_sec": 1740.837,
    "zh": "只配当新世界的地基和奖料",
    "vi": "chỉ xứng đáng làm nền móng và thức ăn cho thế giới mới"
  },
  {
    "idx": 1285,
    "start": "00:29:00,837",
    "end": "00:29:02,417",
    "start_sec": 1740.837,
    "end_sec": 1742.417,
    "zh": "他指着身后的改造人",
    "vi": "Ông ta chỉ vào những người máy phía sau"
  },
  {
    "idx": 1286,
    "start": "00:29:02,417",
    "end": "00:29:04,337",
    "start_sec": 1742.417,
    "end_sec": 1744.337,
    "zh": "眼里是父亲看儿子一样的慈爱",
    "vi": "trong mắt ông ta là tình yêu thương của người cha dành cho con trai"
  },
  {
    "idx": 1287,
    "start": "00:29:04,337",
    "end": "00:29:05,617",
    "start_sec": 1744.337,
    "end_sec": 1745.617,
    "zh": "看到他们了",
    "vi": "Tôi thấy họ rồi"
  },
  {
    "idx": 1288,
    "start": "00:29:05,617",
    "end": "00:29:06,717",
    "start_sec": 1745.617,
    "end_sec": 1746.717,
    "zh": "没有恐惧",
    "vi": "Không sợ hãi"
  },
  {
    "idx": 1289,
    "start": "00:29:06,717",
    "end": "00:29:07,957",
    "start_sec": 1746.717,
    "end_sec": 1747.957,
    "zh": "没有欲望",
    "vi": "Không ham muốn"
  },
  {
    "idx": 1290,
    "start": "00:29:07,957",
    "end": "00:29:09,277",
    "start_sec": 1747.957,
    "end_sec": 1749.277,
    "zh": "绝对服从",
    "vi": "Tuyệt đối phục tùng"
  },
  {
    "idx": 1291,
    "start": "00:29:09,277",
    "end": "00:29:10,477",
    "start_sec": 1749.277,
    "end_sec": 1750.477,
    "zh": "永不背叛",
    "vi": "Không bao giờ phản bội."
  },
  {
    "idx": 1292,
    "start": "00:29:10,477",
    "end": "00:29:12,457",
    "start_sec": 1750.477,
    "end_sec": 1752.457,
    "zh": "这才是完美的造物",
    "vi": "Đó mới là tạo vật hoàn hảo."
  },
  {
    "idx": 1293,
    "start": "00:29:12,457",
    "end": "00:29:14,137",
    "start_sec": 1752.457,
    "end_sec": 1754.137,
    "zh": "你的小法从根受之处了",
    "vi": "Cách làm của bạn đã sai từ gốc rồi."
  },
  {
    "idx": 1294,
    "start": "00:29:14,137",
    "end": "00:29:15,657",
    "start_sec": 1754.137,
    "end_sec": 1755.657,
    "zh": "一直沉默的他突然开口",
    "vi": "Người vẫn luôn im lặng bỗng lên tiếng."
  },
  {
    "idx": 1295,
    "start": "00:29:15,657",
    "end": "00:29:17,197",
    "start_sec": 1755.657,
    "end_sec": 1757.197,
    "zh": "一个完全细胶意外的系统",
    "vi": "Một hệ thống không thể xử lý bất ngờ."
  },
  {
    "idx": 1296,
    "start": "00:29:17,197",
    "end": "00:29:18,017",
    "start_sec": 1757.197,
    "end_sec": 1758.017,
    "zh": "是脆弱的",
    "vi": "Thì rất mong manh."
  },
  {
    "idx": 1297,
    "start": "00:29:18,017",
    "end": "00:29:18,857",
    "start_sec": 1758.017,
    "end_sec": 1758.857,
    "zh": "你的完美",
    "vi": "Sự hoàn hảo của bạn."
  },
  {
    "idx": 1298,
    "start": "00:29:18,857",
    "end": "00:29:19,937",
    "start_sec": 1758.857,
    "end_sec": 1759.937,
    "zh": "只是个死循环",
    "vi": "Chỉ là một vòng lặp chết."
  },
  {
    "idx": 1299,
    "start": "00:29:19,937",
    "end": "00:29:21,357",
    "start_sec": 1759.937,
    "end_sec": 1761.357,
    "zh": "应付不了任何新状况",
    "vi": "Không đối phó được với tình huống mới."
  },
  {
    "idx": 1300,
    "start": "00:29:21,357",
    "end": "00:29:22,357",
    "start_sec": 1761.357,
    "end_sec": 1762.357,
    "zh": "白教授来了兴趣",
    "vi": "Giáo sư Bạch thấy hứng thú."
  },
  {
    "idx": 1301,
    "start": "00:29:22,357",
    "end": "00:29:22,957",
    "start_sec": 1762.357,
    "end_sec": 1762.957,
    "zh": "看着他",
    "vi": "Nhìn anh ta."
  },
  {
    "idx": 1302,
    "start": "00:29:22,957",
    "end": "00:29:24,617",
    "start_sec": 1762.957,
    "end_sec": 1764.617,
    "zh": "有意思的观点",
    "vi": "Một quan điểm thú vị đấy."
  },
  {
    "idx": 1303,
    "start": "00:29:24,617",
    "end": "00:29:25,457",
    "start_sec": 1764.617,
    "end_sec": 1765.457,
    "zh": "狗的脑子",
    "vi": "Não của chó."
  },
  {
    "idx": 1304,
    "start": "00:29:25,457",
    "end": "00:29:26,337",
    "start_sec": 1765.457,
    "end_sec": 1766.337,
    "zh": "人的身体",
    "vi": "Thân xác của người."
  },
  {
    "idx": 1305,
    "start": "00:29:26,337",
    "end": "00:29:28,077",
    "start_sec": 1766.337,
    "end_sec": 1768.077,
    "zh": "还留着人性的渣滓",
    "vi": "Vẫn còn vương lại cặn bã nhân tính."
  },
  {
    "idx": 1306,
    "start": "00:29:28,077",
    "end": "00:29:30,297",
    "start_sec": 1768.077,
    "end_sec": 1770.297,
    "zh": "你本身就是个失败品",
    "vi": "Bản thân bạn chính là một sản phẩm thất bại."
  },
  {
    "idx": 1307,
    "start": "00:29:30,297",
    "end": "00:29:31,437",
    "start_sec": 1770.297,
    "end_sec": 1771.437,
    "zh": "人性不是渣滓",
    "vi": "Nhân tính không phải là cặn bã."
  },
  {
    "idx": 1308,
    "start": "00:29:31,437",
    "end": "00:29:32,977",
    "start_sec": 1771.437,
    "end_sec": 1772.977,
    "zh": "柳如燕的记忆告诉我",
    "vi": "Ký ức của Liễu Như Yến cho tôi biết."
  },
  {
    "idx": 1309,
    "start": "00:29:32,977",
    "end": "00:29:34,277",
    "start_sec": 1772.977,
    "end_sec": 1774.277,
    "zh": "人会因为一首歌流泪",
    "vi": "Con người có thể rơi lệ vì một bài hát."
  },
  {
    "idx": 1310,
    "start": "00:29:34,277",
    "end": "00:29:35,957",
    "start_sec": 1774.277,
    "end_sec": 1775.957,
    "zh": "光为了一个屁大的承诺去死",
    "vi": "Có thể chết vì một lời hứa cỏn con."
  },
  {
    "idx": 1311,
    "start": "00:29:35,957",
    "end": "00:29:37,557",
    "start_sec": 1775.957,
    "end_sec": 1777.557,
    "zh": "这些看着没用的感情",
    "vi": "Những cảm xúc tưởng chừng vô dụng này."
  },
  {
    "idx": 1312,
    "start": "00:29:37,557",
    "end": "00:29:39,237",
    "start_sec": 1777.557,
    "end_sec": 1779.237,
    "zh": "才是让人往前给的根本暴力",
    "vi": "Mới là động lực căn bản để con người tiến lên."
  },
  {
    "idx": 1313,
    "start": "00:29:39,237",
    "end": "00:29:40,137",
    "start_sec": 1779.237,
    "end_sec": 1780.137,
    "zh": "说得好",
    "vi": "Nói hay lắm."
  },
  {
    "idx": 1314,
    "start": "00:29:40,137",
    "end": "00:29:44,297",
    "start_sec": 1780.137,
    "end_sec": 1784.297,
    "zh": "但推动世界的是少数精英",
    "vi": "Nhưng người thúc đẩy thế giới là tầng lớp tinh anh."
  },
  {
    "idx": 1315,
    "start": "00:29:44,297",
    "end": "00:29:46,297",
    "start_sec": 1784.297,
    "end_sec": 1786.297,
    "zh": "我们就是精英",
    "vi": "Chúng ta chính là tinh anh."
  },
  {
    "idx": 1316,
    "start": "00:29:46,297",
    "end": "00:29:48,737",
    "start_sec": 1786.297,
    "end_sec": 1788.737,
    "zh": "其他人只需要清化",
    "vi": "Những kẻ khác chỉ cần thanh lọc."
  },
  {
    "idx": 1317,
    "start": "00:29:48,737",
    "end": "00:29:52,317",
    "start_sec": 1788.737,
    "end_sec": 1792.317,
    "zh": "我的世界是秩序是永恒",
    "vi": "Thế giới của tôi là trật tự và vĩnh hằng."
  },
  {
    "idx": 1318,
    "start": "00:29:52,317",
    "end": "00:29:53,157",
    "start_sec": 1792.317,
    "end_sec": 1793.157,
    "zh": "你呢",
    "vi": "Còn bạn thì sao."
  },
  {
    "idx": 1319,
    "start": "00:29:53,157",
    "end": "00:29:53,877",
    "start_sec": 1793.157,
    "end_sec": 1793.877,
    "zh": "李重九",
    "vi": "Lý Trọng Cửu."
  },
  {
    "idx": 1320,
    "start": "00:29:53,877",
    "end": "00:29:55,169",
    "start_sec": 1793.877,
    "end_sec": 1795.169,
    "zh": "你想定什么规矩我的规矩很简单想活的人靠自己的手活下去强的保护弱的不是为了当老大而是因为他们也弱过我的世界里可以哭可以笑可以犯错",
    "vi": "Bạn muốn đặt ra quy tắc gì"
  },
  {
    "idx": 1320,
    "start": "00:29:55,169",
    "end": "00:29:56,461",
    "start_sec": 1795.169,
    "end_sec": 1796.461,
    "zh": "你想定什么规矩我的规矩很简单想活的人靠自己的手活下去强的保护弱的不是为了当老大而是因为他们也弱过我的世界里可以哭可以笑可以犯错",
    "vi": "Quy tắc của tôi rất đơn giản"
  },
  {
    "idx": 1320,
    "start": "00:29:56,461",
    "end": "00:29:58,675",
    "start_sec": 1796.461,
    "end_sec": 1798.675,
    "zh": "你想定什么规矩我的规矩很简单想活的人靠自己的手活下去强的保护弱的不是为了当老大而是因为他们也弱过我的世界里可以哭可以笑可以犯错",
    "vi": "Ai muốn sống thì hãy tự dùng đôi tay mình mà sống"
  },
  {
    "idx": 1320,
    "start": "00:29:58,675",
    "end": "00:30:01,997",
    "start_sec": 1798.675,
    "end_sec": 1801.997,
    "zh": "你想定什么规矩我的规矩很简单想活的人靠自己的手活下去强的保护弱的不是为了当老大而是因为他们也弱过我的世界里可以哭可以笑可以犯错",
    "vi": "Kẻ mạnh bảo vệ kẻ yếu không phải để làm chủ, mà vì họ cũng từng yếu đuối"
  },
  {
    "idx": 1320,
    "start": "00:30:01,997",
    "end": "00:30:05,134",
    "start_sec": 1801.997,
    "end_sec": 1805.134,
    "zh": "你想定什么规矩我的规矩很简单想活的人靠自己的手活下去强的保护弱的不是为了当老大而是因为他们也弱过我的世界里可以哭可以笑可以犯错",
    "vi": "Trong thế giới của tôi, có thể khóc, có thể cười và có thể phạm sai lầm"
  },
  {
    "idx": 1321,
    "start": "00:30:05,134",
    "end": "00:30:05,794",
    "start_sec": 1805.134,
    "end_sec": 1805.794,
    "zh": "也可以死",
    "vi": "Cũng có thể chết."
  },
  {
    "idx": 1322,
    "start": "00:30:05,794",
    "end": "00:30:06,714",
    "start_sec": 1805.794,
    "end_sec": 1806.714,
    "zh": "我不想当神",
    "vi": "Ta không muốn làm thần."
  },
  {
    "idx": 1323,
    "start": "00:30:06,714",
    "end": "00:30:08,534",
    "start_sec": 1806.714,
    "end_sec": 1808.534,
    "zh": "也不想造什么完美世界",
    "vi": "Cũng không muốn tạo ra thế giới hoàn mỹ nào cả."
  },
  {
    "idx": 1324,
    "start": "00:30:08,534",
    "end": "00:30:10,754",
    "start_sec": 1808.534,
    "end_sec": 1810.754,
    "zh": "我只想在这片烂地上圈一块地",
    "vi": "Ta chỉ muốn khoanh một mảnh đất trên vùng đất nát này."
  },
  {
    "idx": 1325,
    "start": "00:30:10,754",
    "end": "00:30:12,874",
    "start_sec": 1810.754,
    "end_sec": 1812.874,
    "zh": "让想当人的能活的像个人",
    "vi": "Để những ai muốn làm người có thể sống giống như một con người."
  },
  {
    "idx": 1326,
    "start": "00:30:12,874",
    "end": "00:30:15,074",
    "start_sec": 1812.874,
    "end_sec": 1815.074,
    "zh": "我看着白教授说出最后的结论",
    "vi": "Ta nhìn Giáo sư Bạch và đưa ra kết luận cuối cùng."
  },
  {
    "idx": 1327,
    "start": "00:30:15,074",
    "end": "00:30:16,554",
    "start_sec": 1815.074,
    "end_sec": 1816.554,
    "zh": "你的世界是座漂亮的坟墓",
    "vi": "Thế giới của ngươi là một ngôi mộ đẹp đẽ."
  },
  {
    "idx": 1328,
    "start": "00:30:16,554",
    "end": "00:30:18,914",
    "start_sec": 1816.554,
    "end_sec": 1818.914,
    "zh": "我的世界是片乱七八糟的太原",
    "vi": "Thế giới của ta là một vùng đất hoang lộn xộn."
  },
  {
    "idx": 1329,
    "start": "00:30:18,914",
    "end": "00:30:19,694",
    "start_sec": 1818.914,
    "end_sec": 1819.694,
    "zh": "道不同",
    "vi": "Đạo bất đồng."
  },
  {
    "idx": 1330,
    "start": "00:30:19,694",
    "end": "00:30:21,194",
    "start_sec": 1819.694,
    "end_sec": 1821.194,
    "zh": "那就太可惜了",
    "vi": "Vậy thì thật là đáng tiếc."
  },
  {
    "idx": 1331,
    "start": "00:30:21,194",
    "end": "00:30:23,094",
    "start_sec": 1821.194,
    "end_sec": 1823.094,
    "zh": "他身后一个改造人猛地向我冲来",
    "vi": "Một người cải tạo phía sau ông ta lao mạnh về phía ta."
  },
  {
    "idx": 1332,
    "start": "00:30:23,094",
    "end": "00:30:23,914",
    "start_sec": 1823.094,
    "end_sec": 1823.914,
    "zh": "快得不下话",
    "vi": "Nhanh đến mức không tưởng."
  },
  {
    "idx": 1333,
    "start": "00:30:23,914",
    "end": "00:30:24,754",
    "start_sec": 1823.914,
    "end_sec": 1824.754,
    "zh": "我扣下扳机",
    "vi": "Ta bóp cò."
  },
  {
    "idx": 1334,
    "start": "00:30:24,754",
    "end": "00:30:26,254",
    "start_sec": 1824.754,
    "end_sec": 1826.254,
    "zh": "子弹穿过他的眉心",
    "vi": "Viên đạn xuyên qua trán hắn."
  },
  {
    "idx": 1335,
    "start": "00:30:26,254",
    "end": "00:30:27,474",
    "start_sec": 1826.254,
    "end_sec": 1827.474,
    "zh": "我不喜欢沉落",
    "vi": "Ta không thích nói nhiều."
  },
  {
    "idx": 1336,
    "start": "00:30:27,474",
    "end": "00:30:28,654",
    "start_sec": 1827.474,
    "end_sec": 1828.654,
    "zh": "白教授倒了下去",
    "vi": "Giáo sư Bạch ngã gục xuống."
  },
  {
    "idx": 1337,
    "start": "00:30:28,654",
    "end": "00:30:31,214",
    "start_sec": 1828.654,
    "end_sec": 1831.214,
    "zh": "他身后的改造人眼里的红光闪了几下",
    "vi": "Ánh sáng đỏ trong mắt người cải tạo phía sau ông ta lóe lên vài cái."
  },
  {
    "idx": 1338,
    "start": "00:30:31,214",
    "end": "00:30:32,694",
    "start_sec": 1831.214,
    "end_sec": 1832.694,
    "zh": "系统问问将在原地",
    "vi": "Hệ thống đứng khựng lại tại chỗ."
  },
  {
    "idx": 1339,
    "start": "00:30:32,694",
    "end": "00:30:34,714",
    "start_sec": 1832.694,
    "end_sec": 1834.714,
    "zh": "我走到他尸体旁搜出一个笔记本",
    "vi": "Ta đi đến bên thi thể ông ta và lục ra một cuốn sổ tay."
  },
  {
    "idx": 1340,
    "start": "00:30:34,714",
    "end": "00:30:36,274",
    "start_sec": 1834.714,
    "end_sec": 1836.274,
    "zh": "他接过来快速翻看",
    "vi": "Cậu ấy nhận lấy và nhanh chóng lật xem."
  },
  {
    "idx": 1341,
    "start": "00:30:36,274",
    "end": "00:30:37,434",
    "start_sec": 1836.274,
    "end_sec": 1837.434,
    "zh": "脸色越来越沉",
    "vi": "Sắc mặt ngày càng trầm xuống."
  },
  {
    "idx": 1342,
    "start": "00:30:37,434",
    "end": "00:30:37,974",
    "start_sec": 1837.434,
    "end_sec": 1837.974,
    "zh": "主人",
    "vi": "Chủ nhân."
  },
  {
    "idx": 1343,
    "start": "00:30:37,974",
    "end": "00:30:39,374",
    "start_sec": 1837.974,
    "end_sec": 1839.374,
    "zh": "情况比我们想的要复杂",
    "vi": "Tình hình phức tạp hơn chúng ta nghĩ."
  },
  {
    "idx": 1344,
    "start": "00:30:39,374",
    "end": "00:30:40,174",
    "start_sec": 1839.374,
    "end_sec": 1840.174,
    "zh": "本子里说",
    "vi": "Trong cuốn sổ nói rằng."
  },
  {
    "idx": 1345,
    "start": "00:30:40,174",
    "end": "00:30:43,254",
    "start_sec": 1840.174,
    "end_sec": 1843.254,
    "zh": "白教授只是一个叫方舟计划的第三阶段负责人",
    "vi": "Giáo sư Bạch chỉ là người phụ trách giai đoạn ba của một dự án mang tên Kế hoạch Ark."
  },
  {
    "idx": 1346,
    "start": "00:30:43,254",
    "end": "00:30:44,994",
    "start_sec": 1843.254,
    "end_sec": 1844.994,
    "zh": "他的任务是测试计划方案",
    "vi": "Nhiệm vụ của ông ta là thử nghiệm phương án kế hoạch."
  },
  {
    "idx": 1347,
    "start": "00:30:44,994",
    "end": "00:30:46,594",
    "start_sec": 1844.994,
    "end_sec": 1846.594,
    "zh": "并找到像你一样的特异样本",
    "vi": "Và tìm kiếm mẫu vật đặc biệt giống như chủ nhân."
  },
  {
    "idx": 1348,
    "start": "00:30:46,594",
    "end": "00:30:47,614",
    "start_sec": 1846.594,
    "end_sec": 1847.614,
    "zh": "这还有一张地图",
    "vi": "Ở đây còn có một bản đồ."
  },
  {
    "idx": 1349,
    "start": "00:30:47,614",
    "end": "00:30:48,434",
    "start_sec": 1847.614,
    "end_sec": 1848.434,
    "zh": "他指着一眼",
    "vi": "Cậu ấy chỉ vào một chỗ."
  },
  {
    "idx": 1350,
    "start": "00:30:48,434",
    "end": "00:30:50,334",
    "start_sec": 1848.434,
    "end_sec": 1850.334,
    "zh": "上面标了一个叫伊甸园的地方",
    "vi": "Trên đó có đánh dấu một nơi gọi là Vườn Địa Đàng."
  },
  {
    "idx": 1351,
    "start": "00:30:50,334",
    "end": "00:30:52,174",
    "start_sec": 1850.334,
    "end_sec": 1852.174,
    "zh": "背注是方舟计划最终阶段",
    "vi": "Chú thích ghi đó là giai đoạn cuối cùng của kế hoạch Phương Chu."
  },
  {
    "idx": 1352,
    "start": "00:30:52,174",
    "end": "00:30:53,654",
    "start_sec": 1852.174,
    "end_sec": 1853.654,
    "zh": "他还提到了其他的样本",
    "vi": "Cậu ấy còn nhắc đến những mẫu vật khác."
  },
  {
    "idx": 1353,
    "start": "00:30:53,654",
    "end": "00:30:54,754",
    "start_sec": 1853.654,
    "end_sec": 1854.754,
    "zh": "在不同的城市",
    "vi": "Ở các thành phố khác nhau."
  },
  {
    "idx": 1354,
    "start": "00:30:54,754",
    "end": "00:30:55,754",
    "start_sec": 1854.754,
    "end_sec": 1855.754,
    "zh": "代号清起来过",
    "vi": "Mật danh nghe rất kỳ lạ."
  },
  {
    "idx": 1355,
    "start": "00:30:55,754",
    "end": "00:30:56,594",
    "start_sec": 1855.754,
    "end_sec": 1856.594,
    "zh": "我接过笔记本",
    "vi": "Tôi nhận lấy cuốn sổ tay."
  },
  {
    "idx": 1356,
    "start": "00:30:56,594",
    "end": "00:30:57,954",
    "start_sec": 1856.594,
    "end_sec": 1857.954,
    "zh": "看着那张复杂的地图",
    "vi": "Nhìn vào tấm bản đồ phức tạp đó."
  },
  {
    "idx": 1357,
    "start": "00:30:57,954",
    "end": "00:30:58,894",
    "start_sec": 1857.954,
    "end_sec": 1858.894,
    "zh": "和那些诡异的代号",
    "vi": "Và những mật danh kỳ quái kia."
  },
  {
    "idx": 1358,
    "start": "00:30:58,894",
    "end": "00:30:59,974",
    "start_sec": 1858.894,
    "end_sec": 1859.974,
    "zh": "白教授死了",
    "vi": "Giáo sư Bạch đã chết."
  },
  {
    "idx": 1359,
    "start": "00:30:59,974",
    "end": "00:31:00,914",
    "start_sec": 1859.974,
    "end_sec": 1860.914,
    "zh": "但事情没完",
    "vi": "Nhưng mọi chuyện vẫn chưa kết thúc."
  },
  {
    "idx": 1360,
    "start": "00:31:00,914",
    "end": "00:31:02,734",
    "start_sec": 1860.914,
    "end_sec": 1862.734,
    "zh": "我们好像捅了个更大的窟窿",
    "vi": "Chúng tôi dường như đã gây ra một rắc rối lớn hơn rồi."
  },
  {
    "idx": 1361,
    "start": "00:31:02,734",
    "end": "00:31:03,334",
    "start_sec": 1862.734,
    "end_sec": 1863.334,
    "zh": "主人",
    "vi": "Chủ nhân."
  },
  {
    "idx": 1362,
    "start": "00:31:03,334",
    "end": "00:31:04,074",
    "start_sec": 1863.334,
    "end_sec": 1864.074,
    "zh": "他抬起头",
    "vi": "Cậu ấy ngẩng đầu lên."
  },
  {
    "idx": 1363,
    "start": "00:31:04,074",
    "end": "00:31:05,154",
    "start_sec": 1864.074,
    "end_sec": 1865.154,
    "zh": "眼里既有狗声",
    "vi": "Trong mắt đầy vẻ sợ hãi."
  },
  {
    "idx": 1364,
    "start": "00:31:05,154",
    "end": "00:31:09,574",
    "start_sec": 1865.154,
    "end_sec": 1869.574,
    "zh": "我 我是橙子皮",
    "vi": "Tôi, tôi là Trần Tử Bì."
  },
  {
    "idx": 1365,
    "start": "00:31:09,574",
    "end": "00:31:10,654",
    "start_sec": 1869.574,
    "end_sec": 1870.654,
    "zh": "我 就是你",
    "vi": "Tôi chính là bạn."
  },
  {
    "idx": 1366,
    "start": "00:31:10,654",
    "end": "00:31:11,834",
    "start_sec": 1870.654,
    "end_sec": 1871.834,
    "zh": "如果一个月后",
    "vi": "Nếu một tháng sau."
  },
  {
    "idx": 1367,
    "start": "00:31:11,834",
    "end": "00:31:12,654",
    "start_sec": 1871.834,
    "end_sec": 1872.654,
    "zh": "你还想活着",
    "vi": "Bạn vẫn muốn sống sót."
  },
  {
    "idx": 1368,
    "start": "00:31:12,654",
    "end": "00:31:13,394",
    "start_sec": 1872.654,
    "end_sec": 1873.394,
    "zh": "务必听我的",
    "vi": "Thì nhất định phải nghe tôi."
  },
  {
    "idx": 1369,
    "start": "00:31:13,394",
    "end": "00:31:15,474",
    "start_sec": 1873.394,
    "end_sec": 1875.474,
    "zh": "立马搬到楼下101房间",
    "vi": "Lập tức chuyển xuống phòng 101 ở tầng dưới."
  },
  {
    "idx": 1370,
    "start": "00:31:15,474",
    "end": "00:31:17,314",
    "start_sec": 1875.474,
    "end_sec": 1877.314,
    "zh": "超级火灭降临",
    "vi": "Siêu trăng đỏ xuất hiện."
  },
  {
    "idx": 1371,
    "start": "00:31:17,314",
    "end": "00:31:18,174",
    "start_sec": 1877.314,
    "end_sec": 1878.174,
    "zh": "专家称",
    "vi": "Các chuyên gia cho biết."
  },
  {
    "idx": 1372,
    "start": "00:31:18,174",
    "end": "00:31:21,034",
    "start_sec": 1878.174,
    "end_sec": 1881.034,
    "zh": "这可能是万年难得一遇的天魂机关",
    "vi": "Đây có thể là hiện tượng thiên văn kỳ thú vạn năm mới có một lần."
  },
  {
    "idx": 1373,
    "start": "00:31:21,034",
    "end": "00:31:21,894",
    "start_sec": 1881.034,
    "end_sec": 1881.894,
    "zh": "据悉",
    "vi": "Được biết."
  },
  {
    "idx": 1374,
    "start": "00:31:21,894",
    "end": "00:31:23,854",
    "start_sec": 1881.894,
    "end_sec": 1883.854,
    "zh": "神约将持续很长时间",
    "vi": "Trăng đỏ sẽ kéo dài trong một thời gian dài."
  },
  {
    "idx": 1375,
    "start": "00:31:23,854",
    "end": "00:31:25,254",
    "start_sec": 1883.854,
    "end_sec": 1885.254,
    "zh": "幻觉神约的行为",
    "vi": "Những lời đồn đại về trăng đỏ."
  },
  {
    "idx": 1376,
    "start": "00:31:25,254",
    "end": "00:31:26,694",
    "start_sec": 1885.254,
    "end_sec": 1886.694,
    "zh": "有人猜测",
    "vi": "Có người suy đoán."
  },
  {
    "idx": 1377,
    "start": "00:31:26,694",
    "end": "00:31:27,994",
    "start_sec": 1886.694,
    "end_sec": 1887.994,
    "zh": "不愿意被轰炸",
    "vi": "Không muốn bị ném bom."
  },
  {
    "idx": 1378,
    "start": "00:31:27,994",
    "end": "00:31:30,554",
    "start_sec": 1887.994,
    "end_sec": 1890.554,
    "zh": "草",
    "vi": "Khốn kiếp."
  },
  {
    "idx": 1379,
    "start": "00:31:30,554",
    "end": "00:31:31,634",
    "start_sec": 1890.554,
    "end_sec": 1891.634,
    "zh": "又输了",
    "vi": "Lại thua rồi."
  },
  {
    "idx": 1380,
    "start": "00:31:31,634",
    "end": "00:31:32,314",
    "start_sec": 1891.634,
    "end_sec": 1892.314,
    "zh": "妈的",
    "vi": "Mẹ kiếp."
  },
  {
    "idx": 1381,
    "start": "00:31:32,314",
    "end": "00:31:33,534",
    "start_sec": 1892.314,
    "end_sec": 1893.534,
    "zh": "三打一还被反杀",
    "vi": "Ba đánh một mà còn bị giết ngược."
  },
  {
    "idx": 1382,
    "start": "00:31:33,534",
    "end": "00:31:34,334",
    "start_sec": 1893.534,
    "end_sec": 1894.334,
    "zh": "会不会完",
    "vi": "Có biết chơi không vậy."
  },
  {
    "idx": 1383,
    "start": "00:31:43,814",
    "end": "00:31:44,214",
    "start_sec": 1903.814,
    "end_sec": 1904.214,
    "zh": "草",
    "vi": "Vãi thật."
  },
  {
    "idx": 1384,
    "start": "00:31:44,214",
    "end": "00:31:46,154",
    "start_sec": 1904.214,
    "end_sec": 1906.154,
    "zh": "这杯子里的谁怎么跟血水一样",
    "vi": "Sao nước trong cái cốc này lại giống như máu thế này."
  },
  {
    "idx": 1385,
    "start": "00:31:46,154",
    "end": "00:31:48,294",
    "start_sec": 1906.154,
    "end_sec": 1908.294,
    "zh": "月亮怎么是红的",
    "vi": "Sao mặt trăng lại màu đỏ thế kia."
  },
  {
    "idx": 1386,
    "start": "00:31:48,294",
    "end": "00:31:49,554",
    "start_sec": 1908.294,
    "end_sec": 1909.554,
    "zh": "这是什么天文器官",
    "vi": "Đây là hiện tượng thiên văn gì thế."
  },
  {
    "idx": 1387,
    "start": "00:31:49,554",
    "end": "00:31:51,014",
    "start_sec": 1909.554,
    "end_sec": 1911.014,
    "zh": "怪神人的",
    "vi": "Trông đáng sợ thật đấy."
  },
  {
    "idx": 1388,
    "start": "00:31:51,014",
    "end": "00:31:54,474",
    "start_sec": 1911.014,
    "end_sec": 1914.474,
    "zh": "除了红的跟鞋似的",
    "vi": "Ngoài việc đỏ như máu ra."
  },
  {
    "idx": 1389,
    "start": "00:31:54,474",
    "end": "00:31:56,034",
    "start_sec": 1914.474,
    "end_sec": 1916.034,
    "zh": "好像里面什么稀奇的",
    "vi": "Hình như bên trong chẳng có gì lạ cả."
  },
  {
    "idx": 1390,
    "start": "00:31:56,034",
    "end": "00:31:59,054",
    "start_sec": 1916.034,
    "end_sec": 1919.054,
    "zh": "卧槽",
    "vi": "Vãi cả chưởng."
  },
  {
    "idx": 1391,
    "start": "00:31:59,054",
    "end": "00:31:59,934",
    "start_sec": 1919.054,
    "end_sec": 1919.934,
    "zh": "这大半夜的",
    "vi": "Đã nửa đêm thế này rồi."
  },
  {
    "idx": 1392,
    "start": "00:31:59,934",
    "end": "00:32:01,674",
    "start_sec": 1919.934,
    "end_sec": 1921.674,
    "zh": "谁这么强的啊",
    "vi": "Ai mà làm loạn thế không biết."
  },
  {
    "idx": 1393,
    "start": "00:32:01,674",
    "end": "00:32:02,474",
    "start_sec": 1921.674,
    "end_sec": 1922.474,
    "zh": "什么情况",
    "vi": "Có chuyện gì thế."
  },
  {
    "idx": 1394,
    "start": "00:32:02,474",
    "end": "00:32:03,734",
    "start_sec": 1922.474,
    "end_sec": 1923.734,
    "zh": "怎么会是一楼",
    "vi": "Sao lại là tầng một thế kia."
  },
  {
    "idx": 1395,
    "start": "00:32:03,734",
    "end": "00:32:05,134",
    "start_sec": 1923.734,
    "end_sec": 1925.134,
    "zh": "我记得那一层",
    "vi": "Tôi nhớ là tầng đó."
  },
  {
    "idx": 1396,
    "start": "00:32:05,134",
    "end": "00:32:06,254",
    "start_sec": 1925.134,
    "end_sec": 1926.254,
    "zh": "不是土过人吗",
    "vi": "Chẳng phải từng có người chết sao."
  },
  {
    "idx": 1397,
    "start": "00:32:06,254",
    "end": "00:32:06,874",
    "start_sec": 1926.254,
    "end_sec": 1926.874,
    "zh": "晦气得很",
    "vi": "Xui xẻo lắm."
  },
  {
    "idx": 1398,
    "start": "00:32:06,874",
    "end": "00:32:08,034",
    "start_sec": 1926.874,
    "end_sec": 1928.034,
    "zh": "都没人住的",
    "vi": "Làm gì có ai ở đâu."
  },
  {
    "idx": 1399,
    "start": "00:32:08,034",
    "end": "00:32:10,694",
    "start_sec": 1928.034,
    "end_sec": 1930.694,
    "zh": "他谁脑子有泡啊",
    "vi": "Ai mà ngốc thế không biết."
  },
  {
    "idx": 1400,
    "start": "00:32:10,694",
    "end": "00:32:10,994",
    "start_sec": 1930.694,
    "end_sec": 1930.994,
    "zh": "猪一楼",
    "vi": "Lại đi ở tầng một."
  },
  {
    "idx": 1401,
    "start": "00:32:10,994",
    "end": "00:32:11,514",
    "start_sec": 1930.994,
    "end_sec": 1931.514,
    "zh": "猪犯了",
    "vi": "Đã ở đó rồi."
  },
  {
    "idx": 1402,
    "start": "00:32:11,514",
    "end": "00:32:12,554",
    "start_sec": 1931.514,
    "end_sec": 1932.554,
    "zh": "还大半夜的点了花",
    "vi": "Lại còn đốt pháo hoa giữa nửa đêm."
  },
  {
    "idx": 1403,
    "start": "00:32:12,554",
    "end": "00:32:14,134",
    "start_sec": 1932.554,
    "end_sec": 1934.134,
    "zh": "算了",
    "vi": "Thôi bỏ đi."
  },
  {
    "idx": 1404,
    "start": "00:32:14,134",
    "end": "00:32:15,074",
    "start_sec": 1934.134,
    "end_sec": 1935.074,
    "zh": "可能猪可以知道",
    "vi": "Có lẽ người ở đó nghĩ rằng."
  },
  {
    "idx": 1405,
    "start": "00:32:15,074",
    "end": "00:32:15,954",
    "start_sec": 1935.074,
    "end_sec": 1935.954,
    "zh": "点烟花气晦气",
    "vi": "Đốt pháo hoa sẽ xua đuổi vận xui."
  },
  {
    "idx": 1406,
    "start": "00:32:15,954",
    "end": "00:32:17,234",
    "start_sec": 1935.954,
    "end_sec": 1937.234,
    "zh": "你信吧",
    "vi": "Bạn có tin không."
  },
  {
    "idx": 1407,
    "start": "00:32:17,234",
    "end": "00:32:28,554",
    "start_sec": 1937.234,
    "end_sec": 1948.554,
    "zh": "现在查过一条紧急新闻",
    "vi": "Sau đây là một tin tức khẩn cấp."
  },
  {
    "idx": 1408,
    "start": "00:32:28,554",
    "end": "00:32:29,214",
    "start_sec": 1948.554,
    "end_sec": 1949.214,
    "zh": "通知",
    "vi": "Thông báo."
  },
  {
    "idx": 1409,
    "start": "00:32:29,214",
    "end": "00:32:29,854",
    "start_sec": 1949.214,
    "end_sec": 1949.854,
    "zh": "通知",
    "vi": "Thông báo."
  },
  {
    "idx": 1410,
    "start": "00:32:29,854",
    "end": "00:32:31,074",
    "start_sec": 1949.854,
    "end_sec": 1951.074,
    "zh": "特殊情况",
    "vi": "Tình huống đặc biệt."
  },
  {
    "idx": 1411,
    "start": "00:32:31,074",
    "end": "00:32:33,394",
    "start_sec": 1951.074,
    "end_sec": 1953.394,
    "zh": "请所有军民暂时不要外出",
    "vi": "Yêu cầu toàn thể quân dân tạm thời không ra ngoài."
  },
  {
    "idx": 1412,
    "start": "00:32:33,394",
    "end": "00:32:34,414",
    "start_sec": 1953.394,
    "end_sec": 1954.414,
    "zh": "又干嘛呀",
    "vi": "Lại cái gì nữa đây."
  },
  {
    "idx": 1413,
    "start": "00:32:34,414",
    "end": "00:32:35,254",
    "start_sec": 1954.414,
    "end_sec": 1955.254,
    "zh": "搞突袭演习吗",
    "vi": "Diễn tập đột xuất à."
  },
  {
    "idx": 1414,
    "start": "00:32:35,254",
    "end": "00:32:36,594",
    "start_sec": 1955.254,
    "end_sec": 1956.594,
    "zh": "今天真是奇怪的事情",
    "vi": "Hôm nay đúng là toàn chuyện kỳ lạ."
  },
  {
    "idx": 1415,
    "start": "00:32:36,594",
    "end": "00:32:38,074",
    "start_sec": 1956.594,
    "end_sec": 1958.074,
    "zh": "一件接着一件",
    "vi": "Hết chuyện này đến chuyện khác."
  },
  {
    "idx": 1416,
    "start": "00:32:38,074",
    "end": "00:32:40,214",
    "start_sec": 1958.074,
    "end_sec": 1960.214,
    "zh": "卧槽",
    "vi": "Chết tiệt."
  },
  {
    "idx": 1417,
    "start": "00:32:40,214",
    "end": "00:32:41,054",
    "start_sec": 1960.214,
    "end_sec": 1961.054,
    "zh": "有完没完",
    "vi": "Có xong chưa vậy."
  },
  {
    "idx": 1418,
    "start": "00:32:41,054",
    "end": "00:32:41,714",
    "start_sec": 1961.054,
    "end_sec": 1961.714,
    "zh": "还这么巧",
    "vi": "Lại còn trùng hợp thế."
  },
  {
    "idx": 1419,
    "start": "00:32:45,954",
    "end": "00:32:47,994",
    "start_sec": 1965.954,
    "end_sec": 1967.994,
    "zh": "楼下谁啊",
    "vi": "Ai ở dưới lầu thế."
  },
  {
    "idx": 1420,
    "start": "00:32:47,994",
    "end": "00:32:49,854",
    "start_sec": 1967.994,
    "end_sec": 1969.854,
    "zh": "大半夜的敲你妈呢",
    "vi": "Nửa đêm nửa hôm gõ cái gì thế hả."
  },
  {
    "idx": 1421,
    "start": "00:32:49,854",
    "end": "00:32:50,994",
    "start_sec": 1969.854,
    "end_sec": 1970.994,
    "zh": "202的李永明",
    "vi": "Đó là Lý Vĩnh Minh phòng 202."
  },
  {
    "idx": 1422,
    "start": "00:32:50,994",
    "end": "00:32:52,774",
    "start_sec": 1970.994,
    "end_sec": 1972.774,
    "zh": "当厨子的大掌门脾气爆",
    "vi": "Làm đầu bếp trưởng nên tính tình rất nóng nảy."
  },
  {
    "idx": 1423,
    "start": "00:32:52,774",
    "end": "00:32:55,854",
    "start_sec": 1972.774,
    "end_sec": 1975.854,
    "zh": "果然他是第一个开口妈的",
    "vi": "Quả nhiên ông ta là người đầu tiên lên tiếng chửi bới."
  },
  {
    "idx": 1424,
    "start": "00:32:55,854",
    "end": "00:32:58,574",
    "start_sec": 1975.854,
    "end_sec": 1978.574,
    "zh": "妈了个B的",
    "vi": "Mẹ kiếp."
  },
  {
    "idx": 1425,
    "start": "00:32:58,574",
    "end": "00:32:59,174",
    "start_sec": 1978.574,
    "end_sec": 1979.174,
    "zh": "谁啊",
    "vi": "Ai đấy."
  },
  {
    "idx": 1426,
    "start": "00:32:59,174",
    "end": "00:33:00,554",
    "start_sec": 1979.174,
    "end_sec": 1980.554,
    "zh": "大晚上换件事吧",
    "vi": "Đêm hôm khuya khoắt làm cái gì thế."
  },
  {
    "idx": 1427,
    "start": "00:33:00,554",
    "end": "00:33:00,834",
    "start_sec": 1980.554,
    "end_sec": 1980.834,
    "zh": "来",
    "vi": "Ra đây."
  },
  {
    "idx": 1428,
    "start": "00:33:00,834",
    "end": "00:33:01,694",
    "start_sec": 1980.834,
    "end_sec": 1981.694,
    "zh": "让我看看",
    "vi": "Để tao xem nào."
  },
  {
    "idx": 1429,
    "start": "00:33:01,694",
    "end": "00:33:02,614",
    "start_sec": 1981.694,
    "end_sec": 1982.614,
    "zh": "拿个不长眼",
    "vi": "Đứa nào không có mắt thế."
  },
  {
    "idx": 1430,
    "start": "00:33:02,614",
    "end": "00:33:05,334",
    "start_sec": 1982.614,
    "end_sec": 1985.334,
    "zh": "你",
    "vi": "Mày."
  },
  {
    "idx": 1431,
    "start": "00:33:05,334",
    "end": "00:33:05,874",
    "start_sec": 1985.334,
    "end_sec": 1985.874,
    "zh": "你",
    "vi": "Mày."
  },
  {
    "idx": 1432,
    "start": "00:33:05,874",
    "end": "00:33:07,954",
    "start_sec": 1985.874,
    "end_sec": 1987.954,
    "zh": "你他妈是什么怪物",
    "vi": "Mày là cái quái vật khốn kiếp gì thế."
  },
  {
    "idx": 1433,
    "start": "00:33:07,954",
    "end": "00:33:11,034",
    "start_sec": 1987.954,
    "end_sec": 1991.034,
    "zh": "卧槽",
    "vi": "Ôi trời ơi."
  },
  {
    "idx": 1434,
    "start": "00:33:11,034",
    "end": "00:33:12,354",
    "start_sec": 1991.034,
    "end_sec": 1992.354,
    "zh": "发生什么事了",
    "vi": "Có chuyện gì xảy ra thế."
  },
  {
    "idx": 1435,
    "start": "00:33:12,354",
    "end": "00:33:13,414",
    "start_sec": 1992.354,
    "end_sec": 1993.414,
    "zh": "怎么突然没动静了",
    "vi": "Sao tự nhiên im bặt rồi."
  },
  {
    "idx": 1436,
    "start": "00:33:13,414",
    "end": "00:33:13,914",
    "start_sec": 1993.414,
    "end_sec": 1993.914,
    "zh": "真可怜",
    "vi": "Thật đáng thương."
  },
  {
    "idx": 1437,
    "start": "00:33:13,914",
    "end": "00:33:27,634",
    "start_sec": 1993.914,
    "end_sec": 2007.634,
    "zh": "家人们",
    "vi": "Mọi người ơi."
  },
  {
    "idx": 1438,
    "start": "00:33:27,634",
    "end": "00:33:29,454",
    "start_sec": 2007.634,
    "end_sec": 2009.454,
    "zh": "谁知道李哥家发生什么了呀",
    "vi": "Có ai biết nhà anh Lý xảy ra chuyện gì không."
  },
  {
    "idx": 1439,
    "start": "00:33:29,454",
    "end": "00:33:31,174",
    "start_sec": 2009.454,
    "end_sec": 2011.174,
    "zh": "咋没生了呀",
    "vi": "Sao không nghe thấy tiếng gì nữa thế."
  },
  {
    "idx": 1440,
    "start": "00:33:31,174",
    "end": "00:33:33,134",
    "start_sec": 2011.174,
    "end_sec": 2013.134,
    "zh": "谁知道啊",
    "vi": "Ai mà biết được chứ."
  },
  {
    "idx": 1441,
    "start": "00:33:33,134",
    "end": "00:33:35,514",
    "start_sec": 2013.134,
    "end_sec": 2015.514,
    "zh": "不会打架打死人了吧",
    "vi": "Chẳng lẽ đánh nhau đến chết người rồi sao."
  },
  {
    "idx": 1442,
    "start": "00:33:35,514",
    "end": "00:33:37,034",
    "start_sec": 2015.514,
    "end_sec": 2017.034,
    "zh": "美美姐",
    "vi": "Chị Mỹ Mỹ."
  },
  {
    "idx": 1443,
    "start": "00:33:37,034",
    "end": "00:33:38,414",
    "start_sec": 2017.034,
    "end_sec": 2018.414,
    "zh": "你不就住隔壁吗",
    "vi": "Chẳng phải chị ở ngay sát vách sao."
  },
  {
    "idx": 1444,
    "start": "00:33:38,414",
    "end": "00:33:40,114",
    "start_sec": 2018.414,
    "end_sec": 2020.114,
    "zh": "你从猫眼去看一眼呗",
    "vi": "Chị nhìn qua mắt mèo xem thử đi."
  },
  {
    "idx": 1445,
    "start": "00:33:43,914",
    "end": "00:33:47,354",
    "start_sec": 2023.914,
    "end_sec": 2027.354,
    "zh": "有人在敲我家房门",
    "vi": "Có người đang gõ cửa nhà tôi."
  },
  {
    "idx": 1446,
    "start": "00:33:47,354",
    "end": "00:33:48,574",
    "start_sec": 2027.354,
    "end_sec": 2028.574,
    "zh": "哇哇",
    "vi": "Oa oa."
  },
  {
    "idx": 1447,
    "start": "00:33:48,574",
    "end": "00:33:49,894",
    "start_sec": 2028.574,
    "end_sec": 2029.894,
    "zh": "谁啊",
    "vi": "Ai thế nhỉ."
  },
  {
    "idx": 1448,
    "start": "00:33:49,894",
    "end": "00:33:51,374",
    "start_sec": 2029.894,
    "end_sec": 2031.374,
    "zh": "大晚上这么没素质",
    "vi": "Đêm hôm khuya khoắt thật thiếu ý thức."
  },
  {
    "idx": 1449,
    "start": "00:33:51,374",
    "end": "00:33:53,614",
    "start_sec": 2031.374,
    "end_sec": 2033.614,
    "zh": "这让我想起来以前那个一楼的熊孩子",
    "vi": "Làm tôi nhớ đến đứa trẻ hư ở tầng một hồi trước."
  },
  {
    "idx": 1450,
    "start": "00:33:53,614",
    "end": "00:33:55,034",
    "start_sec": 2033.614,
    "end_sec": 2035.034,
    "zh": "没事就喜欢敲门",
    "vi": "Hở ra là thích gõ cửa."
  },
  {
    "idx": 1451,
    "start": "00:33:55,034",
    "end": "00:33:55,714",
    "start_sec": 2035.034,
    "end_sec": 2035.714,
    "zh": "真烦",
    "vi": "Thật phiền phức."
  },
  {
    "idx": 1452,
    "start": "00:33:55,714",
    "end": "00:33:57,174",
    "start_sec": 2035.714,
    "end_sec": 2037.174,
    "zh": "是啊",
    "vi": "Đúng vậy."
  },
  {
    "idx": 1453,
    "start": "00:33:57,174",
    "end": "00:33:59,494",
    "start_sec": 2037.174,
    "end_sec": 2039.494,
    "zh": "那熊孩子缺少家教淘气的很",
    "vi": "Đứa trẻ đó thiếu giáo dục nên nghịch ngợm lắm."
  },
  {
    "idx": 1454,
    "start": "00:33:59,494",
    "end": "00:34:01,214",
    "start_sec": 2039.494,
    "end_sec": 2041.214,
    "zh": "经常跑出去敲别人房门",
    "vi": "Suốt ngày chạy đi gõ cửa nhà người khác."
  },
  {
    "idx": 1455,
    "start": "00:34:01,214",
    "end": "00:34:03,514",
    "start_sec": 2041.214,
    "end_sec": 2043.514,
    "zh": "有天往家里煤气灶扔炮炸",
    "vi": "Có hôm nó ném pháo vào bếp ga trong nhà."
  },
  {
    "idx": 1456,
    "start": "00:34:03,514",
    "end": "00:34:05,114",
    "start_sec": 2043.514,
    "end_sec": 2045.114,
    "zh": "屋内直接来了个大爆炸",
    "vi": "Trong nhà nổ tung một cái thật lớn."
  },
  {
    "idx": 1457,
    "start": "00:34:05,114",
    "end": "00:34:06,234",
    "start_sec": 2045.114,
    "end_sec": 2046.234,
    "zh": "连同他奶奶",
    "vi": "Cả bà nội nó nữa."
  },
  {
    "idx": 1458,
    "start": "00:34:06,234",
    "end": "00:34:06,974",
    "start_sec": 2046.234,
    "end_sec": 2046.974,
    "zh": "一老一小",
    "vi": "Một già một trẻ."
  },
  {
    "idx": 1459,
    "start": "00:34:06,974",
    "end": "00:34:09,254",
    "start_sec": 2046.974,
    "end_sec": 2049.254,
    "zh": "当时就被爆炸的火焰活活烧死",
    "vi": "Lúc đó bị ngọn lửa thiêu sống ngay tại chỗ."
  },
  {
    "idx": 1460,
    "start": "00:34:09,254",
    "end": "00:34:10,834",
    "start_sec": 2049.254,
    "end_sec": 2050.834,
    "zh": "真是把自己做死了",
    "vi": "Đúng là tự làm tự chịu."
  },
  {
    "idx": 1461,
    "start": "00:34:10,834",
    "end": "00:34:11,894",
    "start_sec": 2050.834,
    "end_sec": 2051.894,
    "zh": "王美美",
    "vi": "Vương Mỹ Mỹ."
  },
  {
    "idx": 1462,
    "start": "00:34:11,894",
    "end": "00:34:13,074",
    "start_sec": 2051.894,
    "end_sec": 2053.074,
    "zh": "你去猫眼看看情况",
    "vi": "Chị ra mắt mèo xem tình hình thế nào đi."
  },
  {
    "idx": 1463,
    "start": "00:34:13,074",
    "end": "00:34:14,374",
    "start_sec": 2053.074,
    "end_sec": 2054.374,
    "zh": "要是有人故意捣乱",
    "vi": "Nếu có kẻ cố tình quấy rối."
  },
  {
    "idx": 1464,
    "start": "00:34:14,374",
    "end": "00:34:16,394",
    "start_sec": 2054.374,
    "end_sec": 2056.394,
    "zh": "咱们异动楼的人都出去扁他",
    "vi": "Anh em trong tòa nhà chúng ta sẽ ra ngoài đánh nó."
  },
  {
    "idx": 1465,
    "start": "00:34:16,394",
    "end": "00:34:16,914",
    "start_sec": 2056.394,
    "end_sec": 2056.914,
    "zh": "好",
    "vi": "Được."
  },
  {
    "idx": 1466,
    "start": "00:34:16,914",
    "end": "00:34:25,954",
    "start_sec": 2056.914,
    "end_sec": 2065.954,
    "zh": "万念",
    "vi": "Vạn Niệm."
  },
  {
    "idx": 1467,
    "start": "00:34:25,954",
    "end": "00:34:27,514",
    "start_sec": 2065.954,
    "end_sec": 2067.514,
    "zh": "喂 没人",
    "vi": "Này, không có ai cả."
  },
  {
    "idx": 1468,
    "start": "00:34:27,514",
    "end": "00:34:29,014",
    "start_sec": 2067.514,
    "end_sec": 2069.014,
    "zh": "到底是谁在敲门",
    "vi": "Rốt cuộc là ai đang gõ cửa chứ."
  },
  {
    "idx": 1469,
    "start": "00:34:40,074",
    "end": "00:34:40,994",
    "start_sec": 2080.074,
    "end_sec": 2080.994,
    "zh": "王妹妹你怎么了",
    "vi": "Chị Mỹ Mỹ chị sao thế."
  },
  {
    "idx": 1470,
    "start": "00:34:40,994",
    "end": "00:34:42,334",
    "start_sec": 2080.994,
    "end_sec": 2082.334,
    "zh": "王妹妹你没事吧",
    "vi": "Chị Mỹ Mỹ chị không sao chứ."
  },
  {
    "idx": 1471,
    "start": "00:34:42,334",
    "end": "00:34:42,894",
    "start_sec": 2082.334,
    "end_sec": 2082.894,
    "zh": "什么情况",
    "vi": "Chuyện gì vậy"
  },
  {
    "idx": 1472,
    "start": "00:34:42,894",
    "end": "00:34:45,134",
    "start_sec": 2082.894,
    "end_sec": 2085.134,
    "zh": "妹妹姐,敲门的到底是什么东西?",
    "vi": "Chị ơi, thứ gõ cửa là cái gì vậy ạ."
  },
  {
    "idx": 1473,
    "start": "00:34:45,454",
    "end": "00:34:49,194",
    "start_sec": 2085.454,
    "end_sec": 2089.194,
    "zh": "好多的血,好像是个人,不,不对,好像是两个人,",
    "vi": "Nhiều máu quá, trông như một người, không, không đúng, như hai người vậy,"
  },
  {
    "idx": 1474,
    "start": "00:34:49,394",
    "end": "00:34:52,614",
    "start_sec": 2089.394,
    "end_sec": 2092.614,
    "zh": "他们飞去去的,我看不清,等等,好像其中一个,",
    "vi": "Họ bay qua bay lại, em không nhìn rõ, đợi đã, hình như một trong số họ,"
  },
  {
    "idx": 1475,
    "start": "00:34:52,914",
    "end": "00:34:54,474",
    "start_sec": 2092.914,
    "end_sec": 2094.474,
    "zh": "手里还拿着燃烧的烟花。",
    "vi": "Trong tay còn cầm pháo hoa đang cháy."
  },
  {
    "idx": 1476,
    "start": "00:34:56,014",
    "end": "00:34:59,891",
    "start_sec": 2096.014,
    "end_sec": 2099.891,
    "zh": "不,你,你不是人,你,你是什么?是什么怪物怪物",
    "vi": "Không, mày, mày không phải người, mày, mày là cái gì. Là quái vật quái vật gì."
  },
  {
    "idx": 1477,
    "start": "00:35:10,891",
    "end": "00:35:11,331",
    "start_sec": 2110.891,
    "end_sec": 2111.331,
    "zh": "到底",
    "vi": "Rốt cuộc"
  },
  {
    "idx": 1478,
    "start": "00:35:11,331",
    "end": "00:35:12,771",
    "start_sec": 2111.331,
    "end_sec": 2112.771,
    "zh": "到底是什么东西",
    "vi": "Là cái thứ gì vậy"
  },
  {
    "idx": 1479,
    "start": "00:35:12,771",
    "end": "00:35:15,951",
    "start_sec": 2112.771,
    "end_sec": 2115.951,
    "zh": "传记两久之后",
    "vi": "Sau một hồi lâu"
  },
  {
    "idx": 1480,
    "start": "00:35:15,951",
    "end": "00:35:18,411",
    "start_sec": 2115.951,
    "end_sec": 2118.411,
    "zh": "七种祝贺群里再次响起新消息",
    "vi": "Tin nhắn mới lại vang lên trong nhóm chúc mừng bảy người."
  },
  {
    "idx": 1481,
    "start": "00:35:18,411",
    "end": "00:35:18,651",
    "start_sec": 2118.411,
    "end_sec": 2118.651,
    "zh": "喂",
    "vi": "Alo"
  },
  {
    "idx": 1482,
    "start": "00:35:18,651",
    "end": "00:35:20,711",
    "start_sec": 2118.651,
    "end_sec": 2120.711,
    "zh": "你们不是搞什么恶作剧吧",
    "vi": "Các cậu đang đùa gì phải không."
  },
  {
    "idx": 1483,
    "start": "00:35:20,711",
    "end": "00:35:21,091",
    "start_sec": 2120.711,
    "end_sec": 2121.091,
    "zh": "不会",
    "vi": "Không thể nào."
  },
  {
    "idx": 1484,
    "start": "00:35:21,091",
    "end": "00:35:22,271",
    "start_sec": 2121.091,
    "end_sec": 2122.271,
    "zh": "就204的老古本",
    "vi": "Chỉ là một trò đùa cũ rích năm 204 thôi."
  },
  {
    "idx": 1485,
    "start": "00:35:22,271",
    "end": "00:35:23,511",
    "start_sec": 2122.271,
    "end_sec": 2123.511,
    "zh": "不会有这个性质的",
    "vi": "Không có tính chất như vậy đâu."
  },
  {
    "idx": 1486,
    "start": "00:35:23,511",
    "end": "00:35:24,771",
    "start_sec": 2123.511,
    "end_sec": 2124.771,
    "zh": "有点奇怪啊",
    "vi": "Hơi lạ nhỉ."
  },
  {
    "idx": 1487,
    "start": "00:35:24,771",
    "end": "00:35:26,231",
    "start_sec": 2124.771,
    "end_sec": 2126.231,
    "zh": "要不,报警吧。",
    "vi": "Hay là, gọi cảnh sát đi."
  },
  {
    "idx": 1488,
    "start": "00:35:26,831",
    "end": "00:35:30,371",
    "start_sec": 2126.831,
    "end_sec": 2130.371,
    "zh": "对,对,马上报警,我好像真的闻到了血腥气味了。",
    "vi": "Đúng, đúng, gọi cảnh sát ngay, tôi dường như ngửi thấy mùi máu rồi."
  },
  {
    "idx": 1489,
    "start": "00:35:30,571",
    "end": "00:35:33,031",
    "start_sec": 2130.571,
    "end_sec": 2133.031,
    "zh": "真的假的,有没有你们说的那么瘆人啊?",
    "vi": "Thật hay giả vậy, có ghê rợn như các cậu nói không."
  },
  {
    "idx": 1490,
    "start": "00:35:33,291",
    "end": "00:35:35,011",
    "start_sec": 2133.291,
    "end_sec": 2135.011,
    "zh": "我还在回来的路上呢,好赌。",
    "vi": "Tôi vẫn đang trên đường về, sợ quá."
  },
  {
    "idx": 1491,
    "start": "00:35:35,611",
    "end": "00:35:38,931",
    "start_sec": 2135.611,
    "end_sec": 2138.931,
    "zh": "群里的消息在安静之后,像是吞血报复式的刷新,",
    "vi": "Tin nhắn trong nhóm im lặng rồi lại làm mới như một sự trả thù đẫm máu."
  },
  {
    "idx": 1492,
    "start": "00:35:39,171",
    "end": "00:35:40,551",
    "start_sec": 2139.171,
    "end_sec": 2140.551,
    "zh": "橙子皮刚想擦上一嘴。",
    "vi": "Trần Tử Bì vừa định nói gì đó."
  },
  {
    "idx": 1493,
    "start": "00:35:42,851",
    "end": "00:35:45,431",
    "start_sec": 2142.851,
    "end_sec": 2145.431,
    "zh": "听这声音,那怪物应该是来到三楼了。",
    "vi": "Nghe tiếng động, con quái vật đó chắc đã lên tầng ba rồi."
  },
  {
    "idx": 1494,
    "start": "00:35:45,851",
    "end": "00:35:49,211",
    "start_sec": 2145.851,
    "end_sec": 2149.211,
    "zh": "此时,三楼侯俊杰气急败坏的声音传来。",
    "vi": "Lúc này, giọng tức giận của Hầu Tuấn Kiệt từ tầng ba truyền đến."
  },
  {
    "idx": 1495,
    "start": "00:35:50,191",
    "end": "00:35:52,871",
    "start_sec": 2150.191,
    "end_sec": 2152.871,
    "zh": "走,走,110,怎么站下?",
    "vi": "Đi đi, đi đi, 110, sao còn đứng đó."
  },
  {
    "idx": 1496,
    "start": "00:35:54,771",
    "end": "00:35:57,051",
    "start_sec": 2154.771,
    "end_sec": 2157.051,
    "zh": "门外的老子不管你是什么东西",
    "vi": "Bố mày ở ngoài cửa không cần biết mày là cái thứ gì."
  },
  {
    "idx": 1497,
    "start": "00:35:57,051",
    "end": "00:35:57,831",
    "start_sec": 2157.051,
    "end_sec": 2157.831,
    "zh": "我告诉你",
    "vi": "Tao nói cho mày biết."
  },
  {
    "idx": 1498,
    "start": "00:35:57,831",
    "end": "00:35:58,271",
    "start_sec": 2157.831,
    "end_sec": 2158.271,
    "zh": "别给我",
    "vi": "Đừng có mà."
  },
  {
    "idx": 1499,
    "start": "00:35:58,271",
    "end": "00:35:59,371",
    "start_sec": 2158.271,
    "end_sec": 2159.371,
    "zh": "我是抬枕到黑的",
    "vi": "Tao sẽ đánh chết mày."
  },
  {
    "idx": 1500,
    "start": "00:35:59,371",
    "end": "00:36:03,611",
    "start_sec": 2159.371,
    "end_sec": 2163.611,
    "zh": "不管侯俊杰是何反应",
    "vi": "Bất kể Hầu Tuấn Kiệt phản ứng thế nào."
  },
  {
    "idx": 1501,
    "start": "00:36:03,611",
    "end": "00:36:04,491",
    "start_sec": 2163.611,
    "end_sec": 2164.491,
    "zh": "那敲门声",
    "vi": "Tiếng gõ cửa đó."
  },
  {
    "idx": 1502,
    "start": "00:36:04,491",
    "end": "00:36:05,851",
    "start_sec": 2164.491,
    "end_sec": 2165.851,
    "zh": "你还敲诗宝",
    "vi": "Mày vẫn còn gõ nữa à."
  },
  {
    "idx": 1503,
    "start": "00:36:05,851",
    "end": "00:36:07,631",
    "start_sec": 2165.851,
    "end_sec": 2167.631,
    "zh": "你要是敢进来老子弄死你",
    "vi": "Mày mà dám bước vào đây tao sẽ giết chết mày."
  },
  {
    "idx": 1504,
    "start": "00:36:07,631",
    "end": "00:36:09,251",
    "start_sec": 2167.631,
    "end_sec": 2169.251,
    "zh": "侯俊杰竟然嘴上叫嚣着",
    "vi": "Hầu Tuấn Kiệt tuy ngoài miệng thì gào thét như vậy."
  },
  {
    "idx": 1505,
    "start": "00:36:09,251",
    "end": "00:36:11,351",
    "start_sec": 2169.251,
    "end_sec": 2171.351,
    "zh": "可谁也不知道屋外到底是什么东西",
    "vi": "Nhưng không ai biết thứ ở ngoài cửa rốt cuộc là cái gì."
  },
  {
    "idx": 1506,
    "start": "00:36:11,351",
    "end": "00:36:12,431",
    "start_sec": 2171.351,
    "end_sec": 2172.431,
    "zh": "更不敢真的开门",
    "vi": "Lại càng không ai dám thực sự mở cửa."
  },
  {
    "idx": 1507,
    "start": "00:36:12,431",
    "end": "00:36:14,451",
    "start_sec": 2172.431,
    "end_sec": 2174.451,
    "zh": "就在这时敲门声戛然而止",
    "vi": "Ngay lúc này tiếng gõ cửa đột ngột dừng lại."
  },
  {
    "idx": 1508,
    "start": "00:36:14,451",
    "end": "00:36:16,871",
    "start_sec": 2174.451,
    "end_sec": 2176.871,
    "zh": "侯俊杰想看看门外的东西是否离开",
    "vi": "Hầu Tuấn Kiệt muốn xem thứ ngoài cửa đã rời đi chưa."
  },
  {
    "idx": 1509,
    "start": "00:36:16,871",
    "end": "00:36:17,951",
    "start_sec": 2176.871,
    "end_sec": 2177.951,
    "zh": "缓缓走了上去",
    "vi": "Anh ta chậm rãi bước tới."
  },
  {
    "idx": 1510,
    "start": "00:36:17,951",
    "end": "00:36:23,011",
    "start_sec": 2177.951,
    "end_sec": 2183.011,
    "zh": "你",
    "vi": "Mày."
  },
  {
    "idx": 1511,
    "start": "00:36:23,011",
    "end": "00:36:23,511",
    "start_sec": 2183.011,
    "end_sec": 2183.511,
    "zh": "你",
    "vi": "Mày."
  },
  {
    "idx": 1512,
    "start": "00:36:23,511",
    "end": "00:36:24,131",
    "start_sec": 2183.511,
    "end_sec": 2184.131,
    "zh": "你",
    "vi": "Mày."
  },
  {
    "idx": 1513,
    "start": "00:36:24,131",
    "end": "00:36:35,511",
    "start_sec": 2184.131,
    "end_sec": 2195.511,
    "zh": "三一的侯俊杰没了动静",
    "vi": "Hầu Tuấn Kiệt ở phòng ba lẻ một không còn động tĩnh gì nữa."
  },
  {
    "idx": 1514,
    "start": "00:36:35,511",
    "end": "00:36:36,651",
    "start_sec": 2195.511,
    "end_sec": 2196.651,
    "zh": "估计已经死了",
    "vi": "Có lẽ anh ta đã chết rồi."
  },
  {
    "idx": 1515,
    "start": "00:36:36,651",
    "end": "00:36:37,831",
    "start_sec": 2196.651,
    "end_sec": 2197.831,
    "zh": "这东西直奔四楼",
    "vi": "Thứ đó đang đi thẳng lên tầng bốn."
  },
  {
    "idx": 1516,
    "start": "00:36:37,831",
    "end": "00:36:38,931",
    "start_sec": 2197.831,
    "end_sec": 2198.931,
    "zh": "似乎能感知到",
    "vi": "Dường như nó có thể cảm nhận được."
  },
  {
    "idx": 1517,
    "start": "00:36:38,931",
    "end": "00:36:40,251",
    "start_sec": 2198.931,
    "end_sec": 2200.251,
    "zh": "三楼除了侯俊杰外",
    "vi": "Ở tầng ba ngoài Hầu Tuấn Kiệt ra."
  },
  {
    "idx": 1518,
    "start": "00:36:40,251",
    "end": "00:36:41,251",
    "start_sec": 2200.251,
    "end_sec": 2201.251,
    "zh": "没有其他住户",
    "vi": "Không còn người nào khác sinh sống."
  },
  {
    "idx": 1519,
    "start": "00:36:41,251",
    "end": "00:36:43,211",
    "start_sec": 2201.251,
    "end_sec": 2203.211,
    "zh": "那东西好像",
    "vi": "Thứ đó hình như."
  },
  {
    "idx": 1520,
    "start": "00:36:43,211",
    "end": "00:36:44,831",
    "start_sec": 2203.211,
    "end_sec": 2204.831,
    "zh": "好像朝四楼来了",
    "vi": "Hình như đang đi lên tầng bốn rồi."
  },
  {
    "idx": 1521,
    "start": "00:36:44,831",
    "end": "00:36:46,071",
    "start_sec": 2204.831,
    "end_sec": 2206.071,
    "zh": "正朝我房间来",
    "vi": "Nó đang đi về phía phòng của tôi."
  },
  {
    "idx": 1522,
    "start": "00:36:46,071",
    "end": "00:36:47,031",
    "start_sec": 2206.071,
    "end_sec": 2207.031,
    "zh": "陈康",
    "vi": "Trần Khang."
  },
  {
    "idx": 1523,
    "start": "00:36:47,031",
    "end": "00:36:48,491",
    "start_sec": 2207.031,
    "end_sec": 2208.491,
    "zh": "你不是胆子最大了吗",
    "vi": "Không phải mày là đứa gan dạ nhất sao."
  },
  {
    "idx": 1524,
    "start": "00:36:48,491",
    "end": "00:36:49,111",
    "start_sec": 2208.491,
    "end_sec": 2209.111,
    "zh": "你快出去",
    "vi": "Mày mau ra ngoài đi."
  },
  {
    "idx": 1525,
    "start": "00:36:49,111",
    "end": "00:36:50,111",
    "start_sec": 2209.111,
    "end_sec": 2210.111,
    "zh": "你快出去看看啊",
    "vi": "Mày mau ra ngoài xem thử đi."
  },
  {
    "idx": 1526,
    "start": "00:36:50,111",
    "end": "00:36:52,951",
    "start_sec": 2210.111,
    "end_sec": 2212.951,
    "zh": "反正不能坐以待毙",
    "vi": "Dù sao cũng không thể ngồi chờ chết được."
  },
  {
    "idx": 1527,
    "start": "00:36:52,951",
    "end": "00:36:53,671",
    "start_sec": 2212.951,
    "end_sec": 2213.671,
    "zh": "我去看看",
    "vi": "Để tao ra xem sao."
  },
  {
    "idx": 1528,
    "start": "00:36:53,671",
    "end": "00:36:56,171",
    "start_sec": 2213.671,
    "end_sec": 2216.171,
    "zh": "朋友你我往日无怨",
    "vi": "Này người bạn kia, tôi và bạn xưa nay không oán."
  },
  {
    "idx": 1529,
    "start": "00:36:56,171",
    "end": "00:36:57,091",
    "start_sec": 2216.171,
    "end_sec": 2217.091,
    "zh": "今日无仇",
    "vi": "Ngày nay không thù."
  },
  {
    "idx": 1530,
    "start": "00:36:57,091",
    "end": "00:36:58,291",
    "start_sec": 2217.091,
    "end_sec": 2218.291,
    "zh": "你敲我门干嘛",
    "vi": "Bạn gõ cửa phòng tôi làm gì vậy."
  },
  {
    "idx": 1531,
    "start": "00:36:58,291",
    "end": "00:37:00,671",
    "start_sec": 2218.291,
    "end_sec": 2220.671,
    "zh": "第二波敲门声响起",
    "vi": "Tiếng gõ cửa lần thứ hai vang lên."
  },
  {
    "idx": 1532,
    "start": "00:37:00,671",
    "end": "00:37:02,091",
    "start_sec": 2220.671,
    "end_sec": 2222.091,
    "zh": "像是死亡的钟声",
    "vi": "Như tiếng chuông báo tử."
  },
  {
    "idx": 1533,
    "start": "00:37:02,091",
    "end": "00:37:03,931",
    "start_sec": 2222.091,
    "end_sec": 2223.931,
    "zh": "险康死死握着水火刀",
    "vi": "Huy Khang siết chặt con dao nước lửa."
  },
  {
    "idx": 1534,
    "start": "00:37:03,931",
    "end": "00:37:05,231",
    "start_sec": 2223.931,
    "end_sec": 2225.231,
    "zh": "压力的喘不过气",
    "vi": "Áp lực khiến anh ngạt thở."
  },
  {
    "idx": 1535,
    "start": "00:37:05,231",
    "end": "00:37:07,411",
    "start_sec": 2225.231,
    "end_sec": 2227.411,
    "zh": "他将门内的座椅推放到门口",
    "vi": "Anh đẩy chiếc ghế trong phòng ra cửa."
  },
  {
    "idx": 1536,
    "start": "00:37:07,411",
    "end": "00:37:08,871",
    "start_sec": 2227.411,
    "end_sec": 2228.871,
    "zh": "然而后面的门",
    "vi": "Nhưng cánh cửa phía sau"
  },
  {
    "idx": 1537,
    "start": "00:37:08,871",
    "end": "00:37:10,771",
    "start_sec": 2228.871,
    "end_sec": 2230.771,
    "zh": "连带着门后的座椅",
    "vi": "Cùng với chiếc ghế sau cánh cửa"
  },
  {
    "idx": 1538,
    "start": "00:37:10,771",
    "end": "00:37:11,911",
    "start_sec": 2230.771,
    "end_sec": 2231.911,
    "zh": "尽数的前升",
    "vi": "Đều bị nâng lên."
  },
  {
    "idx": 1539,
    "start": "00:37:11,911",
    "end": "00:37:15,631",
    "start_sec": 2231.911,
    "end_sec": 2235.631,
    "zh": "又是一道感觉温还的声音",
    "vi": "Một giọng nói nghe có vẻ dịu dàng lại vang lên."
  },
  {
    "idx": 1540,
    "start": "00:37:15,631",
    "end": "00:37:16,731",
    "start_sec": 2235.631,
    "end_sec": 2236.731,
    "zh": "在楼内响起",
    "vi": "Trong nhà."
  },
  {
    "idx": 1541,
    "start": "00:37:16,731",
    "end": "00:37:18,191",
    "start_sec": 2236.731,
    "end_sec": 2238.191,
    "zh": "全里再也没了声音",
    "vi": "Không còn một tiếng động nào nữa."
  },
  {
    "idx": 1542,
    "start": "00:37:18,191",
    "end": "00:37:19,231",
    "start_sec": 2238.191,
    "end_sec": 2239.231,
    "zh": "大家都心知肚明",
    "vi": "Mọi người đều hiểu rõ."
  },
  {
    "idx": 1543,
    "start": "00:37:19,231",
    "end": "00:37:20,591",
    "start_sec": 2239.231,
    "end_sec": 2240.591,
    "zh": "险康不启的眼出神",
    "vi": "Huy Khang nhìn chằm chằm không chớp mắt."
  },
  {
    "idx": 1544,
    "start": "00:37:20,591",
    "end": "00:37:21,651",
    "start_sec": 2240.591,
    "end_sec": 2241.651,
    "zh": "妈妈",
    "vi": "Mẹ ơi."
  },
  {
    "idx": 1545,
    "start": "00:37:21,651",
    "end": "00:37:22,171",
    "start_sec": 2241.651,
    "end_sec": 2242.171,
    "zh": "我去",
    "vi": "Con đi."
  },
  {
    "idx": 1546,
    "start": "00:37:22,171",
    "end": "00:37:23,831",
    "start_sec": 2242.171,
    "end_sec": 2243.831,
    "zh": "朵朵乖",
    "vi": "Đóa Đóa ngoan."
  },
  {
    "idx": 1547,
    "start": "00:37:23,831",
    "end": "00:37:25,791",
    "start_sec": 2243.831,
    "end_sec": 2245.791,
    "zh": "朵朵不哭",
    "vi": "Đóa Đóa đừng khóc."
  },
  {
    "idx": 1548,
    "start": "00:37:25,791",
    "end": "00:37:27,491",
    "start_sec": 2245.791,
    "end_sec": 2247.491,
    "zh": "求求你们",
    "vi": "Làm ơn."
  },
  {
    "idx": 1549,
    "start": "00:37:27,491",
    "end": "00:37:28,771",
    "start_sec": 2247.491,
    "end_sec": 2248.771,
    "zh": "各位同楼的朋友",
    "vi": "Các bạn cùng nhà ơi."
  },
  {
    "idx": 1550,
    "start": "00:37:28,771",
    "end": "00:37:30,231",
    "start_sec": 2248.771,
    "end_sec": 2250.231,
    "zh": "我还有孩子呢",
    "vi": "Tôi còn có con nhỏ."
  },
  {
    "idx": 1551,
    "start": "00:37:30,231",
    "end": "00:37:31,391",
    "start_sec": 2250.231,
    "end_sec": 2251.391,
    "zh": "谁来帮帮我",
    "vi": "Ai đó giúp tôi với."
  },
  {
    "idx": 1552,
    "start": "00:37:31,391",
    "end": "00:37:32,871",
    "start_sec": 2251.391,
    "end_sec": 2252.871,
    "zh": "谁来帮帮我",
    "vi": "Ai đó giúp tôi với."
  },
  {
    "idx": 1553,
    "start": "00:37:32,871",
    "end": "00:37:34,571",
    "start_sec": 2252.871,
    "end_sec": 2254.571,
    "zh": "然而",
    "vi": "Thế nhưng."
  },
  {
    "idx": 1554,
    "start": "00:37:34,571",
    "end": "00:37:36,031",
    "start_sec": 2254.571,
    "end_sec": 2256.031,
    "zh": "在人人自危的时候",
    "vi": "Khi mọi người đều lo cho bản thân."
  },
  {
    "idx": 1555,
    "start": "00:37:36,031",
    "end": "00:37:37,811",
    "start_sec": 2256.031,
    "end_sec": 2257.811,
    "zh": "悲哀并不会逆流成河",
    "vi": "Nỗi bi ai không chảy ngược thành sông."
  },
  {
    "idx": 1556,
    "start": "00:37:37,811",
    "end": "00:37:40,111",
    "start_sec": 2257.811,
    "end_sec": 2260.111,
    "zh": "只会像掉落深水的石头",
    "vi": "Mà chỉ như hòn đá rơi xuống nước sâu."
  },
  {
    "idx": 1557,
    "start": "00:37:40,111",
    "end": "00:37:41,091",
    "start_sec": 2260.111,
    "end_sec": 2261.091,
    "zh": "越沉越深",
    "vi": "Càng ngày càng chìm."
  },
  {
    "idx": 1558,
    "start": "00:37:41,091",
    "end": "00:37:43,291",
    "start_sec": 2261.091,
    "end_sec": 2263.291,
    "zh": "沉寂在暗无天日的水里",
    "vi": "Chìm trong làn nước tối tăm."
  },
  {
    "idx": 1559,
    "start": "00:37:43,291",
    "end": "00:37:45,411",
    "start_sec": 2263.291,
    "end_sec": 2265.411,
    "zh": "朵朵",
    "vi": "Đóa Đóa."
  },
  {
    "idx": 1560,
    "start": "00:37:45,411",
    "end": "00:37:46,351",
    "start_sec": 2265.411,
    "end_sec": 2266.351,
    "zh": "快躲起来",
    "vi": "Nhanh lên trốn đi."
  },
  {
    "idx": 1561,
    "start": "00:37:46,351",
    "end": "00:37:52,431",
    "start_sec": 2266.351,
    "end_sec": 2272.431,
    "zh": "外面的",
    "vi": "Kẻ bên ngoài kia"
  },
  {
    "idx": 1562,
    "start": "00:37:52,431",
    "end": "00:37:54,071",
    "start_sec": 2272.431,
    "end_sec": 2274.071,
    "zh": "我不管你到底是个什么玩意",
    "vi": "Tao không quan tâm mày rốt cuộc là cái thứ gì"
  },
  {
    "idx": 1563,
    "start": "00:37:54,071",
    "end": "00:37:55,351",
    "start_sec": 2274.071,
    "end_sec": 2275.351,
    "zh": "不许伤害我女儿",
    "vi": "Không được làm hại con gái tao"
  },
  {
    "idx": 1564,
    "start": "00:37:55,351",
    "end": "00:37:57,111",
    "start_sec": 2275.351,
    "end_sec": 2277.111,
    "zh": "老娘和你拼了",
    "vi": "Bà đây liều mạng với mày"
  },
  {
    "idx": 1565,
    "start": "00:37:57,111",
    "end": "00:38:04,331",
    "start_sec": 2277.111,
    "end_sec": 2284.331,
    "zh": "妈的",
    "vi": "Mẹ kiếp"
  },
  {
    "idx": 1566,
    "start": "00:38:04,331",
    "end": "00:38:05,411",
    "start_sec": 2284.331,
    "end_sec": 2285.411,
    "zh": "到底是个什么东西",
    "vi": "Rốt cuộc là cái thứ gì thế."
  },
  {
    "idx": 1567,
    "start": "00:38:05,411",
    "end": "00:38:06,591",
    "start_sec": 2285.411,
    "end_sec": 2286.591,
    "zh": "连孩子都不放过",
    "vi": "Đến cả trẻ con cũng không tha"
  },
  {
    "idx": 1568,
    "start": "00:38:06,591",
    "end": "00:38:07,351",
    "start_sec": 2286.591,
    "end_sec": 2287.351,
    "zh": "真该死",
    "vi": "Thật đáng chết"
  },
  {
    "idx": 1569,
    "start": "00:38:07,351",
    "end": "00:38:09,511",
    "start_sec": 2287.351,
    "end_sec": 2289.511,
    "zh": "这里是国家安全局",
    "vi": "Đây là Cục An ninh Quốc gia"
  },
  {
    "idx": 1570,
    "start": "00:38:09,511",
    "end": "00:38:10,551",
    "start_sec": 2289.511,
    "end_sec": 2290.551,
    "zh": "紧急通知",
    "vi": "Thông báo khẩn cấp"
  },
  {
    "idx": 1571,
    "start": "00:38:10,551",
    "end": "00:38:11,551",
    "start_sec": 2290.551,
    "end_sec": 2291.551,
    "zh": "紧急通知",
    "vi": "Thông báo khẩn cấp"
  },
  {
    "idx": 1572,
    "start": "00:38:11,551",
    "end": "00:38:14,711",
    "start_sec": 2291.551,
    "end_sec": 2294.711,
    "zh": "全世界正在陷入古怪的灵异事件之中",
    "vi": "Toàn thế giới đang rơi vào những sự kiện tâm linh kỳ quái"
  },
  {
    "idx": 1573,
    "start": "00:38:14,711",
    "end": "00:38:17,731",
    "start_sec": 2294.711,
    "end_sec": 2297.731,
    "zh": "请所有人尽可能避开周边诡异事件",
    "vi": "Xin mọi người hãy cố gắng tránh xa các sự kiện kỳ quái xung quanh"
  },
  {
    "idx": 1574,
    "start": "00:38:17,731",
    "end": "00:38:19,591",
    "start_sec": 2297.731,
    "end_sec": 2299.591,
    "zh": "请尽全力活下来",
    "vi": "Hãy cố gắng hết sức để sống sót"
  },
  {
    "idx": 1575,
    "start": "00:38:19,591",
    "end": "00:38:22,271",
    "start_sec": 2299.591,
    "end_sec": 2302.271,
    "zh": "国家正在想办法挽救一切",
    "vi": "Nhà nước đang tìm cách cứu vãn mọi thứ"
  },
  {
    "idx": 1576,
    "start": "00:38:22,271",
    "end": "00:38:24,231",
    "start_sec": 2302.271,
    "end_sec": 2304.231,
    "zh": "诡异的能力千奇百怪",
    "vi": "Năng lực của những hiện tượng kỳ quái này rất đa dạng"
  },
  {
    "idx": 1577,
    "start": "00:38:24,231",
    "end": "00:38:26,291",
    "start_sec": 2304.231,
    "end_sec": 2306.291,
    "zh": "或许也会遵循某些规则",
    "vi": "Có lẽ chúng cũng tuân theo một số quy luật nào đó"
  },
  {
    "idx": 1578,
    "start": "00:38:26,291",
    "end": "00:38:28,771",
    "start_sec": 2306.291,
    "end_sec": 2308.771,
    "zh": "找到规则也许就能找到生路",
    "vi": "Tìm ra quy luật có lẽ sẽ tìm được đường sống"
  },
  {
    "idx": 1579,
    "start": "00:38:28,771",
    "end": "00:38:30,271",
    "start_sec": 2308.771,
    "end_sec": 2310.271,
    "zh": "最后叮嘱一遍",
    "vi": "Lời dặn dò cuối cùng"
  },
  {
    "idx": 1580,
    "start": "00:38:30,271",
    "end": "00:38:33,111",
    "start_sec": 2310.271,
    "end_sec": 2313.111,
    "zh": "请各位尽全力活下来",
    "vi": "Xin mọi người hãy cố gắng hết sức để sống sót"
  },
  {
    "idx": 1581,
    "start": "00:38:33,111",
    "end": "00:38:33,991",
    "start_sec": 2313.111,
    "end_sec": 2313.991,
    "zh": "诡异将军",
    "vi": "Sự kỳ quái giáng xuống"
  },
  {
    "idx": 1582,
    "start": "00:38:33,991",
    "end": "00:38:36,031",
    "start_sec": 2313.991,
    "end_sec": 2316.031,
    "zh": "诡异事件",
    "vi": "Sự kiện kỳ quái"
  },
  {
    "idx": 1583,
    "start": "00:38:36,031",
    "end": "00:38:36,871",
    "start_sec": 2316.031,
    "end_sec": 2316.871,
    "zh": "什么鬼",
    "vi": "Cái quái gì thế."
  },
  {
    "idx": 1584,
    "start": "00:38:36,871",
    "end": "00:38:38,831",
    "start_sec": 2316.871,
    "end_sec": 2318.831,
    "zh": "不会就是我们现在发生的吧",
    "vi": "Không lẽ chính là chuyện đang xảy ra với chúng ta sao."
  },
  {
    "idx": 1585,
    "start": "00:38:38,831",
    "end": "00:38:39,271",
    "start_sec": 2318.831,
    "end_sec": 2319.271,
    "zh": "鬼",
    "vi": "Ma"
  },
  {
    "idx": 1586,
    "start": "00:38:39,271",
    "end": "00:38:40,191",
    "start_sec": 2319.271,
    "end_sec": 2320.191,
    "zh": "鬼",
    "vi": "Ma kìa"
  },
  {
    "idx": 1587,
    "start": "00:38:40,191",
    "end": "00:38:41,051",
    "start_sec": 2320.191,
    "end_sec": 2321.051,
    "zh": "完了",
    "vi": "Tiêu rồi"
  },
  {
    "idx": 1588,
    "start": "00:38:41,051",
    "end": "00:38:41,971",
    "start_sec": 2321.051,
    "end_sec": 2321.971,
    "zh": "完了",
    "vi": "Xong đời rồi"
  },
  {
    "idx": 1589,
    "start": "00:38:41,971",
    "end": "00:38:43,311",
    "start_sec": 2321.971,
    "end_sec": 2323.311,
    "zh": "我们都会死的",
    "vi": "Chúng ta đều sẽ chết mất"
  },
  {
    "idx": 1590,
    "start": "00:38:43,311",
    "end": "00:38:45,091",
    "start_sec": 2323.311,
    "end_sec": 2325.091,
    "zh": "我们怎么可能斗得过鬼吗",
    "vi": "Làm sao chúng ta đấu lại ma được chứ."
  },
  {
    "idx": 1591,
    "start": "00:38:45,091",
    "end": "00:38:46,291",
    "start_sec": 2325.091,
    "end_sec": 2326.291,
    "zh": "别傻了",
    "vi": "Đừng ngốc nữa."
  },
  {
    "idx": 1592,
    "start": "00:38:46,291",
    "end": "00:38:47,411",
    "start_sec": 2326.291,
    "end_sec": 2327.411,
    "zh": "你没发现吗",
    "vi": "Bạn không nhận ra sao."
  },
  {
    "idx": 1593,
    "start": "00:38:47,411",
    "end": "00:38:48,831",
    "start_sec": 2327.411,
    "end_sec": 2328.831,
    "zh": "他敲完门才会杀人",
    "vi": "Hắn chỉ giết người sau khi gõ cửa xong."
  },
  {
    "idx": 1594,
    "start": "00:38:48,831",
    "end": "00:38:50,371",
    "start_sec": 2328.831,
    "end_sec": 2330.371,
    "zh": "按国家信息的提示",
    "vi": "Theo thông tin quốc gia gợi ý."
  },
  {
    "idx": 1595,
    "start": "00:38:50,371",
    "end": "00:38:52,651",
    "start_sec": 2330.371,
    "end_sec": 2332.651,
    "zh": "趁着他没敲完门赶紧跑",
    "vi": "Tranh thủ lúc hắn chưa gõ xong cửa thì chạy mau."
  },
  {
    "idx": 1596,
    "start": "00:38:52,651",
    "end": "00:38:54,191",
    "start_sec": 2332.651,
    "end_sec": 2334.191,
    "zh": "鬼死了",
    "vi": "Quỷ chết rồi."
  },
  {
    "idx": 1597,
    "start": "00:38:54,191",
    "end": "00:38:54,971",
    "start_sec": 2334.191,
    "end_sec": 2334.971,
    "zh": "鬼杀人",
    "vi": "Quỷ giết người."
  },
  {
    "idx": 1598,
    "start": "00:38:54,971",
    "end": "00:38:56,191",
    "start_sec": 2334.971,
    "end_sec": 2336.191,
    "zh": "真的有鬼子吗",
    "vi": "Thật sự có quỷ sao."
  },
  {
    "idx": 1599,
    "start": "00:38:56,191",
    "end": "00:38:58,651",
    "start_sec": 2336.191,
    "end_sec": 2338.651,
    "zh": "这是五楼他来开门的声音",
    "vi": "Đây là tiếng hắn mở cửa ở tầng năm."
  },
  {
    "idx": 1600,
    "start": "00:38:58,651",
    "end": "00:39:02,471",
    "start_sec": 2338.651,
    "end_sec": 2342.471,
    "zh": "501的周可兴和502的科员一同跑出家门",
    "vi": "Chu Khả Hưng ở phòng 501 và nhân viên phòng 502 cùng chạy ra khỏi nhà."
  },
  {
    "idx": 1601,
    "start": "00:39:02,471",
    "end": "00:39:03,151",
    "start_sec": 2342.471,
    "end_sec": 2343.151,
    "zh": "然而",
    "vi": "Thế nhưng."
  },
  {
    "idx": 1602,
    "start": "00:39:03,151",
    "end": "00:39:04,671",
    "start_sec": 2343.151,
    "end_sec": 2344.671,
    "zh": "给的开门声响起来",
    "vi": "Tiếng mở cửa lại vang lên."
  },
  {
    "idx": 1603,
    "start": "00:39:04,671",
    "end": "00:39:05,711",
    "start_sec": 2344.671,
    "end_sec": 2345.711,
    "zh": "还有炮仗声",
    "vi": "Còn có cả tiếng pháo nổ."
  },
  {
    "idx": 1604,
    "start": "00:39:05,711",
    "end": "00:39:06,611",
    "start_sec": 2345.711,
    "end_sec": 2346.611,
    "zh": "一气坦降",
    "vi": "Mọi thứ kết thúc rồi."
  },
  {
    "idx": 1605,
    "start": "00:39:06,611",
    "end": "00:39:08,691",
    "start_sec": 2346.611,
    "end_sec": 2348.691,
    "zh": "完蛋了",
    "vi": "Tiêu đời rồi."
  },
  {
    "idx": 1606,
    "start": "00:39:08,691",
    "end": "00:39:09,471",
    "start_sec": 2348.691,
    "end_sec": 2349.471,
    "zh": "完蛋了",
    "vi": "Tiêu đời rồi."
  },
  {
    "idx": 1607,
    "start": "00:39:09,471",
    "end": "00:39:10,511",
    "start_sec": 2349.471,
    "end_sec": 2350.511,
    "zh": "我还是出你啊",
    "vi": "Tôi vẫn chưa muốn chết."
  },
  {
    "idx": 1608,
    "start": "00:39:10,511",
    "end": "00:39:11,711",
    "start_sec": 2350.511,
    "end_sec": 2351.711,
    "zh": "我还不想死啊",
    "vi": "Tôi vẫn chưa muốn chết đâu."
  },
  {
    "idx": 1609,
    "start": "00:39:11,711",
    "end": "00:39:15,562",
    "start_sec": 2351.711,
    "end_sec": 2355.562,
    "zh": "唉,晚年居然遇到这么的事,姑娘,看开点吧,怪力乱神不是我们能抵抗的。",
    "vi": "Haizz, cuối đời lại gặp phải chuyện thế này, cô gái à, hãy nghĩ thoáng lên,"
  },
  {
    "idx": 1609,
    "start": "00:39:15,562",
    "end": "00:39:18,931",
    "start_sec": 2355.562,
    "end_sec": 2358.931,
    "zh": "唉,晚年居然遇到这么的事,姑娘,看开点吧,怪力乱神不是我们能抵抗的。",
    "vi": "những chuyện quỷ dị này không phải thứ chúng ta có thể chống lại."
  },
  {
    "idx": 1610,
    "start": "00:39:20,731",
    "end": "00:39:24,345",
    "start_sec": 2360.731,
    "end_sec": 2364.345,
    "zh": "该死,马上六楼了,六楼之后,又是我了,现在跑吗?往哪跑?跑到楼顶,被找上来,还是死,大门不能走,七楼的高度,也不能跳,难道我真的要死吗?在诡异出现的第一天,我就要死。",
    "vi": "Chết tiệt, sắp đến tầng sáu rồi, sau tầng sáu lại đến lượt mình, giờ chạy"
  },
  {
    "idx": 1610,
    "start": "00:39:24,345",
    "end": "00:39:28,184",
    "start_sec": 2364.345,
    "end_sec": 2368.184,
    "zh": "该死,马上六楼了,六楼之后,又是我了,现在跑吗?往哪跑?跑到楼顶,被找上来,还是死,大门不能走,七楼的高度,也不能跳,难道我真的要死吗?在诡异出现的第一天,我就要死。",
    "vi": "sao, chạy đi đâu, chạy lên sân thượng rồi bị tìm thấy thì vẫn chết, cửa chính"
  },
  {
    "idx": 1610,
    "start": "00:39:28,184",
    "end": "00:39:31,798",
    "start_sec": 2368.184,
    "end_sec": 2371.798,
    "zh": "该死,马上六楼了,六楼之后,又是我了,现在跑吗?往哪跑?跑到楼顶,被找上来,还是死,大门不能走,七楼的高度,也不能跳,难道我真的要死吗?在诡异出现的第一天,我就要死。",
    "vi": "không thể đi, độ cao tầng bảy cũng không thể nhảy, chẳng lẽ mình thực sự"
  },
  {
    "idx": 1610,
    "start": "00:39:31,798",
    "end": "00:39:35,411",
    "start_sec": 2371.798,
    "end_sec": 2375.411,
    "zh": "该死,马上六楼了,六楼之后,又是我了,现在跑吗?往哪跑?跑到楼顶,被找上来,还是死,大门不能走,七楼的高度,也不能跳,难道我真的要死吗?在诡异出现的第一天,我就要死。",
    "vi": "phải chết sao, ngay ngày đầu tiên quỷ dị xuất hiện mình đã phải chết rồi."
  },
  {
    "idx": 1611,
    "start": "00:39:35,411",
    "end": "00:39:40,071",
    "start_sec": 2375.411,
    "end_sec": 2380.071,
    "zh": "明天给公司打印机上墨盒",
    "vi": "Ngày mai thay hộp mực cho máy in của công ty."
  },
  {
    "idx": 1612,
    "start": "00:39:40,071",
    "end": "00:39:41,011",
    "start_sec": 2380.071,
    "end_sec": 2381.011,
    "zh": "不省图纸",
    "vi": "Đừng quên bản vẽ."
  },
  {
    "idx": 1613,
    "start": "00:39:41,011",
    "end": "00:39:41,911",
    "start_sec": 2381.011,
    "end_sec": 2381.911,
    "zh": "卧槽",
    "vi": "Cái quái gì thế."
  },
  {
    "idx": 1614,
    "start": "00:39:41,911",
    "end": "00:39:44,351",
    "start_sec": 2381.911,
    "end_sec": 2384.351,
    "zh": "这不是我一个月前给自己发的",
    "vi": "Đây chẳng phải là tin nhắn mình gửi cho bản thân từ một tháng trước sao."
  },
  {
    "idx": 1615,
    "start": "00:39:44,351",
    "end": "00:39:47,191",
    "start_sec": 2384.351,
    "end_sec": 2387.191,
    "zh": "第二天要工作的信息内容",
    "vi": "Nội dung công việc của ngày hôm sau."
  },
  {
    "idx": 1616,
    "start": "00:39:47,191",
    "end": "00:39:56,931",
    "start_sec": 2387.191,
    "end_sec": 2396.931,
    "zh": "肠子皮猛逼的扣了一个问号过去",
    "vi": "Anh ta ngơ ngác gửi lại một dấu chấm hỏi."
  },
  {
    "idx": 1617,
    "start": "00:39:56,931",
    "end": "00:39:58,431",
    "start_sec": 2396.931,
    "end_sec": 2398.431,
    "zh": "结果对面正在鸟咕",
    "vi": "Kết quả đối phương đang gõ chữ."
  },
  {
    "idx": 1618,
    "start": "00:39:58,431",
    "end": "00:39:59,511",
    "start_sec": 2398.431,
    "end_sec": 2399.511,
    "zh": "卧槽",
    "vi": "Cái quái gì thế."
  },
  {
    "idx": 1619,
    "start": "00:40:00,000",
    "end": "00:40:01,920",
    "start_sec": 2400.0,
    "end_sec": 2401.92,
    "zh": "该不会正在和一个月之前的自己聊天吧",
    "vi": "Chẳng lẽ mình đang trò chuyện với bản thân của một tháng trước sao."
  },
  {
    "idx": 1620,
    "start": "00:40:01,920",
    "end": "00:40:04,160",
    "start_sec": 2401.92,
    "end_sec": 2404.16,
    "zh": "就在他既猛逼又惊喜的时候",
    "vi": "Ngay lúc anh ta vừa ngơ ngác vừa kinh ngạc."
  },
  {
    "idx": 1621,
    "start": "00:40:04,160",
    "end": "00:40:06,700",
    "start_sec": 2404.16,
    "end_sec": 2406.7,
    "zh": "恐怖的敲门声从六楼传来",
    "vi": "Tiếng gõ cửa kinh hoàng truyền đến từ tầng sáu."
  },
  {
    "idx": 1622,
    "start": "00:40:06,700",
    "end": "00:40:09,600",
    "start_sec": 2406.7,
    "end_sec": 2409.6,
    "zh": "你别过来",
    "vi": "Mày đừng qua đây."
  },
  {
    "idx": 1623,
    "start": "00:40:09,600",
    "end": "00:40:13,440",
    "start_sec": 2409.6,
    "end_sec": 2413.44,
    "zh": "不不",
    "vi": "Không không."
  },
  {
    "idx": 1624,
    "start": "00:40:13,440",
    "end": "00:40:14,800",
    "start_sec": 2413.44,
    "end_sec": 2414.8,
    "zh": "我不要被你杀死",
    "vi": "Tao không muốn bị mày giết."
  },
  {
    "idx": 1625,
    "start": "00:40:14,800",
    "end": "00:40:15,900",
    "start_sec": 2414.8,
    "end_sec": 2415.9,
    "zh": "我宁愿自杀",
    "vi": "Tao thà tự sát còn hơn."
  },
  {
    "idx": 1626,
    "start": "00:40:30,000",
    "end": "00:40:35,800",
    "start_sec": 2430.0,
    "end_sec": 2435.8,
    "zh": "该死",
    "vi": "Khốn kiếp."
  },
  {
    "idx": 1627,
    "start": "00:40:35,800",
    "end": "00:40:37,060",
    "start_sec": 2435.8,
    "end_sec": 2437.06,
    "zh": "他到603了",
    "vi": "Hắn đến phòng 603 rồi."
  },
  {
    "idx": 1628,
    "start": "00:40:37,060",
    "end": "00:40:38,720",
    "start_sec": 2437.06,
    "end_sec": 2438.72,
    "zh": "下一个就是我了",
    "vi": "Người tiếp theo sẽ là mình."
  },
  {
    "idx": 1629,
    "start": "00:40:38,720",
    "end": "00:40:41,340",
    "start_sec": 2438.72,
    "end_sec": 2441.34,
    "zh": "到底",
    "vi": "Rốt cuộc."
  },
  {
    "idx": 1630,
    "start": "00:40:41,340",
    "end": "00:40:42,480",
    "start_sec": 2441.34,
    "end_sec": 2442.48,
    "zh": "到底要怎样做",
    "vi": "Rốt cuộc phải làm thế nào."
  },
  {
    "idx": 1631,
    "start": "00:40:42,480",
    "end": "00:40:44,080",
    "start_sec": 2442.48,
    "end_sec": 2444.08,
    "zh": "才能改变整此的现状",
    "vi": "Mới có thể thay đổi được tình trạng hiện tại."
  },
  {
    "idx": 1632,
    "start": "00:40:44,080",
    "end": "00:40:44,720",
    "start_sec": 2444.08,
    "end_sec": 2444.72,
    "zh": "一楼",
    "vi": "Tầng một."
  },
  {
    "idx": 1633,
    "start": "00:40:44,720",
    "end": "00:40:45,360",
    "start_sec": 2444.72,
    "end_sec": 2445.36,
    "zh": "火光",
    "vi": "Ánh lửa."
  },
  {
    "idx": 1634,
    "start": "00:40:45,360",
    "end": "00:40:45,960",
    "start_sec": 2445.36,
    "end_sec": 2445.96,
    "zh": "敲门",
    "vi": "Gõ cửa."
  },
  {
    "idx": 1635,
    "start": "00:40:45,960",
    "end": "00:40:46,820",
    "start_sec": 2445.96,
    "end_sec": 2446.82,
    "zh": "烟花炮仗",
    "vi": "Pháo hoa."
  },
  {
    "idx": 1636,
    "start": "00:40:46,820",
    "end": "00:40:47,800",
    "start_sec": 2446.82,
    "end_sec": 2447.8,
    "zh": "基本可以断定",
    "vi": "Cơ bản có thể khẳng định."
  },
  {
    "idx": 1637,
    "start": "00:40:47,800",
    "end": "00:40:48,480",
    "start_sec": 2447.8,
    "end_sec": 2448.48,
    "zh": "这只鬼异",
    "vi": "Con quỷ này."
  },
  {
    "idx": 1638,
    "start": "00:40:48,480",
    "end": "00:40:50,460",
    "start_sec": 2448.48,
    "end_sec": 2450.46,
    "zh": "就是101的老奶奶和熊孩子",
    "vi": "Chính là bà cụ và đứa trẻ nghịch ngợm ở phòng 101."
  },
  {
    "idx": 1639,
    "start": "00:40:50,460",
    "end": "00:40:51,840",
    "start_sec": 2450.46,
    "end_sec": 2451.84,
    "zh": "如果",
    "vi": "Nếu như."
  },
  {
    "idx": 1640,
    "start": "00:40:51,840",
    "end": "00:40:53,200",
    "start_sec": 2451.84,
    "end_sec": 2453.2,
    "zh": "让一个月前的自己",
    "vi": "Để bản thân của một tháng trước."
  },
  {
    "idx": 1641,
    "start": "00:40:53,200",
    "end": "00:40:54,460",
    "start_sec": 2453.2,
    "end_sec": 2454.46,
    "zh": "搬离林平小区呢",
    "vi": "Chuyển đi khỏi khu chung cư Lâm Bình thì sao."
  },
  {
    "idx": 1642,
    "start": "00:40:54,460",
    "end": "00:40:55,040",
    "start_sec": 2454.46,
    "end_sec": 2455.04,
    "zh": "不",
    "vi": "Không."
  },
  {
    "idx": 1643,
    "start": "00:40:55,040",
    "end": "00:40:55,520",
    "start_sec": 2455.04,
    "end_sec": 2455.52,
    "zh": "不行",
    "vi": "Không được."
  },
  {
    "idx": 1644,
    "start": "00:40:55,520",
    "end": "00:40:57,340",
    "start_sec": 2455.52,
    "end_sec": 2457.34,
    "zh": "如果一个月前离开林平小区",
    "vi": "Nếu một tháng trước rời khỏi khu chung cư Lâm Bình."
  },
  {
    "idx": 1645,
    "start": "00:40:57,340",
    "end": "00:40:58,640",
    "start_sec": 2457.34,
    "end_sec": 2458.64,
    "zh": "一个月后鬼迷降临",
    "vi": "Một tháng sau khi sương mù quỷ dị ập đến."
  },
  {
    "idx": 1646,
    "start": "00:40:58,640",
    "end": "00:41:01,500",
    "start_sec": 2458.64,
    "end_sec": 2461.5,
    "zh": "我现在说不定会遇到比枪门鬼更可怕的存在",
    "vi": "Bây giờ chưa biết chừng mình sẽ gặp phải thứ còn đáng sợ hơn cả quỷ gõ cửa."
  },
  {
    "idx": 1647,
    "start": "00:41:01,500",
    "end": "00:41:04,260",
    "start_sec": 2461.5,
    "end_sec": 2464.26,
    "zh": "有没有可能在不离开这栋楼的情况下",
    "vi": "Liệu có khả năng nào không cần rời khỏi tòa nhà này."
  },
  {
    "idx": 1648,
    "start": "00:41:04,260",
    "end": "00:41:05,460",
    "start_sec": 2464.26,
    "end_sec": 2465.46,
    "zh": "避开它呢",
    "vi": "Mà vẫn tránh được nó không."
  },
  {
    "idx": 1649,
    "start": "00:41:05,460",
    "end": "00:41:08,220",
    "start_sec": 2465.46,
    "end_sec": 2468.22,
    "zh": "一楼",
    "vi": "Tầng một."
  },
  {
    "idx": 1650,
    "start": "00:41:08,220",
    "end": "00:41:10,060",
    "start_sec": 2468.22,
    "end_sec": 2470.06,
    "zh": "如果我一个月前搬到101区",
    "vi": "Nếu một tháng trước mình chuyển đến phòng 101."
  },
  {
    "idx": 1651,
    "start": "00:41:10,060",
    "end": "00:41:12,420",
    "start_sec": 2470.06,
    "end_sec": 2472.42,
    "zh": "那么枪门鬼会敲自家门吗",
    "vi": "Vậy thì con quỷ gõ cửa có gõ cửa nhà mình không."
  },
  {
    "idx": 1652,
    "start": "00:41:12,420",
    "end": "00:41:13,020",
    "start_sec": 2472.42,
    "end_sec": 2473.02,
    "zh": "此时",
    "vi": "Lúc này."
  },
  {
    "idx": 1653,
    "start": "00:41:13,020",
    "end": "00:41:14,720",
    "start_sec": 2473.02,
    "end_sec": 2474.72,
    "zh": "603传来惨叫声",
    "vi": "Từ phòng 603 phát ra tiếng hét thảm thiết."
  },
  {
    "idx": 1654,
    "start": "00:41:14,720",
    "end": "00:41:15,600",
    "start_sec": 2474.72,
    "end_sec": 2475.6,
    "zh": "一号响声",
    "vi": "Tiếng động đầu tiên vang lên."
  },
  {
    "idx": 1655,
    "start": "00:41:15,600",
    "end": "00:41:17,900",
    "start_sec": 2475.6,
    "end_sec": 2477.9,
    "zh": "长子皮已经没时间想那么多",
    "vi": "Trần Tử Bì không còn thời gian để suy nghĩ nhiều nữa."
  },
  {
    "idx": 1656,
    "start": "00:41:17,900",
    "end": "00:41:18,820",
    "start_sec": 2477.9,
    "end_sec": 2478.82,
    "zh": "都要死了",
    "vi": "Sắp chết đến nơi rồi."
  },
  {
    "idx": 1657,
    "start": "00:41:18,820",
    "end": "00:41:20,400",
    "start_sec": 2478.82,
    "end_sec": 2480.4,
    "zh": "总要试一试",
    "vi": "Dù sao cũng phải thử một lần."
  },
  {
    "idx": 1658,
    "start": "00:41:20,400",
    "end": "00:41:20,940",
    "start_sec": 2480.4,
    "end_sec": 2480.94,
    "zh": "喂",
    "vi": "Alo."
  },
  {
    "idx": 1659,
    "start": "00:41:20,940",
    "end": "00:41:21,900",
    "start_sec": 2480.94,
    "end_sec": 2481.9,
    "zh": "不管你信不信",
    "vi": "Dù bạn có tin hay không."
  },
  {
    "idx": 1660,
    "start": "00:41:21,900",
    "end": "00:41:22,980",
    "start_sec": 2481.9,
    "end_sec": 2482.98,
    "zh": "我是一个月后的你",
    "vi": "Tôi chính là bạn của một tháng sau."
  },
  {
    "idx": 1661,
    "start": "00:41:22,980",
    "end": "00:41:24,640",
    "start_sec": 2482.98,
    "end_sec": 2484.64,
    "zh": "我现在遇到了要命的情况",
    "vi": "Bây giờ tôi đang gặp phải tình huống nguy hiểm đến tính mạng."
  },
  {
    "idx": 1662,
    "start": "00:41:24,640",
    "end": "00:41:26,340",
    "start_sec": 2484.64,
    "end_sec": 2486.34,
    "zh": "你配合我马上去搬家",
    "vi": "Bạn hãy phối hợp với tôi và chuyển nhà ngay lập tức."
  },
  {
    "idx": 1663,
    "start": "00:41:26,340",
    "end": "00:41:27,660",
    "start_sec": 2486.34,
    "end_sec": 2487.66,
    "zh": "搬到楼下101房间",
    "vi": "Chuyển xuống phòng 101 ở tầng dưới."
  },
  {
    "idx": 1664,
    "start": "00:41:27,660",
    "end": "00:41:30,520",
    "start_sec": 2487.66,
    "end_sec": 2490.52,
    "zh": "卧槽",
    "vi": "Cái gì thế này."
  },
  {
    "idx": 1665,
    "start": "00:41:30,520",
    "end": "00:41:32,240",
    "start_sec": 2490.52,
    "end_sec": 2492.24,
    "zh": "现在诈骗手段都这么高了吗",
    "vi": "Bây giờ chiêu trò lừa đảo đã tinh vi thế này rồi sao."
  },
  {
    "idx": 1666,
    "start": "00:41:32,240",
    "end": "00:41:33,120",
    "start_sec": 2492.24,
    "end_sec": 2493.12,
    "zh": "你当我傻呀",
    "vi": "Bạn nghĩ tôi ngốc chắc."
  },
  {
    "idx": 1667,
    "start": "00:41:33,120",
    "end": "00:41:34,560",
    "start_sec": 2493.12,
    "end_sec": 2494.56,
    "zh": "被一个月前的自己骂",
    "vi": "Bị chính bản thân của một tháng trước mắng."
  },
  {
    "idx": 1668,
    "start": "00:41:34,560",
    "end": "00:41:35,860",
    "start_sec": 2494.56,
    "end_sec": 2495.86,
    "zh": "橙子皮极其无语",
    "vi": "Trần Tử Bì vô cùng cạn lời."
  },
  {
    "idx": 1669,
    "start": "00:41:35,860",
    "end": "00:41:37,740",
    "start_sec": 2495.86,
    "end_sec": 2497.74,
    "zh": "他可没时间在这跟自己斗嘴",
    "vi": "Anh ấy không có thời gian để cãi nhau với chính mình ở đây."
  },
  {
    "idx": 1670,
    "start": "00:41:37,740",
    "end": "00:41:39,060",
    "start_sec": 2497.74,
    "end_sec": 2499.06,
    "zh": "连忙发了一张图片",
    "vi": "Vội vàng gửi một bức ảnh."
  },
  {
    "idx": 1671,
    "start": "00:41:39,060",
    "end": "00:41:39,1000",
    "start_sec": 2499.06,
    "end_sec": 2500.0,
    "zh": "并配上一段话",
    "vi": "Kèm theo một đoạn tin nhắn."
  },
  {
    "idx": 1672,
    "start": "00:41:39,1000",
    "end": "00:41:41,040",
    "start_sec": 2500.0,
    "end_sec": 2501.04,
    "zh": "我有办法证明",
    "vi": "我有办法证明"
  },
  {
    "idx": 1673,
    "start": "00:41:41,040",
    "end": "00:41:42,260",
    "start_sec": 2501.04,
    "end_sec": 2502.26,
    "zh": "你在福利院长大",
    "vi": "Bạn lớn lên ở viện mồ côi."
  },
  {
    "idx": 1674,
    "start": "00:41:42,260",
    "end": "00:41:42,920",
    "start_sec": 2502.26,
    "end_sec": 2502.92,
    "zh": "三本毕业",
    "vi": "Tốt nghiệp đại học dân lập."
  },
  {
    "idx": 1675,
    "start": "00:41:42,920",
    "end": "00:41:43,700",
    "start_sec": 2502.92,
    "end_sec": 2503.7,
    "zh": "找到的公司",
    "vi": "Tìm được một công ty."
  },
  {
    "idx": 1676,
    "start": "00:41:43,700",
    "end": "00:41:44,340",
    "start_sec": 2503.7,
    "end_sec": 2504.34,
    "zh": "做设计",
    "vi": "Làm về thiết kế."
  },
  {
    "idx": 1677,
    "start": "00:41:44,340",
    "end": "00:41:45,220",
    "start_sec": 2504.34,
    "end_sec": 2505.22,
    "zh": "月经四千五",
    "vi": "Lương tháng bốn triệu rưỡi."
  },
  {
    "idx": 1678,
    "start": "00:41:45,220",
    "end": "00:41:46,420",
    "start_sec": 2505.22,
    "end_sec": 2506.42,
    "zh": "八岁喜欢同桌小方",
    "vi": "Tám tuổi thích cô bạn cùng bàn tên Tiểu Phương."
  },
  {
    "idx": 1679,
    "start": "00:41:46,420",
    "end": "00:41:48,100",
    "start_sec": 2506.42,
    "end_sec": 2508.1,
    "zh": "十二岁喜欢新来的音乐老师",
    "vi": "Mười hai tuổi thích giáo viên dạy nhạc mới chuyển đến."
  },
  {
    "idx": 1680,
    "start": "00:41:48,100",
    "end": "00:41:49,300",
    "start_sec": 2508.1,
    "end_sec": 2509.3,
    "zh": "十三岁第一次梦一",
    "vi": "Mười ba tuổi lần đầu tiên mộng tinh."
  },
  {
    "idx": 1681,
    "start": "00:41:49,300",
    "end": "00:41:50,020",
    "start_sec": 2509.3,
    "end_sec": 2510.02,
    "zh": "梦一对象",
    "vi": "Đối tượng trong mơ."
  },
  {
    "idx": 1682,
    "start": "00:41:50,020",
    "end": "00:41:51,720",
    "start_sec": 2510.02,
    "end_sec": 2511.72,
    "zh": "然而",
    "vi": "Tuy nhiên."
  },
  {
    "idx": 1683,
    "start": "00:41:51,720",
    "end": "00:41:53,100",
    "start_sec": 2511.72,
    "end_sec": 2513.1,
    "zh": "无论橙子皮说什么",
    "vi": "Dù cho Trần Tử Bì có nói gì."
  },
  {
    "idx": 1684,
    "start": "00:41:53,100",
    "end": "00:41:55,060",
    "start_sec": 2513.1,
    "end_sec": 2515.06,
    "zh": "那边都无动于衷",
    "vi": "Phía bên kia vẫn hoàn toàn im lặng."
  },
  {
    "idx": 1685,
    "start": "00:41:55,060",
    "end": "00:41:55,500",
    "start_sec": 2515.06,
    "end_sec": 2515.5,
    "zh": "卧槽",
    "vi": "Chết tiệt."
  },
  {
    "idx": 1686,
    "start": "00:41:55,500",
    "end": "00:41:56,440",
    "start_sec": 2515.5,
    "end_sec": 2516.44,
    "zh": "如此警惕",
    "vi": "Cảnh giác đến thế sao."
  },
  {
    "idx": 1687,
    "start": "00:41:56,440",
    "end": "00:41:57,420",
    "start_sec": 2516.44,
    "end_sec": 2517.42,
    "zh": "不愧是我",
    "vi": "Đúng là tôi có khác."
  },
  {
    "idx": 1688,
    "start": "00:41:57,420",
    "end": "00:42:00,300",
    "start_sec": 2517.42,
    "end_sec": 2520.3,
    "zh": "突然橙子皮似乎想到什么",
    "vi": "Đột nhiên Trần Tử Bì như nghĩ ra điều gì."
  },
  {
    "idx": 1689,
    "start": "00:42:00,300",
    "end": "00:42:01,340",
    "start_sec": 2520.3,
    "end_sec": 2521.34,
    "zh": "留下彩票店",
    "vi": "Để lại tiệm vé số."
  },
  {
    "idx": 1690,
    "start": "00:42:01,340",
    "end": "00:42:03,540",
    "start_sec": 2521.34,
    "end_sec": 2523.54,
    "zh": "呱呱乐大旗有六千元大奖",
    "vi": "Vé số cào trúng thưởng lớn sáu nghìn tệ."
  },
  {
    "idx": 1691,
    "start": "00:42:03,540",
    "end": "00:42:06,000",
    "start_sec": 2523.54,
    "end_sec": 2526.0,
    "zh": "卧槽",
    "vi": "Chết tiệt."
  },
  {
    "idx": 1692,
    "start": "00:42:06,000",
    "end": "00:42:06,920",
    "start_sec": 2526.0,
    "end_sec": 2526.92,
    "zh": "这么快就来了",
    "vi": "Đến nhanh như vậy sao."
  },
  {
    "idx": 1693,
    "start": "00:42:06,920",
    "end": "00:42:08,460",
    "start_sec": 2526.92,
    "end_sec": 2528.46,
    "zh": "当恐怖的敲门声",
    "vi": "Khi tiếng gõ cửa kinh dị."
  },
  {
    "idx": 1694,
    "start": "00:42:08,460",
    "end": "00:42:10,160",
    "start_sec": 2528.46,
    "end_sec": 2530.16,
    "zh": "在自己屋前响起的那一刻",
    "vi": "Vang lên trước cửa phòng mình."
  },
  {
    "idx": 1695,
    "start": "00:42:10,160",
    "end": "00:42:11,300",
    "start_sec": 2530.16,
    "end_sec": 2531.3,
    "zh": "橙子皮才知道",
    "vi": "Trần Tử Bì mới biết."
  },
  {
    "idx": 1696,
    "start": "00:42:11,300",
    "end": "00:42:13,060",
    "start_sec": 2531.3,
    "end_sec": 2533.06,
    "zh": "什么叫做真正的无能为力",
    "vi": "Thế nào gọi là thực sự bất lực."
  },
  {
    "idx": 1697,
    "start": "00:42:13,060",
    "end": "00:42:13,780",
    "start_sec": 2533.06,
    "end_sec": 2533.78,
    "zh": "因为害怕",
    "vi": "Vì quá sợ hãi."
  },
  {
    "idx": 1698,
    "start": "00:42:13,780",
    "end": "00:42:15,880",
    "start_sec": 2533.78,
    "end_sec": 2535.88,
    "zh": "自由自主的颤抖起来",
    "vi": "Cơ thể không tự chủ được mà run rẩy liên hồi."
  },
  {
    "idx": 1699,
    "start": "00:42:24,660",
    "end": "00:42:25,540",
    "start_sec": 2544.66,
    "end_sec": 2545.54,
    "zh": "果然是你",
    "vi": "Quả nhiên là ngươi."
  },
  {
    "idx": 1700,
    "start": "00:42:25,540",
    "end": "00:42:26,900",
    "start_sec": 2545.54,
    "end_sec": 2546.9,
    "zh": "借着昏落的光线",
    "vi": "Dưới ánh sáng lờ mờ."
  },
  {
    "idx": 1701,
    "start": "00:42:26,900",
    "end": "00:42:27,860",
    "start_sec": 2546.9,
    "end_sec": 2547.86,
    "zh": "也越能看见",
    "vi": "Càng có thể nhìn rõ."
  },
  {
    "idx": 1702,
    "start": "00:42:27,860",
    "end": "00:42:29,800",
    "start_sec": 2547.86,
    "end_sec": 2549.8,
    "zh": "熊孩子趴在老奶奶背上",
    "vi": "Đứa trẻ nghịch ngợm nằm trên lưng bà lão."
  },
  {
    "idx": 1703,
    "start": "00:42:29,800",
    "end": "00:42:31,760",
    "start_sec": 2549.8,
    "end_sec": 2551.76,
    "zh": "两颗脑袋挤在同一个尖头",
    "vi": "Hai cái đầu chen chúc trên cùng một bả vai."
  },
  {
    "idx": 1704,
    "start": "00:42:31,760",
    "end": "00:42:33,860",
    "start_sec": 2551.76,
    "end_sec": 2553.86,
    "zh": "乌黑的肤色像烧焦里的",
    "vi": "Làn da đen nhẻm như bị thiêu cháy."
  },
  {
    "idx": 1705,
    "start": "00:42:33,860",
    "end": "00:42:35,600",
    "start_sec": 2553.86,
    "end_sec": 2555.6,
    "zh": "世间没有后悔啊",
    "vi": "Trên đời này không có thuốc hối hận."
  },
  {
    "idx": 1706,
    "start": "00:42:35,600",
    "end": "00:42:35,840",
    "start_sec": 2555.6,
    "end_sec": 2555.84,
    "zh": "我",
    "vi": "Tôi."
  },
  {
    "idx": 1707,
    "start": "00:42:35,840",
    "end": "00:42:36,580",
    "start_sec": 2555.84,
    "end_sec": 2556.58,
    "zh": "他妈的",
    "vi": "Mẹ kiếp."
  },
  {
    "idx": 1708,
    "start": "00:42:36,580",
    "end": "00:42:37,320",
    "start_sec": 2556.58,
    "end_sec": 2557.32,
    "zh": "也就是你",
    "vi": "Cũng chính là ngươi."
  },
  {
    "idx": 1709,
    "start": "00:42:37,320",
    "end": "00:42:38,200",
    "start_sec": 2557.32,
    "end_sec": 2558.2,
    "zh": "要死了",
    "vi": "Sắp chết rồi."
  },
  {
    "idx": 1710,
    "start": "00:42:38,200",
    "end": "00:42:38,900",
    "start_sec": 2558.2,
    "end_sec": 2558.9,
    "zh": "然而",
    "vi": "Tuy nhiên."
  },
  {
    "idx": 1711,
    "start": "00:42:38,900",
    "end": "00:42:41,360",
    "start_sec": 2558.9,
    "end_sec": 2561.36,
    "zh": "橙子皮还是没有得到任何回应",
    "vi": "Cheng Zi Pi vẫn không nhận được bất kỳ phản hồi nào."
  },
  {
    "idx": 1712,
    "start": "00:42:41,360",
    "end": "00:42:43,220",
    "start_sec": 2561.36,
    "end_sec": 2563.22,
    "zh": "他妈的老鼻太太",
    "vi": "Mẹ kiếp bà già Nose chết tiệt."
  },
  {
    "idx": 1713,
    "start": "00:42:43,220",
    "end": "00:42:43,920",
    "start_sec": 2563.22,
    "end_sec": 2563.92,
    "zh": "都死了",
    "vi": "Đã chết rồi."
  },
  {
    "idx": 1714,
    "start": "00:42:43,920",
    "end": "00:42:44,640",
    "start_sec": 2563.92,
    "end_sec": 2564.64,
    "zh": "还出来作用",
    "vi": "Mà vẫn còn tác oai tác quái."
  },
  {
    "idx": 1715,
    "start": "00:42:44,640",
    "end": "00:42:48,260",
    "start_sec": 2564.64,
    "end_sec": 2568.26,
    "zh": "这个熊孩子的老奶奶",
    "vi": "Bà già của đứa trẻ hư đốn đó."
  },
  {
    "idx": 1716,
    "start": "00:42:48,260",
    "end": "00:42:49,460",
    "start_sec": 2568.26,
    "end_sec": 2569.46,
    "zh": "来到橙子皮身前",
    "vi": "Tiến đến trước mặt Cheng Zi Pi."
  },
  {
    "idx": 1717,
    "start": "00:42:49,460",
    "end": "00:42:50,920",
    "start_sec": 2569.46,
    "end_sec": 2570.92,
    "zh": "她只觉得浑身冰冷",
    "vi": "Hắn chỉ cảm thấy toàn thân lạnh buốt."
  },
  {
    "idx": 1718,
    "start": "00:42:50,920",
    "end": "00:42:51,660",
    "start_sec": 2570.92,
    "end_sec": 2571.66,
    "zh": "汗毛到处",
    "vi": "Lông tơ dựng đứng."
  },
  {
    "idx": 1719,
    "start": "00:42:51,660",
    "end": "00:42:52,700",
    "start_sec": 2571.66,
    "end_sec": 2572.7,
    "zh": "嘴唇如冻的",
    "vi": "Đôi môi cứng đờ vì lạnh."
  },
  {
    "idx": 1720,
    "start": "00:42:52,700",
    "end": "00:42:53,820",
    "start_sec": 2572.7,
    "end_sec": 2573.82,
    "zh": "再也说不出话来",
    "vi": "Không thể thốt nên lời."
  },
  {
    "idx": 1721,
    "start": "00:42:53,820",
    "end": "00:42:54,580",
    "start_sec": 2573.82,
    "end_sec": 2574.58,
    "zh": "随后",
    "vi": "Sau đó."
  },
  {
    "idx": 1722,
    "start": "00:42:54,580",
    "end": "00:42:56,020",
    "start_sec": 2574.58,
    "end_sec": 2576.02,
    "zh": "嘴巴不受控制的长大",
    "vi": "Miệng hắn không tự chủ được mà há to ra."
  },
  {
    "idx": 1723,
    "start": "00:42:56,900",
    "end": "00:43:00,940",
    "start_sec": 2576.9,
    "end_sec": 2580.94,
    "zh": "那熊孩子咯咯咯阴冷的笑着,把炮仗塞进橙子皮嘴里。",
    "vi": "Đứa trẻ hư đốn đó cười khúc khích đầy quỷ dị rồi nhét pháo vào miệng Cheng Zi Pi."
  },
  {
    "idx": 1724,
    "start": "00:43:01,380",
    "end": "00:43:04,160",
    "start_sec": 2581.38,
    "end_sec": 2584.16,
    "zh": "卧槽,他妈的,要死了,要死了。",
    "vi": "Mẹ kiếp, chết tiệt, sắp chết rồi, sắp chết thật rồi."
  },
  {
    "idx": 1725,
    "start": "00:43:04,660",
    "end": "00:43:09,360",
    "start_sec": 2584.66,
    "end_sec": 2589.36,
    "zh": "橙子皮几乎可以想象到脑袋被炮仗炸开的景象,缓缓闭上了眼睛。",
    "vi": "Cheng Zi Pi gần như có thể tưởng tượng ra cảnh đầu mình bị pháo nổ tung nên chậm rãi nhắm mắt lại."
  },
  {
    "idx": 1726,
    "start": "00:43:11,600",
    "end": "00:43:16,226",
    "start_sec": 2591.6,
    "end_sec": 2596.226,
    "zh": "然而,并没有想象中的疼痛感觉来,橙子皮缓缓睁开眼,发现自己的身体,连同客厅里的家具,竟然在一点一点的消失。",
    "vi": "Tuy nhiên, cảm giác đau đớn như tưởng tượng không hề ập đến, Cheng Zi Pi từ từ mở mắt"
  },
  {
    "idx": 1726,
    "start": "00:43:16,226",
    "end": "00:43:20,620",
    "start_sec": 2596.226,
    "end_sec": 2600.62,
    "zh": "然而,并没有想象中的疼痛感觉来,橙子皮缓缓睁开眼,发现自己的身体,连同客厅里的家具,竟然在一点一点的消失。",
    "vi": "ra và phát hiện cơ thể mình cùng với đồ đạc trong phòng khách đang dần dần biến mất."
  },
  {
    "idx": 1727,
    "start": "00:43:26,900",
    "end": "00:43:30,060",
    "start_sec": 2606.9,
    "end_sec": 2610.06,
    "zh": "我没死",
    "vi": "Ta chưa chết."
  },
  {
    "idx": 1728,
    "start": "00:43:30,060",
    "end": "00:43:31,860",
    "start_sec": 2610.06,
    "end_sec": 2611.86,
    "zh": "这是什么情况",
    "vi": "Chuyện này là sao."
  },
  {
    "idx": 1729,
    "start": "00:43:31,860",
    "end": "00:43:34,860",
    "start_sec": 2611.86,
    "end_sec": 2614.86,
    "zh": "橙子皮抬起头",
    "vi": "Cheng Zi Pi ngẩng đầu lên."
  },
  {
    "idx": 1730,
    "start": "00:43:34,860",
    "end": "00:43:35,820",
    "start_sec": 2614.86,
    "end_sec": 2615.82,
    "zh": "才回过神来",
    "vi": "Mới hoàn hồn lại."
  },
  {
    "idx": 1731,
    "start": "00:43:35,820",
    "end": "00:43:39,480",
    "start_sec": 2615.82,
    "end_sec": 2619.48,
    "zh": "发现自己已经出现在另外一个地方了",
    "vi": "Phát hiện mình đã xuất hiện ở một nơi khác."
  },
  {
    "idx": 1732,
    "start": "00:43:39,480",
    "end": "00:43:41,140",
    "start_sec": 2619.48,
    "end_sec": 2621.14,
    "zh": "这是101",
    "vi": "Đây là phòng 101."
  },
  {
    "idx": 1733,
    "start": "00:43:41,140",
    "end": "00:43:42,620",
    "start_sec": 2621.14,
    "end_sec": 2622.62,
    "zh": "看来是一个月前的我",
    "vi": "Xem ra là ta của một tháng trước."
  },
  {
    "idx": 1734,
    "start": "00:43:42,620",
    "end": "00:43:44,260",
    "start_sec": 2622.62,
    "end_sec": 2624.26,
    "zh": "在我死前成功搬家了",
    "vi": "Đã chuyển nhà thành công trước khi ta chết."
  },
  {
    "idx": 1735,
    "start": "00:43:44,260",
    "end": "00:43:46,960",
    "start_sec": 2624.26,
    "end_sec": 2626.96,
    "zh": "看来我猜的不错",
    "vi": "Xem ra ta đoán không sai."
  },
  {
    "idx": 1736,
    "start": "00:43:46,960",
    "end": "00:43:48,660",
    "start_sec": 2626.96,
    "end_sec": 2628.66,
    "zh": "一个月前的我搬到101",
    "vi": "Ta của một tháng trước chuyển đến phòng 101."
  },
  {
    "idx": 1737,
    "start": "00:43:48,660",
    "end": "00:43:50,140",
    "start_sec": 2628.66,
    "end_sec": 2630.14,
    "zh": "现在的我也会相应",
    "vi": "Ta của hiện tại cũng sẽ tương ứng."
  },
  {
    "idx": 1738,
    "start": "00:43:50,140",
    "end": "00:43:50,800",
    "start_sec": 2630.14,
    "end_sec": 2630.8,
    "zh": "出现101",
    "vi": "Xuất hiện ở phòng 101."
  },
  {
    "idx": 1739,
    "start": "00:43:50,800",
    "end": "00:43:52,760",
    "start_sec": 2630.8,
    "end_sec": 2632.76,
    "zh": "浑身冷汗的橙子皮",
    "vi": "Cheng Zi Pi người đầy mồ hôi lạnh."
  },
  {
    "idx": 1740,
    "start": "00:43:52,760",
    "end": "00:43:53,860",
    "start_sec": 2632.76,
    "end_sec": 2633.86,
    "zh": "瘫痪的沙沙声",
    "vi": "Ngã quỵ xuống sàn nhà."
  },
  {
    "idx": 1741,
    "start": "00:43:53,860",
    "end": "00:43:55,420",
    "start_sec": 2633.86,
    "end_sec": 2635.42,
    "zh": "心脏剧烈躁动着",
    "vi": "Trái tim đập liên hồi dữ dội."
  },
  {
    "idx": 1742,
    "start": "00:43:55,420",
    "end": "00:43:56,640",
    "start_sec": 2635.42,
    "end_sec": 2636.64,
    "zh": "劫后余生的感觉",
    "vi": "Cảm giác sống sót sau tai nạn."
  },
  {
    "idx": 1743,
    "start": "00:43:56,640",
    "end": "00:43:57,680",
    "start_sec": 2636.64,
    "end_sec": 2637.68,
    "zh": "让他内心慌紧",
    "vi": "Khiến lòng anh ta hoảng loạn."
  },
  {
    "idx": 1744,
    "start": "00:43:57,680",
    "end": "00:43:59,960",
    "start_sec": 2637.68,
    "end_sec": 2639.96,
    "zh": "干嘛",
    "vi": "Làm gì thế."
  },
  {
    "idx": 1745,
    "start": "00:43:59,960",
    "end": "00:44:01,860",
    "start_sec": 2639.96,
    "end_sec": 2641.86,
    "zh": "卧槽",
    "vi": "Vãi thật."
  },
  {
    "idx": 1746,
    "start": "00:44:01,860",
    "end": "00:44:02,920",
    "start_sec": 2641.86,
    "end_sec": 2642.92,
    "zh": "我家都搬完了",
    "vi": "Nhà tôi dọn đi hết rồi."
  },
  {
    "idx": 1747,
    "start": "00:44:02,920",
    "end": "00:44:03,680",
    "start_sec": 2642.92,
    "end_sec": 2643.68,
    "zh": "你没事吧",
    "vi": "Bạn không sao chứ."
  },
  {
    "idx": 1748,
    "start": "00:44:03,680",
    "end": "00:44:05,460",
    "start_sec": 2643.68,
    "end_sec": 2645.46,
    "zh": "你不是不相信我就是你吗",
    "vi": "Không phải bạn không tin tôi chính là bạn sao."
  },
  {
    "idx": 1749,
    "start": "00:44:05,460",
    "end": "00:44:07,620",
    "start_sec": 2645.46,
    "end_sec": 2647.62,
    "zh": "卧槽",
    "vi": "Vãi thật."
  },
  {
    "idx": 1750,
    "start": "00:44:07,620",
    "end": "00:44:09,100",
    "start_sec": 2647.62,
    "end_sec": 2649.1,
    "zh": "你是不是我这不重要",
    "vi": "Bạn có phải là tôi hay không không quan trọng."
  },
  {
    "idx": 1751,
    "start": "00:44:09,100",
    "end": "00:44:09,880",
    "start_sec": 2649.1,
    "end_sec": 2649.88,
    "zh": "重要的是",
    "vi": "Quan trọng là."
  },
  {
    "idx": 1752,
    "start": "00:44:09,880",
    "end": "00:44:11,020",
    "start_sec": 2649.88,
    "end_sec": 2651.02,
    "zh": "呱呱饿中了六千",
    "vi": "Vé số cào trúng sáu nghìn rồi."
  },
  {
    "idx": 1753,
    "start": "00:44:11,020",
    "end": "00:44:11,940",
    "start_sec": 2651.02,
    "end_sec": 2651.94,
    "zh": "六千啊",
    "vi": "Sáu nghìn đó."
  },
  {
    "idx": 1754,
    "start": "00:44:11,940",
    "end": "00:44:14,280",
    "start_sec": 2651.94,
    "end_sec": 2654.28,
    "zh": "我以后可是得靠你发财",
    "vi": "Sau này tôi phải trông cậy vào bạn để phát tài rồi."
  },
  {
    "idx": 1755,
    "start": "00:44:14,280",
    "end": "00:44:16,000",
    "start_sec": 2654.28,
    "end_sec": 2656.0,
    "zh": "六",
    "vi": "Tuyệt vời."
  },
  {
    "idx": 1756,
    "start": "00:44:16,000",
    "end": "00:44:17,760",
    "start_sec": 2656.0,
    "end_sec": 2657.76,
    "zh": "不愧是我",
    "vi": "Không hổ danh là tôi."
  },
  {
    "idx": 1757,
    "start": "00:44:17,760",
    "end": "00:44:20,300",
    "start_sec": 2657.76,
    "end_sec": 2660.3,
    "zh": "可恶",
    "vi": "Đáng ghét."
  },
  {
    "idx": 1758,
    "start": "00:44:20,300",
    "end": "00:44:20,840",
    "start_sec": 2660.3,
    "end_sec": 2660.84,
    "zh": "可恶",
    "vi": "Đáng ghét."
  },
  {
    "idx": 1759,
    "start": "00:44:20,840",
    "end": "00:44:21,440",
    "start_sec": 2660.84,
    "end_sec": 2661.44,
    "zh": "他来了",
    "vi": "Nó đến rồi."
  },
  {
    "idx": 1760,
    "start": "00:44:21,440",
    "end": "00:44:23,200",
    "start_sec": 2661.44,
    "end_sec": 2663.2,
    "zh": "他怎么知道七零一没人",
    "vi": "Sao nó biết phòng bảy lẻ một không có người."
  },
  {
    "idx": 1761,
    "start": "00:44:23,200",
    "end": "00:44:24,480",
    "start_sec": 2663.2,
    "end_sec": 2664.48,
    "zh": "他来敲我的门了",
    "vi": "Nó đến gõ cửa phòng tôi rồi."
  },
  {
    "idx": 1762,
    "start": "00:44:24,480",
    "end": "00:44:26,020",
    "start_sec": 2664.48,
    "end_sec": 2666.02,
    "zh": "一位长子提翻到101",
    "vi": "Vì Cam Tử Bì đã dọn xuống phòng một lẻ một."
  },
  {
    "idx": 1763,
    "start": "00:44:26,020",
    "end": "00:44:27,740",
    "start_sec": 2666.02,
    "end_sec": 2667.74,
    "zh": "敲门鬼理所应当的",
    "vi": "Nên con quỷ gõ cửa lẽ đương nhiên."
  },
  {
    "idx": 1764,
    "start": "00:44:27,740",
    "end": "00:44:28,460",
    "start_sec": 2667.74,
    "end_sec": 2668.46,
    "zh": "跳过了气",
    "vi": "Đã bỏ qua tầng bảy."
  },
  {
    "idx": 1765,
    "start": "00:44:28,460",
    "end": "00:44:43,000",
    "start_sec": 2668.46,
    "end_sec": 2683.0,
    "zh": "我死了",
    "vi": "Tôi chết chắc rồi."
  },
  {
    "idx": 1766,
    "start": "00:44:43,000",
    "end": "00:44:46,120",
    "start_sec": 2683.0,
    "end_sec": 2686.12,
    "zh": "怒骂声和炮上声响射整栋楼",
    "vi": "Tiếng chửi bới và tiếng chạy huỳnh huỵch vang vọng khắp tòa nhà."
  },
  {
    "idx": 1767,
    "start": "00:44:46,120",
    "end": "00:44:49,220",
    "start_sec": 2686.12,
    "end_sec": 2689.22,
    "zh": "橙子皮几乎能嗅到空气中浓厚的血腥味",
    "vi": "Cam Tử Bì gần như có thể ngửi thấy mùi máu tanh nồng nặc trong không khí."
  },
  {
    "idx": 1768,
    "start": "00:44:49,220",
    "end": "00:44:50,700",
    "start_sec": 2689.22,
    "end_sec": 2690.7,
    "zh": "恐怕今晚过去",
    "vi": "E rằng qua đêm nay."
  },
  {
    "idx": 1769,
    "start": "00:44:50,700",
    "end": "00:44:52,680",
    "start_sec": 2690.7,
    "end_sec": 2692.68,
    "zh": "这栋楼内只剩我一个活人了",
    "vi": "Trong tòa nhà này chỉ còn lại một mình tôi sống sót."
  },
  {
    "idx": 1770,
    "start": "00:44:52,680",
    "end": "00:44:54,040",
    "start_sec": 2692.68,
    "end_sec": 2694.04,
    "zh": "外面的沙漏还在继续",
    "vi": "Đồng hồ cát bên ngoài vẫn tiếp tục chảy."
  },
  {
    "idx": 1771,
    "start": "00:44:54,040",
    "end": "00:44:57,623",
    "start_sec": 2694.04,
    "end_sec": 2697.623,
    "zh": "橙子皮听得断断续续的惨叫声却无动于衷他只是个凡出击救人相当于送死,只能龟缩在101房间里。末日,就这么悄无声息,弹道的降临了,不会以后都是这么水深火热,死里逃生吧?",
    "vi": "Trần Tử Bì nghe thấy những tiếng la hét thảm thiết ngắt quãng nhưng vẫn dửng dưng"
  },
  {
    "idx": 1771,
    "start": "00:44:57,623",
    "end": "00:45:00,363",
    "start_sec": 2697.623,
    "end_sec": 2700.363,
    "zh": "橙子皮听得断断续续的惨叫声却无动于衷他只是个凡出击救人相当于送死,只能龟缩在101房间里。末日,就这么悄无声息,弹道的降临了,不会以后都是这么水深火热,死里逃生吧?",
    "vi": "Anh ta chỉ là một người bình thường, ra ngoài cứu người chẳng"
  },
  {
    "idx": 1771,
    "start": "00:45:00,363",
    "end": "00:45:03,103",
    "start_sec": 2700.363,
    "end_sec": 2703.103,
    "zh": "橙子皮听得断断续续的惨叫声却无动于衷他只是个凡出击救人相当于送死,只能龟缩在101房间里。末日,就这么悄无声息,弹道的降临了,不会以后都是这么水深火热,死里逃生吧?",
    "vi": "khác nào tự sát, nên chỉ có thể trốn tránh trong phòng 101"
  },
  {
    "idx": 1771,
    "start": "00:45:03,103",
    "end": "00:45:06,265",
    "start_sec": 2703.103,
    "end_sec": 2706.265,
    "zh": "橙子皮听得断断续续的惨叫声却无动于衷他只是个凡出击救人相当于送死,只能龟缩在101房间里。末日,就这么悄无声息,弹道的降临了,不会以后都是这么水深火热,死里逃生吧?",
    "vi": "Ngày tận thế cứ thế lặng lẽ ập đến, không lẽ sau này đều phải"
  },
  {
    "idx": 1771,
    "start": "00:45:06,265",
    "end": "00:45:09,637",
    "start_sec": 2706.265,
    "end_sec": 2709.637,
    "zh": "橙子皮听得断断续续的惨叫声却无动于衷他只是个凡出击救人相当于送死,只能龟缩在101房间里。末日,就这么悄无声息,弹道的降临了,不会以后都是这么水深火热,死里逃生吧?",
    "vi": "sống trong cảnh dầu sôi lửa bỏng, tìm đường sống trong cái chết thế này sao"
  },
  {
    "idx": 1772,
    "start": "00:45:12,437",
    "end": "00:45:15,673",
    "start_sec": 2712.437,
    "end_sec": 2715.673,
    "zh": "长着皮,太阳看了看一楼的屋外,血月香大地,扩洒着青红,寂静云天,宛如地狱。",
    "vi": "Trần Tử Bì nhìn ra bên ngoài tầng một, vầng trăng máu tỏa ánh sáng"
  },
  {
    "idx": 1772,
    "start": "00:45:15,673",
    "end": "00:45:18,477",
    "start_sec": 2715.673,
    "end_sec": 2718.477,
    "zh": "长着皮,太阳看了看一楼的屋外,血月香大地,扩洒着青红,寂静云天,宛如地狱。",
    "vi": "đỏ xanh xuống mặt đất, bầu trời tĩnh lặng như chốn địa ngục."
  },
  {
    "idx": 1773,
    "start": "00:45:18,477",
    "end": "00:45:20,657",
    "start_sec": 2718.477,
    "end_sec": 2720.657,
    "zh": "卧槽",
    "vi": "Chết tiệt"
  },
  {
    "idx": 1774,
    "start": "00:45:20,657",
    "end": "00:45:21,717",
    "start_sec": 2720.657,
    "end_sec": 2721.717,
    "zh": "不对劲啊",
    "vi": "Có gì đó không ổn"
  },
  {
    "idx": 1775,
    "start": "00:45:21,717",
    "end": "00:45:23,337",
    "start_sec": 2721.717,
    "end_sec": 2723.337,
    "zh": "为什么小不生在我门口啊",
    "vi": "Tại sao tiếng bước chân lại ở ngay cửa phòng tôi thế này"
  },
  {
    "idx": 1776,
    "start": "00:45:23,337",
    "end": "00:45:23,877",
    "start_sec": 2723.337,
    "end_sec": 2723.877,
    "zh": "为什么",
    "vi": "Tại sao chứ"
  },
  {
    "idx": 1777,
    "start": "00:45:23,877",
    "end": "00:45:26,457",
    "start_sec": 2723.877,
    "end_sec": 2726.457,
    "zh": "凭什么他跳过801啊",
    "vi": "Tại sao nó lại bỏ qua phòng 801 chứ"
  },
  {
    "idx": 1778,
    "start": "00:45:26,457",
    "end": "00:45:29,237",
    "start_sec": 2726.457,
    "end_sec": 2729.237,
    "zh": "801也被跳过了",
    "vi": "Phòng 801 cũng bị bỏ qua rồi"
  },
  {
    "idx": 1779,
    "start": "00:45:29,237",
    "end": "00:45:30,737",
    "start_sec": 2729.237,
    "end_sec": 2730.737,
    "zh": "为什么会跳过801",
    "vi": "Tại sao lại bỏ qua phòng 801"
  },
  {
    "idx": 1780,
    "start": "00:45:30,737",
    "end": "00:45:31,917",
    "start_sec": 2730.737,
    "end_sec": 2731.917,
    "zh": "没记错的话",
    "vi": "Nếu tôi nhớ không lầm"
  },
  {
    "idx": 1781,
    "start": "00:45:31,917",
    "end": "00:45:33,117",
    "start_sec": 2731.917,
    "end_sec": 2733.117,
    "zh": "801住的是的女白领",
    "vi": "Người sống ở phòng 801 là một cô nàng công sở"
  },
  {
    "idx": 1782,
    "start": "00:45:33,117",
    "end": "00:45:33,997",
    "start_sec": 2733.117,
    "end_sec": 2733.997,
    "zh": "叫罗倩来着",
    "vi": "Tên là La Thiến"
  },
  {
    "idx": 1783,
    "start": "00:45:33,997",
    "end": "00:45:36,417",
    "start_sec": 2733.997,
    "end_sec": 2736.417,
    "zh": "为什么枪门鬼会跳过801呢",
    "vi": "Tại sao con quỷ gõ cửa lại bỏ qua phòng 801 chứ"
  },
  {
    "idx": 1784,
    "start": "00:45:36,417",
    "end": "00:45:37,637",
    "start_sec": 2736.417,
    "end_sec": 2737.637,
    "zh": "操",
    "vi": "Mẹ kiếp"
  },
  {
    "idx": 1785,
    "start": "00:45:37,637",
    "end": "00:45:38,357",
    "start_sec": 2737.637,
    "end_sec": 2738.357,
    "zh": "凭什么",
    "vi": "Dựa vào cái gì chứ"
  },
  {
    "idx": 1786,
    "start": "00:45:38,357",
    "end": "00:45:41,417",
    "start_sec": 2738.357,
    "end_sec": 2741.417,
    "zh": "凭什么那个天天穿丝袜的骚货没事啊",
    "vi": "Tại sao con ả lẳng lơ ngày nào cũng mặc tất lưới đó lại không sao chứ"
  },
  {
    "idx": 1787,
    "start": "00:45:41,417",
    "end": "00:45:42,537",
    "start_sec": 2741.417,
    "end_sec": 2742.537,
    "zh": "我不服啊",
    "vi": "Tôi không phục"
  },
  {
    "idx": 1788,
    "start": "00:45:42,537",
    "end": "00:45:43,777",
    "start_sec": 2742.537,
    "end_sec": 2743.777,
    "zh": "人与人最怕平时",
    "vi": "Con người sợ nhất là so bì với nhau"
  },
  {
    "idx": 1789,
    "start": "00:45:43,777",
    "end": "00:45:45,177",
    "start_sec": 2743.777,
    "end_sec": 2745.177,
    "zh": "如果说大家都要死",
    "vi": "Nếu như tất cả mọi người đều phải chết"
  },
  {
    "idx": 1790,
    "start": "00:45:45,177",
    "end": "00:45:46,337",
    "start_sec": 2745.177,
    "end_sec": 2746.337,
    "zh": "那凭什么你不死",
    "vi": "Thì dựa vào cái gì mà cô ta lại không chết"
  },
  {
    "idx": 1791,
    "start": "00:45:46,337",
    "end": "00:45:47,817",
    "start_sec": 2746.337,
    "end_sec": 2747.817,
    "zh": "一旦出现个别例外",
    "vi": "Một khi xuất hiện ngoại lệ"
  },
  {
    "idx": 1792,
    "start": "00:45:47,817",
    "end": "00:45:49,497",
    "start_sec": 2747.817,
    "end_sec": 2749.497,
    "zh": "大家的心理就会不平衡",
    "vi": "Tâm lý của mọi người sẽ mất cân bằng"
  },
  {
    "idx": 1793,
    "start": "00:45:49,497",
    "end": "00:45:51,117",
    "start_sec": 2749.497,
    "end_sec": 2751.117,
    "zh": "就像现在的无害作战",
    "vi": "Giống như Ngô Hải lúc này"
  },
  {
    "idx": 1794,
    "start": "00:45:51,117",
    "end": "00:45:54,557",
    "start_sec": 2751.117,
    "end_sec": 2754.557,
    "zh": "别 别杀我",
    "vi": "Đừng đừng giết tôi"
  },
  {
    "idx": 1795,
    "start": "00:45:54,557",
    "end": "00:45:55,317",
    "start_sec": 2754.557,
    "end_sec": 2755.317,
    "zh": "我求求你",
    "vi": "Tôi xin bà"
  },
  {
    "idx": 1796,
    "start": "00:45:55,317",
    "end": "00:45:56,737",
    "start_sec": 2755.317,
    "end_sec": 2756.737,
    "zh": "你要什么我都给你",
    "vi": "Bà muốn gì tôi cũng cho"
  },
  {
    "idx": 1797,
    "start": "00:45:56,737",
    "end": "00:45:57,917",
    "start_sec": 2756.737,
    "end_sec": 2757.917,
    "zh": "别杀我",
    "vi": "Đừng giết tôi"
  },
  {
    "idx": 1798,
    "start": "00:45:57,917",
    "end": "00:45:59,897",
    "start_sec": 2757.917,
    "end_sec": 2759.897,
    "zh": "该死的鬼老太太",
    "vi": "Mụ già quỷ quái đáng chết"
  },
  {
    "idx": 1799,
    "start": "00:45:59,897",
    "end": "00:46:01,077",
    "start_sec": 2759.897,
    "end_sec": 2761.077,
    "zh": "一路杀到八楼",
    "vi": "Đã giết một mạch lên đến tầng tám"
  },
  {
    "idx": 1800,
    "start": "00:46:01,077",
    "end": "00:46:02,157",
    "start_sec": 2761.077,
    "end_sec": 2762.157,
    "zh": "接下来会干什么",
    "vi": "Tiếp theo bà ta sẽ làm gì"
  },
  {
    "idx": 1801,
    "start": "00:46:02,157",
    "end": "00:46:04,037",
    "start_sec": 2762.157,
    "end_sec": 2764.037,
    "zh": "是跑到楼顶还是下楼",
    "vi": "Là chạy lên sân thượng hay đi xuống lầu."
  },
  {
    "idx": 1802,
    "start": "00:46:04,037",
    "end": "00:46:09,037",
    "start_sec": 2764.037,
    "end_sec": 2769.037,
    "zh": "曹 这是什么东西啊",
    "vi": "Mẹ kiếp, cái quái gì thế này."
  },
  {
    "idx": 1803,
    "start": "00:46:09,037",
    "end": "00:46:09,757",
    "start_sec": 2769.037,
    "end_sec": 2769.757,
    "zh": "救命啊",
    "vi": "Cứu mạng với."
  },
  {
    "idx": 1804,
    "start": "00:46:09,757",
    "end": "00:46:11,717",
    "start_sec": 2769.757,
    "end_sec": 2771.717,
    "zh": "怎么打不死啊",
    "vi": "Sao đánh mãi không chết thế này."
  },
  {
    "idx": 1805,
    "start": "00:46:11,717",
    "end": "00:46:14,077",
    "start_sec": 2771.717,
    "end_sec": 2774.077,
    "zh": "小势力时不时能听到恐吓的叫声",
    "vi": "Trong khu chung cư thỉnh thoảng lại vang lên tiếng la hét kinh hoàng."
  },
  {
    "idx": 1806,
    "start": "00:46:14,077",
    "end": "00:46:15,537",
    "start_sec": 2774.077,
    "end_sec": 2775.537,
    "zh": "兴起是除了敲门鬼",
    "vi": "Có vẻ như ngoài Quỷ Gõ Cửa ra."
  },
  {
    "idx": 1807,
    "start": "00:46:15,537",
    "end": "00:46:17,177",
    "start_sec": 2775.537,
    "end_sec": 2777.177,
    "zh": "还有新的鬼运也在出现",
    "vi": "Còn có những con quỷ mới đang xuất hiện."
  },
  {
    "idx": 1808,
    "start": "00:46:17,177",
    "end": "00:46:18,637",
    "start_sec": 2777.177,
    "end_sec": 2778.637,
    "zh": "进进门窗后",
    "vi": "Sau khi khóa chặt cửa ra vào và cửa sổ."
  },
  {
    "idx": 1809,
    "start": "00:46:18,637",
    "end": "00:46:21,317",
    "start_sec": 2778.637,
    "end_sec": 2781.317,
    "zh": "橙子皮开始检查自己所有的物资",
    "vi": "Trần Tử Bì bắt đầu kiểm tra lại toàn bộ nhu yếu phẩm của mình."
  },
  {
    "idx": 1810,
    "start": "00:46:21,317",
    "end": "00:46:23,657",
    "start_sec": 2781.317,
    "end_sec": 2783.657,
    "zh": "随后陷入了沉沦",
    "vi": "Sau đó cậu ta rơi vào trầm mặc."
  },
  {
    "idx": 1811,
    "start": "00:46:23,657",
    "end": "00:46:25,957",
    "start_sec": 2783.657,
    "end_sec": 2785.957,
    "zh": "因为水和食物最多只够生两天",
    "vi": "Vì nước và thức ăn nhiều nhất cũng chỉ đủ sống trong hai ngày."
  },
  {
    "idx": 1812,
    "start": "00:46:33,477",
    "end": "00:46:35,437",
    "start_sec": 2793.477,
    "end_sec": 2795.437,
    "zh": "橙子皮几乎一夜都没睡着",
    "vi": "Trần Tử Bì hầu như cả đêm không ngủ được."
  },
  {
    "idx": 1813,
    "start": "00:46:35,437",
    "end": "00:46:37,977",
    "start_sec": 2795.437,
    "end_sec": 2797.977,
    "zh": "直到临近早晨才感到和颜一会",
    "vi": "Mãi đến gần sáng mới chợp mắt được một lát."
  },
  {
    "idx": 1814,
    "start": "00:46:37,977",
    "end": "00:46:43,277",
    "start_sec": 2797.977,
    "end_sec": 2803.277,
    "zh": "卧槽",
    "vi": "Mẹ kiếp."
  },
  {
    "idx": 1815,
    "start": "00:46:43,277",
    "end": "00:46:45,177",
    "start_sec": 2803.277,
    "end_sec": 2805.177,
    "zh": "昨晚小区外面发生了什么",
    "vi": "Đêm qua bên ngoài khu chung cư đã xảy ra chuyện gì thế."
  },
  {
    "idx": 1816,
    "start": "00:46:45,177",
    "end": "00:46:45,937",
    "start_sec": 2805.177,
    "end_sec": 2805.937,
    "zh": "这啊",
    "vi": "Thế này là sao."
  },
  {
    "idx": 1817,
    "start": "00:46:45,937",
    "end": "00:46:46,737",
    "start_sec": 2805.937,
    "end_sec": 2806.737,
    "zh": "能出去吗",
    "vi": "Có ra ngoài được không."
  },
  {
    "idx": 1818,
    "start": "00:46:46,737",
    "end": "00:46:50,811",
    "start_sec": 2806.737,
    "end_sec": 2810.811,
    "zh": "橙子皮有些犹豫,如果现在出去没事的话,那么这个时间去找警察也好,去囤积物资也好,都是不错的机会。",
    "vi": "Trần Tử Bì có chút do dự, nếu bây giờ ra ngoài mà không sao, thì tranh thủ lúc"
  },
  {
    "idx": 1818,
    "start": "00:46:50,811",
    "end": "00:46:54,457",
    "start_sec": 2810.811,
    "end_sec": 2814.457,
    "zh": "橙子皮有些犹豫,如果现在出去没事的话,那么这个时间去找警察也好,去囤积物资也好,都是不错的机会。",
    "vi": "này đi tìm cảnh sát hoặc đi tích trữ nhu yếu phẩm đều là cơ hội tốt."
  },
  {
    "idx": 1819,
    "start": "00:46:57,897",
    "end": "00:47:01,497",
    "start_sec": 2817.897,
    "end_sec": 2821.497,
    "zh": "罗宪,罗女士,你是发娄,你们看到现在外面什么情况吗?",
    "vi": "La Hiến, cô La, hai người ở tầng trên, có thấy tình hình bên ngoài bây giờ thế nào không."
  },
  {
    "idx": 1820,
    "start": "00:47:02,877",
    "end": "00:47:05,057",
    "start_sec": 2822.877,
    "end_sec": 2825.057,
    "zh": "橙子皮,你居然没死?",
    "vi": "Trần Tử Bì, cậu vẫn chưa chết sao."
  },
  {
    "idx": 1821,
    "start": "00:47:05,377",
    "end": "00:47:08,448",
    "start_sec": 2825.377,
    "end_sec": 2828.448,
    "zh": "罗宪相当诧异,毕竟在常人看来,橙子皮住在101,一定是第一个被敲门鬼杀的。",
    "vi": "La Hiến vô cùng ngạc nhiên, dù sao trong mắt người thường, Trần Tử Bì sống ở"
  },
  {
    "idx": 1821,
    "start": "00:47:08,448",
    "end": "00:47:11,157",
    "start_sec": 2828.448,
    "end_sec": 2831.157,
    "zh": "罗宪相当诧异,毕竟在常人看来,橙子皮住在101,一定是第一个被敲门鬼杀的。",
    "vi": "phòng 101, chắc chắn phải là người đầu tiên bị Quỷ Gõ Cửa giết chết."
  },
  {
    "idx": 1822,
    "start": "00:47:11,517",
    "end": "00:47:14,797",
    "start_sec": 2831.517,
    "end_sec": 2834.797,
    "zh": "没死,就是也快了,你看看屋外,现在有人出去吗?",
    "vi": "Chưa chết, nhưng cũng sắp rồi, cô nhìn ra ngoài xem, bây giờ có ai ra ngoài không."
  },
  {
    "idx": 1823,
    "start": "00:47:14,797",
    "end": "00:47:16,677",
    "start_sec": 2834.797,
    "end_sec": 2836.677,
    "zh": "我知道你在想什么",
    "vi": "Tôi biết cậu đang nghĩ gì."
  },
  {
    "idx": 1824,
    "start": "00:47:16,677",
    "end": "00:47:18,077",
    "start_sec": 2836.677,
    "end_sec": 2838.077,
    "zh": "我一早也在看了",
    "vi": "Sáng sớm tôi cũng đã quan sát rồi."
  },
  {
    "idx": 1825,
    "start": "00:47:18,077",
    "end": "00:47:19,917",
    "start_sec": 2838.077,
    "end_sec": 2839.917,
    "zh": "很多人家里现在都有吃的",
    "vi": "Bây giờ nhà nhiều người vẫn còn đồ ăn."
  },
  {
    "idx": 1826,
    "start": "00:47:19,917",
    "end": "00:47:21,537",
    "start_sec": 2839.917,
    "end_sec": 2841.537,
    "zh": "谁敢出去啊",
    "vi": "Ai mà dám ra ngoài chứ."
  },
  {
    "idx": 1827,
    "start": "00:47:21,537",
    "end": "00:47:23,357",
    "start_sec": 2841.537,
    "end_sec": 2843.357,
    "zh": "确实现在谁也不敢出去",
    "vi": "Đúng là bây giờ không ai dám ra ngoài cả."
  },
  {
    "idx": 1828,
    "start": "00:47:23,357",
    "end": "00:47:24,157",
    "start_sec": 2843.357,
    "end_sec": 2844.157,
    "zh": "听了",
    "vi": "Nghe này."
  },
  {
    "idx": 1829,
    "start": "00:47:24,157",
    "end": "00:47:25,917",
    "start_sec": 2844.157,
    "end_sec": 2845.917,
    "zh": "三月二的隋平不是还在外面",
    "vi": "Tùy Bình ở phòng 302 không phải vẫn đang ở ngoài sao."
  },
  {
    "idx": 1830,
    "start": "00:47:25,917",
    "end": "00:47:28,317",
    "start_sec": 2845.917,
    "end_sec": 2848.317,
    "zh": "隋平你什么情况啊",
    "vi": "Tùy Bình, tình hình của anh thế nào rồi."
  },
  {
    "idx": 1831,
    "start": "00:47:28,317",
    "end": "00:47:29,177",
    "start_sec": 2848.317,
    "end_sec": 2849.177,
    "zh": "回家了吗",
    "vi": "Đã về nhà chưa."
  },
  {
    "idx": 1832,
    "start": "00:47:29,177",
    "end": "00:47:30,997",
    "start_sec": 2849.177,
    "end_sec": 2850.997,
    "zh": "隋平要是没死的话",
    "vi": "Nếu Tùy Bình chưa chết"
  },
  {
    "idx": 1833,
    "start": "00:47:30,997",
    "end": "00:47:32,797",
    "start_sec": 2850.997,
    "end_sec": 2852.797,
    "zh": "应该很清楚外面的情况吧",
    "vi": "Thì chắc phải nắm rõ tình hình bên ngoài chứ."
  },
  {
    "idx": 1834,
    "start": "00:47:32,797",
    "end": "00:47:34,797",
    "start_sec": 2852.797,
    "end_sec": 2854.797,
    "zh": "然而群里压根没有回音",
    "vi": "Thế nhưng trong nhóm hoàn toàn không có phản hồi nào."
  },
  {
    "idx": 1835,
    "start": "00:47:34,797",
    "end": "00:47:37,017",
    "start_sec": 2854.797,
    "end_sec": 2857.017,
    "zh": "毫无疑问隋平已经死了",
    "vi": "Không còn nghi ngờ gì nữa, Tùy Bình đã chết rồi."
  },
  {
    "idx": 1836,
    "start": "00:47:37,017",
    "end": "00:47:37,577",
    "start_sec": 2857.017,
    "end_sec": 2857.577,
    "zh": "好",
    "vi": "Được rồi."
  },
  {
    "idx": 1837,
    "start": "00:47:37,577",
    "end": "00:47:38,517",
    "start_sec": 2857.577,
    "end_sec": 2858.517,
    "zh": "来起个末日",
    "vi": "Bắt đầu ngày tận thế nào."
  },
  {
    "idx": 1838,
    "start": "00:47:38,517",
    "end": "00:47:40,117",
    "start_sec": 2858.517,
    "end_sec": 2860.117,
    "zh": "事实上",
    "vi": "Thực tế là"
  },
  {
    "idx": 1839,
    "start": "00:47:40,117",
    "end": "00:47:42,337",
    "start_sec": 2860.117,
    "end_sec": 2862.337,
    "zh": "橙子蹄可以联系一个月前的自己",
    "vi": "Trần Tử Bì có thể liên lạc với chính mình của một tháng trước."
  },
  {
    "idx": 1840,
    "start": "00:47:42,337",
    "end": "00:47:44,037",
    "start_sec": 2862.337,
    "end_sec": 2864.037,
    "zh": "食物方面根本不是问题",
    "vi": "Nên vấn đề thức ăn hoàn toàn không đáng lo."
  },
  {
    "idx": 1841,
    "start": "00:47:44,037",
    "end": "00:47:46,117",
    "start_sec": 2864.037,
    "end_sec": 2866.117,
    "zh": "关键是需要了解外界信息",
    "vi": "Điều quan trọng là cần nắm được thông tin bên ngoài."
  },
  {
    "idx": 1842,
    "start": "00:47:46,117",
    "end": "00:47:47,477",
    "start_sec": 2866.117,
    "end_sec": 2867.477,
    "zh": "否则哪天诡异起脸",
    "vi": "Nếu không, lỡ như một ngày thế lực quỷ dị ập đến"
  },
  {
    "idx": 1843,
    "start": "00:47:47,477",
    "end": "00:47:49,117",
    "start_sec": 2867.477,
    "end_sec": 2869.117,
    "zh": "他根本毫无还手之力",
    "vi": "Cậu ấy sẽ hoàn toàn không có sức chống trả."
  },
  {
    "idx": 1844,
    "start": "00:47:49,117",
    "end": "00:47:52,217",
    "start_sec": 2869.117,
    "end_sec": 2872.217,
    "zh": "喂 过去的我",
    "vi": "Này tôi của quá khứ."
  },
  {
    "idx": 1845,
    "start": "00:47:52,217",
    "end": "00:47:53,077",
    "start_sec": 2872.217,
    "end_sec": 2873.077,
    "zh": "从现在开始",
    "vi": "Kể từ bây giờ"
  },
  {
    "idx": 1846,
    "start": "00:47:53,077",
    "end": "00:47:55,417",
    "start_sec": 2873.077,
    "end_sec": 2875.417,
    "zh": "你每天往冰箱里存放一片的食物",
    "vi": "Cậu hãy cất một phần thức ăn vào tủ lạnh mỗi ngày"
  },
  {
    "idx": 1847,
    "start": "00:47:55,417",
    "end": "00:47:56,537",
    "start_sec": 2875.417,
    "end_sec": 2876.537,
    "zh": "并且保证不拆光",
    "vi": "Và bảo đảm là không ăn hết sạch."
  },
  {
    "idx": 1848,
    "start": "00:47:56,537",
    "end": "00:47:58,017",
    "start_sec": 2876.537,
    "end_sec": 2878.017,
    "zh": "另外 如果可以的话",
    "vi": "Ngoài ra nếu được"
  },
  {
    "idx": 1849,
    "start": "00:47:58,017",
    "end": "00:47:59,797",
    "start_sec": 2878.017,
    "end_sec": 2879.797,
    "zh": "你去买一个军用望远镜",
    "vi": "Cậu hãy đi mua một chiếc ống nhòm quân sự."
  },
  {
    "idx": 1850,
    "start": "00:47:59,797",
    "end": "00:48:01,277",
    "start_sec": 2879.797,
    "end_sec": 2881.277,
    "zh": "囤积物资",
    "vi": "Tích trữ nhu yếu phẩm sao."
  },
  {
    "idx": 1851,
    "start": "00:48:01,277",
    "end": "00:48:02,617",
    "start_sec": 2881.277,
    "end_sec": 2882.617,
    "zh": "你遇到丧尸了呀",
    "vi": "Cậu gặp phải thây ma rồi à."
  },
  {
    "idx": 1852,
    "start": "00:48:02,617",
    "end": "00:48:04,277",
    "start_sec": 2882.617,
    "end_sec": 2884.277,
    "zh": "要不要我囤点电盔啥的",
    "vi": "Có cần tôi tích trữ thêm mũ bảo hiểm hay gì không."
  },
  {
    "idx": 1853,
    "start": "00:48:04,277",
    "end": "00:48:06,037",
    "start_sec": 2884.277,
    "end_sec": 2886.037,
    "zh": "没用 囤积啥都没用",
    "vi": "Không có tác dụng đâu, tích trữ gì cũng vô ích."
  },
  {
    "idx": 1854,
    "start": "00:48:06,037",
    "end": "00:48:06,937",
    "start_sec": 2886.037,
    "end_sec": 2886.937,
    "zh": "你先按我说的做",
    "vi": "Cậu cứ làm theo lời tôi nói trước đi."
  },
  {
    "idx": 1855,
    "start": "00:48:06,937",
    "end": "00:48:08,657",
    "start_sec": 2886.937,
    "end_sec": 2888.657,
    "zh": "以后有需要我会再联系你的",
    "vi": "Sau này có nhu cầu tôi sẽ liên lạc lại với cậu."
  },
  {
    "idx": 1856,
    "start": "00:48:08,657",
    "end": "00:48:09,497",
    "start_sec": 2888.657,
    "end_sec": 2889.497,
    "zh": "明白",
    "vi": "Đã rõ."
  },
  {
    "idx": 1857,
    "start": "00:48:09,497",
    "end": "00:48:11,697",
    "start_sec": 2889.497,
    "end_sec": 2891.697,
    "zh": "再到中午的时候",
    "vi": "Đến giữa trưa"
  },
  {
    "idx": 1858,
    "start": "00:48:11,697",
    "end": "00:48:14,277",
    "start_sec": 2891.697,
    "end_sec": 2894.277,
    "zh": "橙子皮惊奇地发现一个金用望远镜",
    "vi": "Trần Tử Bì kinh ngạc phát hiện một chiếc ống nhòm quân sự"
  },
  {
    "idx": 1859,
    "start": "00:48:14,277",
    "end": "00:48:16,317",
    "start_sec": 2894.277,
    "end_sec": 2896.317,
    "zh": "缓缓出现在客厅桌子上",
    "vi": "Từ từ xuất hiện trên bàn phòng khách."
  },
  {
    "idx": 1860,
    "start": "00:48:16,317",
    "end": "00:48:18,017",
    "start_sec": 2896.317,
    "end_sec": 2898.017,
    "zh": "他又快步来到冰箱前",
    "vi": "Cậu ấy lại nhanh chân bước đến trước tủ lạnh."
  },
  {
    "idx": 1861,
    "start": "00:48:18,017",
    "end": "00:48:18,857",
    "start_sec": 2898.017,
    "end_sec": 2898.857,
    "zh": "果不其然",
    "vi": "Quả nhiên là vậy."
  },
  {
    "idx": 1862,
    "start": "00:48:18,857",
    "end": "00:48:20,837",
    "start_sec": 2898.857,
    "end_sec": 2900.837,
    "zh": "里面有三盒蜜蜂的素食炒面",
    "vi": "Bên trong có ba hộp mì xào chay hiệu Con Ong."
  },
  {
    "idx": 1863,
    "start": "00:48:20,837",
    "end": "00:48:22,017",
    "start_sec": 2900.837,
    "end_sec": 2902.017,
    "zh": "食物倒不是问题了",
    "vi": "Thức ăn giờ không còn là vấn đề nữa."
  },
  {
    "idx": 1864,
    "start": "00:48:22,017",
    "end": "00:48:24,217",
    "start_sec": 2902.017,
    "end_sec": 2904.217,
    "zh": "现在还是要想办法了解外面的情况",
    "vi": "Bây giờ vẫn phải tìm cách để nắm bắt tình hình bên ngoài."
  },
  {
    "idx": 1865,
    "start": "00:48:24,217",
    "end": "00:48:27,397",
    "start_sec": 2904.217,
    "end_sec": 2907.397,
    "zh": "现在望远镜有了",
    "vi": "Hiện tại đã có kính viễn vọng rồi."
  },
  {
    "idx": 1866,
    "start": "00:48:27,397",
    "end": "00:48:29,397",
    "start_sec": 2907.397,
    "end_sec": 2909.397,
    "zh": "一楼的视野还是太局限了",
    "vi": "Tầm nhìn ở tầng một vẫn còn quá hạn chế."
  },
  {
    "idx": 1867,
    "start": "00:48:29,397",
    "end": "00:48:30,497",
    "start_sec": 2909.397,
    "end_sec": 2910.497,
    "zh": "想要了解外面的情况",
    "vi": "Nếu muốn biết tình hình bên ngoài."
  },
  {
    "idx": 1868,
    "start": "00:48:30,497",
    "end": "00:48:32,457",
    "start_sec": 2910.497,
    "end_sec": 2912.457,
    "zh": "最好还是顶楼或者七到八楼",
    "vi": "Tốt nhất là lên sân thượng hoặc tầng bảy tầng tám."
  },
  {
    "idx": 1869,
    "start": "00:48:32,457",
    "end": "00:48:35,357",
    "start_sec": 2912.457,
    "end_sec": 2915.357,
    "zh": "如果让一个月前的我",
    "vi": "Nếu để tôi của một tháng trước."
  },
  {
    "idx": 1870,
    "start": "00:48:35,357",
    "end": "00:48:36,357",
    "start_sec": 2915.357,
    "end_sec": 2916.357,
    "zh": "给罗倩送望远镜",
    "vi": "Đưa kính viễn vọng cho La Thiến."
  },
  {
    "idx": 1871,
    "start": "00:48:36,357",
    "end": "00:48:37,917",
    "start_sec": 2916.357,
    "end_sec": 2917.917,
    "zh": "让她帮我探查外面的情况呢",
    "vi": "Để cô ấy giúp tôi thám thính tình hình bên ngoài thì sao."
  },
  {
    "idx": 1872,
    "start": "00:48:37,917",
    "end": "00:48:39,797",
    "start_sec": 2917.917,
    "end_sec": 2919.797,
    "zh": "好像有点不太靠谱",
    "vi": "Nghe có vẻ không đáng tin cậy cho lắm."
  },
  {
    "idx": 1873,
    "start": "00:48:39,797",
    "end": "00:48:40,757",
    "start_sec": 2919.797,
    "end_sec": 2920.757,
    "zh": "罗欠这个女人",
    "vi": "Người phụ nữ tên La Thiến này."
  },
  {
    "idx": 1874,
    "start": "00:48:40,757",
    "end": "00:48:42,017",
    "start_sec": 2920.757,
    "end_sec": 2922.017,
    "zh": "在气动出了名的自私",
    "vi": "Nổi tiếng là ích kỷ trong tòa nhà này."
  },
  {
    "idx": 1875,
    "start": "00:48:42,017",
    "end": "00:48:42,797",
    "start_sec": 2922.017,
    "end_sec": 2922.797,
    "zh": "不可倾向",
    "vi": "Không thể tin tưởng được."
  },
  {
    "idx": 1876,
    "start": "00:48:42,797",
    "end": "00:48:44,977",
    "start_sec": 2922.797,
    "end_sec": 2924.977,
    "zh": "长子皮纠结许久",
    "vi": "Trần Tử Bì đắn đo rất lâu."
  },
  {
    "idx": 1877,
    "start": "00:48:44,977",
    "end": "00:48:46,677",
    "start_sec": 2924.977,
    "end_sec": 2926.677,
    "zh": "还是决定自己行动",
    "vi": "Cuối cùng vẫn quyết định tự mình hành động."
  },
  {
    "idx": 1878,
    "start": "00:48:46,677",
    "end": "00:48:52,157",
    "start_sec": 2926.677,
    "end_sec": 2932.157,
    "zh": "枪门鬼",
    "vi": "Con quỷ gõ cửa."
  },
  {
    "idx": 1879,
    "start": "00:48:52,157",
    "end": "00:48:53,497",
    "start_sec": 2932.157,
    "end_sec": 2933.497,
    "zh": "昨晚杀完八楼的人后",
    "vi": "Sau khi giết người ở tầng tám tối qua."
  },
  {
    "idx": 1880,
    "start": "00:48:53,497",
    "end": "00:48:54,317",
    "start_sec": 2933.497,
    "end_sec": 2934.317,
    "zh": "就消失了",
    "vi": "Nó đã biến mất rồi."
  },
  {
    "idx": 1881,
    "start": "00:48:54,317",
    "end": "00:48:55,977",
    "start_sec": 2934.317,
    "end_sec": 2935.977,
    "zh": "现在只要不离开这栋楼",
    "vi": "Bây giờ chỉ cần không rời khỏi tòa nhà này."
  },
  {
    "idx": 1882,
    "start": "00:48:55,977",
    "end": "00:48:57,237",
    "start_sec": 2935.977,
    "end_sec": 2937.237,
    "zh": "应该能离开房间吧",
    "vi": "Chắc là có thể ra khỏi phòng."
  },
  {
    "idx": 1883,
    "start": "00:48:57,237",
    "end": "00:48:58,837",
    "start_sec": 2937.237,
    "end_sec": 2938.837,
    "zh": "长子皮有些犹豫",
    "vi": "Trần Tử Bì có chút do dự."
  },
  {
    "idx": 1884,
    "start": "00:48:58,837",
    "end": "00:48:59,317",
    "start_sec": 2938.837,
    "end_sec": 2939.317,
    "zh": "好",
    "vi": "Được rồi."
  },
  {
    "idx": 1885,
    "start": "00:48:59,317",
    "end": "00:49:00,057",
    "start_sec": 2939.317,
    "end_sec": 2940.057,
    "zh": "拼一把",
    "vi": "Liều một phen vậy."
  },
  {
    "idx": 1886,
    "start": "00:49:00,057",
    "end": "00:49:01,257",
    "start_sec": 2940.057,
    "end_sec": 2941.257,
    "zh": "总不能坐吃等死",
    "vi": "Không thể cứ ngồi im chờ chết được."
  },
  {
    "idx": 1887,
    "start": "00:49:01,257",
    "end": "00:49:08,517",
    "start_sec": 2941.257,
    "end_sec": 2948.517,
    "zh": "路过二楼时",
    "vi": "Khi đi ngang qua tầng hai."
  },
  {
    "idx": 1888,
    "start": "00:49:08,517",
    "end": "00:49:09,977",
    "start_sec": 2948.517,
    "end_sec": 2949.977,
    "zh": "橙子皮瞄了一眼",
    "vi": "Trần Tử Bì liếc nhìn một cái."
  },
  {
    "idx": 1889,
    "start": "00:49:09,977",
    "end": "00:49:11,237",
    "start_sec": 2949.977,
    "end_sec": 2951.237,
    "zh": "不得的猴皮发麻",
    "vi": "Khiến anh ta nổi cả da gà."
  },
  {
    "idx": 1890,
    "start": "00:49:11,237",
    "end": "00:49:12,657",
    "start_sec": 2951.237,
    "end_sec": 2952.657,
    "zh": "二楼的楼道上",
    "vi": "Trên hành lang của tầng hai."
  },
  {
    "idx": 1891,
    "start": "00:49:12,657",
    "end": "00:49:13,977",
    "start_sec": 2952.657,
    "end_sec": 2953.977,
    "zh": "踏着几具无头尸体",
    "vi": "Giẫm lên vài xác chết không đầu."
  },
  {
    "idx": 1892,
    "start": "00:49:13,977",
    "end": "00:49:15,937",
    "start_sec": 2953.977,
    "end_sec": 2955.937,
    "zh": "正是王美美整人",
    "vi": "Đó chính là nhóm của Vương Mỹ Mỹ."
  },
  {
    "idx": 1893,
    "start": "00:49:15,937",
    "end": "00:49:18,297",
    "start_sec": 2955.937,
    "end_sec": 2958.297,
    "zh": "想着她心中的故事",
    "vi": "Nghĩ về câu chuyện của cô ta."
  },
  {
    "idx": 1894,
    "start": "00:49:18,297",
    "end": "00:49:20,417",
    "start_sec": 2958.297,
    "end_sec": 2960.417,
    "zh": "橙子皮慢慢朝着三楼走进",
    "vi": "Trần Tử Bì chậm rãi bước lên tầng ba."
  },
  {
    "idx": 1895,
    "start": "00:49:20,417",
    "end": "00:49:21,917",
    "start_sec": 2960.417,
    "end_sec": 2961.917,
    "zh": "她没有敢加快步子",
    "vi": "Anh không dám đi nhanh hơn."
  },
  {
    "idx": 1896,
    "start": "00:49:21,917",
    "end": "00:49:24,217",
    "start_sec": 2961.917,
    "end_sec": 2964.217,
    "zh": "生怕敲门鬼在顶楼没有消失",
    "vi": "Chỉ sợ con quỷ gõ cửa vẫn chưa biến mất ở tầng thượng."
  },
  {
    "idx": 1897,
    "start": "00:49:24,217",
    "end": "00:49:25,957",
    "start_sec": 2964.217,
    "end_sec": 2965.957,
    "zh": "一路踏着血泪",
    "vi": "Bước đi trên con đường đầy máu và nước mắt."
  },
  {
    "idx": 1898,
    "start": "00:49:25,957",
    "end": "00:49:27,657",
    "start_sec": 2965.957,
    "end_sec": 2967.657,
    "zh": "橙子皮终于是来到七楼",
    "vi": "Trần Tử Bì cuối cùng cũng lên đến tầng bảy."
  },
  {
    "idx": 1899,
    "start": "00:49:27,657",
    "end": "00:49:29,717",
    "start_sec": 2967.657,
    "end_sec": 2969.717,
    "zh": "踩点朝八楼看了好一会儿",
    "vi": "Anh đứng quan sát hướng lên tầng tám một lúc lâu."
  },
  {
    "idx": 1900,
    "start": "00:49:29,717",
    "end": "00:49:30,457",
    "start_sec": 2969.717,
    "end_sec": 2970.457,
    "zh": "没有任何异常",
    "vi": "Không có bất kỳ điều gì bất thường."
  },
  {
    "idx": 1901,
    "start": "00:49:30,457",
    "end": "00:49:33,097",
    "start_sec": 2970.457,
    "end_sec": 2973.097,
    "zh": "看来敲门鬼白天是不在的",
    "vi": "Có vẻ như con quỷ gõ cửa không xuất hiện vào ban ngày."
  },
  {
    "idx": 1902,
    "start": "00:49:33,097",
    "end": "00:49:34,217",
    "start_sec": 2973.097,
    "end_sec": 2974.217,
    "zh": "心里松下一口气",
    "vi": "Trong lòng anh thở phào nhẹ nhõm."
  },
  {
    "idx": 1903,
    "start": "00:49:34,217",
    "end": "00:49:36,797",
    "start_sec": 2974.217,
    "end_sec": 2976.797,
    "zh": "橙子皮踮着步子来到801的门外",
    "vi": "Trần Tử Bì nhón chân đi đến trước cửa phòng 801."
  },
  {
    "idx": 1904,
    "start": "00:49:36,797",
    "end": "00:49:37,857",
    "start_sec": 2976.797,
    "end_sec": 2977.857,
    "zh": "她没有敲门",
    "vi": "Anh không gõ cửa."
  },
  {
    "idx": 1905,
    "start": "00:49:37,857",
    "end": "00:49:40,297",
    "start_sec": 2977.857,
    "end_sec": 2980.297,
    "zh": "而是将耳朵凑到了801的门上",
    "vi": "Mà ghé sát tai vào cửa phòng 801."
  },
  {
    "idx": 1906,
    "start": "00:49:40,297",
    "end": "00:49:42,937",
    "start_sec": 2980.297,
    "end_sec": 2982.937,
    "zh": "为什么主按枪门鬼会跳过罗倩呢",
    "vi": "Tại sao con quỷ gõ cửa lại bỏ qua La Thiến."
  },
  {
    "idx": 1907,
    "start": "00:49:42,937",
    "end": "00:49:44,537",
    "start_sec": 2982.937,
    "end_sec": 2984.537,
    "zh": "隔着房门长子提隐",
    "vi": "Ngăn cách bởi cánh cửa, Trần Tử Bì mơ hồ."
  },
  {
    "idx": 1908,
    "start": "00:49:44,537",
    "end": "00:49:46,217",
    "start_sec": 2984.537,
    "end_sec": 2986.217,
    "zh": "越能听到哼哧哼哧的门声",
    "vi": "Nghe thấy tiếng thở phì phò bên trong."
  },
  {
    "idx": 1909,
    "start": "00:49:46,217",
    "end": "00:49:48,337",
    "start_sec": 2986.217,
    "end_sec": 2988.337,
    "zh": "有点像是狗哈记的声音",
    "vi": "Hơi giống tiếng thở hồng hộc của chó."
  },
  {
    "idx": 1910,
    "start": "00:49:48,337",
    "end": "00:49:50,177",
    "start_sec": 2988.337,
    "end_sec": 2990.177,
    "zh": "我倒是想起来了",
    "vi": "Anh chợt nhớ ra một chuyện."
  },
  {
    "idx": 1911,
    "start": "00:49:50,177",
    "end": "00:49:52,517",
    "start_sec": 2990.177,
    "end_sec": 2992.517,
    "zh": "罗倩时常会在小区里遛一条黑狗",
    "vi": "La Thiến thường dắt một con chó đen đi dạo trong khu chung cư."
  },
  {
    "idx": 1912,
    "start": "00:49:52,517",
    "end": "00:49:53,137",
    "start_sec": 2992.517,
    "end_sec": 2993.137,
    "zh": "黑狗",
    "vi": "Chó đen sao."
  },
  {
    "idx": 1913,
    "start": "00:49:53,137",
    "end": "00:49:54,037",
    "start_sec": 2993.137,
    "end_sec": 2994.037,
    "zh": "难道",
    "vi": "Chẳng lẽ."
  },
  {
    "idx": 1914,
    "start": "00:49:54,037",
    "end": "00:49:59,382",
    "start_sec": 2994.037,
    "end_sec": 2999.382,
    "zh": "长子提隐没再听下去他马上就下了朝着802进去卧槽看着802的景象橙子皮一阵倒背包墙上地上铺满粘稠的血液",
    "vi": "Trần Tử Bì không nghe tiếp nữa, anh lập tức đi xuống và bước vào phòng 802"
  },
  {
    "idx": 1914,
    "start": "00:49:59,382",
    "end": "00:50:06,614",
    "start_sec": 2999.382,
    "end_sec": 3006.614,
    "zh": "长子提隐没再听下去他马上就下了朝着802进去卧槽看着802的景象橙子皮一阵倒背包墙上地上铺满粘稠的血液",
    "vi": "Trời đất, nhìn cảnh tượng trong phòng 802, Trần Tử Bì buồn nôn, trên tường và dưới đất phủ đầy máu đặc quánh"
  },
  {
    "idx": 1915,
    "start": "00:50:06,614",
    "end": "00:50:08,594",
    "start_sec": 3006.614,
    "end_sec": 3008.594,
    "zh": "以及无海被炸开的脑袋里",
    "vi": "Cùng với cái đầu bị nổ tung của Ngô Hải."
  },
  {
    "idx": 1916,
    "start": "00:50:08,594",
    "end": "00:50:10,874",
    "start_sec": 3008.594,
    "end_sec": 3010.874,
    "zh": "还挂着一颗摇摇欲坠的眼球",
    "vi": "Vẫn còn một con ngươi lủng lẳng sắp rơi ra."
  },
  {
    "idx": 1917,
    "start": "00:50:10,874",
    "end": "00:50:15,834",
    "start_sec": 3010.874,
    "end_sec": 3015.834,
    "zh": "强忍屋中的血腥",
    "vi": "Anh cố nhịn mùi máu tanh trong phòng."
  },
  {
    "idx": 1918,
    "start": "00:50:15,834",
    "end": "00:50:17,114",
    "start_sec": 3015.834,
    "end_sec": 3017.114,
    "zh": "来到了窗户下",
    "vi": "Anh đi đến bên dưới cửa sổ."
  },
  {
    "idx": 1919,
    "start": "00:50:17,114",
    "end": "00:50:18,614",
    "start_sec": 3017.114,
    "end_sec": 3018.614,
    "zh": "该死的末日",
    "vi": "Ngày tận thế chết tiệt."
  },
  {
    "idx": 1920,
    "start": "00:50:18,614",
    "end": "00:50:20,494",
    "start_sec": 3018.614,
    "end_sec": 3020.494,
    "zh": "八楼的血液",
    "vi": "Máu ở tầng tám."
  },
  {
    "idx": 1921,
    "start": "00:50:20,494",
    "end": "00:50:22,154",
    "start_sec": 3020.494,
    "end_sec": 3022.154,
    "zh": "足以远眺整个小区",
    "vi": "Đủ để nhìn bao quát toàn bộ khu chung cư."
  },
  {
    "idx": 1922,
    "start": "00:50:22,154",
    "end": "00:50:23,854",
    "start_sec": 3022.154,
    "end_sec": 3023.854,
    "zh": "橙子皮现在最想看的",
    "vi": "Điều Trần Tử Bì muốn thấy nhất lúc này"
  },
  {
    "idx": 1923,
    "start": "00:50:23,854",
    "end": "00:50:24,974",
    "start_sec": 3023.854,
    "end_sec": 3024.974,
    "zh": "还是有没有人关注",
    "vi": "vẫn là liệu có ai đang chú ý không"
  },
  {
    "idx": 1924,
    "start": "00:50:24,974",
    "end": "00:50:26,394",
    "start_sec": 3024.974,
    "end_sec": 3026.394,
    "zh": "以了解外面的情况",
    "vi": "để nắm bắt tình hình bên ngoài."
  },
  {
    "idx": 1925,
    "start": "00:50:26,394",
    "end": "00:50:27,674",
    "start_sec": 3026.394,
    "end_sec": 3027.674,
    "zh": "寻尸的吸引后",
    "vi": "Sau khi bị thu hút bởi việc tìm xác"
  },
  {
    "idx": 1926,
    "start": "00:50:27,674",
    "end": "00:50:28,834",
    "start_sec": 3027.674,
    "end_sec": 3028.834,
    "zh": "橙子皮的视线",
    "vi": "tầm mắt của Trần Tử Bì"
  },
  {
    "idx": 1927,
    "start": "00:50:28,834",
    "end": "00:50:30,374",
    "start_sec": 3028.834,
    "end_sec": 3030.374,
    "zh": "渐渐的小区门口吸引",
    "vi": "dần dần bị thu hút về phía cổng khu chung cư."
  },
  {
    "idx": 1928,
    "start": "00:50:30,374",
    "end": "00:50:31,014",
    "start_sec": 3030.374,
    "end_sec": 3031.014,
    "zh": "此后",
    "vi": "Lúc này"
  },
  {
    "idx": 1929,
    "start": "00:50:31,014",
    "end": "00:50:32,434",
    "start_sec": 3031.014,
    "end_sec": 3032.434,
    "zh": "保安亭里的一名保安",
    "vi": "một nhân viên bảo vệ trong bốt gác"
  },
  {
    "idx": 1930,
    "start": "00:50:32,434",
    "end": "00:50:34,634",
    "start_sec": 3032.434,
    "end_sec": 3034.634,
    "zh": "正伸头朝着外面不停张了",
    "vi": "đang thò đầu ra ngoài không ngừng ngó nghiêng."
  },
  {
    "idx": 1931,
    "start": "00:50:34,634",
    "end": "00:50:35,794",
    "start_sec": 3034.634,
    "end_sec": 3035.794,
    "zh": "他似乎想要出去",
    "vi": "Anh ta dường như muốn đi ra ngoài."
  },
  {
    "idx": 1932,
    "start": "00:50:35,794",
    "end": "00:50:36,494",
    "start_sec": 3035.794,
    "end_sec": 3036.494,
    "zh": "对",
    "vi": "Đúng vậy."
  },
  {
    "idx": 1933,
    "start": "00:50:36,494",
    "end": "00:50:37,694",
    "start_sec": 3036.494,
    "end_sec": 3037.694,
    "zh": "保安室里没吃的",
    "vi": "Trong phòng bảo vệ không có đồ ăn."
  },
  {
    "idx": 1934,
    "start": "00:50:37,694",
    "end": "00:50:38,934",
    "start_sec": 3037.694,
    "end_sec": 3038.934,
    "zh": "他上的估计还是人",
    "vi": "Anh ta chắc chắn vẫn là người sống."
  },
  {
    "idx": 1935,
    "start": "00:50:38,934",
    "end": "00:50:40,294",
    "start_sec": 3038.934,
    "end_sec": 3040.294,
    "zh": "这回肯定饿坏了吧",
    "vi": "Lần này chắc chắn là đói lả rồi."
  },
  {
    "idx": 1936,
    "start": "00:50:40,294",
    "end": "00:50:42,254",
    "start_sec": 3040.294,
    "end_sec": 3042.254,
    "zh": "橙子皮这么想着",
    "vi": "Trần Tử Bì nghĩ như vậy."
  },
  {
    "idx": 1937,
    "start": "00:50:42,254",
    "end": "00:50:44,294",
    "start_sec": 3042.254,
    "end_sec": 3044.294,
    "zh": "已经能看见保安打开门",
    "vi": "Đã có thể nhìn thấy người bảo vệ mở cửa"
  },
  {
    "idx": 1938,
    "start": "00:50:44,294",
    "end": "00:50:45,434",
    "start_sec": 3044.294,
    "end_sec": 3045.434,
    "zh": "瞅了瞅周围的情况",
    "vi": "ngó nghiêng tình hình xung quanh"
  },
  {
    "idx": 1939,
    "start": "00:50:45,434",
    "end": "00:50:47,534",
    "start_sec": 3045.434,
    "end_sec": 3047.534,
    "zh": "随后朝着超市拔腿狂奔",
    "vi": "rồi vắt chân lên cổ chạy về phía siêu thị."
  },
  {
    "idx": 1940,
    "start": "00:50:47,534",
    "end": "00:50:51,134",
    "start_sec": 3047.534,
    "end_sec": 3051.134,
    "zh": "卧槽",
    "vi": "Vãi thật."
  },
  {
    "idx": 1941,
    "start": "00:50:51,134",
    "end": "00:50:51,674",
    "start_sec": 3051.134,
    "end_sec": 3051.674,
    "zh": "槽",
    "vi": "Vãi."
  },
  {
    "idx": 1942,
    "start": "00:50:51,674",
    "end": "00:50:53,514",
    "start_sec": 3051.674,
    "end_sec": 3053.514,
    "zh": "我他妈裂开了",
    "vi": "Tôi muốn nổ tung luôn rồi."
  },
  {
    "idx": 1943,
    "start": "00:50:53,514",
    "end": "00:50:56,554",
    "start_sec": 3053.514,
    "end_sec": 3056.554,
    "zh": "卧槽",
    "vi": "Vãi chưởng."
  },
  {
    "idx": 1944,
    "start": "00:50:56,554",
    "end": "00:50:58,094",
    "start_sec": 3056.554,
    "end_sec": 3058.094,
    "zh": "你他妈什么鬼啊",
    "vi": "Cái quái gì thế này."
  },
  {
    "idx": 1945,
    "start": "00:50:58,094",
    "end": "00:50:59,274",
    "start_sec": 3058.094,
    "end_sec": 3059.274,
    "zh": "那保安就打起身",
    "vi": "Người bảo vệ đó vừa chạy đi"
  },
  {
    "idx": 1946,
    "start": "00:50:59,274",
    "end": "00:51:01,354",
    "start_sec": 3059.274,
    "end_sec": 3061.354,
    "zh": "把风吹得比朝天更好",
    "vi": "chạy nhanh như một cơn gió."
  },
  {
    "idx": 1947,
    "start": "00:51:01,354",
    "end": "00:51:01,954",
    "start_sec": 3061.354,
    "end_sec": 3061.954,
    "zh": "对",
    "vi": "Đúng vậy."
  },
  {
    "idx": 1948,
    "start": "00:51:01,954",
    "end": "00:51:03,674",
    "start_sec": 3061.954,
    "end_sec": 3063.674,
    "zh": "后面自知有气的女鬼",
    "vi": "Con ma nữ bám theo phía sau"
  },
  {
    "idx": 1949,
    "start": "00:51:03,674",
    "end": "00:51:04,754",
    "start_sec": 3063.674,
    "end_sec": 3064.754,
    "zh": "居然是咔启自开",
    "vi": "bỗng nhiên cũng đuổi theo"
  },
  {
    "idx": 1950,
    "start": "00:51:04,754",
    "end": "00:51:05,994",
    "start_sec": 3064.754,
    "end_sec": 3065.994,
    "zh": "迅速的追进保安",
    "vi": "nhanh chóng đuổi sát người bảo vệ."
  },
  {
    "idx": 1951,
    "start": "00:51:05,994",
    "end": "00:51:08,214",
    "start_sec": 3065.994,
    "end_sec": 3068.214,
    "zh": "好在保安中就是让着巨鸡幽眠",
    "vi": "May mắn là bảo vệ đã nhường đường cho tôi."
  },
  {
    "idx": 1952,
    "start": "00:51:08,214",
    "end": "00:51:09,494",
    "start_sec": 3068.214,
    "end_sec": 3069.494,
    "zh": "来到了超市门前",
    "vi": "Đến trước cửa siêu thị."
  },
  {
    "idx": 1953,
    "start": "00:51:09,494",
    "end": "00:51:11,454",
    "start_sec": 3069.494,
    "end_sec": 3071.454,
    "zh": "喂喂",
    "vi": "Này này."
  },
  {
    "idx": 1954,
    "start": "00:51:11,454",
    "end": "00:51:12,174",
    "start_sec": 3071.454,
    "end_sec": 3072.174,
    "zh": "开门啊",
    "vi": "Mở cửa ra."
  },
  {
    "idx": 1955,
    "start": "00:51:12,174",
    "end": "00:51:13,334",
    "start_sec": 3072.174,
    "end_sec": 3073.334,
    "zh": "救命救命啊",
    "vi": "Cứu tôi với, cứu tôi với."
  },
  {
    "idx": 1956,
    "start": "00:51:13,334",
    "end": "00:51:14,174",
    "start_sec": 3073.334,
    "end_sec": 3074.174,
    "zh": "喂",
    "vi": "Này."
  },
  {
    "idx": 1957,
    "start": "00:51:14,174",
    "end": "00:51:14,854",
    "start_sec": 3074.174,
    "end_sec": 3074.854,
    "zh": "说八皮",
    "vi": "Nói gì vậy."
  },
  {
    "idx": 1958,
    "start": "00:51:14,854",
    "end": "00:51:15,874",
    "start_sec": 3074.854,
    "end_sec": 3075.874,
    "zh": "你开门啊",
    "vi": "Anh mở cửa ra đi."
  },
  {
    "idx": 1959,
    "start": "00:51:15,874",
    "end": "00:51:17,214",
    "start_sec": 3075.874,
    "end_sec": 3077.214,
    "zh": "老子每次都在那边买烟",
    "vi": "Lần nào tôi cũng mua thuốc lá ở đây."
  },
  {
    "idx": 1960,
    "start": "00:51:17,214",
    "end": "00:51:18,414",
    "start_sec": 3077.214,
    "end_sec": 3078.414,
    "zh": "我知道你在里面",
    "vi": "Tôi biết anh ở trong đó."
  },
  {
    "idx": 1961,
    "start": "00:51:18,414",
    "end": "00:51:19,214",
    "start_sec": 3078.414,
    "end_sec": 3079.214,
    "zh": "你开门啊",
    "vi": "Anh mở cửa ra đi."
  },
  {
    "idx": 1962,
    "start": "00:51:19,214",
    "end": "00:51:20,094",
    "start_sec": 3079.214,
    "end_sec": 3080.094,
    "zh": "救命啊",
    "vi": "Cứu tôi với."
  },
  {
    "idx": 1963,
    "start": "00:51:20,094",
    "end": "00:51:20,454",
    "start_sec": 3080.094,
    "end_sec": 3080.454,
    "zh": "然而",
    "vi": "Thế nhưng."
  },
  {
    "idx": 1964,
    "start": "00:51:20,454",
    "end": "00:51:22,114",
    "start_sec": 3080.454,
    "end_sec": 3082.114,
    "zh": "无论保安怎样叫喊的",
    "vi": "Dù bảo vệ có kêu gào thế nào."
  },
  {
    "idx": 1965,
    "start": "00:51:22,114",
    "end": "00:51:26,014",
    "start_sec": 3082.114,
    "end_sec": 3086.014,
    "zh": "周八平老是恨你",
    "vi": "Châu Bát Bình vẫn ghét anh."
  },
  {
    "idx": 1966,
    "start": "00:51:26,014",
    "end": "00:51:27,434",
    "start_sec": 3086.014,
    "end_sec": 3087.434,
    "zh": "无论港安什么反抗",
    "vi": "Bất kể sự phản kháng nào."
  },
  {
    "idx": 1967,
    "start": "00:51:27,434",
    "end": "00:51:29,214",
    "start_sec": 3087.434,
    "end_sec": 3089.214,
    "zh": "不过是垂水挣扎罢了",
    "vi": "Chỉ là giãy giụa trong tuyệt vọng thôi."
  },
  {
    "idx": 1968,
    "start": "00:51:29,214",
    "end": "00:51:30,894",
    "start_sec": 3089.214,
    "end_sec": 3090.894,
    "zh": "这件女鬼服在港安博耿部",
    "vi": "Bộ đồ ma nữ này đã khiến anh ta."
  },
  {
    "idx": 1969,
    "start": "00:51:30,894",
    "end": "00:51:32,154",
    "start_sec": 3090.894,
    "end_sec": 3092.154,
    "zh": "一点一点往里钻",
    "vi": "Từ từ chui vào trong."
  },
  {
    "idx": 1970,
    "start": "00:51:32,154",
    "end": "00:51:34,374",
    "start_sec": 3092.154,
    "end_sec": 3094.374,
    "zh": "长子皮看着柳心",
    "vi": "Trường Tử Bì nhìn Liễu Tâm."
  },
  {
    "idx": 1971,
    "start": "00:51:34,374",
    "end": "00:51:35,514",
    "start_sec": 3094.374,
    "end_sec": 3095.514,
    "zh": "默默放下了我",
    "vi": "Lặng lẽ buông tôi ra."
  },
  {
    "idx": 1972,
    "start": "00:51:35,514",
    "end": "00:51:36,754",
    "start_sec": 3095.514,
    "end_sec": 3096.754,
    "zh": "从始至终",
    "vi": "Từ đầu đến cuối."
  },
  {
    "idx": 1973,
    "start": "00:51:36,754",
    "end": "00:51:38,614",
    "start_sec": 3096.754,
    "end_sec": 3098.614,
    "zh": "老周便利店的门也没打开",
    "vi": "Cửa hàng tiện lợi của Lão Châu vẫn không mở."
  },
  {
    "idx": 1974,
    "start": "00:51:38,614",
    "end": "00:51:40,034",
    "start_sec": 3098.614,
    "end_sec": 3100.034,
    "zh": "他也明白了一个道理",
    "vi": "Anh ta cũng hiểu ra một đạo lý."
  },
  {
    "idx": 1975,
    "start": "00:51:40,034",
    "end": "00:51:41,514",
    "start_sec": 3100.034,
    "end_sec": 3101.514,
    "zh": "末日谁也靠不住",
    "vi": "Ngày tận thế không thể dựa vào ai."
  },
  {
    "idx": 1976,
    "start": "00:51:41,514",
    "end": "00:51:43,634",
    "start_sec": 3101.514,
    "end_sec": 3103.634,
    "zh": "看来白天也不能随便外出",
    "vi": "Xem ra ban ngày cũng không thể tùy tiện ra ngoài."
  },
  {
    "idx": 1977,
    "start": "00:51:43,634",
    "end": "00:51:46,054",
    "start_sec": 3103.634,
    "end_sec": 3106.054,
    "zh": "至少在没有最可怜的时日之前",
    "vi": "Ít nhất là trước khi không còn những ngày tháng đáng thương hại."
  },
  {
    "idx": 1978,
    "start": "00:51:46,054",
    "end": "00:51:48,634",
    "start_sec": 3106.054,
    "end_sec": 3108.634,
    "zh": "长子皮从802出来",
    "vi": "Trường Tử Bì bước ra từ phòng 802."
  },
  {
    "idx": 1979,
    "start": "00:51:48,634",
    "end": "00:51:50,654",
    "start_sec": 3108.634,
    "end_sec": 3110.654,
    "zh": "手里拎着一个紫色塑料袋",
    "vi": "Tay cầm một túi nhựa màu tím."
  },
  {
    "idx": 1980,
    "start": "00:51:50,654",
    "end": "00:51:52,834",
    "start_sec": 3110.654,
    "end_sec": 3112.834,
    "zh": "里面装着我买的所有的食物",
    "vi": "Bên trong là tất cả thức ăn tôi đã mua."
  },
  {
    "idx": 1981,
    "start": "00:51:52,834",
    "end": "00:51:54,534",
    "start_sec": 3112.834,
    "end_sec": 3114.534,
    "zh": "我用一个月钱的自己帮我",
    "vi": "Tôi đã dùng tiền lương một tháng của mình để mua đồ ăn."
  },
  {
    "idx": 1982,
    "start": "00:51:54,534",
    "end": "00:51:55,654",
    "start_sec": 3114.534,
    "end_sec": 3115.654,
    "zh": "现在并不缺食物",
    "vi": "Bây giờ tôi không thiếu thức ăn."
  },
  {
    "idx": 1983,
    "start": "00:51:55,654",
    "end": "00:51:57,594",
    "start_sec": 3115.654,
    "end_sec": 3117.594,
    "zh": "但现在七栋里还有另一个活人呢",
    "vi": "Nhưng bây giờ trong tòa nhà số bảy còn có một người sống khác."
  },
  {
    "idx": 1984,
    "start": "00:51:57,594",
    "end": "00:51:59,094",
    "start_sec": 3117.594,
    "end_sec": 3119.094,
    "zh": "长者提想了想",
    "vi": "Trường Tử Bì suy nghĩ một chút."
  },
  {
    "idx": 1985,
    "start": "00:51:59,094",
    "end": "00:52:01,014",
    "start_sec": 3119.094,
    "end_sec": 3121.014,
    "zh": "在七栋楼顶发了条消息",
    "vi": "Anh ta đã gửi một tin nhắn trên tầng thượng tòa nhà số bảy."
  },
  {
    "idx": 1986,
    "start": "00:52:01,014",
    "end": "00:52:01,654",
    "start_sec": 3121.014,
    "end_sec": 3121.654,
    "zh": "罗小姐",
    "vi": "Cô La."
  },
  {
    "idx": 1987,
    "start": "00:52:01,654",
    "end": "00:52:02,814",
    "start_sec": 3121.654,
    "end_sec": 3122.814,
    "zh": "屋外好吵啊",
    "vi": "Ngoài trời ồn ào quá."
  },
  {
    "idx": 1988,
    "start": "00:52:02,814",
    "end": "00:52:04,314",
    "start_sec": 3122.814,
    "end_sec": 3124.314,
    "zh": "你知道发生什么了吗",
    "vi": "Bạn có biết chuyện gì đang xảy ra không."
  },
  {
    "idx": 1989,
    "start": "00:52:04,314",
    "end": "00:52:05,414",
    "start_sec": 3124.314,
    "end_sec": 3125.414,
    "zh": "不知道啊",
    "vi": "Tôi không biết."
  },
  {
    "idx": 1990,
    "start": "00:52:05,414",
    "end": "00:52:06,234",
    "start_sec": 3125.414,
    "end_sec": 3126.234,
    "zh": "我在睡觉",
    "vi": "Tôi đang ngủ."
  },
  {
    "idx": 1991,
    "start": "00:52:06,234",
    "end": "00:52:07,434",
    "start_sec": 3126.234,
    "end_sec": 3127.434,
    "zh": "你要不出去看看",
    "vi": "Hay là bạn ra ngoài xem đi."
  },
  {
    "idx": 1992,
    "start": "00:52:07,434",
    "end": "00:52:09,154",
    "start_sec": 3127.434,
    "end_sec": 3129.154,
    "zh": "呵呵",
    "vi": "Heh."
  },
  {
    "idx": 1993,
    "start": "00:52:09,154",
    "end": "00:52:11,254",
    "start_sec": 3129.154,
    "end_sec": 3131.254,
    "zh": "刚刚小区保安被爬行女鬼杀死",
    "vi": "Bảo vệ khu dân cư vừa bị một con ma bò sát giết chết."
  },
  {
    "idx": 1994,
    "start": "00:52:11,254",
    "end": "00:52:12,034",
    "start_sec": 3131.254,
    "end_sec": 3132.034,
    "zh": "动静那么大",
    "vi": "Động tĩnh lớn như vậy."
  },
  {
    "idx": 1995,
    "start": "00:52:12,034",
    "end": "00:52:13,034",
    "start_sec": 3132.034,
    "end_sec": 3133.034,
    "zh": "罗先生睡着",
    "vi": "Ngài La đang ngủ."
  },
  {
    "idx": 1996,
    "start": "00:52:13,034",
    "end": "00:52:14,094",
    "start_sec": 3133.034,
    "end_sec": 3134.094,
    "zh": "还让我出去看看",
    "vi": "Lại còn bảo tôi ra ngoài xem."
  },
  {
    "idx": 1997,
    "start": "00:52:14,094",
    "end": "00:52:15,274",
    "start_sec": 3134.094,
    "end_sec": 3135.274,
    "zh": "你倒是挺会算计",
    "vi": "Bạn đúng là biết tính toán."
  },
  {
    "idx": 1998,
    "start": "00:52:15,274",
    "end": "00:52:17,354",
    "start_sec": 3135.274,
    "end_sec": 3137.354,
    "zh": "长者提擦了他走动的塑料袋",
    "vi": "Trường Tử Bì lau túi nhựa đang cầm trên tay."
  },
  {
    "idx": 1999,
    "start": "00:52:17,354",
    "end": "00:52:18,154",
    "start_sec": 3137.354,
    "end_sec": 3138.154,
    "zh": "呵呵",
    "vi": "Heh."
  },
  {
    "idx": 2000,
    "start": "00:52:18,154",
    "end": "00:52:18,974",
    "start_sec": 3138.154,
    "end_sec": 3138.974,
    "zh": "你还不知道",
    "vi": "Bạn vẫn chưa biết."
  },
  {
    "idx": 2001,
    "start": "00:52:18,974",
    "end": "00:52:20,274",
    "start_sec": 3138.974,
    "end_sec": 3140.274,
    "zh": "我现在就在你们外吧",
    "vi": "Tôi đang ở ngay bên ngoài các bạn."
  },
  {
    "idx": 2002,
    "start": "00:52:20,274",
    "end": "00:52:21,494",
    "start_sec": 3140.274,
    "end_sec": 3141.494,
    "zh": "如果你是个好人",
    "vi": "Nếu bạn là người tốt."
  },
  {
    "idx": 2003,
    "start": "00:52:21,494",
    "end": "00:52:22,394",
    "start_sec": 3141.494,
    "end_sec": 3142.394,
    "zh": "劝我不出去",
    "vi": "Và khuyên tôi đừng ra ngoài."
  },
  {
    "idx": 2004,
    "start": "00:52:22,394",
    "end": "00:52:23,714",
    "start_sec": 3142.394,
    "end_sec": 3143.714,
    "zh": "我会将食物留给你",
    "vi": "Tôi sẽ để lại thức ăn cho bạn."
  },
  {
    "idx": 2005,
    "start": "00:52:23,714",
    "end": "00:52:24,354",
    "start_sec": 3143.714,
    "end_sec": 3144.354,
    "zh": "可惜",
    "vi": "Tiếc là."
  },
  {
    "idx": 2006,
    "start": "00:52:24,354",
    "end": "00:52:26,094",
    "start_sec": 3144.354,
    "end_sec": 3146.094,
    "zh": "长子皮冷着脸",
    "vi": "Trường Tử Bì lạnh lùng nói."
  },
  {
    "idx": 2007,
    "start": "00:52:26,094",
    "end": "00:52:27,594",
    "start_sec": 3146.094,
    "end_sec": 3147.594,
    "zh": "不仅带走802的食物",
    "vi": "Không chỉ lấy đi thức ăn của phòng 802."
  },
  {
    "idx": 2008,
    "start": "00:52:27,594",
    "end": "00:52:30,334",
    "start_sec": 3147.594,
    "end_sec": 3150.334,
    "zh": "连带着网架所有楼层的食物都被他掏空",
    "vi": "Mà còn vét sạch thức ăn của tất cả các tầng trên mạng lưới."
  },
  {
    "idx": 2009,
    "start": "00:52:30,334",
    "end": "00:52:32,774",
    "start_sec": 3150.334,
    "end_sec": 3152.774,
    "zh": "如果罗倩仅仅只是自私也不算了",
    "vi": "Nếu La Thiến chỉ ích kỷ thì cũng không sao."
  },
  {
    "idx": 2010,
    "start": "00:52:32,774",
    "end": "00:52:34,554",
    "start_sec": 3152.774,
    "end_sec": 3154.554,
    "zh": "但他不该去想着算计长子皮",
    "vi": "Nhưng cô ta không nên tính toán với Trường Tử Bì."
  },
  {
    "idx": 2011,
    "start": "00:52:34,554",
    "end": "00:52:39,054",
    "start_sec": 3154.554,
    "end_sec": 3159.054,
    "zh": "小区里一股发心于鬼",
    "vi": "Thế lực quỷ dị xuất hiện trong khu chung cư"
  },
  {
    "idx": 2012,
    "start": "00:52:39,054",
    "end": "00:52:40,714",
    "start_sec": 3159.054,
    "end_sec": 3160.714,
    "zh": "绝对不是我们抗衡的",
    "vi": "tuyệt đối không phải là thứ chúng ta có thể chống lại."
  },
  {
    "idx": 2013,
    "start": "00:52:40,714",
    "end": "00:52:42,534",
    "start_sec": 3160.714,
    "end_sec": 3162.534,
    "zh": "且不说可能还有其他诡异",
    "vi": "Chưa kể có thể vẫn còn những thế lực quỷ dị khác."
  },
  {
    "idx": 2014,
    "start": "00:52:42,534",
    "end": "00:52:44,014",
    "start_sec": 3162.534,
    "end_sec": 3164.014,
    "zh": "长子皮有些无奈",
    "vi": "Cam Tử Bì cảm thấy có chút bất lực."
  },
  {
    "idx": 2015,
    "start": "00:52:44,014",
    "end": "00:52:45,254",
    "start_sec": 3164.014,
    "end_sec": 3165.254,
    "zh": "虽说他现在有挂",
    "vi": "Mặc dù hiện tại anh ta có khả năng đặc biệt."
  },
  {
    "idx": 2016,
    "start": "00:52:45,254",
    "end": "00:52:46,414",
    "start_sec": 3165.254,
    "end_sec": 3166.414,
    "zh": "但并不是无敌的",
    "vi": "Nhưng anh ta không phải là vô địch."
  },
  {
    "idx": 2017,
    "start": "00:52:46,414",
    "end": "00:52:48,374",
    "start_sec": 3166.414,
    "end_sec": 3168.374,
    "zh": "至少拿现在的诡异没有办法",
    "vi": "Ít nhất là lúc này anh ta vẫn bất lực trước thế lực quỷ dị."
  },
  {
    "idx": 2018,
    "start": "00:52:48,374",
    "end": "00:52:49,434",
    "start_sec": 3168.374,
    "end_sec": 3169.434,
    "zh": "只能委屈求全",
    "vi": "Chỉ đành phải nín nhịn để cầu toàn."
  },
  {
    "idx": 2019,
    "start": "00:52:49,434",
    "end": "00:52:51,814",
    "start_sec": 3169.434,
    "end_sec": 3171.814,
    "zh": "电视一直处于无信号状态",
    "vi": "Tivi vẫn luôn ở trong trạng thái mất tín hiệu."
  },
  {
    "idx": 2020,
    "start": "00:52:51,814",
    "end": "00:52:53,734",
    "start_sec": 3171.814,
    "end_sec": 3173.734,
    "zh": "成的皮只能用电脑上网",
    "vi": "Cam Tử Bì chỉ có thể dùng máy tính để lên mạng."
  },
  {
    "idx": 2021,
    "start": "00:52:53,734",
    "end": "00:52:55,334",
    "start_sec": 3173.734,
    "end_sec": 3175.334,
    "zh": "看看能不能找到有用信息",
    "vi": "Xem thử có thể tìm được thông tin gì hữu ích không."
  },
  {
    "idx": 2022,
    "start": "00:52:55,334",
    "end": "00:52:56,194",
    "start_sec": 3175.334,
    "end_sec": 3176.194,
    "zh": "这时",
    "vi": "Đúng lúc này."
  },
  {
    "idx": 2023,
    "start": "00:52:56,194",
    "end": "00:52:59,554",
    "start_sec": 3176.194,
    "end_sec": 3179.554,
    "zh": "一个名为求生建议的帖子吸引了他的注意",
    "vi": "Một bài viết có tiêu đề Lời khuyên sinh tồn đã thu hút sự chú ý của anh ta."
  },
  {
    "idx": 2024,
    "start": "00:52:59,554",
    "end": "00:53:01,794",
    "start_sec": 3179.554,
    "end_sec": 3181.794,
    "zh": "论诡异是否能被认为消灭",
    "vi": "Bàn về việc liệu con người có thể tiêu diệt được thế lực quỷ dị hay không."
  },
  {
    "idx": 2025,
    "start": "00:53:01,794",
    "end": "00:53:04,294",
    "start_sec": 3181.794,
    "end_sec": 3184.294,
    "zh": "家父年轻时曾经学过道士术法",
    "vi": "Cha tôi khi còn trẻ từng học qua thuật pháp đạo sĩ."
  },
  {
    "idx": 2026,
    "start": "00:53:04,294",
    "end": "00:53:06,554",
    "start_sec": 3184.294,
    "end_sec": 3186.554,
    "zh": "昨晚家父的铜钱剑发出金光",
    "vi": "Tối qua thanh kiếm tiền xu của cha tôi đã phát ra ánh kim quang."
  },
  {
    "idx": 2027,
    "start": "00:53:06,554",
    "end": "00:53:08,494",
    "start_sec": 3186.554,
    "end_sec": 3188.494,
    "zh": "随家父斩下一小鬼头颅",
    "vi": "Giúp cha tôi chém bay đầu của một con quỷ nhỏ."
  },
  {
    "idx": 2028,
    "start": "00:53:08,494",
    "end": "00:53:10,974",
    "start_sec": 3188.494,
    "end_sec": 3190.974,
    "zh": "然而在遇到具有一定能力的诡异时",
    "vi": "Tuy nhiên khi gặp phải thế lực quỷ dị có năng lực mạnh hơn."
  },
  {
    "idx": 2029,
    "start": "00:53:10,974",
    "end": "00:53:12,014",
    "start_sec": 3190.974,
    "end_sec": 3192.014,
    "zh": "却毫无作用",
    "vi": "Thì nó lại hoàn toàn vô dụng."
  },
  {
    "idx": 2030,
    "start": "00:53:12,014",
    "end": "00:53:12,814",
    "start_sec": 3192.014,
    "end_sec": 3192.814,
    "zh": "据我推测",
    "vi": "Theo tôi suy đoán."
  },
  {
    "idx": 2031,
    "start": "00:53:12,814",
    "end": "00:53:15,374",
    "start_sec": 3192.814,
    "end_sec": 3195.374,
    "zh": "诡异复苏可能比道法的进化更快",
    "vi": "Sự hồi sinh của thế lực quỷ dị có thể nhanh hơn sự tiến hóa của đạo pháp."
  },
  {
    "idx": 2032,
    "start": "00:53:15,374",
    "end": "00:53:16,394",
    "start_sec": 3195.374,
    "end_sec": 3196.394,
    "zh": "也许到了后期",
    "vi": "Có lẽ đến giai đoạn sau."
  },
  {
    "idx": 2033,
    "start": "00:53:16,394",
    "end": "00:53:18,214",
    "start_sec": 3196.394,
    "end_sec": 3198.214,
    "zh": "诡异将不会怕任何道法",
    "vi": "Thế lực quỷ dị sẽ không còn sợ bất kỳ đạo pháp nào nữa."
  },
  {
    "idx": 2034,
    "start": "00:53:18,214",
    "end": "00:53:19,494",
    "start_sec": 3198.214,
    "end_sec": 3199.494,
    "zh": "卧槽",
    "vi": "Chết tiệt."
  },
  {
    "idx": 2035,
    "start": "00:53:19,494",
    "end": "00:53:20,934",
    "start_sec": 3199.494,
    "end_sec": 3200.934,
    "zh": "网站怎么自主关闭了",
    "vi": "Sao trang web lại tự động đóng thế này."
  },
  {
    "idx": 2036,
    "start": "00:53:20,934",
    "end": "00:53:22,554",
    "start_sec": 3200.934,
    "end_sec": 3202.554,
    "zh": "这帖子搞不好是真的",
    "vi": "Bài viết này có khi là thật đấy."
  },
  {
    "idx": 2037,
    "start": "00:53:22,554",
    "end": "00:53:23,574",
    "start_sec": 3202.554,
    "end_sec": 3203.574,
    "zh": "坐在橙子皮",
    "vi": "Cam Tử Bì đang ngồi đó."
  },
  {
    "idx": 2038,
    "start": "00:53:23,574",
    "end": "00:53:25,094",
    "start_sec": 3203.574,
    "end_sec": 3205.094,
    "zh": "还想搜搜相关贴士",
    "vi": "Vẫn muốn tìm kiếm thêm các bài viết liên quan."
  },
  {
    "idx": 2039,
    "start": "00:53:25,094",
    "end": "00:53:26,354",
    "start_sec": 3205.094,
    "end_sec": 3206.354,
    "zh": "突然手机来了小子",
    "vi": "Thì đột nhiên điện thoại có tin nhắn đến."
  },
  {
    "idx": 2040,
    "start": "00:53:26,354",
    "end": "00:53:30,594",
    "start_sec": 3206.354,
    "end_sec": 3210.594,
    "zh": "好兄弟",
    "vi": "Người anh em tốt."
  },
  {
    "idx": 2041,
    "start": "00:53:30,594",
    "end": "00:53:31,254",
    "start_sec": 3210.594,
    "end_sec": 3211.254,
    "zh": "在不在",
    "vi": "Bạn có đó không."
  },
  {
    "idx": 2042,
    "start": "00:53:31,254",
    "end": "00:53:31,954",
    "start_sec": 3211.254,
    "end_sec": 3211.954,
    "zh": "怎么了",
    "vi": "Có chuyện gì thế."
  },
  {
    "idx": 2043,
    "start": "00:53:31,954",
    "end": "00:53:33,194",
    "start_sec": 3211.954,
    "end_sec": 3213.194,
    "zh": "没钱花了",
    "vi": "Tôi hết tiền tiêu rồi."
  },
  {
    "idx": 2044,
    "start": "00:53:33,194",
    "end": "00:53:34,194",
    "start_sec": 3213.194,
    "end_sec": 3214.194,
    "zh": "OK",
    "vi": "Được thôi."
  },
  {
    "idx": 2045,
    "start": "00:53:34,194",
    "end": "00:53:36,474",
    "start_sec": 3214.194,
    "end_sec": 3216.474,
    "zh": "果然还是自己最懂自家",
    "vi": "Quả nhiên chỉ có bản thân mới hiểu rõ chính mình."
  },
  {
    "idx": 2046,
    "start": "00:53:36,474",
    "end": "00:53:37,834",
    "start_sec": 3216.474,
    "end_sec": 3217.834,
    "zh": "那六千块不够花呀",
    "vi": "Sáu nghìn tệ đó không đủ tiêu đâu."
  },
  {
    "idx": 2047,
    "start": "00:53:37,834",
    "end": "00:53:38,374",
    "start_sec": 3217.834,
    "end_sec": 3218.374,
    "zh": "好兄弟",
    "vi": "Người anh em tốt."
  },
  {
    "idx": 2048,
    "start": "00:53:38,374",
    "end": "00:53:39,894",
    "start_sec": 3218.374,
    "end_sec": 3219.894,
    "zh": "你这处于绝对无敌的未来",
    "vi": "Bạn đang ở một tương lai vô địch tuyệt đối."
  },
  {
    "idx": 2049,
    "start": "00:53:39,894",
    "end": "00:53:41,054",
    "start_sec": 3219.894,
    "end_sec": 3221.054,
    "zh": "你不让我当一把锋",
    "vi": "Bạn không để tôi làm tiên phong một lần sao."
  },
  {
    "idx": 2050,
    "start": "00:53:41,054",
    "end": "00:53:43,394",
    "start_sec": 3221.054,
    "end_sec": 3223.394,
    "zh": "橙子皮一声无语",
    "vi": "Cheng Zi Pi cạn lời."
  },
  {
    "idx": 2051,
    "start": "00:53:43,394",
    "end": "00:53:45,354",
    "start_sec": 3223.394,
    "end_sec": 3225.354,
    "zh": "不过既然过去的自己提出要求",
    "vi": "Nhưng vì bản thân trong quá khứ đã đưa ra yêu cầu."
  },
  {
    "idx": 2052,
    "start": "00:53:45,354",
    "end": "00:53:46,594",
    "start_sec": 3225.354,
    "end_sec": 3226.594,
    "zh": "他不可能不去满足",
    "vi": "Anh không thể không đáp ứng."
  },
  {
    "idx": 2053,
    "start": "00:53:46,594",
    "end": "00:53:48,094",
    "start_sec": 3226.594,
    "end_sec": 3228.094,
    "zh": "毕竟帮过去的自己",
    "vi": "Dù sao thì giúp đỡ bản thân trong quá khứ."
  },
  {
    "idx": 2054,
    "start": "00:53:48,094",
    "end": "00:53:49,894",
    "start_sec": 3228.094,
    "end_sec": 3229.894,
    "zh": "就相当于帮助现在的",
    "vi": "Cũng tương đương với việc giúp đỡ chính mình hiện tại."
  },
  {
    "idx": 2055,
    "start": "00:53:49,894",
    "end": "00:53:50,814",
    "start_sec": 3229.894,
    "end_sec": 3230.814,
    "zh": "赚钱",
    "vi": "Kiếm tiền."
  },
  {
    "idx": 2056,
    "start": "00:53:50,814",
    "end": "00:53:51,714",
    "start_sec": 3230.814,
    "end_sec": 3231.714,
    "zh": "我想想",
    "vi": "Để tôi suy nghĩ xem."
  },
  {
    "idx": 2057,
    "start": "00:53:51,714",
    "end": "00:53:52,914",
    "start_sec": 3231.714,
    "end_sec": 3232.914,
    "zh": "这一个月发生什么",
    "vi": "Tháng này có chuyện gì xảy ra nhỉ."
  },
  {
    "idx": 2058,
    "start": "00:53:52,914",
    "end": "00:53:53,894",
    "start_sec": 3232.914,
    "end_sec": 3233.894,
    "zh": "三次求彩票",
    "vi": "Mua xổ số ba lần."
  },
  {
    "idx": 2059,
    "start": "00:53:53,894",
    "end": "00:53:54,394",
    "start_sec": 3233.894,
    "end_sec": 3234.394,
    "zh": "不行",
    "vi": "Không được."
  },
  {
    "idx": 2060,
    "start": "00:53:54,394",
    "end": "00:53:55,534",
    "start_sec": 3234.394,
    "end_sec": 3235.534,
    "zh": "那玩意儿有黑幕",
    "vi": "Thứ đó có ám muội."
  },
  {
    "idx": 2061,
    "start": "00:53:55,534",
    "end": "00:53:56,714",
    "start_sec": 3235.534,
    "end_sec": 3236.714,
    "zh": "就算我知道大奖号码",
    "vi": "Dù tôi có biết con số trúng thưởng."
  },
  {
    "idx": 2062,
    "start": "00:53:56,714",
    "end": "00:53:58,054",
    "start_sec": 3236.714,
    "end_sec": 3238.054,
    "zh": "到时候也会是一个新号",
    "vi": "Đến lúc đó nó cũng sẽ là một con số mới."
  },
  {
    "idx": 2063,
    "start": "00:53:58,054",
    "end": "00:53:58,934",
    "start_sec": 3238.054,
    "end_sec": 3238.934,
    "zh": "呱呱乐的话",
    "vi": "Còn vé số cào thì."
  },
  {
    "idx": 2064,
    "start": "00:53:58,934",
    "end": "00:54:00,014",
    "start_sec": 3238.934,
    "end_sec": 3240.014,
    "zh": "本身好像没有大奖",
    "vi": "Bản thân nó hình như không có giải lớn."
  },
  {
    "idx": 2065,
    "start": "00:54:00,014",
    "end": "00:54:01,534",
    "start_sec": 3240.014,
    "end_sec": 3241.534,
    "zh": "长者提想了想",
    "vi": "Zhang Zhe Ti suy nghĩ một chút."
  },
  {
    "idx": 2066,
    "start": "00:54:01,534",
    "end": "00:54:03,074",
    "start_sec": 3241.534,
    "end_sec": 3243.074,
    "zh": "当即就给过去的自己",
    "vi": "Liền gửi ngay cho bản thân trong quá khứ."
  },
  {
    "idx": 2067,
    "start": "00:54:03,074",
    "end": "00:54:04,574",
    "start_sec": 3243.074,
    "end_sec": 3244.574,
    "zh": "围托了一条信息",
    "vi": "Một tin nhắn ủy thác."
  },
  {
    "idx": 2068,
    "start": "00:54:04,574",
    "end": "00:54:05,934",
    "start_sec": 3244.574,
    "end_sec": 3245.934,
    "zh": "明晚会有一个年轻的官",
    "vi": "Tối mai sẽ có một vị quan trẻ tuổi."
  },
  {
    "idx": 2069,
    "start": "00:54:05,934",
    "end": "00:54:06,814",
    "start_sec": 3245.934,
    "end_sec": 3246.814,
    "zh": "带过来看项目",
    "vi": "Đến xem dự án."
  },
  {
    "idx": 2070,
    "start": "00:54:06,814",
    "end": "00:54:07,514",
    "start_sec": 3246.814,
    "end_sec": 3247.514,
    "zh": "很好说话",
    "vi": "Người đó rất dễ nói chuyện."
  },
  {
    "idx": 2071,
    "start": "00:54:07,514",
    "end": "00:54:08,314",
    "start_sec": 3247.514,
    "end_sec": 3248.314,
    "zh": "你陪他玩几天",
    "vi": "Bạn đi chơi với anh ta vài ngày."
  },
  {
    "idx": 2072,
    "start": "00:54:08,314",
    "end": "00:54:09,174",
    "start_sec": 3248.314,
    "end_sec": 3249.174,
    "zh": "这单子签了",
    "vi": "Ký được hợp đồng này."
  },
  {
    "idx": 2073,
    "start": "00:54:09,174",
    "end": "00:54:10,194",
    "start_sec": 3249.174,
    "end_sec": 3250.194,
    "zh": "有三万一场",
    "vi": "Sẽ được ba mươi nghìn tệ một buổi."
  },
  {
    "idx": 2074,
    "start": "00:54:10,194",
    "end": "00:54:10,994",
    "start_sec": 3250.194,
    "end_sec": 3250.994,
    "zh": "三万",
    "vi": "Ba mươi nghìn tệ."
  },
  {
    "idx": 2075,
    "start": "00:54:10,994",
    "end": "00:54:11,594",
    "start_sec": 3250.994,
    "end_sec": 3251.594,
    "zh": "我说",
    "vi": "Tôi nói này."
  },
  {
    "idx": 2076,
    "start": "00:54:11,594",
    "end": "00:54:13,314",
    "start_sec": 3251.594,
    "end_sec": 3253.314,
    "zh": "咱们都能穿越四通对话了",
    "vi": "Chúng ta đã có thể trò chuyện xuyên thời gian rồi."
  },
  {
    "idx": 2077,
    "start": "00:54:13,314",
    "end": "00:54:14,054",
    "start_sec": 3253.314,
    "end_sec": 3254.054,
    "zh": "这赚钱速度",
    "vi": "Tốc độ kiếm tiền này."
  },
  {
    "idx": 2078,
    "start": "00:54:14,054",
    "end": "00:54:15,494",
    "start_sec": 3254.054,
    "end_sec": 3255.494,
    "zh": "是不是有点拉了",
    "vi": "Có phải là hơi kém quá rồi không."
  },
  {
    "idx": 2079,
    "start": "00:54:15,494",
    "end": "00:54:16,434",
    "start_sec": 3255.494,
    "end_sec": 3256.434,
    "zh": "那我告诉你",
    "vi": "Vậy tôi nói cho bạn biết."
  },
  {
    "idx": 2080,
    "start": "00:54:16,434",
    "end": "00:54:17,874",
    "start_sec": 3256.434,
    "end_sec": 3257.874,
    "zh": "某银行有机器表现问题",
    "vi": "Máy móc của một ngân hàng nào đó gặp sự cố."
  },
  {
    "idx": 2081,
    "start": "00:54:17,874",
    "end": "00:54:18,934",
    "start_sec": 3257.874,
    "end_sec": 3258.934,
    "zh": "你信吗",
    "vi": "Bạn có tin không."
  },
  {
    "idx": 2082,
    "start": "00:54:18,934",
    "end": "00:54:19,634",
    "start_sec": 3258.934,
    "end_sec": 3259.634,
    "zh": "发自然",
    "vi": "Nhưng mà."
  },
  {
    "idx": 2083,
    "start": "00:54:19,634",
    "end": "00:54:22,294",
    "start_sec": 3259.634,
    "end_sec": 3262.294,
    "zh": "手机那头没有再亮起信息",
    "vi": "Đầu bên kia điện thoại không còn sáng đèn tin nhắn nữa."
  },
  {
    "idx": 2084,
    "start": "00:54:22,294",
    "end": "00:54:22,914",
    "start_sec": 3262.294,
    "end_sec": 3262.914,
    "zh": "橙子皮",
    "vi": "Trần Tử Bì."
  },
  {
    "idx": 2085,
    "start": "00:54:22,914",
    "end": "00:54:23,634",
    "start_sec": 3262.914,
    "end_sec": 3263.634,
    "zh": "你怎么笑了",
    "vi": "Sao bạn lại cười thế."
  },
  {
    "idx": 2086,
    "start": "00:54:23,634",
    "end": "00:54:24,514",
    "start_sec": 3263.634,
    "end_sec": 3264.514,
    "zh": "说来",
    "vi": "Nói mới nhớ."
  },
  {
    "idx": 2087,
    "start": "00:54:24,514",
    "end": "00:54:26,594",
    "start_sec": 3264.514,
    "end_sec": 3266.594,
    "zh": "要是过去的我和那个乖二代会好了",
    "vi": "Nếu bản thân trong quá khứ thân thiết với cậu ấm con quan đó."
  },
  {
    "idx": 2088,
    "start": "00:54:26,594",
    "end": "00:54:27,914",
    "start_sec": 3266.594,
    "end_sec": 3267.914,
    "zh": "我是不是能从他那里",
    "vi": "Liệu tôi có thể từ chỗ anh ta."
  },
  {
    "idx": 2089,
    "start": "00:54:27,914",
    "end": "00:54:29,894",
    "start_sec": 3267.914,
    "end_sec": 3269.894,
    "zh": "得到一些常人无法得知的情报呢",
    "vi": "Có được một số thông tin mà người thường không thể biết được không."
  },
  {
    "idx": 2090,
    "start": "00:54:29,894",
    "end": "00:54:31,094",
    "start_sec": 3269.894,
    "end_sec": 3271.094,
    "zh": "这么想着",
    "vi": "Nghĩ đến đây."
  },
  {
    "idx": 2091,
    "start": "00:54:31,094",
    "end": "00:54:32,614",
    "start_sec": 3271.094,
    "end_sec": 3272.614,
    "zh": "橙子皮有些凄悍的",
    "vi": "Trần Tử Bì có chút mong đợi."
  },
  {
    "idx": 2092,
    "start": "00:54:32,614",
    "end": "00:54:34,374",
    "start_sec": 3272.614,
    "end_sec": 3274.374,
    "zh": "看向了手机的好友栏",
    "vi": "Nhìn vào danh sách bạn bè trên điện thoại."
  },
  {
    "idx": 2093,
    "start": "00:54:34,374",
    "end": "00:54:35,614",
    "start_sec": 3274.374,
    "end_sec": 3275.614,
    "zh": "夜晚再次来临",
    "vi": "Màn đêm lại buông xuống."
  },
  {
    "idx": 2094,
    "start": "00:54:35,614",
    "end": "00:54:36,654",
    "start_sec": 3275.614,
    "end_sec": 3276.654,
    "zh": "血液拨开乌云",
    "vi": "Trăng máu gạt đi mây đen."
  },
  {
    "idx": 2095,
    "start": "00:54:36,654",
    "end": "00:54:39,174",
    "start_sec": 3276.654,
    "end_sec": 3279.174,
    "zh": "那熟悉的冷意再次吹进狐嘴里",
    "vi": "Cơn gió lạnh quen thuộc lại thổi vào trong phòng."
  },
  {
    "idx": 2096,
    "start": "00:54:39,174",
    "end": "00:54:41,414",
    "start_sec": 3279.174,
    "end_sec": 3281.414,
    "zh": "橙子皮从客厅站起",
    "vi": "Trần Tử Bì đứng dậy từ phòng khách."
  },
  {
    "idx": 2097,
    "start": "00:54:41,414",
    "end": "00:54:43,034",
    "start_sec": 3281.414,
    "end_sec": 3283.034,
    "zh": "有些警惕的缩在一角",
    "vi": "Cảnh giác nép vào một góc."
  },
  {
    "idx": 2098,
    "start": "00:54:43,034",
    "end": "00:54:44,834",
    "start_sec": 3283.034,
    "end_sec": 3284.834,
    "zh": "敲门鬼夜里活动白天消失",
    "vi": "Quỷ gõ cửa hoạt động vào ban đêm và biến mất vào ban ngày."
  },
  {
    "idx": 2099,
    "start": "00:54:44,834",
    "end": "00:54:45,734",
    "start_sec": 3284.834,
    "end_sec": 3285.734,
    "zh": "现在还不确定",
    "vi": "Hiện tại vẫn chưa chắc chắn."
  },
  {
    "idx": 2100,
    "start": "00:54:45,734",
    "end": "00:54:47,374",
    "start_sec": 3285.734,
    "end_sec": 3287.374,
    "zh": "晚上是不是会像游戏一样",
    "vi": "Liệu ban đêm có giống như trong trò chơi hay không."
  },
  {
    "idx": 2101,
    "start": "00:54:47,374",
    "end": "00:54:48,674",
    "start_sec": 3287.374,
    "end_sec": 3288.674,
    "zh": "重置在101房内",
    "vi": "Điểm hồi sinh ở trong phòng 101."
  },
  {
    "idx": 2102,
    "start": "00:54:54,991",
    "end": "00:55:03,236",
    "start_sec": 3294.991,
    "end_sec": 3303.236,
    "zh": "果然,枪门鬼在晚上,在101重置,重置地点是厨房,开完以后躲在卧室里就行。",
    "vi": "Quả nhiên, quỷ gõ cửa hồi sinh vào ban đêm ở phòng 101, địa điểm hồi sinh"
  },
  {
    "idx": 2102,
    "start": "00:55:03,236",
    "end": "00:55:10,511",
    "start_sec": 3303.236,
    "end_sec": 3310.511,
    "zh": "果然,枪门鬼在晚上,在101重置,重置地点是厨房,开完以后躲在卧室里就行。",
    "vi": "là nhà bếp, sau khi mở cửa chỉ cần trốn vào phòng ngủ là được."
  },
  {
    "idx": 2103,
    "start": "00:55:15,531",
    "end": "00:55:19,071",
    "start_sec": 3315.531,
    "end_sec": 3319.071,
    "zh": "谁啊,敲什么敲,不知道现在不能出门吗?",
    "vi": "Ai thế, gõ cái gì mà gõ, không biết bây giờ không được ra ngoài sao."
  },
  {
    "idx": 2104,
    "start": "00:55:21,671",
    "end": "00:55:23,431",
    "start_sec": 3321.671,
    "end_sec": 3323.431,
    "zh": "救命啊,救命啊!",
    "vi": "Cứu mạng với, cứu mạng với."
  },
  {
    "idx": 2105,
    "start": "00:55:24,991",
    "end": "00:55:26,491",
    "start_sec": 3324.991,
    "end_sec": 3326.491,
    "zh": "今晚又是一栋楼的末日",
    "vi": "Đêm nay lại là ngày tận thế của một tòa nhà."
  },
  {
    "idx": 2106,
    "start": "00:55:26,491",
    "end": "00:55:30,271",
    "start_sec": 3326.491,
    "end_sec": 3330.271,
    "zh": "橙子皮负责并行",
    "vi": "Trần Tử Bì phụ trách việc liên lạc song song."
  },
  {
    "idx": 2107,
    "start": "00:55:30,271",
    "end": "00:55:32,151",
    "start_sec": 3330.271,
    "end_sec": 3332.151,
    "zh": "夜里被惨吊声吵醒几次",
    "vi": "Ban đêm bị đánh thức mấy lần bởi tiếng kêu thảm thiết."
  },
  {
    "idx": 2108,
    "start": "00:55:32,151",
    "end": "00:55:33,271",
    "start_sec": 3332.151,
    "end_sec": 3333.271,
    "zh": "简单吃过饭后",
    "vi": "Sau khi ăn cơm qua loa."
  },
  {
    "idx": 2109,
    "start": "00:55:33,271",
    "end": "00:55:34,091",
    "start_sec": 3333.271,
    "end_sec": 3334.091,
    "zh": "他如昨日一般",
    "vi": "Cô ấy vẫn như ngày hôm qua."
  },
  {
    "idx": 2110,
    "start": "00:55:34,091",
    "end": "00:55:35,451",
    "start_sec": 3334.091,
    "end_sec": 3335.451,
    "zh": "勘察小区的外情况",
    "vi": "Khảo sát tình hình bên ngoài khu chung cư."
  },
  {
    "idx": 2111,
    "start": "00:55:35,451",
    "end": "00:55:37,131",
    "start_sec": 3335.451,
    "end_sec": 3337.131,
    "zh": "以及上网过去外地信息",
    "vi": "Và lên mạng tìm kiếm thông tin từ nơi khác."
  },
  {
    "idx": 2112,
    "start": "00:55:37,131",
    "end": "00:55:40,231",
    "start_sec": 3337.131,
    "end_sec": 3340.231,
    "zh": "但是并未得到任何实质性有用的内容",
    "vi": "Nhưng không nhận được bất kỳ nội dung hữu ích thực tế nào."
  },
  {
    "idx": 2113,
    "start": "00:55:40,231",
    "end": "00:55:41,691",
    "start_sec": 3340.231,
    "end_sec": 3341.691,
    "zh": "一直等到傍晚五点",
    "vi": "Chờ đợi cho đến năm giờ chiều."
  },
  {
    "idx": 2114,
    "start": "00:55:41,691",
    "end": "00:55:43,771",
    "start_sec": 3341.691,
    "end_sec": 3343.771,
    "zh": "我去",
    "vi": "Trời đất."
  },
  {
    "idx": 2115,
    "start": "00:55:43,771",
    "end": "00:55:45,651",
    "start_sec": 3343.771,
    "end_sec": 3345.651,
    "zh": "这个二代客户真行啊",
    "vi": "Khách hàng giàu có này được việc thật đấy."
  },
  {
    "idx": 2116,
    "start": "00:55:45,651",
    "end": "00:55:46,731",
    "start_sec": 3345.651,
    "end_sec": 3346.731,
    "zh": "我们再一起开开两把",
    "vi": "Chúng ta chơi thêm hai ván nữa."
  },
  {
    "idx": 2117,
    "start": "00:55:46,731",
    "end": "00:55:47,951",
    "start_sec": 3346.731,
    "end_sec": 3347.951,
    "zh": "他就签单了",
    "vi": "Là anh ta ký hợp đồng ngay."
  },
  {
    "idx": 2118,
    "start": "00:55:47,951",
    "end": "00:55:48,311",
    "start_sec": 3347.951,
    "end_sec": 3348.311,
    "zh": "对了",
    "vi": "Đúng rồi."
  },
  {
    "idx": 2119,
    "start": "00:55:48,311",
    "end": "00:55:49,511",
    "start_sec": 3348.311,
    "end_sec": 3349.511,
    "zh": "你有没有想要的东西",
    "vi": "Em có muốn món đồ gì không."
  },
  {
    "idx": 2120,
    "start": "00:55:49,511",
    "end": "00:55:51,231",
    "start_sec": 3349.511,
    "end_sec": 3351.231,
    "zh": "我提前给你准备准备",
    "vi": "Để anh chuẩn bị trước cho em."
  },
  {
    "idx": 2121,
    "start": "00:55:51,231",
    "end": "00:55:53,351",
    "start_sec": 3351.231,
    "end_sec": 3353.351,
    "zh": "想到昨天看到的那篇帖子",
    "vi": "Nghĩ đến bài đăng đã xem ngày hôm qua."
  },
  {
    "idx": 2122,
    "start": "00:55:53,351",
    "end": "00:55:54,771",
    "start_sec": 3353.351,
    "end_sec": 3354.771,
    "zh": "橙子皮回了一下",
    "vi": "Trần Tử Bì trả lời lại."
  },
  {
    "idx": 2123,
    "start": "00:55:54,771",
    "end": "00:55:56,691",
    "start_sec": 3354.771,
    "end_sec": 3356.691,
    "zh": "可以的话你买些老旧法器",
    "vi": "Nếu được thì anh mua một số pháp khí cũ kỹ đi."
  },
  {
    "idx": 2124,
    "start": "00:55:56,691",
    "end": "00:55:58,131",
    "start_sec": 3356.691,
    "end_sec": 3358.131,
    "zh": "最好在寺庙里买",
    "vi": "Tốt nhất là mua ở trong chùa."
  },
  {
    "idx": 2125,
    "start": "00:55:58,131",
    "end": "00:55:59,691",
    "start_sec": 3358.131,
    "end_sec": 3359.691,
    "zh": "你准备杀鬼",
    "vi": "Em định diệt quỷ sao."
  },
  {
    "idx": 2126,
    "start": "00:55:59,691",
    "end": "00:56:01,211",
    "start_sec": 3359.691,
    "end_sec": 3361.211,
    "zh": "不是我要杀鬼",
    "vi": "Không phải em muốn diệt quỷ."
  },
  {
    "idx": 2127,
    "start": "00:56:01,211",
    "end": "00:56:02,511",
    "start_sec": 3361.211,
    "end_sec": 3362.511,
    "zh": "而是鬼要杀我",
    "vi": "Mà là quỷ muốn giết em."
  },
  {
    "idx": 2128,
    "start": "00:56:02,511",
    "end": "00:56:06,111",
    "start_sec": 3362.511,
    "end_sec": 3366.111,
    "zh": "随后橙子皮与一个月前的自己说明现在的情况",
    "vi": "Sau đó Trần Tử Bì giải thích tình hình hiện tại với chính mình của một tháng trước."
  },
  {
    "idx": 2129,
    "start": "00:56:06,111",
    "end": "00:56:07,411",
    "start_sec": 3366.111,
    "end_sec": 3367.411,
    "zh": "那天男友回应",
    "vi": "Hôm đó bạn trai không phản hồi."
  },
  {
    "idx": 2130,
    "start": "00:56:07,411",
    "end": "00:56:09,631",
    "start_sec": 3367.411,
    "end_sec": 3369.631,
    "zh": "应该是忙着找寺庙去",
    "vi": "Chắc là đang bận đi tìm chùa rồi."
  },
  {
    "idx": 2131,
    "start": "00:56:09,631",
    "end": "00:56:11,751",
    "start_sec": 3369.631,
    "end_sec": 3371.751,
    "zh": "翻了翻好友栏",
    "vi": "Tôi lướt xem danh sách bạn bè."
  },
  {
    "idx": 2132,
    "start": "00:56:11,751",
    "end": "00:56:15,151",
    "start_sec": 3371.751,
    "end_sec": 3375.151,
    "zh": "橙子皮果然找到一个被诸为大客户的新朋友",
    "vi": "Trần Tử Bì tìm thấy một người bạn mới được coi là khách hàng lớn."
  },
  {
    "idx": 2133,
    "start": "00:56:15,151",
    "end": "00:56:15,591",
    "start_sec": 3375.151,
    "end_sec": 3375.591,
    "zh": "在吗",
    "vi": "Bạn có đó không."
  },
  {
    "idx": 2134,
    "start": "00:56:15,591",
    "end": "00:56:18,031",
    "start_sec": 3375.591,
    "end_sec": 3378.031,
    "zh": "身处特殊家庭的周扬",
    "vi": "Chu Dương xuất thân từ một gia đình đặc biệt."
  },
  {
    "idx": 2135,
    "start": "00:56:18,031",
    "end": "00:56:20,691",
    "start_sec": 3378.031,
    "end_sec": 3380.691,
    "zh": "对于末日肯定知道的比橙子皮要多",
    "vi": "Chắc chắn cậu ta biết về ngày tận thế nhiều hơn tôi."
  },
  {
    "idx": 2136,
    "start": "00:56:20,691",
    "end": "00:56:22,951",
    "start_sec": 3380.691,
    "end_sec": 3382.951,
    "zh": "之所以让过去的自己和他交朋友",
    "vi": "Lý do tôi để bản thân trong quá khứ kết bạn với cậu ta."
  },
  {
    "idx": 2137,
    "start": "00:56:22,951",
    "end": "00:56:23,811",
    "start_sec": 3382.951,
    "end_sec": 3383.811,
    "zh": "一来是赚钱",
    "vi": "Thứ nhất là để kiếm tiền."
  },
  {
    "idx": 2138,
    "start": "00:56:23,811",
    "end": "00:56:25,871",
    "start_sec": 3383.811,
    "end_sec": 3385.871,
    "zh": "二来是需要他的关系去的",
    "vi": "Thứ hai là cần mối quan hệ của cậu ta."
  },
  {
    "idx": 2139,
    "start": "00:56:25,871",
    "end": "00:56:27,051",
    "start_sec": 3385.871,
    "end_sec": 3387.051,
    "zh": "然而消息发出去后",
    "vi": "Tuy nhiên sau khi tin nhắn gửi đi."
  },
  {
    "idx": 2140,
    "start": "00:56:27,051",
    "end": "00:56:29,911",
    "start_sec": 3387.051,
    "end_sec": 3389.911,
    "zh": "周扬似乎意见大于陈子皮的意思也没有",
    "vi": "Chu Dương dường như không có ý kiến gì với Trần Tử Bì."
  },
  {
    "idx": 2141,
    "start": "00:56:29,911",
    "end": "00:56:32,571",
    "start_sec": 3389.911,
    "end_sec": 3392.571,
    "zh": "陈哥哥",
    "vi": "Anh Trần ơi."
  },
  {
    "idx": 2142,
    "start": "00:56:32,571",
    "end": "00:56:33,731",
    "start_sec": 3392.571,
    "end_sec": 3393.731,
    "zh": "你那还有吃的吗",
    "vi": "Anh còn đồ ăn không."
  },
  {
    "idx": 2143,
    "start": "00:56:33,731",
    "end": "00:56:34,871",
    "start_sec": 3393.731,
    "end_sec": 3394.871,
    "zh": "我家没有吃的了",
    "vi": "Nhà em hết sạch đồ ăn rồi."
  },
  {
    "idx": 2144,
    "start": "00:56:34,871",
    "end": "00:56:36,251",
    "start_sec": 3394.871,
    "end_sec": 3396.251,
    "zh": "能给我送点吗",
    "vi": "Anh có thể mang qua cho em một ít không."
  },
  {
    "idx": 2145,
    "start": "00:56:36,251",
    "end": "00:56:36,671",
    "start_sec": 3396.251,
    "end_sec": 3396.671,
    "zh": "呵呵",
    "vi": "Ha ha."
  },
  {
    "idx": 2146,
    "start": "00:56:36,671",
    "end": "00:56:37,931",
    "start_sec": 3396.671,
    "end_sec": 3397.931,
    "zh": "周扬的消息没等来",
    "vi": "Tin nhắn của Chu Dương thì chưa thấy đâu."
  },
  {
    "idx": 2147,
    "start": "00:56:37,931",
    "end": "00:56:39,251",
    "start_sec": 3397.931,
    "end_sec": 3399.251,
    "zh": "你倒是来找我了",
    "vi": "Mà cô lại tìm đến tôi trước."
  },
  {
    "idx": 2148,
    "start": "00:56:39,251",
    "end": "00:56:40,131",
    "start_sec": 3399.251,
    "end_sec": 3400.131,
    "zh": "看着那条信息",
    "vi": "Nhìn dòng tin nhắn đó."
  },
  {
    "idx": 2149,
    "start": "00:56:40,131",
    "end": "00:56:41,511",
    "start_sec": 3400.131,
    "end_sec": 3401.511,
    "zh": "陈子皮满脸厌恶",
    "vi": "Trần Tử Bì lộ rõ vẻ chán ghét."
  },
  {
    "idx": 2150,
    "start": "00:56:41,511",
    "end": "00:56:42,991",
    "start_sec": 3401.511,
    "end_sec": 3402.991,
    "zh": "为什么不是你过来拿呢",
    "vi": "Sao cô không tự qua đây mà lấy."
  },
  {
    "idx": 2151,
    "start": "00:56:42,991",
    "end": "00:56:44,591",
    "start_sec": 3402.991,
    "end_sec": 3404.591,
    "zh": "不过是利用我试探楼道里",
    "vi": "Chẳng qua là muốn lợi dụng tôi để thăm dò xem."
  },
  {
    "idx": 2152,
    "start": "00:56:44,591",
    "end": "00:56:45,551",
    "start_sec": 3404.591,
    "end_sec": 3405.551,
    "zh": "是个安全罢了",
    "vi": "Hành lang có an toàn hay không thôi."
  },
  {
    "idx": 2153,
    "start": "00:56:45,551",
    "end": "00:56:47,411",
    "start_sec": 3405.551,
    "end_sec": 3407.411,
    "zh": "陈子皮随手回了一截",
    "vi": "Trần Tử Bì tiện tay trả lời một câu."
  },
  {
    "idx": 2154,
    "start": "00:56:47,411",
    "end": "00:56:47,991",
    "start_sec": 3407.411,
    "end_sec": 3407.991,
    "zh": "不好意思",
    "vi": "Xin lỗi nhé."
  },
  {
    "idx": 2155,
    "start": "00:56:47,991",
    "end": "00:56:49,591",
    "start_sec": 3407.991,
    "end_sec": 3409.591,
    "zh": "我这边也没有吃的了",
    "vi": "Chỗ tôi cũng hết đồ ăn rồi."
  },
  {
    "idx": 2156,
    "start": "00:56:49,591",
    "end": "00:56:51,871",
    "start_sec": 3409.591,
    "end_sec": 3411.871,
    "zh": "一听陈子皮说没有食物",
    "vi": "Vừa nghe Trần Tử Bì nói không có thức ăn."
  },
  {
    "idx": 2157,
    "start": "00:56:51,871",
    "end": "00:56:53,371",
    "start_sec": 3411.871,
    "end_sec": 3413.371,
    "zh": "罗倩语气都变了",
    "vi": "Giọng điệu của La Thiến liền thay đổi."
  },
  {
    "idx": 2158,
    "start": "00:56:53,371",
    "end": "00:56:55,091",
    "start_sec": 3413.371,
    "end_sec": 3415.091,
    "zh": "那你不会出去找吗",
    "vi": "Vậy sao anh không ra ngoài mà tìm."
  },
  {
    "idx": 2159,
    "start": "00:56:55,091",
    "end": "00:56:56,611",
    "start_sec": 3415.091,
    "end_sec": 3416.611,
    "zh": "我这其实还有点土豆",
    "vi": "Thực ra tôi vẫn còn một ít khoai tây."
  },
  {
    "idx": 2160,
    "start": "00:56:56,611",
    "end": "00:56:57,611",
    "start_sec": 3416.611,
    "end_sec": 3417.611,
    "zh": "我吃一点猪一点",
    "vi": "Tôi ăn một chút là hết thôi."
  },
  {
    "idx": 2161,
    "start": "00:56:57,611",
    "end": "00:56:58,391",
    "start_sec": 3417.611,
    "end_sec": 3418.391,
    "zh": "也能对付",
    "vi": "Cũng đủ đối phó qua ngày."
  },
  {
    "idx": 2162,
    "start": "00:56:58,391",
    "end": "00:56:59,391",
    "start_sec": 3418.391,
    "end_sec": 3419.391,
    "zh": "要不你出去看看",
    "vi": "Hay là anh ra ngoài xem thử đi."
  },
  {
    "idx": 2163,
    "start": "00:56:59,391",
    "end": "00:57:00,751",
    "start_sec": 3419.391,
    "end_sec": 3420.751,
    "zh": "这楼里的食物我都不要",
    "vi": "Thức ăn trong tòa nhà này tôi không lấy đâu."
  },
  {
    "idx": 2164,
    "start": "00:57:00,751",
    "end": "00:57:01,831",
    "start_sec": 3420.751,
    "end_sec": 3421.831,
    "zh": "你自己拿吧",
    "vi": "Anh cứ tự mình lấy đi."
  },
  {
    "idx": 2165,
    "start": "00:57:01,831",
    "end": "00:57:03,471",
    "start_sec": 3421.831,
    "end_sec": 3423.471,
    "zh": "你怎么这么怕呀",
    "vi": "Sao anh lại nhát gan thế chứ."
  },
  {
    "idx": 2166,
    "start": "00:57:03,471",
    "end": "00:57:04,831",
    "start_sec": 3423.471,
    "end_sec": 3424.831,
    "zh": "一点都不像个男人",
    "vi": "Chẳng giống đàn ông chút nào."
  },
  {
    "idx": 2167,
    "start": "00:57:04,831",
    "end": "00:57:05,691",
    "start_sec": 3424.831,
    "end_sec": 3425.691,
    "zh": "还有师妹",
    "vi": "Còn cả sư muội nữa."
  },
  {
    "idx": 2168,
    "start": "00:57:05,691",
    "end": "00:57:06,171",
    "start_sec": 3425.691,
    "end_sec": 3426.171,
    "zh": "没事",
    "vi": "Không sao đâu."
  },
  {
    "idx": 2169,
    "start": "00:57:06,171",
    "end": "00:57:07,611",
    "start_sec": 3426.171,
    "end_sec": 3427.611,
    "zh": "我吃土豆了呀",
    "vi": "Tôi ăn khoai tây rồi mà."
  },
  {
    "idx": 2170,
    "start": "00:57:07,611",
    "end": "00:57:07,851",
    "start_sec": 3427.611,
    "end_sec": 3427.851,
    "zh": "别",
    "vi": "Đừng."
  },
  {
    "idx": 2171,
    "start": "00:57:07,851",
    "end": "00:57:08,451",
    "start_sec": 3427.851,
    "end_sec": 3428.451,
    "zh": "别",
    "vi": "Đừng mà."
  },
  {
    "idx": 2172,
    "start": "00:57:08,451",
    "end": "00:57:09,391",
    "start_sec": 3428.451,
    "end_sec": 3429.391,
    "zh": "求求你了",
    "vi": "Tôi xin anh đấy."
  },
  {
    "idx": 2173,
    "start": "00:57:09,391",
    "end": "00:57:10,711",
    "start_sec": 3429.391,
    "end_sec": 3430.711,
    "zh": "给我送点食物吧",
    "vi": "Mang cho tôi ít thức ăn đi."
  },
  {
    "idx": 2174,
    "start": "00:57:10,711",
    "end": "00:57:11,431",
    "start_sec": 3430.711,
    "end_sec": 3431.431,
    "zh": "你来找我",
    "vi": "Anh đến tìm tôi đi."
  },
  {
    "idx": 2175,
    "start": "00:57:11,431",
    "end": "00:57:12,831",
    "start_sec": 3431.431,
    "end_sec": 3432.831,
    "zh": "我什么都会满足你的",
    "vi": "Tôi sẽ đáp ứng mọi yêu cầu của anh."
  },
  {
    "idx": 2176,
    "start": "00:57:12,831",
    "end": "00:57:14,851",
    "start_sec": 3432.831,
    "end_sec": 3434.851,
    "zh": "听着诱惑力十足的话",
    "vi": "Nghe những lời đầy cám dỗ này."
  },
  {
    "idx": 2177,
    "start": "00:57:14,851",
    "end": "00:57:16,971",
    "start_sec": 3434.851,
    "end_sec": 3436.971,
    "zh": "橙子皮只觉得浑身鸡皮疙瘩",
    "vi": "Trần Tử Bì chỉ thấy nổi hết da gà."
  },
  {
    "idx": 2178,
    "start": "00:57:16,971",
    "end": "00:57:18,651",
    "start_sec": 3436.971,
    "end_sec": 3438.651,
    "zh": "瞬间关上手机",
    "vi": "Anh lập tức tắt điện thoại."
  },
  {
    "idx": 2179,
    "start": "00:57:18,651",
    "end": "00:57:20,771",
    "start_sec": 3438.651,
    "end_sec": 3440.771,
    "zh": "橙子皮",
    "vi": "Trần Tử Bì."
  },
  {
    "idx": 2180,
    "start": "00:57:20,771",
    "end": "00:57:21,791",
    "start_sec": 3440.771,
    "end_sec": 3441.791,
    "zh": "你个窝囊费",
    "vi": "Đồ vô dụng nhà anh."
  },
  {
    "idx": 2181,
    "start": "00:57:21,791",
    "end": "00:57:23,111",
    "start_sec": 3441.791,
    "end_sec": 3443.111,
    "zh": "你就等着饿死吧",
    "vi": "Anh cứ đợi chết đói đi."
  },
  {
    "idx": 2182,
    "start": "00:57:23,371",
    "end": "00:57:25,311",
    "start_sec": 3443.371,
    "end_sec": 3445.311,
    "zh": "鬼一复苏",
    "vi": "Từ khi quỷ hồi sinh."
  },
  {
    "idx": 2183,
    "start": "00:57:25,311",
    "end": "00:57:26,611",
    "start_sec": 3445.311,
    "end_sec": 3446.611,
    "zh": "已经整整两天了",
    "vi": "Đã trọn vẹn hai ngày rồi."
  },
  {
    "idx": 2184,
    "start": "00:57:26,611",
    "end": "00:57:27,451",
    "start_sec": 3446.611,
    "end_sec": 3447.451,
    "zh": "很多家庭储养",
    "vi": "Nhiều gia đình tích trữ lương thực."
  },
  {
    "idx": 2185,
    "start": "00:57:27,451",
    "end": "00:57:28,411",
    "start_sec": 3447.451,
    "end_sec": 3448.411,
    "zh": "应该都用光了",
    "vi": "Chắc là đã dùng hết sạch rồi."
  },
  {
    "idx": 2186,
    "start": "00:57:28,411",
    "end": "00:57:29,851",
    "start_sec": 3448.411,
    "end_sec": 3449.851,
    "zh": "橙子皮吃完饭",
    "vi": "Trần Tử Bì ăn cơm xong."
  },
  {
    "idx": 2187,
    "start": "00:57:29,851",
    "end": "00:57:31,051",
    "start_sec": 3449.851,
    "end_sec": 3451.051,
    "zh": "在窗口边往外翻",
    "vi": "Liền từ cửa sổ nhìn ra ngoài."
  },
  {
    "idx": 2188,
    "start": "00:57:31,051",
    "end": "00:57:31,891",
    "start_sec": 3451.051,
    "end_sec": 3451.891,
    "zh": "果不其然",
    "vi": "Quả nhiên không ngoài dự đoán."
  },
  {
    "idx": 2189,
    "start": "00:57:31,891",
    "end": "00:57:33,131",
    "start_sec": 3451.891,
    "end_sec": 3453.131,
    "zh": "街上的一楼看见",
    "vi": "Ở ngay tầng một trên đường phố."
  },
  {
    "idx": 2190,
    "start": "00:57:33,131",
    "end": "00:57:33,771",
    "start_sec": 3453.131,
    "end_sec": 3453.771,
    "zh": "就能看到",
    "vi": "Là có thể nhìn thấy."
  },
  {
    "idx": 2191,
    "start": "00:57:33,771",
    "end": "00:57:34,691",
    "start_sec": 3453.771,
    "end_sec": 3454.691,
    "zh": "有几栋楼户",
    "vi": "Có mấy tòa nhà"
  },
  {
    "idx": 2192,
    "start": "00:57:34,691",
    "end": "00:57:35,411",
    "start_sec": 3454.691,
    "end_sec": 3455.411,
    "zh": "都探出了",
    "vi": "Đều thò ra"
  },
  {
    "idx": 2193,
    "start": "00:57:35,411",
    "end": "00:57:36,211",
    "start_sec": 3455.411,
    "end_sec": 3456.211,
    "zh": "那么的大量外面",
    "vi": "Ngoài trời đầy nắng"
  },
  {
    "idx": 2194,
    "start": "00:57:36,211",
    "end": "00:57:37,531",
    "start_sec": 3456.211,
    "end_sec": 3457.531,
    "zh": "两人月色的阳光下",
    "vi": "Dưới ánh nắng ban mai"
  },
  {
    "idx": 2195,
    "start": "00:57:37,531",
    "end": "00:57:38,711",
    "start_sec": 3457.531,
    "end_sec": 3458.711,
    "zh": "每个人都警惕的",
    "vi": "Mọi người đều cảnh giác"
  },
  {
    "idx": 2196,
    "start": "00:57:38,711",
    "end": "00:57:39,451",
    "start_sec": 3458.711,
    "end_sec": 3459.451,
    "zh": "看着绿化带",
    "vi": "Nhìn khu cây xanh"
  },
  {
    "idx": 2197,
    "start": "00:57:39,451",
    "end": "00:57:40,211",
    "start_sec": 3459.451,
    "end_sec": 3460.211,
    "zh": "谁也不敢",
    "vi": "Không ai dám"
  },
  {
    "idx": 2198,
    "start": "00:57:40,211",
    "end": "00:57:41,311",
    "start_sec": 3460.211,
    "end_sec": 3461.311,
    "zh": "走到小区楼的",
    "vi": "Đi đến khu nhà"
  },
  {
    "idx": 2199,
    "start": "00:57:41,311",
    "end": "00:57:42,251",
    "start_sec": 3461.311,
    "end_sec": 3462.251,
    "zh": "胡子",
    "vi": "Của khu dân cư"
  },
  {
    "idx": 2200,
    "start": "00:57:42,251",
    "end": "00:57:43,131",
    "start_sec": 3462.251,
    "end_sec": 3463.131,
    "zh": "胡子",
    "vi": "Của khu dân cư"
  },
  {
    "idx": 2201,
    "start": "00:57:43,131",
    "end": "00:57:44,471",
    "start_sec": 3463.131,
    "end_sec": 3464.471,
    "zh": "我知道你累了",
    "vi": "Mẹ biết con mệt rồi"
  },
  {
    "idx": 2202,
    "start": "00:57:44,471",
    "end": "00:57:45,351",
    "start_sec": 3464.471,
    "end_sec": 3465.351,
    "zh": "再等一等",
    "vi": "Cố gắng thêm chút nữa"
  },
  {
    "idx": 2203,
    "start": "00:57:45,351",
    "end": "00:57:46,091",
    "start_sec": 3465.351,
    "end_sec": 3466.091,
    "zh": "再等一等",
    "vi": "Cố gắng thêm chút nữa"
  },
  {
    "idx": 2204,
    "start": "00:57:46,091",
    "end": "00:57:47,111",
    "start_sec": 3466.091,
    "end_sec": 3467.111,
    "zh": "妈妈不肯出去",
    "vi": "Mẹ không chịu ra ngoài"
  },
  {
    "idx": 2205,
    "start": "00:57:47,111",
    "end": "00:57:49,891",
    "start_sec": 3467.111,
    "end_sec": 3469.891,
    "zh": "敲门鬼透过罗倩",
    "vi": "Tiếng gõ cửa qua Lạc Thiến"
  },
  {
    "idx": 2206,
    "start": "00:57:49,891",
    "end": "00:57:50,871",
    "start_sec": 3469.891,
    "end_sec": 3470.871,
    "zh": "到底是不是因为",
    "vi": "Liệu có phải vì"
  },
  {
    "idx": 2207,
    "start": "00:57:50,871",
    "end": "00:57:51,491",
    "start_sec": 3470.871,
    "end_sec": 3471.491,
    "zh": "黑狗的原因",
    "vi": "Chuyện con chó đen không"
  },
  {
    "idx": 2208,
    "start": "00:57:51,491",
    "end": "00:57:52,711",
    "start_sec": 3471.491,
    "end_sec": 3472.711,
    "zh": "或许马上就知道了",
    "vi": "Có lẽ sắp biết rồi"
  },
  {
    "idx": 2209,
    "start": "00:57:52,711",
    "end": "00:57:56,091",
    "start_sec": 3472.711,
    "end_sec": 3476.091,
    "zh": "坐在橙子皮还在观察外面的情况时",
    "vi": "Trong lúc Trừng Tử Bì đang quan sát tình hình bên ngoài"
  },
  {
    "idx": 2210,
    "start": "00:57:56,091",
    "end": "00:57:58,771",
    "start_sec": 3476.091,
    "end_sec": 3478.771,
    "zh": "客厅桌子上缓缓出现一盏小香笼",
    "vi": "Trên bàn phòng khách từ từ xuất hiện một lư hương nhỏ"
  },
  {
    "idx": 2211,
    "start": "00:57:58,771",
    "end": "00:58:02,351",
    "start_sec": 3478.771,
    "end_sec": 3482.351,
    "zh": "我去",
    "vi": "Trời ơi"
  },
  {
    "idx": 2212,
    "start": "00:58:02,351",
    "end": "00:58:03,671",
    "start_sec": 3482.351,
    "end_sec": 3483.671,
    "zh": "这炉子怎么热了的",
    "vi": "Sao cái lư này lại nóng thế"
  },
  {
    "idx": 2213,
    "start": "00:58:03,671",
    "end": "00:58:05,291",
    "start_sec": 3483.671,
    "end_sec": 3485.291,
    "zh": "过去的我不会真逃到宝贝了吧",
    "vi": "Tôi không phải đã trốn thoát đến bảo bối rồi chứ"
  },
  {
    "idx": 2214,
    "start": "00:58:05,291",
    "end": "00:58:07,311",
    "start_sec": 3485.291,
    "end_sec": 3487.311,
    "zh": "橙子皮慌忙拿起手机",
    "vi": "Trừng Tử Bì vội vàng cầm điện thoại lên"
  },
  {
    "idx": 2215,
    "start": "00:58:07,311",
    "end": "00:58:08,751",
    "start_sec": 3487.311,
    "end_sec": 3488.751,
    "zh": "给过去的女警发交警",
    "vi": "Gọi cho cảnh sát giao thông lúc trước"
  },
  {
    "idx": 2216,
    "start": "00:58:08,751",
    "end": "00:58:11,211",
    "start_sec": 3488.751,
    "end_sec": 3491.211,
    "zh": "你这炉子从哪弄来的",
    "vi": "Cậu lấy cái lư này ở đâu ra vậy"
  },
  {
    "idx": 2217,
    "start": "00:58:11,211",
    "end": "00:58:13,011",
    "start_sec": 3491.211,
    "end_sec": 3493.011,
    "zh": "昨晚我买法器碰到了周扬",
    "vi": "Tối qua tôi đi mua pháp khí thì gặp Chu Dương"
  },
  {
    "idx": 2218,
    "start": "00:58:13,011",
    "end": "00:58:14,731",
    "start_sec": 3493.011,
    "end_sec": 3494.731,
    "zh": "结果他就带我去永德寺了",
    "vi": "Kết quả anh ấy đưa tôi đến chùa Vĩnh Đức"
  },
  {
    "idx": 2219,
    "start": "00:58:14,731",
    "end": "00:58:16,591",
    "start_sec": 3494.731,
    "end_sec": 3496.591,
    "zh": "永德寺说是寺庙居然只有几十平",
    "vi": "Chùa Vĩnh Đức nói là chùa mà chỉ có mấy chục mét vuông"
  },
  {
    "idx": 2220,
    "start": "00:58:16,591",
    "end": "00:58:17,731",
    "start_sec": 3496.591,
    "end_sec": 3497.731,
    "zh": "就是个小土地庙",
    "vi": "Chỉ là một ngôi miếu nhỏ thôi"
  },
  {
    "idx": 2221,
    "start": "00:58:17,731",
    "end": "00:58:19,491",
    "start_sec": 3497.731,
    "end_sec": 3499.491,
    "zh": "公共的佛像我也没看出来是什么",
    "vi": "Tượng Phật ở nơi công cộng tôi cũng không nhìn ra là tượng gì."
  },
  {
    "idx": 2222,
    "start": "00:58:19,491",
    "end": "00:58:20,911",
    "start_sec": 3499.491,
    "end_sec": 3500.911,
    "zh": "但周扬说这里很灵",
    "vi": "Nhưng Chu Dương nói nơi này rất linh thiêng."
  },
  {
    "idx": 2223,
    "start": "00:58:20,911",
    "end": "00:58:22,631",
    "start_sec": 3500.911,
    "end_sec": 3502.631,
    "zh": "然后我就交一万箱火钱",
    "vi": "Thế là tôi đóng mười nghìn tiền công đức."
  },
  {
    "idx": 2224,
    "start": "00:58:22,631",
    "end": "00:58:23,711",
    "start_sec": 3502.631,
    "end_sec": 3503.711,
    "zh": "给我这个香炉",
    "vi": "Để nhận chiếc lư hương này."
  },
  {
    "idx": 2225,
    "start": "00:58:23,711",
    "end": "00:58:26,231",
    "start_sec": 3503.711,
    "end_sec": 3506.231,
    "zh": "说这是给神仙老爷传播香火的东西",
    "vi": "Họ nói đây là vật để truyền bá hương khói cho các vị thần tiên."
  },
  {
    "idx": 2226,
    "start": "00:58:26,231",
    "end": "00:58:27,711",
    "start_sec": 3506.231,
    "end_sec": 3507.711,
    "zh": "这些避灾绝对够用",
    "vi": "Thứ này chắc chắn đủ để tránh tai ương."
  },
  {
    "idx": 2227,
    "start": "00:58:27,711",
    "end": "00:58:30,191",
    "start_sec": 3507.711,
    "end_sec": 3510.191,
    "zh": "一个炉子竟然要一万",
    "vi": "Một chiếc lư hương mà giá tận mười nghìn."
  },
  {
    "idx": 2228,
    "start": "00:58:30,191",
    "end": "00:58:32,051",
    "start_sec": 3510.191,
    "end_sec": 3512.051,
    "zh": "这年头法器都这么贵",
    "vi": "Thời buổi này pháp khí đều đắt đỏ như vậy."
  },
  {
    "idx": 2229,
    "start": "00:58:32,051",
    "end": "00:58:33,991",
    "start_sec": 3512.051,
    "end_sec": 3513.991,
    "zh": "不过感觉挺厉害的",
    "vi": "Nhưng cảm giác nó rất lợi hại."
  },
  {
    "idx": 2230,
    "start": "00:58:33,991",
    "end": "00:58:35,211",
    "start_sec": 3513.991,
    "end_sec": 3515.211,
    "zh": "应该不至于作假吧",
    "vi": "Chắc không đến mức là đồ giả đâu."
  },
  {
    "idx": 2231,
    "start": "00:58:35,211",
    "end": "00:58:37,491",
    "start_sec": 3515.211,
    "end_sec": 3517.491,
    "zh": "看来周扬估计真知道点什么",
    "vi": "Xem ra Chu Dương có lẽ thực sự biết điều gì đó."
  },
  {
    "idx": 2232,
    "start": "00:58:37,491",
    "end": "00:58:40,111",
    "start_sec": 3517.491,
    "end_sec": 3520.111,
    "zh": "有机会还是要拉紧拉紧关系",
    "vi": "Nếu có cơ hội thì vẫn nên thắt chặt mối quan hệ."
  },
  {
    "idx": 2233,
    "start": "00:58:40,111",
    "end": "00:58:44,211",
    "start_sec": 3520.111,
    "end_sec": 3524.211,
    "zh": "长者皮爱不退手的把玩的香炉",
    "vi": "Trần Tử Bì mân mê chiếc lư hương không rời tay."
  },
  {
    "idx": 2234,
    "start": "00:58:44,211",
    "end": "00:58:46,211",
    "start_sec": 3524.211,
    "end_sec": 3526.211,
    "zh": "突然想到一个不合理的问题",
    "vi": "Đột nhiên nghĩ đến một vấn đề không hợp lý."
  },
  {
    "idx": 2235,
    "start": "00:58:46,211",
    "end": "00:58:48,591",
    "start_sec": 3526.211,
    "end_sec": 3528.591,
    "zh": "既然过去的我买的香炉现在能收到",
    "vi": "Nếu tôi trong quá khứ mua lư hương mà tôi ở hiện tại lại nhận được."
  },
  {
    "idx": 2236,
    "start": "00:58:48,591",
    "end": "00:58:50,471",
    "start_sec": 3528.591,
    "end_sec": 3530.471,
    "zh": "就说明过去的我和现在的我",
    "vi": "Thì chứng tỏ tôi trong quá khứ và tôi ở hiện tại."
  },
  {
    "idx": 2237,
    "start": "00:58:50,471",
    "end": "00:58:51,611",
    "start_sec": 3530.471,
    "end_sec": 3531.611,
    "zh": "在一条时间线上",
    "vi": "Đang ở trên cùng một dòng thời gian."
  },
  {
    "idx": 2238,
    "start": "00:58:51,611",
    "end": "00:58:54,191",
    "start_sec": 3531.611,
    "end_sec": 3534.191,
    "zh": "那为什么现在的我却没有买香无的记忆呢",
    "vi": "Vậy tại sao tôi ở hiện tại lại không có ký ức về việc mua lư hương."
  },
  {
    "idx": 2239,
    "start": "00:58:54,191",
    "end": "00:58:57,091",
    "start_sec": 3534.191,
    "end_sec": 3537.091,
    "zh": "还是说原本就是两个平行时间线",
    "vi": "Hay vốn dĩ đây là hai dòng thời gian song song."
  },
  {
    "idx": 2240,
    "start": "00:58:57,091",
    "end": "00:58:58,911",
    "start_sec": 3537.091,
    "end_sec": 3538.911,
    "zh": "只在某个关键点上才相交",
    "vi": "Chỉ giao nhau tại một thời điểm mấu chốt nào đó."
  },
  {
    "idx": 2241,
    "start": "00:58:58,911",
    "end": "00:59:01,611",
    "start_sec": 3538.911,
    "end_sec": 3541.611,
    "zh": "就在橙子皮对这个问题感到困惑时",
    "vi": "Ngay khi Trần Tử Bì đang cảm thấy bối rối về vấn đề này."
  },
  {
    "idx": 2242,
    "start": "00:59:01,611",
    "end": "00:59:03,971",
    "start_sec": 3541.611,
    "end_sec": 3543.971,
    "zh": "楼上发来一阵剧烈的拳吠声",
    "vi": "Trên lầu bỗng vang lên tiếng chó sủa dữ dội."
  },
  {
    "idx": 2243,
    "start": "00:59:03,971",
    "end": "00:59:06,131",
    "start_sec": 3543.971,
    "end_sec": 3546.131,
    "zh": "妈妈知道你饿了",
    "vi": "Mẹ biết con đói rồi."
  },
  {
    "idx": 2244,
    "start": "00:59:06,131",
    "end": "00:59:08,291",
    "start_sec": 3546.131,
    "end_sec": 3548.291,
    "zh": "那个超能的东西两天没出现了",
    "vi": "Thứ đáng sợ kia đã hai ngày không xuất hiện rồi."
  },
  {
    "idx": 2245,
    "start": "00:59:08,291",
    "end": "00:59:08,651",
    "start_sec": 3548.291,
    "end_sec": 3548.651,
    "zh": "乖",
    "vi": "Ngoan nào."
  },
  {
    "idx": 2246,
    "start": "00:59:08,651",
    "end": "00:59:10,011",
    "start_sec": 3548.651,
    "end_sec": 3550.011,
    "zh": "你出门去狗地家",
    "vi": "Con đi ra ngoài đến nhà Goudi đi."
  },
  {
    "idx": 2247,
    "start": "00:59:10,011",
    "end": "00:59:11,411",
    "start_sec": 3550.011,
    "end_sec": 3551.411,
    "zh": "有什么吃的都叼过来",
    "vi": "Có đồ gì ăn được thì cứ tha về đây."
  },
  {
    "idx": 2248,
    "start": "00:59:11,411",
    "end": "00:59:12,191",
    "start_sec": 3551.411,
    "end_sec": 3552.191,
    "zh": "听见了吗",
    "vi": "Nghe rõ chưa."
  },
  {
    "idx": 2249,
    "start": "00:59:21,611",
    "end": "00:59:28,591",
    "start_sec": 3561.611,
    "end_sec": 3568.591,
    "zh": "吃个饭",
    "vi": "Ăn cơm thôi."
  },
  {
    "idx": 2250,
    "start": "00:59:28,591",
    "end": "00:59:29,471",
    "start_sec": 3568.591,
    "end_sec": 3569.471,
    "zh": "你真不懂",
    "vi": "Bạn thật sự không hiểu đâu."
  },
  {
    "idx": 2251,
    "start": "00:59:29,471",
    "end": "00:59:31,051",
    "start_sec": 3569.471,
    "end_sec": 3571.051,
    "zh": "不会吃完了回来的吧",
    "vi": "Chắc không phải ăn xong mới về đấy chứ."
  },
  {
    "idx": 2252,
    "start": "00:59:31,051",
    "end": "00:59:31,991",
    "start_sec": 3571.051,
    "end_sec": 3571.991,
    "zh": "算了",
    "vi": "Thôi bỏ đi."
  },
  {
    "idx": 2253,
    "start": "00:59:31,991",
    "end": "00:59:32,751",
    "start_sec": 3571.991,
    "end_sec": 3572.751,
    "zh": "你都没事",
    "vi": "Đến cả mày cũng không sao."
  },
  {
    "idx": 2254,
    "start": "00:59:32,751",
    "end": "00:59:33,931",
    "start_sec": 3572.751,
    "end_sec": 3573.931,
    "zh": "我也出门看看",
    "vi": "Tôi cũng ra ngoài xem thử vậy."
  },
  {
    "idx": 2255,
    "start": "00:59:33,931",
    "end": "00:59:38,851",
    "start_sec": 3573.931,
    "end_sec": 3578.851,
    "zh": "橙子皮听着楼上的动静",
    "vi": "Trần Tử Bì nghe ngóng động tĩnh ở trên lầu."
  },
  {
    "idx": 2256,
    "start": "00:59:38,851",
    "end": "00:59:42,151",
    "start_sec": 3578.851,
    "end_sec": 3582.151,
    "zh": "应该是罗剑在从八楼往下挨下挨户的小食物",
    "vi": "Chắc là La Thiến đang tìm kiếm thức ăn từng nhà một từ tầng tám xuống."
  },
  {
    "idx": 2257,
    "start": "00:59:42,151",
    "end": "00:59:43,011",
    "start_sec": 3582.151,
    "end_sec": 3583.011,
    "zh": "边找边骂",
    "vi": "Vừa tìm vừa chửi bới."
  },
  {
    "idx": 2258,
    "start": "00:59:43,011",
    "end": "00:59:44,791",
    "start_sec": 3583.011,
    "end_sec": 3584.791,
    "zh": "怎么吃的都没有了",
    "vi": "Sao chẳng còn cái gì ăn được thế này."
  },
  {
    "idx": 2259,
    "start": "00:59:44,791",
    "end": "00:59:46,911",
    "start_sec": 3584.791,
    "end_sec": 3586.911,
    "zh": "橙子皮是不是被你全部拿走了",
    "vi": "Trần Tử Bì, có phải anh đã lấy hết đi rồi không."
  },
  {
    "idx": 2260,
    "start": "00:59:46,911",
    "end": "00:59:48,311",
    "start_sec": 3586.911,
    "end_sec": 3588.311,
    "zh": "你怎么这么狂态",
    "vi": "Sao anh lại quá đáng như vậy."
  },
  {
    "idx": 2261,
    "start": "00:59:48,311",
    "end": "00:59:49,811",
    "start_sec": 3588.311,
    "end_sec": 3589.811,
    "zh": "一点也不考虑别人",
    "vi": "Không nghĩ cho người khác một chút nào cả."
  },
  {
    "idx": 2262,
    "start": "00:59:49,811",
    "end": "00:59:51,291",
    "start_sec": 3589.811,
    "end_sec": 3591.291,
    "zh": "你是冷血动物吗",
    "vi": "Anh là động vật máu lạnh à."
  },
  {
    "idx": 2263,
    "start": "00:59:51,291",
    "end": "00:59:52,571",
    "start_sec": 3591.291,
    "end_sec": 3592.571,
    "zh": "我说罗小姐",
    "vi": "Tôi nói này cô La."
  },
  {
    "idx": 2264,
    "start": "00:59:52,571",
    "end": "00:59:53,691",
    "start_sec": 3592.571,
    "end_sec": 3593.691,
    "zh": "你凭什么认为",
    "vi": "Dựa vào đâu mà cô nghĩ."
  },
  {
    "idx": 2265,
    "start": "00:59:53,691",
    "end": "00:59:54,971",
    "start_sec": 3593.691,
    "end_sec": 3594.971,
    "zh": "东西都是我拿的呢",
    "vi": "Mọi thứ đều do tôi lấy chứ."
  },
  {
    "idx": 2266,
    "start": "00:59:54,971",
    "end": "00:59:56,791",
    "start_sec": 3594.971,
    "end_sec": 3596.791,
    "zh": "我每天都盯着下面看",
    "vi": "Ngày nào tôi cũng quan sát bên dưới."
  },
  {
    "idx": 2267,
    "start": "00:59:56,791",
    "end": "00:59:58,051",
    "start_sec": 3596.791,
    "end_sec": 3598.051,
    "zh": "我们这个单元楼",
    "vi": "Khu nhà của chúng ta."
  },
  {
    "idx": 2268,
    "start": "00:59:58,051",
    "end": "00:59:59,271",
    "start_sec": 3598.051,
    "end_sec": 3599.271,
    "zh": "根本就没人来过",
    "vi": "Vốn dĩ không có ai đến cả."
  },
  {
    "idx": 2269,
    "start": "00:59:59,271",
    "end": "00:59:59,871",
    "start_sec": 3599.271,
    "end_sec": 3599.871,
    "zh": "楼里",
    "vi": "Trong tòa nhà này."
  },
  {
    "idx": 2270,
    "start": "01:00:00,000",
    "end": "01:00:02,740",
    "start_sec": 3600.0,
    "end_sec": 3602.74,
    "zh": "我们两个活人,你说食物不在你这",
    "vi": "Chỉ có hai người sống là chúng ta, anh nói thức ăn không ở chỗ anh sao."
  },
  {
    "idx": 2271,
    "start": "01:00:02,740",
    "end": "01:00:05,780",
    "start_sec": 3602.74,
    "end_sec": 3605.78,
    "zh": "也就是说,其实你每天都观察外面的情况",
    "vi": "Nói cách khác, thật ra ngày nào cô cũng quan sát tình hình bên ngoài."
  },
  {
    "idx": 2272,
    "start": "01:00:05,780",
    "end": "01:00:08,920",
    "start_sec": 3605.78,
    "end_sec": 3608.92,
    "zh": "可是为什么,昨天我问你小区里的叫喊声是什么情况",
    "vi": "Nhưng tại sao hôm qua tôi hỏi cô về tiếng la hét trong khu chung cư là thế nào."
  },
  {
    "idx": 2273,
    "start": "01:00:08,920",
    "end": "01:00:10,900",
    "start_sec": 3608.92,
    "end_sec": 3610.9,
    "zh": "你说不知道,还建议我出去呢",
    "vi": "Cô lại bảo không biết, còn khuyên tôi nên đi ra ngoài."
  },
  {
    "idx": 2274,
    "start": "01:00:10,900",
    "end": "01:00:12,440",
    "start_sec": 3610.9,
    "end_sec": 3612.44,
    "zh": "难道不是为了利用我",
    "vi": "Chẳng lẽ không phải là để lợi dụng tôi sao."
  },
  {
    "idx": 2275,
    "start": "01:00:12,440",
    "end": "01:00:18,140",
    "start_sec": 3612.44,
    "end_sec": 3618.14,
    "zh": "罗倩的心思被橙子皮戳穿,面色泛红,恼羞了好一阵",
    "vi": "Ý đồ của La Thiến bị Trần Tử Bì vạch trần, mặt cô đỏ bừng lên vì xấu hổ và tức giận."
  },
  {
    "idx": 2276,
    "start": "01:00:18,140",
    "end": "01:00:23,000",
    "start_sec": 3618.14,
    "end_sec": 3623.0,
    "zh": "反正我不管,这楼里的食物,按道理,我应该有一半的所有权",
    "vi": "Dù sao tôi không quan tâm, thức ăn trong tòa nhà này theo lý tôi phải được một nửa."
  },
  {
    "idx": 2277,
    "start": "01:00:23,680",
    "end": "01:00:27,980",
    "start_sec": 3623.68,
    "end_sec": 3627.98,
    "zh": "橙子皮没有理会的,反手就要拉窗帘,罗倩才是她妈的",
    "vi": "Trần Tử Bì không thèm để ý, liền kéo rèm cửa lại, La Thiến tức giận mắng mỏ."
  },
  {
    "idx": 2278,
    "start": "01:00:27,980",
    "end": "01:00:28,920",
    "start_sec": 3627.98,
    "end_sec": 3628.92,
    "zh": "蚕子皮",
    "vi": "Trần Tử Bì."
  },
  {
    "idx": 2279,
    "start": "01:00:28,920",
    "end": "01:00:30,560",
    "start_sec": 3628.92,
    "end_sec": 3630.56,
    "zh": "你他妈的不是个男人",
    "vi": "Anh không phải là đàn ông."
  },
  {
    "idx": 2280,
    "start": "01:00:30,560",
    "end": "01:00:32,080",
    "start_sec": 3630.56,
    "end_sec": 3632.08,
    "zh": "欺负我一个女人算什么",
    "vi": "Ăn hiếp một người phụ nữ như tôi thì có gì hay chứ."
  },
  {
    "idx": 2281,
    "start": "01:00:32,080",
    "end": "01:00:34,260",
    "start_sec": 3632.08,
    "end_sec": 3634.26,
    "zh": "一个女人和一条狗",
    "vi": "Một người phụ nữ và một con chó"
  },
  {
    "idx": 2282,
    "start": "01:00:34,260",
    "end": "01:00:35,920",
    "start_sec": 3634.26,
    "end_sec": 3635.92,
    "zh": "的确不能拿成个皮怎么样",
    "vi": "Thật sự không thể làm gì được"
  },
  {
    "idx": 2283,
    "start": "01:00:35,920",
    "end": "01:00:37,520",
    "start_sec": 3635.92,
    "end_sec": 3637.52,
    "zh": "但兔子急了还咬人呢",
    "vi": "Nhưng thỏ cùng đường còn cắn người"
  },
  {
    "idx": 2284,
    "start": "01:00:37,520",
    "end": "01:00:38,140",
    "start_sec": 3637.52,
    "end_sec": 3638.14,
    "zh": "他想了想",
    "vi": "Anh ta suy nghĩ"
  },
  {
    "idx": 2285,
    "start": "01:00:38,140",
    "end": "01:00:39,840",
    "start_sec": 3638.14,
    "end_sec": 3639.84,
    "zh": "我去的自己发了条消息",
    "vi": "Tôi đã tự mình gửi một tin nhắn"
  },
  {
    "idx": 2286,
    "start": "01:00:39,840",
    "end": "01:00:41,480",
    "start_sec": 3639.84,
    "end_sec": 3641.48,
    "zh": "门窗以后换上防盗",
    "vi": "Sau này cửa sổ sẽ được thay bằng loại chống trộm"
  },
  {
    "idx": 2287,
    "start": "01:00:41,480",
    "end": "01:00:41,920",
    "start_sec": 3641.48,
    "end_sec": 3641.92,
    "zh": "不",
    "vi": "Không"
  },
  {
    "idx": 2288,
    "start": "01:00:41,920",
    "end": "01:00:42,640",
    "start_sec": 3641.92,
    "end_sec": 3642.64,
    "zh": "防弹吧",
    "vi": "Chống đạn đi"
  },
  {
    "idx": 2289,
    "start": "01:00:42,640",
    "end": "01:00:45,360",
    "start_sec": 3642.64,
    "end_sec": 3645.36,
    "zh": "这是门外传来螺旋慌张的叫喊声",
    "vi": "Tiếng kêu hoảng loạn vang lên từ bên ngoài cửa"
  },
  {
    "idx": 2290,
    "start": "01:00:45,360",
    "end": "01:00:45,920",
    "start_sec": 3645.36,
    "end_sec": 3645.92,
    "zh": "虎子",
    "vi": "Hổ tử"
  },
  {
    "idx": 2291,
    "start": "01:00:45,920",
    "end": "01:00:46,600",
    "start_sec": 3645.92,
    "end_sec": 3646.6,
    "zh": "虎子",
    "vi": "Hổ tử"
  },
  {
    "idx": 2292,
    "start": "01:00:46,600",
    "end": "01:00:47,420",
    "start_sec": 3646.6,
    "end_sec": 3647.42,
    "zh": "危险啊",
    "vi": "Nguy hiểm lắm"
  },
  {
    "idx": 2293,
    "start": "01:00:47,420",
    "end": "01:00:48,060",
    "start_sec": 3647.42,
    "end_sec": 3648.06,
    "zh": "别出去",
    "vi": "Đừng ra ngoài"
  },
  {
    "idx": 2294,
    "start": "01:00:48,060",
    "end": "01:00:52,820",
    "start_sec": 3648.06,
    "end_sec": 3652.82,
    "zh": "我操",
    "vi": "Đệt"
  },
  {
    "idx": 2295,
    "start": "01:00:52,820",
    "end": "01:00:55,220",
    "start_sec": 3652.82,
    "end_sec": 3655.22,
    "zh": "谁家狗再翻垃圾桶啊",
    "vi": "Nhà nào để chó lục thùng rác vậy"
  },
  {
    "idx": 2296,
    "start": "01:00:55,220",
    "end": "01:00:55,920",
    "start_sec": 3655.22,
    "end_sec": 3655.92,
    "zh": "完了完了",
    "vi": "Xong rồi xong rồi"
  },
  {
    "idx": 2297,
    "start": "01:00:55,920",
    "end": "01:00:57,100",
    "start_sec": 3655.92,
    "end_sec": 3657.1,
    "zh": "他必死无疑",
    "vi": "Anh ta chắc chắn sẽ chết"
  },
  {
    "idx": 2298,
    "start": "01:00:57,100",
    "end": "01:00:59,700",
    "start_sec": 3657.1,
    "end_sec": 3659.7,
    "zh": "昨天那个保安死的那叫一个财",
    "vi": "Bảo vệ hôm qua chết thảm lắm"
  },
  {
    "idx": 2299,
    "start": "01:00:59,700",
    "end": "01:01:03,320",
    "start_sec": 3659.7,
    "end_sec": 3663.32,
    "zh": "所有人哪怕是罗宪都觉得胡子必主无疑了",
    "vi": "Mọi người, kể cả La Hiến, đều nghĩ Hồ tử chắc chắn sẽ chết"
  },
  {
    "idx": 2300,
    "start": "01:01:03,320",
    "end": "01:01:04,400",
    "start_sec": 3663.32,
    "end_sec": 3664.4,
    "zh": "两人几分钟过去",
    "vi": "Vài phút trôi qua"
  },
  {
    "idx": 2301,
    "start": "01:01:04,400",
    "end": "01:01:06,980",
    "start_sec": 3664.4,
    "end_sec": 3666.98,
    "zh": "两戒同理发霉的剩饭被吃得干干净",
    "vi": "Phần cơm thừa mốc meo đã được ăn sạch sẽ"
  },
  {
    "idx": 2302,
    "start": "01:01:06,980",
    "end": "01:01:09,140",
    "start_sec": 3666.98,
    "end_sec": 3669.14,
    "zh": "那爬行女鬼也没有出现",
    "vi": "Con ma bò cái đó cũng không xuất hiện"
  },
  {
    "idx": 2303,
    "start": "01:01:09,140",
    "end": "01:01:10,620",
    "start_sec": 3669.14,
    "end_sec": 3670.62,
    "zh": "怎么回事",
    "vi": "Chuyện gì vậy"
  },
  {
    "idx": 2304,
    "start": "01:01:10,620",
    "end": "01:01:12,120",
    "start_sec": 3670.62,
    "end_sec": 3672.12,
    "zh": "那个蜘蛛女鬼走了吗",
    "vi": "Con ma nhện đó đi rồi sao"
  },
  {
    "idx": 2305,
    "start": "01:01:12,120",
    "end": "01:01:12,820",
    "start_sec": 3672.12,
    "end_sec": 3672.82,
    "zh": "不会吧",
    "vi": "Không thể nào"
  },
  {
    "idx": 2306,
    "start": "01:01:12,820",
    "end": "01:01:14,200",
    "start_sec": 3672.82,
    "end_sec": 3674.2,
    "zh": "那是不是我们可以出去了",
    "vi": "Vậy là chúng ta có thể ra ngoài rồi sao"
  },
  {
    "idx": 2307,
    "start": "01:01:14,200",
    "end": "01:01:18,260",
    "start_sec": 3674.2,
    "end_sec": 3678.26,
    "zh": "就在众人满怀期待时",
    "vi": "Ngay khi mọi người đang mong đợi"
  },
  {
    "idx": 2308,
    "start": "01:01:18,260",
    "end": "01:01:20,300",
    "start_sec": 3678.26,
    "end_sec": 3680.3,
    "zh": "一个长得酷似火鱼鞋似的男子",
    "vi": "Một người đàn ông trông giống hệt Hỏa Ngư"
  },
  {
    "idx": 2309,
    "start": "01:01:20,300",
    "end": "01:01:21,580",
    "start_sec": 3680.3,
    "end_sec": 3681.58,
    "zh": "壮着胆子走出家门",
    "vi": "Dũng cảm bước ra khỏi nhà"
  },
  {
    "idx": 2310,
    "start": "01:01:21,580",
    "end": "01:01:23,340",
    "start_sec": 3681.58,
    "end_sec": 3683.34,
    "zh": "左右看了看没什么危险",
    "vi": "Nhìn quanh không thấy nguy hiểm"
  },
  {
    "idx": 2311,
    "start": "01:01:23,340",
    "end": "01:01:24,920",
    "start_sec": 3683.34,
    "end_sec": 3684.92,
    "zh": "拔腿向前一边跑去",
    "vi": "Tôi cắm đầu chạy về phía trước."
  },
  {
    "idx": 2312,
    "start": "01:01:24,920",
    "end": "01:01:26,280",
    "start_sec": 3684.92,
    "end_sec": 3686.28,
    "zh": "刚跑出几步",
    "vi": "Vừa chạy được vài bước."
  },
  {
    "idx": 2313,
    "start": "01:01:26,280",
    "end": "01:01:28,240",
    "start_sec": 3686.28,
    "end_sec": 3688.24,
    "zh": "御化寨里一阵辛苦快用",
    "vi": "Tiếng động lạ vang lên trong trại."
  },
  {
    "idx": 2314,
    "start": "01:01:28,240",
    "end": "01:01:32,520",
    "start_sec": 3688.24,
    "end_sec": 3692.52,
    "zh": "阳开就要到便利店",
    "vi": "Dương Khai sắp đến cửa hàng tiện lợi."
  },
  {
    "idx": 2315,
    "start": "01:01:32,520",
    "end": "01:01:33,760",
    "start_sec": 3692.52,
    "end_sec": 3693.76,
    "zh": "那男子松了一口气",
    "vi": "Người đàn ông đó thở phào nhẹ nhõm."
  },
  {
    "idx": 2316,
    "start": "01:01:33,760",
    "end": "01:01:35,360",
    "start_sec": 3693.76,
    "end_sec": 3695.36,
    "zh": "慌一慌张的消失便利店",
    "vi": "Hắn vội vã biến mất vào cửa hàng."
  },
  {
    "idx": 2317,
    "start": "01:01:35,360",
    "end": "01:01:36,760",
    "start_sec": 3695.36,
    "end_sec": 3696.76,
    "zh": "老周快开门",
    "vi": "Lão Chu mở cửa nhanh lên."
  },
  {
    "idx": 2318,
    "start": "01:01:36,760",
    "end": "01:01:37,780",
    "start_sec": 3696.76,
    "end_sec": 3697.78,
    "zh": "我家没吃的了",
    "vi": "Nhà tôi hết đồ ăn rồi."
  },
  {
    "idx": 2319,
    "start": "01:01:37,780",
    "end": "01:01:38,720",
    "start_sec": 3697.78,
    "end_sec": 3698.72,
    "zh": "孩子还要喝奶",
    "vi": "Con tôi còn cần uống sữa."
  },
  {
    "idx": 2320,
    "start": "01:01:38,720",
    "end": "01:01:39,320",
    "start_sec": 3698.72,
    "end_sec": 3699.32,
    "zh": "你开门",
    "vi": "Bạn mở cửa đi."
  },
  {
    "idx": 2321,
    "start": "01:01:39,320",
    "end": "01:01:41,140",
    "start_sec": 3699.32,
    "end_sec": 3701.14,
    "zh": "我把家里所有的钱都给你",
    "vi": "Tôi sẽ đưa hết tiền trong nhà cho bạn."
  },
  {
    "idx": 2322,
    "start": "01:01:41,140",
    "end": "01:01:42,520",
    "start_sec": 3701.14,
    "end_sec": 3702.52,
    "zh": "然而不论外面如何",
    "vi": "Thế nhưng dù bên ngoài thế nào."
  },
  {
    "idx": 2323,
    "start": "01:01:42,520",
    "end": "01:01:43,600",
    "start_sec": 3702.52,
    "end_sec": 3703.6,
    "zh": "老周都省不见",
    "vi": "Lão Chu vẫn không thấy đâu."
  },
  {
    "idx": 2324,
    "start": "01:01:43,600",
    "end": "01:01:45,260",
    "start_sec": 3703.6,
    "end_sec": 3705.26,
    "zh": "你怎么还在这里",
    "vi": "Sao bạn vẫn còn ở đây."
  },
  {
    "idx": 2325,
    "start": "01:01:45,260",
    "end": "01:01:46,700",
    "start_sec": 3705.26,
    "end_sec": 3706.7,
    "zh": "刚才那黑狗出来就没事",
    "vi": "Con chó đen đó đi rồi thì không sao nữa."
  },
  {
    "idx": 2326,
    "start": "01:01:46,700",
    "end": "01:01:50,060",
    "start_sec": 3706.7,
    "end_sec": 3710.06,
    "zh": "那男子转身就要跑",
    "vi": "Người đàn ông đó quay người định chạy."
  },
  {
    "idx": 2327,
    "start": "01:01:50,060",
    "end": "01:01:51,760",
    "start_sec": 3710.06,
    "end_sec": 3711.76,
    "zh": "行动缓慢的女鬼",
    "vi": "Nữ quỷ di chuyển chậm chạp."
  },
  {
    "idx": 2328,
    "start": "01:01:51,760",
    "end": "01:01:52,980",
    "start_sec": 3711.76,
    "end_sec": 3712.98,
    "zh": "让他喝在男子背上",
    "vi": "Đã bám lấy lưng người đàn ông."
  },
  {
    "idx": 2329,
    "start": "01:01:52,980",
    "end": "01:01:55,120",
    "start_sec": 3712.98,
    "end_sec": 3715.12,
    "zh": "从他和警处开始愈口愈好喝水",
    "vi": "Từ chỗ tiếp xúc bắt đầu ăn mòn cơ thể."
  },
  {
    "idx": 2330,
    "start": "01:01:55,120",
    "end": "01:01:56,600",
    "start_sec": 3715.12,
    "end_sec": 3716.6,
    "zh": "尽管看不到",
    "vi": "Dù không nhìn thấy."
  },
  {
    "idx": 2331,
    "start": "01:01:56,600",
    "end": "01:01:57,320",
    "start_sec": 3716.6,
    "end_sec": 3717.32,
    "zh": "听声音",
    "vi": "Nhưng nghe tiếng động."
  },
  {
    "idx": 2332,
    "start": "01:01:57,320",
    "end": "01:01:58,320",
    "start_sec": 3717.32,
    "end_sec": 3718.32,
    "zh": "橙子皮一言之道",
    "vi": "Trình Tử đã hiểu rõ."
  },
  {
    "idx": 2333,
    "start": "01:01:58,320",
    "end": "01:01:59,320",
    "start_sec": 3718.32,
    "end_sec": 3719.32,
    "zh": "外面发生了什么",
    "vi": "Bên ngoài đã xảy ra chuyện gì."
  },
  {
    "idx": 2334,
    "start": "01:01:59,320",
    "end": "01:02:00,700",
    "start_sec": 3719.32,
    "end_sec": 3720.7,
    "zh": "罗倩的心目下闪",
    "vi": "Tim La Thiến đập liên hồi."
  },
  {
    "idx": 2335,
    "start": "01:02:00,700",
    "end": "01:02:02,080",
    "start_sec": 3720.7,
    "end_sec": 3722.08,
    "zh": "一刻也不敢待在屋外",
    "vi": "Cô không dám ở lại ngoài trời thêm giây nào."
  },
  {
    "idx": 2336,
    "start": "01:02:02,080",
    "end": "01:02:03,840",
    "start_sec": 3722.08,
    "end_sec": 3723.84,
    "zh": "带着狗儿子拔腿往家里跑",
    "vi": "Dắt theo con chó cưng chạy về nhà."
  },
  {
    "idx": 2337,
    "start": "01:02:03,840",
    "end": "01:02:05,900",
    "start_sec": 3723.84,
    "end_sec": 3725.9,
    "zh": "敲门鬼跳过罗倩",
    "vi": "Quỷ gõ cửa đã bỏ qua La Thiến."
  },
  {
    "idx": 2338,
    "start": "01:02:05,900",
    "end": "01:02:07,200",
    "start_sec": 3725.9,
    "end_sec": 3727.2,
    "zh": "爬行女鬼不杀胡子",
    "vi": "Nữ quỷ bò trườn không giết người."
  },
  {
    "idx": 2339,
    "start": "01:02:07,200",
    "end": "01:02:08,360",
    "start_sec": 3727.2,
    "end_sec": 3728.36,
    "zh": "现在基本可以断定",
    "vi": "Bây giờ có thể khẳng định."
  },
  {
    "idx": 2340,
    "start": "01:02:08,360",
    "end": "01:02:09,960",
    "start_sec": 3728.36,
    "end_sec": 3729.96,
    "zh": "诡异或者说一部分诡异",
    "vi": "Những thứ quỷ dị hoặc một phần của chúng."
  },
  {
    "idx": 2341,
    "start": "01:02:09,960",
    "end": "01:02:11,000",
    "start_sec": 3729.96,
    "end_sec": 3731.0,
    "zh": "惧怕黑狗",
    "vi": "Đều sợ chó đen."
  },
  {
    "idx": 2342,
    "start": "01:02:11,000",
    "end": "01:02:12,280",
    "start_sec": 3731.0,
    "end_sec": 3732.28,
    "zh": "关于黑狗的猜测",
    "vi": "Suy đoán về con chó đen."
  },
  {
    "idx": 2343,
    "start": "01:02:12,280",
    "end": "01:02:13,280",
    "start_sec": 3732.28,
    "end_sec": 3733.28,
    "zh": "已经得到证实",
    "vi": "Đã được chứng thực."
  },
  {
    "idx": 2344,
    "start": "01:02:13,280",
    "end": "01:02:14,520",
    "start_sec": 3733.28,
    "end_sec": 3734.52,
    "zh": "现在还是要验证",
    "vi": "Bây giờ vẫn cần kiểm chứng."
  },
  {
    "idx": 2345,
    "start": "01:02:14,520",
    "end": "01:02:16,000",
    "start_sec": 3734.52,
    "end_sec": 3736.0,
    "zh": "把击香炉是否有用",
    "vi": "Xem chiếc lư hương này có tác dụng gì không."
  },
  {
    "idx": 2346,
    "start": "01:02:16,000",
    "end": "01:02:17,020",
    "start_sec": 3736.0,
    "end_sec": 3737.02,
    "zh": "橙子皮想",
    "vi": "Trần Tử Bì nghĩ."
  },
  {
    "idx": 2347,
    "start": "01:02:17,020",
    "end": "01:02:18,560",
    "start_sec": 3737.02,
    "end_sec": 3738.56,
    "zh": "倒是可以把香炉",
    "vi": "Có thể đặt lư hương."
  },
  {
    "idx": 2348,
    "start": "01:02:18,560",
    "end": "01:02:19,440",
    "start_sec": 3738.56,
    "end_sec": 3739.44,
    "zh": "放到厨房门口",
    "vi": "Ở ngay cửa nhà bếp."
  },
  {
    "idx": 2349,
    "start": "01:02:19,440",
    "end": "01:02:20,600",
    "start_sec": 3739.44,
    "end_sec": 3740.6,
    "zh": "看看晚上敲门鬼",
    "vi": "Để xem tối nay khi quỷ gõ cửa."
  },
  {
    "idx": 2350,
    "start": "01:02:20,600",
    "end": "01:02:21,180",
    "start_sec": 3740.6,
    "end_sec": 3741.18,
    "zh": "刷新的时候",
    "vi": "Xuất hiện trở lại."
  },
  {
    "idx": 2351,
    "start": "01:02:21,180",
    "end": "01:02:22,900",
    "start_sec": 3741.18,
    "end_sec": 3742.9,
    "zh": "会不会避开",
    "vi": "Liệu có tránh đi không."
  },
  {
    "idx": 2352,
    "start": "01:02:22,900",
    "end": "01:02:24,920",
    "start_sec": 3742.9,
    "end_sec": 3744.92,
    "zh": "得麻烦你",
    "vi": "Phải làm phiền bạn."
  },
  {
    "idx": 2353,
    "start": "01:02:24,920",
    "end": "01:02:25,780",
    "start_sec": 3744.92,
    "end_sec": 3745.78,
    "zh": "买只黑狗",
    "vi": "Mua một con chó đen."
  },
  {
    "idx": 2354,
    "start": "01:02:25,780",
    "end": "01:02:26,840",
    "start_sec": 3745.78,
    "end_sec": 3746.84,
    "zh": "要纯黑的",
    "vi": "Phải là loại đen tuyền."
  },
  {
    "idx": 2355,
    "start": "01:02:26,840",
    "end": "01:02:27,960",
    "start_sec": 3746.84,
    "end_sec": 3747.96,
    "zh": "最好是精神自卫",
    "vi": "Tốt nhất là loại có tính cảnh giác cao."
  },
  {
    "idx": 2356,
    "start": "01:02:27,960",
    "end": "01:02:29,080",
    "start_sec": 3747.96,
    "end_sec": 3749.08,
    "zh": "比较残暴点的狗",
    "vi": "Và hung dữ một chút."
  },
  {
    "idx": 2357,
    "start": "01:02:29,080",
    "end": "01:02:29,760",
    "start_sec": 3749.08,
    "end_sec": 3749.76,
    "zh": "对了",
    "vi": "Đúng rồi."
  },
  {
    "idx": 2358,
    "start": "01:02:29,760",
    "end": "01:02:30,760",
    "start_sec": 3749.76,
    "end_sec": 3750.76,
    "zh": "如果可以的话",
    "vi": "Nếu được thì."
  },
  {
    "idx": 2359,
    "start": "01:02:30,760",
    "end": "01:02:31,800",
    "start_sec": 3750.76,
    "end_sec": 3751.8,
    "zh": "给猪羊也买一只",
    "vi": "Hãy mua cho Trư Dương một con luôn."
  },
  {
    "idx": 2360,
    "start": "01:02:31,800",
    "end": "01:02:33,120",
    "start_sec": 3751.8,
    "end_sec": 3753.12,
    "zh": "能不能从猪羊口中",
    "vi": "Liệu có thể lấy được thông tin."
  },
  {
    "idx": 2361,
    "start": "01:02:33,120",
    "end": "01:02:33,880",
    "start_sec": 3753.12,
    "end_sec": 3753.88,
    "zh": "抄取些情报",
    "vi": "Từ miệng của Trư Dương hay không."
  },
  {
    "idx": 2362,
    "start": "01:02:33,880",
    "end": "01:02:35,160",
    "start_sec": 3753.88,
    "end_sec": 3755.16,
    "zh": "可全看黑狗了",
    "vi": "Tất cả đều phải trông cậy vào con chó đen này."
  },
  {
    "idx": 2363,
    "start": "01:02:35,160",
    "end": "01:02:40,960",
    "start_sec": 3755.16,
    "end_sec": 3760.96,
    "zh": "罗倩从慌乱中回过神来",
    "vi": "La Thiến hoàn hồn lại sau cơn hoảng loạn."
  },
  {
    "idx": 2364,
    "start": "01:02:40,960",
    "end": "01:02:42,380",
    "start_sec": 3760.96,
    "end_sec": 3762.38,
    "zh": "若有所思的看着胡子",
    "vi": "Đăm chiêu nhìn Hồ Tử."
  },
  {
    "idx": 2365,
    "start": "01:02:42,380",
    "end": "01:02:43,300",
    "start_sec": 3762.38,
    "end_sec": 3763.3,
    "zh": "她不是傻的",
    "vi": "Cô ấy không hề ngốc."
  },
  {
    "idx": 2366,
    "start": "01:02:43,300",
    "end": "01:02:44,420",
    "start_sec": 3763.3,
    "end_sec": 3764.42,
    "zh": "自己能活到现代",
    "vi": "Việc bản thân có thể sống sót đến nay."
  },
  {
    "idx": 2367,
    "start": "01:02:44,420",
    "end": "01:02:46,000",
    "start_sec": 3764.42,
    "end_sec": 3766.0,
    "zh": "是有八九跟胡子有关",
    "vi": "Tám chín phần mười là có liên quan đến Hồ Tử."
  },
  {
    "idx": 2368,
    "start": "01:02:46,000",
    "end": "01:02:46,740",
    "start_sec": 3766.0,
    "end_sec": 3766.74,
    "zh": "胡子",
    "vi": "Hồ Tử."
  },
  {
    "idx": 2369,
    "start": "01:02:46,740",
    "end": "01:02:48,360",
    "start_sec": 3766.74,
    "end_sec": 3768.36,
    "zh": "你下楼自己去转一转",
    "vi": "Mày tự đi xuống lầu dạo một vòng đi."
  },
  {
    "idx": 2370,
    "start": "01:02:48,360",
    "end": "01:02:51,880",
    "start_sec": 3768.36,
    "end_sec": 3771.88,
    "zh": "胡子的出现",
    "vi": "Sự xuất hiện của Hồ Tử."
  },
  {
    "idx": 2371,
    "start": "01:02:51,880",
    "end": "01:02:53,760",
    "start_sec": 3771.88,
    "end_sec": 3773.76,
    "zh": "再次引起小区里一场高乱",
    "vi": "Lại gây ra một trận hỗn loạn lớn trong khu chung cư."
  },
  {
    "idx": 2372,
    "start": "01:02:53,760",
    "end": "01:02:55,880",
    "start_sec": 3773.76,
    "end_sec": 3775.88,
    "zh": "众人纷纷凝在过来黑狗的用处",
    "vi": "Mọi người đổ dồn ánh mắt vào tác dụng của con chó đen."
  },
  {
    "idx": 2373,
    "start": "01:02:55,880",
    "end": "01:02:57,460",
    "start_sec": 3775.88,
    "end_sec": 3777.46,
    "zh": "眼睛里闪烁着金光",
    "vi": "Ánh mắt họ lóe lên những tia sáng."
  },
  {
    "idx": 2374,
    "start": "01:02:57,460",
    "end": "01:03:00,100",
    "start_sec": 3777.46,
    "end_sec": 3780.1,
    "zh": "罗倩盯着胡子周围看了许久",
    "vi": "La Thiến nhìn chằm chằm xung quanh Hu Tử một lúc lâu."
  },
  {
    "idx": 2375,
    "start": "01:03:00,100",
    "end": "01:03:01,460",
    "start_sec": 3780.1,
    "end_sec": 3781.46,
    "zh": "越发确定女鬼怕",
    "vi": "Cô càng lúc càng chắc chắn rằng nữ quỷ sợ nó."
  },
  {
    "idx": 2376,
    "start": "01:03:01,460",
    "end": "01:03:03,400",
    "start_sec": 3781.46,
    "end_sec": 3783.4,
    "zh": "如此一来",
    "vi": "Như vậy thì."
  },
  {
    "idx": 2377,
    "start": "01:03:03,400",
    "end": "01:03:05,400",
    "start_sec": 3783.4,
    "end_sec": 3785.4,
    "zh": "便利店的食物不全都是我的",
    "vi": "Toàn bộ thức ăn trong cửa hàng tiện lợi sẽ là của tôi."
  },
  {
    "idx": 2378,
    "start": "01:03:05,400",
    "end": "01:03:06,680",
    "start_sec": 3785.4,
    "end_sec": 3786.68,
    "zh": "胡子",
    "vi": "Hu Tử."
  },
  {
    "idx": 2379,
    "start": "01:03:06,680",
    "end": "01:03:07,960",
    "start_sec": 3786.68,
    "end_sec": 3787.96,
    "zh": "走 去便利店",
    "vi": "Đi thôi, đến cửa hàng tiện lợi nào."
  },
  {
    "idx": 2380,
    "start": "01:03:07,960",
    "end": "01:03:09,140",
    "start_sec": 3787.96,
    "end_sec": 3789.14,
    "zh": "只要你保护妈妈",
    "vi": "Chỉ cần con bảo vệ mẹ."
  },
  {
    "idx": 2381,
    "start": "01:03:09,140",
    "end": "01:03:10,460",
    "start_sec": 3789.14,
    "end_sec": 3790.46,
    "zh": "咱们想吃什么吃什么",
    "vi": "Chúng ta muốn ăn gì thì ăn nấy."
  },
  {
    "idx": 2382,
    "start": "01:03:10,460",
    "end": "01:03:12,240",
    "start_sec": 3790.46,
    "end_sec": 3792.24,
    "zh": "罗倩壮着胆子走出小区",
    "vi": "La Thiến lấy hết can đảm bước ra khỏi khu chung cư."
  },
  {
    "idx": 2383,
    "start": "01:03:12,240",
    "end": "01:03:13,460",
    "start_sec": 3792.24,
    "end_sec": 3793.46,
    "zh": "起初走得很谨慎",
    "vi": "Ban đầu cô đi rất cẩn thận."
  },
  {
    "idx": 2384,
    "start": "01:03:13,460",
    "end": "01:03:15,260",
    "start_sec": 3793.46,
    "end_sec": 3795.26,
    "zh": "但绿化带力始终没有动静",
    "vi": "Nhưng trong vành đai cây xanh vẫn không có động tĩnh gì."
  },
  {
    "idx": 2385,
    "start": "01:03:15,260",
    "end": "01:03:16,560",
    "start_sec": 3795.26,
    "end_sec": 3796.56,
    "zh": "她的胆子也越来越大",
    "vi": "Gan của cô cũng ngày càng lớn hơn."
  },
  {
    "idx": 2386,
    "start": "01:03:16,560",
    "end": "01:03:17,980",
    "start_sec": 3796.56,
    "end_sec": 3797.98,
    "zh": "罗倩这一行为",
    "vi": "Hành động này của La Thiến."
  },
  {
    "idx": 2387,
    "start": "01:03:17,980",
    "end": "01:03:20,080",
    "start_sec": 3797.98,
    "end_sec": 3800.08,
    "zh": "也来小区上百年献神走一顿",
    "vi": "Cũng khiến mọi người trong khu chung cư vô cùng kinh ngạc."
  },
  {
    "idx": 2388,
    "start": "01:03:20,080",
    "end": "01:03:21,740",
    "start_sec": 3800.08,
    "end_sec": 3801.74,
    "zh": "我靠 真行啊",
    "vi": "Ôi trời, được thật đấy."
  },
  {
    "idx": 2389,
    "start": "01:03:21,740",
    "end": "01:03:23,180",
    "start_sec": 3801.74,
    "end_sec": 3803.18,
    "zh": "鬼真的怕黑狗啊",
    "vi": "Ma quỷ thực sự sợ chó đen kìa."
  },
  {
    "idx": 2390,
    "start": "01:03:23,180",
    "end": "01:03:24,760",
    "start_sec": 3803.18,
    "end_sec": 3804.76,
    "zh": "这女人有只黑狗",
    "vi": "Người phụ nữ này có một con chó đen."
  },
  {
    "idx": 2391,
    "start": "01:03:24,760",
    "end": "01:03:25,880",
    "start_sec": 3804.76,
    "end_sec": 3805.88,
    "zh": "无敌了",
    "vi": "Vô địch rồi."
  },
  {
    "idx": 2392,
    "start": "01:03:25,880",
    "end": "01:03:26,360",
    "start_sec": 3805.88,
    "end_sec": 3806.36,
    "zh": "好",
    "vi": "Tuyệt quá."
  },
  {
    "idx": 2393,
    "start": "01:03:26,360",
    "end": "01:03:28,700",
    "start_sec": 3806.36,
    "end_sec": 3808.7,
    "zh": "早知道应该养巧黑狗了",
    "vi": "Biết thế lúc trước nuôi một con chó đen rồi."
  },
  {
    "idx": 2394,
    "start": "01:03:28,700",
    "end": "01:03:29,900",
    "start_sec": 3808.7,
    "end_sec": 3809.9,
    "zh": "差奶奶的",
    "vi": "Mẹ kiếp."
  },
  {
    "idx": 2395,
    "start": "01:03:29,900",
    "end": "01:03:32,180",
    "start_sec": 3809.9,
    "end_sec": 3812.18,
    "zh": "这高娘子凭什么运气这么好啊",
    "vi": "Người đàn bà này sao lại có vận may tốt thế chứ."
  },
  {
    "idx": 2396,
    "start": "01:03:32,180",
    "end": "01:03:32,660",
    "start_sec": 3812.18,
    "end_sec": 3812.66,
    "zh": "哎",
    "vi": "Này."
  },
  {
    "idx": 2397,
    "start": "01:03:32,660",
    "end": "01:03:35,980",
    "start_sec": 3812.66,
    "end_sec": 3815.98,
    "zh": "老周",
    "vi": "Lão Chu."
  },
  {
    "idx": 2398,
    "start": "01:03:35,980",
    "end": "01:03:36,560",
    "start_sec": 3815.98,
    "end_sec": 3816.56,
    "zh": "老周",
    "vi": "Lão Chu."
  },
  {
    "idx": 2399,
    "start": "01:03:36,560",
    "end": "01:03:37,640",
    "start_sec": 3816.56,
    "end_sec": 3817.64,
    "zh": "我知道你在这",
    "vi": "Tôi biết ông ở trong này."
  },
  {
    "idx": 2400,
    "start": "01:03:37,640",
    "end": "01:03:38,640",
    "start_sec": 3817.64,
    "end_sec": 3818.64,
    "zh": "你开门啊",
    "vi": "Ông mở cửa đi."
  },
  {
    "idx": 2401,
    "start": "01:03:38,640",
    "end": "01:03:39,560",
    "start_sec": 3818.64,
    "end_sec": 3819.56,
    "zh": "你别怕呀",
    "vi": "Bạn đừng sợ."
  },
  {
    "idx": 2402,
    "start": "01:03:39,560",
    "end": "01:03:40,100",
    "start_sec": 3819.56,
    "end_sec": 3820.1,
    "zh": "我有狗",
    "vi": "Tôi có chó."
  },
  {
    "idx": 2403,
    "start": "01:03:40,100",
    "end": "01:03:40,880",
    "start_sec": 3820.1,
    "end_sec": 3820.88,
    "zh": "天气坏了",
    "vi": "Thời tiết xấu quá."
  },
  {
    "idx": 2404,
    "start": "01:03:40,880",
    "end": "01:03:41,800",
    "start_sec": 3820.88,
    "end_sec": 3821.8,
    "zh": "我不敢过来的",
    "vi": "Tôi không dám qua đó."
  },
  {
    "idx": 2405,
    "start": "01:03:41,800",
    "end": "01:03:42,1000",
    "start_sec": 3821.8,
    "end_sec": 3823.0,
    "zh": "罗线拍打着门",
    "vi": "La Thiến đập cửa."
  },
  {
    "idx": 2406,
    "start": "01:03:42,1000",
    "end": "01:03:43,920",
    "start_sec": 3823.0,
    "end_sec": 3823.92,
    "zh": "隐约能听到",
    "vi": "隐约能听到"
  },
  {
    "idx": 2407,
    "start": "01:03:43,920",
    "end": "01:03:45,120",
    "start_sec": 3823.92,
    "end_sec": 3825.12,
    "zh": "门后传来脚步声",
    "vi": "Tiếng bước chân sau cánh cửa."
  },
  {
    "idx": 2408,
    "start": "01:03:45,120",
    "end": "01:03:46,320",
    "start_sec": 3825.12,
    "end_sec": 3826.32,
    "zh": "但门还是没打开",
    "vi": "Nhưng cửa vẫn không mở."
  },
  {
    "idx": 2409,
    "start": "01:03:46,320",
    "end": "01:03:47,780",
    "start_sec": 3826.32,
    "end_sec": 3827.78,
    "zh": "老周",
    "vi": "Lão Chu."
  },
  {
    "idx": 2410,
    "start": "01:03:47,780",
    "end": "01:03:49,500",
    "start_sec": 3827.78,
    "end_sec": 3829.5,
    "zh": "你这个狗子的家伙",
    "vi": "Đồ khốn kiếp nhà ông."
  },
  {
    "idx": 2411,
    "start": "01:03:49,500",
    "end": "01:03:50,760",
    "start_sec": 3829.5,
    "end_sec": 3830.76,
    "zh": "罗线系的牙费养娘",
    "vi": "La Thiến nghiến răng tức giận."
  },
  {
    "idx": 2412,
    "start": "01:03:50,760",
    "end": "01:03:52,360",
    "start_sec": 3830.76,
    "end_sec": 3832.36,
    "zh": "刚被橙子皮堵在门外",
    "vi": "Vừa bị Trần Tử Bì chặn ngoài cửa."
  },
  {
    "idx": 2413,
    "start": "01:03:52,360",
    "end": "01:03:54,260",
    "start_sec": 3832.36,
    "end_sec": 3834.26,
    "zh": "现在连电力店的门也进不去",
    "vi": "Giờ đến cửa tiệm điện cũng không vào được."
  },
  {
    "idx": 2414,
    "start": "01:03:54,260",
    "end": "01:03:55,800",
    "start_sec": 3834.26,
    "end_sec": 3835.8,
    "zh": "明明还有无敌的黑狗",
    "vi": "Rõ ràng là có con chó đen vô địch."
  },
  {
    "idx": 2415,
    "start": "01:03:55,800",
    "end": "01:03:56,880",
    "start_sec": 3835.8,
    "end_sec": 3836.88,
    "zh": "连鬼一都不怕",
    "vi": "Đến ma quỷ còn chẳng sợ."
  },
  {
    "idx": 2416,
    "start": "01:03:56,880",
    "end": "01:03:58,240",
    "start_sec": 3836.88,
    "end_sec": 3838.24,
    "zh": "哦 罗小姐",
    "vi": "Ồ cô La."
  },
  {
    "idx": 2417,
    "start": "01:03:58,240",
    "end": "01:03:59,340",
    "start_sec": 3838.24,
    "end_sec": 3839.34,
    "zh": "如果可以的话",
    "vi": "Nếu được thì."
  },
  {
    "idx": 2418,
    "start": "01:03:59,340",
    "end": "01:04:00,720",
    "start_sec": 3839.34,
    "end_sec": 3840.72,
    "zh": "麻烦你保护我一下",
    "vi": "Phiền cô bảo vệ tôi một chút."
  },
  {
    "idx": 2419,
    "start": "01:04:00,720",
    "end": "01:04:01,680",
    "start_sec": 3840.72,
    "end_sec": 3841.68,
    "zh": "我可以开门",
    "vi": "Tôi có thể mở cửa."
  },
  {
    "idx": 2420,
    "start": "01:04:01,680",
    "end": "01:04:03,460",
    "start_sec": 3841.68,
    "end_sec": 3843.46,
    "zh": "我只要一点吃的就行",
    "vi": "Tôi chỉ cần chút đồ ăn là được."
  },
  {
    "idx": 2421,
    "start": "01:04:03,460",
    "end": "01:04:04,840",
    "start_sec": 3843.46,
    "end_sec": 3844.84,
    "zh": "罗倩寻声看过去",
    "vi": "La Thiến nhìn theo hướng phát ra tiếng."
  },
  {
    "idx": 2422,
    "start": "01:04:04,840",
    "end": "01:04:05,520",
    "start_sec": 3844.84,
    "end_sec": 3845.52,
    "zh": "脸色一新",
    "vi": "Sắc mặt cô thay đổi."
  },
  {
    "idx": 2423,
    "start": "01:04:05,520",
    "end": "01:04:08,020",
    "start_sec": 3845.52,
    "end_sec": 3848.02,
    "zh": "这个光头是小区的维修工赵德柱",
    "vi": "Gã đầu trọc này là Triệu Đức Trụ thợ sửa chữa của khu chung cư."
  },
  {
    "idx": 2424,
    "start": "01:04:08,020",
    "end": "01:04:09,140",
    "start_sec": 3848.02,
    "end_sec": 3849.14,
    "zh": "罗倩找过他几次",
    "vi": "La Thiến từng tìm ông ta vài lần."
  },
  {
    "idx": 2425,
    "start": "01:04:09,140",
    "end": "01:04:10,080",
    "start_sec": 3849.14,
    "end_sec": 3850.08,
    "zh": "赵师傅",
    "vi": "Sư phụ Triệu."
  },
  {
    "idx": 2426,
    "start": "01:04:10,080",
    "end": "01:04:11,520",
    "start_sec": 3850.08,
    "end_sec": 3851.52,
    "zh": "你真的能开防盗门",
    "vi": "Ông thực sự mở được cửa chống trộm sao."
  },
  {
    "idx": 2427,
    "start": "01:04:11,520",
    "end": "01:04:13,040",
    "start_sec": 3851.52,
    "end_sec": 3853.04,
    "zh": "别说防盗门",
    "vi": "Đừng nói là cửa chống trộm."
  },
  {
    "idx": 2428,
    "start": "01:04:13,040",
    "end": "01:04:14,480",
    "start_sec": 3853.04,
    "end_sec": 3854.48,
    "zh": "防弹的我都能开",
    "vi": "Cửa chống đạn tôi cũng mở được."
  },
  {
    "idx": 2429,
    "start": "01:04:14,480",
    "end": "01:04:15,280",
    "start_sec": 3854.48,
    "end_sec": 3855.28,
    "zh": "那好",
    "vi": "Vậy tốt quá."
  },
  {
    "idx": 2430,
    "start": "01:04:15,280",
    "end": "01:04:16,480",
    "start_sec": 3855.28,
    "end_sec": 3856.48,
    "zh": "你在家门口等我",
    "vi": "Ông đợi tôi ở cửa nhà đi."
  },
  {
    "idx": 2431,
    "start": "01:04:16,480",
    "end": "01:04:17,260",
    "start_sec": 3856.48,
    "end_sec": 3857.26,
    "zh": "我去接你",
    "vi": "Tôi đi đón ông."
  },
  {
    "idx": 2432,
    "start": "01:04:17,260",
    "end": "01:04:18,600",
    "start_sec": 3857.26,
    "end_sec": 3858.6,
    "zh": "见面的第一时间",
    "vi": "Ngay khi vừa gặp mặt."
  },
  {
    "idx": 2433,
    "start": "01:04:18,600",
    "end": "01:04:20,780",
    "start_sec": 3858.6,
    "end_sec": 3860.78,
    "zh": "赵德柱两眼放光的盯着胡子",
    "vi": "Triệu Đức Trụ nhìn chằm chằm vào Râu Quai Nón với ánh mắt sáng rực."
  },
  {
    "idx": 2434,
    "start": "01:04:20,780",
    "end": "01:04:24,703",
    "start_sec": 3860.78,
    "end_sec": 3864.703,
    "zh": "他其实想要把胡子占回起来,但这包子凶狠的模样又牛眼,要是与狗搏斗过程中,把狗敲死就得不偿失了。",
    "vi": "Ông ta thực sự muốn chiếm đoạt Râu Quai Nón, nhưng vẻ hung dữ của con chó này rất"
  },
  {
    "idx": 2434,
    "start": "01:04:24,703",
    "end": "01:04:28,420",
    "start_sec": 3864.703,
    "end_sec": 3868.42,
    "zh": "他其实想要把胡子占回起来,但这包子凶狠的模样又牛眼,要是与狗搏斗过程中,把狗敲死就得不偿失了。",
    "vi": "đáng sợ, nếu trong lúc đánh nhau mà lỡ tay đánh chết nó thì lợi bất cập hại."
  },
  {
    "idx": 2435,
    "start": "01:04:28,720",
    "end": "01:04:31,728",
    "start_sec": 3868.72,
    "end_sec": 3871.728,
    "zh": "罗小姐,我帮你我只拿我一家无口的口粮,你放心,门打开后我不多拿的。",
    "vi": "Cô La, tôi giúp cô và chỉ lấy phần lương thực cho năm người nhà tôi"
  },
  {
    "idx": 2435,
    "start": "01:04:31,728",
    "end": "01:04:34,360",
    "start_sec": 3871.728,
    "end_sec": 3874.36,
    "zh": "罗小姐,我帮你我只拿我一家无口的口粮,你放心,门打开后我不多拿的。",
    "vi": "thôi, cô yên tâm, sau khi mở cửa tôi sẽ không lấy nhiều đâu."
  },
  {
    "idx": 2436,
    "start": "01:04:35,600",
    "end": "01:04:39,257",
    "start_sec": 3875.6,
    "end_sec": 3879.257,
    "zh": "因为不确定,黑狗能不能避负两人,所以赵德主和罗剑很谨慎地吃了一剑,最终有幸无险地来到便利店中。",
    "vi": "Vì không chắc con chó đen có thể bảo vệ được cả hai người hay không, nên Triệu Đức Trụ và"
  },
  {
    "idx": 2436,
    "start": "01:04:39,257",
    "end": "01:04:42,740",
    "start_sec": 3879.257,
    "end_sec": 3882.74,
    "zh": "因为不确定,黑狗能不能避负两人,所以赵德主和罗剑很谨慎地吃了一剑,最终有幸无险地来到便利店中。",
    "vi": "La Thiến đi đứng rất cẩn thận, cuối cùng cũng đến được cửa hàng tiện lợi một cách an toàn."
  },
  {
    "idx": 2437,
    "start": "01:04:44,960",
    "end": "01:04:47,732",
    "start_sec": 3884.96,
    "end_sec": 3887.732,
    "zh": "美女,美女,我抬钱到黑带给你当保镖,帮你收拾不听话的家伙,你带我过去呗。",
    "vi": "Người đẹp ơi, tôi là đai đen Taekwondo sẽ làm vệ sĩ cho cô, giúp"
  },
  {
    "idx": 2437,
    "start": "01:04:47,732",
    "end": "01:04:50,320",
    "start_sec": 3887.732,
    "end_sec": 3890.32,
    "zh": "美女,美女,我抬钱到黑带给你当保镖,帮你收拾不听话的家伙,你带我过去呗。",
    "vi": "cô xử lý những kẻ không nghe lời, cô cho tôi đi cùng với."
  },
  {
    "idx": 2438,
    "start": "01:04:50,780",
    "end": "01:04:54,300",
    "start_sec": 3890.78,
    "end_sec": 3894.3,
    "zh": "姐姐,你看看我啊,我活好,代代我好。",
    "vi": "Chị ơi, chị nhìn em đi, em làm việc tốt lắm, cho em đi theo với."
  },
  {
    "idx": 2439,
    "start": "01:04:54,560",
    "end": "01:04:58,960",
    "start_sec": 3894.56,
    "end_sec": 3898.96,
    "zh": "一时间,因为胡子的庇护,小区里工围的喊话一波接着一波,罗宪有些飘飘然,他没想到有朝一日自己还能成为别人依附的对象。胡子,我可真是没白养你呀,真是妈妈的好大。",
    "vi": "Trong phút chốc, nhờ sự bảo vệ của Râu Quai Nón, những tiếng gọi từ xung quanh khu chung cư vang lên hết đợt"
  },
  {
    "idx": 2439,
    "start": "01:04:58,960",
    "end": "01:05:03,543",
    "start_sec": 3898.96,
    "end_sec": 3903.543,
    "zh": "一时间,因为胡子的庇护,小区里工围的喊话一波接着一波,罗宪有些飘飘然,他没想到有朝一日自己还能成为别人依附的对象。胡子,我可真是没白养你呀,真是妈妈的好大。",
    "vi": "này đến đợt khác, La Thiến cảm thấy hơi lâng lâng, cô không ngờ có ngày mình lại trở thành chỗ dựa cho người khác"
  },
  {
    "idx": 2439,
    "start": "01:05:03,543",
    "end": "01:05:07,026",
    "start_sec": 3903.543,
    "end_sec": 3907.026,
    "zh": "一时间,因为胡子的庇护,小区里工围的喊话一波接着一波,罗宪有些飘飘然,他没想到有朝一日自己还能成为别人依附的对象。胡子,我可真是没白养你呀,真是妈妈的好大。",
    "vi": "Râu Quai Nón ơi, mẹ quả thực không nuôi công con mà, đúng là con trai ngoan của mẹ"
  },
  {
    "idx": 2440,
    "start": "01:05:07,806",
    "end": "01:05:09,686",
    "start_sec": 3907.806,
    "end_sec": 3909.686,
    "zh": "教师傅,我们再接两个人。",
    "vi": "Bác thợ khóa ơi, chúng ta đón thêm hai người nữa đi."
  },
  {
    "idx": 2441,
    "start": "01:05:09,966",
    "end": "01:05:13,686",
    "start_sec": 3909.966,
    "end_sec": 3913.686,
    "zh": "也对,罗小姐,你现在的情况确实需要几个帮手。",
    "vi": "Cũng đúng, cô La à, tình hình của cô bây giờ quả thực cần vài người giúp việc."
  },
  {
    "idx": 2442,
    "start": "01:05:14,686",
    "end": "01:05:17,606",
    "start_sec": 3914.686,
    "end_sec": 3917.606,
    "zh": "听那个跆拳道黑带,还有那个小白脸吧。",
    "vi": "Đón cậu đai đen Taekwondo và cậu mặt trắng kia đi."
  },
  {
    "idx": 2443,
    "start": "01:05:18,066",
    "end": "01:05:21,074",
    "start_sec": 3918.066,
    "end_sec": 3921.074,
    "zh": "跆拳道黑带的叫李志勇,小白脸是个主播,罗宪有缘见过几年,一直基于他的颜值,",
    "vi": "Cậu đai đen Taekwondo tên là Lý Chí Dũng, còn cậu mặt trắng là một streamer,"
  },
  {
    "idx": 2443,
    "start": "01:05:21,074",
    "end": "01:05:23,706",
    "start_sec": 3921.074,
    "end_sec": 3923.706,
    "zh": "跆拳道黑带的叫李志勇,小白脸是个主播,罗宪有缘见过几年,一直基于他的颜值,",
    "vi": "La Thiến từng gặp vài lần và luôn thích vẻ ngoài của cậu ta."
  },
  {
    "idx": 2444,
    "start": "01:05:23,706",
    "end": "01:05:25,306",
    "start_sec": 3923.706,
    "end_sec": 3925.306,
    "zh": "奈何自己配不上人家",
    "vi": "Nhưng ngặt nỗi bản thân không xứng với người ta."
  },
  {
    "idx": 2445,
    "start": "01:05:25,306",
    "end": "01:05:26,746",
    "start_sec": 3925.306,
    "end_sec": 3926.746,
    "zh": "更别说相互接触",
    "vi": "Chứ đừng nói đến việc tiếp xúc với nhau."
  },
  {
    "idx": 2446,
    "start": "01:05:26,746",
    "end": "01:05:27,826",
    "start_sec": 3926.746,
    "end_sec": 3927.826,
    "zh": "但现在不一样了",
    "vi": "Nhưng bây giờ thì khác rồi."
  },
  {
    "idx": 2447,
    "start": "01:05:27,826",
    "end": "01:05:28,406",
    "start_sec": 3927.826,
    "end_sec": 3928.406,
    "zh": "因为胡子",
    "vi": "Nhờ có Râu Quai Nón."
  },
  {
    "idx": 2448,
    "start": "01:05:28,406",
    "end": "01:05:30,266",
    "start_sec": 3928.406,
    "end_sec": 3930.266,
    "zh": "他现在被人像是胡大爷一样",
    "vi": "Bây giờ cô được người ta cung phụng như bà hoàng."
  },
  {
    "idx": 2449,
    "start": "01:05:30,266",
    "end": "01:05:32,266",
    "start_sec": 3930.266,
    "end_sec": 3932.266,
    "zh": "我美女你放心",
    "vi": "Người đẹp cứ yên tâm đi."
  },
  {
    "idx": 2450,
    "start": "01:05:32,266",
    "end": "01:05:34,186",
    "start_sec": 3932.266,
    "end_sec": 3934.186,
    "zh": "以后谁敢对你动手动脚",
    "vi": "Sau này kẻ nào dám động tay động chân với cô."
  },
  {
    "idx": 2451,
    "start": "01:05:34,186",
    "end": "01:05:35,866",
    "start_sec": 3934.186,
    "end_sec": 3935.866,
    "zh": "我李志勇第一个不答应",
    "vi": "Lý Chí Dũng tôi sẽ là người đầu tiên không đồng ý."
  },
  {
    "idx": 2452,
    "start": "01:05:35,866",
    "end": "01:05:36,886",
    "start_sec": 3935.866,
    "end_sec": 3936.886,
    "zh": "罗倩姐姐",
    "vi": "Chị La Thiến ơi."
  },
  {
    "idx": 2453,
    "start": "01:05:36,886",
    "end": "01:05:38,026",
    "start_sec": 3936.886,
    "end_sec": 3938.026,
    "zh": "我也会帮你的",
    "vi": "Em cũng sẽ giúp chị mà."
  },
  {
    "idx": 2454,
    "start": "01:05:38,026",
    "end": "01:05:39,606",
    "start_sec": 3938.026,
    "end_sec": 3939.606,
    "zh": "这时便利店的门",
    "vi": "Lúc này, cửa của cửa hàng tiện lợi."
  },
  {
    "idx": 2455,
    "start": "01:05:39,606",
    "end": "01:05:40,786",
    "start_sec": 3939.606,
    "end_sec": 3940.786,
    "zh": "终于被赵哥主笑",
    "vi": "Cuối cùng cũng được Triệu Đức Trụ mở ra."
  },
  {
    "idx": 2456,
    "start": "01:05:40,786",
    "end": "01:05:41,586",
    "start_sec": 3940.786,
    "end_sec": 3941.586,
    "zh": "毕竟以后",
    "vi": "Dù sao thì sau này."
  },
  {
    "idx": 2457,
    "start": "01:05:41,586",
    "end": "01:05:42,946",
    "start_sec": 3941.586,
    "end_sec": 3942.946,
    "zh": "接手便利店的主人",
    "vi": "Người tiếp quản cửa hàng tiện lợi này."
  },
  {
    "idx": 2458,
    "start": "01:05:42,946",
    "end": "01:05:44,026",
    "start_sec": 3942.946,
    "end_sec": 3944.026,
    "zh": "说不定就是他了",
    "vi": "Biết đâu lại chính là ông ta."
  },
  {
    "idx": 2459,
    "start": "01:05:44,026",
    "end": "01:05:45,066",
    "start_sec": 3944.026,
    "end_sec": 3945.066,
    "zh": "总不能强行砸",
    "vi": "Nên không thể đập phá bừa bãi được."
  },
  {
    "idx": 2460,
    "start": "01:05:45,066",
    "end": "01:05:45,886",
    "start_sec": 3945.066,
    "end_sec": 3945.886,
    "zh": "走",
    "vi": "Đi thôi."
  },
  {
    "idx": 2461,
    "start": "01:05:45,886",
    "end": "01:05:47,086",
    "start_sec": 3945.886,
    "end_sec": 3947.086,
    "zh": "现在先去吃饱",
    "vi": "Bây giờ đi ăn cho no bụng đã"
  },
  {
    "idx": 2462,
    "start": "01:05:47,086",
    "end": "01:05:48,286",
    "start_sec": 3947.086,
    "end_sec": 3948.286,
    "zh": "罗倩大手一挥",
    "vi": "La Thiến vung tay một cái"
  },
  {
    "idx": 2463,
    "start": "01:05:48,286",
    "end": "01:05:50,106",
    "start_sec": 3948.286,
    "end_sec": 3950.106,
    "zh": "急着浩浩荡荡冲进便利店",
    "vi": "Vội vàng hùng hổ xông vào cửa hàng tiện lợi"
  },
  {
    "idx": 2464,
    "start": "01:05:53,706",
    "end": "01:06:00,946",
    "start_sec": 3953.706,
    "end_sec": 3960.946,
    "zh": "你们怎么过来了",
    "vi": "Sao các người lại tới đây"
  },
  {
    "idx": 2465,
    "start": "01:06:00,946",
    "end": "01:06:02,066",
    "start_sec": 3960.946,
    "end_sec": 3962.066,
    "zh": "周建",
    "vi": "Chu Kiến"
  },
  {
    "idx": 2466,
    "start": "01:06:02,066",
    "end": "01:06:03,566",
    "start_sec": 3962.066,
    "end_sec": 3963.566,
    "zh": "归你他妈说的出口",
    "vi": "Mẹ kiếp, câu đó mà mày cũng nói ra được à"
  },
  {
    "idx": 2467,
    "start": "01:06:03,566",
    "end": "01:06:06,466",
    "start_sec": 3963.566,
    "end_sec": 3966.466,
    "zh": "你他妈有病吧",
    "vi": "Mày bị điên à"
  },
  {
    "idx": 2468,
    "start": "01:06:06,466",
    "end": "01:06:07,206",
    "start_sec": 3966.466,
    "end_sec": 3967.206,
    "zh": "把我干什么",
    "vi": "Cản tao làm gì"
  },
  {
    "idx": 2469,
    "start": "01:06:07,206",
    "end": "01:06:08,066",
    "start_sec": 3967.206,
    "end_sec": 3968.066,
    "zh": "我有病",
    "vi": "Tao bị điên"
  },
  {
    "idx": 2470,
    "start": "01:06:08,066",
    "end": "01:06:09,306",
    "start_sec": 3968.066,
    "end_sec": 3969.306,
    "zh": "有病的是你吧",
    "vi": "Người bị điên là mày mới đúng"
  },
  {
    "idx": 2471,
    "start": "01:06:09,306",
    "end": "01:06:10,066",
    "start_sec": 3969.306,
    "end_sec": 3970.066,
    "zh": "我问你",
    "vi": "Tao hỏi mày"
  },
  {
    "idx": 2472,
    "start": "01:06:10,066",
    "end": "01:06:11,586",
    "start_sec": 3970.066,
    "end_sec": 3971.586,
    "zh": "那天保安来敲你的门",
    "vi": "Hôm đó bảo vệ đến gõ cửa phòng mày"
  },
  {
    "idx": 2473,
    "start": "01:06:11,586",
    "end": "01:06:12,666",
    "start_sec": 3971.586,
    "end_sec": 3972.666,
    "zh": "你为什么不开门",
    "vi": "Sao mày không mở cửa"
  },
  {
    "idx": 2474,
    "start": "01:06:12,666",
    "end": "01:06:14,046",
    "start_sec": 3972.666,
    "end_sec": 3974.046,
    "zh": "我为什么要开门",
    "vi": "Tại sao tao phải mở cửa"
  },
  {
    "idx": 2475,
    "start": "01:06:14,046",
    "end": "01:06:15,286",
    "start_sec": 3974.046,
    "end_sec": 3975.286,
    "zh": "电力店是我开的",
    "vi": "Cửa hàng tiện lợi này là tao mở"
  },
  {
    "idx": 2476,
    "start": "01:06:15,286",
    "end": "01:06:15,986",
    "start_sec": 3975.286,
    "end_sec": 3975.986,
    "zh": "开不开门",
    "vi": "Mở cửa hay không"
  },
  {
    "idx": 2477,
    "start": "01:06:15,986",
    "end": "01:06:16,826",
    "start_sec": 3975.986,
    "end_sec": 3976.826,
    "zh": "这是我的自由",
    "vi": "Đó là tự do của tao"
  },
  {
    "idx": 2478,
    "start": "01:06:16,826",
    "end": "01:06:18,886",
    "start_sec": 3976.826,
    "end_sec": 3978.886,
    "zh": "所以刚刚罗小姐敲门",
    "vi": "Cho nên vừa rồi cô La gõ cửa"
  },
  {
    "idx": 2479,
    "start": "01:06:18,886",
    "end": "01:06:20,326",
    "start_sec": 3978.886,
    "end_sec": 3980.326,
    "zh": "你也是不想开门的",
    "vi": "Mày cũng không muốn mở cửa"
  },
  {
    "idx": 2480,
    "start": "01:06:20,326",
    "end": "01:06:20,846",
    "start_sec": 3980.326,
    "end_sec": 3980.846,
    "zh": "对吧",
    "vi": "Đúng không"
  },
  {
    "idx": 2481,
    "start": "01:06:20,846",
    "end": "01:06:22,466",
    "start_sec": 3980.846,
    "end_sec": 3982.466,
    "zh": "我刚刚在睡觉",
    "vi": "Tao vừa mới ngủ"
  },
  {
    "idx": 2482,
    "start": "01:06:22,466",
    "end": "01:06:28,666",
    "start_sec": 3982.466,
    "end_sec": 3988.666,
    "zh": "你是怕我过来",
    "vi": "Mày sợ tao tới"
  },
  {
    "idx": 2483,
    "start": "01:06:28,666",
    "end": "01:06:29,966",
    "start_sec": 3988.666,
    "end_sec": 3989.966,
    "zh": "光分了你的食物吧",
    "vi": "Chia bớt thức ăn của mày đúng không"
  },
  {
    "idx": 2484,
    "start": "01:06:29,966",
    "end": "01:06:30,566",
    "start_sec": 3989.966,
    "end_sec": 3990.566,
    "zh": "那好",
    "vi": "Được thôi"
  },
  {
    "idx": 2485,
    "start": "01:06:30,566",
    "end": "01:06:31,586",
    "start_sec": 3990.566,
    "end_sec": 3991.586,
    "zh": "我现在就拿了",
    "vi": "Bây giờ tao lấy đây"
  },
  {
    "idx": 2486,
    "start": "01:06:31,586",
    "end": "01:06:32,266",
    "start_sec": 3991.586,
    "end_sec": 3992.266,
    "zh": "你们怎样",
    "vi": "Các người định làm gì"
  },
  {
    "idx": 2487,
    "start": "01:06:32,266",
    "end": "01:06:33,926",
    "start_sec": 3992.266,
    "end_sec": 3993.926,
    "zh": "我不仅要拿",
    "vi": "Tao không chỉ lấy"
  },
  {
    "idx": 2488,
    "start": "01:06:33,926",
    "end": "01:06:34,986",
    "start_sec": 3993.926,
    "end_sec": 3994.986,
    "zh": "我还全部都要",
    "vi": "Mà tao còn lấy hết sạch"
  },
  {
    "idx": 2489,
    "start": "01:06:34,986",
    "end": "01:06:36,466",
    "start_sec": 3994.986,
    "end_sec": 3996.466,
    "zh": "你们几个要什么",
    "vi": "Mấy người muốn lấy gì"
  },
  {
    "idx": 2490,
    "start": "01:06:36,466",
    "end": "01:06:37,426",
    "start_sec": 3996.466,
    "end_sec": 3997.426,
    "zh": "赶紧自己搬",
    "vi": "Mau tự tay dọn đi"
  },
  {
    "idx": 2491,
    "start": "01:06:37,426",
    "end": "01:06:38,026",
    "start_sec": 3997.426,
    "end_sec": 3998.026,
    "zh": "你们",
    "vi": "Các người"
  },
  {
    "idx": 2492,
    "start": "01:06:38,026",
    "end": "01:06:38,486",
    "start_sec": 3998.026,
    "end_sec": 3998.486,
    "zh": "你们",
    "vi": "Các người"
  },
  {
    "idx": 2493,
    "start": "01:06:38,486",
    "end": "01:06:40,146",
    "start_sec": 3998.486,
    "end_sec": 4000.146,
    "zh": "不准抢",
    "vi": "Đừng có cướp"
  },
  {
    "idx": 2494,
    "start": "01:06:40,146",
    "end": "01:06:41,886",
    "start_sec": 4000.146,
    "end_sec": 4001.886,
    "zh": "鬼一边去",
    "vi": "của tôi"
  },
  {
    "idx": 2495,
    "start": "01:06:41,886",
    "end": "01:06:43,186",
    "start_sec": 4001.886,
    "end_sec": 4003.186,
    "zh": "我们想吃啥就吃啥",
    "vi": "Chúng tôi muốn ăn gì thì ăn nấy"
  },
  {
    "idx": 2496,
    "start": "01:06:43,186",
    "end": "01:06:44,366",
    "start_sec": 4003.186,
    "end_sec": 4004.366,
    "zh": "我说",
    "vi": "Tôi nói này"
  },
  {
    "idx": 2497,
    "start": "01:06:44,366",
    "end": "01:06:46,506",
    "start_sec": 4004.366,
    "end_sec": 4006.506,
    "zh": "你是不是没搞清楚情况啊",
    "vi": "Cậu có vẻ chưa hiểu tình hình nhỉ"
  },
  {
    "idx": 2498,
    "start": "01:06:46,506",
    "end": "01:06:47,666",
    "start_sec": 4006.506,
    "end_sec": 4007.666,
    "zh": "现在是我们在这里",
    "vi": "Bây giờ là chúng tôi ở đây"
  },
  {
    "idx": 2499,
    "start": "01:06:47,666",
    "end": "01:06:48,586",
    "start_sec": 4007.666,
    "end_sec": 4008.586,
    "zh": "单独我们走了",
    "vi": "một mình chúng tôi đi rồi"
  },
  {
    "idx": 2500,
    "start": "01:06:48,586",
    "end": "01:06:49,546",
    "start_sec": 4008.586,
    "end_sec": 4009.546,
    "zh": "你想想看",
    "vi": "Cậu thử nghĩ xem"
  },
  {
    "idx": 2501,
    "start": "01:06:49,546",
    "end": "01:06:50,526",
    "start_sec": 4009.546,
    "end_sec": 4010.526,
    "zh": "那个红衣女鬼",
    "vi": "Cái con ma nữ áo đỏ kia"
  },
  {
    "idx": 2502,
    "start": "01:06:50,526",
    "end": "01:06:51,706",
    "start_sec": 4010.526,
    "end_sec": 4011.706,
    "zh": "会不会来找你呢",
    "vi": "có đến tìm cậu không"
  },
  {
    "idx": 2503,
    "start": "01:06:51,706",
    "end": "01:06:55,686",
    "start_sec": 4011.706,
    "end_sec": 4015.686,
    "zh": "罗小姐",
    "vi": "Cô La"
  },
  {
    "idx": 2504,
    "start": "01:06:55,686",
    "end": "01:06:56,466",
    "start_sec": 4015.686,
    "end_sec": 4016.466,
    "zh": "我错了",
    "vi": "Tôi sai rồi"
  },
  {
    "idx": 2505,
    "start": "01:06:56,466",
    "end": "01:06:57,286",
    "start_sec": 4016.466,
    "end_sec": 4017.286,
    "zh": "我求求你",
    "vi": "Tôi cầu xin cô"
  },
  {
    "idx": 2506,
    "start": "01:06:57,286",
    "end": "01:06:58,226",
    "start_sec": 4017.286,
    "end_sec": 4018.226,
    "zh": "要不住我这吧",
    "vi": "Hay là cô ở chỗ tôi đi"
  },
  {
    "idx": 2507,
    "start": "01:06:58,226",
    "end": "01:06:59,206",
    "start_sec": 4018.226,
    "end_sec": 4019.206,
    "zh": "我这什么都有",
    "vi": "Chỗ tôi có đủ mọi thứ"
  },
  {
    "idx": 2508,
    "start": "01:06:59,206",
    "end": "01:07:00,506",
    "start_sec": 4019.206,
    "end_sec": 4020.506,
    "zh": "赵德柱",
    "vi": "Triệu Đức Trụ"
  },
  {
    "idx": 2509,
    "start": "01:07:00,506",
    "end": "01:07:01,126",
    "start_sec": 4020.506,
    "end_sec": 4021.126,
    "zh": "赵哥",
    "vi": "Anh Triệu"
  },
  {
    "idx": 2510,
    "start": "01:07:01,126",
    "end": "01:07:02,386",
    "start_sec": 4021.126,
    "end_sec": 4022.386,
    "zh": "你把门锁修好吧",
    "vi": "Anh sửa cái khóa cửa đi"
  },
  {
    "idx": 2511,
    "start": "01:07:02,386",
    "end": "01:07:03,566",
    "start_sec": 4022.386,
    "end_sec": 4023.566,
    "zh": "我求你了",
    "vi": "Tôi cầu xin anh"
  },
  {
    "idx": 2512,
    "start": "01:07:03,566",
    "end": "01:07:04,606",
    "start_sec": 4023.566,
    "end_sec": 4024.606,
    "zh": "我住这",
    "vi": "Tôi ở đây"
  },
  {
    "idx": 2513,
    "start": "01:07:04,606",
    "end": "01:07:05,386",
    "start_sec": 4024.606,
    "end_sec": 4025.386,
    "zh": "那你觉得",
    "vi": "Vậy cô nghĩ"
  },
  {
    "idx": 2514,
    "start": "01:07:05,386",
    "end": "01:07:07,026",
    "start_sec": 4025.386,
    "end_sec": 4027.026,
    "zh": "谁才是便利店主人",
    "vi": "Ai mới là chủ tiệm tiện lợi"
  },
  {
    "idx": 2515,
    "start": "01:07:07,026",
    "end": "01:07:07,646",
    "start_sec": 4027.026,
    "end_sec": 4027.646,
    "zh": "你是",
    "vi": "Là cô"
  },
  {
    "idx": 2516,
    "start": "01:07:07,646",
    "end": "01:07:08,886",
    "start_sec": 4027.646,
    "end_sec": 4028.886,
    "zh": "你是主人",
    "vi": "Cô là chủ"
  },
  {
    "idx": 2517,
    "start": "01:07:08,886",
    "end": "01:07:09,206",
    "start_sec": 4028.886,
    "end_sec": 4029.206,
    "zh": "行了",
    "vi": "Được rồi"
  },
  {
    "idx": 2518,
    "start": "01:07:09,206",
    "end": "01:07:10,286",
    "start_sec": 4029.206,
    "end_sec": 4030.286,
    "zh": "都不用搬了",
    "vi": "Không cần chuyển nữa đâu"
  },
  {
    "idx": 2519,
    "start": "01:07:10,286",
    "end": "01:07:11,626",
    "start_sec": 4030.286,
    "end_sec": 4031.626,
    "zh": "以后住这里了",
    "vi": "Từ nay sẽ ở đây"
  },
  {
    "idx": 2520,
    "start": "01:07:11,626",
    "end": "01:07:12,546",
    "start_sec": 4031.626,
    "end_sec": 4032.546,
    "zh": "住",
    "vi": "Ở"
  },
  {
    "idx": 2521,
    "start": "01:07:12,546",
    "end": "01:07:13,166",
    "start_sec": 4032.546,
    "end_sec": 4033.166,
    "zh": "住这",
    "vi": "Ở đây sao."
  },
  {
    "idx": 2522,
    "start": "01:07:13,166",
    "end": "01:07:14,206",
    "start_sec": 4033.166,
    "end_sec": 4034.206,
    "zh": "罗小姐",
    "vi": "Cô La."
  },
  {
    "idx": 2523,
    "start": "01:07:14,206",
    "end": "01:07:15,166",
    "start_sec": 4034.206,
    "end_sec": 4035.166,
    "zh": "要是住这里",
    "vi": "Nếu phải ở đây."
  },
  {
    "idx": 2524,
    "start": "01:07:15,166",
    "end": "01:07:16,906",
    "start_sec": 4035.166,
    "end_sec": 4036.906,
    "zh": "你看你能不能送我回去",
    "vi": "Cô xem có thể đưa tôi về không."
  },
  {
    "idx": 2525,
    "start": "01:07:16,906",
    "end": "01:07:18,426",
    "start_sec": 4036.906,
    "end_sec": 4038.426,
    "zh": "或者您陪我走一趟",
    "vi": "Hoặc cô đi cùng tôi một chuyến."
  },
  {
    "idx": 2526,
    "start": "01:07:18,426",
    "end": "01:07:20,086",
    "start_sec": 4038.426,
    "end_sec": 4040.086,
    "zh": "让我把家人带过来呢",
    "vi": "Để tôi đón người nhà qua đây."
  },
  {
    "idx": 2527,
    "start": "01:07:20,086",
    "end": "01:07:22,506",
    "start_sec": 4040.086,
    "end_sec": 4042.506,
    "zh": "哼 你那一家五口",
    "vi": "Hừ, năm miệng ăn nhà anh."
  },
  {
    "idx": 2528,
    "start": "01:07:22,506",
    "end": "01:07:24,026",
    "start_sec": 4042.506,
    "end_sec": 4044.026,
    "zh": "消耗是不是太大了",
    "vi": "Tiêu tốn hơi nhiều đấy."
  },
  {
    "idx": 2529,
    "start": "01:07:24,026",
    "end": "01:07:26,286",
    "start_sec": 4044.026,
    "end_sec": 4046.286,
    "zh": "再说 你好像就会跳个门开个锁",
    "vi": "Hơn nữa, anh hình như chỉ biết nhảy cửa với mở khóa."
  },
  {
    "idx": 2530,
    "start": "01:07:26,286",
    "end": "01:07:27,126",
    "start_sec": 4046.286,
    "end_sec": 4047.126,
    "zh": "是不是有用",
    "vi": "Có ích gì chứ."
  },
  {
    "idx": 2531,
    "start": "01:07:27,126",
    "end": "01:07:28,966",
    "start_sec": 4047.126,
    "end_sec": 4048.966,
    "zh": "别 别 罗小姐",
    "vi": "Đừng, đừng mà cô La."
  },
  {
    "idx": 2532,
    "start": "01:07:28,966",
    "end": "01:07:30,766",
    "start_sec": 4048.966,
    "end_sec": 4050.766,
    "zh": "你就没什么想去的地方吗",
    "vi": "Cô không có nơi nào muốn đến sao."
  },
  {
    "idx": 2533,
    "start": "01:07:30,766",
    "end": "01:07:31,946",
    "start_sec": 4050.766,
    "end_sec": 4051.946,
    "zh": "我跟在你身边",
    "vi": "Tôi ở bên cạnh cô."
  },
  {
    "idx": 2534,
    "start": "01:07:31,946",
    "end": "01:07:34,326",
    "start_sec": 4051.946,
    "end_sec": 4054.326,
    "zh": "可以一直给您开锁的啊",
    "vi": "Có thể mở khóa cho cô mãi mà."
  },
  {
    "idx": 2535,
    "start": "01:07:34,326",
    "end": "01:07:36,306",
    "start_sec": 4054.326,
    "end_sec": 4056.306,
    "zh": "嗯 想去的地方",
    "vi": "Ừm, nơi muốn đến sao."
  },
  {
    "idx": 2536,
    "start": "01:07:36,306",
    "end": "01:07:38,246",
    "start_sec": 4056.306,
    "end_sec": 4058.246,
    "zh": "我还真有个地方想去来着",
    "vi": "Tôi đúng là có một nơi muốn đến."
  },
  {
    "idx": 2537,
    "start": "01:07:38,246",
    "end": "01:07:40,026",
    "start_sec": 4058.246,
    "end_sec": 4060.026,
    "zh": "就是我家楼下101",
    "vi": "Chính là phòng một linh một dưới nhà tôi."
  },
  {
    "idx": 2538,
    "start": "01:07:40,026",
    "end": "01:07:44,746",
    "start_sec": 4060.026,
    "end_sec": 4064.746,
    "zh": "天黑了",
    "vi": "Trời tối rồi."
  },
  {
    "idx": 2539,
    "start": "01:07:44,746",
    "end": "01:07:46,446",
    "start_sec": 4064.746,
    "end_sec": 4066.446,
    "zh": "你们不知道吧",
    "vi": "Các người không biết đâu."
  },
  {
    "idx": 2540,
    "start": "01:07:46,446",
    "end": "01:07:48,906",
    "start_sec": 4066.446,
    "end_sec": 4068.906,
    "zh": "101可是拿了整整一栋楼的口洋",
    "vi": "Phòng một linh một đã lấy hết lương thực của cả tòa nhà."
  },
  {
    "idx": 2541,
    "start": "01:07:48,906",
    "end": "01:07:49,966",
    "start_sec": 4068.906,
    "end_sec": 4069.966,
    "zh": "真是自私",
    "vi": "Thật là ích kỷ."
  },
  {
    "idx": 2542,
    "start": "01:07:49,966",
    "end": "01:07:50,906",
    "start_sec": 4069.966,
    "end_sec": 4070.906,
    "zh": "太自私了",
    "vi": "Quá ích kỷ."
  },
  {
    "idx": 2543,
    "start": "01:07:50,906",
    "end": "01:07:52,406",
    "start_sec": 4070.906,
    "end_sec": 4072.406,
    "zh": "真不是好鸟啊",
    "vi": "Đúng là kẻ chẳng ra gì."
  },
  {
    "idx": 2544,
    "start": "01:07:52,406",
    "end": "01:07:53,586",
    "start_sec": 4072.406,
    "end_sec": 4073.586,
    "zh": "藏了这么多吃的",
    "vi": "Giấu nhiều đồ ăn như vậy."
  },
  {
    "idx": 2545,
    "start": "01:07:53,586",
    "end": "01:07:54,626",
    "start_sec": 4073.586,
    "end_sec": 4074.626,
    "zh": "也不知道分享",
    "vi": "Mà không biết chia sẻ."
  },
  {
    "idx": 2546,
    "start": "01:07:54,626",
    "end": "01:07:55,586",
    "start_sec": 4074.626,
    "end_sec": 4075.586,
    "zh": "赵德柱",
    "vi": "Triệu Đức Trụ."
  },
  {
    "idx": 2547,
    "start": "01:07:55,586",
    "end": "01:07:56,526",
    "start_sec": 4075.586,
    "end_sec": 4076.526,
    "zh": "你们开门后",
    "vi": "Sau khi các người mở cửa."
  },
  {
    "idx": 2548,
    "start": "01:07:56,526",
    "end": "01:07:57,846",
    "start_sec": 4076.526,
    "end_sec": 4077.846,
    "zh": "里面的东西随便拿",
    "vi": "Đồ bên trong cứ lấy tự nhiên."
  },
  {
    "idx": 2549,
    "start": "01:07:57,846",
    "end": "01:07:58,726",
    "start_sec": 4077.846,
    "end_sec": 4078.726,
    "zh": "我一尊不要",
    "vi": "Tôi không lấy một món nào."
  },
  {
    "idx": 2550,
    "start": "01:07:58,726",
    "end": "01:07:59,966",
    "start_sec": 4078.726,
    "end_sec": 4079.966,
    "zh": "这是有的小弟",
    "vi": "Đây là đàn em của cô."
  },
  {
    "idx": 2551,
    "start": "01:07:59,966",
    "end": "01:08:01,046",
    "start_sec": 4079.966,
    "end_sec": 4081.046,
    "zh": "回来包袱我了",
    "vi": "Quay lại làm vướng chân tôi rồi."
  },
  {
    "idx": 2552,
    "start": "01:08:01,046",
    "end": "01:08:02,866",
    "start_sec": 4081.046,
    "end_sec": 4082.866,
    "zh": "唐可提听着门外的动静",
    "vi": "Đường Khả Đề nghe động tĩnh ngoài cửa."
  },
  {
    "idx": 2553,
    "start": "01:08:02,866",
    "end": "01:08:04,346",
    "start_sec": 4082.866,
    "end_sec": 4084.346,
    "zh": "看了眼手机上的部件",
    "vi": "liếc nhìn linh kiện trên điện thoại."
  },
  {
    "idx": 2554,
    "start": "01:08:04,346",
    "end": "01:08:06,586",
    "start_sec": 4084.346,
    "end_sec": 4086.586,
    "zh": "丝毫不在意的坐回沙发上",
    "vi": "không chút bận tâm mà ngồi lại ghế sofa."
  },
  {
    "idx": 2555,
    "start": "01:08:06,586",
    "end": "01:08:07,746",
    "start_sec": 4086.586,
    "end_sec": 4087.746,
    "zh": "长期待在小区",
    "vi": "Ở lại khu chung cư này lâu dài."
  },
  {
    "idx": 2556,
    "start": "01:08:07,746",
    "end": "01:08:09,026",
    "start_sec": 4087.746,
    "end_sec": 4089.026,
    "zh": "绝对不是明智之举",
    "vi": "tuyệt đối không phải là quyết định khôn ngoan."
  },
  {
    "idx": 2557,
    "start": "01:08:09,026",
    "end": "01:08:10,066",
    "start_sec": 4089.026,
    "end_sec": 4090.066,
    "zh": "得快点确定",
    "vi": "Phải nhanh chóng xác định xem."
  },
  {
    "idx": 2558,
    "start": "01:08:10,066",
    "end": "01:08:10,986",
    "start_sec": 4090.066,
    "end_sec": 4090.986,
    "zh": "香炉有没有用",
    "vi": "lư hương có tác dụng hay không."
  },
  {
    "idx": 2559,
    "start": "01:08:10,986",
    "end": "01:08:12,246",
    "start_sec": 4090.986,
    "end_sec": 4092.246,
    "zh": "还有小区周围的情况",
    "vi": "và tình hình xung quanh khu chung cư."
  },
  {
    "idx": 2560,
    "start": "01:08:12,246",
    "end": "01:08:13,086",
    "start_sec": 4092.246,
    "end_sec": 4093.086,
    "zh": "以及临江市",
    "vi": "cũng như thành phố Lâm Giang."
  },
  {
    "idx": 2561,
    "start": "01:08:13,086",
    "end": "01:08:14,306",
    "start_sec": 4093.086,
    "end_sec": 4094.306,
    "zh": "有没有撤离点之类的",
    "vi": "có điểm sơ tán nào không."
  },
  {
    "idx": 2562,
    "start": "01:08:14,306",
    "end": "01:08:16,286",
    "start_sec": 4094.306,
    "end_sec": 4096.286,
    "zh": "再码",
    "vi": "Mẹ kiếp."
  },
  {
    "idx": 2563,
    "start": "01:08:16,286",
    "end": "01:08:17,406",
    "start_sec": 4096.286,
    "end_sec": 4097.406,
    "zh": "我跑了整个市区",
    "vi": "Tôi đã chạy khắp cả thành phố."
  },
  {
    "idx": 2564,
    "start": "01:08:17,406",
    "end": "01:08:19,066",
    "start_sec": 4097.406,
    "end_sec": 4099.066,
    "zh": "终于买到两只纯黑的野狗",
    "vi": "cuối cùng cũng mua được hai con chó hoang đen tuyền."
  },
  {
    "idx": 2565,
    "start": "01:08:19,066",
    "end": "01:08:19,666",
    "start_sec": 4099.066,
    "end_sec": 4099.666,
    "zh": "马达",
    "vi": "Mẹ kiếp."
  },
  {
    "idx": 2566,
    "start": "01:08:19,966",
    "end": "01:08:21,466",
    "start_sec": 4099.966,
    "end_sec": 4101.466,
    "zh": "狗贩子捐一条收我五千",
    "vi": "Bọn buôn chó lấy của tôi năm nghìn một con."
  },
  {
    "idx": 2567,
    "start": "01:08:21,466",
    "end": "01:08:22,186",
    "start_sec": 4101.466,
    "end_sec": 4102.186,
    "zh": "真黑呀",
    "vi": "Đúng là cắt cổ mà."
  },
  {
    "idx": 2568,
    "start": "01:08:22,186",
    "end": "01:08:23,026",
    "start_sec": 4102.186,
    "end_sec": 4103.026,
    "zh": "不过说来也怪",
    "vi": "Nhưng nói cũng lạ."
  },
  {
    "idx": 2569,
    "start": "01:08:23,026",
    "end": "01:08:24,126",
    "start_sec": 4103.026,
    "end_sec": 4104.126,
    "zh": "周扬娜和公子哥",
    "vi": "Chu Dương Na và tên công tử bột đó."
  },
  {
    "idx": 2570,
    "start": "01:08:24,126",
    "end": "01:08:25,186",
    "start_sec": 4104.126,
    "end_sec": 4105.186,
    "zh": "居然要了这黑野狗",
    "vi": "lại muốn lấy con chó hoang đen này."
  },
  {
    "idx": 2571,
    "start": "01:08:25,186",
    "end": "01:08:25,766",
    "start_sec": 4105.186,
    "end_sec": 4105.766,
    "zh": "我以为他",
    "vi": "Tôi cứ nghĩ anh ta."
  },
  {
    "idx": 2572,
    "start": "01:08:25,766",
    "end": "01:08:27,186",
    "start_sec": 4105.766,
    "end_sec": 4107.186,
    "zh": "至少要个有血统的狗呢",
    "vi": "ít nhất cũng phải đòi một con chó có gia phả chứ."
  },
  {
    "idx": 2573,
    "start": "01:08:27,186",
    "end": "01:08:28,366",
    "start_sec": 4107.186,
    "end_sec": 4108.366,
    "zh": "野狗好啊",
    "vi": "Chó hoang tốt mà."
  },
  {
    "idx": 2574,
    "start": "01:08:28,366",
    "end": "01:08:28,646",
    "start_sec": 4108.366,
    "end_sec": 4108.646,
    "zh": "兄",
    "vi": "Này anh."
  },
  {
    "idx": 2575,
    "start": "01:08:28,646",
    "end": "01:08:29,366",
    "start_sec": 4108.646,
    "end_sec": 4109.366,
    "zh": "狗呢",
    "vi": "Chó đâu rồi."
  },
  {
    "idx": 2576,
    "start": "01:08:29,366",
    "end": "01:08:30,406",
    "start_sec": 4109.366,
    "end_sec": 4110.406,
    "zh": "大概什么时候到",
    "vi": "Khoảng bao giờ thì tới."
  },
  {
    "idx": 2577,
    "start": "01:08:30,406",
    "end": "01:08:31,346",
    "start_sec": 4110.406,
    "end_sec": 4111.346,
    "zh": "明天吧",
    "vi": "Chắc là ngày mai."
  },
  {
    "idx": 2578,
    "start": "01:08:31,346",
    "end": "01:08:32,266",
    "start_sec": 4111.346,
    "end_sec": 4112.266,
    "zh": "今晚刚打的针",
    "vi": "Tối nay vừa mới tiêm phòng xong."
  },
  {
    "idx": 2579,
    "start": "01:08:32,266",
    "end": "01:08:33,226",
    "start_sec": 4112.266,
    "end_sec": 4113.226,
    "zh": "办得正",
    "vi": "Đang làm giấy tờ."
  },
  {
    "idx": 2580,
    "start": "01:08:33,226",
    "end": "01:08:34,826",
    "start_sec": 4113.226,
    "end_sec": 4114.826,
    "zh": "明早要多快有多快",
    "vi": "Sáng mai sẽ giao tới nhanh nhất có thể."
  },
  {
    "idx": 2581,
    "start": "01:08:34,826",
    "end": "01:08:36,186",
    "start_sec": 4114.826,
    "end_sec": 4116.186,
    "zh": "你把狗带回来",
    "vi": "Anh đưa con chó về đây đi"
  },
  {
    "idx": 2582,
    "start": "01:08:36,186",
    "end": "01:08:37,326",
    "start_sec": 4116.186,
    "end_sec": 4117.326,
    "zh": "成此提示吧",
    "vi": "Đây là lời cảnh báo cho anh đấy"
  },
  {
    "idx": 2583,
    "start": "01:08:37,326",
    "end": "01:08:38,526",
    "start_sec": 4117.326,
    "end_sec": 4118.526,
    "zh": "敢欺负我罗姐",
    "vi": "Dám bắt nạt chị La của tôi à"
  },
  {
    "idx": 2584,
    "start": "01:08:38,526",
    "end": "01:08:39,866",
    "start_sec": 4118.526,
    "end_sec": 4119.866,
    "zh": "现在你自己开门",
    "vi": "Giờ anh tự mở cửa đi"
  },
  {
    "idx": 2585,
    "start": "01:08:39,866",
    "end": "01:08:40,806",
    "start_sec": 4119.866,
    "end_sec": 4120.806,
    "zh": "还能免一顿打",
    "vi": "Còn tránh được một trận đòn"
  },
  {
    "idx": 2586,
    "start": "01:08:40,806",
    "end": "01:08:42,166",
    "start_sec": 4120.806,
    "end_sec": 4122.166,
    "zh": "要是等我们进去",
    "vi": "Nếu để chúng tôi vào"
  },
  {
    "idx": 2587,
    "start": "01:08:42,166",
    "end": "01:08:43,226",
    "start_sec": 4122.166,
    "end_sec": 4123.226,
    "zh": "不想说的话",
    "vi": "Mà anh không chịu nói"
  },
  {
    "idx": 2588,
    "start": "01:08:43,226",
    "end": "01:08:44,286",
    "start_sec": 4123.226,
    "end_sec": 4124.286,
    "zh": "我劝你们现在离开",
    "vi": "Tôi khuyên anh nên rời đi ngay bây giờ"
  },
  {
    "idx": 2589,
    "start": "01:08:44,286",
    "end": "01:08:44,786",
    "start_sec": 4124.286,
    "end_sec": 4124.786,
    "zh": "还来得及",
    "vi": "Vẫn còn kịp"
  },
  {
    "idx": 2590,
    "start": "01:08:44,786",
    "end": "01:08:46,546",
    "start_sec": 4124.786,
    "end_sec": 4126.546,
    "zh": "还敢威胁我们",
    "vi": "Anh còn dám đe dọa chúng tôi"
  },
  {
    "idx": 2591,
    "start": "01:08:46,546",
    "end": "01:08:47,306",
    "start_sec": 4126.546,
    "end_sec": 4127.306,
    "zh": "我说",
    "vi": "Tôi nói này"
  },
  {
    "idx": 2592,
    "start": "01:08:47,306",
    "end": "01:08:48,686",
    "start_sec": 4127.306,
    "end_sec": 4128.686,
    "zh": "你们已经有了便利店",
    "vi": "Anh đã có cửa hàng tiện lợi rồi"
  },
  {
    "idx": 2593,
    "start": "01:08:48,686",
    "end": "01:08:50,526",
    "start_sec": 4128.686,
    "end_sec": 4130.526,
    "zh": "不至于来这里跟我共吃饭",
    "vi": "Đâu cần phải đến đây ăn cơm với tôi"
  },
  {
    "idx": 2594,
    "start": "01:08:50,526",
    "end": "01:08:51,686",
    "start_sec": 4130.526,
    "end_sec": 4131.686,
    "zh": "长子皮双眼",
    "vi": "Changzi Pi nhìn quanh"
  },
  {
    "idx": 2595,
    "start": "01:08:51,686",
    "end": "01:08:53,486",
    "start_sec": 4131.686,
    "end_sec": 4133.486,
    "zh": "不是朝着厨房的方向看见",
    "vi": "Không thấy hướng về phía nhà bếp"
  },
  {
    "idx": 2596,
    "start": "01:08:53,486",
    "end": "01:08:55,326",
    "start_sec": 4133.486,
    "end_sec": 4135.326,
    "zh": "罗杰跟他废什么话",
    "vi": "Nói nhiều với Roger làm gì"
  },
  {
    "idx": 2597,
    "start": "01:08:55,326",
    "end": "01:08:57,026",
    "start_sec": 4135.326,
    "end_sec": 4137.026,
    "zh": "等进去好好揍他一顿",
    "vi": "Đợi vào trong đánh cho một trận"
  },
  {
    "idx": 2598,
    "start": "01:08:57,026",
    "end": "01:08:58,386",
    "start_sec": 4137.026,
    "end_sec": 4138.386,
    "zh": "赶紧滚",
    "vi": "Cút ngay đi"
  },
  {
    "idx": 2599,
    "start": "01:08:58,386",
    "end": "01:08:59,306",
    "start_sec": 4138.386,
    "end_sec": 4139.306,
    "zh": "我屋里有鬼",
    "vi": "Nhà tôi có ma"
  },
  {
    "idx": 2600,
    "start": "01:08:59,306",
    "end": "01:09:00,366",
    "start_sec": 4139.306,
    "end_sec": 4140.366,
    "zh": "你们要是想死",
    "vi": "Nếu các người muốn chết"
  },
  {
    "idx": 2601,
    "start": "01:09:00,366",
    "end": "01:09:01,506",
    "start_sec": 4140.366,
    "end_sec": 4141.506,
    "zh": "尽管试试",
    "vi": "Cứ thử xem"
  },
  {
    "idx": 2602,
    "start": "01:09:01,506",
    "end": "01:09:02,786",
    "start_sec": 4141.506,
    "end_sec": 4142.786,
    "zh": "长子皮看了一眼时间",
    "vi": "Changzi Pi liếc nhìn đồng hồ"
  },
  {
    "idx": 2603,
    "start": "01:09:02,786",
    "end": "01:09:04,626",
    "start_sec": 4142.786,
    "end_sec": 4144.626,
    "zh": "快要躲在角落里",
    "vi": "Nhanh chóng trốn vào góc"
  },
  {
    "idx": 2604,
    "start": "01:09:04,626",
    "end": "01:09:06,126",
    "start_sec": 4144.626,
    "end_sec": 4146.126,
    "zh": "鬼",
    "vi": "Ma"
  },
  {
    "idx": 2605,
    "start": "01:09:06,126",
    "end": "01:09:07,266",
    "start_sec": 4146.126,
    "end_sec": 4147.266,
    "zh": "他屋里有鬼",
    "vi": "Nhà anh ta có ma"
  },
  {
    "idx": 2606,
    "start": "01:09:07,266",
    "end": "01:09:10,006",
    "start_sec": 4147.266,
    "end_sec": 4150.006,
    "zh": "好像他这个屋以前是死过人吧",
    "vi": "Hình như nhà này trước đây có người chết thì phải"
  },
  {
    "idx": 2607,
    "start": "01:09:10,006",
    "end": "01:09:10,886",
    "start_sec": 4150.006,
    "end_sec": 4150.886,
    "zh": "我记起来了",
    "vi": "Tôi nhớ ra rồi"
  },
  {
    "idx": 2608,
    "start": "01:09:10,886",
    "end": "01:09:12,346",
    "start_sec": 4150.886,
    "end_sec": 4152.346,
    "zh": "他这屋以前发生过爆炸",
    "vi": "Nhà này trước đây từng xảy ra vụ nổ"
  },
  {
    "idx": 2609,
    "start": "01:09:12,346",
    "end": "01:09:13,306",
    "start_sec": 4152.346,
    "end_sec": 4153.306,
    "zh": "死了一老一小",
    "vi": "Chết một già một trẻ"
  },
  {
    "idx": 2610,
    "start": "01:09:13,306",
    "end": "01:09:14,586",
    "start_sec": 4153.306,
    "end_sec": 4154.586,
    "zh": "众人念念相续",
    "vi": "Mọi người xôn xao bàn tán"
  },
  {
    "idx": 2611,
    "start": "01:09:14,586",
    "end": "01:09:16,726",
    "start_sec": 4154.586,
    "end_sec": 4156.726,
    "zh": "现代的他们对于鬼这个字眼",
    "vi": "Người hiện đại bọn họ nghe đến chữ ma"
  },
  {
    "idx": 2612,
    "start": "01:09:16,726",
    "end": "01:09:17,846",
    "start_sec": 4156.726,
    "end_sec": 4157.846,
    "zh": "可是怕得不行",
    "vi": "Là sợ đến mức không chịu nổi"
  },
  {
    "idx": 2613,
    "start": "01:09:17,846",
    "end": "01:09:18,846",
    "start_sec": 4157.846,
    "end_sec": 4158.846,
    "zh": "那是屁",
    "vi": "Đúng là nhảm nhí"
  },
  {
    "idx": 2614,
    "start": "01:09:18,846",
    "end": "01:09:20,086",
    "start_sec": 4158.846,
    "end_sec": 4160.086,
    "zh": "他肯定唬我们的",
    "vi": "Nó chắc chắn đang dọa chúng ta"
  },
  {
    "idx": 2615,
    "start": "01:09:20,086",
    "end": "01:09:20,826",
    "start_sec": 4160.086,
    "end_sec": 4160.826,
    "zh": "再说了",
    "vi": "Hơn nữa"
  },
  {
    "idx": 2616,
    "start": "01:09:20,826",
    "end": "01:09:21,706",
    "start_sec": 4160.826,
    "end_sec": 4161.706,
    "zh": "有鬼的屋子",
    "vi": "Căn nhà có ma"
  },
  {
    "idx": 2617,
    "start": "01:09:21,706",
    "end": "01:09:22,786",
    "start_sec": 4161.706,
    "end_sec": 4162.786,
    "zh": "他敢待在里面",
    "vi": "Nó dám ở bên trong"
  },
  {
    "idx": 2618,
    "start": "01:09:22,786",
    "end": "01:09:23,526",
    "start_sec": 4162.786,
    "end_sec": 4163.526,
    "zh": "你们就不敢",
    "vi": "Các bạn lại không dám"
  },
  {
    "idx": 2619,
    "start": "01:09:23,526",
    "end": "01:09:23,966",
    "start_sec": 4163.526,
    "end_sec": 4163.966,
    "zh": "对",
    "vi": "Đúng"
  },
  {
    "idx": 2620,
    "start": "01:09:23,966",
    "end": "01:09:26,246",
    "start_sec": 4163.966,
    "end_sec": 4166.246,
    "zh": "这小子一定是吓唬人",
    "vi": "Thằng nhóc này chắc chắn đang dọa người"
  },
  {
    "idx": 2621,
    "start": "01:09:26,246",
    "end": "01:09:27,246",
    "start_sec": 4166.246,
    "end_sec": 4167.246,
    "zh": "几人又来了底气",
    "vi": "Mấy người lại lấy lại can đảm"
  },
  {
    "idx": 2622,
    "start": "01:09:27,246",
    "end": "01:09:28,606",
    "start_sec": 4167.246,
    "end_sec": 4168.606,
    "zh": "而屋里的橙子皮",
    "vi": "Còn Trần Tử Bì ở trong nhà"
  },
  {
    "idx": 2623,
    "start": "01:09:28,606",
    "end": "01:09:30,166",
    "start_sec": 4168.606,
    "end_sec": 4170.166,
    "zh": "却没再发出任何回应",
    "vi": "Lại không hề đưa ra phản hồi nào"
  },
  {
    "idx": 2624,
    "start": "01:09:30,166",
    "end": "01:09:31,086",
    "start_sec": 4170.166,
    "end_sec": 4171.086,
    "zh": "因为他的目光",
    "vi": "Bởi vì ánh mắt của nó"
  },
  {
    "idx": 2625,
    "start": "01:09:31,086",
    "end": "01:09:32,626",
    "start_sec": 4171.086,
    "end_sec": 4172.626,
    "zh": "全然落在厨房里",
    "vi": "Hoàn toàn đặt ở trong bếp"
  },
  {
    "idx": 2626,
    "start": "01:09:32,626",
    "end": "01:09:39,706",
    "start_sec": 4172.626,
    "end_sec": 4179.706,
    "zh": "这香炉怎么不发光",
    "vi": "Sao cái lư hương này không phát sáng"
  },
  {
    "idx": 2627,
    "start": "01:09:39,706",
    "end": "01:09:40,246",
    "start_sec": 4179.706,
    "end_sec": 4180.246,
    "zh": "卧槽",
    "vi": "Chết tiệt"
  },
  {
    "idx": 2628,
    "start": "01:09:40,246",
    "end": "01:09:41,446",
    "start_sec": 4180.246,
    "end_sec": 4181.446,
    "zh": "难道我买了个假货",
    "vi": "Chẳng lẽ tôi mua phải hàng giả"
  },
  {
    "idx": 2629,
    "start": "01:09:41,446",
    "end": "01:09:43,486",
    "start_sec": 4181.446,
    "end_sec": 4183.486,
    "zh": "就在橙子皮吐槽的同时",
    "vi": "Ngay lúc Trần Tử Bì đang càm ràm"
  },
  {
    "idx": 2630,
    "start": "01:09:43,486",
    "end": "01:09:45,286",
    "start_sec": 4183.486,
    "end_sec": 4185.286,
    "zh": "那敲门鬼脑袋满的一双",
    "vi": "Con ma gõ cửa kia nhìn chằm chằm vào"
  },
  {
    "idx": 2631,
    "start": "01:09:45,286",
    "end": "01:09:46,506",
    "start_sec": 4185.286,
    "end_sec": 4186.506,
    "zh": "死死冰的香炉",
    "vi": "Cái lư hương lạnh lẽo"
  },
  {
    "idx": 2632,
    "start": "01:09:46,506",
    "end": "01:09:48,186",
    "start_sec": 4186.506,
    "end_sec": 4188.186,
    "zh": "整个区域都在发闪",
    "vi": "Cả khu vực đều đang lóe sáng"
  },
  {
    "idx": 2633,
    "start": "01:09:48,186",
    "end": "01:09:50,126",
    "start_sec": 4188.186,
    "end_sec": 4190.126,
    "zh": "卧槽",
    "vi": "Chết tiệt"
  },
  {
    "idx": 2634,
    "start": "01:09:50,126",
    "end": "01:09:51,006",
    "start_sec": 4190.126,
    "end_sec": 4191.006,
    "zh": "真有用",
    "vi": "Thật sự có tác dụng"
  },
  {
    "idx": 2635,
    "start": "01:09:51,006",
    "end": "01:09:52,186",
    "start_sec": 4191.006,
    "end_sec": 4192.186,
    "zh": "他们在怕这个香炉",
    "vi": "Chúng nó đang sợ cái lư hương này"
  },
  {
    "idx": 2636,
    "start": "01:09:52,186",
    "end": "01:09:53,086",
    "start_sec": 4192.186,
    "end_sec": 4193.086,
    "zh": "可是这香炉",
    "vi": "Nhưng cái lư hương này"
  },
  {
    "idx": 2637,
    "start": "01:09:53,086",
    "end": "01:09:53,906",
    "start_sec": 4193.086,
    "end_sec": 4193.906,
    "zh": "也不是法器",
    "vi": "Cũng đâu phải pháp khí"
  },
  {
    "idx": 2638,
    "start": "01:09:53,906",
    "end": "01:09:59,899",
    "start_sec": 4193.906,
    "end_sec": 4199.899,
    "zh": "美貌金光啊敲门鬼生怕得罪了香炉般拉开去沿着这些随行人性的厉害的香炉朝着门外走进难不成这永德斯基派的是什么大神赵德柱你个废物",
    "vi": "Ánh vàng rực rỡ kìa con ma gõ cửa sợ đắc tội với lư hương nên lùi lại phía sau tránh xa cái lư hương"
  },
  {
    "idx": 2638,
    "start": "01:09:59,899",
    "end": "01:10:05,652",
    "start_sec": 4199.899,
    "end_sec": 4205.652,
    "zh": "美貌金光啊敲门鬼生怕得罪了香炉般拉开去沿着这些随行人性的厉害的香炉朝着门外走进难不成这永德斯基派的是什么大神赵德柱你个废物",
    "vi": "lợi hại này rồi đi ra ngoài cửa chẳng lẽ kẻ phái đến là đại thần nào đó Triệu Đức Trụ đồ vô dụng"
  },
  {
    "idx": 2639,
    "start": "01:10:05,652",
    "end": "01:10:06,972",
    "start_sec": 4205.652,
    "end_sec": 4206.972,
    "zh": "开个门开这么久",
    "vi": "Mở cửa mà mở lâu thế"
  },
  {
    "idx": 2640,
    "start": "01:10:06,972",
    "end": "01:10:07,932",
    "start_sec": 4206.972,
    "end_sec": 4207.932,
    "zh": "马上好",
    "vi": "Sắp xong rồi"
  },
  {
    "idx": 2641,
    "start": "01:10:07,932",
    "end": "01:10:08,952",
    "start_sec": 4207.932,
    "end_sec": 4208.952,
    "zh": "马上好",
    "vi": "Xong ngay đây."
  },
  {
    "idx": 2642,
    "start": "01:10:08,952",
    "end": "01:10:11,712",
    "start_sec": 4208.952,
    "end_sec": 4211.712,
    "zh": "他妈的",
    "vi": "Mẹ kiếp."
  },
  {
    "idx": 2643,
    "start": "01:10:11,712",
    "end": "01:10:12,532",
    "start_sec": 4211.712,
    "end_sec": 4212.532,
    "zh": "赶紧开门",
    "vi": "Mau mở cửa ra."
  },
  {
    "idx": 2644,
    "start": "01:10:12,532",
    "end": "01:10:14,052",
    "start_sec": 4212.532,
    "end_sec": 4214.052,
    "zh": "怎么",
    "vi": "Sao thế."
  },
  {
    "idx": 2645,
    "start": "01:10:14,052",
    "end": "01:10:15,032",
    "start_sec": 4214.052,
    "end_sec": 4215.032,
    "zh": "想明白了",
    "vi": "Nghĩ thông suốt rồi à."
  },
  {
    "idx": 2646,
    "start": "01:10:15,032",
    "end": "01:10:16,292",
    "start_sec": 4215.032,
    "end_sec": 4216.292,
    "zh": "现在知道开门了",
    "vi": "Giờ mới biết mở cửa à."
  },
  {
    "idx": 2647,
    "start": "01:10:16,292",
    "end": "01:10:16,552",
    "start_sec": 4216.292,
    "end_sec": 4216.552,
    "zh": "完了",
    "vi": "Tiêu rồi."
  },
  {
    "idx": 2648,
    "start": "01:10:16,552",
    "end": "01:10:17,252",
    "start_sec": 4216.552,
    "end_sec": 4217.252,
    "zh": "我飞了",
    "vi": "Tôi chạy đây."
  },
  {
    "idx": 2649,
    "start": "01:10:17,252",
    "end": "01:10:19,532",
    "start_sec": 4217.252,
    "end_sec": 4219.532,
    "zh": "你",
    "vi": "Cậu"
  },
  {
    "idx": 2650,
    "start": "01:10:19,532",
    "end": "01:10:20,152",
    "start_sec": 4219.532,
    "end_sec": 4220.152,
    "zh": "你",
    "vi": "Cậu"
  },
  {
    "idx": 2651,
    "start": "01:10:25,012",
    "end": "01:10:27,912",
    "start_sec": 4225.012,
    "end_sec": 4227.912,
    "zh": "罗倩姐姐",
    "vi": "Chị La Thiến"
  },
  {
    "idx": 2652,
    "start": "01:10:27,912",
    "end": "01:10:28,792",
    "start_sec": 4227.912,
    "end_sec": 4228.792,
    "zh": "等等我",
    "vi": "Chờ tôi với."
  },
  {
    "idx": 2653,
    "start": "01:10:28,792",
    "end": "01:10:29,692",
    "start_sec": 4228.792,
    "end_sec": 4229.692,
    "zh": "我跑",
    "vi": "Tôi chạy đây."
  },
  {
    "idx": 2654,
    "start": "01:10:29,692",
    "end": "01:10:31,012",
    "start_sec": 4229.692,
    "end_sec": 4231.012,
    "zh": "什么鬼啊",
    "vi": "Cái quỷ gì thế."
  },
  {
    "idx": 2655,
    "start": "01:10:31,012",
    "end": "01:10:34,612",
    "start_sec": 4231.012,
    "end_sec": 4234.612,
    "zh": "我都说了",
    "vi": "Tôi đã nói rồi mà."
  },
  {
    "idx": 2656,
    "start": "01:10:34,612",
    "end": "01:10:35,652",
    "start_sec": 4234.612,
    "end_sec": 4235.652,
    "zh": "屋里有鬼吗",
    "vi": "Trong nhà có quỷ à."
  },
  {
    "idx": 2657,
    "start": "01:10:35,652",
    "end": "01:10:37,452",
    "start_sec": 4235.652,
    "end_sec": 4237.452,
    "zh": "这个罗倩跑得倒是挺快",
    "vi": "Cô nàng La Thiến này chạy nhanh thật đấy."
  },
  {
    "idx": 2658,
    "start": "01:10:37,452",
    "end": "01:10:38,532",
    "start_sec": 4237.452,
    "end_sec": 4238.532,
    "zh": "可惜了",
    "vi": "Tiếc thật."
  },
  {
    "idx": 2659,
    "start": "01:10:38,532",
    "end": "01:10:40,572",
    "start_sec": 4238.532,
    "end_sec": 4240.572,
    "zh": "罗倩照得住小白脸三人",
    "vi": "La Thiến cùng ba tên mặt trắng kia"
  },
  {
    "idx": 2660,
    "start": "01:10:40,572",
    "end": "01:10:42,292",
    "start_sec": 4240.572,
    "end_sec": 4242.292,
    "zh": "争先恐后的往楼上跑",
    "vi": "tranh nhau chạy lên lầu."
  },
  {
    "idx": 2661,
    "start": "01:10:42,292",
    "end": "01:10:44,972",
    "start_sec": 4242.292,
    "end_sec": 4244.972,
    "zh": "只有邹健不知是吓傻了还是等得",
    "vi": "Chỉ có Châu Kiện không biết là bị dọa sợ đến ngốc hay sao"
  },
  {
    "idx": 2662,
    "start": "01:10:44,972",
    "end": "01:10:46,492",
    "start_sec": 4244.972,
    "end_sec": 4246.492,
    "zh": "竟然往店里一点狂奔",
    "vi": "mà lại điên cuồng chạy vào trong cửa hàng."
  },
  {
    "idx": 2663,
    "start": "01:10:46,492",
    "end": "01:10:52,452",
    "start_sec": 4246.492,
    "end_sec": 4252.452,
    "zh": "你",
    "vi": "Mày"
  },
  {
    "idx": 2664,
    "start": "01:10:52,452",
    "end": "01:10:53,392",
    "start_sec": 4252.452,
    "end_sec": 4253.392,
    "zh": "你别过来",
    "vi": "Mày đừng qua đây."
  },
  {
    "idx": 2665,
    "start": "01:10:53,392",
    "end": "01:11:03,732",
    "start_sec": 4253.392,
    "end_sec": 4263.732,
    "zh": "周健简直不敢相信自己的眼睛",
    "vi": "Châu Kiện không thể tin vào mắt mình nữa."
  },
  {
    "idx": 2666,
    "start": "01:11:03,732",
    "end": "01:11:04,792",
    "start_sec": 4263.732,
    "end_sec": 4264.792,
    "zh": "那爬行女鬼",
    "vi": "Con quỷ cái đang bò kia"
  },
  {
    "idx": 2667,
    "start": "01:11:04,792",
    "end": "01:11:06,332",
    "start_sec": 4264.792,
    "end_sec": 4266.332,
    "zh": "见到敲门鬼老太太",
    "vi": "khi nhìn thấy bà lão quỷ gõ cửa"
  },
  {
    "idx": 2668,
    "start": "01:11:06,332",
    "end": "01:11:07,672",
    "start_sec": 4266.332,
    "end_sec": 4267.672,
    "zh": "竟然卑微的低头黑",
    "vi": "lại hèn mọn cúi đầu xuống."
  },
  {
    "idx": 2669,
    "start": "01:11:07,672",
    "end": "01:11:08,732",
    "start_sec": 4267.672,
    "end_sec": 4268.732,
    "zh": "他很想跑",
    "vi": "Anh ta rất muốn chạy"
  },
  {
    "idx": 2670,
    "start": "01:11:08,732",
    "end": "01:11:11,012",
    "start_sec": 4268.732,
    "end_sec": 4271.012,
    "zh": "但身体却不受控制的相对人力",
    "vi": "nhưng cơ thể lại không thể khống chế được."
  },
  {
    "idx": 2671,
    "start": "01:11:11,012",
    "end": "01:11:13,312",
    "start_sec": 4271.012,
    "end_sec": 4273.312,
    "zh": "只能眼睁睁等待着自己的脑袋炸",
    "vi": "Chỉ có thể trơ mắt nhìn đầu mình nổ tung."
  },
  {
    "idx": 2672,
    "start": "01:11:13,312",
    "end": "01:11:15,792",
    "start_sec": 4273.312,
    "end_sec": 4275.792,
    "zh": "有了这次的教训",
    "vi": "Có được bài học lần này."
  },
  {
    "idx": 2673,
    "start": "01:11:15,792",
    "end": "01:11:17,592",
    "start_sec": 4275.792,
    "end_sec": 4277.592,
    "zh": "罗倩应该不敢来找我了",
    "vi": "La Thiến chắc là không dám đến tìm tôi nữa rồi."
  },
  {
    "idx": 2674,
    "start": "01:11:17,592",
    "end": "01:11:19,452",
    "start_sec": 4277.592,
    "end_sec": 4279.452,
    "zh": "按照一个月的固定时间",
    "vi": "Tính theo thời gian cố định một tháng."
  },
  {
    "idx": 2675,
    "start": "01:11:19,452",
    "end": "01:11:20,172",
    "start_sec": 4279.452,
    "end_sec": 4280.172,
    "zh": "差事来算",
    "vi": "làm nhiệm vụ."
  },
  {
    "idx": 2676,
    "start": "01:11:20,172",
    "end": "01:11:21,792",
    "start_sec": 4280.172,
    "end_sec": 4281.792,
    "zh": "一个月前的我明天领回黑狗",
    "vi": "Tôi của một tháng trước ngày mai sẽ nhận lại chú chó đen."
  },
  {
    "idx": 2677,
    "start": "01:11:21,792",
    "end": "01:11:24,332",
    "start_sec": 4281.792,
    "end_sec": 4284.332,
    "zh": "现在的我第二天也会得到黑狗",
    "vi": "Tôi của hiện tại ngày hôm sau cũng sẽ có được chú chó đen."
  },
  {
    "idx": 2678,
    "start": "01:11:24,332",
    "end": "01:11:27,552",
    "start_sec": 4284.332,
    "end_sec": 4287.552,
    "zh": "相如黑狗总算是拥有一定的自保能力了",
    "vi": "Có được chú chó đen cuối cùng cũng giúp tôi có khả năng tự bảo vệ nhất định rồi."
  },
  {
    "idx": 2679,
    "start": "01:11:27,552",
    "end": "01:11:32,472",
    "start_sec": 4287.552,
    "end_sec": 4292.472,
    "zh": "我操",
    "vi": "Chết tiệt."
  },
  {
    "idx": 2680,
    "start": "01:11:32,472",
    "end": "01:11:35,072",
    "start_sec": 4292.472,
    "end_sec": 4295.072,
    "zh": "长子皮看着眼前的黑狗被吓一跳",
    "vi": "Trần Tử Bì nhìn chú chó đen trước mặt mà giật nảy mình."
  },
  {
    "idx": 2681,
    "start": "01:11:35,072",
    "end": "01:11:36,472",
    "start_sec": 4295.072,
    "end_sec": 4296.472,
    "zh": "许久才回回神来",
    "vi": "Mất một lúc lâu mới hoàn hồn lại."
  },
  {
    "idx": 2682,
    "start": "01:11:36,472",
    "end": "01:11:38,332",
    "start_sec": 4296.472,
    "end_sec": 4298.332,
    "zh": "你 你就是我买的狗",
    "vi": "Đây chính là con chó tôi mua sao."
  },
  {
    "idx": 2683,
    "start": "01:11:38,332",
    "end": "01:11:39,192",
    "start_sec": 4298.332,
    "end_sec": 4299.192,
    "zh": "怎么样",
    "vi": "Thế nào."
  },
  {
    "idx": 2684,
    "start": "01:11:39,192",
    "end": "01:11:40,272",
    "start_sec": 4299.192,
    "end_sec": 4300.272,
    "zh": "这狗怎么样",
    "vi": "Con chó này thế nào."
  },
  {
    "idx": 2685,
    "start": "01:11:40,272",
    "end": "01:11:41,012",
    "start_sec": 4300.272,
    "end_sec": 4301.012,
    "zh": "黑不黑",
    "vi": "Có đen không."
  },
  {
    "idx": 2686,
    "start": "01:11:41,012",
    "end": "01:11:42,132",
    "start_sec": 4301.012,
    "end_sec": 4302.132,
    "zh": "你叫小墨迹",
    "vi": "Tên là Tiểu Mặc Tích nhé."
  },
  {
    "idx": 2687,
    "start": "01:11:42,132",
    "end": "01:11:42,772",
    "start_sec": 4302.132,
    "end_sec": 4302.772,
    "zh": "黑",
    "vi": "Đen."
  },
  {
    "idx": 2688,
    "start": "01:11:42,772",
    "end": "01:11:44,112",
    "start_sec": 4302.772,
    "end_sec": 4304.112,
    "zh": "真他妈黑",
    "vi": "Đen thật đấy."
  },
  {
    "idx": 2689,
    "start": "01:11:44,112",
    "end": "01:11:48,492",
    "start_sec": 4304.112,
    "end_sec": 4308.492,
    "zh": "书阳",
    "vi": "Thư Dương."
  },
  {
    "idx": 2690,
    "start": "01:11:48,492",
    "end": "01:11:50,732",
    "start_sec": 4308.492,
    "end_sec": 4310.732,
    "zh": "橙子皮你有没有吃",
    "vi": "Trần Tử Bì bạn có sao không."
  },
  {
    "idx": 2691,
    "start": "01:11:50,732",
    "end": "01:11:52,352",
    "start_sec": 4310.732,
    "end_sec": 4312.352,
    "zh": "呵呵 太真实了",
    "vi": "Ha ha, thật quá đi mất."
  },
  {
    "idx": 2692,
    "start": "01:11:52,352",
    "end": "01:11:53,672",
    "start_sec": 4312.352,
    "end_sec": 4313.672,
    "zh": "果然没有人情才会灵雅",
    "vi": "Quả nhiên không có tình người thì mới linh nghiệm."
  },
  {
    "idx": 2693,
    "start": "01:11:53,672",
    "end": "01:11:55,472",
    "start_sec": 4313.672,
    "end_sec": 4315.472,
    "zh": "长子皮故意回了一句",
    "vi": "Trần Tử Bì cố ý trả lời một câu."
  },
  {
    "idx": 2694,
    "start": "01:11:55,472",
    "end": "01:11:57,092",
    "start_sec": 4315.472,
    "end_sec": 4317.092,
    "zh": "没事 多亏了小墨迹",
    "vi": "Không sao, nhờ có Tiểu Mặc Tích."
  },
  {
    "idx": 2695,
    "start": "01:11:57,092",
    "end": "01:11:58,332",
    "start_sec": 4317.092,
    "end_sec": 4318.332,
    "zh": "这狗居然可以比起爱",
    "vi": "Con chó này lại có thể tránh tà."
  },
  {
    "idx": 2696,
    "start": "01:11:58,332",
    "end": "01:12:01,172",
    "start_sec": 4318.332,
    "end_sec": 4321.172,
    "zh": "是啊 多亏你送我的狗",
    "vi": "Đúng vậy, nhờ con chó bạn tặng tôi."
  },
  {
    "idx": 2697,
    "start": "01:12:01,172",
    "end": "01:12:02,972",
    "start_sec": 4321.172,
    "end_sec": 4322.972,
    "zh": "我这一路都有惊无险的",
    "vi": "Suốt dọc đường tôi đều gặp nguy nhưng không sao."
  },
  {
    "idx": 2698,
    "start": "01:12:02,972",
    "end": "01:12:03,912",
    "start_sec": 4322.972,
    "end_sec": 4323.912,
    "zh": "你没事就好",
    "vi": "Bạn không sao là tốt rồi."
  },
  {
    "idx": 2699,
    "start": "01:12:03,912",
    "end": "01:12:05,432",
    "start_sec": 4323.912,
    "end_sec": 4325.432,
    "zh": "你那边目前怎么样了",
    "vi": "Bên phía bạn hiện tại thế nào rồi."
  },
  {
    "idx": 2700,
    "start": "01:12:05,432",
    "end": "01:12:07,112",
    "start_sec": 4325.432,
    "end_sec": 4327.112,
    "zh": "一路有惊无险",
    "vi": "Dọc đường gặp nguy nhưng không sao."
  },
  {
    "idx": 2701,
    "start": "01:12:07,112",
    "end": "01:12:09,252",
    "start_sec": 4327.112,
    "end_sec": 4329.252,
    "zh": "朱公子 你是出了临江市吗",
    "vi": "Chung công tử, anh đã ra khỏi thành phố Lâm Giang chưa."
  },
  {
    "idx": 2702,
    "start": "01:12:09,252",
    "end": "01:12:11,872",
    "start_sec": 4329.252,
    "end_sec": 4331.872,
    "zh": "对 有搜救队提前来了",
    "vi": "Rồi, có đội cứu hộ đến trước."
  },
  {
    "idx": 2703,
    "start": "01:12:11,872",
    "end": "01:12:13,592",
    "start_sec": 4331.872,
    "end_sec": 4333.592,
    "zh": "但城市里诡异太多",
    "vi": "Nhưng trong thành phố có quá nhiều thứ kỳ lạ."
  },
  {
    "idx": 2704,
    "start": "01:12:13,592",
    "end": "01:12:14,572",
    "start_sec": 4333.592,
    "end_sec": 4334.572,
    "zh": "仗着你的黑狗",
    "vi": "Nhờ con chó đen của bạn."
  },
  {
    "idx": 2705,
    "start": "01:12:14,572",
    "end": "01:12:16,792",
    "start_sec": 4334.572,
    "end_sec": 4336.792,
    "zh": "我们一家平安出了临江市",
    "vi": "Cả gia đình tôi đã bình an ra khỏi thành phố Lâm Giang."
  },
  {
    "idx": 2706,
    "start": "01:12:16,792",
    "end": "01:12:19,652",
    "start_sec": 4336.792,
    "end_sec": 4339.652,
    "zh": "在临江市外南城河有一艘大船",
    "vi": "Bên ngoài thành phố Lâm Giang, ở sông Nam Thành có một con thuyền lớn."
  },
  {
    "idx": 2707,
    "start": "01:12:19,652",
    "end": "01:12:21,132",
    "start_sec": 4339.652,
    "end_sec": 4341.132,
    "zh": "是暂时的安置地点",
    "vi": "Đó là nơi tạm trú."
  },
  {
    "idx": 2708,
    "start": "01:12:21,132",
    "end": "01:12:22,552",
    "start_sec": 4341.132,
    "end_sec": 4342.552,
    "zh": "这里有很特殊的人",
    "vi": "Ở đây có những người rất đặc biệt."
  },
  {
    "idx": 2709,
    "start": "01:12:22,552",
    "end": "01:12:24,032",
    "start_sec": 4342.552,
    "end_sec": 4344.032,
    "zh": "负责保护我们的安全",
    "vi": "Chịu trách nhiệm bảo vệ an toàn cho chúng tôi."
  },
  {
    "idx": 2710,
    "start": "01:12:24,032",
    "end": "01:12:25,632",
    "start_sec": 4344.032,
    "end_sec": 4345.632,
    "zh": "船会开向京市附近",
    "vi": "Con thuyền sẽ đi về phía Kinh Thị."
  },
  {
    "idx": 2711,
    "start": "01:12:25,632",
    "end": "01:12:28,072",
    "start_sec": 4345.632,
    "end_sec": 4348.072,
    "zh": "据说那里有更安全的避难所",
    "vi": "Nghe nói ở đó có nơi trú ẩn an toàn hơn."
  },
  {
    "idx": 2712,
    "start": "01:12:28,072",
    "end": "01:12:29,952",
    "start_sec": 4348.072,
    "end_sec": 4349.952,
    "zh": "很特殊的人",
    "vi": "Những người rất đặc biệt."
  },
  {
    "idx": 2713,
    "start": "01:12:29,952",
    "end": "01:12:32,132",
    "start_sec": 4349.952,
    "end_sec": 4352.132,
    "zh": "嗯 我不好多说",
    "vi": "Ừm, tôi không tiện nói nhiều."
  },
  {
    "idx": 2714,
    "start": "01:12:32,132",
    "end": "01:12:33,592",
    "start_sec": 4352.132,
    "end_sec": 4353.592,
    "zh": "总之谢谢你的狗",
    "vi": "Dù sao cũng cảm ơn con chó của bạn."
  },
  {
    "idx": 2715,
    "start": "01:12:33,592",
    "end": "01:12:34,472",
    "start_sec": 4353.592,
    "end_sec": 4354.472,
    "zh": "作为回报",
    "vi": "Đổi lại."
  },
  {
    "idx": 2716,
    "start": "01:12:34,472",
    "end": "01:12:36,052",
    "start_sec": 4354.472,
    "end_sec": 4356.052,
    "zh": "我可以告诉你一条情报",
    "vi": "Tôi có thể cho bạn một tin tức."
  },
  {
    "idx": 2717,
    "start": "01:12:36,052",
    "end": "01:12:37,612",
    "start_sec": 4356.052,
    "end_sec": 4357.612,
    "zh": "如果你能去到永德寺",
    "vi": "Nếu bạn có thể đến chùa Vĩnh Đức."
  },
  {
    "idx": 2718,
    "start": "01:12:37,612",
    "end": "01:12:39,492",
    "start_sec": 4357.612,
    "end_sec": 4359.492,
    "zh": "那里还有最后一批撤离队",
    "vi": "Ở đó còn có nhóm rút lui cuối cùng."
  },
  {
    "idx": 2719,
    "start": "01:12:39,492",
    "end": "01:12:40,432",
    "start_sec": 4359.492,
    "end_sec": 4360.432,
    "zh": "赶上的话",
    "vi": "Nếu kịp."
  },
  {
    "idx": 2720,
    "start": "01:12:40,432",
    "end": "01:12:42,092",
    "start_sec": 4360.432,
    "end_sec": 4362.092,
    "zh": "应该能和撤离队一起走",
    "vi": "Bạn có thể đi cùng nhóm rút lui."
  },
  {
    "idx": 2721,
    "start": "01:12:42,092",
    "end": "01:12:43,132",
    "start_sec": 4362.092,
    "end_sec": 4363.132,
    "zh": "你务必记得",
    "vi": "Bạn nhất định phải nhớ."
  },
  {
    "idx": 2722,
    "start": "01:12:43,132",
    "end": "01:12:44,752",
    "start_sec": 4363.132,
    "end_sec": 4364.752,
    "zh": "城市里面还有很多诡异",
    "vi": "Trong thành phố còn rất nhiều thứ kỳ lạ."
  },
  {
    "idx": 2723,
    "start": "01:12:44,752",
    "end": "01:12:47,152",
    "start_sec": 4364.752,
    "end_sec": 4367.152,
    "zh": "甚至存在黑狗都无法镇压的诡异",
    "vi": "Thậm chí có những thứ kỳ lạ mà chó đen cũng không trấn áp được."
  },
  {
    "idx": 2724,
    "start": "01:12:47,152",
    "end": "01:12:48,612",
    "start_sec": 4367.152,
    "end_sec": 4368.612,
    "zh": "明白了 谢谢",
    "vi": "Tôi hiểu rồi, cảm ơn."
  },
  {
    "idx": 2725,
    "start": "01:12:48,612",
    "end": "01:12:51,572",
    "start_sec": 4368.612,
    "end_sec": 4371.572,
    "zh": "永德寺距离我至少说几十公里",
    "vi": "Chùa Vĩnh Đức cách tôi ít nhất vài chục cây số."
  },
  {
    "idx": 2726,
    "start": "01:12:51,572",
    "end": "01:12:53,472",
    "start_sec": 4371.572,
    "end_sec": 4373.472,
    "zh": "出去的话需要规划下路线",
    "vi": "Ra ngoài cần lên kế hoạch tuyến đường."
  },
  {
    "idx": 2727,
    "start": "01:12:53,472",
    "end": "01:12:54,552",
    "start_sec": 4373.472,
    "end_sec": 4374.552,
    "zh": "最好是有辆车",
    "vi": "Tốt nhất là có xe."
  },
  {
    "idx": 2728,
    "start": "01:12:54,552",
    "end": "01:12:55,732",
    "start_sec": 4374.552,
    "end_sec": 4375.732,
    "zh": "而且要白天出行",
    "vi": "Và phải đi ban ngày."
  },
  {
    "idx": 2729,
    "start": "01:12:55,732",
    "end": "01:12:57,052",
    "start_sec": 4375.732,
    "end_sec": 4377.052,
    "zh": "像枪门鬼这样的存在",
    "vi": "Những thứ như Quỷ Môn Quan."
  },
  {
    "idx": 2730,
    "start": "01:12:57,052",
    "end": "01:12:58,032",
    "start_sec": 4377.052,
    "end_sec": 4378.032,
    "zh": "白天都消失了",
    "vi": "Ban ngày cũng biến mất."
  },
  {
    "idx": 2731,
    "start": "01:12:58,032",
    "end": "01:12:59,232",
    "start_sec": 4378.032,
    "end_sec": 4379.232,
    "zh": "至少白天出现的鬼异",
    "vi": "Ít nhất thì những hiện tượng kỳ dị xuất hiện vào ban ngày"
  },
  {
    "idx": 2732,
    "start": "01:12:59,232",
    "end": "01:13:00,252",
    "start_sec": 4379.232,
    "end_sec": 4380.252,
    "zh": "一定比晚上要熟",
    "vi": "chắc chắn sẽ ít hơn so với ban đêm."
  },
  {
    "idx": 2733,
    "start": "01:13:00,252",
    "end": "01:13:02,392",
    "start_sec": 4380.252,
    "end_sec": 4382.392,
    "zh": "已经第三天了",
    "vi": "Đã là ngày thứ ba rồi."
  },
  {
    "idx": 2734,
    "start": "01:13:02,392",
    "end": "01:13:03,612",
    "start_sec": 4382.392,
    "end_sec": 4383.612,
    "zh": "我该出去看看了",
    "vi": "Mình nên ra ngoài xem thử thế nào."
  },
  {
    "idx": 2735,
    "start": "01:13:03,612",
    "end": "01:13:07,192",
    "start_sec": 4383.612,
    "end_sec": 4387.192,
    "zh": "装了点食物后",
    "vi": "Sau khi chuẩn bị một ít thức ăn"
  },
  {
    "idx": 2736,
    "start": "01:13:07,192",
    "end": "01:13:09,532",
    "start_sec": 4387.192,
    "end_sec": 4389.532,
    "zh": "橙子皮掀着小墨迹走出房门",
    "vi": "Trần Tử Bì dắt Tiểu Mặc Tích bước ra khỏi cửa phòng."
  },
  {
    "idx": 2737,
    "start": "01:13:09,532",
    "end": "01:13:12,812",
    "start_sec": 4389.532,
    "end_sec": 4392.812,
    "zh": "英明是自鬼异降临以来第一次出门",
    "vi": "Đây là lần đầu tiên Anh Minh ra ngoài kể từ khi hiện tượng kỳ dị xuất hiện."
  },
  {
    "idx": 2738,
    "start": "01:13:12,812",
    "end": "01:13:14,092",
    "start_sec": 4392.812,
    "end_sec": 4394.092,
    "zh": "他却无比淡定",
    "vi": "Nhưng anh ấy lại vô cùng bình tĩnh."
  },
  {
    "idx": 2739,
    "start": "01:13:14,092",
    "end": "01:13:16,152",
    "start_sec": 4394.092,
    "end_sec": 4396.152,
    "zh": "身上有香炉",
    "vi": "Trên người có lư hương"
  },
  {
    "idx": 2740,
    "start": "01:13:16,152",
    "end": "01:13:17,152",
    "start_sec": 4396.152,
    "end_sec": 4397.152,
    "zh": "手边有黑狗",
    "vi": "bên cạnh có chó đen."
  },
  {
    "idx": 2741,
    "start": "01:13:17,152",
    "end": "01:13:18,452",
    "start_sec": 4397.152,
    "end_sec": 4398.452,
    "zh": "在小区附近转转",
    "vi": "Đi dạo quanh khu chung cư"
  },
  {
    "idx": 2742,
    "start": "01:13:18,452",
    "end": "01:13:19,532",
    "start_sec": 4398.452,
    "end_sec": 4399.532,
    "zh": "应该没问题吧",
    "vi": "chắc là không có vấn đề gì đâu."
  },
  {
    "idx": 2743,
    "start": "01:13:19,532",
    "end": "01:13:20,852",
    "start_sec": 4399.532,
    "end_sec": 4400.852,
    "zh": "你们看",
    "vi": "Các bạn nhìn kìa"
  },
  {
    "idx": 2744,
    "start": "01:13:20,852",
    "end": "01:13:22,072",
    "start_sec": 4400.852,
    "end_sec": 4402.072,
    "zh": "又有人出门了",
    "vi": "lại có người ra ngoài rồi."
  },
  {
    "idx": 2745,
    "start": "01:13:22,072",
    "end": "01:13:22,452",
    "start_sec": 4402.072,
    "end_sec": 4402.452,
    "zh": "好",
    "vi": "Ồ"
  },
  {
    "idx": 2746,
    "start": "01:13:22,452",
    "end": "01:13:23,412",
    "start_sec": 4402.452,
    "end_sec": 4403.412,
    "zh": "他也有黑狗",
    "vi": "anh ta cũng có chó đen kìa."
  },
  {
    "idx": 2747,
    "start": "01:13:23,412",
    "end": "01:13:25,592",
    "start_sec": 4403.412,
    "end_sec": 4405.592,
    "zh": "这是小区里寄昨天那个女孩的",
    "vi": "Đây là người nuôi chó thứ hai trong khu chung cư"
  },
  {
    "idx": 2748,
    "start": "01:13:25,592",
    "end": "01:13:26,652",
    "start_sec": 4405.592,
    "end_sec": 4406.652,
    "zh": "第二个狗大户了",
    "vi": "sau cô gái ngày hôm qua."
  },
  {
    "idx": 2749,
    "start": "01:13:26,652",
    "end": "01:13:27,412",
    "start_sec": 4406.652,
    "end_sec": 4407.412,
    "zh": "帅哥",
    "vi": "Anh đẹp trai ơi"
  },
  {
    "idx": 2750,
    "start": "01:13:27,412",
    "end": "01:13:28,152",
    "start_sec": 4407.412,
    "end_sec": 4408.152,
    "zh": "再带我呗",
    "vi": "cho tôi đi cùng với."
  },
  {
    "idx": 2751,
    "start": "01:13:28,152",
    "end": "01:13:29,172",
    "start_sec": 4408.152,
    "end_sec": 4409.172,
    "zh": "我给你打下手",
    "vi": "Tôi sẽ làm phụ tá cho anh."
  },
  {
    "idx": 2752,
    "start": "01:13:29,172",
    "end": "01:13:30,532",
    "start_sec": 4409.172,
    "end_sec": 4410.532,
    "zh": "法令医生",
    "vi": "Bác sĩ pháp y"
  },
  {
    "idx": 2753,
    "start": "01:13:30,532",
    "end": "01:13:31,072",
    "start_sec": 4410.532,
    "end_sec": 4411.072,
    "zh": "罗杰",
    "vi": "La Kiệt"
  },
  {
    "idx": 2754,
    "start": "01:13:31,072",
    "end": "01:13:31,692",
    "start_sec": 4411.072,
    "end_sec": 4411.692,
    "zh": "赵德柱",
    "vi": "Triệu Đức Trụ"
  },
  {
    "idx": 2755,
    "start": "01:13:31,692",
    "end": "01:13:32,692",
    "start_sec": 4411.692,
    "end_sec": 4412.692,
    "zh": "小白脸三人",
    "vi": "và gã mặt trắng, ba người bọn họ"
  },
  {
    "idx": 2756,
    "start": "01:13:32,692",
    "end": "01:13:33,812",
    "start_sec": 4412.692,
    "end_sec": 4413.812,
    "zh": "也被曹达生气",
    "vi": "cũng bị tiếng động làm cho chú ý."
  },
  {
    "idx": 2757,
    "start": "01:13:33,812",
    "end": "01:13:35,572",
    "start_sec": 4413.812,
    "end_sec": 4415.572,
    "zh": "他怎么也有黑狗啊",
    "vi": "Sao anh ta cũng có chó đen thế nhỉ."
  },
  {
    "idx": 2758,
    "start": "01:13:35,572",
    "end": "01:13:36,192",
    "start_sec": 4415.572,
    "end_sec": 4416.192,
    "zh": "他出去了",
    "vi": "Anh ta ra ngoài rồi"
  },
  {
    "idx": 2759,
    "start": "01:13:36,192",
    "end": "01:13:37,452",
    "start_sec": 4416.192,
    "end_sec": 4417.452,
    "zh": "是不是说明",
    "vi": "liệu có phải đồng nghĩa với việc"
  },
  {
    "idx": 2760,
    "start": "01:13:37,452",
    "end": "01:13:39,172",
    "start_sec": 4417.452,
    "end_sec": 4419.172,
    "zh": "他家里那个鬼不见了",
    "vi": "con quỷ trong nhà anh ta đã biến mất rồi không."
  },
  {
    "idx": 2761,
    "start": "01:13:39,172",
    "end": "01:13:39,652",
    "start_sec": 4419.172,
    "end_sec": 4419.652,
    "zh": "罗杰",
    "vi": "Roger."
  },
  {
    "idx": 2762,
    "start": "01:13:39,652",
    "end": "01:13:41,272",
    "start_sec": 4419.652,
    "end_sec": 4421.272,
    "zh": "我们也去便利店吧",
    "vi": "Chúng ta cũng đến cửa hàng tiện lợi đi."
  },
  {
    "idx": 2763,
    "start": "01:13:41,272",
    "end": "01:13:42,872",
    "start_sec": 4421.272,
    "end_sec": 4422.872,
    "zh": "昨天被那玩意吓的",
    "vi": "Hôm qua bị cái thứ đó dọa cho sợ khiếp vía."
  },
  {
    "idx": 2764,
    "start": "01:13:42,872",
    "end": "01:13:44,312",
    "start_sec": 4422.872,
    "end_sec": 4424.312,
    "zh": "我们都还没吃饭呢",
    "vi": "Chúng ta vẫn chưa ăn gì cả."
  },
  {
    "idx": 2765,
    "start": "01:13:44,312",
    "end": "01:13:44,872",
    "start_sec": 4424.312,
    "end_sec": 4424.872,
    "zh": "不急",
    "vi": "Không vội."
  },
  {
    "idx": 2766,
    "start": "01:13:44,872",
    "end": "01:13:46,152",
    "start_sec": 4424.872,
    "end_sec": 4426.152,
    "zh": "先看看他要干嘛",
    "vi": "Trước tiên hãy xem anh ta muốn làm gì."
  },
  {
    "idx": 2767,
    "start": "01:13:46,152",
    "end": "01:13:47,992",
    "start_sec": 4426.152,
    "end_sec": 4427.992,
    "zh": "他要是有打便利店的主意",
    "vi": "Nếu anh ta có ý định nhắm vào cửa hàng tiện lợi."
  },
  {
    "idx": 2768,
    "start": "01:13:47,992",
    "end": "01:13:49,292",
    "start_sec": 4427.992,
    "end_sec": 4429.292,
    "zh": "找人帮忙搬东西",
    "vi": "Và tìm người giúp chuyển đồ."
  },
  {
    "idx": 2769,
    "start": "01:13:49,292",
    "end": "01:13:51,472",
    "start_sec": 4429.292,
    "end_sec": 4431.472,
    "zh": "咱们出去和他说好东西五五分",
    "vi": "Chúng ta sẽ ra ngoài thương lượng chia đôi đồ tốt với anh ta."
  },
  {
    "idx": 2770,
    "start": "01:13:51,472",
    "end": "01:13:53,432",
    "start_sec": 4431.472,
    "end_sec": 4433.432,
    "zh": "他要是一个人去搬东西的话",
    "vi": "Còn nếu anh ta tự đi chuyển đồ một mình."
  },
  {
    "idx": 2771,
    "start": "01:13:53,432",
    "end": "01:13:55,412",
    "start_sec": 4433.432,
    "end_sec": 4435.412,
    "zh": "那我们可以去抢他的狗",
    "vi": "Thì chúng ta có thể đến cướp chó của anh ta."
  },
  {
    "idx": 2772,
    "start": "01:13:55,412",
    "end": "01:13:56,492",
    "start_sec": 4435.412,
    "end_sec": 4436.492,
    "zh": "两只黑狗",
    "vi": "Hai con chó đen đó."
  },
  {
    "idx": 2773,
    "start": "01:13:56,492",
    "end": "01:13:58,392",
    "start_sec": 4436.492,
    "end_sec": 4438.392,
    "zh": "不过我们占领这个小区了",
    "vi": "Nhưng chúng ta đã chiếm khu chung cư này rồi."
  },
  {
    "idx": 2774,
    "start": "01:13:58,392",
    "end": "01:13:59,632",
    "start_sec": 4438.392,
    "end_sec": 4439.632,
    "zh": "长子皮知道",
    "vi": "Trương Tử Bì biết rõ."
  },
  {
    "idx": 2775,
    "start": "01:13:59,632",
    "end": "01:14:02,512",
    "start_sec": 4439.632,
    "end_sec": 4442.512,
    "zh": "此时定然有很多羡慕嫉妒恨的目光盯着他",
    "vi": "Lúc này chắc chắn có rất nhiều ánh mắt ghen tị và căm ghét đang chằm chằm nhìn vào mình."
  },
  {
    "idx": 2776,
    "start": "01:14:02,512",
    "end": "01:14:04,452",
    "start_sec": 4442.512,
    "end_sec": 4444.452,
    "zh": "有声看起了附近楼层",
    "vi": "Anh ta nhìn lên các tầng lầu gần đó."
  },
  {
    "idx": 2777,
    "start": "01:14:04,452",
    "end": "01:14:05,092",
    "start_sec": 4444.452,
    "end_sec": 4445.092,
    "zh": "所有人",
    "vi": "Mọi người nghe đây."
  },
  {
    "idx": 2778,
    "start": "01:14:05,092",
    "end": "01:14:05,952",
    "start_sec": 4445.092,
    "end_sec": 4445.952,
    "zh": "我宣布个事",
    "vi": "Tôi xin thông báo một việc."
  },
  {
    "idx": 2779,
    "start": "01:14:05,952",
    "end": "01:14:07,312",
    "start_sec": 4445.952,
    "end_sec": 4447.312,
    "zh": "我要让马尔的骑车",
    "vi": "Tôi cần một chiếc xe điện."
  },
  {
    "idx": 2780,
    "start": "01:14:07,312",
    "end": "01:14:08,152",
    "start_sec": 4447.312,
    "end_sec": 4448.152,
    "zh": "你们谁有",
    "vi": "Ai trong số các bạn có."
  },
  {
    "idx": 2781,
    "start": "01:14:08,152",
    "end": "01:14:09,172",
    "start_sec": 4448.152,
    "end_sec": 4449.172,
    "zh": "把车要给我",
    "vi": "Hãy đưa chìa khóa xe cho tôi."
  },
  {
    "idx": 2782,
    "start": "01:14:09,172",
    "end": "01:14:10,312",
    "start_sec": 4449.172,
    "end_sec": 4450.312,
    "zh": "我给你们几天的食物",
    "vi": "Tôi sẽ đưa cho các bạn thức ăn đủ dùng trong vài ngày."
  },
  {
    "idx": 2783,
    "start": "01:14:10,312",
    "end": "01:14:12,332",
    "start_sec": 4450.312,
    "end_sec": 4452.332,
    "zh": "长子皮的声音响射小区",
    "vi": "Giọng của Trương Tử Bì vang vọng khắp khu chung cư."
  },
  {
    "idx": 2784,
    "start": "01:14:12,332",
    "end": "01:14:13,092",
    "start_sec": 4452.332,
    "end_sec": 4453.092,
    "zh": "片刻后",
    "vi": "Một lát sau."
  },
  {
    "idx": 2785,
    "start": "01:14:13,092",
    "end": "01:14:15,812",
    "start_sec": 4453.092,
    "end_sec": 4455.812,
    "zh": "安静的小区响起恐怖的喧闹",
    "vi": "Khu chung cư đang yên tĩnh bỗng vang lên những tiếng ồn ào náo nhiệt."
  },
  {
    "idx": 2786,
    "start": "01:14:15,812",
    "end": "01:14:17,792",
    "start_sec": 4455.812,
    "end_sec": 4457.792,
    "zh": "我比压地马尔",
    "vi": "Tôi có xe điện đây."
  },
  {
    "idx": 2787,
    "start": "01:14:17,792",
    "end": "01:14:19,352",
    "start_sec": 4457.792,
    "end_sec": 4459.352,
    "zh": "就在小区停车场",
    "vi": "Nó đang ở ngay bãi đỗ xe của khu chung cư."
  },
  {
    "idx": 2788,
    "start": "01:14:19,352",
    "end": "01:14:20,672",
    "start_sec": 4459.352,
    "end_sec": 4460.672,
    "zh": "小哥",
    "vi": "Này cậu em."
  },
  {
    "idx": 2789,
    "start": "01:14:20,672",
    "end": "01:14:21,372",
    "start_sec": 4460.672,
    "end_sec": 4461.372,
    "zh": "看看我",
    "vi": "Hãy nhìn tôi này."
  },
  {
    "idx": 2790,
    "start": "01:14:21,372",
    "end": "01:14:22,312",
    "start_sec": 4461.372,
    "end_sec": 4462.312,
    "zh": "我的春思大志",
    "vi": "Xe của tôi xịn lắm."
  },
  {
    "idx": 2791,
    "start": "01:14:22,312",
    "end": "01:14:23,692",
    "start_sec": 4462.312,
    "end_sec": 4463.692,
    "zh": "又算性能友好吗",
    "vi": "Thế hiệu năng có ổn không."
  },
  {
    "idx": 2792,
    "start": "01:14:23,692",
    "end": "01:14:24,272",
    "start_sec": 4463.692,
    "end_sec": 4464.272,
    "zh": "行",
    "vi": "Được."
  },
  {
    "idx": 2793,
    "start": "01:14:24,272",
    "end": "01:14:24,972",
    "start_sec": 4464.272,
    "end_sec": 4464.972,
    "zh": "救你了",
    "vi": "Cứu cậu đây."
  },
  {
    "idx": 2794,
    "start": "01:14:24,972",
    "end": "01:14:25,532",
    "start_sec": 4464.972,
    "end_sec": 4465.532,
    "zh": "大志",
    "vi": "Đại Chí."
  },
  {
    "idx": 2795,
    "start": "01:14:25,532",
    "end": "01:14:27,012",
    "start_sec": 4465.532,
    "end_sec": 4467.012,
    "zh": "小伙子",
    "vi": "Cậu em ơi."
  },
  {
    "idx": 2796,
    "start": "01:14:27,012",
    "end": "01:14:28,372",
    "start_sec": 4467.012,
    "end_sec": 4468.372,
    "zh": "小伙子",
    "vi": "Cậu em ơi."
  },
  {
    "idx": 2797,
    "start": "01:14:28,372",
    "end": "01:14:29,712",
    "start_sec": 4468.372,
    "end_sec": 4469.712,
    "zh": "求求你",
    "vi": "Xin cậu đấy."
  },
  {
    "idx": 2798,
    "start": "01:14:29,712",
    "end": "01:14:30,872",
    "start_sec": 4469.712,
    "end_sec": 4470.872,
    "zh": "求求你了",
    "vi": "Tôi xin cậu đấy."
  },
  {
    "idx": 2799,
    "start": "01:14:30,872",
    "end": "01:14:31,652",
    "start_sec": 4470.872,
    "end_sec": 4471.652,
    "zh": "我老伴",
    "vi": "Vợ tôi."
  },
  {
    "idx": 2800,
    "start": "01:14:31,652",
    "end": "01:14:33,692",
    "start_sec": 4471.652,
    "end_sec": 4473.692,
    "zh": "已经两天没吃东西",
    "vi": "Đã hai ngày không ăn gì rồi."
  },
  {
    "idx": 2801,
    "start": "01:14:33,692",
    "end": "01:14:35,152",
    "start_sec": 4473.692,
    "end_sec": 4475.152,
    "zh": "快顶不住了",
    "vi": "Bà ấy sắp không trụ nổi nữa."
  },
  {
    "idx": 2802,
    "start": "01:14:35,152",
    "end": "01:14:36,412",
    "start_sec": 4475.152,
    "end_sec": 4476.412,
    "zh": "能不能麻烦你",
    "vi": "Liệu có thể làm phiền cậu."
  },
  {
    "idx": 2803,
    "start": "01:14:36,412",
    "end": "01:14:38,252",
    "start_sec": 4476.412,
    "end_sec": 4478.252,
    "zh": "麻烦你给我点吃的",
    "vi": "Làm phiền cậu cho tôi chút đồ ăn."
  },
  {
    "idx": 2804,
    "start": "01:14:38,252",
    "end": "01:14:40,292",
    "start_sec": 4478.252,
    "end_sec": 4480.292,
    "zh": "看那老头面黄鸡瘦的模样",
    "vi": "Nhìn ông lão mặt vàng vọt gầy gò đó kìa."
  },
  {
    "idx": 2805,
    "start": "01:14:40,292",
    "end": "01:14:40,912",
    "start_sec": 4480.292,
    "end_sec": 4480.912,
    "zh": "疼死你",
    "vi": "Đau chết cậu."
  },
  {
    "idx": 2806,
    "start": "01:14:40,912",
    "end": "01:14:41,532",
    "start_sec": 4480.912,
    "end_sec": 4481.532,
    "zh": "有点疼",
    "vi": "Hơi đau một chút."
  },
  {
    "idx": 2807,
    "start": "01:14:41,532",
    "end": "01:14:42,852",
    "start_sec": 4481.532,
    "end_sec": 4482.852,
    "zh": "大爷",
    "vi": "Ông ơi."
  },
  {
    "idx": 2808,
    "start": "01:14:42,852",
    "end": "01:14:43,572",
    "start_sec": 4482.852,
    "end_sec": 4483.572,
    "zh": "你什么事",
    "vi": "Ông có chuyện gì thế."
  },
  {
    "idx": 2809,
    "start": "01:14:43,572",
    "end": "01:14:44,532",
    "start_sec": 4483.572,
    "end_sec": 4484.532,
    "zh": "我",
    "vi": "Tôi."
  },
  {
    "idx": 2810,
    "start": "01:14:44,532",
    "end": "01:14:46,772",
    "start_sec": 4484.532,
    "end_sec": 4486.772,
    "zh": "我武林红光小面包",
    "vi": "Tôi có chiếc xe tải nhỏ Wuling Hongguang."
  },
  {
    "idx": 2811,
    "start": "01:14:46,772",
    "end": "01:14:48,712",
    "start_sec": 4486.772,
    "end_sec": 4488.712,
    "zh": "小伙子求求你",
    "vi": "Cậu em ơi xin cậu đấy."
  },
  {
    "idx": 2812,
    "start": "01:14:48,712",
    "end": "01:14:50,732",
    "start_sec": 4488.712,
    "end_sec": 4490.732,
    "zh": "救救我老伴吧",
    "vi": "Hãy cứu vợ tôi với."
  },
  {
    "idx": 2813,
    "start": "01:14:50,732",
    "end": "01:14:52,132",
    "start_sec": 4490.732,
    "end_sec": 4492.132,
    "zh": "算了",
    "vi": "Thôi được rồi."
  },
  {
    "idx": 2814,
    "start": "01:14:52,132",
    "end": "01:14:53,612",
    "start_sec": 4492.132,
    "end_sec": 4493.612,
    "zh": "武林红光就武林红光吧",
    "vi": "Wuling Hongguang thì Wuling Hongguang vậy."
  },
  {
    "idx": 2815,
    "start": "01:14:53,612",
    "end": "01:14:54,752",
    "start_sec": 4493.612,
    "end_sec": 4494.752,
    "zh": "至少能多拿点东西",
    "vi": "Ít nhất cũng chở được nhiều đồ hơn."
  },
  {
    "idx": 2816,
    "start": "01:14:54,752",
    "end": "01:14:59,126",
    "start_sec": 4494.752,
    "end_sec": 4499.126,
    "zh": "老大爷文生也会小伙子车钥匙你接着大爷你不怕我跑了顿小伙子,车钥匙你接着大爷,你不怕我跑了呀小伙子,我相信你那行,大爷你认真绳子下来",
    "vi": "Ông lão ơi, cậu em cầm lấy chìa khóa xe đi"
  },
  {
    "idx": 2816,
    "start": "01:14:59,126",
    "end": "01:15:01,909",
    "start_sec": 4499.126,
    "end_sec": 4501.909,
    "zh": "老大爷文生也会小伙子车钥匙你接着大爷你不怕我跑了顿小伙子,车钥匙你接着大爷,你不怕我跑了呀小伙子,我相信你那行,大爷你认真绳子下来",
    "vi": "Ông không sợ tôi chạy mất à"
  },
  {
    "idx": 2816,
    "start": "01:15:01,909",
    "end": "01:15:04,295",
    "start_sec": 4501.909,
    "end_sec": 4504.295,
    "zh": "老大爷文生也会小伙子车钥匙你接着大爷你不怕我跑了顿小伙子,车钥匙你接着大爷,你不怕我跑了呀小伙子,我相信你那行,大爷你认真绳子下来",
    "vi": "Cậu em ơi, tôi tin cậu"
  },
  {
    "idx": 2816,
    "start": "01:15:04,295",
    "end": "01:15:07,078",
    "start_sec": 4504.295,
    "end_sec": 4507.078,
    "zh": "老大爷文生也会小伙子车钥匙你接着大爷你不怕我跑了顿小伙子,车钥匙你接着大爷,你不怕我跑了呀小伙子,我相信你那行,大爷你认真绳子下来",
    "vi": "Được rồi, ông thả dây xuống đi"
  },
  {
    "idx": 2817,
    "start": "01:15:07,078",
    "end": "01:15:08,998",
    "start_sec": 4507.078,
    "end_sec": 4508.998,
    "zh": "我给你拴两箱方便面,你拉上去",
    "vi": "Tôi buộc hai thùng mì tôm vào cho ông kéo lên."
  },
  {
    "idx": 2818,
    "start": "01:15:08,998",
    "end": "01:15:11,398",
    "start_sec": 4508.998,
    "end_sec": 4511.398,
    "zh": "你,你不送上来啊",
    "vi": "Cậu, cậu không mang lên tận nơi à."
  },
  {
    "idx": 2819,
    "start": "01:15:11,398",
    "end": "01:15:13,698",
    "start_sec": 4511.398,
    "end_sec": 4513.698,
    "zh": "那可不行,恐怕只要我走进这栋楼",
    "vi": "Thế thì không được đâu, e là chỉ cần tôi bước vào tòa nhà đó."
  },
  {
    "idx": 2820,
    "start": "01:15:13,698",
    "end": "01:15:15,698",
    "start_sec": 4513.698,
    "end_sec": 4515.698,
    "zh": "估计被抢的毛都不剩了",
    "vi": "Chắc là bị cướp sạch không còn một cọng lông."
  },
  {
    "idx": 2821,
    "start": "01:15:15,698",
    "end": "01:15:21,778",
    "start_sec": 4515.698,
    "end_sec": 4521.778,
    "zh": "拴好了,你拉上去吧,我走了",
    "vi": "Buộc xong rồi, ông kéo lên đi, cháu đi đây."
  },
  {
    "idx": 2822,
    "start": "01:15:21,778",
    "end": "01:15:23,638",
    "start_sec": 4521.778,
    "end_sec": 4523.638,
    "zh": "谢谢了小伙子",
    "vi": "Cảm ơn cháu nhé chàng trai."
  },
  {
    "idx": 2823,
    "start": "01:15:23,638",
    "end": "01:15:27,018",
    "start_sec": 4523.638,
    "end_sec": 4527.018,
    "zh": "车就在小区外马路边停着",
    "vi": "Xe đang đỗ ở ngay bên lề đường ngoài khu chung cư."
  },
  {
    "idx": 2824,
    "start": "01:15:27,018",
    "end": "01:15:32,358",
    "start_sec": 4527.018,
    "end_sec": 4532.358,
    "zh": "杨太太方便面就要被拉到大爷的窗口",
    "vi": "Mì ăn liền của bà Dương sắp được kéo đến cửa sổ của ông lão."
  },
  {
    "idx": 2825,
    "start": "01:15:32,358",
    "end": "01:15:35,238",
    "start_sec": 4532.358,
    "end_sec": 4535.238,
    "zh": "突然对农舍的大妈一把暴力小气力忙了",
    "vi": "Bỗng nhiên một bà thím ở tầng dưới dùng sức giật mạnh lấy."
  },
  {
    "idx": 2826,
    "start": "01:15:35,238",
    "end": "01:15:37,038",
    "start_sec": 4535.238,
    "end_sec": 4537.038,
    "zh": "这是我买的",
    "vi": "Đây là đồ tôi mua mà."
  },
  {
    "idx": 2827,
    "start": "01:15:37,038",
    "end": "01:15:38,478",
    "start_sec": 4537.038,
    "end_sec": 4538.478,
    "zh": "你抢什么",
    "vi": "Bà cướp cái gì thế."
  },
  {
    "idx": 2828,
    "start": "01:15:38,478",
    "end": "01:15:40,458",
    "start_sec": 4538.478,
    "end_sec": 4540.458,
    "zh": "谁说这是你的了",
    "vi": "Ai bảo đây là của ông chứ."
  },
  {
    "idx": 2829,
    "start": "01:15:40,458",
    "end": "01:15:42,118",
    "start_sec": 4540.458,
    "end_sec": 4542.118,
    "zh": "这从我家窗户前挑过",
    "vi": "Nó đi ngang qua cửa sổ nhà tôi."
  },
  {
    "idx": 2830,
    "start": "01:15:42,118",
    "end": "01:15:43,298",
    "start_sec": 4542.118,
    "end_sec": 4543.298,
    "zh": "就不能是我的",
    "vi": "Thì sao không thể là của tôi được chứ."
  },
  {
    "idx": 2831,
    "start": "01:15:43,298",
    "end": "01:15:45,438",
    "start_sec": 4543.298,
    "end_sec": 4545.438,
    "zh": "畜生啊畜生",
    "vi": "Đồ súc sinh, thật là súc sinh mà."
  },
  {
    "idx": 2832,
    "start": "01:15:45,438",
    "end": "01:15:48,718",
    "start_sec": 4545.438,
    "end_sec": 4548.718,
    "zh": "那是我和老伴救命的口粮啊",
    "vi": "Đó là lương thực cứu mạng của tôi và nhà tôi mà."
  },
  {
    "idx": 2833,
    "start": "01:15:48,718",
    "end": "01:15:50,678",
    "start_sec": 4548.718,
    "end_sec": 4550.678,
    "zh": "一时间的呼声和笑声交流",
    "vi": "Trong chốc lát, tiếng khóc và tiếng cười lẫn lộn vào nhau."
  },
  {
    "idx": 2834,
    "start": "01:15:50,678",
    "end": "01:15:51,938",
    "start_sec": 4550.678,
    "end_sec": 4551.938,
    "zh": "响彻整个小区",
    "vi": "Vang vọng khắp cả khu chung cư."
  },
  {
    "idx": 2835,
    "start": "01:15:51,938",
    "end": "01:15:54,578",
    "start_sec": 4551.938,
    "end_sec": 4554.578,
    "zh": "身处末世几乎没人对此感到悲哀",
    "vi": "Sống trong thời mạt thế, hầu như không ai cảm thấy đau buồn vì điều này."
  },
  {
    "idx": 2836,
    "start": "01:15:54,578",
    "end": "01:15:55,618",
    "start_sec": 4554.578,
    "end_sec": 4555.618,
    "zh": "更多的是羡慕",
    "vi": "Mà phần lớn là sự ghen tị."
  },
  {
    "idx": 2837,
    "start": "01:15:55,618",
    "end": "01:15:57,358",
    "start_sec": 4555.618,
    "end_sec": 4557.358,
    "zh": "羡慕大妈能抢到方便面",
    "vi": "Họ ghen tị vì bà thím kia cướp được mì ăn liền."
  },
  {
    "idx": 2838,
    "start": "01:15:57,358",
    "end": "01:16:02,898",
    "start_sec": 4557.358,
    "end_sec": 4562.898,
    "zh": "那小子出去了",
    "vi": "Thằng nhóc đó ra ngoài rồi."
  },
  {
    "idx": 2839,
    "start": "01:16:02,898",
    "end": "01:16:04,078",
    "start_sec": 4562.898,
    "end_sec": 4564.078,
    "zh": "胆挺肥啊",
    "vi": "Gan to gớm nhỉ."
  },
  {
    "idx": 2840,
    "start": "01:16:04,078",
    "end": "01:16:05,418",
    "start_sec": 4564.078,
    "end_sec": 4565.418,
    "zh": "居然敢出门",
    "vi": "Thế mà cũng dám ra ngoài đường."
  },
  {
    "idx": 2841,
    "start": "01:16:05,418",
    "end": "01:16:06,678",
    "start_sec": 4565.418,
    "end_sec": 4566.678,
    "zh": "以为有了黑狗",
    "vi": "Tưởng là có con chó đen."
  },
  {
    "idx": 2842,
    "start": "01:16:06,678",
    "end": "01:16:08,238",
    "start_sec": 4566.678,
    "end_sec": 4568.238,
    "zh": "就可以为所欲为了吗",
    "vi": "Thì muốn làm gì thì làm sao."
  },
  {
    "idx": 2843,
    "start": "01:16:08,238",
    "end": "01:16:10,238",
    "start_sec": 4568.238,
    "end_sec": 4570.238,
    "zh": "出去死在外面都是活该",
    "vi": "Chết ở bên ngoài cũng là đáng đời mày."
  },
  {
    "idx": 2844,
    "start": "01:16:10,238",
    "end": "01:16:11,338",
    "start_sec": 4570.238,
    "end_sec": 4571.338,
    "zh": "你死了",
    "vi": "Mày chết rồi."
  },
  {
    "idx": 2845,
    "start": "01:16:11,338",
    "end": "01:16:13,278",
    "start_sec": 4571.338,
    "end_sec": 4573.278,
    "zh": "店里店里的食物就全是我的",
    "vi": "Thì toàn bộ thức ăn trong cửa hàng sẽ là của tao."
  },
  {
    "idx": 2846,
    "start": "01:16:21,938",
    "end": "01:16:24,858",
    "start_sec": 4581.938,
    "end_sec": 4584.858,
    "zh": "小墨记,早,出发,有何事?",
    "vi": "Tiểu Mặc, chào buổi sáng, xuất phát thôi, có chuyện gì vậy."
  },
  {
    "idx": 2847,
    "start": "01:16:26,438",
    "end": "01:16:28,758",
    "start_sec": 4586.438,
    "end_sec": 4588.758,
    "zh": "橙子皮的视线透过车窗向外带,",
    "vi": "Ánh mắt của Trần Tử Bì nhìn ra ngoài qua cửa kính xe."
  },
  {
    "idx": 2848,
    "start": "01:16:29,138",
    "end": "01:16:31,638",
    "start_sec": 4589.138,
    "end_sec": 4591.638,
    "zh": "这座楼栋里不少人好奇地看见那楼舍,",
    "vi": "Nhiều người trong tòa nhà này tò mò nhìn về phía chiếc xe."
  },
  {
    "idx": 2849,
    "start": "01:16:32,058",
    "end": "01:16:34,458",
    "start_sec": 4592.058,
    "end_sec": 4594.458,
    "zh": "他把油门踩到,一路开着心惊胆战,",
    "vi": "Anh ta nhấn ga hết cỡ, vừa lái xe đi vừa vô cùng lo sợ."
  },
  {
    "idx": 2850,
    "start": "01:16:34,698",
    "end": "01:16:37,178",
    "start_sec": 4594.698,
    "end_sec": 4597.178,
    "zh": "谁也不确定外面会不会随时出现鬼迷,",
    "vi": "Không ai chắc chắn được bên ngoài có xuất hiện quái vật bất cứ lúc nào hay không."
  },
  {
    "idx": 2851,
    "start": "01:16:37,818",
    "end": "01:16:40,338",
    "start_sec": 4597.818,
    "end_sec": 4600.338,
    "zh": "但让他意想不到的是,一路上毫无意识,",
    "vi": "Nhưng điều anh không ngờ tới là suốt dọc đường lại vô cùng yên bình."
  },
  {
    "idx": 2852,
    "start": "01:16:40,598",
    "end": "01:16:43,618",
    "start_sec": 4600.598,
    "end_sec": 4603.618,
    "zh": "也不知道是小墨记的作用还是香牛的原因。",
    "vi": "Không biết là do tác dụng của Tiểu Mặc Kê hay là vì nhang thơm."
  },
  {
    "idx": 2853,
    "start": "01:16:44,698",
    "end": "01:16:48,178",
    "start_sec": 4604.698,
    "end_sec": 4608.178,
    "zh": "隔着遥远的路段,橙子皮终于看到了领和寺的大门,",
    "vi": "Từ một đoạn đường xa, Trần Tử Bì cuối cùng đã nhìn thấy cổng chùa Lĩnh Hòa."
  },
  {
    "idx": 2854,
    "start": "01:16:48,538",
    "end": "01:16:51,658",
    "start_sec": 4608.538,
    "end_sec": 4611.658,
    "zh": "不对劲,会不会太顺利了,这么简单知道了?",
    "vi": "Có gì đó không đúng. Liệu có quá thuận lợi không. Sao lại biết được dễ dàng như vậy."
  },
  {
    "idx": 2855,
    "start": "01:16:51,938",
    "end": "01:16:54,178",
    "start_sec": 4611.938,
    "end_sec": 4614.178,
    "zh": "临近永德寺最后的一份街道上",
    "vi": "Trên con phố cuối cùng dẫn đến chùa Vĩnh Đức"
  },
  {
    "idx": 2856,
    "start": "01:16:54,178",
    "end": "01:16:55,398",
    "start_sec": 4614.178,
    "end_sec": 4615.398,
    "zh": "到处有车辆侧翻",
    "vi": "Xe cộ lật nghiêng khắp nơi"
  },
  {
    "idx": 2857,
    "start": "01:16:55,398",
    "end": "01:16:56,678",
    "start_sec": 4615.398,
    "end_sec": 4616.678,
    "zh": "或是撞在栏盖上",
    "vi": "Hoặc đâm vào dải phân cách"
  },
  {
    "idx": 2858,
    "start": "01:16:56,678",
    "end": "01:16:58,418",
    "start_sec": 4616.678,
    "end_sec": 4618.418,
    "zh": "这应该是当时诡异阵营",
    "vi": "Đây chắc là do thế lực quỷ dị lúc đó"
  },
  {
    "idx": 2859,
    "start": "01:16:58,418",
    "end": "01:16:59,618",
    "start_sec": 4618.418,
    "end_sec": 4619.618,
    "zh": "司机们都出事了",
    "vi": "Các tài xế đều đã gặp nạn"
  },
  {
    "idx": 2860,
    "start": "01:16:59,618",
    "end": "01:17:01,098",
    "start_sec": 4619.618,
    "end_sec": 4621.098,
    "zh": "车子仍在行进",
    "vi": "Chiếc xe vẫn tiếp tục lao đi"
  },
  {
    "idx": 2861,
    "start": "01:17:01,098",
    "end": "01:17:02,998",
    "start_sec": 4621.098,
    "end_sec": 4622.998,
    "zh": "仰看着永德寺越来越近",
    "vi": "Nhìn chùa Vĩnh Đức ngày càng đến gần"
  },
  {
    "idx": 2862,
    "start": "01:17:02,998",
    "end": "01:17:04,318",
    "start_sec": 4622.998,
    "end_sec": 4624.318,
    "zh": "橙子皮的胸口",
    "vi": "Lồng ngực của Trần Tử Bì"
  },
  {
    "idx": 2863,
    "start": "01:17:04,318",
    "end": "01:17:05,018",
    "start_sec": 4624.318,
    "end_sec": 4625.018,
    "zh": "当下起",
    "vi": "Thắt lại"
  },
  {
    "idx": 2864,
    "start": "01:17:05,018",
    "end": "01:17:06,158",
    "start_sec": 4625.018,
    "end_sec": 4626.158,
    "zh": "突然",
    "vi": "Đột nhiên"
  },
  {
    "idx": 2865,
    "start": "01:17:06,158",
    "end": "01:17:07,258",
    "start_sec": 4626.158,
    "end_sec": 4627.258,
    "zh": "布加座的小默契",
    "vi": "Tiểu Mặc Kê ở ghế phụ"
  },
  {
    "idx": 2866,
    "start": "01:17:07,258",
    "end": "01:17:08,098",
    "start_sec": 4627.258,
    "end_sec": 4628.098,
    "zh": "不知道为什么",
    "vi": "Không biết vì sao"
  },
  {
    "idx": 2867,
    "start": "01:17:08,098",
    "end": "01:17:09,998",
    "start_sec": 4628.098,
    "end_sec": 4629.998,
    "zh": "朝着正前方的虚空吼叫",
    "vi": "Lại gầm rú vào khoảng không phía trước"
  },
  {
    "idx": 2868,
    "start": "01:17:09,998",
    "end": "01:17:11,558",
    "start_sec": 4629.998,
    "end_sec": 4631.558,
    "zh": "他身子止不住的发闪",
    "vi": "Cơ thể nó không ngừng run rẩy"
  },
  {
    "idx": 2869,
    "start": "01:17:11,558",
    "end": "01:17:13,238",
    "start_sec": 4631.558,
    "end_sec": 4633.238,
    "zh": "仿佛正前方的虚空中",
    "vi": "Giống như trong khoảng không phía trước"
  },
  {
    "idx": 2870,
    "start": "01:17:13,238",
    "end": "01:17:14,218",
    "start_sec": 4633.238,
    "end_sec": 4634.218,
    "zh": "有什么姿态",
    "vi": "Có thứ gì đó đang hiện diện"
  },
  {
    "idx": 2871,
    "start": "01:17:14,218",
    "end": "01:17:15,178",
    "start_sec": 4634.218,
    "end_sec": 4635.178,
    "zh": "小默契",
    "vi": "Tiểu Mặc Kê"
  },
  {
    "idx": 2872,
    "start": "01:17:15,178",
    "end": "01:17:15,738",
    "start_sec": 4635.178,
    "end_sec": 4635.738,
    "zh": "怎么了",
    "vi": "Có chuyện gì thế."
  },
  {
    "idx": 2873,
    "start": "01:17:15,738",
    "end": "01:17:20,118",
    "start_sec": 4635.738,
    "end_sec": 4640.118,
    "zh": "小默契的肢体",
    "vi": "Cơ thể của Tiểu Mặc Kê"
  },
  {
    "idx": 2874,
    "start": "01:17:20,118",
    "end": "01:17:21,218",
    "start_sec": 4640.118,
    "end_sec": 4641.218,
    "zh": "水溢着溢起来",
    "vi": "Bắt đầu vặn vẹo một cách kỳ lạ"
  },
  {
    "idx": 2875,
    "start": "01:17:21,218",
    "end": "01:17:22,838",
    "start_sec": 4641.218,
    "end_sec": 4642.838,
    "zh": "像是有一只无形的大猫",
    "vi": "Giống như có một con mèo lớn vô hình"
  },
  {
    "idx": 2876,
    "start": "01:17:22,838",
    "end": "01:17:23,678",
    "start_sec": 4642.838,
    "end_sec": 4643.678,
    "zh": "将它咨试了",
    "vi": "Đang nuốt chửng nó"
  },
  {
    "idx": 2877,
    "start": "01:17:23,678",
    "end": "01:17:24,778",
    "start_sec": 4643.678,
    "end_sec": 4644.778,
    "zh": "我靠",
    "vi": "Tiêu rồi"
  },
  {
    "idx": 2878,
    "start": "01:17:24,778",
    "end": "01:17:25,578",
    "start_sec": 4644.778,
    "end_sec": 4645.578,
    "zh": "小磨叽",
    "vi": "Tiểu Mặc Kê"
  },
  {
    "idx": 2879,
    "start": "01:17:25,578",
    "end": "01:17:26,418",
    "start_sec": 4645.578,
    "end_sec": 4646.418,
    "zh": "小磨叽",
    "vi": "Tiểu Mặc Kê"
  },
  {
    "idx": 2880,
    "start": "01:17:26,418",
    "end": "01:17:27,118",
    "start_sec": 4646.418,
    "end_sec": 4647.118,
    "zh": "你怎么了",
    "vi": "Mày sao thế."
  },
  {
    "idx": 2881,
    "start": "01:17:27,118",
    "end": "01:17:28,678",
    "start_sec": 4647.118,
    "end_sec": 4648.678,
    "zh": "变故来得太突然",
    "vi": "Mọi chuyện xảy ra quá đột ngột"
  },
  {
    "idx": 2882,
    "start": "01:17:28,678",
    "end": "01:17:30,578",
    "start_sec": 4648.678,
    "end_sec": 4650.578,
    "zh": "橙子皮刚想抱起小磨叽",
    "vi": "Khi Tiểu Cam vừa định bế Tiểu Mặc Kê lên"
  },
  {
    "idx": 2883,
    "start": "01:17:30,578",
    "end": "01:17:31,158",
    "start_sec": 4650.578,
    "end_sec": 4651.158,
    "zh": "咔咔咔",
    "vi": "Rắc rắc rắc"
  },
  {
    "idx": 2884,
    "start": "01:17:31,158",
    "end": "01:17:31,918",
    "start_sec": 4651.158,
    "end_sec": 4651.918,
    "zh": "一道骨头",
    "vi": "Một tiếng xương"
  },
  {
    "idx": 2885,
    "start": "01:17:31,918",
    "end": "01:17:32,758",
    "start_sec": 4651.918,
    "end_sec": 4652.758,
    "zh": "热烈的响声",
    "vi": "Vang lên dữ dội"
  },
  {
    "idx": 2886,
    "start": "01:17:32,758",
    "end": "01:17:34,338",
    "start_sec": 4652.758,
    "end_sec": 4654.338,
    "zh": "从小磨叽脑袋上传来",
    "vi": "Từ đầu Tiểu Mặc Kê vang lên"
  },
  {
    "idx": 2887,
    "start": "01:17:34,338",
    "end": "01:17:36,218",
    "start_sec": 4654.338,
    "end_sec": 4656.218,
    "zh": "小磨叽眼里充满恐惧",
    "vi": "Mắt Tiểu Mặc Kê đầy sợ hãi"
  },
  {
    "idx": 2888,
    "start": "01:17:36,218",
    "end": "01:17:37,618",
    "start_sec": 4656.218,
    "end_sec": 4657.618,
    "zh": "耗尽最后一次力气",
    "vi": "Dùng hết sức lực cuối cùng"
  },
  {
    "idx": 2889,
    "start": "01:17:37,618",
    "end": "01:17:38,778",
    "start_sec": 4657.618,
    "end_sec": 4658.778,
    "zh": "用脑袋顶了顶床",
    "vi": "Dùng đầu đẩy vào giường"
  },
  {
    "idx": 2890,
    "start": "01:17:38,778",
    "end": "01:17:41,138",
    "start_sec": 4658.778,
    "end_sec": 4661.138,
    "zh": "他妈的",
    "vi": "Chết tiệt"
  },
  {
    "idx": 2891,
    "start": "01:17:41,138",
    "end": "01:17:42,098",
    "start_sec": 4661.138,
    "end_sec": 4662.098,
    "zh": "到底发生了什么",
    "vi": "Rốt cuộc đã xảy ra chuyện gì"
  },
  {
    "idx": 2892,
    "start": "01:17:42,098",
    "end": "01:17:42,718",
    "start_sec": 4662.098,
    "end_sec": 4662.718,
    "zh": "是什么",
    "vi": "Là gì"
  },
  {
    "idx": 2893,
    "start": "01:17:42,718",
    "end": "01:17:44,538",
    "start_sec": 4662.718,
    "end_sec": 4664.538,
    "zh": "橙子皮双眼红红",
    "vi": "Mắt Tiểu Cam đỏ hoe"
  },
  {
    "idx": 2894,
    "start": "01:17:44,538",
    "end": "01:17:46,418",
    "start_sec": 4664.538,
    "end_sec": 4666.418,
    "zh": "随着空气中未知的存在",
    "vi": "Cùng với sự tồn tại bí ẩn trong không khí"
  },
  {
    "idx": 2895,
    "start": "01:17:46,418",
    "end": "01:17:47,378",
    "start_sec": 4666.418,
    "end_sec": 4667.378,
    "zh": "随后",
    "vi": "Sau đó"
  },
  {
    "idx": 2896,
    "start": "01:17:47,378",
    "end": "01:17:48,418",
    "start_sec": 4667.378,
    "end_sec": 4668.418,
    "zh": "骨头随略声",
    "vi": "Tiếng xương kêu răng rắc"
  },
  {
    "idx": 2897,
    "start": "01:17:48,418",
    "end": "01:17:49,918",
    "start_sec": 4668.418,
    "end_sec": 4669.918,
    "zh": "才使你脚摆开了",
    "vi": "Khiến chân mày bị kéo ra"
  },
  {
    "idx": 2898,
    "start": "01:17:49,918",
    "end": "01:17:52,638",
    "start_sec": 4669.918,
    "end_sec": 4672.638,
    "zh": "橙子皮惨叫出声",
    "vi": "Tiểu Cam hét lên thảm thiết"
  },
  {
    "idx": 2899,
    "start": "01:17:52,638",
    "end": "01:17:53,818",
    "start_sec": 4672.638,
    "end_sec": 4673.818,
    "zh": "慌忙取舍三鱼",
    "vi": "Vội vàng lấy ra ba con cá"
  },
  {
    "idx": 2900,
    "start": "01:17:53,818",
    "end": "01:17:55,978",
    "start_sec": 4673.818,
    "end_sec": 4675.978,
    "zh": "但脚上的扭曲才是最紧张",
    "vi": "Nhưng sự vặn vẹo ở chân mới là điều đáng sợ nhất"
  },
  {
    "idx": 2901,
    "start": "01:17:55,978",
    "end": "01:17:56,858",
    "start_sec": 4675.978,
    "end_sec": 4676.858,
    "zh": "为什么",
    "vi": "Tại sao"
  },
  {
    "idx": 2902,
    "start": "01:17:56,858",
    "end": "01:17:57,658",
    "start_sec": 4676.858,
    "end_sec": 4677.658,
    "zh": "狗没有",
    "vi": "Con chó không"
  },
  {
    "idx": 2903,
    "start": "01:17:57,658",
    "end": "01:17:58,558",
    "start_sec": 4677.658,
    "end_sec": 4678.558,
    "zh": "香炉也没有",
    "vi": "Cái lư hương cũng không"
  },
  {
    "idx": 2904,
    "start": "01:17:58,558",
    "end": "01:18:00,298",
    "start_sec": 4678.558,
    "end_sec": 4680.298,
    "zh": "为什么会碰到这么厉害的鬼迹",
    "vi": "Tại sao lại gặp phải tà khí mạnh như vậy"
  },
  {
    "idx": 2905,
    "start": "01:18:00,298",
    "end": "01:18:00,778",
    "start_sec": 4680.298,
    "end_sec": 4680.778,
    "zh": "草",
    "vi": "Chết tiệt"
  },
  {
    "idx": 2906,
    "start": "01:18:00,778",
    "end": "01:18:01,438",
    "start_sec": 4680.778,
    "end_sec": 4681.438,
    "zh": "草",
    "vi": "Chết tiệt"
  },
  {
    "idx": 2907,
    "start": "01:18:01,438",
    "end": "01:18:02,438",
    "start_sec": 4681.438,
    "end_sec": 4682.438,
    "zh": "脑子就这么白",
    "vi": "Đầu óc tôi cứ thế trống rỗng"
  },
  {
    "idx": 2908,
    "start": "01:18:02,438",
    "end": "01:18:03,198",
    "start_sec": 4682.438,
    "end_sec": 4683.198,
    "zh": "该死了",
    "vi": "Sắp chết rồi"
  },
  {
    "idx": 2909,
    "start": "01:18:03,198",
    "end": "01:18:04,258",
    "start_sec": 4683.198,
    "end_sec": 4684.258,
    "zh": "难道我又要死了吗",
    "vi": "Chẳng lẽ tôi sắp chết lần nữa sao"
  },
  {
    "idx": 2910,
    "start": "01:18:04,258",
    "end": "01:18:05,138",
    "start_sec": 4684.258,
    "end_sec": 4685.138,
    "zh": "以为疼痛",
    "vi": "Cứ nghĩ là đau đớn"
  },
  {
    "idx": 2911,
    "start": "01:18:05,138",
    "end": "01:18:06,738",
    "start_sec": 4685.138,
    "end_sec": 4686.738,
    "zh": "橙子皮的面部开始扭曲",
    "vi": "Khuôn mặt của Trần Tử Bì bắt đầu vặn vẹo."
  },
  {
    "idx": 2912,
    "start": "01:18:06,738",
    "end": "01:18:08,338",
    "start_sec": 4686.738,
    "end_sec": 4688.338,
    "zh": "他轻轻的踹着脚掌暴力",
    "vi": "Bàn chân của anh ta bị vặn gãy một cách tàn nhẫn."
  },
  {
    "idx": 2913,
    "start": "01:18:08,338",
    "end": "01:18:09,158",
    "start_sec": 4688.338,
    "end_sec": 4689.158,
    "zh": "血水喷溅",
    "vi": "Máu tươi phun tung tóe."
  },
  {
    "idx": 2914,
    "start": "01:18:09,158",
    "end": "01:18:10,878",
    "start_sec": 4689.158,
    "end_sec": 4690.878,
    "zh": "随后小腿骨也在扭曲",
    "vi": "Ngay sau đó xương cẳng chân cũng bị vặn vẹo."
  },
  {
    "idx": 2915,
    "start": "01:18:10,878",
    "end": "01:18:12,398",
    "start_sec": 4690.878,
    "end_sec": 4692.398,
    "zh": "让他大腿翻肩而来",
    "vi": "khiến cho đùi của anh ta gập ngược lên vai."
  },
  {
    "idx": 2916,
    "start": "01:18:12,398",
    "end": "01:18:13,218",
    "start_sec": 4692.398,
    "end_sec": 4693.218,
    "zh": "剧烈的疼痛",
    "vi": "Cơn đau dữ dội."
  },
  {
    "idx": 2917,
    "start": "01:18:13,218",
    "end": "01:18:14,158",
    "start_sec": 4693.218,
    "end_sec": 4694.158,
    "zh": "让他肌肌腹腻",
    "vi": "khiến các cơ của anh ta co giật liên hồi."
  },
  {
    "idx": 2918,
    "start": "01:18:14,158",
    "end": "01:18:15,078",
    "start_sec": 4694.158,
    "end_sec": 4695.078,
    "zh": "他强咬着牙",
    "vi": "Anh ta cắn chặt răng."
  },
  {
    "idx": 2919,
    "start": "01:18:15,078",
    "end": "01:18:15,838",
    "start_sec": 4695.078,
    "end_sec": 4695.838,
    "zh": "满脸绝望",
    "vi": "Khuôn mặt đầy vẻ tuyệt vọng."
  },
  {
    "idx": 2920,
    "start": "01:18:15,838",
    "end": "01:18:16,258",
    "start_sec": 4695.838,
    "end_sec": 4696.258,
    "zh": "哥",
    "vi": "Anh ơi."
  },
  {
    "idx": 2921,
    "start": "01:18:16,258",
    "end": "01:18:17,118",
    "start_sec": 4696.258,
    "end_sec": 4697.118,
    "zh": "我不能死",
    "vi": "Tôi không thể chết được."
  },
  {
    "idx": 2922,
    "start": "01:18:17,118",
    "end": "01:18:19,678",
    "start_sec": 4697.118,
    "end_sec": 4699.678,
    "zh": "长子皮强行让自己冷静下来",
    "vi": "Trần Tử Bì cố gắng ép bản thân phải bình tĩnh lại."
  },
  {
    "idx": 2923,
    "start": "01:18:19,678",
    "end": "01:18:22,398",
    "start_sec": 4699.678,
    "end_sec": 4702.398,
    "zh": "但找不到任何破解当前局面的办法",
    "vi": "Nhưng anh ta không tìm được bất kỳ cách nào để giải quyết tình cảnh hiện tại."
  },
  {
    "idx": 2924,
    "start": "01:18:22,398",
    "end": "01:18:23,578",
    "start_sec": 4702.398,
    "end_sec": 4703.578,
    "zh": "现在的我要死了",
    "vi": "Bây giờ tôi sắp chết rồi."
  },
  {
    "idx": 2925,
    "start": "01:18:23,578",
    "end": "01:18:25,178",
    "start_sec": 4703.578,
    "end_sec": 4705.178,
    "zh": "但至少一个月前的我还活着",
    "vi": "Nhưng ít nhất tôi của một tháng trước vẫn còn sống."
  },
  {
    "idx": 2926,
    "start": "01:18:25,178",
    "end": "01:18:26,718",
    "start_sec": 4705.178,
    "end_sec": 4706.718,
    "zh": "长子皮慌忙掏出了",
    "vi": "Trần Tử Bì vội vàng lấy điện thoại ra."
  },
  {
    "idx": 2927,
    "start": "01:18:26,718",
    "end": "01:18:27,838",
    "start_sec": 4706.718,
    "end_sec": 4707.838,
    "zh": "过去的我",
    "vi": "Gửi tôi của quá khứ."
  },
  {
    "idx": 2928,
    "start": "01:18:27,838",
    "end": "01:18:29,338",
    "start_sec": 4707.838,
    "end_sec": 4709.338,
    "zh": "如果你看到这条信息的时候",
    "vi": "Nếu như bạn nhìn thấy dòng tin nhắn này."
  },
  {
    "idx": 2929,
    "start": "01:18:29,338",
    "end": "01:18:30,518",
    "start_sec": 4709.338,
    "end_sec": 4710.518,
    "zh": "我可能已经死了",
    "vi": "Thì có lẽ tôi đã chết rồi."
  },
  {
    "idx": 2930,
    "start": "01:18:30,518",
    "end": "01:18:31,178",
    "start_sec": 4710.518,
    "end_sec": 4711.178,
    "zh": "你切记",
    "vi": "Bạn hãy nhớ kỹ."
  },
  {
    "idx": 2931,
    "start": "01:18:31,178",
    "end": "01:18:32,818",
    "start_sec": 4711.178,
    "end_sec": 4712.818,
    "zh": "鬼一降临的第三天后",
    "vi": "Sau ngày thứ ba kể từ khi ác quỷ xuất hiện."
  },
  {
    "idx": 2932,
    "start": "01:18:32,818",
    "end": "01:18:34,918",
    "start_sec": 4712.818,
    "end_sec": 4714.918,
    "zh": "千万不要带着小磨叽到永德寺",
    "vi": "Tuyệt đối không được đưa Tiểu Ma Kỷ đến chùa Vĩnh Đức."
  },
  {
    "idx": 2933,
    "start": "01:18:34,918",
    "end": "01:18:36,438",
    "start_sec": 4714.918,
    "end_sec": 4716.438,
    "zh": "打完这条信息后",
    "vi": "Sau khi soạn xong dòng tin nhắn này."
  },
  {
    "idx": 2934,
    "start": "01:18:36,438",
    "end": "01:18:38,278",
    "start_sec": 4716.438,
    "end_sec": 4718.278,
    "zh": "长子皮身体开始扭曲",
    "vi": "Cơ thể của Trần Tử Bì bắt đầu vặn vẹo."
  },
  {
    "idx": 2935,
    "start": "01:18:38,278",
    "end": "01:18:39,518",
    "start_sec": 4718.278,
    "end_sec": 4719.518,
    "zh": "血水不断喷点",
    "vi": "Máu tươi không ngừng phun ra."
  },
  {
    "idx": 2936,
    "start": "01:18:39,518",
    "end": "01:18:40,718",
    "start_sec": 4719.518,
    "end_sec": 4720.718,
    "zh": "直至完全没力",
    "vi": "Cho đến khi anh ta hoàn toàn kiệt sức."
  },
  {
    "idx": 2937,
    "start": "01:18:47,118",
    "end": "01:18:48,698",
    "start_sec": 4727.118,
    "end_sec": 4728.698,
    "zh": "我 我没死",
    "vi": "Tôi, tôi chưa chết."
  },
  {
    "idx": 2938,
    "start": "01:18:48,698",
    "end": "01:18:50,298",
    "start_sec": 4728.698,
    "end_sec": 4730.298,
    "zh": "这里是小区外面",
    "vi": "Nơi này là bên ngoài khu chung cư."
  },
  {
    "idx": 2939,
    "start": "01:18:50,298",
    "end": "01:18:51,878",
    "start_sec": 4730.298,
    "end_sec": 4731.878,
    "zh": "确实没事啊",
    "vi": "Đúng là không sao thật rồi."
  },
  {
    "idx": 2940,
    "start": "01:18:51,878",
    "end": "01:18:52,818",
    "start_sec": 4731.878,
    "end_sec": 4732.818,
    "zh": "那刚刚算什么",
    "vi": "Vậy chuyện vừa rồi là thế nào chứ."
  },
  {
    "idx": 2941,
    "start": "01:18:52,818",
    "end": "01:18:53,998",
    "start_sec": 4732.818,
    "end_sec": 4733.998,
    "zh": "嗯 不对",
    "vi": "Không, không đúng."
  },
  {
    "idx": 2942,
    "start": "01:18:53,998",
    "end": "01:18:55,318",
    "start_sec": 4733.998,
    "end_sec": 4735.318,
    "zh": "绝对不是梦",
    "vi": "Tuyệt đối không phải là mơ."
  },
  {
    "idx": 2943,
    "start": "01:18:55,318",
    "end": "01:18:56,378",
    "start_sec": 4735.318,
    "end_sec": 4736.378,
    "zh": "感觉太深刻了",
    "vi": "Cảm giác quá chân thực."
  },
  {
    "idx": 2944,
    "start": "01:18:56,378",
    "end": "01:18:57,978",
    "start_sec": 4736.378,
    "end_sec": 4737.978,
    "zh": "回想起刚才的撕心裂肺",
    "vi": "Nghĩ lại cảm giác đau đớn xé lòng vừa rồi."
  },
  {
    "idx": 2945,
    "start": "01:18:57,978",
    "end": "01:18:59,318",
    "start_sec": 4737.978,
    "end_sec": 4739.318,
    "zh": "肠子皮一阵后发",
    "vi": "Tràng Tử Bì cảm thấy rùng mình sợ hãi."
  },
  {
    "idx": 2946,
    "start": "01:18:59,318",
    "end": "01:19:00,238",
    "start_sec": 4739.318,
    "end_sec": 4740.238,
    "zh": "冷汗紧身",
    "vi": "Mồ hôi lạnh toát ra khắp người."
  },
  {
    "idx": 2947,
    "start": "01:19:00,238",
    "end": "01:19:03,518",
    "start_sec": 4740.238,
    "end_sec": 4743.518,
    "zh": "刚刚自己领土前发的遗言也消失了",
    "vi": "Lời trăn trối gửi đi trước khi chết vừa rồi cũng biến mất."
  },
  {
    "idx": 2948,
    "start": "01:19:03,518",
    "end": "01:19:05,358",
    "start_sec": 4743.518,
    "end_sec": 4745.358,
    "zh": "肠子皮缓缓闭上眼睛",
    "vi": "Tràng Tử Bì từ từ nhắm mắt lại."
  },
  {
    "idx": 2949,
    "start": "01:19:05,358",
    "end": "01:19:06,118",
    "start_sec": 4745.358,
    "end_sec": 4746.118,
    "zh": "开始思考",
    "vi": "Bắt đầu suy nghĩ."
  },
  {
    "idx": 2950,
    "start": "01:19:06,118",
    "end": "01:19:06,998",
    "start_sec": 4746.118,
    "end_sec": 4746.998,
    "zh": "三天前",
    "vi": "Ba ngày trước."
  },
  {
    "idx": 2951,
    "start": "01:19:06,998",
    "end": "01:19:07,978",
    "start_sec": 4746.998,
    "end_sec": 4747.978,
    "zh": "瑞伊突然降临",
    "vi": "Thụy Y đột ngột xuất hiện."
  },
  {
    "idx": 2952,
    "start": "01:19:07,978",
    "end": "01:19:09,798",
    "start_sec": 4747.978,
    "end_sec": 4749.798,
    "zh": "这一切发生的都太过突兀",
    "vi": "Mọi chuyện xảy ra quá đột ngột."
  },
  {
    "idx": 2953,
    "start": "01:19:09,798",
    "end": "01:19:11,518",
    "start_sec": 4749.798,
    "end_sec": 4751.518,
    "zh": "他还没来得及消化这一切",
    "vi": "Anh ấy vẫn chưa kịp tiếp nhận tất cả chuyện này."
  },
  {
    "idx": 2954,
    "start": "01:19:11,518",
    "end": "01:19:12,358",
    "start_sec": 4751.518,
    "end_sec": 4752.358,
    "zh": "事关生死",
    "vi": "Chuyện này liên quan đến sinh tử."
  },
  {
    "idx": 2955,
    "start": "01:19:12,358",
    "end": "01:19:15,238",
    "start_sec": 4752.358,
    "end_sec": 4755.238,
    "zh": "他必须要彻底的弄清楚现在的情况",
    "vi": "Anh ấy phải làm rõ hoàn toàn tình hình hiện tại."
  },
  {
    "idx": 2956,
    "start": "01:19:15,238",
    "end": "01:19:16,978",
    "start_sec": 4755.238,
    "end_sec": 4756.978,
    "zh": "有没有一种可能",
    "vi": "Liệu có khả năng nào."
  },
  {
    "idx": 2957,
    "start": "01:19:16,978",
    "end": "01:19:17,858",
    "start_sec": 4756.978,
    "end_sec": 4757.858,
    "zh": "我死了",
    "vi": "Tôi đã chết rồi."
  },
  {
    "idx": 2958,
    "start": "01:19:17,858",
    "end": "01:19:18,938",
    "start_sec": 4757.858,
    "end_sec": 4758.938,
    "zh": "我已经不是我了",
    "vi": "Tôi đã không còn là tôi nữa."
  },
  {
    "idx": 2959,
    "start": "01:19:18,938",
    "end": "01:19:20,338",
    "start_sec": 4758.938,
    "end_sec": 4760.338,
    "zh": "如果说",
    "vi": "Nếu như nói."
  },
  {
    "idx": 2960,
    "start": "01:19:20,338",
    "end": "01:19:21,978",
    "start_sec": 4760.338,
    "end_sec": 4761.978,
    "zh": "刚才那五个字死亡的我是零",
    "vi": "Tôi của lúc chết vừa rồi là số không."
  },
  {
    "idx": 2961,
    "start": "01:19:21,978",
    "end": "01:19:22,958",
    "start_sec": 4761.978,
    "end_sec": 4762.958,
    "zh": "现在的我是一",
    "vi": "Tôi của hiện tại là số một."
  },
  {
    "idx": 2962,
    "start": "01:19:22,958",
    "end": "01:19:23,918",
    "start_sec": 4762.958,
    "end_sec": 4763.918,
    "zh": "过去的我是二",
    "vi": "Tôi của quá khứ là số hai."
  },
  {
    "idx": 2963,
    "start": "01:19:23,918",
    "end": "01:19:25,318",
    "start_sec": 4763.918,
    "end_sec": 4765.318,
    "zh": "在即将死亡的情况下",
    "vi": "Trong tình huống sắp chết."
  },
  {
    "idx": 2964,
    "start": "01:19:25,318",
    "end": "01:19:26,098",
    "start_sec": 4765.318,
    "end_sec": 4766.098,
    "zh": "我变成了零",
    "vi": "Tôi đã biến thành số không."
  },
  {
    "idx": 2965,
    "start": "01:19:26,098",
    "end": "01:19:27,198",
    "start_sec": 4766.098,
    "end_sec": 4767.198,
    "zh": "零死前零下二",
    "vi": "Số không trước khi chết để lại số hai."
  },
  {
    "idx": 2966,
    "start": "01:19:27,198",
    "end": "01:19:28,858",
    "start_sec": 4767.198,
    "end_sec": 4768.858,
    "zh": "死后变成某种未知的界面",
    "vi": "Sau khi chết sẽ biến thành một trạng thái chưa biết nào đó."
  },
  {
    "idx": 2967,
    "start": "01:19:28,858",
    "end": "01:19:29,638",
    "start_sec": 4768.858,
    "end_sec": 4769.638,
    "zh": "相当于",
    "vi": "Tương đương với."
  },
  {
    "idx": 2968,
    "start": "01:19:29,638",
    "end": "01:19:30,178",
    "start_sec": 4769.638,
    "end_sec": 4770.178,
    "zh": "永恒",
    "vi": "Vĩnh hằng."
  },
  {
    "idx": 2969,
    "start": "01:19:30,178",
    "end": "01:19:32,218",
    "start_sec": 4770.178,
    "end_sec": 4772.218,
    "zh": "而此时二会预计提供出陆体",
    "vi": "Và lúc này số hai sẽ cung cấp lại cơ thể."
  },
  {
    "idx": 2970,
    "start": "01:19:32,218",
    "end": "01:19:33,098",
    "start_sec": 4772.218,
    "end_sec": 4773.098,
    "zh": "两者结合",
    "vi": "Cả hai kết hợp lại."
  },
  {
    "idx": 2971,
    "start": "01:19:33,098",
    "end": "01:19:33,878",
    "start_sec": 4773.098,
    "end_sec": 4773.878,
    "zh": "互变成一",
    "vi": "Hòa làm một."
  },
  {
    "idx": 2972,
    "start": "01:19:33,878",
    "end": "01:19:35,678",
    "start_sec": 4773.878,
    "end_sec": 4775.678,
    "zh": "而过去的是既定存在的",
    "vi": "Mà quá khứ là thứ đã định sẵn rồi."
  },
  {
    "idx": 2973,
    "start": "01:19:35,678",
    "end": "01:19:36,258",
    "start_sec": 4775.678,
    "end_sec": 4776.258,
    "zh": "也就是说",
    "vi": "Nghĩa là."
  },
  {
    "idx": 2974,
    "start": "01:19:36,258",
    "end": "01:19:37,398",
    "start_sec": 4776.258,
    "end_sec": 4777.398,
    "zh": "以后面永远有二",
    "vi": "Phía sau sẽ luôn có số hai."
  },
  {
    "idx": 2975,
    "start": "01:19:37,398",
    "end": "01:19:38,678",
    "start_sec": 4777.398,
    "end_sec": 4778.678,
    "zh": "未来是未知的",
    "vi": "Tương lai là vô định."
  },
  {
    "idx": 2976,
    "start": "01:19:38,678",
    "end": "01:19:39,958",
    "start_sec": 4778.678,
    "end_sec": 4779.958,
    "zh": "要命的情况随时都有",
    "vi": "Tình huống nguy hiểm có thể xảy ra bất cứ lúc nào."
  },
  {
    "idx": 2977,
    "start": "01:19:39,958",
    "end": "01:19:41,098",
    "start_sec": 4779.958,
    "end_sec": 4781.098,
    "zh": "亦永远可以变成零",
    "vi": "Cũng luôn có thể trở về số không."
  },
  {
    "idx": 2978,
    "start": "01:19:41,098",
    "end": "01:19:41,678",
    "start_sec": 4781.098,
    "end_sec": 4781.678,
    "zh": "如此",
    "vi": "Như vậy."
  },
  {
    "idx": 2979,
    "start": "01:19:41,678",
    "end": "01:19:42,858",
    "start_sec": 4781.678,
    "end_sec": 4782.858,
    "zh": "也形成一个循环",
    "vi": "Sẽ tạo thành một vòng lặp."
  },
  {
    "idx": 2980,
    "start": "01:19:42,858",
    "end": "01:19:43,758",
    "start_sec": 4782.858,
    "end_sec": 4783.758,
    "zh": "循环",
    "vi": "Vòng lặp."
  },
  {
    "idx": 2981,
    "start": "01:19:43,758",
    "end": "01:19:44,858",
    "start_sec": 4783.758,
    "end_sec": 4784.858,
    "zh": "循环是无限的",
    "vi": "Vòng lặp này là vô hạn."
  },
  {
    "idx": 2982,
    "start": "01:19:44,858",
    "end": "01:19:47,318",
    "start_sec": 4784.858,
    "end_sec": 4787.318,
    "zh": "也就是说",
    "vi": "Nói cách khác."
  },
  {
    "idx": 2983,
    "start": "01:19:47,318",
    "end": "01:19:48,378",
    "start_sec": 4787.318,
    "end_sec": 4788.378,
    "zh": "我们无限重生",
    "vi": "Chúng ta sẽ hồi sinh vô hạn."
  },
  {
    "idx": 2984,
    "start": "01:19:48,378",
    "end": "01:19:49,778",
    "start_sec": 4788.378,
    "end_sec": 4789.778,
    "zh": "不过有三点致命缺陷",
    "vi": "Nhưng có ba điểm yếu chí mạng."
  },
  {
    "idx": 2985,
    "start": "01:19:49,778",
    "end": "01:19:50,278",
    "start_sec": 4789.778,
    "end_sec": 4790.278,
    "zh": "第一",
    "vi": "Thứ nhất."
  },
  {
    "idx": 2986,
    "start": "01:19:50,278",
    "end": "01:19:51,398",
    "start_sec": 4790.278,
    "end_sec": 4791.398,
    "zh": "必须要联系过去",
    "vi": "Bắt buộc phải liên lạc với quá khứ."
  },
  {
    "idx": 2987,
    "start": "01:19:51,398",
    "end": "01:19:51,758",
    "start_sec": 4791.398,
    "end_sec": 4791.758,
    "zh": "第二",
    "vi": "Thứ hai."
  },
  {
    "idx": 2988,
    "start": "01:19:51,758",
    "end": "01:19:53,318",
    "start_sec": 4791.758,
    "end_sec": 4793.318,
    "zh": "手机有太多不知的因素",
    "vi": "Điện thoại có quá nhiều yếu tố không xác định."
  },
  {
    "idx": 2989,
    "start": "01:19:53,318",
    "end": "01:19:54,238",
    "start_sec": 4793.318,
    "end_sec": 4794.238,
    "zh": "可能会没电",
    "vi": "Có thể sẽ hết pin."
  },
  {
    "idx": 2990,
    "start": "01:19:54,238",
    "end": "01:19:55,118",
    "start_sec": 4794.238,
    "end_sec": 4795.118,
    "zh": "也可能会损坏",
    "vi": "Hoặc có thể bị hỏng."
  },
  {
    "idx": 2991,
    "start": "01:19:55,118",
    "end": "01:19:55,658",
    "start_sec": 4795.118,
    "end_sec": 4795.658,
    "zh": "第三",
    "vi": "Thứ ba."
  },
  {
    "idx": 2992,
    "start": "01:19:55,658",
    "end": "01:19:56,478",
    "start_sec": 4795.658,
    "end_sec": 4796.478,
    "zh": "重生地点",
    "vi": "Địa điểm hồi sinh."
  },
  {
    "idx": 2993,
    "start": "01:19:56,478",
    "end": "01:19:57,678",
    "start_sec": 4796.478,
    "end_sec": 4797.678,
    "zh": "不知道是不是随机的",
    "vi": "Không biết có phải ngẫu nhiên hay không."
  },
  {
    "idx": 2994,
    "start": "01:19:57,678",
    "end": "01:19:58,538",
    "start_sec": 4797.678,
    "end_sec": 4798.538,
    "zh": "这次重生",
    "vi": "Lần hồi sinh này."
  },
  {
    "idx": 2995,
    "start": "01:19:58,538",
    "end": "01:19:59,638",
    "start_sec": 4798.538,
    "end_sec": 4799.638,
    "zh": "是在小区外面",
    "vi": "Là ở bên ngoài khu chung cư."
  },
  {
    "idx": 2996,
    "start": "01:20:00,000",
    "end": "01:20:02,210",
    "start_sec": 4800.0,
    "end_sec": 4802.21,
    "zh": "一直重生在鬼谊脸上,即使我能及时联系过去,那也是无限体验死亡。",
    "vi": "Nếu cứ liên tục hồi sinh ngay trước mặt con quỷ, dù tôi có kịp thời liên"
  },
  {
    "idx": 2996,
    "start": "01:20:02,210",
    "end": "01:20:04,160",
    "start_sec": 4802.21,
    "end_sec": 4804.16,
    "zh": "一直重生在鬼谊脸上,即使我能及时联系过去,那也是无限体验死亡。",
    "vi": "lạc với quá khứ, thì đó cũng chỉ là trải nghiệm cái chết vô hạn."
  },
  {
    "idx": 2997,
    "start": "01:20:04,860",
    "end": "01:20:08,902",
    "start_sec": 4804.86,
    "end_sec": 4808.902,
    "zh": "当然,这一切也只是橙子皮的猜想,灵魂重生肉体什么的,太过离奇,不过鬼谊都降临了,还有什么比这更离奇的深?",
    "vi": "Dĩ nhiên, tất cả những điều này cũng chỉ là suy đoán của Trần Tử Bì, chuyện linh hồn hồi sinh thể xác quá mức"
  },
  {
    "idx": 2997,
    "start": "01:20:08,902",
    "end": "01:20:12,620",
    "start_sec": 4808.902,
    "end_sec": 4812.62,
    "zh": "当然,这一切也只是橙子皮的猜想,灵魂重生肉体什么的,太过离奇,不过鬼谊都降临了,还有什么比这更离奇的深?",
    "vi": "kỳ lạ, nhưng đến cả con quỷ cũng đã xuất hiện rồi, còn chuyện gì có thể kỳ lạ hơn thế nữa chứ."
  },
  {
    "idx": 2998,
    "start": "01:20:13,040",
    "end": "01:20:16,911",
    "start_sec": 4813.04,
    "end_sec": 4816.911,
    "zh": "现在看来,永德寺外面的位置鬼谊太厉害,只要我走进它的山派上位,根本无法逃脱,难怪永德寺外面会有这么多损坏的车辆。",
    "vi": "Giờ nhìn lại, con quỷ bên ngoài Chùa Vĩnh Đức quá lợi hại, chỉ cần tôi bước vào phạm vi của nó là hoàn"
  },
  {
    "idx": 2998,
    "start": "01:20:16,911",
    "end": "01:20:20,460",
    "start_sec": 4816.911,
    "end_sec": 4820.46,
    "zh": "现在看来,永德寺外面的位置鬼谊太厉害,只要我走进它的山派上位,根本无法逃脱,难怪永德寺外面会有这么多损坏的车辆。",
    "vi": "toàn không thể trốn thoát, hèn chi bên ngoài Chùa Vĩnh Đức lại có nhiều xe cộ bị hư hỏng đến vậy."
  },
  {
    "idx": 2999,
    "start": "01:20:20,760",
    "end": "01:20:22,824",
    "start_sec": 4820.76,
    "end_sec": 4822.824,
    "zh": "不过寺里似乎不受鬼谊影响,看来永德寺真的有什么抵抗鬼谊的存在。",
    "vi": "Nhưng trong chùa dường như không bị con quỷ ảnh hưởng, xem ra Chùa"
  },
  {
    "idx": 2999,
    "start": "01:20:22,824",
    "end": "01:20:24,740",
    "start_sec": 4822.824,
    "end_sec": 4824.74,
    "zh": "不过寺里似乎不受鬼谊影响,看来永德寺真的有什么抵抗鬼谊的存在。",
    "vi": "Vĩnh Đức thực sự có thứ gì đó chống lại được con quỷ."
  },
  {
    "idx": 3000,
    "start": "01:20:24,740",
    "end": "01:20:26,140",
    "start_sec": 4824.74,
    "end_sec": 4826.14,
    "zh": "橙子皮想了想",
    "vi": "Trần Tử Bì suy nghĩ một lát."
  },
  {
    "idx": 3001,
    "start": "01:20:26,140",
    "end": "01:20:28,020",
    "start_sec": 4826.14,
    "end_sec": 4828.02,
    "zh": "既然现在的我进不去",
    "vi": "Nếu hiện tại tôi không thể vào được."
  },
  {
    "idx": 3002,
    "start": "01:20:28,020",
    "end": "01:20:30,340",
    "start_sec": 4828.02,
    "end_sec": 4830.34,
    "zh": "那过去的我是不是可以提前搬进永德寺",
    "vi": "Vậy tôi của quá khứ có thể dọn vào chùa Vĩnh Đức trước hay không."
  },
  {
    "idx": 3003,
    "start": "01:20:30,340",
    "end": "01:20:32,620",
    "start_sec": 4830.34,
    "end_sec": 4832.62,
    "zh": "心里刚刚萌生出这种想法",
    "vi": "Trong lòng vừa nảy sinh ý nghĩ này."
  },
  {
    "idx": 3004,
    "start": "01:20:32,620",
    "end": "01:20:34,080",
    "start_sec": 4832.62,
    "end_sec": 4834.08,
    "zh": "橙子皮又当即走进",
    "vi": "Trần Tử Bì liền lập tức gạt đi."
  },
  {
    "idx": 3005,
    "start": "01:20:34,080",
    "end": "01:20:35,140",
    "start_sec": 4834.08,
    "end_sec": 4835.14,
    "zh": "不,不行",
    "vi": "Không, không được."
  },
  {
    "idx": 3006,
    "start": "01:20:35,140",
    "end": "01:20:36,340",
    "start_sec": 4835.14,
    "end_sec": 4836.34,
    "zh": "刚才的假设里",
    "vi": "Trong giả thuyết vừa rồi."
  },
  {
    "idx": 3007,
    "start": "01:20:36,340",
    "end": "01:20:38,240",
    "start_sec": 4836.34,
    "end_sec": 4838.24,
    "zh": "只有现在的我死会变成灵",
    "vi": "Chỉ có tôi của hiện tại chết mới biến thành linh hồn."
  },
  {
    "idx": 3008,
    "start": "01:20:38,240",
    "end": "01:20:39,560",
    "start_sec": 4838.24,
    "end_sec": 4839.56,
    "zh": "如果过去的我死了呢",
    "vi": "Nếu tôi của quá khứ chết thì sao."
  },
  {
    "idx": 3009,
    "start": "01:20:39,560",
    "end": "01:20:41,720",
    "start_sec": 4839.56,
    "end_sec": 4841.72,
    "zh": "那是不是意味着没有肉体的提供",
    "vi": "Như vậy có phải nghĩa là nếu không có thể xác cung cấp."
  },
  {
    "idx": 3010,
    "start": "01:20:41,720",
    "end": "01:20:43,000",
    "start_sec": 4841.72,
    "end_sec": 4843.0,
    "zh": "我就真的死了",
    "vi": "Tôi sẽ thực sự chết luôn."
  },
  {
    "idx": 3011,
    "start": "01:20:43,000",
    "end": "01:20:45,280",
    "start_sec": 4843.0,
    "end_sec": 4845.28,
    "zh": "永德寺这个地方看起来很不简单",
    "vi": "Nơi như chùa Vĩnh Đức trông không hề đơn giản."
  },
  {
    "idx": 3012,
    "start": "01:20:45,280",
    "end": "01:20:46,500",
    "start_sec": 4845.28,
    "end_sec": 4846.5,
    "zh": "即使是一个月前",
    "vi": "Ngay cả một tháng trước."
  },
  {
    "idx": 3013,
    "start": "01:20:46,500",
    "end": "01:20:47,380",
    "start_sec": 4846.5,
    "end_sec": 4847.38,
    "zh": "诡异还未降临",
    "vi": "Khi sự quỷ dị chưa giáng xuống."
  },
  {
    "idx": 3014,
    "start": "01:20:47,380",
    "end": "01:20:48,840",
    "start_sec": 4847.38,
    "end_sec": 4848.84,
    "zh": "我也不能让过去的我冒险",
    "vi": "Tôi cũng không thể để tôi của quá khứ mạo hiểm."
  },
  {
    "idx": 3015,
    "start": "01:20:48,840",
    "end": "01:20:50,680",
    "start_sec": 4848.84,
    "end_sec": 4850.68,
    "zh": "我重生的根本是过去",
    "vi": "Gốc rễ sự trùng sinh của tôi là quá khứ."
  },
  {
    "idx": 3016,
    "start": "01:20:50,680",
    "end": "01:20:51,640",
    "start_sec": 4850.68,
    "end_sec": 4851.64,
    "zh": "要说冒险的话",
    "vi": "Nếu nói đến mạo hiểm."
  },
  {
    "idx": 3017,
    "start": "01:20:51,640",
    "end": "01:20:52,700",
    "start_sec": 4851.64,
    "end_sec": 4852.7,
    "zh": "只能是现在的我",
    "vi": "Thì chỉ có thể là tôi của hiện tại."
  },
  {
    "idx": 3018,
    "start": "01:20:52,700",
    "end": "01:20:53,240",
    "start_sec": 4852.7,
    "end_sec": 4853.24,
    "zh": "看来",
    "vi": "Xem ra."
  },
  {
    "idx": 3019,
    "start": "01:20:53,240",
    "end": "01:20:54,480",
    "start_sec": 4853.24,
    "end_sec": 4854.48,
    "zh": "不过除非必要情况",
    "vi": "Nhưng trừ phi là trường hợp cần thiết."
  },
  {
    "idx": 3020,
    "start": "01:20:54,480",
    "end": "01:20:56,080",
    "start_sec": 4854.48,
    "end_sec": 4856.08,
    "zh": "还是要少加干涉过去的我",
    "vi": "Vẫn nên ít can thiệp vào tôi của quá khứ."
  },
  {
    "idx": 3021,
    "start": "01:20:56,080",
    "end": "01:20:56,720",
    "start_sec": 4856.08,
    "end_sec": 4856.72,
    "zh": "当然",
    "vi": "Dĩ nhiên."
  },
  {
    "idx": 3022,
    "start": "01:20:56,720",
    "end": "01:20:57,660",
    "start_sec": 4856.72,
    "end_sec": 4857.66,
    "zh": "这只是假设",
    "vi": "Đây chỉ là giả thuyết."
  },
  {
    "idx": 3023,
    "start": "01:20:57,660",
    "end": "01:20:59,040",
    "start_sec": 4857.66,
    "end_sec": 4859.04,
    "zh": "想要证明这种假设",
    "vi": "Muốn chứng minh giả thuyết này."
  },
  {
    "idx": 3024,
    "start": "01:20:59,040",
    "end": "01:21:00,080",
    "start_sec": 4859.04,
    "end_sec": 4860.08,
    "zh": "只有他在死一次",
    "vi": "Chỉ có cách là chết thêm một lần nữa."
  },
  {
    "idx": 3025,
    "start": "01:21:00,080",
    "end": "01:21:01,720",
    "start_sec": 4860.08,
    "end_sec": 4861.72,
    "zh": "但死亡所带来的痛苦",
    "vi": "Nhưng nỗi đau đớn do cái chết mang lại."
  },
  {
    "idx": 3026,
    "start": "01:21:01,720",
    "end": "01:21:02,920",
    "start_sec": 4861.72,
    "end_sec": 4862.92,
    "zh": "经历过鱼死的人",
    "vi": "Người đã từng trải qua cái chết."
  },
  {
    "idx": 3027,
    "start": "01:21:02,920",
    "end": "01:21:04,400",
    "start_sec": 4862.92,
    "end_sec": 4864.4,
    "zh": "谁想再经历第二次",
    "vi": "Ai lại muốn trải qua lần thứ hai chứ."
  },
  {
    "idx": 3028,
    "start": "01:21:04,400",
    "end": "01:21:06,960",
    "start_sec": 4864.4,
    "end_sec": 4866.96,
    "zh": "长子皮从五灵湖光里走过来",
    "vi": "Trần Tử Bì đi ra khỏi khu chung cư Ngũ Linh Hồ Quang."
  },
  {
    "idx": 3029,
    "start": "01:21:06,960",
    "end": "01:21:08,600",
    "start_sec": 4866.96,
    "end_sec": 4868.6,
    "zh": "牵着小莫迪往小区走",
    "vi": "Dắt Tiểu Mạc Địch đi về phía khu nhà."
  },
  {
    "idx": 3030,
    "start": "01:21:08,600",
    "end": "01:21:11,020",
    "start_sec": 4868.6,
    "end_sec": 4871.02,
    "zh": "不管假设是不是真的",
    "vi": "Bất kể giả thuyết có đúng hay không."
  },
  {
    "idx": 3031,
    "start": "01:21:11,020",
    "end": "01:21:14,160",
    "start_sec": 4871.02,
    "end_sec": 4874.16,
    "zh": "总之以后要多带几部手机和充电宝在身上",
    "vi": "Tóm lại sau này phải mang theo nhiều điện thoại và sạc dự phòng bên người."
  },
  {
    "idx": 3032,
    "start": "01:21:14,160",
    "end": "01:21:15,500",
    "start_sec": 4874.16,
    "end_sec": 4875.5,
    "zh": "喂",
    "vi": "Này."
  },
  {
    "idx": 3033,
    "start": "01:21:15,500",
    "end": "01:21:16,740",
    "start_sec": 4875.5,
    "end_sec": 4876.74,
    "zh": "小哥怎么又回来了",
    "vi": "Sao cậu em lại quay lại rồi."
  },
  {
    "idx": 3034,
    "start": "01:21:16,740",
    "end": "01:21:18,520",
    "start_sec": 4876.74,
    "end_sec": 4878.52,
    "zh": "是不是五灵湖光不好用",
    "vi": "Có phải chiếc xe Ngũ Linh không dễ dùng không."
  },
  {
    "idx": 3035,
    "start": "01:21:18,520",
    "end": "01:21:19,680",
    "start_sec": 4878.52,
    "end_sec": 4879.68,
    "zh": "我只要一箱面包",
    "vi": "Tôi chỉ cần một thùng bánh mì."
  },
  {
    "idx": 3036,
    "start": "01:21:19,680",
    "end": "01:21:20,900",
    "start_sec": 4879.68,
    "end_sec": 4880.9,
    "zh": "我给你扒拉美啦",
    "vi": "Tôi đổi cho cậu chiếc Panamera nhé."
  },
  {
    "idx": 3037,
    "start": "01:21:20,900",
    "end": "01:21:22,420",
    "start_sec": 4880.9,
    "end_sec": 4882.42,
    "zh": "我只要一箱饼干",
    "vi": "Tôi chỉ cần một thùng bánh quy."
  },
  {
    "idx": 3038,
    "start": "01:21:22,420",
    "end": "01:21:23,600",
    "start_sec": 4882.42,
    "end_sec": 4883.6,
    "zh": "保时捷行不行",
    "vi": "Xe Porsche được không."
  },
  {
    "idx": 3039,
    "start": "01:21:23,600",
    "end": "01:21:25,220",
    "start_sec": 4883.6,
    "end_sec": 4885.22,
    "zh": "嘻嘻嚷嚷的声音",
    "vi": "Những tiếng ồn ào náo nhiệt."
  },
  {
    "idx": 3040,
    "start": "01:21:25,220",
    "end": "01:21:26,380",
    "start_sec": 4885.22,
    "end_sec": 4886.38,
    "zh": "从楼层中传来",
    "vi": "Truyền ra từ các tầng lầu."
  },
  {
    "idx": 3041,
    "start": "01:21:26,380",
    "end": "01:21:27,560",
    "start_sec": 4886.38,
    "end_sec": 4887.56,
    "zh": "长子皮没有理会",
    "vi": "Trương Tử Bì không thèm để ý."
  },
  {
    "idx": 3042,
    "start": "01:21:27,560",
    "end": "01:21:30,660",
    "start_sec": 4887.56,
    "end_sec": 4890.66,
    "zh": "只是路过当时给自己武林红光的老头家楼下",
    "vi": "Chỉ đi ngang qua dưới lầu nhà ông lão đã đưa chiếc xe Ngũ Linh cho mình khi đó."
  },
  {
    "idx": 3043,
    "start": "01:21:30,660",
    "end": "01:21:31,540",
    "start_sec": 4890.66,
    "end_sec": 4891.54,
    "zh": "抬头看了一眼",
    "vi": "Anh ngẩng đầu lên nhìn một cái."
  },
  {
    "idx": 3044,
    "start": "01:21:31,540",
    "end": "01:21:32,980",
    "start_sec": 4891.54,
    "end_sec": 4892.98,
    "zh": "那老头不知去了哪里",
    "vi": "Không biết ông lão đó đã đi đâu."
  },
  {
    "idx": 3045,
    "start": "01:21:32,980",
    "end": "01:21:34,400",
    "start_sec": 4892.98,
    "end_sec": 4894.4,
    "zh": "屋内依稀能听到呼声",
    "vi": "Trong nhà mơ hồ có thể nghe thấy tiếng ngáy."
  },
  {
    "idx": 3046,
    "start": "01:21:34,400",
    "end": "01:21:37,600",
    "start_sec": 4894.4,
    "end_sec": 4897.6,
    "zh": "而老头楼下的那家屋内传来嘻嘻哈哈的笑声",
    "vi": "Còn căn nhà dưới lầu của ông lão lại truyền ra tiếng cười nói vui vẻ."
  },
  {
    "idx": 3047,
    "start": "01:21:37,600",
    "end": "01:21:39,600",
    "start_sec": 4897.6,
    "end_sec": 4899.6,
    "zh": "长子皮驻足片刻后",
    "vi": "Trương Tử Bì dừng chân một lát."
  },
  {
    "idx": 3048,
    "start": "01:21:39,600",
    "end": "01:21:40,920",
    "start_sec": 4899.6,
    "end_sec": 4900.92,
    "zh": "继续朝自家走",
    "vi": "Rồi tiếp tục đi về phía nhà mình."
  },
  {
    "idx": 3049,
    "start": "01:21:40,920",
    "end": "01:21:43,200",
    "start_sec": 4900.92,
    "end_sec": 4903.2,
    "zh": "801室内三颗脑袋挤在窗口",
    "vi": "Trong căn phòng 801 có ba cái đầu đang chen chúc bên cửa sổ."
  },
  {
    "idx": 3050,
    "start": "01:21:43,200",
    "end": "01:21:44,720",
    "start_sec": 4903.2,
    "end_sec": 4904.72,
    "zh": "一脸狐狸的看着长子皮",
    "vi": "Vẻ mặt nghi ngờ nhìn Trương Tử Bì."
  },
  {
    "idx": 3051,
    "start": "01:21:44,720",
    "end": "01:21:45,300",
    "start_sec": 4904.72,
    "end_sec": 4905.3,
    "zh": "罗姐",
    "vi": "Chị La."
  },
  {
    "idx": 3052,
    "start": "01:21:45,300",
    "end": "01:21:46,800",
    "start_sec": 4905.3,
    "end_sec": 4906.8,
    "zh": "他怎么又回来了",
    "vi": "Sao hắn lại quay lại rồi."
  },
  {
    "idx": 3053,
    "start": "01:21:46,800",
    "end": "01:21:50,180",
    "start_sec": 4906.8,
    "end_sec": 4910.18,
    "zh": "不会是小区外面有黑狗都怕的诡异吧",
    "vi": "Không lẽ bên ngoài khu chung cư có thứ quỷ dị mà ngay cả chó đen cũng sợ sao."
  },
  {
    "idx": 3054,
    "start": "01:21:50,180",
    "end": "01:21:51,320",
    "start_sec": 4910.18,
    "end_sec": 4911.32,
    "zh": "管他那么多",
    "vi": "Kệ xác hắn đi."
  },
  {
    "idx": 3055,
    "start": "01:21:51,320",
    "end": "01:21:52,200",
    "start_sec": 4911.32,
    "end_sec": 4912.2,
    "zh": "既然回来了",
    "vi": "Đã quay lại rồi."
  },
  {
    "idx": 3056,
    "start": "01:21:52,200",
    "end": "01:21:54,300",
    "start_sec": 4912.2,
    "end_sec": 4914.3,
    "zh": "咱们找个时间把他的狗抢了",
    "vi": "Chúng ta tìm lúc nào đó cướp con chó của hắn đi."
  },
  {
    "idx": 3057,
    "start": "01:21:54,300",
    "end": "01:21:54,900",
    "start_sec": 4914.3,
    "end_sec": 4914.9,
    "zh": "赵德柱",
    "vi": "Triệu Đức Trụ."
  },
  {
    "idx": 3058,
    "start": "01:21:54,900",
    "end": "01:21:55,700",
    "start_sec": 4914.9,
    "end_sec": 4915.7,
    "zh": "你敢去吗",
    "vi": "Cậu dám đi không."
  },
  {
    "idx": 3059,
    "start": "01:21:55,700",
    "end": "01:21:56,360",
    "start_sec": 4915.7,
    "end_sec": 4916.36,
    "zh": "敢去的话",
    "vi": "Nếu dám đi."
  },
  {
    "idx": 3060,
    "start": "01:21:56,360",
    "end": "01:21:57,800",
    "start_sec": 4916.36,
    "end_sec": 4917.8,
    "zh": "我们现在就去下楼抢",
    "vi": "Chúng ta xuống lầu cướp ngay bây giờ."
  },
  {
    "idx": 3061,
    "start": "01:21:57,800",
    "end": "01:21:58,380",
    "start_sec": 4917.8,
    "end_sec": 4918.38,
    "zh": "罗姐",
    "vi": "Chị La."
  },
  {
    "idx": 3062,
    "start": "01:21:58,380",
    "end": "01:21:59,380",
    "start_sec": 4918.38,
    "end_sec": 4919.38,
    "zh": "还是算了吧",
    "vi": "Thôi bỏ đi."
  },
  {
    "idx": 3063,
    "start": "01:21:59,380",
    "end": "01:22:00,360",
    "start_sec": 4919.38,
    "end_sec": 4920.36,
    "zh": "他快到家了",
    "vi": "Hắn sắp về đến nhà rồi."
  },
  {
    "idx": 3064,
    "start": "01:22:00,360",
    "end": "01:22:01,660",
    "start_sec": 4920.36,
    "end_sec": 4921.66,
    "zh": "他屋里有鬼啊",
    "vi": "Trong nhà hắn có quỷ đấy."
  },
  {
    "idx": 3065,
    "start": "01:22:01,660",
    "end": "01:22:03,580",
    "start_sec": 4921.66,
    "end_sec": 4923.58,
    "zh": "还是下次等他出门的时候",
    "vi": "Để lần tới khi hắn ra ngoài."
  },
  {
    "idx": 3066,
    "start": "01:22:03,580",
    "end": "01:22:05,480",
    "start_sec": 4923.58,
    "end_sec": 4925.48,
    "zh": "咱们在外面拦住他吧",
    "vi": "Chúng ta chặn hắn ở bên ngoài đi."
  },
  {
    "idx": 3067,
    "start": "01:22:05,480",
    "end": "01:22:07,480",
    "start_sec": 4925.48,
    "end_sec": 4927.48,
    "zh": "周扬是不是",
    "vi": "Chu Dương có phải đang."
  },
  {
    "idx": 3068,
    "start": "01:22:07,480",
    "end": "01:22:08,120",
    "start_sec": 4927.48,
    "end_sec": 4928.12,
    "zh": "夸我的",
    "vi": "Khen tôi không."
  },
  {
    "idx": 3069,
    "start": "01:22:08,120",
    "end": "01:22:09,520",
    "start_sec": 4928.12,
    "end_sec": 4929.52,
    "zh": "永德斯外面这么凶险",
    "vi": "Bên ngoài Vĩnh Đức Tự nguy hiểm thế."
  },
  {
    "idx": 3070,
    "start": "01:22:09,520",
    "end": "01:22:10,740",
    "start_sec": 4929.52,
    "end_sec": 4930.74,
    "zh": "他一点也不和我说",
    "vi": "Mà hắn chẳng nói với tôi câu nào."
  },
  {
    "idx": 3071,
    "start": "01:22:10,740",
    "end": "01:22:13,200",
    "start_sec": 4930.74,
    "end_sec": 4933.2,
    "zh": "长者皮很想对着周扬臭骂一顿",
    "vi": "Trình Bì rất muốn mắng Chu Dương một trận."
  },
  {
    "idx": 3072,
    "start": "01:22:13,200",
    "end": "01:22:14,460",
    "start_sec": 4933.2,
    "end_sec": 4934.46,
    "zh": "但思绪梳理清楚后",
    "vi": "Nhưng sau khi suy nghĩ thông suốt."
  },
  {
    "idx": 3073,
    "start": "01:22:14,460",
    "end": "01:22:15,620",
    "start_sec": 4934.46,
    "end_sec": 4935.62,
    "zh": "他还是放下了手机",
    "vi": "Cậu ta vẫn đặt điện thoại xuống."
  },
  {
    "idx": 3074,
    "start": "01:22:15,620",
    "end": "01:22:17,300",
    "start_sec": 4935.62,
    "end_sec": 4937.3,
    "zh": "永德斯外的未知诡异",
    "vi": "Thứ quỷ dị chưa biết bên ngoài Vĩnh Đức Tự."
  },
  {
    "idx": 3075,
    "start": "01:22:17,300",
    "end": "01:22:19,540",
    "start_sec": 4937.3,
    "end_sec": 4939.54,
    "zh": "能在无形中将人的身体挤压变形",
    "vi": "Có thể vô hình làm cơ thể người biến dạng."
  },
  {
    "idx": 3076,
    "start": "01:22:19,540",
    "end": "01:22:20,540",
    "start_sec": 4939.54,
    "end_sec": 4940.54,
    "zh": "连香炉都不怕",
    "vi": "Ngay cả lư hương cũng không sợ."
  },
  {
    "idx": 3077,
    "start": "01:22:20,540",
    "end": "01:22:22,040",
    "start_sec": 4940.54,
    "end_sec": 4942.04,
    "zh": "等级肯定比敲门鬼要高",
    "vi": "Cấp bậc chắc chắn cao hơn quỷ gõ cửa."
  },
  {
    "idx": 3078,
    "start": "01:22:22,040",
    "end": "01:22:24,360",
    "start_sec": 4942.04,
    "end_sec": 4944.36,
    "zh": "而永德四被称为安全车里点",
    "vi": "Mà Vĩnh Đức Tự được gọi là điểm an toàn."
  },
  {
    "idx": 3079,
    "start": "01:22:24,360",
    "end": "01:22:25,780",
    "start_sec": 4944.36,
    "end_sec": 4945.78,
    "zh": "连无形诡异都不敢进去",
    "vi": "Ngay cả quỷ vô hình cũng không dám vào."
  },
  {
    "idx": 3080,
    "start": "01:22:25,780",
    "end": "01:22:28,060",
    "start_sec": 4945.78,
    "end_sec": 4948.06,
    "zh": "可能里面真的存在周扬叔叔的特殊的人",
    "vi": "Có lẽ bên trong thực sự có người đặc biệt của chú Chu Dương."
  },
  {
    "idx": 3081,
    "start": "01:22:28,060",
    "end": "01:22:29,720",
    "start_sec": 4948.06,
    "end_sec": 4949.72,
    "zh": "想着想着",
    "vi": "Càng nghĩ."
  },
  {
    "idx": 3082,
    "start": "01:22:29,720",
    "end": "01:22:31,060",
    "start_sec": 4949.72,
    "end_sec": 4951.06,
    "zh": "橙子皮陷入了沉默",
    "vi": "Trình Bì càng chìm vào im lặng."
  },
  {
    "idx": 3083,
    "start": "01:22:31,060",
    "end": "01:22:33,020",
    "start_sec": 4951.06,
    "end_sec": 4953.02,
    "zh": "连香炉都无法对抗的诡异",
    "vi": "Thứ quỷ dị mà cả lư hương cũng không đối phó nổi."
  },
  {
    "idx": 3084,
    "start": "01:22:33,020",
    "end": "01:22:33,940",
    "start_sec": 4953.02,
    "end_sec": 4953.94,
    "zh": "他又能做什么",
    "vi": "Thì cậu ta làm được gì."
  },
  {
    "idx": 3085,
    "start": "01:22:33,940",
    "end": "01:22:36,480",
    "start_sec": 4953.94,
    "end_sec": 4956.48,
    "zh": "似乎也只能在小区里混吃等死",
    "vi": "Dường như chỉ có thể ở trong khu chung cư mà sống qua ngày."
  },
  {
    "idx": 3086,
    "start": "01:22:36,480",
    "end": "01:22:38,820",
    "start_sec": 4956.48,
    "end_sec": 4958.82,
    "zh": "毕竟人与诡异的差距还是太大了",
    "vi": "Dù sao khoảng cách giữa người và quỷ vẫn quá lớn."
  },
  {
    "idx": 3087,
    "start": "01:22:38,820",
    "end": "01:22:40,400",
    "start_sec": 4958.82,
    "end_sec": 4960.4,
    "zh": "今天发生的事太多",
    "vi": "Hôm nay xảy ra quá nhiều chuyện."
  },
  {
    "idx": 3088,
    "start": "01:22:40,400",
    "end": "01:22:41,960",
    "start_sec": 4960.4,
    "end_sec": 4961.96,
    "zh": "橙子皮躺在沙发上",
    "vi": "Trình Bì nằm trên ghế sofa."
  },
  {
    "idx": 3089,
    "start": "01:22:41,960",
    "end": "01:22:43,180",
    "start_sec": 4961.96,
    "end_sec": 4963.18,
    "zh": "不知不觉睡了过去",
    "vi": "Rồi chìm vào giấc ngủ lúc nào không hay."
  },
  {
    "idx": 3090,
    "start": "01:22:48,400",
    "end": "01:22:49,280",
    "start_sec": 4968.4,
    "end_sec": 4969.28,
    "zh": "天已经黑了",
    "vi": "Trời đã tối rồi."
  },
  {
    "idx": 3091,
    "start": "01:22:49,280",
    "end": "01:22:50,920",
    "start_sec": 4969.28,
    "end_sec": 4970.92,
    "zh": "橙子皮被小莫去吵醒",
    "vi": "Trần Tử Bì bị Tiểu Mạc đánh thức"
  },
  {
    "idx": 3092,
    "start": "01:22:50,920",
    "end": "01:22:52,440",
    "start_sec": 4970.92,
    "end_sec": 4972.44,
    "zh": "本能的从沙发上过去",
    "vi": "Theo bản năng nhảy khỏi ghế sofa"
  },
  {
    "idx": 3093,
    "start": "01:22:52,440",
    "end": "01:22:54,020",
    "start_sec": 4972.44,
    "end_sec": 4974.02,
    "zh": "卧槽",
    "vi": "Chết tiệt"
  },
  {
    "idx": 3094,
    "start": "01:22:54,020",
    "end": "01:22:56,980",
    "start_sec": 4974.02,
    "end_sec": 4976.98,
    "zh": "敲门鬼再次出现",
    "vi": "Kẻ gõ cửa lại xuất hiện"
  },
  {
    "idx": 3095,
    "start": "01:22:56,980",
    "end": "01:22:58,680",
    "start_sec": 4976.98,
    "end_sec": 4978.68,
    "zh": "直接以人形走出厨房",
    "vi": "Trực tiếp bước ra từ bếp dưới hình dạng con người"
  },
  {
    "idx": 3096,
    "start": "01:22:58,680",
    "end": "01:22:59,800",
    "start_sec": 4978.68,
    "end_sec": 4979.8,
    "zh": "而不是以往那般",
    "vi": "Chứ không phải như mọi khi"
  },
  {
    "idx": 3097,
    "start": "01:22:59,800",
    "end": "01:23:01,620",
    "start_sec": 4979.8,
    "end_sec": 4981.62,
    "zh": "由黑影慢慢转变成人形",
    "vi": "Từ bóng đen từ từ biến thành hình người"
  },
  {
    "idx": 3098,
    "start": "01:23:01,620",
    "end": "01:23:03,520",
    "start_sec": 4981.62,
    "end_sec": 4983.52,
    "zh": "小诺记对着敲门鬼狂吠",
    "vi": "Tiểu Nặc Ký sủa vang về phía kẻ gõ cửa"
  },
  {
    "idx": 3099,
    "start": "01:23:03,520",
    "end": "01:23:04,680",
    "start_sec": 4983.52,
    "end_sec": 4984.68,
    "zh": "然而敲门鬼",
    "vi": "Thế nhưng kẻ gõ cửa"
  },
  {
    "idx": 3100,
    "start": "01:23:04,680",
    "end": "01:23:05,400",
    "start_sec": 4984.68,
    "end_sec": 4985.4,
    "zh": "竟然一声",
    "vi": "Lại không hề"
  },
  {
    "idx": 3101,
    "start": "01:23:05,400",
    "end": "01:23:06,320",
    "start_sec": 4985.4,
    "end_sec": 4986.32,
    "zh": "也不怕小诺记",
    "vi": "Sợ Tiểu Nặc Ký"
  },
  {
    "idx": 3102,
    "start": "01:23:06,320",
    "end": "01:23:08,160",
    "start_sec": 4986.32,
    "end_sec": 4988.16,
    "zh": "朝着小诺记一点点靠近",
    "vi": "Từ từ tiến lại gần Tiểu Nặc Ký"
  },
  {
    "idx": 3103,
    "start": "01:23:08,160",
    "end": "01:23:09,620",
    "start_sec": 4988.16,
    "end_sec": 4989.62,
    "zh": "不对",
    "vi": "Không đúng"
  },
  {
    "idx": 3104,
    "start": "01:23:09,620",
    "end": "01:23:11,600",
    "start_sec": 4989.62,
    "end_sec": 4991.6,
    "zh": "敲门鬼不是也怕黑主的吗",
    "vi": "Kẻ gõ cửa không phải cũng sợ chó đen sao"
  },
  {
    "idx": 3105,
    "start": "01:23:11,600",
    "end": "01:23:13,480",
    "start_sec": 4991.6,
    "end_sec": 4993.48,
    "zh": "之前不就是跳过了801是吗",
    "vi": "Lần trước không phải đã bỏ qua 801 rồi sao"
  },
  {
    "idx": 3106,
    "start": "01:23:13,480",
    "end": "01:23:14,920",
    "start_sec": 4993.48,
    "end_sec": 4994.92,
    "zh": "成个皮赖不及多想",
    "vi": "Trần Tử Bì không kịp suy nghĩ nhiều"
  },
  {
    "idx": 3107,
    "start": "01:23:14,920",
    "end": "01:23:17,140",
    "start_sec": 4994.92,
    "end_sec": 4997.14,
    "zh": "赶紧将香炉摆在客厅桌子上",
    "vi": "Nhanh chóng đặt lư hương lên bàn phòng khách"
  },
  {
    "idx": 3108,
    "start": "01:23:17,140",
    "end": "01:23:18,580",
    "start_sec": 4997.14,
    "end_sec": 4998.58,
    "zh": "连忙抱着小诺记后退",
    "vi": "Vội ôm Tiểu Nặc Ký lùi lại"
  },
  {
    "idx": 3109,
    "start": "01:23:18,580",
    "end": "01:23:21,780",
    "start_sec": 4998.58,
    "end_sec": 5001.78,
    "zh": "下一步",
    "vi": "Bước tiếp theo"
  },
  {
    "idx": 3110,
    "start": "01:23:21,780",
    "end": "01:23:23,300",
    "start_sec": 5001.78,
    "end_sec": 5003.3,
    "zh": "三人组发出一声响响",
    "vi": "Ba người phát ra một tiếng động lớn"
  },
  {
    "idx": 3111,
    "start": "01:23:23,300",
    "end": "01:23:25,320",
    "start_sec": 5003.3,
    "end_sec": 5005.32,
    "zh": "像是感受到这么恐怖的存在",
    "vi": "Như thể cảm nhận được sự tồn tại đáng sợ này"
  },
  {
    "idx": 3112,
    "start": "01:23:25,320",
    "end": "01:23:26,440",
    "start_sec": 5005.32,
    "end_sec": 5006.44,
    "zh": "匆匆走出101",
    "vi": "Vội vã rời khỏi 101"
  },
  {
    "idx": 3113,
    "start": "01:23:26,440",
    "end": "01:23:27,540",
    "start_sec": 5006.44,
    "end_sec": 5007.54,
    "zh": "再也不敢停留",
    "vi": "Không dám nán lại nữa"
  },
  {
    "idx": 3114,
    "start": "01:23:27,540",
    "end": "01:23:29,160",
    "start_sec": 5007.54,
    "end_sec": 5009.16,
    "zh": "为什么会变得不怕黑狗了",
    "vi": "Tại sao lại không sợ chó đen nữa"
  },
  {
    "idx": 3115,
    "start": "01:23:29,160",
    "end": "01:23:30,520",
    "start_sec": 5009.16,
    "end_sec": 5010.52,
    "zh": "难道说是变强了",
    "vi": "Chẳng lẽ nó mạnh lên rồi"
  },
  {
    "idx": 3116,
    "start": "01:23:30,520",
    "end": "01:23:31,000",
    "start_sec": 5010.52,
    "end_sec": 5011.0,
    "zh": "敲门鬼",
    "vi": "Kẻ gõ cửa"
  },
  {
    "idx": 3117,
    "start": "01:23:31,000",
    "end": "01:23:32,360",
    "start_sec": 5011.0,
    "end_sec": 5012.36,
    "zh": "每晚都会杀一栋楼的人",
    "vi": "Mỗi đêm đều giết một tòa nhà"
  },
  {
    "idx": 3118,
    "start": "01:23:32,360",
    "end": "01:23:33,840",
    "start_sec": 5012.36,
    "end_sec": 5013.84,
    "zh": "他已经杀了三栋楼的人",
    "vi": "Nó đã giết người của ba tòa nhà rồi"
  },
  {
    "idx": 3119,
    "start": "01:23:33,840",
    "end": "01:23:35,420",
    "start_sec": 5013.84,
    "end_sec": 5015.42,
    "zh": "鬼杀人会变强吗",
    "vi": "Ma giết người có mạnh lên không"
  },
  {
    "idx": 3120,
    "start": "01:23:35,420",
    "end": "01:23:36,680",
    "start_sec": 5015.42,
    "end_sec": 5016.68,
    "zh": "照这样下去的话",
    "vi": "Nếu cứ tiếp tục thế này"
  },
  {
    "idx": 3121,
    "start": "01:23:36,680",
    "end": "01:23:37,620",
    "start_sec": 5016.68,
    "end_sec": 5017.62,
    "zh": "别说黑狗",
    "vi": "Đừng nói là chó đen."
  },
  {
    "idx": 3122,
    "start": "01:23:37,620",
    "end": "01:23:39,320",
    "start_sec": 5017.62,
    "end_sec": 5019.32,
    "zh": "就是香炉也镇压不住啊",
    "vi": "Ngay cả lư hương cũng không trấn áp nổi."
  },
  {
    "idx": 3123,
    "start": "01:23:39,320",
    "end": "01:23:39,920",
    "start_sec": 5019.32,
    "end_sec": 5019.92,
    "zh": "下午时",
    "vi": "Chiều nay."
  },
  {
    "idx": 3124,
    "start": "01:23:39,920",
    "end": "01:23:41,000",
    "start_sec": 5019.92,
    "end_sec": 5021.0,
    "zh": "橙子皮还无奈",
    "vi": "Trần Tử Bì còn bất lực."
  },
  {
    "idx": 3125,
    "start": "01:23:41,000",
    "end": "01:23:42,840",
    "start_sec": 5021.0,
    "end_sec": 5022.84,
    "zh": "只能狗在房间里混吃等死",
    "vi": "Chỉ có thể trốn trong phòng sống qua ngày chờ chết."
  },
  {
    "idx": 3126,
    "start": "01:23:42,840",
    "end": "01:23:43,620",
    "start_sec": 5022.84,
    "end_sec": 5023.62,
    "zh": "现在看来",
    "vi": "Giờ xem ra."
  },
  {
    "idx": 3127,
    "start": "01:23:43,620",
    "end": "01:23:44,620",
    "start_sec": 5023.62,
    "end_sec": 5024.62,
    "zh": "诡异也在进化",
    "vi": "Sự quỷ dị cũng đang tiến hóa."
  },
  {
    "idx": 3128,
    "start": "01:23:44,620",
    "end": "01:23:46,020",
    "start_sec": 5024.62,
    "end_sec": 5026.02,
    "zh": "他连混吃等死都不能",
    "vi": "Anh ta đến cả sống qua ngày chờ chết cũng không được nữa."
  },
  {
    "idx": 3129,
    "start": "01:23:46,020",
    "end": "01:23:46,720",
    "start_sec": 5026.02,
    "end_sec": 5026.72,
    "zh": "看来",
    "vi": "Xem ra."
  },
  {
    "idx": 3130,
    "start": "01:23:46,720",
    "end": "01:23:47,780",
    "start_sec": 5026.72,
    "end_sec": 5027.78,
    "zh": "明天要再出趟门",
    "vi": "Ngày mai phải ra ngoài một chuyến."
  },
  {
    "idx": 3131,
    "start": "01:23:47,780",
    "end": "01:23:48,920",
    "start_sec": 5027.78,
    "end_sec": 5028.92,
    "zh": "既然有的四不能去",
    "vi": "Vì có những ngôi chùa không thể đi."
  },
  {
    "idx": 3132,
    "start": "01:23:48,920",
    "end": "01:23:50,540",
    "start_sec": 5028.92,
    "end_sec": 5030.54,
    "zh": "或许可以去市区别的角落看看",
    "vi": "Có lẽ có thể đến những góc khác trong thành phố xem sao."
  },
  {
    "idx": 3133,
    "start": "01:23:50,540",
    "end": "01:23:51,400",
    "start_sec": 5030.54,
    "end_sec": 5031.4,
    "zh": "寻找线索",
    "vi": "Tìm kiếm manh mối."
  },
  {
    "idx": 3134,
    "start": "01:23:51,400",
    "end": "01:23:55,860",
    "start_sec": 5031.4,
    "end_sec": 5035.86,
    "zh": "畜生啊",
    "vi": "Lũ súc sinh."
  },
  {
    "idx": 3135,
    "start": "01:23:55,860",
    "end": "01:23:58,120",
    "start_sec": 5035.86,
    "end_sec": 5038.12,
    "zh": "两箱食物都抢走了",
    "vi": "Cướp mất cả hai thùng thức ăn rồi."
  },
  {
    "idx": 3136,
    "start": "01:23:58,120",
    "end": "01:23:59,620",
    "start_sec": 5038.12,
    "end_sec": 5039.62,
    "zh": "那可是救命的",
    "vi": "Đó là đồ cứu mạng mà."
  },
  {
    "idx": 3137,
    "start": "01:23:59,620",
    "end": "01:24:01,140",
    "start_sec": 5039.62,
    "end_sec": 5041.14,
    "zh": "老伴啊",
    "vi": "Bà nó ơi."
  },
  {
    "idx": 3138,
    "start": "01:24:01,140",
    "end": "01:24:02,580",
    "start_sec": 5041.14,
    "end_sec": 5042.58,
    "zh": "是我没用了",
    "vi": "Là tôi vô dụng."
  },
  {
    "idx": 3139,
    "start": "01:24:02,580",
    "end": "01:24:04,000",
    "start_sec": 5042.58,
    "end_sec": 5044.0,
    "zh": "我对不住你",
    "vi": "Tôi có lỗi với bà."
  },
  {
    "idx": 3140,
    "start": "01:24:04,000",
    "end": "01:24:05,540",
    "start_sec": 5044.0,
    "end_sec": 5045.54,
    "zh": "既然你走了",
    "vi": "Giờ bà đã đi rồi."
  },
  {
    "idx": 3141,
    "start": "01:24:05,540",
    "end": "01:24:07,160",
    "start_sec": 5045.54,
    "end_sec": 5047.16,
    "zh": "我也不活了",
    "vi": "Tôi cũng không sống nữa."
  },
  {
    "idx": 3142,
    "start": "01:24:07,160",
    "end": "01:24:08,440",
    "start_sec": 5047.16,
    "end_sec": 5048.44,
    "zh": "老大爷呜咽着",
    "vi": "Ông lão nghẹn ngào."
  },
  {
    "idx": 3143,
    "start": "01:24:08,440",
    "end": "01:24:10,540",
    "start_sec": 5048.44,
    "end_sec": 5050.54,
    "zh": "他向先前吊拉泡面箱的横子",
    "vi": "Ông ấy nhìn về phía sợi dây trước đó dùng để kéo thùng mì ăn liền."
  },
  {
    "idx": 3144,
    "start": "01:24:10,540",
    "end": "01:24:11,840",
    "start_sec": 5050.54,
    "end_sec": 5051.84,
    "zh": "脸色坚硬",
    "vi": "Vẻ mặt đờ đẫn."
  },
  {
    "idx": 3145,
    "start": "01:24:11,840",
    "end": "01:24:13,680",
    "start_sec": 5051.84,
    "end_sec": 5053.68,
    "zh": "将横子缠绕着吊扇上",
    "vi": "Quấn sợi dây lên quạt trần."
  },
  {
    "idx": 3146,
    "start": "01:24:13,680",
    "end": "01:24:16,060",
    "start_sec": 5053.68,
    "end_sec": 5056.06,
    "zh": "老大爷悲愤的听着楼下的笑声",
    "vi": "Ông lão căm phẫn lắng nghe tiếng cười dưới lầu."
  },
  {
    "idx": 3147,
    "start": "01:24:16,060",
    "end": "01:24:16,600",
    "start_sec": 5056.06,
    "end_sec": 5056.6,
    "zh": "前生",
    "vi": "Nói khẽ."
  },
  {
    "idx": 3148,
    "start": "01:24:16,600",
    "end": "01:24:32,440",
    "start_sec": 5056.6,
    "end_sec": 5072.44,
    "zh": "妈 灭好了没",
    "vi": "Mẹ ơi, mì chín chưa."
  },
  {
    "idx": 3149,
    "start": "01:24:32,440",
    "end": "01:24:33,260",
    "start_sec": 5072.44,
    "end_sec": 5073.26,
    "zh": "急什么",
    "vi": "Vội gì chứ."
  },
  {
    "idx": 3150,
    "start": "01:24:33,260",
    "end": "01:24:35,220",
    "start_sec": 5073.26,
    "end_sec": 5075.22,
    "zh": "咱们可是有两大箱子呢",
    "vi": "Chúng ta có tận hai thùng lớn cơ mà."
  },
  {
    "idx": 3151,
    "start": "01:24:35,220",
    "end": "01:24:35,860",
    "start_sec": 5075.22,
    "end_sec": 5075.86,
    "zh": "慢慢吃",
    "vi": "Ăn từ từ thôi."
  },
  {
    "idx": 3152,
    "start": "01:24:35,860",
    "end": "01:24:37,780",
    "start_sec": 5075.86,
    "end_sec": 5077.78,
    "zh": "说不定还能等来救援呢",
    "vi": "Biết đâu còn đợi được cứu hộ đấy."
  },
  {
    "idx": 3153,
    "start": "01:24:37,780",
    "end": "01:24:38,420",
    "start_sec": 5077.78,
    "end_sec": 5078.42,
    "zh": "得了吧",
    "vi": "Thôi đi."
  },
  {
    "idx": 3154,
    "start": "01:24:38,420",
    "end": "01:24:39,100",
    "start_sec": 5078.42,
    "end_sec": 5079.1,
    "zh": "还救援",
    "vi": "Cứu hộ gì chứ."
  },
  {
    "idx": 3155,
    "start": "01:24:39,100",
    "end": "01:24:40,260",
    "start_sec": 5079.1,
    "end_sec": 5080.26,
    "zh": "人都死完了吧",
    "vi": "Người ta chết hết cả rồi."
  },
  {
    "idx": 3156,
    "start": "01:24:40,260",
    "end": "01:24:41,740",
    "start_sec": 5080.26,
    "end_sec": 5081.74,
    "zh": "我看还不如有机会",
    "vi": "Tôi thấy chi bằng tìm cơ hội."
  },
  {
    "idx": 3157,
    "start": "01:24:41,740",
    "end": "01:24:43,180",
    "start_sec": 5081.74,
    "end_sec": 5083.18,
    "zh": "把那小子的黑狗抢来",
    "vi": "Cướp con chó đen của thằng nhóc kia."
  },
  {
    "idx": 3158,
    "start": "01:24:43,180",
    "end": "01:24:44,320",
    "start_sec": 5083.18,
    "end_sec": 5084.32,
    "zh": "什么都靠谱",
    "vi": "Còn thực tế hơn nhiều."
  },
  {
    "idx": 3159,
    "start": "01:24:44,320",
    "end": "01:24:45,780",
    "start_sec": 5084.32,
    "end_sec": 5085.78,
    "zh": "你说的倒好听",
    "vi": "Bạn nói nghe thì hay lắm."
  },
  {
    "idx": 3160,
    "start": "01:24:45,780",
    "end": "01:24:46,900",
    "start_sec": 5085.78,
    "end_sec": 5086.9,
    "zh": "你敢下楼啊",
    "vi": "Bạn dám xuống lầu không."
  },
  {
    "idx": 3161,
    "start": "01:24:46,900",
    "end": "01:24:47,700",
    "start_sec": 5086.9,
    "end_sec": 5087.7,
    "zh": "我说",
    "vi": "Tôi nói này."
  },
  {
    "idx": 3162,
    "start": "01:24:47,700",
    "end": "01:24:50,160",
    "start_sec": 5087.7,
    "end_sec": 5090.16,
    "zh": "咱们把别人吃的全抢了",
    "vi": "Chúng ta cướp hết đồ ăn của người khác."
  },
  {
    "idx": 3163,
    "start": "01:24:50,160",
    "end": "01:24:51,460",
    "start_sec": 5090.16,
    "end_sec": 5091.46,
    "zh": "是不是不太好",
    "vi": "Liệu có không tốt lắm không."
  },
  {
    "idx": 3164,
    "start": "01:24:51,460",
    "end": "01:24:53,240",
    "start_sec": 5091.46,
    "end_sec": 5093.24,
    "zh": "我记得那老头的老伴",
    "vi": "Tôi nhớ vợ của ông lão đó."
  },
  {
    "idx": 3165,
    "start": "01:24:53,240",
    "end": "01:24:54,981",
    "start_sec": 5093.24,
    "end_sec": 5094.981,
    "zh": "身体不太好来着你不吃这个东西你关心他们他们关心你要不送两包上去吧小壮你刚刚还打了那大爷实在是",
    "vi": "Sức khỏe không được tốt lắm"
  },
  {
    "idx": 3165,
    "start": "01:24:54,981",
    "end": "01:24:59,334",
    "start_sec": 5094.981,
    "end_sec": 5099.334,
    "zh": "身体不太好来着你不吃这个东西你关心他们他们关心你要不送两包上去吧小壮你刚刚还打了那大爷实在是",
    "vi": "Không ăn thì thôi, quan tâm họ làm gì, họ có quan tâm mình đâu"
  },
  {
    "idx": 3165,
    "start": "01:24:59,334",
    "end": "01:25:01,365",
    "start_sec": 5099.334,
    "end_sec": 5101.365,
    "zh": "身体不太好来着你不吃这个东西你关心他们他们关心你要不送两包上去吧小壮你刚刚还打了那大爷实在是",
    "vi": "Hay là mang hai gói lên đi"
  },
  {
    "idx": 3165,
    "start": "01:25:01,365",
    "end": "01:25:05,137",
    "start_sec": 5101.365,
    "end_sec": 5105.137,
    "zh": "身体不太好来着你不吃这个东西你关心他们他们关心你要不送两包上去吧小壮你刚刚还打了那大爷实在是",
    "vi": "Tiểu Tráng, lúc nãy con còn đánh ông ấy, thật là quá đáng"
  },
  {
    "idx": 3166,
    "start": "01:25:05,137",
    "end": "01:25:06,177",
    "start_sec": 5105.137,
    "end_sec": 5106.177,
    "zh": "送什么送",
    "vi": "Mang cái gì mà mang."
  },
  {
    "idx": 3167,
    "start": "01:25:06,177",
    "end": "01:25:08,117",
    "start_sec": 5106.177,
    "end_sec": 5108.117,
    "zh": "他刚刚来敲门要食物",
    "vi": "Lão ta vừa mới gõ cửa xin thức ăn."
  },
  {
    "idx": 3168,
    "start": "01:25:08,117",
    "end": "01:25:09,357",
    "start_sec": 5108.117,
    "end_sec": 5109.357,
    "zh": "我没打断他的腿",
    "vi": "Tôi không đánh gãy chân lão."
  },
  {
    "idx": 3169,
    "start": "01:25:09,357",
    "end": "01:25:10,577",
    "start_sec": 5109.357,
    "end_sec": 5110.577,
    "zh": "已经算好的了",
    "vi": "Đã là may lắm rồi."
  },
  {
    "idx": 3170,
    "start": "01:25:10,577",
    "end": "01:25:12,717",
    "start_sec": 5110.577,
    "end_sec": 5112.717,
    "zh": "谁敲门了",
    "vi": "Ai gõ cửa thế."
  },
  {
    "idx": 3171,
    "start": "01:25:12,717",
    "end": "01:25:14,057",
    "start_sec": 5112.717,
    "end_sec": 5114.057,
    "zh": "不会是那老头",
    "vi": "Không lẽ là ông lão đó."
  },
  {
    "idx": 3172,
    "start": "01:25:14,057",
    "end": "01:25:15,437",
    "start_sec": 5114.057,
    "end_sec": 5115.437,
    "zh": "又来要食物了吧",
    "vi": "Lại đến xin thức ăn à."
  },
  {
    "idx": 3173,
    "start": "01:25:15,437",
    "end": "01:25:16,637",
    "start_sec": 5115.437,
    "end_sec": 5116.637,
    "zh": "死老头",
    "vi": "Lão già chết tiệt."
  },
  {
    "idx": 3174,
    "start": "01:25:16,637",
    "end": "01:25:17,457",
    "start_sec": 5116.637,
    "end_sec": 5117.457,
    "zh": "你还敢来",
    "vi": "Ông còn dám đến à."
  },
  {
    "idx": 3175,
    "start": "01:25:17,457",
    "end": "01:25:18,157",
    "start_sec": 5117.457,
    "end_sec": 5118.157,
    "zh": "都说了",
    "vi": "Đã bảo rồi."
  },
  {
    "idx": 3176,
    "start": "01:25:18,157",
    "end": "01:25:19,057",
    "start_sec": 5118.157,
    "end_sec": 5119.057,
    "zh": "吃的谁拿到",
    "vi": "Đồ ăn ai lấy được."
  },
  {
    "idx": 3177,
    "start": "01:25:19,057",
    "end": "01:25:19,837",
    "start_sec": 5119.057,
    "end_sec": 5119.837,
    "zh": "就是谁的",
    "vi": "Thì là của người đó."
  },
  {
    "idx": 3178,
    "start": "01:25:19,837",
    "end": "01:25:22,897",
    "start_sec": 5119.837,
    "end_sec": 5122.897,
    "zh": "你笑个屁的笑",
    "vi": "Cười cái gì mà cười."
  },
  {
    "idx": 3179,
    "start": "01:25:22,897",
    "end": "01:25:24,497",
    "start_sec": 5122.897,
    "end_sec": 5124.497,
    "zh": "脸黑的跟个鬼似的",
    "vi": "Mặt đen như quỷ vậy."
  },
  {
    "idx": 3180,
    "start": "01:25:24,497",
    "end": "01:25:26,497",
    "start_sec": 5124.497,
    "end_sec": 5126.497,
    "zh": "家里死人了是吧",
    "vi": "Nhà có tang hay sao thế."
  },
  {
    "idx": 3181,
    "start": "01:25:29,897",
    "end": "01:25:31,897",
    "start_sec": 5129.897,
    "end_sec": 5131.897,
    "zh": "我 我 救命 救命",
    "vi": "Tôi tôi cứu tôi với cứu tôi với."
  },
  {
    "idx": 3182,
    "start": "01:25:33,197",
    "end": "01:25:34,197",
    "start_sec": 5133.197,
    "end_sec": 5134.197,
    "zh": "几个老公似的",
    "vi": "Giống như mấy người chồng vậy."
  },
  {
    "idx": 3183,
    "start": "01:25:34,197",
    "end": "01:25:35,197",
    "start_sec": 5134.197,
    "end_sec": 5135.197,
    "zh": "一口状错了",
    "vi": "Cắn nhầm một cái rồi."
  },
  {
    "idx": 3184,
    "start": "01:25:35,197",
    "end": "01:25:37,197",
    "start_sec": 5135.197,
    "end_sec": 5137.197,
    "zh": "放开 放开",
    "vi": "Buông ra buông ra."
  },
  {
    "idx": 3185,
    "start": "01:25:38,197",
    "end": "01:25:39,197",
    "start_sec": 5138.197,
    "end_sec": 5139.197,
    "zh": "没成功了",
    "vi": "Không thành công rồi."
  },
  {
    "idx": 3186,
    "start": "01:25:39,197",
    "end": "01:25:41,197",
    "start_sec": 5139.197,
    "end_sec": 5141.197,
    "zh": "怎么会 怎么会",
    "vi": "Sao lại thế sao lại thế."
  },
  {
    "idx": 3187,
    "start": "01:25:47,797",
    "end": "01:25:49,097",
    "start_sec": 5147.797,
    "end_sec": 5149.097,
    "zh": "从林平小区出去",
    "vi": "Đi ra từ khu chung cư Lâm Bình."
  },
  {
    "idx": 3188,
    "start": "01:25:49,097",
    "end": "01:25:50,397",
    "start_sec": 5149.097,
    "end_sec": 5150.397,
    "zh": "往右可以去永德寺",
    "vi": "Rẽ phải có thể đến chùa Vĩnh Đức."
  },
  {
    "idx": 3189,
    "start": "01:25:50,397",
    "end": "01:25:51,897",
    "start_sec": 5150.397,
    "end_sec": 5151.897,
    "zh": "反之可以出城市",
    "vi": "Ngược lại thì có thể ra khỏi thành phố."
  },
  {
    "idx": 3190,
    "start": "01:25:51,897",
    "end": "01:25:52,697",
    "start_sec": 5151.897,
    "end_sec": 5152.697,
    "zh": "周扬说过",
    "vi": "Chu Dương từng nói."
  },
  {
    "idx": 3191,
    "start": "01:25:52,697",
    "end": "01:25:53,997",
    "start_sec": 5152.697,
    "end_sec": 5153.997,
    "zh": "南城河有一艘大船",
    "vi": "Sông Nam Thành có một con thuyền lớn."
  },
  {
    "idx": 3192,
    "start": "01:25:53,997",
    "end": "01:25:55,397",
    "start_sec": 5153.997,
    "end_sec": 5155.397,
    "zh": "专门负责保护高层人员",
    "vi": "Chuyên phụ trách bảo vệ nhân sự cấp cao."
  },
  {
    "idx": 3193,
    "start": "01:25:55,397",
    "end": "01:25:57,537",
    "start_sec": 5155.397,
    "end_sec": 5157.537,
    "zh": "如果能去那里的话",
    "vi": "Nếu có thể đến đó."
  },
  {
    "idx": 3194,
    "start": "01:25:57,537",
    "end": "01:25:59,717",
    "start_sec": 5157.537,
    "end_sec": 5159.717,
    "zh": "只是该怎么去呢",
    "vi": "Nhưng làm sao để đi đây."
  },
  {
    "idx": 3195,
    "start": "01:25:59,717",
    "end": "01:26:00,797",
    "start_sec": 5159.717,
    "end_sec": 5160.797,
    "zh": "单单一个勇的四",
    "vi": "Chỉ riêng chùa Vĩnh Đức."
  },
  {
    "idx": 3196,
    "start": "01:26:00,797",
    "end": "01:26:01,917",
    "start_sec": 5160.797,
    "end_sec": 5161.917,
    "zh": "我都没办法进去",
    "vi": "Tôi còn không có cách nào vào được."
  },
  {
    "idx": 3197,
    "start": "01:26:01,917",
    "end": "01:26:02,817",
    "start_sec": 5161.917,
    "end_sec": 5162.817,
    "zh": "我出去来乘客",
    "vi": "Tôi mà đi ra ngoài."
  },
  {
    "idx": 3198,
    "start": "01:26:02,817",
    "end": "01:26:04,517",
    "start_sec": 5162.817,
    "end_sec": 5164.517,
    "zh": "一路上还不知道有多少诡异",
    "vi": "Trên đường đi còn không biết có bao nhiêu thứ kỳ quái."
  },
  {
    "idx": 3199,
    "start": "01:26:04,517",
    "end": "01:26:06,097",
    "start_sec": 5164.517,
    "end_sec": 5166.097,
    "zh": "长子皮这么想着",
    "vi": "Trương Tử Bì đang nghĩ như vậy."
  },
  {
    "idx": 3200,
    "start": "01:26:06,097",
    "end": "01:26:07,917",
    "start_sec": 5166.097,
    "end_sec": 5167.917,
    "zh": "突然从外传来一声嘈杂",
    "vi": "Đột nhiên từ bên ngoài truyền đến tiếng ồn ào."
  },
  {
    "idx": 3201,
    "start": "01:26:07,917",
    "end": "01:26:08,977",
    "start_sec": 5167.917,
    "end_sec": 5168.977,
    "zh": "我靠",
    "vi": "Chết tiệt."
  },
  {
    "idx": 3202,
    "start": "01:26:08,977",
    "end": "01:26:11,257",
    "start_sec": 5168.977,
    "end_sec": 5171.257,
    "zh": "怎么大晚上的又有人出门了",
    "vi": "Sao đêm hôm thế này lại có người ra ngoài rồi."
  },
  {
    "idx": 3203,
    "start": "01:26:11,257",
    "end": "01:26:12,757",
    "start_sec": 5171.257,
    "end_sec": 5172.757,
    "zh": "喂 大爷",
    "vi": "Này ông cụ."
  },
  {
    "idx": 3204,
    "start": "01:26:12,757",
    "end": "01:26:14,797",
    "start_sec": 5172.757,
    "end_sec": 5174.797,
    "zh": "你出去怎么没事啊",
    "vi": "Ông đi ra ngoài sao lại không sao thế."
  },
  {
    "idx": 3205,
    "start": "01:26:14,797",
    "end": "01:26:17,357",
    "start_sec": 5174.797,
    "end_sec": 5177.357,
    "zh": "这次是大爷鸽公追手",
    "vi": "Lần này là ông cụ ra tay từ xa."
  },
  {
    "idx": 3206,
    "start": "01:26:17,357",
    "end": "01:26:19,417",
    "start_sec": 5177.357,
    "end_sec": 5179.417,
    "zh": "一条吊船",
    "vi": "Một con thuyền treo."
  },
  {
    "idx": 3207,
    "start": "01:26:19,417",
    "end": "01:26:20,797",
    "start_sec": 5179.417,
    "end_sec": 5180.797,
    "zh": "不顾下的青年魔子",
    "vi": "Trói chặt chàng thanh niên."
  },
  {
    "idx": 3208,
    "start": "01:26:20,797",
    "end": "01:26:22,917",
    "start_sec": 5180.797,
    "end_sec": 5182.917,
    "zh": "救命 救命",
    "vi": "Cứu tôi với cứu tôi với."
  },
  {
    "idx": 3209,
    "start": "01:26:22,917",
    "end": "01:26:28,157",
    "start_sec": 5182.917,
    "end_sec": 5188.157,
    "zh": "这不是给我武林宏光的大爷",
    "vi": "Đây chẳng phải là ông cụ lái chiếc xe Ngũ Lăng Hồng Quang sao."
  },
  {
    "idx": 3210,
    "start": "01:26:28,157",
    "end": "01:26:29,757",
    "start_sec": 5188.157,
    "end_sec": 5189.757,
    "zh": "怎么会变成鬼医了",
    "vi": "Sao lại biến thành thứ kỳ quái thế này."
  },
  {
    "idx": 3211,
    "start": "01:26:29,757",
    "end": "01:26:30,557",
    "start_sec": 5189.757,
    "end_sec": 5190.557,
    "zh": "该死了",
    "vi": "Chết tiệt thật."
  },
  {
    "idx": 3212,
    "start": "01:26:30,557",
    "end": "01:26:31,097",
    "start_sec": 5190.557,
    "end_sec": 5191.097,
    "zh": "敲门鬼",
    "vi": "Quỷ gõ cửa."
  },
  {
    "idx": 3213,
    "start": "01:26:31,097",
    "end": "01:26:32,397",
    "start_sec": 5191.097,
    "end_sec": 5192.397,
    "zh": "爬行女鬼就算了",
    "vi": "Nữ quỷ bò lê lết đã đành."
  },
  {
    "idx": 3214,
    "start": "01:26:32,397",
    "end": "01:26:33,357",
    "start_sec": 5192.397,
    "end_sec": 5193.357,
    "zh": "现在又多出来一个",
    "vi": "Bây giờ lại xuất hiện thêm một con nữa."
  },
  {
    "idx": 3215,
    "start": "01:26:33,357",
    "end": "01:26:35,697",
    "start_sec": 5193.357,
    "end_sec": 5195.697,
    "zh": "为什么大爷会变成鬼医呢",
    "vi": "Tại sao ông lão lại biến thành quỷ y chứ."
  },
  {
    "idx": 3216,
    "start": "01:26:35,697",
    "end": "01:26:37,357",
    "start_sec": 5195.697,
    "end_sec": 5197.357,
    "zh": "那他是不是也会持续变强",
    "vi": "Vậy có phải ông ta cũng sẽ liên tục mạnh lên không."
  },
  {
    "idx": 3217,
    "start": "01:26:37,357",
    "end": "01:26:38,257",
    "start_sec": 5197.357,
    "end_sec": 5198.257,
    "zh": "但这鬼",
    "vi": "Nhưng con quỷ này."
  },
  {
    "idx": 3218,
    "start": "01:26:38,257",
    "end": "01:26:40,057",
    "start_sec": 5198.257,
    "end_sec": 5200.057,
    "zh": "如果小区的人全被杀完",
    "vi": "Nếu người trong khu chung cư bị giết sạch."
  },
  {
    "idx": 3219,
    "start": "01:26:40,057",
    "end": "01:26:41,937",
    "start_sec": 5200.057,
    "end_sec": 5201.937,
    "zh": "香炉黑狗还能扛得住吗",
    "vi": "Thì lư hương và con chó đen liệu có chống đỡ nổi không."
  },
  {
    "idx": 3220,
    "start": "01:26:41,937",
    "end": "01:26:44,397",
    "start_sec": 5201.937,
    "end_sec": 5204.397,
    "zh": "听着哒哒哒的脚步声",
    "vi": "Nghe tiếng bước chân cộc cộc cộc."
  },
  {
    "idx": 3221,
    "start": "01:26:44,397",
    "end": "01:26:47,257",
    "start_sec": 5204.397,
    "end_sec": 5207.257,
    "zh": "橙子皮知道那大爷此时坐在自己身上",
    "vi": "Trần Tử Bì biết ông lão lúc này đang đứng ngoài cửa nhà mình."
  },
  {
    "idx": 3222,
    "start": "01:26:47,257",
    "end": "01:26:49,177",
    "start_sec": 5207.257,
    "end_sec": 5209.177,
    "zh": "好在是有香炉和黑狗",
    "vi": "May mà có lư hương và con chó đen."
  },
  {
    "idx": 3223,
    "start": "01:26:49,177",
    "end": "01:26:51,057",
    "start_sec": 5209.177,
    "end_sec": 5211.057,
    "zh": "他没敢靠近又匆匆离开",
    "vi": "Ông ta không dám lại gần rồi vội vã rời đi."
  },
  {
    "idx": 3224,
    "start": "01:26:51,057",
    "end": "01:26:55,017",
    "start_sec": 5211.057,
    "end_sec": 5215.017,
    "zh": "似乎大爷的警部有雷函",
    "vi": "Dường như trên cổ của ông lão có vết siết cổ."
  },
  {
    "idx": 3225,
    "start": "01:26:55,017",
    "end": "01:26:57,297",
    "start_sec": 5215.017,
    "end_sec": 5217.297,
    "zh": "是他杀还是说是杀",
    "vi": "Là bị sát hại hay là tự sát."
  },
  {
    "idx": 3226,
    "start": "01:26:57,297",
    "end": "01:26:59,417",
    "start_sec": 5217.297,
    "end_sec": 5219.417,
    "zh": "结合今天听到大爷家的呼声",
    "vi": "Kết hợp với tiếng khóc nghe được từ nhà ông lão hôm nay."
  },
  {
    "idx": 3227,
    "start": "01:26:59,417",
    "end": "01:27:00,817",
    "start_sec": 5219.417,
    "end_sec": 5220.817,
    "zh": "以及他楼下的笑声",
    "vi": "Cũng như tiếng cười ở tầng dưới của ông ta."
  },
  {
    "idx": 3228,
    "start": "01:27:00,817",
    "end": "01:27:02,137",
    "start_sec": 5220.817,
    "end_sec": 5222.137,
    "zh": "橙子平眼眼起来",
    "vi": "Trần Tử Bì nheo mắt lại."
  },
  {
    "idx": 3229,
    "start": "01:27:02,137",
    "end": "01:27:03,477",
    "start_sec": 5222.137,
    "end_sec": 5223.477,
    "zh": "食物被抢",
    "vi": "Thức ăn bị cướp đoạt."
  },
  {
    "idx": 3230,
    "start": "01:27:03,477",
    "end": "01:27:05,257",
    "start_sec": 5223.477,
    "end_sec": 5225.257,
    "zh": "老白雷士含糊自杀",
    "vi": "Ông lão treo cổ tự sát vì uất ức."
  },
  {
    "idx": 3231,
    "start": "01:27:05,257",
    "end": "01:27:06,757",
    "start_sec": 5225.257,
    "end_sec": 5226.757,
    "zh": "不会是海运很自杀",
    "vi": "Chẳng lẽ cứ ôm hận tự sát."
  },
  {
    "idx": 3232,
    "start": "01:27:06,757",
    "end": "01:27:08,097",
    "start_sec": 5226.757,
    "end_sec": 5228.097,
    "zh": "也有几率变成鬼吧",
    "vi": "Thì cũng có tỉ lệ biến thành quỷ sao."
  },
  {
    "idx": 3233,
    "start": "01:27:08,097",
    "end": "01:27:10,517",
    "start_sec": 5228.097,
    "end_sec": 5230.517,
    "zh": "这一夜橙子提睡的很晚",
    "vi": "Đêm nay Trần Tử Bì ngủ rất muộn."
  },
  {
    "idx": 3234,
    "start": "01:27:10,517",
    "end": "01:27:12,397",
    "start_sec": 5230.517,
    "end_sec": 5232.397,
    "zh": "一是要策划明天出门线路",
    "vi": "Một là phải lên kế hoạch cho tuyến đường ra ngoài ngày mai."
  },
  {
    "idx": 3235,
    "start": "01:27:12,397",
    "end": "01:27:14,057",
    "start_sec": 5232.397,
    "end_sec": 5234.057,
    "zh": "二是给个新的鬼医增加",
    "vi": "Hai là vì sự xuất hiện của con quỷ y mới."
  },
  {
    "idx": 3236,
    "start": "01:27:14,057",
    "end": "01:27:16,637",
    "start_sec": 5234.057,
    "end_sec": 5236.637,
    "zh": "让海人听闻的惨叫声更加的灵感",
    "vi": "Khiến những tiếng la hét thảm thiết rợn người càng thêm dồn dập."
  },
  {
    "idx": 3237,
    "start": "01:27:16,637",
    "end": "01:27:20,257",
    "start_sec": 5236.637,
    "end_sec": 5240.257,
    "zh": "简单说完早饭后",
    "vi": "Sau khi ăn xong bữa sáng đơn giản."
  },
  {
    "idx": 3238,
    "start": "01:27:20,257",
    "end": "01:27:22,197",
    "start_sec": 5240.257,
    "end_sec": 5242.197,
    "zh": "橙子皮牵着小墨迹出了门",
    "vi": "Trần Tử Bì dắt Tiểu Mặc Tích đi ra ngoài."
  },
  {
    "idx": 3239,
    "start": "01:27:22,197",
    "end": "01:27:24,457",
    "start_sec": 5242.197,
    "end_sec": 5244.457,
    "zh": "今天是阴雨间",
    "vi": "Hôm nay là một ngày âm u và có mưa."
  },
  {
    "idx": 3240,
    "start": "01:27:24,457",
    "end": "01:27:25,837",
    "start_sec": 5244.457,
    "end_sec": 5245.837,
    "zh": "小雨淅淅沥沥下着",
    "vi": "Cơn mưa nhỏ đang rơi lất phất."
  },
  {
    "idx": 3241,
    "start": "01:27:25,837",
    "end": "01:27:27,577",
    "start_sec": 5245.837,
    "end_sec": 5247.577,
    "zh": "难得天空不再是红色",
    "vi": "Hiếm khi bầu trời không còn là màu đỏ."
  },
  {
    "idx": 3242,
    "start": "01:27:27,577",
    "end": "01:27:29,137",
    "start_sec": 5247.577,
    "end_sec": 5249.137,
    "zh": "在小区里此即如水",
    "vi": "Trong khu chung cư yên tĩnh như tờ."
  },
  {
    "idx": 3243,
    "start": "01:27:29,137",
    "end": "01:27:31,897",
    "start_sec": 5249.137,
    "end_sec": 5251.897,
    "zh": "橙子皮抬头看了看周围楼洞",
    "vi": "Trần Tử Bì ngẩng đầu nhìn quanh các lối vào tòa nhà."
  },
  {
    "idx": 3244,
    "start": "01:27:31,897",
    "end": "01:27:34,437",
    "start_sec": 5251.897,
    "end_sec": 5254.437,
    "zh": "已经看不到那些探头打量外界的人",
    "vi": "Đã không còn thấy những người thò đầu ra quan sát thế giới bên ngoài nữa."
  },
  {
    "idx": 3245,
    "start": "01:27:34,437",
    "end": "01:27:35,577",
    "start_sec": 5254.437,
    "end_sec": 5255.577,
    "zh": "该死的末日",
    "vi": "Thời tận thế chết tiệt."
  },
  {
    "idx": 3246,
    "start": "01:27:35,577",
    "end": "01:27:38,677",
    "start_sec": 5255.577,
    "end_sec": 5258.677,
    "zh": "这已经不知道是橙子皮自己是骂出这句话",
    "vi": "Đây đã không biết là lần thứ bao nhiêu Trần Tử Bì tự mắng câu này rồi."
  },
  {
    "idx": 3247,
    "start": "01:27:38,677",
    "end": "01:27:39,777",
    "start_sec": 5258.677,
    "end_sec": 5259.777,
    "zh": "橙子皮",
    "vi": "Trần Tử Bì."
  },
  {
    "idx": 3248,
    "start": "01:27:39,777",
    "end": "01:27:40,437",
    "start_sec": 5259.777,
    "end_sec": 5260.437,
    "zh": "站住",
    "vi": "Đứng lại."
  },
  {
    "idx": 3249,
    "start": "01:27:40,437",
    "end": "01:27:42,097",
    "start_sec": 5260.437,
    "end_sec": 5262.097,
    "zh": "我说你们想干嘛",
    "vi": "Tao nói này, chúng mày muốn làm gì thế."
  },
  {
    "idx": 3250,
    "start": "01:27:42,097",
    "end": "01:27:42,737",
    "start_sec": 5262.097,
    "end_sec": 5262.737,
    "zh": "都末世了",
    "vi": "Đã là tận thế rồi."
  },
  {
    "idx": 3251,
    "start": "01:27:42,737",
    "end": "01:27:43,737",
    "start_sec": 5262.737,
    "end_sec": 5263.737,
    "zh": "还搞打劫制一趟",
    "vi": "Mà còn bày đặt đi ăn cướp nữa à."
  },
  {
    "idx": 3252,
    "start": "01:27:43,737",
    "end": "01:27:44,837",
    "start_sec": 5263.737,
    "end_sec": 5264.837,
    "zh": "我身上可没钱",
    "vi": "Trên người tao không có tiền đâu."
  },
  {
    "idx": 3253,
    "start": "01:27:44,837",
    "end": "01:27:46,237",
    "start_sec": 5264.837,
    "end_sec": 5266.237,
    "zh": "谁要你的钱了",
    "vi": "Ai thèm tiền của mày chứ."
  },
  {
    "idx": 3254,
    "start": "01:27:46,237",
    "end": "01:27:46,437",
    "start_sec": 5266.237,
    "end_sec": 5266.437,
    "zh": "对",
    "vi": "Đúng thế."
  },
  {
    "idx": 3255,
    "start": "01:27:46,437",
    "end": "01:27:47,857",
    "start_sec": 5266.437,
    "end_sec": 5267.857,
    "zh": "我们要的是你的黑狗",
    "vi": "Thứ bọn tao muốn là con chó đen của mày."
  },
  {
    "idx": 3256,
    "start": "01:27:47,857",
    "end": "01:27:49,697",
    "start_sec": 5267.857,
    "end_sec": 5269.697,
    "zh": "那小白脸晃着手中的刀",
    "vi": "Tên mặt trắng kia khua khua con dao trong tay."
  },
  {
    "idx": 3257,
    "start": "01:27:49,697",
    "end": "01:27:50,777",
    "start_sec": 5269.697,
    "end_sec": 5270.777,
    "zh": "慢慢拨进城里",
    "vi": "từ từ tiến sát lại gần Trần Tử Bì."
  },
  {
    "idx": 3258,
    "start": "01:27:50,777",
    "end": "01:27:52,117",
    "start_sec": 5270.777,
    "end_sec": 5272.117,
    "zh": "把你的狗留下",
    "vi": "Để con chó của mày lại."
  },
  {
    "idx": 3259,
    "start": "01:27:52,117",
    "end": "01:27:52,677",
    "start_sec": 5272.117,
    "end_sec": 5272.677,
    "zh": "不然",
    "vi": "Nếu không thì."
  },
  {
    "idx": 3260,
    "start": "01:27:52,677",
    "end": "01:27:56,637",
    "start_sec": 5272.677,
    "end_sec": 5276.637,
    "zh": "橙子皮像看傻的一样看着几人",
    "vi": "Trần Tử Bì nhìn mấy người đó như nhìn lũ ngốc."
  },
  {
    "idx": 3261,
    "start": "01:27:56,637",
    "end": "01:27:59,477",
    "start_sec": 5276.637,
    "end_sec": 5279.477,
    "zh": "觉得自己跟他们仿佛身处在不同的世界里",
    "vi": "Cảm thấy bản thân và họ như đang ở hai thế giới khác nhau."
  },
  {
    "idx": 3262,
    "start": "01:27:59,477",
    "end": "01:28:01,497",
    "start_sec": 5279.477,
    "end_sec": 5281.497,
    "zh": "他现在想的是怎样离开小区",
    "vi": "Điều anh đang nghĩ bây giờ là làm sao để rời khỏi khu chung cư."
  },
  {
    "idx": 3263,
    "start": "01:28:01,497",
    "end": "01:28:03,117",
    "start_sec": 5281.497,
    "end_sec": 5283.117,
    "zh": "怎样规避或者说应对",
    "vi": "Làm sao để né tránh hoặc đối phó."
  },
  {
    "idx": 3264,
    "start": "01:28:03,117",
    "end": "01:28:04,837",
    "start_sec": 5283.117,
    "end_sec": 5284.837,
    "zh": "以后位置的更强的诡异",
    "vi": "với những thứ quỷ dị mạnh hơn chưa biết trước trong tương lai."
  },
  {
    "idx": 3265,
    "start": "01:28:04,837",
    "end": "01:28:06,157",
    "start_sec": 5284.837,
    "end_sec": 5286.157,
    "zh": "而他们三人的逻辑",
    "vi": "Còn logic của ba người họ."
  },
  {
    "idx": 3266,
    "start": "01:28:06,157",
    "end": "01:28:07,937",
    "start_sec": 5286.157,
    "end_sec": 5287.937,
    "zh": "只是在小区里面混吃等死",
    "vi": "chỉ là sống vất vưởng chờ chết trong khu chung cư."
  },
  {
    "idx": 3267,
    "start": "01:28:07,937",
    "end": "01:28:10,297",
    "start_sec": 5287.937,
    "end_sec": 5290.297,
    "zh": "以为有了黑狗就能在末世存活下去",
    "vi": "nghĩ rằng có con chó đen là có thể sống sót qua thời tận thế."
  },
  {
    "idx": 3268,
    "start": "01:28:10,297",
    "end": "01:28:12,077",
    "start_sec": 5290.297,
    "end_sec": 5292.077,
    "zh": "倒也不至于在他们这段时间",
    "vi": "Cũng không đến mức phải lãng phí thời gian với họ."
  },
  {
    "idx": 3269,
    "start": "01:28:12,077",
    "end": "01:28:14,197",
    "start_sec": 5292.077,
    "end_sec": 5294.197,
    "zh": "今天的目的是打探城市里的情况",
    "vi": "Mục tiêu hôm nay là dò la tình hình trong thành phố."
  },
  {
    "idx": 3270,
    "start": "01:28:14,197",
    "end": "01:28:15,617",
    "start_sec": 5294.197,
    "end_sec": 5295.617,
    "zh": "一去到了某些凶险的地方",
    "vi": "và đi đến một số nơi nguy hiểm."
  },
  {
    "idx": 3271,
    "start": "01:28:15,617",
    "end": "01:28:16,997",
    "start_sec": 5295.617,
    "end_sec": 5296.997,
    "zh": "我也不方便照顾小木鸡",
    "vi": "Tôi cũng không tiện chăm sóc Tiểu Ma Cơ."
  },
  {
    "idx": 3272,
    "start": "01:28:16,997",
    "end": "01:28:18,197",
    "start_sec": 5296.997,
    "end_sec": 5298.197,
    "zh": "有香炉就够了",
    "vi": "Có lư hương là đủ rồi."
  },
  {
    "idx": 3273,
    "start": "01:28:18,197",
    "end": "01:28:19,777",
    "start_sec": 5298.197,
    "end_sec": 5299.777,
    "zh": "但是把小磨叽放他们这也行",
    "vi": "Nhưng để Tiểu Ma Cơ ở chỗ họ cũng được."
  },
  {
    "idx": 3274,
    "start": "01:28:19,777",
    "end": "01:28:21,397",
    "start_sec": 5299.777,
    "end_sec": 5301.397,
    "zh": "他们现在要依靠黑狗保命",
    "vi": "Bây giờ họ phải dựa vào con chó đen để giữ mạng."
  },
  {
    "idx": 3275,
    "start": "01:28:21,397",
    "end": "01:28:22,317",
    "start_sec": 5301.397,
    "end_sec": 5302.317,
    "zh": "倒是不用担心",
    "vi": "Nên không cần phải lo lắng."
  },
  {
    "idx": 3276,
    "start": "01:28:22,317",
    "end": "01:28:23,437",
    "start_sec": 5302.317,
    "end_sec": 5303.437,
    "zh": "他们会越在小磨叽",
    "vi": "Họ sẽ bắt nạt Tiểu Ma Cơ."
  },
  {
    "idx": 3277,
    "start": "01:28:23,437",
    "end": "01:28:24,897",
    "start_sec": 5303.437,
    "end_sec": 5304.897,
    "zh": "反而会当大爷一样供着",
    "vi": "Ngược lại họ sẽ cung phụng nó như ông hoàng."
  },
  {
    "idx": 3278,
    "start": "01:28:24,897",
    "end": "01:28:27,857",
    "start_sec": 5304.897,
    "end_sec": 5307.857,
    "zh": "山人面面相见",
    "vi": "Ba người nhìn nhau ngơ ngác."
  },
  {
    "idx": 3279,
    "start": "01:28:27,857",
    "end": "01:28:29,937",
    "start_sec": 5307.857,
    "end_sec": 5309.937,
    "zh": "没想到长子皮给的如此手段",
    "vi": "Không ngờ Trưởng Tử Bì lại có thủ đoạn như thế này."
  },
  {
    "idx": 3280,
    "start": "01:28:29,937",
    "end": "01:28:33,157",
    "start_sec": 5309.937,
    "end_sec": 5313.157,
    "zh": "帮我照顾好小磨叽",
    "vi": "Hãy giúp tôi chăm sóc tốt cho Tiểu Ma Cơ."
  },
  {
    "idx": 3281,
    "start": "01:28:33,157",
    "end": "01:28:34,477",
    "start_sec": 5313.157,
    "end_sec": 5314.477,
    "zh": "晚上我会回来接他",
    "vi": "Buổi tối tôi sẽ quay lại đón nó."
  },
  {
    "idx": 3282,
    "start": "01:28:34,477",
    "end": "01:28:35,537",
    "start_sec": 5314.477,
    "end_sec": 5315.537,
    "zh": "你在想屁事",
    "vi": "Bạn đang mơ tưởng đấy à."
  },
  {
    "idx": 3283,
    "start": "01:28:35,537",
    "end": "01:28:36,817",
    "start_sec": 5315.537,
    "end_sec": 5316.817,
    "zh": "你不看我贼肉黑狗",
    "vi": "Nếu bạn không để con chó đen lại."
  },
  {
    "idx": 3284,
    "start": "01:28:36,817",
    "end": "01:28:38,257",
    "start_sec": 5316.817,
    "end_sec": 5318.257,
    "zh": "我看你活不过心啊",
    "vi": "Tôi thấy bạn không sống nổi qua tối nay đâu."
  },
  {
    "idx": 3285,
    "start": "01:28:38,257",
    "end": "01:28:40,497",
    "start_sec": 5318.257,
    "end_sec": 5320.497,
    "zh": "对于磨叽等人三番五次的挑衅",
    "vi": "Đối với sự khiêu khích năm lần bảy lượt của nhóm Ma Cơ."
  },
  {
    "idx": 3286,
    "start": "01:28:40,497",
    "end": "01:28:42,277",
    "start_sec": 5320.497,
    "end_sec": 5322.277,
    "zh": "长子皮一定无法容忍",
    "vi": "Trưởng Tử Bì chắc chắn không thể dung thứ."
  },
  {
    "idx": 3287,
    "start": "01:28:42,277",
    "end": "01:28:43,157",
    "start_sec": 5322.277,
    "end_sec": 5323.157,
    "zh": "反正能跟着我",
    "vi": "Dù sao thì đi theo tôi."
  },
  {
    "idx": 3288,
    "start": "01:28:43,157",
    "end": "01:28:46,977",
    "start_sec": 5323.157,
    "end_sec": 5326.977,
    "zh": "你们有取死之道",
    "vi": "Các bạn chỉ có con đường chết."
  },
  {
    "idx": 3289,
    "start": "01:28:46,977",
    "end": "01:28:48,837",
    "start_sec": 5326.977,
    "end_sec": 5328.837,
    "zh": "等我晚上回来",
    "vi": "Đợi tối nay tôi quay lại."
  },
  {
    "idx": 3290,
    "start": "01:28:48,837",
    "end": "01:28:49,597",
    "start_sec": 5328.837,
    "end_sec": 5329.597,
    "zh": "走",
    "vi": "Đi thôi."
  },
  {
    "idx": 3291,
    "start": "01:28:49,597",
    "end": "01:28:50,597",
    "start_sec": 5329.597,
    "end_sec": 5330.597,
    "zh": "杀",
    "vi": "Giết."
  },
  {
    "idx": 3292,
    "start": "01:28:50,597",
    "end": "01:28:51,577",
    "start_sec": 5330.597,
    "end_sec": 5331.577,
    "zh": "了",
    "vi": "Chết."
  },
  {
    "idx": 3293,
    "start": "01:28:51,577",
    "end": "01:28:54,257",
    "start_sec": 5331.577,
    "end_sec": 5334.257,
    "zh": "出了小区",
    "vi": "Sau khi ra khỏi khu chung cư."
  },
  {
    "idx": 3294,
    "start": "01:28:54,257",
    "end": "01:28:55,537",
    "start_sec": 5334.257,
    "end_sec": 5335.537,
    "zh": "坐上武林红光",
    "vi": "Chúng tôi bước lên chiếc xe Wuling Hongguang."
  },
  {
    "idx": 3295,
    "start": "01:28:55,537",
    "end": "01:28:57,457",
    "start_sec": 5335.537,
    "end_sec": 5337.457,
    "zh": "车子往小区另一边开去",
    "vi": "Chiếc xe chạy về phía bên kia của khu chung cư."
  },
  {
    "idx": 3296,
    "start": "01:28:57,457",
    "end": "01:28:59,457",
    "start_sec": 5337.457,
    "end_sec": 5339.457,
    "zh": "城市的街道上",
    "vi": "Trên những con đường của thành phố."
  },
  {
    "idx": 3297,
    "start": "01:28:59,457",
    "end": "01:29:00,917",
    "start_sec": 5339.457,
    "end_sec": 5340.917,
    "zh": "偶有车祸的车辆之流",
    "vi": "Thỉnh thoảng có những chiếc xe bị tai nạn nằm chắn ngang."
  },
  {
    "idx": 3298,
    "start": "01:29:00,917",
    "end": "01:29:02,377",
    "start_sec": 5340.917,
    "end_sec": 5342.377,
    "zh": "但活人却不介意的",
    "vi": "Nhưng tuyệt nhiên không thấy bóng dáng người sống nào."
  },
  {
    "idx": 3299,
    "start": "01:29:02,377",
    "end": "01:29:03,857",
    "start_sec": 5342.377,
    "end_sec": 5343.857,
    "zh": "按照地址一路前行",
    "vi": "Chúng tôi tiếp tục đi theo địa chỉ."
  },
  {
    "idx": 3300,
    "start": "01:29:03,857",
    "end": "01:29:05,837",
    "start_sec": 5343.857,
    "end_sec": 5345.837,
    "zh": "车子开到了城区的边缘",
    "vi": "Chiếc xe đã chạy đến rìa thành phố."
  },
  {
    "idx": 3301,
    "start": "01:29:05,837",
    "end": "01:29:06,357",
    "start_sec": 5345.837,
    "end_sec": 5346.357,
    "zh": "他以为",
    "vi": "Anh ta nghĩ rằng"
  },
  {
    "idx": 3302,
    "start": "01:29:06,357",
    "end": "01:29:08,457",
    "start_sec": 5346.357,
    "end_sec": 5348.457,
    "zh": "应该是可以一帆风顺的出城了",
    "vi": "có thể thuận lợi rời khỏi thành phố rồi."
  },
  {
    "idx": 3303,
    "start": "01:29:08,457",
    "end": "01:29:10,497",
    "start_sec": 5348.457,
    "end_sec": 5350.497,
    "zh": "但是让橙子皮想不到的是",
    "vi": "Nhưng điều Trần Tử Bì không ngờ tới là"
  },
  {
    "idx": 3304,
    "start": "01:29:10,497",
    "end": "01:29:11,757",
    "start_sec": 5350.497,
    "end_sec": 5351.757,
    "zh": "城外的南城河",
    "vi": "con sông Nam Thành ở ngoại ô"
  },
  {
    "idx": 3305,
    "start": "01:29:11,757",
    "end": "01:29:13,557",
    "start_sec": 5351.757,
    "end_sec": 5353.557,
    "zh": "河水居然淹到了路道上",
    "vi": "nước sông đã ngập lên cả mặt đường."
  },
  {
    "idx": 3306,
    "start": "01:29:13,557",
    "end": "01:29:14,217",
    "start_sec": 5353.557,
    "end_sec": 5354.217,
    "zh": "深不可见",
    "vi": "Sâu không thấy đáy."
  },
  {
    "idx": 3307,
    "start": "01:29:14,217",
    "end": "01:29:15,317",
    "start_sec": 5354.217,
    "end_sec": 5355.317,
    "zh": "路怎么都淹了",
    "vi": "Sao đường lại bị ngập hết thế này."
  },
  {
    "idx": 3308,
    "start": "01:29:15,317",
    "end": "01:29:17,877",
    "start_sec": 5355.317,
    "end_sec": 5357.877,
    "zh": "看样子应该是鬼一张眼前就开始涨水",
    "vi": "Trông thế này chắc là nước đã bắt đầu dâng lên từ trước khi Quỷ Nhất Trương đến."
  },
  {
    "idx": 3309,
    "start": "01:29:17,877",
    "end": "01:29:19,177",
    "start_sec": 5357.877,
    "end_sec": 5359.177,
    "zh": "为什么没收到消息呢",
    "vi": "Sao lại không nhận được tin tức gì nhỉ."
  },
  {
    "idx": 3310,
    "start": "01:29:19,177",
    "end": "01:29:21,717",
    "start_sec": 5359.177,
    "end_sec": 5361.717,
    "zh": "本来还想着到南城河附近打探打探情况",
    "vi": "Vốn dĩ định đến gần sông Nam Thành để dò la tình hình"
  },
  {
    "idx": 3311,
    "start": "01:29:21,717",
    "end": "01:29:23,057",
    "start_sec": 5361.717,
    "end_sec": 5363.057,
    "zh": "看样子是没法去了",
    "vi": "xem ra là không đi được nữa rồi."
  },
  {
    "idx": 3312,
    "start": "01:29:23,057",
    "end": "01:29:25,037",
    "start_sec": 5363.057,
    "end_sec": 5365.037,
    "zh": "南城河涨水消息却没放出",
    "vi": "Sông Nam Thành dâng nước nhưng lại không có tin tức gì truyền ra"
  },
  {
    "idx": 3313,
    "start": "01:29:25,037",
    "end": "01:29:26,597",
    "start_sec": 5365.037,
    "end_sec": 5366.597,
    "zh": "里面应该是有引擎",
    "vi": "bên trong chắc chắn có ẩn tình."
  },
  {
    "idx": 3314,
    "start": "01:29:26,597",
    "end": "01:29:28,537",
    "start_sec": 5366.597,
    "end_sec": 5368.537,
    "zh": "橙子皮懊恼的拍了排放向盘",
    "vi": "Trần Tử Bì bực bội đập tay lên vô lăng"
  },
  {
    "idx": 3315,
    "start": "01:29:28,537",
    "end": "01:29:29,917",
    "start_sec": 5368.537,
    "end_sec": 5369.917,
    "zh": "朝着原路返回",
    "vi": "rồi quay xe trở về đường cũ."
  },
  {
    "idx": 3316,
    "start": "01:29:29,917",
    "end": "01:29:30,537",
    "start_sec": 5369.917,
    "end_sec": 5370.537,
    "zh": "哎",
    "vi": "Ôi."
  },
  {
    "idx": 3317,
    "start": "01:29:30,537",
    "end": "01:29:32,397",
    "start_sec": 5370.537,
    "end_sec": 5372.397,
    "zh": "看来今天又是出心无辜的一天",
    "vi": "Xem ra hôm nay lại là một ngày công cốc rồi."
  },
  {
    "idx": 3318,
    "start": "01:29:32,397",
    "end": "01:29:34,317",
    "start_sec": 5372.397,
    "end_sec": 5374.317,
    "zh": "就在橙子皮路过医院时",
    "vi": "Ngay khi Trần Tử Bì đi ngang qua bệnh viện"
  },
  {
    "idx": 3319,
    "start": "01:29:34,317",
    "end": "01:29:37,377",
    "start_sec": 5374.317,
    "end_sec": 5377.377,
    "zh": "发现一辆还未熄火的车子在院门口停着",
    "vi": "phát hiện một chiếc xe chưa tắt máy đang đỗ ở cổng viện."
  },
  {
    "idx": 3320,
    "start": "01:29:37,377",
    "end": "01:29:38,717",
    "start_sec": 5377.377,
    "end_sec": 5378.717,
    "zh": "一气能听到叫喊声",
    "vi": "Loáng thoáng có thể nghe thấy tiếng la hét."
  },
  {
    "idx": 3321,
    "start": "01:29:38,717",
    "end": "01:29:40,437",
    "start_sec": 5378.717,
    "end_sec": 5380.437,
    "zh": "他思索片刻绕过医院",
    "vi": "Anh suy nghĩ một lát rồi đi vòng qua bệnh viện"
  },
  {
    "idx": 3322,
    "start": "01:29:40,437",
    "end": "01:29:42,057",
    "start_sec": 5380.437,
    "end_sec": 5382.057,
    "zh": "将车子停在树丛后面",
    "vi": "đỗ xe vào sau bụi cây."
  },
  {
    "idx": 3323,
    "start": "01:29:42,057",
    "end": "01:29:44,097",
    "start_sec": 5382.057,
    "end_sec": 5384.097,
    "zh": "随后从包里逃出望远镜",
    "vi": "Sau đó anh lấy kính viễn vọng từ trong túi ra."
  },
  {
    "idx": 3324,
    "start": "01:29:45,317",
    "end": "01:29:47,877",
    "start_sec": 5385.317,
    "end_sec": 5387.877,
    "zh": "保持理智,我们已经找到了注射剂了。",
    "vi": "Hãy giữ lý trí, chúng ta đã tìm thấy thuốc tiêm rồi."
  },
  {
    "idx": 3325,
    "start": "01:29:48,317",
    "end": "01:29:54,253",
    "start_sec": 5388.317,
    "end_sec": 5394.253,
    "zh": "透过居用望远镜,成德皮可以清晰地看到几个身穿制服的人围着一个光着榜歌的男子,而那男子的头发似乎在以肉眼可见的速度生长。要,要。0你一定要往前清醒我们这就给你重生当来人别碰我",
    "vi": "Qua kính viễn vọng quân sự, Trần Tử Bì có thể nhìn thấy rõ ràng vài người mặc đồng phục đang vây quanh một người"
  },
  {
    "idx": 3325,
    "start": "01:29:54,253",
    "end": "01:30:00,188",
    "start_sec": 5394.253,
    "end_sec": 5400.188,
    "zh": "透过居用望远镜,成德皮可以清晰地看到几个身穿制服的人围着一个光着榜歌的男子,而那男子的头发似乎在以肉眼可见的速度生长。要,要。0你一定要往前清醒我们这就给你重生当来人别碰我",
    "vi": "đàn ông cởi trần, tóc của người đàn ông đó dường như đang dài ra với tốc độ có thể nhìn thấy bằng mắt thường"
  },
  {
    "idx": 3325,
    "start": "01:30:00,188",
    "end": "01:30:00,663",
    "start_sec": 5400.188,
    "end_sec": 5400.663,
    "zh": "透过居用望远镜,成德皮可以清晰地看到几个身穿制服的人围着一个光着榜歌的男子,而那男子的头发似乎在以肉眼可见的速度生长。要,要。0你一定要往前清醒我们这就给你重生当来人别碰我",
    "vi": "Thuốc, thuốc"
  },
  {
    "idx": 3325,
    "start": "01:30:00,663",
    "end": "01:30:04,224",
    "start_sec": 5400.663,
    "end_sec": 5404.224,
    "zh": "透过居用望远镜,成德皮可以清晰地看到几个身穿制服的人围着一个光着榜歌的男子,而那男子的头发似乎在以肉眼可见的速度生长。要,要。0你一定要往前清醒我们这就给你重生当来人别碰我",
    "vi": "Bạn nhất định phải giữ tỉnh táo, chúng tôi sẽ tiêm cho bạn ngay đây"
  },
  {
    "idx": 3325,
    "start": "01:30:04,224",
    "end": "01:30:05,174",
    "start_sec": 5404.224,
    "end_sec": 5405.174,
    "zh": "透过居用望远镜,成德皮可以清晰地看到几个身穿制服的人围着一个光着榜歌的男子,而那男子的头发似乎在以肉眼可见的速度生长。要,要。0你一定要往前清醒我们这就给你重生当来人别碰我",
    "vi": "Đừng chạm vào tôi"
  },
  {
    "idx": 3326,
    "start": "01:30:05,174",
    "end": "01:30:06,754",
    "start_sec": 5405.174,
    "end_sec": 5406.754,
    "zh": "那男子不仅头发在生长",
    "vi": "Người đàn ông đó không chỉ tóc đang dài ra"
  },
  {
    "idx": 3327,
    "start": "01:30:06,754",
    "end": "01:30:08,274",
    "start_sec": 5406.754,
    "end_sec": 5408.274,
    "zh": "就连声音也变得尖锐",
    "vi": "mà ngay cả giọng nói cũng trở nên chói tai."
  },
  {
    "idx": 3328,
    "start": "01:30:08,274",
    "end": "01:30:11,134",
    "start_sec": 5408.274,
    "end_sec": 5411.134,
    "zh": "037",
    "vi": "Không ba bảy."
  },
  {
    "idx": 3329,
    "start": "01:30:11,134",
    "end": "01:30:18,454",
    "start_sec": 5411.134,
    "end_sec": 5418.454,
    "zh": "不吵头发也可以杀人",
    "vi": "Không ngờ tóc cũng có thể giết người."
  },
  {
    "idx": 3330,
    "start": "01:30:18,454",
    "end": "01:30:19,634",
    "start_sec": 5418.454,
    "end_sec": 5419.634,
    "zh": "037",
    "vi": "Không ba bảy."
  },
  {
    "idx": 3331,
    "start": "01:30:19,634",
    "end": "01:30:21,614",
    "start_sec": 5419.634,
    "end_sec": 5421.614,
    "zh": "037保持理智",
    "vi": "Không ba bảy hãy giữ lý trí."
  },
  {
    "idx": 3332,
    "start": "01:30:21,614",
    "end": "01:30:23,714",
    "start_sec": 5421.614,
    "end_sec": 5423.714,
    "zh": "上下几人被这一幕",
    "vi": "Mấy người xung quanh bị cảnh tượng này"
  },
  {
    "idx": 3333,
    "start": "01:30:23,714",
    "end": "01:30:24,934",
    "start_sec": 5423.714,
    "end_sec": 5424.934,
    "zh": "吓得谁也不敢上线",
    "vi": "dọa cho không ai dám tiến lên."
  },
  {
    "idx": 3334,
    "start": "01:30:24,934",
    "end": "01:30:25,714",
    "start_sec": 5424.934,
    "end_sec": 5425.714,
    "zh": "这是",
    "vi": "Đây là"
  },
  {
    "idx": 3335,
    "start": "01:30:25,714",
    "end": "01:30:27,474",
    "start_sec": 5425.714,
    "end_sec": 5427.474,
    "zh": "严康奇猛然抬起脸",
    "vi": "Nghiêm Khang Kỳ đột nhiên ngẩng mặt lên."
  },
  {
    "idx": 3336,
    "start": "01:30:27,474",
    "end": "01:30:28,234",
    "start_sec": 5427.474,
    "end_sec": 5428.234,
    "zh": "诡异的是",
    "vi": "Điều kỳ quái là"
  },
  {
    "idx": 3337,
    "start": "01:30:28,234",
    "end": "01:30:29,074",
    "start_sec": 5428.234,
    "end_sec": 5429.074,
    "zh": "那张脸上",
    "vi": "trên khuôn mặt đó"
  },
  {
    "idx": 3338,
    "start": "01:30:29,074",
    "end": "01:30:30,334",
    "start_sec": 5429.074,
    "end_sec": 5430.334,
    "zh": "竟然一半是男人",
    "vi": "hóa ra một nửa là đàn ông"
  },
  {
    "idx": 3339,
    "start": "01:30:30,334",
    "end": "01:30:31,214",
    "start_sec": 5430.334,
    "end_sec": 5431.214,
    "zh": "一半是女人",
    "vi": "một nửa là phụ nữ."
  },
  {
    "idx": 3340,
    "start": "01:30:31,214",
    "end": "01:30:32,314",
    "start_sec": 5431.214,
    "end_sec": 5432.314,
    "zh": "还愣着干嘛",
    "vi": "Còn đờ người ra đó làm gì."
  },
  {
    "idx": 3341,
    "start": "01:30:32,314",
    "end": "01:30:33,354",
    "start_sec": 5432.314,
    "end_sec": 5433.354,
    "zh": "给我找裙子",
    "vi": "Tìm váy cho ta."
  },
  {
    "idx": 3342,
    "start": "01:30:33,354",
    "end": "01:30:34,554",
    "start_sec": 5433.354,
    "end_sec": 5434.554,
    "zh": "我要穿裙子",
    "vi": "Ta muốn mặc váy."
  },
  {
    "idx": 3343,
    "start": "01:30:34,554",
    "end": "01:30:35,674",
    "start_sec": 5434.554,
    "end_sec": 5435.674,
    "zh": "是 是",
    "vi": "Vâng, vâng."
  },
  {
    "idx": 3344,
    "start": "01:30:35,674",
    "end": "01:30:36,514",
    "start_sec": 5435.674,
    "end_sec": 5436.514,
    "zh": "紧接着",
    "vi": "Ngay sau đó"
  },
  {
    "idx": 3345,
    "start": "01:30:36,514",
    "end": "01:30:37,694",
    "start_sec": 5436.514,
    "end_sec": 5437.694,
    "zh": "一人撞着男子上前",
    "vi": "một người lấy hết can đảm tiến lên"
  },
  {
    "idx": 3346,
    "start": "01:30:37,694",
    "end": "01:30:38,954",
    "start_sec": 5437.694,
    "end_sec": 5438.954,
    "zh": "将裙子递过去",
    "vi": "đưa chiếc váy qua."
  },
  {
    "idx": 3347,
    "start": "01:30:38,954",
    "end": "01:30:39,474",
    "start_sec": 5438.954,
    "end_sec": 5439.474,
    "zh": "快",
    "vi": "Nhanh lên."
  },
  {
    "idx": 3348,
    "start": "01:30:39,474",
    "end": "01:30:40,254",
    "start_sec": 5439.474,
    "end_sec": 5440.254,
    "zh": "就现在",
    "vi": "Ngay bây giờ."
  },
  {
    "idx": 3349,
    "start": "01:30:40,254",
    "end": "01:30:41,214",
    "start_sec": 5440.254,
    "end_sec": 5441.214,
    "zh": "注射药剂",
    "vi": "Tiêm thuốc đi."
  },
  {
    "idx": 3350,
    "start": "01:30:41,214",
    "end": "01:30:41,874",
    "start_sec": 5441.214,
    "end_sec": 5441.874,
    "zh": "文言",
    "vi": "Nghe vậy"
  },
  {
    "idx": 3351,
    "start": "01:30:41,874",
    "end": "01:30:43,094",
    "start_sec": 5441.874,
    "end_sec": 5443.094,
    "zh": "一人迅速捡起",
    "vi": "một người nhanh chóng nhặt lên"
  },
  {
    "idx": 3352,
    "start": "01:30:43,094",
    "end": "01:30:44,894",
    "start_sec": 5443.094,
    "end_sec": 5444.894,
    "zh": "人家一只的同伴手上的注射剂",
    "vi": "ống tiêm trên tay người đồng nghiệp"
  },
  {
    "idx": 3353,
    "start": "01:30:44,894",
    "end": "01:30:45,934",
    "start_sec": 5444.894,
    "end_sec": 5445.934,
    "zh": "一把扎了过去",
    "vi": "rồi đâm mạnh vào."
  },
  {
    "idx": 3354,
    "start": "01:30:45,934",
    "end": "01:30:46,474",
    "start_sec": 5445.934,
    "end_sec": 5446.474,
    "zh": "啊",
    "vi": "Á."
  },
  {
    "idx": 3355,
    "start": "01:30:46,474",
    "end": "01:30:47,314",
    "start_sec": 5446.474,
    "end_sec": 5447.314,
    "zh": "你 你",
    "vi": "Ngươi, ngươi."
  },
  {
    "idx": 3356,
    "start": "01:30:47,314",
    "end": "01:30:48,254",
    "start_sec": 5447.314,
    "end_sec": 5448.254,
    "zh": "好大的胆子",
    "vi": "Gan to lắm."
  },
  {
    "idx": 3357,
    "start": "01:30:48,254",
    "end": "01:30:49,354",
    "start_sec": 5448.254,
    "end_sec": 5449.354,
    "zh": "半张女人脸",
    "vi": "Nửa khuôn mặt phụ nữ"
  },
  {
    "idx": 3358,
    "start": "01:30:49,354",
    "end": "01:30:50,954",
    "start_sec": 5449.354,
    "end_sec": 5450.954,
    "zh": "有气的快想注射药剂",
    "vi": "tức giận muốn rút ống tiêm ra."
  },
  {
    "idx": 3359,
    "start": "01:30:50,954",
    "end": "01:30:51,814",
    "start_sec": 5450.954,
    "end_sec": 5451.814,
    "zh": "吓死了",
    "vi": "Đáng sợ quá."
  },
  {
    "idx": 3360,
    "start": "01:30:51,814",
    "end": "01:30:54,094",
    "start_sec": 5451.814,
    "end_sec": 5454.094,
    "zh": "那人的头发如一种红粉粉的信息",
    "vi": "Tóc của người đó như những sợi tơ màu hồng."
  },
  {
    "idx": 3361,
    "start": "01:30:54,094",
    "end": "01:30:55,634",
    "start_sec": 5454.094,
    "end_sec": 5455.634,
    "zh": "向自己折腾一层",
    "vi": "Tự làm khổ mình thêm một lần nữa."
  },
  {
    "idx": 3362,
    "start": "01:30:55,634",
    "end": "01:30:57,134",
    "start_sec": 5455.634,
    "end_sec": 5457.134,
    "zh": "妈的妈的",
    "vi": "Chết tiệt thật."
  },
  {
    "idx": 3363,
    "start": "01:30:57,134",
    "end": "01:30:58,054",
    "start_sec": 5457.134,
    "end_sec": 5458.054,
    "zh": "这本东西",
    "vi": "Thứ này."
  },
  {
    "idx": 3364,
    "start": "01:30:58,054",
    "end": "01:30:59,674",
    "start_sec": 5458.054,
    "end_sec": 5459.674,
    "zh": "总算控制住了",
    "vi": "Cuối cùng cũng khống chế được rồi."
  },
  {
    "idx": 3365,
    "start": "01:30:59,674",
    "end": "01:31:01,014",
    "start_sec": 5459.674,
    "end_sec": 5461.014,
    "zh": "那边会男人的人",
    "vi": "Người đàn ông ở phía đó."
  },
  {
    "idx": 3366,
    "start": "01:31:01,014",
    "end": "01:31:02,514",
    "start_sec": 5461.014,
    "end_sec": 5462.514,
    "zh": "冷着脸太想周围走",
    "vi": "Lạnh lùng bước đi xung quanh."
  },
  {
    "idx": 3367,
    "start": "01:31:02,514",
    "end": "01:31:03,514",
    "start_sec": 5462.514,
    "end_sec": 5463.514,
    "zh": "一群废物",
    "vi": "Một lũ vô dụng."
  },
  {
    "idx": 3368,
    "start": "01:31:03,514",
    "end": "01:31:04,134",
    "start_sec": 5463.514,
    "end_sec": 5464.134,
    "zh": "还不走",
    "vi": "Còn không mau cút đi."
  },
  {
    "idx": 3369,
    "start": "01:31:04,134",
    "end": "01:31:06,234",
    "start_sec": 5464.134,
    "end_sec": 5466.234,
    "zh": "我操",
    "vi": "Mẹ kiếp."
  },
  {
    "idx": 3370,
    "start": "01:31:06,234",
    "end": "01:31:07,394",
    "start_sec": 5466.234,
    "end_sec": 5467.394,
    "zh": "这是什么人",
    "vi": "Đây là loại người gì vậy."
  },
  {
    "idx": 3371,
    "start": "01:31:07,394",
    "end": "01:31:09,954",
    "start_sec": 5467.394,
    "end_sec": 5469.954,
    "zh": "这还是人吗",
    "vi": "Đây còn là con người sao."
  },
  {
    "idx": 3372,
    "start": "01:31:09,954",
    "end": "01:31:11,634",
    "start_sec": 5469.954,
    "end_sec": 5471.634,
    "zh": "这还是人吗",
    "vi": "Đây còn là con người sao."
  },
  {
    "idx": 3373,
    "start": "01:31:11,634",
    "end": "01:31:12,854",
    "start_sec": 5471.634,
    "end_sec": 5472.854,
    "zh": "透过军用望远镜",
    "vi": "Thông qua ống nhòm quân sự."
  },
  {
    "idx": 3374,
    "start": "01:31:12,854",
    "end": "01:31:15,334",
    "start_sec": 5472.854,
    "end_sec": 5475.334,
    "zh": "程子蹄将医院所发生的一切禁收",
    "vi": "Trình Tử Đề thu hết mọi việc xảy ra ở bệnh viện vào tầm mắt."
  },
  {
    "idx": 3375,
    "start": "01:31:15,334",
    "end": "01:31:16,554",
    "start_sec": 5475.334,
    "end_sec": 5476.554,
    "zh": "尽管听不到",
    "vi": "Mặc dù không nghe thấy gì."
  },
  {
    "idx": 3376,
    "start": "01:31:16,554",
    "end": "01:31:18,894",
    "start_sec": 5476.554,
    "end_sec": 5478.894,
    "zh": "但头发杀人所带来的视觉效果",
    "vi": "Nhưng cảnh tượng giết người đó."
  },
  {
    "idx": 3377,
    "start": "01:31:18,894",
    "end": "01:31:20,494",
    "start_sec": 5478.894,
    "end_sec": 5480.494,
    "zh": "还是让他久久不能平复",
    "vi": "Vẫn khiến anh không thể bình tâm lại được."
  },
  {
    "idx": 3378,
    "start": "01:31:20,494",
    "end": "01:31:21,234",
    "start_sec": 5480.494,
    "end_sec": 5481.234,
    "zh": "鬼",
    "vi": "Ma quỷ."
  },
  {
    "idx": 3379,
    "start": "01:31:21,234",
    "end": "01:31:22,014",
    "start_sec": 5481.234,
    "end_sec": 5482.014,
    "zh": "不对",
    "vi": "Không đúng."
  },
  {
    "idx": 3380,
    "start": "01:31:22,014",
    "end": "01:31:23,154",
    "start_sec": 5482.014,
    "end_sec": 5483.154,
    "zh": "鬼似乎没有意识",
    "vi": "Ma quỷ dường như không có ý thức."
  },
  {
    "idx": 3381,
    "start": "01:31:23,154",
    "end": "01:31:24,074",
    "start_sec": 5483.154,
    "end_sec": 5484.074,
    "zh": "在小区里时",
    "vi": "Khi ở trong khu dân cư."
  },
  {
    "idx": 3382,
    "start": "01:31:24,074",
    "end": "01:31:25,754",
    "start_sec": 5484.074,
    "end_sec": 5485.754,
    "zh": "三只鬼都在无差别杀人",
    "vi": "Cả ba con quỷ đều giết người không phân biệt."
  },
  {
    "idx": 3383,
    "start": "01:31:25,754",
    "end": "01:31:26,934",
    "start_sec": 5485.754,
    "end_sec": 5486.934,
    "zh": "说起意识",
    "vi": "Nói về ý thức."
  },
  {
    "idx": 3384,
    "start": "01:31:26,934",
    "end": "01:31:28,654",
    "start_sec": 5486.934,
    "end_sec": 5488.654,
    "zh": "刚才那人又变回了正常人",
    "vi": "Người vừa rồi lại trở về làm người bình thường."
  },
  {
    "idx": 3385,
    "start": "01:31:28,654",
    "end": "01:31:31,234",
    "start_sec": 5488.654,
    "end_sec": 5491.234,
    "zh": "好像是身体里住着一只鬼",
    "vi": "Giống như trong cơ thể hắn có một con quỷ trú ngụ."
  },
  {
    "idx": 3386,
    "start": "01:31:31,234",
    "end": "01:31:31,934",
    "start_sec": 5491.234,
    "end_sec": 5491.934,
    "zh": "难道说",
    "vi": "Chẳng lẽ."
  },
  {
    "idx": 3387,
    "start": "01:31:31,934",
    "end": "01:31:34,054",
    "start_sec": 5491.934,
    "end_sec": 5494.054,
    "zh": "人可以通过某种手段与鬼融合",
    "vi": "Con người có thể dùng cách nào đó để dung hợp với quỷ."
  },
  {
    "idx": 3388,
    "start": "01:31:34,054",
    "end": "01:31:35,134",
    "start_sec": 5494.054,
    "end_sec": 5495.134,
    "zh": "如果可以的话",
    "vi": "Nếu có thể làm vậy."
  },
  {
    "idx": 3389,
    "start": "01:31:35,134",
    "end": "01:31:37,134",
    "start_sec": 5495.134,
    "end_sec": 5497.134,
    "zh": "程子提现在很想去接触他们",
    "vi": "Trình Tử Đề bây giờ rất muốn tiếp cận họ."
  },
  {
    "idx": 3390,
    "start": "01:31:37,134",
    "end": "01:31:38,794",
    "start_sec": 5497.134,
    "end_sec": 5498.794,
    "zh": "从他们口中获取一些心意",
    "vi": "Để lấy thêm thông tin từ miệng họ."
  },
  {
    "idx": 3391,
    "start": "01:31:38,794",
    "end": "01:31:40,234",
    "start_sec": 5498.794,
    "end_sec": 5500.234,
    "zh": "但他一个毫不相干的人",
    "vi": "Nhưng một người hoàn toàn không liên quan"
  },
  {
    "idx": 3392,
    "start": "01:31:40,234",
    "end": "01:31:41,214",
    "start_sec": 5500.234,
    "end_sec": 5501.214,
    "zh": "正是在末世",
    "vi": "lại đang ở trong thời kỳ mạt thế"
  },
  {
    "idx": 3393,
    "start": "01:31:41,214",
    "end": "01:31:43,134",
    "start_sec": 5501.214,
    "end_sec": 5503.134,
    "zh": "他可不认为对方是什么擅长",
    "vi": "Anh ta không nghĩ đối phương là người giỏi giang"
  },
  {
    "idx": 3394,
    "start": "01:31:43,134",
    "end": "01:31:44,374",
    "start_sec": 5503.134,
    "end_sec": 5504.374,
    "zh": "更不敢随意接触",
    "vi": "Càng không dám tùy tiện tiếp xúc"
  },
  {
    "idx": 3395,
    "start": "01:31:44,374",
    "end": "01:31:45,194",
    "start_sec": 5504.374,
    "end_sec": 5505.194,
    "zh": "这时",
    "vi": "Lúc này"
  },
  {
    "idx": 3396,
    "start": "01:31:45,194",
    "end": "01:31:47,274",
    "start_sec": 5505.194,
    "end_sec": 5507.274,
    "zh": "那一行穿着制服的人走了走",
    "vi": "nhóm người mặc đồng phục đi tới"
  },
  {
    "idx": 3397,
    "start": "01:31:47,274",
    "end": "01:31:48,194",
    "start_sec": 5507.274,
    "end_sec": 5508.194,
    "zh": "这玩意儿",
    "vi": "Thứ này"
  },
  {
    "idx": 3398,
    "start": "01:31:48,194",
    "end": "01:31:49,194",
    "start_sec": 5508.194,
    "end_sec": 5509.194,
    "zh": "越来越难压制了",
    "vi": "càng ngày càng khó khống chế"
  },
  {
    "idx": 3399,
    "start": "01:31:49,194",
    "end": "01:31:50,554",
    "start_sec": 5509.194,
    "end_sec": 5510.554,
    "zh": "走 去永德寺",
    "vi": "Đi thôi, đến chùa Vĩnh Đức"
  },
  {
    "idx": 3400,
    "start": "01:31:50,554",
    "end": "01:31:52,134",
    "start_sec": 5510.554,
    "end_sec": 5512.134,
    "zh": "永德寺",
    "vi": "Chùa Vĩnh Đức"
  },
  {
    "idx": 3401,
    "start": "01:31:52,134",
    "end": "01:31:53,214",
    "start_sec": 5512.134,
    "end_sec": 5513.214,
    "zh": "透过风声",
    "vi": "Qua tiếng gió"
  },
  {
    "idx": 3402,
    "start": "01:31:53,214",
    "end": "01:31:55,234",
    "start_sec": 5513.214,
    "end_sec": 5515.234,
    "zh": "橙子皮隐约听到这三个字",
    "vi": "Cam Bì mơ hồ nghe thấy ba chữ này"
  },
  {
    "idx": 3403,
    "start": "01:31:55,234",
    "end": "01:31:56,094",
    "start_sec": 5515.234,
    "end_sec": 5516.094,
    "zh": "谁",
    "vi": "Ai"
  },
  {
    "idx": 3404,
    "start": "01:31:56,094",
    "end": "01:31:56,814",
    "start_sec": 5516.094,
    "end_sec": 5516.814,
    "zh": "突然",
    "vi": "Đột nhiên"
  },
  {
    "idx": 3405,
    "start": "01:31:56,814",
    "end": "01:31:59,394",
    "start_sec": 5516.814,
    "end_sec": 5519.394,
    "zh": "037猛的探向橙子皮所在的位置",
    "vi": "037 đột ngột hướng về phía Cam Bì"
  },
  {
    "idx": 3406,
    "start": "01:31:59,394",
    "end": "01:32:00,294",
    "start_sec": 5519.394,
    "end_sec": 5520.294,
    "zh": "他拎起包",
    "vi": "Anh ta xách túi"
  },
  {
    "idx": 3407,
    "start": "01:32:00,294",
    "end": "01:32:01,654",
    "start_sec": 5520.294,
    "end_sec": 5521.654,
    "zh": "转身头也被鬼的",
    "vi": "quay người lại, đầu cũng bị quỷ"
  },
  {
    "idx": 3408,
    "start": "01:32:01,654",
    "end": "01:32:03,054",
    "start_sec": 5521.654,
    "end_sec": 5523.054,
    "zh": "开着武林红光灵气",
    "vi": "Bật ra linh khí màu đỏ của võ lâm"
  },
  {
    "idx": 3409,
    "start": "01:32:03,054",
    "end": "01:32:05,294",
    "start_sec": 5523.054,
    "end_sec": 5525.294,
    "zh": "现在还敢出门",
    "vi": "Bây giờ còn dám ra ngoài"
  },
  {
    "idx": 3410,
    "start": "01:32:05,294",
    "end": "01:32:07,914",
    "start_sec": 5525.294,
    "end_sec": 5527.914,
    "zh": "037他不会也是御鬼者吧",
    "vi": "037 anh ta cũng là người điều khiển quỷ sao"
  },
  {
    "idx": 3411,
    "start": "01:32:07,914",
    "end": "01:32:08,954",
    "start_sec": 5527.914,
    "end_sec": 5528.954,
    "zh": "管他是什么",
    "vi": "Bất kể anh ta là gì"
  },
  {
    "idx": 3412,
    "start": "01:32:08,954",
    "end": "01:32:10,054",
    "start_sec": 5528.954,
    "end_sec": 5530.054,
    "zh": "只要不妨碍我们",
    "vi": "Miễn là không cản trở chúng ta"
  },
  {
    "idx": 3413,
    "start": "01:32:10,054",
    "end": "01:32:12,814",
    "start_sec": 5530.054,
    "end_sec": 5532.814,
    "zh": "妈的",
    "vi": "Mẹ kiếp"
  },
  {
    "idx": 3414,
    "start": "01:32:12,814",
    "end": "01:32:14,674",
    "start_sec": 5532.814,
    "end_sec": 5534.674,
    "zh": "好不容易才发现给给用的线索",
    "vi": "Vất vả lắm mới tìm được manh mối cho Giegie"
  },
  {
    "idx": 3415,
    "start": "01:32:14,674",
    "end": "01:32:15,834",
    "start_sec": 5534.674,
    "end_sec": 5535.834,
    "zh": "现在就要干了吗",
    "vi": "Bây giờ lại phải làm sao đây"
  },
  {
    "idx": 3416,
    "start": "01:32:15,834",
    "end": "01:32:16,994",
    "start_sec": 5535.834,
    "end_sec": 5536.994,
    "zh": "想了想",
    "vi": "Suy nghĩ một chút"
  },
  {
    "idx": 3417,
    "start": "01:32:16,994",
    "end": "01:32:18,734",
    "start_sec": 5536.994,
    "end_sec": 5538.734,
    "zh": "橙子皮不担心的踩下刹车",
    "vi": "Cam Bì không chút lo lắng đạp phanh"
  },
  {
    "idx": 3418,
    "start": "01:32:18,734",
    "end": "01:32:20,194",
    "start_sec": 5538.734,
    "end_sec": 5540.194,
    "zh": "把车开进了滇草房",
    "vi": "Lái xe vào nhà kho ở Điền Thảo"
  },
  {
    "idx": 3419,
    "start": "01:32:20,194",
    "end": "01:32:21,894",
    "start_sec": 5540.194,
    "end_sec": 5541.894,
    "zh": "如果他们要去永德寺的话",
    "vi": "Nếu bọn họ đi chùa Vĩnh Đức"
  },
  {
    "idx": 3420,
    "start": "01:32:21,894",
    "end": "01:32:23,134",
    "start_sec": 5541.894,
    "end_sec": 5543.134,
    "zh": "必然要走临江大道",
    "vi": "chắc chắn sẽ đi đường Lâm Giang"
  },
  {
    "idx": 3421,
    "start": "01:32:23,134",
    "end": "01:32:25,494",
    "start_sec": 5543.134,
    "end_sec": 5545.494,
    "zh": "那火热杀队友都跟砍瓜切菜一样",
    "vi": "Tên người lửa đó giết đồng đội dễ như thái rau vậy."
  },
  {
    "idx": 3422,
    "start": "01:32:25,494",
    "end": "01:32:26,794",
    "start_sec": 5545.494,
    "end_sec": 5546.794,
    "zh": "还是暂时不要接触的好",
    "vi": "Tạm thời đừng đụng vào thì hơn."
  },
  {
    "idx": 3423,
    "start": "01:32:26,794",
    "end": "01:32:28,014",
    "start_sec": 5546.794,
    "end_sec": 5548.014,
    "zh": "倒是可以等他们走了",
    "vi": "Có thể đợi bọn họ đi rồi."
  },
  {
    "idx": 3424,
    "start": "01:32:28,014",
    "end": "01:32:29,134",
    "start_sec": 5548.014,
    "end_sec": 5549.134,
    "zh": "再返回医院看看",
    "vi": "Quay lại bệnh viện xem sao."
  },
  {
    "idx": 3425,
    "start": "01:32:29,134",
    "end": "01:32:31,314",
    "start_sec": 5549.134,
    "end_sec": 5551.314,
    "zh": "说不定那两只尸体上有点什么线索",
    "vi": "Biết đâu trên hai cái xác đó có manh mối gì."
  },
  {
    "idx": 3426,
    "start": "01:32:31,314",
    "end": "01:32:33,694",
    "start_sec": 5551.314,
    "end_sec": 5553.694,
    "zh": "总比漫无目的的在城市转悠好",
    "vi": "Vẫn hơn là đi lang thang trong thành phố mà không có mục đích."
  },
  {
    "idx": 3427,
    "start": "01:32:33,694",
    "end": "01:32:35,394",
    "start_sec": 5553.694,
    "end_sec": 5555.394,
    "zh": "卢成子提所想一番",
    "vi": "Lư Thành Tử suy nghĩ một chút."
  },
  {
    "idx": 3428,
    "start": "01:32:35,394",
    "end": "01:32:37,874",
    "start_sec": 5555.394,
    "end_sec": 5557.874,
    "zh": "随后一阵车的轰鸣声突然响起",
    "vi": "Sau đó một tiếng động cơ xe vang lên đột ngột."
  },
  {
    "idx": 3429,
    "start": "01:32:37,874",
    "end": "01:32:40,394",
    "start_sec": 5557.874,
    "end_sec": 5560.394,
    "zh": "当那飞车完全从视线中消失之后",
    "vi": "Khi chiếc xe đó hoàn toàn biến mất khỏi tầm mắt."
  },
  {
    "idx": 3430,
    "start": "01:32:40,394",
    "end": "01:32:42,674",
    "start_sec": 5560.394,
    "end_sec": 5562.674,
    "zh": "长者皮甲车往医院方向返回去",
    "vi": "Trường Tử Bì lái xe quay lại hướng bệnh viện."
  },
  {
    "idx": 3431,
    "start": "01:32:48,734",
    "end": "01:32:51,154",
    "start_sec": 5568.734,
    "end_sec": 5571.154,
    "zh": "我操",
    "vi": "Chết tiệt thật."
  },
  {
    "idx": 3432,
    "start": "01:32:51,154",
    "end": "01:32:52,154",
    "start_sec": 5571.154,
    "end_sec": 5572.154,
    "zh": "这里还是医院",
    "vi": "Đây vẫn là bệnh viện."
  },
  {
    "idx": 3433,
    "start": "01:32:52,154",
    "end": "01:32:52,994",
    "start_sec": 5572.154,
    "end_sec": 5572.994,
    "zh": "看样子",
    "vi": "Xem ra."
  },
  {
    "idx": 3434,
    "start": "01:32:52,994",
    "end": "01:32:53,774",
    "start_sec": 5572.994,
    "end_sec": 5573.774,
    "zh": "医院里的诡异",
    "vi": "Thứ quỷ dị trong bệnh viện."
  },
  {
    "idx": 3435,
    "start": "01:32:53,774",
    "end": "01:32:55,274",
    "start_sec": 5573.774,
    "end_sec": 5575.274,
    "zh": "应该是被那火人消灭完了",
    "vi": "Chắc là đã bị người lửa đó tiêu diệt sạch rồi."
  },
  {
    "idx": 3436,
    "start": "01:32:55,274",
    "end": "01:32:56,514",
    "start_sec": 5575.274,
    "end_sec": 5576.514,
    "zh": "长子皮摸了摸",
    "vi": "Trường Tử Bì sờ sờ."
  },
  {
    "idx": 3437,
    "start": "01:32:56,514",
    "end": "01:32:57,534",
    "start_sec": 5576.514,
    "end_sec": 5577.534,
    "zh": "怀里踹着的项目",
    "vi": "Thứ nhét trong ngực áo."
  },
  {
    "idx": 3438,
    "start": "01:32:57,534",
    "end": "01:32:59,334",
    "start_sec": 5577.534,
    "end_sec": 5579.334,
    "zh": "这才把脉出脚往里走",
    "vi": "Lúc này mới lấy hết can đảm bước vào trong."
  },
  {
    "idx": 3439,
    "start": "01:32:59,334",
    "end": "01:33:05,014",
    "start_sec": 5579.334,
    "end_sec": 5585.014,
    "zh": "这就是刚才那个人注射的药剂",
    "vi": "Đây chính là loại thuốc mà người đó đã tiêm."
  },
  {
    "idx": 3440,
    "start": "01:33:05,014",
    "end": "01:33:05,914",
    "start_sec": 5585.014,
    "end_sec": 5585.914,
    "zh": "高同速",
    "vi": "Cao Đồng Tố."
  },
  {
    "idx": 3441,
    "start": "01:33:05,914",
    "end": "01:33:07,114",
    "start_sec": 5585.914,
    "end_sec": 5587.114,
    "zh": "这不是雄性激素",
    "vi": "Đây không phải là hormone nam."
  },
  {
    "idx": 3442,
    "start": "01:33:07,114",
    "end": "01:33:08,374",
    "start_sec": 5587.114,
    "end_sec": 5588.374,
    "zh": "结合刚才所见",
    "vi": "Kết hợp với những gì vừa thấy."
  },
  {
    "idx": 3443,
    "start": "01:33:08,374",
    "end": "01:33:10,374",
    "start_sec": 5588.374,
    "end_sec": 5590.374,
    "zh": "长子皮心中大致有所猜测",
    "vi": "Trường Tử Bì trong lòng đã đoán được phần nào."
  },
  {
    "idx": 3444,
    "start": "01:33:10,374",
    "end": "01:33:12,534",
    "start_sec": 5590.374,
    "end_sec": 5592.534,
    "zh": "现在基本可以断定",
    "vi": "Giờ có thể khẳng định chắc chắn."
  },
  {
    "idx": 3445,
    "start": "01:33:12,534",
    "end": "01:33:14,114",
    "start_sec": 5592.534,
    "end_sec": 5594.114,
    "zh": "那人体内融合了一只女鬼",
    "vi": "Trong cơ thể người đó đã dung hợp một con nữ quỷ."
  },
  {
    "idx": 3446,
    "start": "01:33:14,114",
    "end": "01:33:15,274",
    "start_sec": 5594.114,
    "end_sec": 5595.274,
    "zh": "不知出于何种原因",
    "vi": "Không biết vì lý do gì."
  },
  {
    "idx": 3447,
    "start": "01:33:15,274",
    "end": "01:33:16,654",
    "start_sec": 5595.274,
    "end_sec": 5596.654,
    "zh": "出现无法复原的情况",
    "vi": "Mà xuất hiện tình trạng không thể phục hồi."
  },
  {
    "idx": 3448,
    "start": "01:33:16,654",
    "end": "01:33:17,854",
    "start_sec": 5596.654,
    "end_sec": 5597.854,
    "zh": "而用来压制诡异的",
    "vi": "Và thứ dùng để trấn áp sự quỷ dị đó."
  },
  {
    "idx": 3449,
    "start": "01:33:17,854",
    "end": "01:33:18,754",
    "start_sec": 5597.854,
    "end_sec": 5598.754,
    "zh": "竟然是高瞳素",
    "vi": "Lại chính là Cao Đồng Tố."
  },
  {
    "idx": 3450,
    "start": "01:33:18,754",
    "end": "01:33:20,474",
    "start_sec": 5598.754,
    "end_sec": 5600.474,
    "zh": "高瞳素可以压制诡异",
    "vi": "Cao Đồng Tố có thể trấn áp được quỷ dị."
  },
  {
    "idx": 3451,
    "start": "01:33:20,474",
    "end": "01:33:22,894",
    "start_sec": 5600.474,
    "end_sec": 5602.894,
    "zh": "着实令橙子皮有些诡异所述",
    "vi": "Thực sự khiến Trần Tử Bì có chút kỳ lạ"
  },
  {
    "idx": 3452,
    "start": "01:33:22,894",
    "end": "01:33:24,654",
    "start_sec": 5602.894,
    "end_sec": 5604.654,
    "zh": "渐渐消化着新得到的情报",
    "vi": "Dần dần tiêu hóa thông tin mới nhận được"
  },
  {
    "idx": 3453,
    "start": "01:33:24,654",
    "end": "01:33:27,534",
    "start_sec": 5604.654,
    "end_sec": 5607.534,
    "zh": "橙子皮脑海里产生出一个大胆的想法",
    "vi": "Một ý nghĩ táo bạo nảy ra trong đầu Trần Tử Bì"
  },
  {
    "idx": 3454,
    "start": "01:33:27,534",
    "end": "01:33:29,094",
    "start_sec": 5607.534,
    "end_sec": 5609.094,
    "zh": "既然人力无法抗衡诡异",
    "vi": "Nếu sức người không thể chống lại sự kỳ lạ"
  },
  {
    "idx": 3455,
    "start": "01:33:29,094",
    "end": "01:33:31,494",
    "start_sec": 5609.094,
    "end_sec": 5611.494,
    "zh": "是不是可以借助诡异的力量来对付诡异",
    "vi": "Liệu có thể mượn sức mạnh của sự kỳ lạ để đối phó với sự kỳ lạ không"
  },
  {
    "idx": 3456,
    "start": "01:33:31,494",
    "end": "01:33:33,654",
    "start_sec": 5611.494,
    "end_sec": 5613.654,
    "zh": "如果我体内也融合一起诡异呢",
    "vi": "Nếu tôi cũng dung hợp một chút sự kỳ lạ vào cơ thể thì sao"
  },
  {
    "idx": 3457,
    "start": "01:33:33,654",
    "end": "01:33:35,254",
    "start_sec": 5613.654,
    "end_sec": 5615.254,
    "zh": "当然一切都是后话",
    "vi": "Tất nhiên đó là chuyện sau này"
  },
  {
    "idx": 3458,
    "start": "01:33:35,254",
    "end": "01:33:37,934",
    "start_sec": 5615.254,
    "end_sec": 5617.934,
    "zh": "现在的他对诡异了解的还是太少了",
    "vi": "Hiện tại anh ta vẫn hiểu quá ít về sự kỳ lạ"
  },
  {
    "idx": 3459,
    "start": "01:33:37,934",
    "end": "01:33:41,014",
    "start_sec": 5617.934,
    "end_sec": 5621.014,
    "zh": "我操真会切",
    "vi": "Đệt, đúng là biết cách cắt"
  },
  {
    "idx": 3460,
    "start": "01:33:41,014",
    "end": "01:33:44,094",
    "start_sec": 5621.014,
    "end_sec": 5624.094,
    "zh": "橙子皮不小心踢到地上其中一起射击",
    "vi": "Trần Tử Bì vô tình đá phải một trong những viên đạn trên mặt đất"
  },
  {
    "idx": 3461,
    "start": "01:33:44,094",
    "end": "01:33:45,634",
    "start_sec": 5624.094,
    "end_sec": 5625.634,
    "zh": "这还有没有用过的高瞳素",
    "vi": "Còn cái này có phải là cao đồng tố chưa dùng không"
  },
  {
    "idx": 3462,
    "start": "01:33:45,634",
    "end": "01:33:48,594",
    "start_sec": 5625.634,
    "end_sec": 5628.594,
    "zh": "换着手中的高同宿",
    "vi": "Đổi lấy cao đồng tố trong tay"
  },
  {
    "idx": 3463,
    "start": "01:33:48,594",
    "end": "01:33:50,534",
    "start_sec": 5628.594,
    "end_sec": 5630.534,
    "zh": "长子蹄突然眼前一眼",
    "vi": "Trần Tử Bì chợt nhìn thấy"
  },
  {
    "idx": 3464,
    "start": "01:33:50,534",
    "end": "01:33:54,274",
    "start_sec": 5630.534,
    "end_sec": 5634.274,
    "zh": "还有多久到永德寺",
    "vi": "Còn bao lâu nữa thì đến Vĩnh Đức Tự"
  },
  {
    "idx": 3465,
    "start": "01:33:54,274",
    "end": "01:33:56,434",
    "start_sec": 5634.274,
    "end_sec": 5636.434,
    "zh": "大概在晚上之前能到达",
    "vi": "Chắc là sẽ đến trước buổi tối"
  },
  {
    "idx": 3466,
    "start": "01:33:56,434",
    "end": "01:33:57,914",
    "start_sec": 5636.434,
    "end_sec": 5637.914,
    "zh": "高同宿还剩多少",
    "vi": "Cao đồng tố còn lại bao nhiêu"
  },
  {
    "idx": 3467,
    "start": "01:33:57,914",
    "end": "01:33:59,214",
    "start_sec": 5637.914,
    "end_sec": 5639.214,
    "zh": "高",
    "vi": "Cao"
  },
  {
    "idx": 3468,
    "start": "01:33:59,214",
    "end": "01:34:01,694",
    "start_sec": 5639.214,
    "end_sec": 5641.694,
    "zh": "高同宿好像在小虎身上",
    "vi": "Cao đồng tố dường như ở trên người Tiểu Hổ"
  },
  {
    "idx": 3469,
    "start": "01:34:01,694",
    "end": "01:34:02,894",
    "start_sec": 5641.694,
    "end_sec": 5642.894,
    "zh": "小",
    "vi": "Tiểu"
  },
  {
    "idx": 3470,
    "start": "01:34:02,894",
    "end": "01:34:04,174",
    "start_sec": 5642.894,
    "end_sec": 5644.174,
    "zh": "小虎死了",
    "vi": "Tiểu Hổ chết rồi"
  },
  {
    "idx": 3471,
    "start": "01:34:04,174",
    "end": "01:34:05,094",
    "start_sec": 5644.174,
    "end_sec": 5645.094,
    "zh": "我是小龙",
    "vi": "Tôi là Tiểu Long"
  },
  {
    "idx": 3472,
    "start": "01:34:05,094",
    "end": "01:34:05,494",
    "start_sec": 5645.094,
    "end_sec": 5645.494,
    "zh": "高",
    "vi": "Cao"
  },
  {
    "idx": 3473,
    "start": "01:34:05,494",
    "end": "01:34:07,894",
    "start_sec": 5645.494,
    "end_sec": 5647.894,
    "zh": "高同宿好像落在医院了",
    "vi": "Cao đồng tố dường như đã rơi ở bệnh viện rồi"
  },
  {
    "idx": 3474,
    "start": "01:34:07,894",
    "end": "01:34:08,354",
    "start_sec": 5647.894,
    "end_sec": 5648.354,
    "zh": "什么",
    "vi": "Cái gì"
  },
  {
    "idx": 3475,
    "start": "01:34:08,354",
    "end": "01:34:09,474",
    "start_sec": 5648.354,
    "end_sec": 5649.474,
    "zh": "你们是废物吗",
    "vi": "Các người là đồ vô dụng sao"
  },
  {
    "idx": 3476,
    "start": "01:34:09,474",
    "end": "01:34:10,434",
    "start_sec": 5649.474,
    "end_sec": 5650.434,
    "zh": "高同宿都能忘",
    "vi": "Cao đồng tố cũng quên được"
  },
  {
    "idx": 3477,
    "start": "01:34:10,434",
    "end": "01:34:11,354",
    "start_sec": 5650.434,
    "end_sec": 5651.354,
    "zh": "你们想死吗",
    "vi": "Các người muốn chết sao"
  },
  {
    "idx": 3478,
    "start": "01:34:11,354",
    "end": "01:34:13,054",
    "start_sec": 5651.354,
    "end_sec": 5653.054,
    "zh": "刚刚才太害怕了",
    "vi": "Vừa nãy tôi đã quá sợ hãi rồi"
  },
  {
    "idx": 3479,
    "start": "01:34:13,054",
    "end": "01:34:14,294",
    "start_sec": 5653.054,
    "end_sec": 5654.294,
    "zh": "那死的可是我亲弟弟",
    "vi": "Đó là em trai ruột của tôi đã chết"
  },
  {
    "idx": 3480,
    "start": "01:34:14,294",
    "end": "01:34:15,434",
    "start_sec": 5654.294,
    "end_sec": 5655.434,
    "zh": "妈的废物",
    "vi": "Đệt, đồ vô dụng"
  },
  {
    "idx": 3481,
    "start": "01:34:15,434",
    "end": "01:34:17,334",
    "start_sec": 5655.434,
    "end_sec": 5657.334,
    "zh": "要不到附近医院再找找",
    "vi": "Hay là đến bệnh viện gần đây tìm thử xem."
  },
  {
    "idx": 3482,
    "start": "01:34:17,334",
    "end": "01:34:18,054",
    "start_sec": 5657.334,
    "end_sec": 5658.054,
    "zh": "不行",
    "vi": "Không được."
  },
  {
    "idx": 3483,
    "start": "01:34:18,054",
    "end": "01:34:19,894",
    "start_sec": 5658.054,
    "end_sec": 5659.894,
    "zh": "今天清理完这家医院的",
    "vi": "Hôm nay sau khi dọn dẹp xong đống quỷ dị"
  },
  {
    "idx": 3484,
    "start": "01:34:19,894",
    "end": "01:34:21,434",
    "start_sec": 5659.894,
    "end_sec": 5661.434,
    "zh": "诡异我差点彻底失控",
    "vi": "ở bệnh viện này tôi suýt nữa đã mất kiểm soát hoàn toàn."
  },
  {
    "idx": 3485,
    "start": "01:34:21,434",
    "end": "01:34:22,834",
    "start_sec": 5661.434,
    "end_sec": 5662.834,
    "zh": "掉头回去去",
    "vi": "Quay xe lại đi."
  },
  {
    "idx": 3486,
    "start": "01:34:22,834",
    "end": "01:34:26,194",
    "start_sec": 5662.834,
    "end_sec": 5666.194,
    "zh": "医院里有人来过",
    "vi": "Có người từng đến bệnh viện này."
  },
  {
    "idx": 3487,
    "start": "01:34:26,194",
    "end": "01:34:27,534",
    "start_sec": 5666.194,
    "end_sec": 5667.534,
    "zh": "高瞳素全没了",
    "vi": "Cao Đồng Tố đã biến mất sạch sẽ."
  },
  {
    "idx": 3488,
    "start": "01:34:27,534",
    "end": "01:34:29,574",
    "start_sec": 5667.534,
    "end_sec": 5669.574,
    "zh": "看样子是被人拿走了",
    "vi": "Xem ra đã bị ai đó lấy đi rồi."
  },
  {
    "idx": 3489,
    "start": "01:34:29,574",
    "end": "01:34:31,434",
    "start_sec": 5669.574,
    "end_sec": 5671.434,
    "zh": "妈的肯定是今天",
    "vi": "Mẹ kiếp chắc chắn là tên nhóc"
  },
  {
    "idx": 3490,
    "start": "01:34:31,434",
    "end": "01:34:32,734",
    "start_sec": 5671.434,
    "end_sec": 5672.734,
    "zh": "观察我们的那小子",
    "vi": "đã theo dõi chúng ta ngày hôm nay."
  },
  {
    "idx": 3491,
    "start": "01:34:32,734",
    "end": "01:34:34,234",
    "start_sec": 5672.734,
    "end_sec": 5674.234,
    "zh": "操老子要是再见到他",
    "vi": "Mẹ kiếp nếu tao còn gặp lại nó"
  },
  {
    "idx": 3492,
    "start": "01:34:34,234",
    "end": "01:34:35,074",
    "start_sec": 5674.234,
    "end_sec": 5675.074,
    "zh": "飞扒了他的皮",
    "vi": "tao nhất định sẽ lột da nó ra."
  },
  {
    "idx": 3493,
    "start": "01:34:35,074",
    "end": "01:34:36,434",
    "start_sec": 5675.074,
    "end_sec": 5676.434,
    "zh": "现在怎么办",
    "vi": "Bây giờ tính sao đây."
  },
  {
    "idx": 3494,
    "start": "01:34:36,434",
    "end": "01:34:38,754",
    "start_sec": 5676.434,
    "end_sec": 5678.754,
    "zh": "037这里有张纸条",
    "vi": "Không ba bảy ở đây có một tờ giấy."
  },
  {
    "idx": 3495,
    "start": "01:34:38,754",
    "end": "01:34:40,234",
    "start_sec": 5678.754,
    "end_sec": 5680.234,
    "zh": "橙子皮是吧",
    "vi": "Trần Tử Bì phải không."
  },
  {
    "idx": 3496,
    "start": "01:34:40,234",
    "end": "01:34:41,374",
    "start_sec": 5680.234,
    "end_sec": 5681.374,
    "zh": "还敢留纸条",
    "vi": "Mà còn dám để lại giấy nhắn nữa."
  },
  {
    "idx": 3497,
    "start": "01:34:41,374",
    "end": "01:34:43,754",
    "start_sec": 5681.374,
    "end_sec": 5683.754,
    "zh": "走去林平小区",
    "vi": "Đi thôi đến khu chung cư Lâm Bình."
  },
  {
    "idx": 3498,
    "start": "01:34:43,754",
    "end": "01:34:45,014",
    "start_sec": 5683.754,
    "end_sec": 5685.014,
    "zh": "老子要弄死他",
    "vi": "Tao phải giết chết nó."
  },
  {
    "idx": 3499,
    "start": "01:34:45,014",
    "end": "01:34:47,854",
    "start_sec": 5685.014,
    "end_sec": 5687.854,
    "zh": "橙子皮刚到小区外面门一会儿",
    "vi": "Trần Tử Bì vừa mới đến trước cổng khu chung cư một lát"
  },
  {
    "idx": 3500,
    "start": "01:34:47,854",
    "end": "01:34:48,774",
    "start_sec": 5687.854,
    "end_sec": 5688.774,
    "zh": "那黑色商务车",
    "vi": "thì chiếc xe thương mại màu đen đó"
  },
  {
    "idx": 3501,
    "start": "01:34:48,774",
    "end": "01:34:50,154",
    "start_sec": 5688.774,
    "end_sec": 5690.154,
    "zh": "给扭扭黑身了",
    "vi": "cũng vừa vặn đi tới."
  },
  {
    "idx": 3502,
    "start": "01:34:50,154",
    "end": "01:34:51,674",
    "start_sec": 5690.154,
    "end_sec": 5691.674,
    "zh": "喂",
    "vi": "Này."
  },
  {
    "idx": 3503,
    "start": "01:34:51,674",
    "end": "01:34:53,834",
    "start_sec": 5691.674,
    "end_sec": 5693.834,
    "zh": "这里是林平小区吗",
    "vi": "Ở đây có phải là khu chung cư Lâm Bình không."
  },
  {
    "idx": 3504,
    "start": "01:34:53,834",
    "end": "01:34:54,494",
    "start_sec": 5693.834,
    "end_sec": 5694.494,
    "zh": "这里就是",
    "vi": "Đúng là ở đây."
  },
  {
    "idx": 3505,
    "start": "01:34:54,494",
    "end": "01:34:56,792",
    "start_sec": 5694.494,
    "end_sec": 5696.792,
    "zh": "小区里有没有叫橙子皮的我就是就你他妈叫橙子皮啊037从车上下来体内诡异隐隐有复苏迹象交出高同速我可以让你死得痛快点",
    "vi": "Trong khu chung cư có ai tên Trần Tử Bì không"
  },
  {
    "idx": 3505,
    "start": "01:34:56,792",
    "end": "01:34:57,837",
    "start_sec": 5696.792,
    "end_sec": 5697.837,
    "zh": "小区里有没有叫橙子皮的我就是就你他妈叫橙子皮啊037从车上下来体内诡异隐隐有复苏迹象交出高同速我可以让你死得痛快点",
    "vi": "Tôi chính là người đó"
  },
  {
    "idx": 3505,
    "start": "01:34:57,837",
    "end": "01:34:59,717",
    "start_sec": 5697.837,
    "end_sec": 5699.717,
    "zh": "小区里有没有叫橙子皮的我就是就你他妈叫橙子皮啊037从车上下来体内诡异隐隐有复苏迹象交出高同速我可以让你死得痛快点",
    "vi": "Hóa ra mày là thằng Trần Tử Bì à"
  },
  {
    "idx": 3505,
    "start": "01:34:59,717",
    "end": "01:35:03,269",
    "start_sec": 5699.717,
    "end_sec": 5703.269,
    "zh": "小区里有没有叫橙子皮的我就是就你他妈叫橙子皮啊037从车上下来体内诡异隐隐有复苏迹象交出高同速我可以让你死得痛快点",
    "vi": "Không ba bảy bước xuống xe, thế lực quỷ dị trong người có dấu hiệu thức tỉnh"
  },
  {
    "idx": 3505,
    "start": "01:35:03,269",
    "end": "01:35:06,611",
    "start_sec": 5703.269,
    "end_sec": 5706.611,
    "zh": "小区里有没有叫橙子皮的我就是就你他妈叫橙子皮啊037从车上下来体内诡异隐隐有复苏迹象交出高同速我可以让你死得痛快点",
    "vi": "Giao Cao Đồng Tố ra đây, tao có thể cho mày chết nhanh gọn một chút"
  },
  {
    "idx": 3506,
    "start": "01:35:06,611",
    "end": "01:35:09,791",
    "start_sec": 5706.611,
    "end_sec": 5709.791,
    "zh": "千色逐渐变暗",
    "vi": "Bầu trời dần dần tối sầm lại."
  },
  {
    "idx": 3507,
    "start": "01:35:09,791",
    "end": "01:35:11,151",
    "start_sec": 5709.791,
    "end_sec": 5711.151,
    "zh": "橙子皮差一样时间",
    "vi": "Trần Tử Bì nhìn thời gian."
  },
  {
    "idx": 3508,
    "start": "01:35:11,151",
    "end": "01:35:12,671",
    "start_sec": 5711.151,
    "end_sec": 5712.671,
    "zh": "火气别那么大嘛",
    "vi": "Đừng nóng giận như thế chứ."
  },
  {
    "idx": 3509,
    "start": "01:35:12,671",
    "end": "01:35:14,751",
    "start_sec": 5712.671,
    "end_sec": 5714.751,
    "zh": "高同速我今天确实捡到汽车",
    "vi": "Cao Đồng Tố hôm nay tôi quả thực có nhặt được."
  },
  {
    "idx": 3510,
    "start": "01:35:14,751",
    "end": "01:35:15,751",
    "start_sec": 5714.751,
    "end_sec": 5715.751,
    "zh": "你是遇鬼者",
    "vi": "Anh là người ngự quỷ sao."
  },
  {
    "idx": 3511,
    "start": "01:35:15,751",
    "end": "01:35:16,191",
    "start_sec": 5715.751,
    "end_sec": 5716.191,
    "zh": "不对",
    "vi": "Không đúng."
  },
  {
    "idx": 3512,
    "start": "01:35:16,191",
    "end": "01:35:18,031",
    "start_sec": 5716.191,
    "end_sec": 5718.031,
    "zh": "你身上没有遇鬼者的气息",
    "vi": "Trên người ngươi không có khí tức của ngự quỷ giả."
  },
  {
    "idx": 3513,
    "start": "01:35:18,031",
    "end": "01:35:19,091",
    "start_sec": 5718.031,
    "end_sec": 5719.091,
    "zh": "却有一种威压",
    "vi": "Nhưng lại có một loại uy áp."
  },
  {
    "idx": 3514,
    "start": "01:35:19,091",
    "end": "01:35:21,031",
    "start_sec": 5719.091,
    "end_sec": 5721.031,
    "zh": "看来是带了某种宝贝在身上",
    "vi": "Xem ra là có mang theo bảo bối gì đó bên người."
  },
  {
    "idx": 3515,
    "start": "01:35:21,031",
    "end": "01:35:22,611",
    "start_sec": 5721.031,
    "end_sec": 5722.611,
    "zh": "难怪赶一个人出门",
    "vi": "Thảo nào dám ra ngoài một mình."
  },
  {
    "idx": 3516,
    "start": "01:35:22,611",
    "end": "01:35:23,131",
    "start_sec": 5722.611,
    "end_sec": 5723.131,
    "zh": "没鬼者",
    "vi": "Ngự quỷ giả."
  },
  {
    "idx": 3517,
    "start": "01:35:23,131",
    "end": "01:35:24,151",
    "start_sec": 5723.131,
    "end_sec": 5724.151,
    "zh": "原来这就是你们",
    "vi": "Hóa ra đây là cách các anh"
  },
  {
    "idx": 3518,
    "start": "01:35:24,151",
    "end": "01:35:25,711",
    "start_sec": 5724.151,
    "end_sec": 5725.711,
    "zh": "对人体融合诡异的称呼",
    "vi": "gọi việc dung hợp quỷ dị vào cơ thể người."
  },
  {
    "idx": 3519,
    "start": "01:35:25,711",
    "end": "01:35:26,351",
    "start_sec": 5725.711,
    "end_sec": 5726.351,
    "zh": "小子",
    "vi": "Nhóc con."
  },
  {
    "idx": 3520,
    "start": "01:35:26,351",
    "end": "01:35:27,991",
    "start_sec": 5726.351,
    "end_sec": 5727.991,
    "zh": "我就不知道你哪来的底气",
    "vi": "Ta không biết ngươi lấy đâu ra tự tin"
  },
  {
    "idx": 3521,
    "start": "01:35:27,991",
    "end": "01:35:29,511",
    "start_sec": 5727.991,
    "end_sec": 5729.511,
    "zh": "敢用高童速威胁我",
    "vi": "mà dám dùng Cao Đồng Tố để đe dọa ta."
  },
  {
    "idx": 3522,
    "start": "01:35:29,511",
    "end": "01:35:30,791",
    "start_sec": 5729.511,
    "end_sec": 5730.791,
    "zh": "要知道我们御鬼者",
    "vi": "Phải biết rằng ngự quỷ giả chúng ta"
  },
  {
    "idx": 3523,
    "start": "01:35:30,791",
    "end": "01:35:32,071",
    "start_sec": 5730.791,
    "end_sec": 5732.071,
    "zh": "杀你们这些狂人",
    "vi": "giết những kẻ điên như các ngươi"
  },
  {
    "idx": 3524,
    "start": "01:35:32,071",
    "end": "01:35:33,931",
    "start_sec": 5732.071,
    "end_sec": 5733.931,
    "zh": "就跟捏死一只蚂蚁一样简单",
    "vi": "cũng dễ dàng như bóp chết một con kiến vậy."
  },
  {
    "idx": 3525,
    "start": "01:35:33,931",
    "end": "01:35:35,231",
    "start_sec": 5733.931,
    "end_sec": 5735.231,
    "zh": "算不上威胁",
    "vi": "Không tính là đe dọa."
  },
  {
    "idx": 3526,
    "start": "01:35:35,231",
    "end": "01:35:36,331",
    "start_sec": 5735.231,
    "end_sec": 5736.331,
    "zh": "起初我也不确定",
    "vi": "Ban đầu tôi cũng không chắc"
  },
  {
    "idx": 3527,
    "start": "01:35:36,331",
    "end": "01:35:37,671",
    "start_sec": 5736.331,
    "end_sec": 5737.671,
    "zh": "你们是不是急需高童速",
    "vi": "các anh có đang rất cần Cao Đồng Tố hay không."
  },
  {
    "idx": 3528,
    "start": "01:35:37,671",
    "end": "01:35:39,351",
    "start_sec": 5737.671,
    "end_sec": 5739.351,
    "zh": "但既然你们能找到这儿",
    "vi": "Nhưng vì các anh đã tìm được đến đây"
  },
  {
    "idx": 3529,
    "start": "01:35:39,351",
    "end": "01:35:40,671",
    "start_sec": 5739.351,
    "end_sec": 5740.671,
    "zh": "就说明你们确实很需要",
    "vi": "thì chứng tỏ các anh thực sự rất cần nó."
  },
  {
    "idx": 3530,
    "start": "01:35:40,671",
    "end": "01:35:42,691",
    "start_sec": 5740.671,
    "end_sec": 5742.691,
    "zh": "所以我们可以合作",
    "vi": "Thế nên chúng ta có thể hợp tác."
  },
  {
    "idx": 3531,
    "start": "01:35:42,691",
    "end": "01:35:43,951",
    "start_sec": 5742.691,
    "end_sec": 5743.951,
    "zh": "你凭什么觉得",
    "vi": "Ngươi dựa vào đâu mà nghĩ"
  },
  {
    "idx": 3532,
    "start": "01:35:43,951",
    "end": "01:35:45,151",
    "start_sec": 5743.951,
    "end_sec": 5745.151,
    "zh": "你能和我们合作",
    "vi": "ngươi có thể hợp tác với chúng ta."
  },
  {
    "idx": 3533,
    "start": "01:35:45,151",
    "end": "01:35:45,951",
    "start_sec": 5745.151,
    "end_sec": 5745.951,
    "zh": "你配吗",
    "vi": "Ngươi xứng sao."
  },
  {
    "idx": 3534,
    "start": "01:35:45,951",
    "end": "01:35:47,351",
    "start_sec": 5745.951,
    "end_sec": 5747.351,
    "zh": "我知道你在想什么",
    "vi": "Tôi biết anh đang nghĩ gì."
  },
  {
    "idx": 3535,
    "start": "01:35:47,351",
    "end": "01:35:48,511",
    "start_sec": 5747.351,
    "end_sec": 5748.511,
    "zh": "你大可以把我杀了",
    "vi": "Anh hoàn toàn có thể giết tôi"
  },
  {
    "idx": 3536,
    "start": "01:35:48,511",
    "end": "01:35:49,351",
    "start_sec": 5748.511,
    "end_sec": 5749.351,
    "zh": "拿走高童速",
    "vi": "rồi cướp đi Cao Đồng Tố."
  },
  {
    "idx": 3537,
    "start": "01:35:49,351",
    "end": "01:35:51,251",
    "start_sec": 5749.351,
    "end_sec": 5751.251,
    "zh": "甚至连我身上的宝贝也拿走",
    "vi": "Thậm chí là cướp luôn cả bảo bối trên người tôi."
  },
  {
    "idx": 3538,
    "start": "01:35:51,251",
    "end": "01:35:52,071",
    "start_sec": 5751.251,
    "end_sec": 5752.071,
    "zh": "但不巧的是",
    "vi": "Nhưng không may là"
  },
  {
    "idx": 3539,
    "start": "01:35:52,071",
    "end": "01:35:53,271",
    "start_sec": 5752.071,
    "end_sec": 5753.271,
    "zh": "我身上就带来这",
    "vi": "tôi chỉ mang theo"
  },
  {
    "idx": 3540,
    "start": "01:35:53,271",
    "end": "01:35:53,991",
    "start_sec": 5753.271,
    "end_sec": 5753.991,
    "zh": "一只个花",
    "vi": "một ít này thôi."
  },
  {
    "idx": 3541,
    "start": "01:35:53,991",
    "end": "01:35:55,031",
    "start_sec": 5753.991,
    "end_sec": 5755.031,
    "zh": "你是不是不够用",
    "vi": "Có phải anh không đủ dùng không."
  },
  {
    "idx": 3542,
    "start": "01:35:55,031",
    "end": "01:35:56,871",
    "start_sec": 5755.031,
    "end_sec": 5756.871,
    "zh": "要不你先杀了我",
    "vi": "Hay là anh cứ giết tôi trước đi."
  },
  {
    "idx": 3543,
    "start": "01:35:56,871",
    "end": "01:35:57,891",
    "start_sec": 5756.871,
    "end_sec": 5757.891,
    "zh": "再去找找试试",
    "vi": "Rồi đi tìm thử xem sao."
  },
  {
    "idx": 3544,
    "start": "01:35:57,891",
    "end": "01:36:00,051",
    "start_sec": 5757.891,
    "end_sec": 5760.051,
    "zh": "零三七给橙子皮的话也不准",
    "vi": "Lời của 037 nói với Trần Tử Bì cũng không chắc chắn."
  },
  {
    "idx": 3545,
    "start": "01:36:00,051",
    "end": "01:36:00,651",
    "start_sec": 5760.051,
    "end_sec": 5760.651,
    "zh": "小子",
    "vi": "Thằng nhóc."
  },
  {
    "idx": 3546,
    "start": "01:36:00,651",
    "end": "01:36:01,911",
    "start_sec": 5760.651,
    "end_sec": 5761.911,
    "zh": "不得不说你很有胆量",
    "vi": "Phải thừa nhận là mày rất có gan."
  },
  {
    "idx": 3547,
    "start": "01:36:01,911",
    "end": "01:36:03,311",
    "start_sec": 5761.911,
    "end_sec": 5763.311,
    "zh": "难道你不怕死吗",
    "vi": "Không lẽ mày không sợ chết sao."
  },
  {
    "idx": 3548,
    "start": "01:36:03,311",
    "end": "01:36:03,711",
    "start_sec": 5763.311,
    "end_sec": 5763.711,
    "zh": "怕呀",
    "vi": "Sợ chứ."
  },
  {
    "idx": 3549,
    "start": "01:36:03,711",
    "end": "01:36:04,211",
    "start_sec": 5763.711,
    "end_sec": 5764.211,
    "zh": "当然怕",
    "vi": "Dĩ nhiên là sợ."
  },
  {
    "idx": 3550,
    "start": "01:36:04,211",
    "end": "01:36:05,011",
    "start_sec": 5764.211,
    "end_sec": 5765.011,
    "zh": "在这墓室里",
    "vi": "Trong ngôi mộ này."
  },
  {
    "idx": 3551,
    "start": "01:36:05,011",
    "end": "01:36:05,931",
    "start_sec": 5765.011,
    "end_sec": 5765.931,
    "zh": "人命比草剑",
    "vi": "Mạng người rẻ như rác."
  },
  {
    "idx": 3552,
    "start": "01:36:05,931",
    "end": "01:36:06,911",
    "start_sec": 5765.931,
    "end_sec": 5766.911,
    "zh": "随时都可能死",
    "vi": "Có thể chết bất cứ lúc nào."
  },
  {
    "idx": 3553,
    "start": "01:36:06,911",
    "end": "01:36:07,931",
    "start_sec": 5766.911,
    "end_sec": 5767.931,
    "zh": "正因为怕死",
    "vi": "Chính vì sợ chết."
  },
  {
    "idx": 3554,
    "start": "01:36:07,931",
    "end": "01:36:10,071",
    "start_sec": 5767.931,
    "end_sec": 5770.071,
    "zh": "所以我才要尽可能获取能保命的线索",
    "vi": "Nên tôi mới phải cố gắng thu thập manh mối giữ mạng."
  },
  {
    "idx": 3555,
    "start": "01:36:10,071",
    "end": "01:36:10,711",
    "start_sec": 5770.071,
    "end_sec": 5770.711,
    "zh": "不瞒你说",
    "vi": "Không giấu gì anh."
  },
  {
    "idx": 3556,
    "start": "01:36:10,711",
    "end": "01:36:12,451",
    "start_sec": 5770.711,
    "end_sec": 5772.451,
    "zh": "其实昨天我就死过一次了",
    "vi": "Thật ra hôm qua tôi đã chết một lần rồi."
  },
  {
    "idx": 3557,
    "start": "01:36:12,451",
    "end": "01:36:14,031",
    "start_sec": 5772.451,
    "end_sec": 5774.031,
    "zh": "零三七打亮这橙子皮",
    "vi": "037 quan sát Trần Tử Bì."
  },
  {
    "idx": 3558,
    "start": "01:36:14,031",
    "end": "01:36:15,571",
    "start_sec": 5774.031,
    "end_sec": 5775.571,
    "zh": "全当他说了句玩笑",
    "vi": "Chỉ coi đó là một lời nói đùa."
  },
  {
    "idx": 3559,
    "start": "01:36:15,571",
    "end": "01:36:17,371",
    "start_sec": 5775.571,
    "end_sec": 5777.371,
    "zh": "他似乎有点欣赏这小子了",
    "vi": "Hắn dường như có chút xem trọng thằng nhóc này rồi."
  },
  {
    "idx": 3560,
    "start": "01:36:17,371",
    "end": "01:36:18,231",
    "start_sec": 5777.371,
    "end_sec": 5778.231,
    "zh": "其实吧",
    "vi": "Thật ra thì."
  },
  {
    "idx": 3561,
    "start": "01:36:18,231",
    "end": "01:36:20,031",
    "start_sec": 5778.231,
    "end_sec": 5780.031,
    "zh": "高层一直有能人预测过未来",
    "vi": "Cấp trên luôn có những kỳ nhân dự đoán được tương lai."
  },
  {
    "idx": 3562,
    "start": "01:36:20,031",
    "end": "01:36:21,571",
    "start_sec": 5780.031,
    "end_sec": 5781.571,
    "zh": "也假设过现在的情况",
    "vi": "Cũng đã giả định tình huống hiện tại."
  },
  {
    "idx": 3563,
    "start": "01:36:21,571",
    "end": "01:36:22,171",
    "start_sec": 5781.571,
    "end_sec": 5782.171,
    "zh": "为此",
    "vi": "Vì vậy."
  },
  {
    "idx": 3564,
    "start": "01:36:22,171",
    "end": "01:36:25,131",
    "start_sec": 5782.171,
    "end_sec": 5785.131,
    "zh": "国家单独成立了研究部来应对这种情况",
    "vi": "Quốc gia đã thành lập riêng một bộ nghiên cứu để đối phó với tình huống này."
  },
  {
    "idx": 3565,
    "start": "01:36:25,131",
    "end": "01:36:26,411",
    "start_sec": 5785.131,
    "end_sec": 5786.411,
    "zh": "目前已知的是",
    "vi": "Hiện tại điều đã biết là."
  },
  {
    "idx": 3566,
    "start": "01:36:26,411",
    "end": "01:36:29,211",
    "start_sec": 5786.411,
    "end_sec": 5789.211,
    "zh": "福道法法器对鬼医有克制效果",
    "vi": "Pháp khí Phật Đạo có hiệu quả khắc chế đối với quỷ."
  },
  {
    "idx": 3567,
    "start": "01:36:29,211",
    "end": "01:36:29,671",
    "start_sec": 5789.211,
    "end_sec": 5789.671,
    "zh": "但不多",
    "vi": "Nhưng không nhiều."
  },
  {
    "idx": 3568,
    "start": "01:36:29,671",
    "end": "01:36:31,191",
    "start_sec": 5789.671,
    "end_sec": 5791.191,
    "zh": "而人要是想对付鬼",
    "vi": "Còn con người nếu muốn đối phó với quỷ."
  },
  {
    "idx": 3569,
    "start": "01:36:31,191",
    "end": "01:36:32,591",
    "start_sec": 5791.191,
    "end_sec": 5792.591,
    "zh": "就只有依靠鬼的力量",
    "vi": "Thì chỉ có thể dựa vào sức mạnh của quỷ."
  },
  {
    "idx": 3570,
    "start": "01:36:32,591",
    "end": "01:36:34,631",
    "start_sec": 5792.591,
    "end_sec": 5794.631,
    "zh": "这也就是御鬼者的出现契机",
    "vi": "Đây cũng chính là cơ hội xuất hiện của Ngự Quỷ Giả."
  },
  {
    "idx": 3571,
    "start": "01:36:34,631",
    "end": "01:36:35,191",
    "start_sec": 5794.631,
    "end_sec": 5795.191,
    "zh": "驾驭鬼",
    "vi": "Điều khiển quỷ."
  },
  {
    "idx": 3572,
    "start": "01:36:35,191",
    "end": "01:36:36,371",
    "start_sec": 5795.191,
    "end_sec": 5796.371,
    "zh": "那怎么驾驭鬼呢",
    "vi": "Vậy làm sao để điều khiển quỷ."
  },
  {
    "idx": 3573,
    "start": "01:36:36,371",
    "end": "01:36:37,031",
    "start_sec": 5796.371,
    "end_sec": 5797.031,
    "zh": "驾驭",
    "vi": "Điều khiển sao."
  },
  {
    "idx": 3574,
    "start": "01:36:37,031",
    "end": "01:36:37,891",
    "start_sec": 5797.031,
    "end_sec": 5797.891,
    "zh": "你想多了",
    "vi": "Bạn nghĩ nhiều quá rồi."
  },
  {
    "idx": 3575,
    "start": "01:36:37,891",
    "end": "01:36:39,031",
    "start_sec": 5797.891,
    "end_sec": 5799.031,
    "zh": "人不可能驾驭鬼",
    "vi": "Con người không thể điều khiển được quỷ."
  },
  {
    "idx": 3576,
    "start": "01:36:39,031",
    "end": "01:36:41,171",
    "start_sec": 5799.031,
    "end_sec": 5801.171,
    "zh": "只能趁着鬼医或者鬼医道具",
    "vi": "Chỉ có thể nhân lúc quỷ hoặc đạo cụ quỷ dị"
  },
  {
    "idx": 3577,
    "start": "01:36:41,171",
    "end": "01:36:43,651",
    "start_sec": 5801.171,
    "end_sec": 5803.651,
    "zh": "向未形成灵智的时候强行寄生",
    "vi": "chưa hình thành trí khôn mà cưỡng ép ký sinh."
  },
  {
    "idx": 3578,
    "start": "01:36:43,651",
    "end": "01:36:44,871",
    "start_sec": 5803.651,
    "end_sec": 5804.871,
    "zh": "会不会有什么弊端",
    "vi": "Liệu có tác hại gì không."
  },
  {
    "idx": 3579,
    "start": "01:36:44,871",
    "end": "01:36:45,491",
    "start_sec": 5804.871,
    "end_sec": 5805.491,
    "zh": "有",
    "vi": "Có chứ."
  },
  {
    "idx": 3580,
    "start": "01:36:45,491",
    "end": "01:36:47,511",
    "start_sec": 5805.491,
    "end_sec": 5807.511,
    "zh": "一旦过度使用鬼医的力量",
    "vi": "Một khi lạm dụng sức mạnh của quỷ"
  },
  {
    "idx": 3581,
    "start": "01:36:47,511",
    "end": "01:36:49,571",
    "start_sec": 5807.511,
    "end_sec": 5809.571,
    "zh": "它就会在你体内慢慢苏醒",
    "vi": "nó sẽ dần thức tỉnh trong cơ thể bạn."
  },
  {
    "idx": 3582,
    "start": "01:36:49,571",
    "end": "01:36:50,631",
    "start_sec": 5809.571,
    "end_sec": 5810.631,
    "zh": "渐渐吞噬你",
    "vi": "Rồi từ từ nuốt chửng bạn."
  },
  {
    "idx": 3583,
    "start": "01:36:50,631",
    "end": "01:36:52,751",
    "start_sec": 5810.631,
    "end_sec": 5812.751,
    "zh": "诡异的苏醒几乎是不可逆的",
    "vi": "Sự thức tỉnh của quỷ gần như là không thể đảo ngược."
  },
  {
    "idx": 3584,
    "start": "01:36:52,751",
    "end": "01:36:55,291",
    "start_sec": 5812.751,
    "end_sec": 5815.291,
    "zh": "只能以外力降低他们的苏醒速度",
    "vi": "Chỉ có thể dùng lực bên ngoài để giảm tốc độ thức tỉnh của chúng."
  },
  {
    "idx": 3585,
    "start": "01:36:55,291",
    "end": "01:36:57,031",
    "start_sec": 5815.291,
    "end_sec": 5817.031,
    "zh": "每个诡异的克制因素不同",
    "vi": "Mỗi con quỷ đều có yếu tố khắc chế khác nhau."
  },
  {
    "idx": 3586,
    "start": "01:36:57,031",
    "end": "01:36:59,931",
    "start_sec": 5817.031,
    "end_sec": 5819.931,
    "zh": "可能有的诡异苏醒需要用人血克制",
    "vi": "Có thể có con quỷ khi thức tỉnh cần dùng máu người để khắc chế."
  },
  {
    "idx": 3587,
    "start": "01:36:59,931",
    "end": "01:37:01,591",
    "start_sec": 5819.931,
    "end_sec": 5821.591,
    "zh": "有的则是要用血肉攻击",
    "vi": "Có con lại cần dùng máu thịt để tấn công."
  },
  {
    "idx": 3588,
    "start": "01:37:01,591",
    "end": "01:37:02,551",
    "start_sec": 5821.591,
    "end_sec": 5822.551,
    "zh": "明白了",
    "vi": "Tôi hiểu rồi."
  },
  {
    "idx": 3589,
    "start": "01:37:02,551",
    "end": "01:37:02,971",
    "start_sec": 5822.551,
    "end_sec": 5822.971,
    "zh": "对了",
    "vi": "Đúng rồi."
  },
  {
    "idx": 3590,
    "start": "01:37:02,971",
    "end": "01:37:04,131",
    "start_sec": 5822.971,
    "end_sec": 5824.131,
    "zh": "你们是不是要去永德寺",
    "vi": "Có phải các bạn định đến chùa Vĩnh Đức không."
  },
  {
    "idx": 3591,
    "start": "01:37:04,131",
    "end": "01:37:06,051",
    "start_sec": 5824.131,
    "end_sec": 5826.051,
    "zh": "那里是唯一的撤离地点吗",
    "vi": "Nơi đó là điểm sơ tán duy nhất sao."
  },
  {
    "idx": 3592,
    "start": "01:37:06,051",
    "end": "01:37:06,711",
    "start_sec": 5826.051,
    "end_sec": 5826.711,
    "zh": "没了",
    "vi": "Không phải."
  },
  {
    "idx": 3593,
    "start": "01:37:06,711",
    "end": "01:37:07,771",
    "start_sec": 5826.711,
    "end_sec": 5827.771,
    "zh": "一共就两个",
    "vi": "Tổng cộng có hai nơi."
  },
  {
    "idx": 3594,
    "start": "01:37:07,771",
    "end": "01:37:11,451",
    "start_sec": 5827.771,
    "end_sec": 5831.451,
    "zh": "一是优先保护高层的御鬼者送人到南城和邮轮上",
    "vi": "Một là ưu tiên bảo vệ những người điều khiển quỷ cấp cao để đưa họ đến Nam Thành và lên du thuyền."
  },
  {
    "idx": 3595,
    "start": "01:37:11,451",
    "end": "01:37:11,891",
    "start_sec": 5831.451,
    "end_sec": 5831.891,
    "zh": "其次",
    "vi": "Thứ hai."
  },
  {
    "idx": 3596,
    "start": "01:37:11,891",
    "end": "01:37:13,311",
    "start_sec": 5831.891,
    "end_sec": 5833.311,
    "zh": "永德寺作为备选方案",
    "vi": "Chùa Vĩnh Đức được dùng làm phương án dự phòng."
  },
  {
    "idx": 3597,
    "start": "01:37:13,311",
    "end": "01:37:15,791",
    "start_sec": 5833.311,
    "end_sec": 5835.791,
    "zh": "用于应对突发情况成立的撤离点",
    "vi": "Là điểm sơ tán được thiết lập để ứng phó với các tình huống khẩn cấp."
  },
  {
    "idx": 3598,
    "start": "01:37:15,791",
    "end": "01:37:16,771",
    "start_sec": 5835.791,
    "end_sec": 5836.771,
    "zh": "突发情况",
    "vi": "Tình huống khẩn cấp sao."
  },
  {
    "idx": 3599,
    "start": "01:37:16,771",
    "end": "01:37:17,451",
    "start_sec": 5836.771,
    "end_sec": 5837.451,
    "zh": "比如",
    "vi": "Ví dụ như."
  },
  {
    "idx": 3600,
    "start": "01:37:17,451",
    "end": "01:37:19,331",
    "start_sec": 5837.451,
    "end_sec": 5839.331,
    "zh": "身上的诡异复苏了",
    "vi": "Con quỷ trên người thức tỉnh."
  },
  {
    "idx": 3601,
    "start": "01:37:19,331",
    "end": "01:37:21,351",
    "start_sec": 5839.331,
    "end_sec": 5841.351,
    "zh": "可能会伤害到游轮上的高层",
    "vi": "Có thể làm hại những người cấp cao trên du thuyền"
  },
  {
    "idx": 3602,
    "start": "01:37:21,351",
    "end": "01:37:22,811",
    "start_sec": 5841.351,
    "end_sec": 5842.811,
    "zh": "所以我只能走背后来",
    "vi": "Nên ta chỉ có thể đi đường vòng"
  },
  {
    "idx": 3603,
    "start": "01:37:22,811",
    "end": "01:37:24,931",
    "start_sec": 5842.811,
    "end_sec": 5844.931,
    "zh": "不过你小子也算运气好",
    "vi": "Nhưng cậu nhóc cũng khá may mắn"
  },
  {
    "idx": 3604,
    "start": "01:37:24,931",
    "end": "01:37:25,611",
    "start_sec": 5844.931,
    "end_sec": 5845.611,
    "zh": "遇到了我",
    "vi": "Khi gặp được ta"
  },
  {
    "idx": 3605,
    "start": "01:37:25,611",
    "end": "01:37:27,151",
    "start_sec": 5845.611,
    "end_sec": 5847.151,
    "zh": "我可以保护你去永德寺",
    "vi": "Ta có thể bảo vệ cậu đến chùa Vĩnh Đức"
  },
  {
    "idx": 3606,
    "start": "01:37:27,151",
    "end": "01:37:30,331",
    "start_sec": 5847.151,
    "end_sec": 5850.331,
    "zh": "永德寺已经死在那里了",
    "vi": "Chùa Vĩnh Đức đã chết ở đó rồi"
  },
  {
    "idx": 3607,
    "start": "01:37:30,331",
    "end": "01:37:31,151",
    "start_sec": 5850.331,
    "end_sec": 5851.151,
    "zh": "还要再去吗",
    "vi": "Vẫn còn muốn đi sao"
  },
  {
    "idx": 3608,
    "start": "01:37:31,151",
    "end": "01:37:32,711",
    "start_sec": 5851.151,
    "end_sec": 5852.711,
    "zh": "这个零三七似乎挺强的",
    "vi": "Cái 037 này có vẻ khá mạnh"
  },
  {
    "idx": 3609,
    "start": "01:37:32,711",
    "end": "01:37:34,491",
    "start_sec": 5852.711,
    "end_sec": 5854.491,
    "zh": "他应该可以抗衡永德寺外的诡异吧",
    "vi": "Nó có thể chống lại những thứ kỳ lạ bên ngoài chùa Vĩnh Đức chứ"
  },
  {
    "idx": 3610,
    "start": "01:37:34,491",
    "end": "01:37:36,791",
    "start_sec": 5854.491,
    "end_sec": 5856.791,
    "zh": "长子皮沉思片刻点了点头",
    "vi": "Trường Tử Bì trầm ngâm một lát rồi gật đầu"
  },
  {
    "idx": 3611,
    "start": "01:37:36,791",
    "end": "01:37:37,071",
    "start_sec": 5856.791,
    "end_sec": 5857.071,
    "zh": "行",
    "vi": "Được"
  },
  {
    "idx": 3612,
    "start": "01:37:37,071",
    "end": "01:37:39,191",
    "start_sec": 5857.071,
    "end_sec": 5859.191,
    "zh": "我去个小区域把我的狗接回来",
    "vi": "Ta đi một khu nhỏ để đón con chó của ta về"
  },
  {
    "idx": 3613,
    "start": "01:37:39,191",
    "end": "01:37:40,111",
    "start_sec": 5859.191,
    "end_sec": 5860.111,
    "zh": "再准备点东西",
    "vi": "Rồi chuẩn bị chút đồ"
  },
  {
    "idx": 3614,
    "start": "01:37:40,111",
    "end": "01:37:40,831",
    "start_sec": 5860.111,
    "end_sec": 5860.831,
    "zh": "对了",
    "vi": "Đúng rồi"
  },
  {
    "idx": 3615,
    "start": "01:37:40,831",
    "end": "01:37:41,711",
    "start_sec": 5860.831,
    "end_sec": 5861.711,
    "zh": "你也跟我一起去",
    "vi": "Cậu cũng đi với ta"
  },
  {
    "idx": 3616,
    "start": "01:37:41,711",
    "end": "01:37:43,171",
    "start_sec": 5861.711,
    "end_sec": 5863.171,
    "zh": "顺便帮我杀几个人",
    "vi": "Nhân tiện giúp ta giết vài người"
  },
  {
    "idx": 3617,
    "start": "01:37:43,171",
    "end": "01:37:43,511",
    "start_sec": 5863.171,
    "end_sec": 5863.511,
    "zh": "文言",
    "vi": "Văn Ngôn"
  },
  {
    "idx": 3618,
    "start": "01:37:43,511",
    "end": "01:37:45,671",
    "start_sec": 5863.511,
    "end_sec": 5865.671,
    "zh": "零三七诧异的看了长子皮一眼",
    "vi": "037 ngạc nhiên nhìn Trường Tử Bì"
  },
  {
    "idx": 3619,
    "start": "01:37:45,671",
    "end": "01:37:47,871",
    "start_sec": 5865.671,
    "end_sec": 5867.871,
    "zh": "长子皮原本是打算到了晚上",
    "vi": "Trường Tử Bì vốn định buổi tối"
  },
  {
    "idx": 3620,
    "start": "01:37:47,871",
    "end": "01:37:49,031",
    "start_sec": 5867.871,
    "end_sec": 5869.031,
    "zh": "利用香炉的威慑",
    "vi": "Sử dụng uy lực của lư hương"
  },
  {
    "idx": 3621,
    "start": "01:37:49,031",
    "end": "01:37:50,271",
    "start_sec": 5869.031,
    "end_sec": 5870.271,
    "zh": "看看能不能把敲门",
    "vi": "Xem có thể dồn con quỷ gõ cửa"
  },
  {
    "idx": 3622,
    "start": "01:37:50,271",
    "end": "01:37:51,231",
    "start_sec": 5870.271,
    "end_sec": 5871.231,
    "zh": "鬼逼到便利店",
    "vi": "Vào cửa hàng tiện lợi không"
  },
  {
    "idx": 3623,
    "start": "01:37:51,231",
    "end": "01:37:51,971",
    "start_sec": 5871.231,
    "end_sec": 5871.971,
    "zh": "现在看来",
    "vi": "Giờ xem ra"
  },
  {
    "idx": 3624,
    "start": "01:37:51,971",
    "end": "01:37:52,951",
    "start_sec": 5871.971,
    "end_sec": 5872.951,
    "zh": "有灵三七跟着",
    "vi": "Có 037 đi cùng"
  },
  {
    "idx": 3625,
    "start": "01:37:52,951",
    "end": "01:37:54,031",
    "start_sec": 5872.951,
    "end_sec": 5874.031,
    "zh": "似乎不用那么麻烦",
    "vi": "Có vẻ không cần phiền phức như vậy nữa"
  },
  {
    "idx": 3626,
    "start": "01:37:54,031",
    "end": "01:38:01,091",
    "start_sec": 5874.031,
    "end_sec": 5881.091,
    "zh": "罗 罗姐",
    "vi": "La La tỷ"
  },
  {
    "idx": 3627,
    "start": "01:38:01,091",
    "end": "01:38:02,851",
    "start_sec": 5881.091,
    "end_sec": 5882.851,
    "zh": "橙子皮回来了",
    "vi": "Trường Tử Bì đã về rồi"
  },
  {
    "idx": 3628,
    "start": "01:38:02,851",
    "end": "01:38:03,711",
    "start_sec": 5882.851,
    "end_sec": 5883.711,
    "zh": "回来就回来呗",
    "vi": "Về thì về thôi"
  },
  {
    "idx": 3629,
    "start": "01:38:03,711",
    "end": "01:38:04,231",
    "start_sec": 5883.711,
    "end_sec": 5884.231,
    "zh": "帮什么",
    "vi": "Giúp gì chứ"
  },
  {
    "idx": 3630,
    "start": "01:38:04,231",
    "end": "01:38:06,411",
    "start_sec": 5884.231,
    "end_sec": 5886.411,
    "zh": "她不是一个人回来的",
    "vi": "Cô ấy không về một mình"
  },
  {
    "idx": 3631,
    "start": "01:38:06,411",
    "end": "01:38:07,271",
    "start_sec": 5886.411,
    "end_sec": 5887.271,
    "zh": "她带了几个",
    "vi": "Cô ta dẫn theo vài người."
  },
  {
    "idx": 3632,
    "start": "01:38:07,271",
    "end": "01:38:09,011",
    "start_sec": 5887.271,
    "end_sec": 5889.011,
    "zh": "穿着打扮特殊的人",
    "vi": "Ăn mặc trông rất lạ lùng."
  },
  {
    "idx": 3633,
    "start": "01:38:09,011",
    "end": "01:38:09,591",
    "start_sec": 5889.011,
    "end_sec": 5889.591,
    "zh": "而且",
    "vi": "Hơn nữa."
  },
  {
    "idx": 3634,
    "start": "01:38:09,591",
    "end": "01:38:10,811",
    "start_sec": 5889.591,
    "end_sec": 5890.811,
    "zh": "而且她们好像",
    "vi": "Hơn nữa bọn họ dường như."
  },
  {
    "idx": 3635,
    "start": "01:38:10,811",
    "end": "01:38:12,551",
    "start_sec": 5890.811,
    "end_sec": 5892.551,
    "zh": "不怕绿化带里的女鬼",
    "vi": "Không sợ con ma nữ trong dải cây xanh."
  },
  {
    "idx": 3636,
    "start": "01:38:12,551",
    "end": "01:38:13,751",
    "start_sec": 5892.551,
    "end_sec": 5893.751,
    "zh": "什么",
    "vi": "Cái gì cơ."
  },
  {
    "idx": 3637,
    "start": "01:38:13,751",
    "end": "01:38:15,031",
    "start_sec": 5893.751,
    "end_sec": 5895.031,
    "zh": "罗姐 怎么办",
    "vi": "Chị La, giờ phải làm sao."
  },
  {
    "idx": 3638,
    "start": "01:38:15,031",
    "end": "01:38:16,831",
    "start_sec": 5895.031,
    "end_sec": 5896.831,
    "zh": "咱们今天刚想了她的狗",
    "vi": "Hôm nay chúng ta vừa mới bắt chó của cô ta."
  },
  {
    "idx": 3639,
    "start": "01:38:16,831",
    "end": "01:38:19,731",
    "start_sec": 5896.831,
    "end_sec": 5899.731,
    "zh": "你说他不会带着那伙人来找我们麻烦吧",
    "vi": "Cô nói xem liệu cô ta có dẫn đám người đó đến gây chuyện không."
  },
  {
    "idx": 3640,
    "start": "01:38:19,731",
    "end": "01:38:20,631",
    "start_sec": 5899.731,
    "end_sec": 5900.631,
    "zh": "先看看吧",
    "vi": "Cứ xem tình hình đã."
  },
  {
    "idx": 3641,
    "start": "01:38:20,631",
    "end": "01:38:21,551",
    "start_sec": 5900.631,
    "end_sec": 5901.551,
    "zh": "到时候大不了",
    "vi": "Đến lúc đó cùng lắm thì."
  },
  {
    "idx": 3642,
    "start": "01:38:21,551",
    "end": "01:38:22,811",
    "start_sec": 5901.551,
    "end_sec": 5902.811,
    "zh": "咱们把狗还给他",
    "vi": "Chúng ta trả chó lại cho cô ta."
  },
  {
    "idx": 3643,
    "start": "01:38:22,811",
    "end": "01:38:23,811",
    "start_sec": 5902.811,
    "end_sec": 5903.811,
    "zh": "不多吗",
    "vi": "Không đông người à."
  },
  {
    "idx": 3644,
    "start": "01:38:23,811",
    "end": "01:38:24,071",
    "start_sec": 5903.811,
    "end_sec": 5904.071,
    "zh": "不多",
    "vi": "Không đông."
  },
  {
    "idx": 3645,
    "start": "01:38:24,071",
    "end": "01:38:25,971",
    "start_sec": 5904.071,
    "end_sec": 5905.971,
    "zh": "但看起来像政府的人",
    "vi": "Nhưng trông họ giống người của chính phủ."
  },
  {
    "idx": 3646,
    "start": "01:38:25,971",
    "end": "01:38:27,011",
    "start_sec": 5905.971,
    "end_sec": 5907.011,
    "zh": "管他什么人",
    "vi": "Mặc kệ họ là ai."
  },
  {
    "idx": 3647,
    "start": "01:38:27,011",
    "end": "01:38:27,671",
    "start_sec": 5907.011,
    "end_sec": 5907.671,
    "zh": "这样得住",
    "vi": "Phải đề phòng thôi."
  },
  {
    "idx": 3648,
    "start": "01:38:27,671",
    "end": "01:38:29,311",
    "start_sec": 5907.671,
    "end_sec": 5909.311,
    "zh": "你把你那一家五口叫上",
    "vi": "Bạn gọi năm người nhà bạn đến đây."
  },
  {
    "idx": 3649,
    "start": "01:38:29,311",
    "end": "01:38:30,211",
    "start_sec": 5909.311,
    "end_sec": 5910.211,
    "zh": "准备好家伙",
    "vi": "Chuẩn bị sẵn hung khí đi."
  },
  {
    "idx": 3650,
    "start": "01:38:30,211",
    "end": "01:38:31,871",
    "start_sec": 5910.211,
    "end_sec": 5911.871,
    "zh": "他妈的",
    "vi": "Mẹ kiếp."
  },
  {
    "idx": 3651,
    "start": "01:38:31,871",
    "end": "01:38:32,711",
    "start_sec": 5911.871,
    "end_sec": 5912.711,
    "zh": "你小子",
    "vi": "Thằng nhóc này."
  },
  {
    "idx": 3652,
    "start": "01:38:32,711",
    "end": "01:38:33,351",
    "start_sec": 5912.711,
    "end_sec": 5913.351,
    "zh": "太鸡贼了吧",
    "vi": "Khôn lỏi quá nhỉ."
  },
  {
    "idx": 3653,
    "start": "01:38:33,351",
    "end": "01:38:34,251",
    "start_sec": 5913.351,
    "end_sec": 5914.251,
    "zh": "一只一只的给",
    "vi": "Cứ đưa từng con một."
  },
  {
    "idx": 3654,
    "start": "01:38:34,251",
    "end": "01:38:35,031",
    "start_sec": 5914.251,
    "end_sec": 5915.031,
    "zh": "没办法",
    "vi": "Không còn cách nào khác."
  },
  {
    "idx": 3655,
    "start": "01:38:35,031",
    "end": "01:38:36,411",
    "start_sec": 5915.031,
    "end_sec": 5916.411,
    "zh": "总不能我一丝心全给你",
    "vi": "Chẳng lẽ tôi lại đưa hết cho bạn."
  },
  {
    "idx": 3656,
    "start": "01:38:36,411",
    "end": "01:38:37,491",
    "start_sec": 5916.411,
    "end_sec": 5917.491,
    "zh": "你反手把我杀了吧",
    "vi": "Rồi bạn quay lại giết tôi sao."
  },
  {
    "idx": 3657,
    "start": "01:38:37,491",
    "end": "01:38:38,191",
    "start_sec": 5917.491,
    "end_sec": 5918.191,
    "zh": "话说",
    "vi": "Mà này."
  },
  {
    "idx": 3658,
    "start": "01:38:38,191",
    "end": "01:38:40,111",
    "start_sec": 5918.191,
    "end_sec": 5920.111,
    "zh": "你这小区里住的三只鬼一",
    "vi": "Ba con ma sống trong khu chung cư của bạn."
  },
  {
    "idx": 3659,
    "start": "01:38:40,111",
    "end": "01:38:41,111",
    "start_sec": 5920.111,
    "end_sec": 5921.111,
    "zh": "一只刚成形",
    "vi": "Một con vừa mới thành hình."
  },
  {
    "idx": 3660,
    "start": "01:38:41,111",
    "end": "01:38:42,191",
    "start_sec": 5921.111,
    "end_sec": 5922.191,
    "zh": "一只还没进化",
    "vi": "Một con vẫn chưa tiến hóa."
  },
  {
    "idx": 3661,
    "start": "01:38:42,191",
    "end": "01:38:43,331",
    "start_sec": 5922.191,
    "end_sec": 5923.331,
    "zh": "还有一只在进化",
    "vi": "Vẫn còn một con đang tiến hóa."
  },
  {
    "idx": 3662,
    "start": "01:38:43,331",
    "end": "01:38:44,851",
    "start_sec": 5923.331,
    "end_sec": 5924.851,
    "zh": "在进化的这只还他妈",
    "vi": "Con đang tiến hóa này lại còn khốn kiếp"
  },
  {
    "idx": 3663,
    "start": "01:38:44,851",
    "end": "01:38:46,191",
    "start_sec": 5924.851,
    "end_sec": 5926.191,
    "zh": "就在你屋里隐藏着",
    "vi": "ẩn nấp ngay trong phòng của bạn."
  },
  {
    "idx": 3664,
    "start": "01:38:46,191",
    "end": "01:38:48,191",
    "start_sec": 5926.191,
    "end_sec": 5928.191,
    "zh": "你身上的到底是什么宝贝",
    "vi": "Rốt cuộc trên người bạn có bảo bối gì"
  },
  {
    "idx": 3665,
    "start": "01:38:48,191",
    "end": "01:38:50,831",
    "start_sec": 5928.191,
    "end_sec": 5930.831,
    "zh": "连小区里有几只鬼异都感受得这么清楚",
    "vi": "mà lại cảm nhận rõ được trong khu có bao nhiêu quỷ dị như vậy."
  },
  {
    "idx": 3666,
    "start": "01:38:50,831",
    "end": "01:38:52,291",
    "start_sec": 5930.831,
    "end_sec": 5932.291,
    "zh": "虽说成为御鬼者有弊端",
    "vi": "Tuy nói trở thành Ngự Quỷ Giả có hại"
  },
  {
    "idx": 3667,
    "start": "01:38:52,291",
    "end": "01:38:54,171",
    "start_sec": 5932.291,
    "end_sec": 5934.171,
    "zh": "但这好处也是实打实的呀",
    "vi": "nhưng lợi ích này cũng là thật sự."
  },
  {
    "idx": 3668,
    "start": "01:38:54,171",
    "end": "01:38:56,651",
    "start_sec": 5934.171,
    "end_sec": 5936.651,
    "zh": "那只刚成型的鬼异气息太微弱",
    "vi": "Luồng khí của con quỷ dị vừa hình thành đó quá yếu"
  },
  {
    "idx": 3669,
    "start": "01:38:56,651",
    "end": "01:38:58,391",
    "start_sec": 5936.651,
    "end_sec": 5938.391,
    "zh": "应该是鬼异降临后自杀",
    "vi": "chắc là tự sát sau khi quỷ dị giáng lâm"
  },
  {
    "idx": 3670,
    "start": "01:38:58,391",
    "end": "01:38:59,311",
    "start_sec": 5938.391,
    "end_sec": 5939.311,
    "zh": "不形成的吧",
    "vi": "nên mới hình thành đúng không."
  },
  {
    "idx": 3671,
    "start": "01:38:59,311",
    "end": "01:39:01,631",
    "start_sec": 5939.311,
    "end_sec": 5941.631,
    "zh": "被杀人是无法形成鬼异的",
    "vi": "Người bị giết thì không thể hình thành quỷ dị."
  },
  {
    "idx": 3672,
    "start": "01:39:01,631",
    "end": "01:39:04,351",
    "start_sec": 5941.631,
    "end_sec": 5944.351,
    "zh": "要是那只刚成型的鬼异再晚点出现",
    "vi": "Nếu con quỷ dị vừa hình thành đó xuất hiện muộn hơn chút nữa"
  },
  {
    "idx": 3673,
    "start": "01:39:04,351",
    "end": "01:39:05,911",
    "start_sec": 5944.351,
    "end_sec": 5945.911,
    "zh": "说不定我能把他抓起来",
    "vi": "biết đâu tôi có thể bắt nó lại"
  },
  {
    "idx": 3674,
    "start": "01:39:05,911",
    "end": "01:39:07,011",
    "start_sec": 5945.911,
    "end_sec": 5947.011,
    "zh": "帮你成为御鬼者",
    "vi": "giúp bạn trở thành Ngự Quỷ Giả."
  },
  {
    "idx": 3675,
    "start": "01:39:07,011",
    "end": "01:39:08,691",
    "start_sec": 5947.011,
    "end_sec": 5948.691,
    "zh": "他这和大人有何",
    "vi": "Việc này của anh ta với đại nhân có gì"
  },
  {
    "idx": 3676,
    "start": "01:39:08,691",
    "end": "01:39:10,171",
    "start_sec": 5948.691,
    "end_sec": 5950.171,
    "zh": "总感觉怪怪的",
    "vi": "tổng thể cứ thấy kỳ lạ thế nào."
  },
  {
    "idx": 3677,
    "start": "01:39:10,171",
    "end": "01:39:11,911",
    "start_sec": 5950.171,
    "end_sec": 5951.911,
    "zh": "肠子皮简单装了点食物",
    "vi": "Trần Tử Bì đơn giản thu dọn ít thức ăn"
  },
  {
    "idx": 3678,
    "start": "01:39:11,911",
    "end": "01:39:13,791",
    "start_sec": 5951.911,
    "end_sec": 5953.791,
    "zh": "随后一行人潮便利店走去",
    "vi": "sau đó cả nhóm đi về phía cửa hàng tiện lợi."
  },
  {
    "idx": 3679,
    "start": "01:39:13,791",
    "end": "01:39:14,671",
    "start_sec": 5953.791,
    "end_sec": 5954.671,
    "zh": "小木居",
    "vi": "Tiểu Mộc Cư"
  },
  {
    "idx": 3680,
    "start": "01:39:14,671",
    "end": "01:39:15,991",
    "start_sec": 5954.671,
    "end_sec": 5955.991,
    "zh": "我来接你了",
    "vi": "ta đến đón ngươi đây."
  },
  {
    "idx": 3681,
    "start": "01:39:15,991",
    "end": "01:39:20,211",
    "start_sec": 5955.991,
    "end_sec": 5960.211,
    "zh": "憋什么急,橙子皮,不要以为带几个人过来,我们就怕你们。",
    "vi": "Vội cái gì, Trần Tử Bì, đừng tưởng dẫn theo vài người tới là chúng tôi sợ các người."
  },
  {
    "idx": 3682,
    "start": "01:39:20,391",
    "end": "01:39:23,871",
    "start_sec": 5960.391,
    "end_sec": 5963.871,
    "zh": "对,我们人多,打起来你们不一定打得过我们。",
    "vi": "Đúng vậy, chúng tôi đông người, đánh nhau chưa chắc các người đã thắng được chúng tôi."
  },
  {
    "idx": 3683,
    "start": "01:39:24,271",
    "end": "01:39:28,651",
    "start_sec": 5964.271,
    "end_sec": 5968.651,
    "zh": "罗宪看着橙子皮身后那人,总感觉他的脸烟冷的可怕,态度转下来。",
    "vi": "La Hiến nhìn người phía sau Trần Tử Bì, luôn cảm thấy khuôn mặt hắn lạnh lùng đến đáng sợ, thái độ liền dịu xuống."
  },
  {
    "idx": 3684,
    "start": "01:39:28,991",
    "end": "01:39:33,531",
    "start_sec": 5968.991,
    "end_sec": 5973.531,
    "zh": "要不这样吧,橙子皮,我们把狗还给你,咱们各过各的,两不相待请了吧。",
    "vi": "Hay là thế này đi, Trần Tử Bì, chúng tôi trả chó lại cho anh, chúng ta nước sông không phạm nước giếng, được chứ."
  },
  {
    "idx": 3685,
    "start": "01:39:34,011",
    "end": "01:39:35,871",
    "start_sec": 5974.011,
    "end_sec": 5975.871,
    "zh": "你觉得可怕吗?我说过,都是。",
    "vi": "Bạn thấy đáng sợ sao. Tôi đã nói rồi, đều là."
  },
  {
    "idx": 3686,
    "start": "01:39:36,111",
    "end": "01:39:37,491",
    "start_sec": 5976.111,
    "end_sec": 5977.491,
    "zh": "别真以为老子怕你们。",
    "vi": "Đừng tưởng ông đây thực sự sợ các người."
  },
  {
    "idx": 3687,
    "start": "01:39:37,831",
    "end": "01:39:43,051",
    "start_sec": 5977.831,
    "end_sec": 5983.051,
    "zh": "橙子皮话还没说完,只见赵德柱提着武器走上来,这是零三七不耐烦的开心。",
    "vi": "Trần Tử Bì chưa nói dứt lời, đã thấy Triệu Đức Trụ cầm vũ khí bước lên, lúc này 037 mất kiên nhẫn lên tiếng."
  },
  {
    "idx": 3688,
    "start": "01:39:43,371",
    "end": "01:39:44,691",
    "start_sec": 5983.371,
    "end_sec": 5984.691,
    "zh": "话真多,真烦。",
    "vi": "Nói nhiều quá, thật phiền phức."
  },
  {
    "idx": 3689,
    "start": "01:39:44,691",
    "end": "01:39:47,111",
    "start_sec": 5984.691,
    "end_sec": 5987.111,
    "zh": "037仅仅只是瞪一眼照的",
    "vi": "037 chỉ liếc nhìn Triệu Đức Trụ một cái"
  },
  {
    "idx": 3690,
    "start": "01:39:47,111",
    "end": "01:39:48,731",
    "start_sec": 5987.111,
    "end_sec": 5988.731,
    "zh": "看那光秃秃的脑袋上",
    "vi": "nhìn lên cái đầu trọc lóc kia."
  },
  {
    "idx": 3691,
    "start": "01:39:48,731",
    "end": "01:39:50,551",
    "start_sec": 5988.731,
    "end_sec": 5990.551,
    "zh": "只能开始让头发变得红了",
    "vi": "Tóc của hắn bắt đầu chuyển sang màu đỏ."
  },
  {
    "idx": 3692,
    "start": "01:39:50,551",
    "end": "01:39:52,091",
    "start_sec": 5990.551,
    "end_sec": 5992.091,
    "zh": "头发向他整张脸包裹",
    "vi": "Mái tóc bao phủ lấy toàn bộ khuôn mặt của hắn."
  },
  {
    "idx": 3693,
    "start": "01:39:52,091",
    "end": "01:39:53,451",
    "start_sec": 5992.091,
    "end_sec": 5993.451,
    "zh": "向他脖子蔓延着",
    "vi": "Vài lan dần xuống cổ của hắn."
  },
  {
    "idx": 3694,
    "start": "01:39:53,451",
    "end": "01:39:55,591",
    "start_sec": 5993.451,
    "end_sec": 5995.591,
    "zh": "你 你",
    "vi": "Mày, mày."
  },
  {
    "idx": 3695,
    "start": "01:40:00,000",
    "end": "01:40:05,120",
    "start_sec": 6000.0,
    "end_sec": 6005.12,
    "zh": "凌三七的眼神下跌,",
    "vi": "Ánh mắt của Lăng Tam Thất tối sầm lại."
  },
  {
    "idx": 3696,
    "start": "01:40:05,120",
    "end": "01:40:07,440",
    "start_sec": 6005.12,
    "end_sec": 6007.44,
    "zh": "上次的人头发全都开始疯掉了。",
    "vi": "Mái tóc của người kia bắt đầu mọc ra điên cuồng."
  },
  {
    "idx": 3697,
    "start": "01:40:07,440",
    "end": "01:40:11,160",
    "start_sec": 6007.44,
    "end_sec": 6011.16,
    "zh": "罗宪在这一门杀伤,",
    "vi": "Triệu Đức Trụ bị sát hại ngay tại chỗ."
  },
  {
    "idx": 3698,
    "start": "01:40:11,160",
    "end": "01:40:13,320",
    "start_sec": 6011.16,
    "end_sec": 6013.32,
    "zh": "跪下到城里一锋起锋。",
    "vi": "Hắn quỳ rạp xuống đất không ngừng dập đầu."
  },
  {
    "idx": 3699,
    "start": "01:40:13,320",
    "end": "01:40:14,240",
    "start_sec": 6013.32,
    "end_sec": 6014.24,
    "zh": "陈哥哥,",
    "vi": "Anh Trần."
  },
  {
    "idx": 3700,
    "start": "01:40:14,240",
    "end": "01:40:14,680",
    "start_sec": 6014.24,
    "end_sec": 6014.68,
    "zh": "你,",
    "vi": "Anh."
  },
  {
    "idx": 3701,
    "start": "01:40:14,680",
    "end": "01:40:15,440",
    "start_sec": 6014.68,
    "end_sec": 6015.44,
    "zh": "你杀我,",
    "vi": "Đừng giết tôi."
  },
  {
    "idx": 3702,
    "start": "01:40:15,440",
    "end": "01:40:16,120",
    "start_sec": 6015.44,
    "end_sec": 6016.12,
    "zh": "做错了,",
    "vi": "Tôi sai rồi."
  },
  {
    "idx": 3703,
    "start": "01:40:16,120",
    "end": "01:40:17,400",
    "start_sec": 6016.12,
    "end_sec": 6017.4,
    "zh": "我应该跟你作对,",
    "vi": "Tôi không nên đối đầu với anh."
  },
  {
    "idx": 3704,
    "start": "01:40:17,400",
    "end": "01:40:18,120",
    "start_sec": 6017.4,
    "end_sec": 6018.12,
    "zh": "你放过我,",
    "vi": "Xin anh tha cho tôi."
  },
  {
    "idx": 3705,
    "start": "01:40:18,120",
    "end": "01:40:19,680",
    "start_sec": 6018.12,
    "end_sec": 6019.68,
    "zh": "我愿意给你当名作吗?",
    "vi": "Tôi nguyện làm trâu làm ngựa cho anh."
  },
  {
    "idx": 3706,
    "start": "01:40:19,680",
    "end": "01:40:23,040",
    "start_sec": 6019.68,
    "end_sec": 6023.04,
    "zh": "看见没,",
    "vi": "Thấy chưa."
  },
  {
    "idx": 3707,
    "start": "01:40:23,040",
    "end": "01:40:24,120",
    "start_sec": 6023.04,
    "end_sec": 6024.12,
    "zh": "你就是一鬼种,",
    "vi": "Ngươi chỉ là một giống quỷ."
  },
  {
    "idx": 3708,
    "start": "01:40:24,120",
    "end": "01:40:25,440",
    "start_sec": 6024.12,
    "end_sec": 6025.44,
    "zh": "杀你们这些常人,",
    "vi": "Giết những người thường như các người."
  },
  {
    "idx": 3709,
    "start": "01:40:25,440",
    "end": "01:40:26,880",
    "start_sec": 6025.44,
    "end_sec": 6026.88,
    "zh": "犹如刷土鸡老狗一样。",
    "vi": "Cũng giống như giết gà giết chó vậy."
  },
  {
    "idx": 3710,
    "start": "01:40:26,880",
    "end": "01:40:28,560",
    "start_sec": 6026.88,
    "end_sec": 6028.56,
    "zh": "凌三七病态的效果,",
    "vi": "Tiếng cười bệnh hoạn của Lăng Tam Thất vang lên."
  },
  {
    "idx": 3711,
    "start": "01:40:28,560",
    "end": "01:40:29,800",
    "start_sec": 6028.56,
    "end_sec": 6029.8,
    "zh": "生命也变得尖锐,",
    "vi": "Giọng nói cũng trở nên sắc nhọn."
  },
  {
    "idx": 3712,
    "start": "01:40:29,800",
    "end": "01:40:30,940",
    "start_sec": 6029.8,
    "end_sec": 6030.94,
    "zh": "仿佛杀疯了一番",
    "vi": "Giống như đã giết đến điên cuồng."
  },
  {
    "idx": 3713,
    "start": "01:40:30,940",
    "end": "01:40:32,200",
    "start_sec": 6030.94,
    "end_sec": 6032.2,
    "zh": "橙子皮没敢回话",
    "vi": "Trần Tử Bì không dám trả lời."
  },
  {
    "idx": 3714,
    "start": "01:40:32,200",
    "end": "01:40:33,480",
    "start_sec": 6032.2,
    "end_sec": 6033.48,
    "zh": "转身走出便利店",
    "vi": "Anh quay người đi ra khỏi cửa hàng tiện lợi."
  },
  {
    "idx": 3715,
    "start": "01:40:33,480",
    "end": "01:40:35,360",
    "start_sec": 6033.48,
    "end_sec": 6035.36,
    "zh": "生怕他又受什么刺激失去理智",
    "vi": "Chỉ sợ hắn lại bị kích động gì đó mà mất đi lý trí."
  },
  {
    "idx": 3716,
    "start": "01:40:35,360",
    "end": "01:40:36,440",
    "start_sec": 6035.36,
    "end_sec": 6036.44,
    "zh": "把自己也杀了",
    "vi": "Rồi giết luôn cả mình."
  },
  {
    "idx": 3717,
    "start": "01:40:36,440",
    "end": "01:40:41,060",
    "start_sec": 6036.44,
    "end_sec": 6041.06,
    "zh": "注射完高瞳素",
    "vi": "Sau khi tiêm xong Cao Đồng Tố."
  },
  {
    "idx": 3718,
    "start": "01:40:41,060",
    "end": "01:40:43,140",
    "start_sec": 6041.06,
    "end_sec": 6043.14,
    "zh": "林三七细血的看了一眼橙子皮",
    "vi": "Lăng Tam Thất nhìn Trần Tử Bì đầy giễu cợt."
  },
  {
    "idx": 3719,
    "start": "01:40:43,140",
    "end": "01:40:43,940",
    "start_sec": 6043.14,
    "end_sec": 6043.94,
    "zh": "你小子",
    "vi": "Cậu nhóc này."
  },
  {
    "idx": 3720,
    "start": "01:40:43,940",
    "end": "01:40:45,160",
    "start_sec": 6043.94,
    "end_sec": 6045.16,
    "zh": "带这么多狗干嘛",
    "vi": "Dẫn theo nhiều chó như vậy làm gì."
  },
  {
    "idx": 3721,
    "start": "01:40:45,160",
    "end": "01:40:47,140",
    "start_sec": 6045.16,
    "end_sec": 6047.14,
    "zh": "难不成你还有点受屁",
    "vi": "Chẳng lẽ bạn lại có sở thích kỳ quặc đó."
  },
  {
    "idx": 3722,
    "start": "01:40:47,140",
    "end": "01:40:49,260",
    "start_sec": 6047.14,
    "end_sec": 6049.26,
    "zh": "别说那么恶心",
    "vi": "Đừng nói những lời ghê tởm như vậy."
  },
  {
    "idx": 3723,
    "start": "01:40:49,260",
    "end": "01:40:50,500",
    "start_sec": 6049.26,
    "end_sec": 6050.5,
    "zh": "飞狗可以避血",
    "vi": "Phi Cẩu có thể tránh được máu."
  },
  {
    "idx": 3724,
    "start": "01:40:50,500",
    "end": "01:40:51,100",
    "start_sec": 6050.5,
    "end_sec": 6051.1,
    "zh": "真的",
    "vi": "Thật sao."
  },
  {
    "idx": 3725,
    "start": "01:40:51,100",
    "end": "01:40:51,840",
    "start_sec": 6051.1,
    "end_sec": 6051.84,
    "zh": "真的",
    "vi": "Thật đấy."
  },
  {
    "idx": 3726,
    "start": "01:40:51,840",
    "end": "01:40:54,200",
    "start_sec": 6051.84,
    "end_sec": 6054.2,
    "zh": "随后一行人向永德司出发",
    "vi": "Sau đó cả nhóm khởi hành đến Vĩnh Đức Tự."
  },
  {
    "idx": 3727,
    "start": "01:40:54,200",
    "end": "01:40:57,640",
    "start_sec": 6054.2,
    "end_sec": 6057.64,
    "zh": "橙子皮看着车窗外熟悉的铁剑",
    "vi": "Tranh Tử Bì nhìn ra ngoài cửa sổ xe thấy những thanh sắt quen thuộc."
  },
  {
    "idx": 3728,
    "start": "01:40:57,640",
    "end": "01:40:58,640",
    "start_sec": 6057.64,
    "end_sec": 6058.64,
    "zh": "在快速倒退",
    "vi": "Đang lùi lại phía sau rất nhanh."
  },
  {
    "idx": 3729,
    "start": "01:40:58,640",
    "end": "01:40:59,520",
    "start_sec": 6058.64,
    "end_sec": 6059.52,
    "zh": "问林三七",
    "vi": "Cô hỏi Lâm Tam Thất."
  },
  {
    "idx": 3730,
    "start": "01:40:59,520",
    "end": "01:41:01,560",
    "start_sec": 6059.52,
    "end_sec": 6061.56,
    "zh": "永德四外的诡异你能对付吗",
    "vi": "Bạn có đối phó được những thứ quỷ dị bên ngoài Vĩnh Đức Tự không."
  },
  {
    "idx": 3731,
    "start": "01:41:01,560",
    "end": "01:41:04,480",
    "start_sec": 6061.56,
    "end_sec": 6064.48,
    "zh": "037以为橙子皮在质疑他的能力",
    "vi": "037 tưởng rằng Tranh Tử Bì đang nghi ngờ năng lực của mình."
  },
  {
    "idx": 3732,
    "start": "01:41:04,480",
    "end": "01:41:07,380",
    "start_sec": 6064.48,
    "end_sec": 6067.38,
    "zh": "不会都是一些刚形成或者在进化的诡异",
    "vi": "Đó chẳng qua chỉ là những thứ quỷ dị mới hình thành hoặc đang tiến hóa."
  },
  {
    "idx": 3733,
    "start": "01:41:07,380",
    "end": "01:41:08,580",
    "start_sec": 6067.38,
    "end_sec": 6068.58,
    "zh": "有什么不能对付的",
    "vi": "Có gì mà không đối phó được chứ."
  },
  {
    "idx": 3734,
    "start": "01:41:08,580",
    "end": "01:41:11,140",
    "start_sec": 6068.58,
    "end_sec": 6071.14,
    "zh": "就算完成进化又不是说对付不了",
    "vi": "Dù chúng có hoàn thành tiến hóa thì cũng không phải là không thể đối phó."
  },
  {
    "idx": 3735,
    "start": "01:41:11,140",
    "end": "01:41:13,040",
    "start_sec": 6071.14,
    "end_sec": 6073.04,
    "zh": "037却脸橙子皮",
    "vi": "037 quay sang nhìn Tranh Tử Bì."
  },
  {
    "idx": 3736,
    "start": "01:41:13,040",
    "end": "01:41:14,080",
    "start_sec": 6073.04,
    "end_sec": 6074.08,
    "zh": "怎么你怕了",
    "vi": "Sao nào, bạn sợ rồi à."
  },
  {
    "idx": 3737,
    "start": "01:41:14,080",
    "end": "01:41:15,260",
    "start_sec": 6074.08,
    "end_sec": 6075.26,
    "zh": "他的自信能量",
    "vi": "Sự tự tin của anh ấy."
  },
  {
    "idx": 3738,
    "start": "01:41:15,260",
    "end": "01:41:16,540",
    "start_sec": 6075.26,
    "end_sec": 6076.54,
    "zh": "橙子皮还在生化",
    "vi": "Tranh Tử Bì vẫn đang suy nghĩ."
  },
  {
    "idx": 3739,
    "start": "01:41:16,540",
    "end": "01:41:18,560",
    "start_sec": 6076.54,
    "end_sec": 6078.56,
    "zh": "车辆仍在快速前行",
    "vi": "Chiếc xe vẫn đang lao nhanh về phía trước."
  },
  {
    "idx": 3740,
    "start": "01:41:18,560",
    "end": "01:41:20,980",
    "start_sec": 6078.56,
    "end_sec": 6080.98,
    "zh": "037再次注射了一支高速机",
    "vi": "037 lại tiêm thêm một liều thuốc tăng tốc."
  },
  {
    "idx": 3741,
    "start": "01:41:20,980",
    "end": "01:41:23,120",
    "start_sec": 6080.98,
    "end_sec": 6083.12,
    "zh": "摸了摸后解决难难就一道",
    "vi": "Anh sờ vào gáy rồi thở dài một tiếng."
  },
  {
    "idx": 3742,
    "start": "01:41:23,120",
    "end": "01:41:25,220",
    "start_sec": 6083.12,
    "end_sec": 6085.22,
    "zh": "看来延缓就是延缓",
    "vi": "Xem ra trì hoãn thì vẫn chỉ là trì hoãn."
  },
  {
    "idx": 3743,
    "start": "01:41:25,220",
    "end": "01:41:27,220",
    "start_sec": 6085.22,
    "end_sec": 6087.22,
    "zh": "无法从根本遏制诡异的不足",
    "vi": "Không thể ngăn chặn tận gốc sự quỷ dị đang trỗi dậy."
  },
  {
    "idx": 3744,
    "start": "01:41:27,220",
    "end": "01:41:27,980",
    "start_sec": 6087.22,
    "end_sec": 6087.98,
    "zh": "也不知道",
    "vi": "Cũng không biết."
  },
  {
    "idx": 3745,
    "start": "01:41:27,980",
    "end": "01:41:29,660",
    "start_sec": 6087.98,
    "end_sec": 6089.66,
    "zh": "上头说的能压制体内",
    "vi": "Phương pháp mà cấp trên nói có thể áp chế."
  },
  {
    "idx": 3746,
    "start": "01:41:29,660",
    "end": "01:41:30,840",
    "start_sec": 6089.66,
    "end_sec": 6090.84,
    "zh": "诡异复苏的方法",
    "vi": "Sự trỗi dậy của quỷ dị trong cơ thể."
  },
  {
    "idx": 3747,
    "start": "01:41:30,840",
    "end": "01:41:31,880",
    "start_sec": 6090.84,
    "end_sec": 6091.88,
    "zh": "有没有实行",
    "vi": "Đã được thực hiện hay chưa."
  },
  {
    "idx": 3748,
    "start": "01:41:31,880",
    "end": "01:41:34,760",
    "start_sec": 6091.88,
    "end_sec": 6094.76,
    "zh": "远方永德寺的门户渐渐浮现",
    "vi": "Cổng vào Vĩnh Đức Tự ở phía xa dần dần hiện ra."
  },
  {
    "idx": 3749,
    "start": "01:41:34,760",
    "end": "01:41:37,100",
    "start_sec": 6094.76,
    "end_sec": 6097.1,
    "zh": "路道两旁又多出不少车祸车辆",
    "vi": "Hai bên đường lại xuất hiện thêm nhiều xe gặp tai nạn."
  },
  {
    "idx": 3750,
    "start": "01:41:37,100",
    "end": "01:41:37,740",
    "start_sec": 6097.1,
    "end_sec": 6097.74,
    "zh": "这一次",
    "vi": "Lần này."
  },
  {
    "idx": 3751,
    "start": "01:41:37,740",
    "end": "01:41:39,020",
    "start_sec": 6097.74,
    "end_sec": 6099.02,
    "zh": "橙子皮仔细看了",
    "vi": "Trần Tử Bì quan sát kỹ"
  },
  {
    "idx": 3752,
    "start": "01:41:39,020",
    "end": "01:41:40,840",
    "start_sec": 6099.02,
    "end_sec": 6100.84,
    "zh": "几乎每辆车内的长客身体",
    "vi": "Hầu như cơ thể của các hành khách trong mỗi chiếc xe"
  },
  {
    "idx": 3753,
    "start": "01:41:40,840",
    "end": "01:41:42,680",
    "start_sec": 6100.84,
    "end_sec": 6102.68,
    "zh": "都有不同长度的扭曲变形",
    "vi": "đều bị vặn vẹo biến dạng ở những mức độ khác nhau"
  },
  {
    "idx": 3754,
    "start": "01:41:42,680",
    "end": "01:41:43,580",
    "start_sec": 6102.68,
    "end_sec": 6103.58,
    "zh": "不对劲",
    "vi": "Không ổn rồi"
  },
  {
    "idx": 3755,
    "start": "01:41:43,580",
    "end": "01:41:44,240",
    "start_sec": 6103.58,
    "end_sec": 6104.24,
    "zh": "加速",
    "vi": "Tăng tốc đi"
  },
  {
    "idx": 3756,
    "start": "01:41:44,240",
    "end": "01:41:45,580",
    "start_sec": 6104.24,
    "end_sec": 6105.58,
    "zh": "车子给我加速",
    "vi": "Mau tăng tốc xe lên cho tôi"
  },
  {
    "idx": 3757,
    "start": "01:41:45,580",
    "end": "01:41:47,800",
    "start_sec": 6105.58,
    "end_sec": 6107.8,
    "zh": "以最快速度朝着永德寺开",
    "vi": "Lái với tốc độ nhanh nhất về phía chùa Vĩnh Đức"
  },
  {
    "idx": 3758,
    "start": "01:41:47,800",
    "end": "01:41:48,460",
    "start_sec": 6107.8,
    "end_sec": 6108.46,
    "zh": "突然",
    "vi": "Đột nhiên"
  },
  {
    "idx": 3759,
    "start": "01:41:48,460",
    "end": "01:41:49,660",
    "start_sec": 6108.46,
    "end_sec": 6109.66,
    "zh": "零三七大喊着",
    "vi": "Không Ba Bảy hét lớn"
  },
  {
    "idx": 3760,
    "start": "01:41:49,660",
    "end": "01:41:50,700",
    "start_sec": 6109.66,
    "end_sec": 6110.7,
    "zh": "他眉头醒醒了",
    "vi": "Chân mày anh ta nhíu chặt lại"
  },
  {
    "idx": 3761,
    "start": "01:41:50,700",
    "end": "01:41:51,600",
    "start_sec": 6110.7,
    "end_sec": 6111.6,
    "zh": "口罩开始冰冰",
    "vi": "Khẩu trang bắt đầu lạnh ngắt"
  },
  {
    "idx": 3762,
    "start": "01:41:51,600",
    "end": "01:41:54,900",
    "start_sec": 6111.6,
    "end_sec": 6114.9,
    "zh": "怎么没人汇报",
    "vi": "Sao không có ai báo cáo vậy"
  },
  {
    "idx": 3763,
    "start": "01:41:54,900",
    "end": "01:41:56,720",
    "start_sec": 6114.9,
    "end_sec": 6116.72,
    "zh": "这里有一只这么厉害的鬼",
    "vi": "Ở đây có một con quỷ đáng sợ như thế này"
  },
  {
    "idx": 3764,
    "start": "01:41:56,720",
    "end": "01:41:57,860",
    "start_sec": 6116.72,
    "end_sec": 6117.86,
    "zh": "闻言",
    "vi": "Nghe vậy"
  },
  {
    "idx": 3765,
    "start": "01:41:57,860",
    "end": "01:41:59,140",
    "start_sec": 6117.86,
    "end_sec": 6119.14,
    "zh": "橙子皮吸力一紧",
    "vi": "tim Trần Tử Bì thắt lại"
  },
  {
    "idx": 3766,
    "start": "01:41:59,140",
    "end": "01:41:59,960",
    "start_sec": 6119.14,
    "end_sec": 6119.96,
    "zh": "妈的",
    "vi": "Mẹ kiếp"
  },
  {
    "idx": 3767,
    "start": "01:41:59,960",
    "end": "01:42:00,560",
    "start_sec": 6119.96,
    "end_sec": 6120.56,
    "zh": "看样子",
    "vi": "Xem ra"
  },
  {
    "idx": 3768,
    "start": "01:42:00,560",
    "end": "01:42:01,640",
    "start_sec": 6120.56,
    "end_sec": 6121.64,
    "zh": "037还不知道",
    "vi": "Không Ba Bảy vẫn chưa biết"
  },
  {
    "idx": 3769,
    "start": "01:42:01,640",
    "end": "01:42:02,700",
    "start_sec": 6121.64,
    "end_sec": 6122.7,
    "zh": "这里有无形诡异",
    "vi": "ở đây có sự kỳ dị vô hình"
  },
  {
    "idx": 3770,
    "start": "01:42:02,700",
    "end": "01:42:04,380",
    "start_sec": 6122.7,
    "end_sec": 6124.38,
    "zh": "刚才还一副无数危惧的样子",
    "vi": "Vừa nãy còn tỏ ra không hề sợ hãi"
  },
  {
    "idx": 3771,
    "start": "01:42:04,380",
    "end": "01:42:06,220",
    "start_sec": 6124.38,
    "end_sec": 6126.22,
    "zh": "橙子皮下意识里",
    "vi": "Theo bản năng Trần Tử Bì"
  },
  {
    "idx": 3772,
    "start": "01:42:06,220",
    "end": "01:42:07,860",
    "start_sec": 6126.22,
    "end_sec": 6127.86,
    "zh": "伸手摸向怀中的香炉",
    "vi": "đưa tay sờ vào lư hương trong ngực"
  },
  {
    "idx": 3773,
    "start": "01:42:07,860",
    "end": "01:42:08,920",
    "start_sec": 6127.86,
    "end_sec": 6128.92,
    "zh": "037",
    "vi": "Không Ba Bảy"
  },
  {
    "idx": 3774,
    "start": "01:42:08,920",
    "end": "01:42:10,320",
    "start_sec": 6128.92,
    "end_sec": 6130.32,
    "zh": "发生什么了",
    "vi": "Có chuyện gì xảy ra thế"
  },
  {
    "idx": 3775,
    "start": "01:42:10,320",
    "end": "01:42:12,960",
    "start_sec": 6130.32,
    "end_sec": 6132.96,
    "zh": "主驾驶的男子刚想气热",
    "vi": "Người đàn ông ở ghế lái vừa định lên tiếng"
  },
  {
    "idx": 3776,
    "start": "01:42:12,960",
    "end": "01:42:15,520",
    "start_sec": 6132.96,
    "end_sec": 6135.52,
    "zh": "脚踝会踩在咔咔咔的腿下",
    "vi": "thì cổ chân phát ra những tiếng rắc rắc"
  },
  {
    "idx": 3777,
    "start": "01:42:15,520",
    "end": "01:42:15,840",
    "start_sec": 6135.52,
    "end_sec": 6135.84,
    "zh": "脚",
    "vi": "Chân"
  },
  {
    "idx": 3778,
    "start": "01:42:15,840",
    "end": "01:42:16,560",
    "start_sec": 6135.84,
    "end_sec": 6136.56,
    "zh": "我的脚",
    "vi": "chân của tôi"
  },
  {
    "idx": 3779,
    "start": "01:42:16,560",
    "end": "01:42:17,320",
    "start_sec": 6136.56,
    "end_sec": 6137.32,
    "zh": "随即",
    "vi": "Ngay sau đó"
  },
  {
    "idx": 3780,
    "start": "01:42:17,320",
    "end": "01:42:19,200",
    "start_sec": 6137.32,
    "end_sec": 6139.2,
    "zh": "车子也猛烈晃动起来",
    "vi": "chiếc xe cũng rung lắc dữ dội"
  },
  {
    "idx": 3781,
    "start": "01:42:19,200",
    "end": "01:42:19,560",
    "start_sec": 6139.2,
    "end_sec": 6139.56,
    "zh": "震度",
    "vi": "Rung chấn"
  },
  {
    "idx": 3782,
    "start": "01:42:19,560",
    "end": "01:42:20,420",
    "start_sec": 6139.56,
    "end_sec": 6140.42,
    "zh": "短持震度",
    "vi": "Cơn rung chấn ngắn"
  },
  {
    "idx": 3783,
    "start": "01:42:20,420",
    "end": "01:42:21,900",
    "start_sec": 6140.42,
    "end_sec": 6141.9,
    "zh": "小子",
    "vi": "Này nhóc"
  },
  {
    "idx": 3784,
    "start": "01:42:21,900",
    "end": "01:42:23,840",
    "start_sec": 6141.9,
    "end_sec": 6143.84,
    "zh": "你说黑狗可以压制邪祟是吧",
    "vi": "Bạn nói chó đen có thể trấn áp tà ma đúng không."
  },
  {
    "idx": 3785,
    "start": "01:42:23,840",
    "end": "01:42:24,760",
    "start_sec": 6143.84,
    "end_sec": 6144.76,
    "zh": "037",
    "vi": "Tam Thất"
  },
  {
    "idx": 3786,
    "start": "01:42:24,760",
    "end": "01:42:26,920",
    "start_sec": 6144.76,
    "end_sec": 6146.92,
    "zh": "低头看向蜷缩在脚边的胡子",
    "vi": "cúi đầu nhìn Hồ Tử đang cuộn tròn dưới chân"
  },
  {
    "idx": 3787,
    "start": "01:42:26,920",
    "end": "01:42:30,160",
    "start_sec": 6146.92,
    "end_sec": 6150.16,
    "zh": "是 是的 可以",
    "vi": "Đúng, đúng vậy, được chứ"
  },
  {
    "idx": 3788,
    "start": "01:42:30,160",
    "end": "01:42:33,320",
    "start_sec": 6150.16,
    "end_sec": 6153.32,
    "zh": "橙子皮大致猜到了林三七想要做什么了",
    "vi": "Trần Tử Bì lờ mờ đoán được Lâm Tam Thất muốn làm gì"
  },
  {
    "idx": 3789,
    "start": "01:42:33,320",
    "end": "01:42:35,020",
    "start_sec": 6153.32,
    "end_sec": 6155.02,
    "zh": "低头把小磨叽拢在怀里",
    "vi": "cúi đầu ôm chặt Tiểu Mạt vào lòng"
  },
  {
    "idx": 3790,
    "start": "01:42:35,020",
    "end": "01:42:40,000",
    "start_sec": 6155.02,
    "end_sec": 6160.0,
    "zh": "下一个林三七任如不长发化雷星星一样",
    "vi": "Giây tiếp theo, Lâm Tam Thất ra tay nhanh như chớp"
  },
  {
    "idx": 3791,
    "start": "01:42:40,000",
    "end": "01:42:42,800",
    "start_sec": 6160.0,
    "end_sec": 6162.8,
    "zh": "把胡子刺上了蜂窝门",
    "vi": "ném Hồ Tử vào cánh cửa tổ ong"
  },
  {
    "idx": 3792,
    "start": "01:42:42,800",
    "end": "01:42:45,460",
    "start_sec": 6162.8,
    "end_sec": 6165.46,
    "zh": "一瞬间黑狗却把整个车厢建了",
    "vi": "Trong nháy mắt, máu chó đen bắn tung tóe khắp toa xe"
  },
  {
    "idx": 3793,
    "start": "01:42:45,460",
    "end": "01:42:46,920",
    "start_sec": 6165.46,
    "end_sec": 6166.92,
    "zh": "脚 我的脚",
    "vi": "Chân, chân của tôi"
  },
  {
    "idx": 3794,
    "start": "01:42:46,920",
    "end": "01:42:49,020",
    "start_sec": 6166.92,
    "end_sec": 6169.02,
    "zh": "脚下又可以动了",
    "vi": "dưới chân lại có thể cử động rồi"
  },
  {
    "idx": 3795,
    "start": "01:42:49,020",
    "end": "01:42:50,280",
    "start_sec": 6169.02,
    "end_sec": 6170.28,
    "zh": "司机联合一下",
    "vi": "Tài xế lập tức phối hợp"
  },
  {
    "idx": 3796,
    "start": "01:42:50,280",
    "end": "01:42:52,180",
    "start_sec": 6170.28,
    "end_sec": 6172.18,
    "zh": "急速 把蜢的肺抄",
    "vi": "tăng tốc hết cỡ"
  },
  {
    "idx": 3797,
    "start": "01:42:52,180",
    "end": "01:42:53,820",
    "start_sec": 6172.18,
    "end_sec": 6173.82,
    "zh": "车子速度老了一些",
    "vi": "tốc độ xe nhanh hơn một chút"
  },
  {
    "idx": 3798,
    "start": "01:42:53,820",
    "end": "01:42:56,060",
    "start_sec": 6173.82,
    "end_sec": 6176.06,
    "zh": "两看永德寺紧紧相差百米",
    "vi": "nhìn lại thì chỉ còn cách chùa Vĩnh Đức trăm mét"
  },
  {
    "idx": 3799,
    "start": "01:42:56,060",
    "end": "01:42:59,820",
    "start_sec": 6176.06,
    "end_sec": 6179.82,
    "zh": "我操",
    "vi": "Chết tiệt"
  },
  {
    "idx": 3800,
    "start": "01:42:59,820",
    "end": "01:43:00,700",
    "start_sec": 6179.82,
    "end_sec": 6180.7,
    "zh": "永德寺外的",
    "vi": "Thứ ở bên ngoài chùa Vĩnh Đức"
  },
  {
    "idx": 3801,
    "start": "01:43:00,700",
    "end": "01:43:01,660",
    "start_sec": 6180.7,
    "end_sec": 6181.66,
    "zh": "到底是什么诡异",
    "vi": "rốt cuộc là thứ quỷ quái gì"
  },
  {
    "idx": 3802,
    "start": "01:43:01,660",
    "end": "01:43:03,640",
    "start_sec": 6181.66,
    "end_sec": 6183.64,
    "zh": "连明三七都没有反抗的余地",
    "vi": "đến cả Lâm Tam Thất cũng không có sức kháng cự"
  },
  {
    "idx": 3803,
    "start": "01:43:03,640",
    "end": "01:43:04,880",
    "start_sec": 6183.64,
    "end_sec": 6184.88,
    "zh": "长子皮知道",
    "vi": "Trần Tử Bì biết"
  },
  {
    "idx": 3804,
    "start": "01:43:04,880",
    "end": "01:43:06,940",
    "start_sec": 6184.88,
    "end_sec": 6186.94,
    "zh": "这次恐怕又要凶多吉少了",
    "vi": "lần này e rằng lành ít dữ nhiều rồi"
  },
  {
    "idx": 3805,
    "start": "01:43:06,940",
    "end": "01:43:08,040",
    "start_sec": 6186.94,
    "end_sec": 6188.04,
    "zh": "他连忙掏出手机",
    "vi": "cậu ấy vội vàng rút điện thoại ra"
  },
  {
    "idx": 3806,
    "start": "01:43:08,040",
    "end": "01:43:09,480",
    "start_sec": 6188.04,
    "end_sec": 6189.48,
    "zh": "过去的我",
    "vi": "Tôi của quá khứ"
  },
  {
    "idx": 3807,
    "start": "01:43:09,480",
    "end": "01:43:11,060",
    "start_sec": 6189.48,
    "end_sec": 6191.06,
    "zh": "我现在又遇到了要命的情况",
    "vi": "bây giờ tôi lại gặp phải tình huống nguy hiểm đến tính mạng"
  },
  {
    "idx": 3808,
    "start": "01:43:11,060",
    "end": "01:43:11,960",
    "start_sec": 6191.06,
    "end_sec": 6191.96,
    "zh": "我有一个假设",
    "vi": "tôi có một giả thuyết"
  },
  {
    "idx": 3809,
    "start": "01:43:11,960",
    "end": "01:43:13,200",
    "start_sec": 6191.96,
    "end_sec": 6193.2,
    "zh": "我死后会化为灵魂",
    "vi": "sau khi tôi chết sẽ hóa thành linh hồn"
  },
  {
    "idx": 3810,
    "start": "01:43:13,200",
    "end": "01:43:14,560",
    "start_sec": 6193.2,
    "end_sec": 6194.56,
    "zh": "你的肉身会立刻来到",
    "vi": "thể xác của bạn sẽ lập tức đến đây"
  },
  {
    "idx": 3811,
    "start": "01:43:14,560",
    "end": "01:43:16,040",
    "start_sec": 6194.56,
    "end_sec": 6196.04,
    "zh": "我死前的任何一个时间节点",
    "vi": "Bất kỳ thời điểm nào trước khi tôi chết"
  },
  {
    "idx": 3812,
    "start": "01:43:16,040",
    "end": "01:43:17,360",
    "start_sec": 6196.04,
    "end_sec": 6197.36,
    "zh": "不会混穿到你身上",
    "vi": "cũng không thể nhập hồn vào người cậu."
  },
  {
    "idx": 3813,
    "start": "01:43:17,360",
    "end": "01:43:18,260",
    "start_sec": 6197.36,
    "end_sec": 6198.26,
    "zh": "如果假设成立",
    "vi": "Nếu giả thuyết này đúng"
  },
  {
    "idx": 3814,
    "start": "01:43:18,260",
    "end": "01:43:18,1000",
    "start_sec": 6198.26,
    "end_sec": 6199.0,
    "zh": "那就说明",
    "vi": "thì điều đó chứng tỏ"
  },
  {
    "idx": 3815,
    "start": "01:43:18,1000",
    "end": "01:43:20,300",
    "start_sec": 6199.0,
    "end_sec": 6200.3,
    "zh": "我可以通过你无心不服",
    "vi": "我可以通过你无心不服"
  },
  {
    "idx": 3816,
    "start": "01:43:20,300",
    "end": "01:43:21,540",
    "start_sec": 6200.3,
    "end_sec": 6201.54,
    "zh": "如果假设不成立",
    "vi": "Nếu giả thuyết không đúng"
  },
  {
    "idx": 3817,
    "start": "01:43:21,540",
    "end": "01:43:22,560",
    "start_sec": 6201.54,
    "end_sec": 6202.56,
    "zh": "那我就真的死了",
    "vi": "thì tôi sẽ thực sự chết."
  },
  {
    "idx": 3818,
    "start": "01:43:22,560",
    "end": "01:43:23,040",
    "start_sec": 6202.56,
    "end_sec": 6203.04,
    "zh": "记住",
    "vi": "Hãy nhớ kỹ"
  },
  {
    "idx": 3819,
    "start": "01:43:23,040",
    "end": "01:43:24,180",
    "start_sec": 6203.04,
    "end_sec": 6204.18,
    "zh": "鬼一降临的第四天",
    "vi": "ngày thứ tư sau khi ác quỷ giáng lâm"
  },
  {
    "idx": 3820,
    "start": "01:43:24,180",
    "end": "01:43:26,300",
    "start_sec": 6204.18,
    "end_sec": 6206.3,
    "zh": "千万不要和林三七一起去拥着伺",
    "vi": "tuyệt đối đừng đi cùng Lâm Tam Thất đến Ung Trạch Tự."
  },
  {
    "idx": 3821,
    "start": "01:43:26,300",
    "end": "01:43:29,060",
    "start_sec": 6206.3,
    "end_sec": 6209.06,
    "zh": "我说你小子什么脑霉路都要死了",
    "vi": "Tôi nói này, đầu óc cậu bị gì thế, sắp chết đến nơi rồi"
  },
  {
    "idx": 3822,
    "start": "01:43:29,060",
    "end": "01:43:30,140",
    "start_sec": 6209.06,
    "end_sec": 6210.14,
    "zh": "还他妈玩手机",
    "vi": "mà vẫn còn chơi điện thoại."
  },
  {
    "idx": 3823,
    "start": "01:43:30,140",
    "end": "01:43:31,000",
    "start_sec": 6210.14,
    "end_sec": 6211.0,
    "zh": "他妈的",
    "vi": "Mẹ kiếp"
  },
  {
    "idx": 3824,
    "start": "01:43:31,000",
    "end": "01:43:31,940",
    "start_sec": 6211.0,
    "end_sec": 6211.94,
    "zh": "这门怎么打不开",
    "vi": "sao cái cửa này không mở được thế."
  },
  {
    "idx": 3825,
    "start": "01:43:31,940",
    "end": "01:43:38,060",
    "start_sec": 6211.94,
    "end_sec": 6218.06,
    "zh": "不想吵话了",
    "vi": "Không muốn nói nhảm nữa"
  },
  {
    "idx": 3826,
    "start": "01:43:38,060",
    "end": "01:43:38,980",
    "start_sec": 6218.06,
    "end_sec": 6218.98,
    "zh": "赶紧爬起来",
    "vi": "mau bò dậy đi."
  },
  {
    "idx": 3827,
    "start": "01:43:38,980",
    "end": "01:43:39,980",
    "start_sec": 6218.98,
    "end_sec": 6219.98,
    "zh": "把你的狗给我",
    "vi": "Đưa con chó của cậu cho tôi."
  },
  {
    "idx": 3828,
    "start": "01:43:39,980",
    "end": "01:43:41,960",
    "start_sec": 6219.98,
    "end_sec": 6221.96,
    "zh": "没等长者一反一管",
    "vi": "Chưa đợi Trương Triết kịp phản ứng"
  },
  {
    "idx": 3829,
    "start": "01:43:41,960",
    "end": "01:43:44,220",
    "start_sec": 6221.96,
    "end_sec": 6224.22,
    "zh": "小莫及时已经被死了千双白狗",
    "vi": "Tiểu Mạc đã đâm chết con chó"
  },
  {
    "idx": 3830,
    "start": "01:43:44,220",
    "end": "01:43:45,040",
    "start_sec": 6224.22,
    "end_sec": 6225.04,
    "zh": "鲜血不见",
    "vi": "máu tươi bắn tung tóe."
  },
  {
    "idx": 3831,
    "start": "01:43:45,040",
    "end": "01:43:46,060",
    "start_sec": 6225.04,
    "end_sec": 6226.06,
    "zh": "顶着干嘛",
    "vi": "Đứng đực ra đó làm gì."
  },
  {
    "idx": 3832,
    "start": "01:43:46,060",
    "end": "01:43:46,900",
    "start_sec": 6226.06,
    "end_sec": 6226.9,
    "zh": "好啊",
    "vi": "Được rồi."
  },
  {
    "idx": 3833,
    "start": "01:43:46,900",
    "end": "01:43:48,620",
    "start_sec": 6226.9,
    "end_sec": 6228.62,
    "zh": "这黑狗且抵挡不了多久",
    "vi": "Con chó đen này không chống đỡ được lâu đâu."
  },
  {
    "idx": 3834,
    "start": "01:43:53,040",
    "end": "01:43:55,180",
    "start_sec": 6233.04,
    "end_sec": 6235.18,
    "zh": "037救救救我",
    "vi": "Lâm Tam Thất, cứu, cứu tôi với."
  },
  {
    "idx": 3835,
    "start": "01:43:55,180",
    "end": "01:43:57,500",
    "start_sec": 6235.18,
    "end_sec": 6237.5,
    "zh": "妈的废物",
    "vi": "Mẹ kiếp, đúng là đồ vô dụng."
  },
  {
    "idx": 3836,
    "start": "01:43:57,500",
    "end": "01:43:58,260",
    "start_sec": 6237.5,
    "end_sec": 6238.26,
    "zh": "别挡路",
    "vi": "Đừng cản đường."
  },
  {
    "idx": 3837,
    "start": "01:43:58,260",
    "end": "01:44:00,780",
    "start_sec": 6238.26,
    "end_sec": 6240.78,
    "zh": "橙子皮从恐中走",
    "vi": "Trương Triết bước ra trong nỗi sợ hãi"
  },
  {
    "idx": 3838,
    "start": "01:44:00,780",
    "end": "01:44:02,380",
    "start_sec": 6240.78,
    "end_sec": 6242.38,
    "zh": "既然你连队友都不救",
    "vi": "Nếu ngay cả đồng đội cậu cũng không cứu"
  },
  {
    "idx": 3839,
    "start": "01:44:02,380",
    "end": "01:44:03,280",
    "start_sec": 6242.38,
    "end_sec": 6243.28,
    "zh": "又为什么救我",
    "vi": "thì tại sao lại cứu tôi."
  },
  {
    "idx": 3840,
    "start": "01:44:03,280",
    "end": "01:44:03,760",
    "start_sec": 6243.28,
    "end_sec": 6243.76,
    "zh": "救你",
    "vi": "Cứu cậu sao."
  },
  {
    "idx": 3841,
    "start": "01:44:03,760",
    "end": "01:44:05,200",
    "start_sec": 6243.76,
    "end_sec": 6245.2,
    "zh": "你难道觉得我很善良",
    "vi": "Chẳng lẽ ngươi nghĩ ta rất lương thiện."
  },
  {
    "idx": 3842,
    "start": "01:44:05,200",
    "end": "01:44:07,860",
    "start_sec": 6245.2,
    "end_sec": 6247.86,
    "zh": "037看着近战平时这个模式",
    "vi": "Linh Tam Thất nhìn Trương Tử Bì ở ngay trước mắt."
  },
  {
    "idx": 3843,
    "start": "01:44:07,860",
    "end": "01:44:08,680",
    "start_sec": 6247.86,
    "end_sec": 6248.68,
    "zh": "缓缓下来",
    "vi": "Từ từ hạ xuống."
  },
  {
    "idx": 3844,
    "start": "01:44:08,680",
    "end": "01:44:10,360",
    "start_sec": 6248.68,
    "end_sec": 6250.36,
    "zh": "这只鬼很聪明",
    "vi": "Con quỷ này rất thông minh."
  },
  {
    "idx": 3845,
    "start": "01:44:10,360",
    "end": "01:44:11,520",
    "start_sec": 6250.36,
    "end_sec": 6251.52,
    "zh": "优先杀司机",
    "vi": "Nó ưu tiên giết tài xế trước."
  },
  {
    "idx": 3846,
    "start": "01:44:11,520",
    "end": "01:44:13,640",
    "start_sec": 6251.52,
    "end_sec": 6253.64,
    "zh": "随后游跃到墙开始虐杀",
    "vi": "Sau đó nhảy lên tường và bắt đầu tàn sát."
  },
  {
    "idx": 3847,
    "start": "01:44:13,640",
    "end": "01:44:15,840",
    "start_sec": 6253.64,
    "end_sec": 6255.84,
    "zh": "可以断定他已经生出灵智",
    "vi": "Có thể khẳng định nó đã sinh ra linh trí."
  },
  {
    "idx": 3848,
    "start": "01:44:15,840",
    "end": "01:44:17,040",
    "start_sec": 6255.84,
    "end_sec": 6257.04,
    "zh": "比我要强很多",
    "vi": "Mạnh hơn ta rất nhiều."
  },
  {
    "idx": 3849,
    "start": "01:44:17,040",
    "end": "01:44:18,320",
    "start_sec": 6257.04,
    "end_sec": 6258.32,
    "zh": "而你能活到现在",
    "vi": "Còn ngươi có thể sống sót đến giờ."
  },
  {
    "idx": 3850,
    "start": "01:44:18,320",
    "end": "01:44:19,720",
    "start_sec": 6258.32,
    "end_sec": 6259.72,
    "zh": "全靠你身上的方法",
    "vi": "Hoàn toàn dựa vào bảo vật trên người ngươi."
  },
  {
    "idx": 3851,
    "start": "01:44:19,720",
    "end": "01:44:20,440",
    "start_sec": 6259.72,
    "end_sec": 6260.44,
    "zh": "对",
    "vi": "Đúng vậy."
  },
  {
    "idx": 3852,
    "start": "01:44:20,440",
    "end": "01:44:21,480",
    "start_sec": 6260.44,
    "end_sec": 6261.48,
    "zh": "那无形鬼力",
    "vi": "Luồng quỷ lực vô hình đó."
  },
  {
    "idx": 3853,
    "start": "01:44:21,480",
    "end": "01:44:22,940",
    "start_sec": 6261.48,
    "end_sec": 6262.94,
    "zh": "就能开始攻击零三七",
    "vi": "Đã bắt đầu tấn công Linh Tam Thất."
  },
  {
    "idx": 3854,
    "start": "01:44:22,940",
    "end": "01:44:24,720",
    "start_sec": 6262.94,
    "end_sec": 6264.72,
    "zh": "零三七的头发开始风涨",
    "vi": "Tóc của Linh Tam Thất bắt đầu dài ra điên cuồng."
  },
  {
    "idx": 3855,
    "start": "01:44:24,720",
    "end": "01:44:26,020",
    "start_sec": 6264.72,
    "end_sec": 6266.02,
    "zh": "身体也开始扭曲",
    "vi": "Cơ thể cũng bắt đầu vặn vẹo."
  },
  {
    "idx": 3856,
    "start": "01:44:26,020",
    "end": "01:44:26,880",
    "start_sec": 6266.02,
    "end_sec": 6266.88,
    "zh": "但她却在下",
    "vi": "Nhưng cô ta lại đang cười."
  },
  {
    "idx": 3857,
    "start": "01:44:26,880",
    "end": "01:44:28,120",
    "start_sec": 6266.88,
    "end_sec": 6268.12,
    "zh": "由你到现在",
    "vi": "Giữ ngươi lại đến giờ."
  },
  {
    "idx": 3858,
    "start": "01:44:28,120",
    "end": "01:44:29,420",
    "start_sec": 6268.12,
    "end_sec": 6269.42,
    "zh": "不过是分散目标",
    "vi": "Chẳng qua là để phân tán mục tiêu."
  },
  {
    "idx": 3859,
    "start": "01:44:29,420",
    "end": "01:44:31,080",
    "start_sec": 6269.42,
    "end_sec": 6271.08,
    "zh": "借助你身上宝贝的威压",
    "vi": "Nhờ vào uy áp từ bảo vật trên người ngươi."
  },
  {
    "idx": 3860,
    "start": "01:44:31,080",
    "end": "01:44:32,360",
    "start_sec": 6271.08,
    "end_sec": 6272.36,
    "zh": "越过这百米距离",
    "vi": "Vượt qua khoảng cách trăm mét này."
  },
  {
    "idx": 3861,
    "start": "01:44:32,360",
    "end": "01:44:33,280",
    "start_sec": 6272.36,
    "end_sec": 6273.28,
    "zh": "进入永泽寺",
    "vi": "Để đi vào chùa Vĩnh Trạch."
  },
  {
    "idx": 3862,
    "start": "01:44:33,280",
    "end": "01:44:34,300",
    "start_sec": 6273.28,
    "end_sec": 6274.3,
    "zh": "但现在看来",
    "vi": "Nhưng bây giờ xem ra."
  },
  {
    "idx": 3863,
    "start": "01:44:34,300",
    "end": "01:44:35,740",
    "start_sec": 6274.3,
    "end_sec": 6275.74,
    "zh": "你身上的宝贝等级",
    "vi": "Cấp bậc bảo vật trên người ngươi."
  },
  {
    "idx": 3864,
    "start": "01:44:35,740",
    "end": "01:44:36,740",
    "start_sec": 6275.74,
    "end_sec": 6276.74,
    "zh": "如果还要高",
    "vi": "Dường như còn cao hơn."
  },
  {
    "idx": 3865,
    "start": "01:44:36,740",
    "end": "01:44:37,960",
    "start_sec": 6276.74,
    "end_sec": 6277.96,
    "zh": "就没必要留你了",
    "vi": "Thì không cần thiết phải giữ ngươi lại nữa."
  },
  {
    "idx": 3866,
    "start": "01:44:37,960",
    "end": "01:44:38,280",
    "start_sec": 6277.96,
    "end_sec": 6278.28,
    "zh": "说真",
    "vi": "Nói xong."
  },
  {
    "idx": 3867,
    "start": "01:44:38,280",
    "end": "01:44:39,860",
    "start_sec": 6278.28,
    "end_sec": 6279.86,
    "zh": "零三七便要去抢我",
    "vi": "Linh Tam Thất liền lao đến cướp."
  },
  {
    "idx": 3868,
    "start": "01:44:39,860",
    "end": "01:44:41,100",
    "start_sec": 6279.86,
    "end_sec": 6281.1,
    "zh": "长子皮身上的香炉",
    "vi": "Lư hương trên người Trương Tử Bì."
  },
  {
    "idx": 3869,
    "start": "01:44:41,100",
    "end": "01:44:42,160",
    "start_sec": 6281.1,
    "end_sec": 6282.16,
    "zh": "这一刻",
    "vi": "Khoảnh khắc này."
  },
  {
    "idx": 3870,
    "start": "01:44:42,160",
    "end": "01:44:43,220",
    "start_sec": 6282.16,
    "end_sec": 6283.22,
    "zh": "长子皮才明白",
    "vi": "Trương Tử Bì mới hiểu ra."
  },
  {
    "idx": 3871,
    "start": "01:44:43,220",
    "end": "01:44:44,480",
    "start_sec": 6283.22,
    "end_sec": 6284.48,
    "zh": "零三七不过是一个",
    "vi": "Linh Tam Thất chẳng qua chỉ là một"
  },
  {
    "idx": 3872,
    "start": "01:44:44,480",
    "end": "01:44:45,620",
    "start_sec": 6284.48,
    "end_sec": 6285.62,
    "zh": "彻头彻尾的疯子",
    "vi": "kẻ điên cuồng triệt để."
  },
  {
    "idx": 3873,
    "start": "01:44:45,620",
    "end": "01:44:46,400",
    "start_sec": 6285.62,
    "end_sec": 6286.4,
    "zh": "她很想跑",
    "vi": "Cô ta rất muốn chạy trốn"
  },
  {
    "idx": 3874,
    "start": "01:44:46,400",
    "end": "01:44:47,700",
    "start_sec": 6286.4,
    "end_sec": 6287.7,
    "zh": "带一股无形的压力",
    "vi": "nhưng một áp lực vô hình"
  },
  {
    "idx": 3875,
    "start": "01:44:47,700",
    "end": "01:44:48,600",
    "start_sec": 6287.7,
    "end_sec": 6288.6,
    "zh": "让她动作不得",
    "vi": "khiến cô ta không thể cử động."
  },
  {
    "idx": 3876,
    "start": "01:44:48,600",
    "end": "01:44:49,780",
    "start_sec": 6288.6,
    "end_sec": 6289.78,
    "zh": "橙子皮冷着脸",
    "vi": "Trương Tử Bì lạnh mặt"
  },
  {
    "idx": 3877,
    "start": "01:44:49,780",
    "end": "01:44:51,060",
    "start_sec": 6289.78,
    "end_sec": 6291.06,
    "zh": "从怀里抛出香炉",
    "vi": "ném lư hương từ trong ngực ra"
  },
  {
    "idx": 3878,
    "start": "01:44:51,060",
    "end": "01:44:52,300",
    "start_sec": 6291.06,
    "end_sec": 6292.3,
    "zh": "使出浑身泄漱",
    "vi": "dùng hết toàn lực"
  },
  {
    "idx": 3879,
    "start": "01:44:52,300",
    "end": "01:44:53,220",
    "start_sec": 6292.3,
    "end_sec": 6293.22,
    "zh": "不远不离",
    "vi": "để ném ra xa."
  },
  {
    "idx": 3880,
    "start": "01:44:53,220",
    "end": "01:44:55,023",
    "start_sec": 6293.22,
    "end_sec": 6295.023,
    "zh": "去他妈吧都别慌失去香炉的遗憾无形诡异的压力和零三七的头发几乎从实到达,橙子皮捆索鲜化为血污。",
    "vi": "Mẹ kiếp, tất cả đừng hoảng loạn"
  },
  {
    "idx": 3880,
    "start": "01:44:55,023",
    "end": "01:44:59,401",
    "start_sec": 6295.023,
    "end_sec": 6299.401,
    "zh": "去他妈吧都别慌失去香炉的遗憾无形诡异的压力和零三七的头发几乎从实到达,橙子皮捆索鲜化为血污。",
    "vi": "Sự tiếc nuối khi mất lư hương, áp lực vô hình kỳ quái và tóc của Linh"
  },
  {
    "idx": 3880,
    "start": "01:44:59,401",
    "end": "01:45:04,037",
    "start_sec": 6299.401,
    "end_sec": 6304.037,
    "zh": "去他妈吧都别慌失去香炉的遗憾无形诡异的压力和零三七的头发几乎从实到达,橙子皮捆索鲜化为血污。",
    "vi": "Tam Thất gần như ập đến cùng lúc, khiến Trương Tử Bì lập tức biến thành vũng máu"
  },
  {
    "idx": 3881,
    "start": "01:45:08,177",
    "end": "01:45:12,617",
    "start_sec": 6308.177,
    "end_sec": 6312.617,
    "zh": "我没死,橙子皮浑身冷淡,一阵后发之后,是无尽的心态。",
    "vi": "Mình chưa chết. Trương Tử Bì toàn thân lạnh toát, sau một hồi bàng hoàng là sự phấn khích vô tận."
  },
  {
    "idx": 3882,
    "start": "01:45:12,997",
    "end": "01:45:17,237",
    "start_sec": 6312.997,
    "end_sec": 6317.237,
    "zh": "橙,我是假设没错,我可以无限复活,我是无限的。",
    "vi": "Giả thuyết của mình không sai, mình có thể hồi sinh vô hạn, mình là vô hạn."
  },
  {
    "idx": 3883,
    "start": "01:45:17,577",
    "end": "01:45:20,944",
    "start_sec": 6317.577,
    "end_sec": 6320.944,
    "zh": "惊喜了好一会儿,橙子皮才抬头打亮子周,发现自己重生在小区外面,正是与零三七见面之前。",
    "vi": "Vui mừng một hồi lâu, Trương Tử Bì mới ngẩng đầu quan sát xung quanh, phát hiện bản thân"
  },
  {
    "idx": 3883,
    "start": "01:45:20,944",
    "end": "01:45:23,957",
    "start_sec": 6320.944,
    "end_sec": 6323.957,
    "zh": "惊喜了好一会儿,橙子皮才抬头打亮子周,发现自己重生在小区外面,正是与零三七见面之前。",
    "vi": "đã hồi sinh ở bên ngoài khu chung cư, ngay trước thời điểm gặp Linh Tam Thất."
  },
  {
    "idx": 3884,
    "start": "01:45:23,957",
    "end": "01:45:24,997",
    "start_sec": 6323.957,
    "end_sec": 6324.997,
    "zh": "想到林三七",
    "vi": "Nghĩ đến Linh Tam Thất"
  },
  {
    "idx": 3885,
    "start": "01:45:24,997",
    "end": "01:45:26,617",
    "start_sec": 6324.997,
    "end_sec": 6326.617,
    "zh": "橙子皮脸色逐渐阴冷",
    "vi": "sắc mặt Trương Tử Bì dần trở nên âm trầm."
  },
  {
    "idx": 3886,
    "start": "01:45:26,617",
    "end": "01:45:27,557",
    "start_sec": 6326.617,
    "end_sec": 6327.557,
    "zh": "他早该想到",
    "vi": "Cô ta đáng lẽ phải nghĩ ra từ sớm"
  },
  {
    "idx": 3887,
    "start": "01:45:27,557",
    "end": "01:45:29,597",
    "start_sec": 6327.557,
    "end_sec": 6329.597,
    "zh": "林三七从始至终都在断线",
    "vi": "rằng Linh Tam Thất ngay từ đầu đã mất kết nối."
  },
  {
    "idx": 3888,
    "start": "01:45:29,597",
    "end": "01:45:31,197",
    "start_sec": 6329.597,
    "end_sec": 6331.197,
    "zh": "这是黑的商务车",
    "vi": "Lúc này, chiếc xe thương mại màu đen"
  },
  {
    "idx": 3889,
    "start": "01:45:31,197",
    "end": "01:45:31,797",
    "start_sec": 6331.197,
    "end_sec": 6331.797,
    "zh": "无情而至",
    "vi": "lạnh lùng lao tới."
  },
  {
    "idx": 3890,
    "start": "01:45:31,797",
    "end": "01:45:33,277",
    "start_sec": 6331.797,
    "end_sec": 6333.277,
    "zh": "你他妈就是橙子皮啊",
    "vi": "Mày chính là Trương Tử Bì phải không."
  },
  {
    "idx": 3891,
    "start": "01:45:33,277",
    "end": "01:45:33,897",
    "start_sec": 6333.277,
    "end_sec": 6333.897,
    "zh": "我就是",
    "vi": "Tao đấy."
  },
  {
    "idx": 3892,
    "start": "01:45:33,897",
    "end": "01:45:35,417",
    "start_sec": 6333.897,
    "end_sec": 6335.417,
    "zh": "你他妈嘴巴放干净点",
    "vi": "Mày ăn nói cho sạch sẽ một chút."
  },
  {
    "idx": 3893,
    "start": "01:45:35,417",
    "end": "01:45:38,597",
    "start_sec": 6335.417,
    "end_sec": 6338.597,
    "zh": "林三七被橙子皮",
    "vi": "Linh Tam Thất bị Trương Tử Bì"
  },
  {
    "idx": 3894,
    "start": "01:45:38,597",
    "end": "01:45:39,677",
    "start_sec": 6338.597,
    "end_sec": 6339.677,
    "zh": "突如其来的呵斥",
    "vi": "mắng mỏ đột ngột"
  },
  {
    "idx": 3895,
    "start": "01:45:39,677",
    "end": "01:45:40,657",
    "start_sec": 6339.677,
    "end_sec": 6340.657,
    "zh": "搞得有些猛逼",
    "vi": "khiến cho có chút ngơ ngác."
  },
  {
    "idx": 3896,
    "start": "01:45:40,657",
    "end": "01:45:41,197",
    "start_sec": 6340.657,
    "end_sec": 6341.197,
    "zh": "你",
    "vi": "Mày"
  },
  {
    "idx": 3897,
    "start": "01:45:41,197",
    "end": "01:45:42,277",
    "start_sec": 6341.197,
    "end_sec": 6342.277,
    "zh": "你什么你",
    "vi": "Mày cái gì mà mày."
  },
  {
    "idx": 3898,
    "start": "01:45:42,277",
    "end": "01:45:43,837",
    "start_sec": 6342.277,
    "end_sec": 6343.837,
    "zh": "想要高通宿是吧",
    "vi": "Muốn thông báo cao cấp phải không."
  },
  {
    "idx": 3899,
    "start": "01:45:43,837",
    "end": "01:45:44,417",
    "start_sec": 6343.837,
    "end_sec": 6344.417,
    "zh": "我",
    "vi": "Tao"
  },
  {
    "idx": 3900,
    "start": "01:45:44,417",
    "end": "01:45:45,677",
    "start_sec": 6344.417,
    "end_sec": 6345.677,
    "zh": "我什么我",
    "vi": "Tao cái gì mà tao."
  },
  {
    "idx": 3901,
    "start": "01:45:45,677",
    "end": "01:45:47,077",
    "start_sec": 6345.677,
    "end_sec": 6347.077,
    "zh": "要去永德斯是吧",
    "vi": "Đi đến Vĩnh Đức Tư phải không"
  },
  {
    "idx": 3902,
    "start": "01:45:47,077",
    "end": "01:45:47,637",
    "start_sec": 6347.077,
    "end_sec": 6347.637,
    "zh": "妈的",
    "vi": "Chết tiệt"
  },
  {
    "idx": 3903,
    "start": "01:45:47,637",
    "end": "01:45:48,577",
    "start_sec": 6347.637,
    "end_sec": 6348.577,
    "zh": "你想死吗",
    "vi": "Anh muốn chết à"
  },
  {
    "idx": 3904,
    "start": "01:45:48,577",
    "end": "01:45:50,097",
    "start_sec": 6348.577,
    "end_sec": 6350.097,
    "zh": "再杀老的一次",
    "vi": "Lần thứ hai giết tôi"
  },
  {
    "idx": 3905,
    "start": "01:45:50,097",
    "end": "01:45:51,217",
    "start_sec": 6350.097,
    "end_sec": 6351.217,
    "zh": "你拿不到高通宿",
    "vi": "Anh không thể lấy được Cao Đồng Túc"
  },
  {
    "idx": 3906,
    "start": "01:45:51,217",
    "end": "01:45:51,897",
    "start_sec": 6351.217,
    "end_sec": 6351.897,
    "zh": "都别活",
    "vi": "Không ai sống được"
  },
  {
    "idx": 3907,
    "start": "01:45:51,897",
    "end": "01:45:53,337",
    "start_sec": 6351.897,
    "end_sec": 6353.337,
    "zh": "林三七又猛逼了",
    "vi": "Lâm Tam Thất lại hung hăng rồi"
  },
  {
    "idx": 3908,
    "start": "01:45:53,337",
    "end": "01:45:54,837",
    "start_sec": 6353.337,
    "end_sec": 6354.837,
    "zh": "明明是第一次见面",
    "vi": "Rõ ràng là lần đầu gặp mặt"
  },
  {
    "idx": 3909,
    "start": "01:45:54,837",
    "end": "01:45:55,857",
    "start_sec": 6354.837,
    "end_sec": 6355.857,
    "zh": "他为什么要说起",
    "vi": "Sao anh ta lại nói vậy"
  },
  {
    "idx": 3910,
    "start": "01:45:55,857",
    "end": "01:45:57,437",
    "start_sec": 6355.857,
    "end_sec": 6357.437,
    "zh": "看037憋屈的模样",
    "vi": "Nhìn bộ dạng ấm ức của 037 kìa"
  },
  {
    "idx": 3911,
    "start": "01:45:57,437",
    "end": "01:45:58,677",
    "start_sec": 6357.437,
    "end_sec": 6358.677,
    "zh": "肠子皮屑里暗爽",
    "vi": "Thầm vui sướng trong lòng"
  },
  {
    "idx": 3912,
    "start": "01:45:58,677",
    "end": "01:46:00,417",
    "start_sec": 6358.677,
    "end_sec": 6360.417,
    "zh": "心头怒气终于消了一下",
    "vi": "Cơn giận trong lòng cuối cùng cũng nguôi ngoai"
  },
  {
    "idx": 3913,
    "start": "01:46:00,417",
    "end": "01:46:01,757",
    "start_sec": 6360.417,
    "end_sec": 6361.757,
    "zh": "我知道你为了找高同苏",
    "vi": "Tôi biết anh để tìm Cao Đồng Túc"
  },
  {
    "idx": 3914,
    "start": "01:46:01,757",
    "end": "01:46:03,237",
    "start_sec": 6361.757,
    "end_sec": 6363.237,
    "zh": "刚清理完一家医院的诡异",
    "vi": "Vừa mới xử lý xong một bệnh viện đầy quỷ dị"
  },
  {
    "idx": 3915,
    "start": "01:46:03,237",
    "end": "01:46:04,237",
    "start_sec": 6363.237,
    "end_sec": 6364.237,
    "zh": "现在还很虚弱",
    "vi": "Bây giờ còn rất yếu"
  },
  {
    "idx": 3916,
    "start": "01:46:04,237",
    "end": "01:46:05,877",
    "start_sec": 6364.237,
    "end_sec": 6365.877,
    "zh": "还知道你体内诡异复苏",
    "vi": "Còn biết trong cơ thể anh có quỷ dị đang trỗi dậy"
  },
  {
    "idx": 3917,
    "start": "01:46:05,877",
    "end": "01:46:06,797",
    "start_sec": 6365.877,
    "end_sec": 6366.797,
    "zh": "被高层抛弃",
    "vi": "Bị cấp trên bỏ rơi"
  },
  {
    "idx": 3918,
    "start": "01:46:06,797",
    "end": "01:46:08,057",
    "start_sec": 6366.797,
    "end_sec": 6368.057,
    "zh": "所以要去勇个四十个",
    "vi": "Nên mới đi Vĩnh Đức Tư"
  },
  {
    "idx": 3919,
    "start": "01:46:08,057",
    "end": "01:46:08,657",
    "start_sec": 6368.057,
    "end_sec": 6368.657,
    "zh": "不用吃力点",
    "vi": "Không cần cố sức đâu"
  },
  {
    "idx": 3920,
    "start": "01:46:08,657",
    "end": "01:46:09,377",
    "start_sec": 6368.657,
    "end_sec": 6369.377,
    "zh": "遇鬼者",
    "vi": "Người gặp quỷ"
  },
  {
    "idx": 3921,
    "start": "01:46:09,377",
    "end": "01:46:10,337",
    "start_sec": 6369.377,
    "end_sec": 6370.337,
    "zh": "南城河",
    "vi": "Nam Thành Hà"
  },
  {
    "idx": 3922,
    "start": "01:46:10,337",
    "end": "01:46:11,017",
    "start_sec": 6370.337,
    "end_sec": 6371.017,
    "zh": "油门",
    "vi": "Ga-xăng"
  },
  {
    "idx": 3923,
    "start": "01:46:11,017",
    "end": "01:46:12,857",
    "start_sec": 6371.017,
    "end_sec": 6372.857,
    "zh": "037越听越好地讲",
    "vi": "037 càng nghe càng thấy lạ"
  },
  {
    "idx": 3924,
    "start": "01:46:12,857",
    "end": "01:46:13,677",
    "start_sec": 6372.857,
    "end_sec": 6373.677,
    "zh": "037",
    "vi": "037"
  },
  {
    "idx": 3925,
    "start": "01:46:13,677",
    "end": "01:46:15,377",
    "start_sec": 6373.677,
    "end_sec": 6375.377,
    "zh": "这小子不简单啊",
    "vi": "Cậu ta không đơn giản đâu"
  },
  {
    "idx": 3926,
    "start": "01:46:15,377",
    "end": "01:46:17,817",
    "start_sec": 6375.377,
    "end_sec": 6377.817,
    "zh": "他会不会是某些高层的人",
    "vi": "Cậu ta có phải là người của cấp trên nào đó không"
  },
  {
    "idx": 3927,
    "start": "01:46:17,817",
    "end": "01:46:18,477",
    "start_sec": 6377.817,
    "end_sec": 6378.477,
    "zh": "确实",
    "vi": "Đúng vậy"
  },
  {
    "idx": 3928,
    "start": "01:46:18,477",
    "end": "01:46:20,157",
    "start_sec": 6378.477,
    "end_sec": 6380.157,
    "zh": "平头百姓不可能接触到",
    "vi": "Người dân thường không thể tiếp xúc"
  },
  {
    "idx": 3929,
    "start": "01:46:20,157",
    "end": "01:46:21,097",
    "start_sec": 6380.157,
    "end_sec": 6381.097,
    "zh": "这么多内部消息",
    "vi": "Với nhiều tin nội bộ như vậy"
  },
  {
    "idx": 3930,
    "start": "01:46:21,097",
    "end": "01:46:23,157",
    "start_sec": 6381.097,
    "end_sec": 6383.157,
    "zh": "037心里的杀意渐渐消解",
    "vi": "Sát ý trong lòng 037 dần tan biến"
  },
  {
    "idx": 3931,
    "start": "01:46:23,157",
    "end": "01:46:24,177",
    "start_sec": 6383.157,
    "end_sec": 6384.177,
    "zh": "多了一次警惕",
    "vi": "Có thêm một sự cảnh giác."
  },
  {
    "idx": 3932,
    "start": "01:46:24,177",
    "end": "01:46:26,277",
    "start_sec": 6384.177,
    "end_sec": 6386.277,
    "zh": "长子皮取出高重速",
    "vi": "Đường Tử Bì lấy vật phẩm cao trọng tốc ra."
  },
  {
    "idx": 3933,
    "start": "01:46:26,277",
    "end": "01:46:27,477",
    "start_sec": 6386.277,
    "end_sec": 6387.477,
    "zh": "随手丢给037",
    "vi": "Tiện tay ném cho không ba bảy."
  },
  {
    "idx": 3934,
    "start": "01:46:27,477",
    "end": "01:46:29,317",
    "start_sec": 6387.477,
    "end_sec": 6389.317,
    "zh": "别来沾鸡啊",
    "vi": "Đừng có mà lại gần tôi."
  },
  {
    "idx": 3935,
    "start": "01:46:29,317",
    "end": "01:46:31,417",
    "start_sec": 6389.317,
    "end_sec": 6391.417,
    "zh": "回到101时",
    "vi": "Khi quay trở lại phòng một không một."
  },
  {
    "idx": 3936,
    "start": "01:46:31,417",
    "end": "01:46:32,737",
    "start_sec": 6391.417,
    "end_sec": 6392.737,
    "zh": "长子皮陷入沉思",
    "vi": "Đường Tử Bì chìm vào suy nghĩ."
  },
  {
    "idx": 3937,
    "start": "01:46:32,737",
    "end": "01:46:34,377",
    "start_sec": 6392.737,
    "end_sec": 6394.377,
    "zh": "在去某些危险地方之前",
    "vi": "Trước khi đi đến một số nơi nguy hiểm."
  },
  {
    "idx": 3938,
    "start": "01:46:34,377",
    "end": "01:46:35,917",
    "start_sec": 6394.377,
    "end_sec": 6395.917,
    "zh": "只要提前告知过去的我",
    "vi": "Chỉ cần báo trước cho bản thân tôi trong quá khứ."
  },
  {
    "idx": 3939,
    "start": "01:46:35,917",
    "end": "01:46:37,577",
    "start_sec": 6395.917,
    "end_sec": 6397.577,
    "zh": "我就相当于不死之身",
    "vi": "Tôi coi như đã có được thân thể bất tử."
  },
  {
    "idx": 3940,
    "start": "01:46:37,577",
    "end": "01:46:39,217",
    "start_sec": 6397.577,
    "end_sec": 6399.217,
    "zh": "南城和长水没法去",
    "vi": "Nam Thành và Trường Thủy không thể đi được."
  },
  {
    "idx": 3941,
    "start": "01:46:39,217",
    "end": "01:46:40,997",
    "start_sec": 6399.217,
    "end_sec": 6400.997,
    "zh": "永德寺还是可以尝试一下",
    "vi": "Nhưng chùa Vĩnh Đức vẫn có thể thử một lần."
  },
  {
    "idx": 3942,
    "start": "01:46:40,997",
    "end": "01:46:42,757",
    "start_sec": 6400.997,
    "end_sec": 6402.757,
    "zh": "永德寺外的鬼一杀人",
    "vi": "Con quỷ bên ngoài chùa Vĩnh Đức khi giết người."
  },
  {
    "idx": 3943,
    "start": "01:46:42,757",
    "end": "01:46:43,517",
    "start_sec": 6402.757,
    "end_sec": 6403.517,
    "zh": "有六星级",
    "vi": "Có cấp độ sáu sao."
  },
  {
    "idx": 3944,
    "start": "01:46:43,517",
    "end": "01:46:44,397",
    "start_sec": 6403.517,
    "end_sec": 6404.397,
    "zh": "游落到墙",
    "vi": "Bị hạn chế quy luật."
  },
  {
    "idx": 3945,
    "start": "01:46:44,397",
    "end": "01:46:45,157",
    "start_sec": 6404.397,
    "end_sec": 6405.157,
    "zh": "也就是说",
    "vi": "Nghĩa là."
  },
  {
    "idx": 3946,
    "start": "01:46:45,157",
    "end": "01:46:46,397",
    "start_sec": 6405.157,
    "end_sec": 6406.397,
    "zh": "他只能一个一个的杀",
    "vi": "Nó chỉ có thể giết từng người một."
  },
  {
    "idx": 3947,
    "start": "01:46:46,397",
    "end": "01:46:48,177",
    "start_sec": 6406.397,
    "end_sec": 6408.177,
    "zh": "所以037没有一开始",
    "vi": "Cho nên không ba bảy đã không ra tay ngay từ đầu."
  },
  {
    "idx": 3948,
    "start": "01:46:48,177",
    "end": "01:46:49,177",
    "start_sec": 6408.177,
    "end_sec": 6409.177,
    "zh": "就杀我做香炉",
    "vi": "Để giết tôi làm lư hương."
  },
  {
    "idx": 3949,
    "start": "01:46:49,177",
    "end": "01:46:50,737",
    "start_sec": 6409.177,
    "end_sec": 6410.737,
    "zh": "人越少反而越不易",
    "vi": "Càng ít người thì lại càng bất lợi."
  },
  {
    "idx": 3950,
    "start": "01:46:50,737",
    "end": "01:46:51,557",
    "start_sec": 6410.737,
    "end_sec": 6411.557,
    "zh": "如此说来",
    "vi": "Nói như vậy."
  },
  {
    "idx": 3951,
    "start": "01:46:51,557",
    "end": "01:46:52,857",
    "start_sec": 6411.557,
    "end_sec": 6412.857,
    "zh": "是不是只要人多多",
    "vi": "Có phải chỉ cần có thật nhiều người."
  },
  {
    "idx": 3952,
    "start": "01:46:52,857",
    "end": "01:46:54,977",
    "start_sec": 6412.857,
    "end_sec": 6414.977,
    "zh": "只能在无情鬼一杀完所有的人之前",
    "vi": "Chỉ cần trước khi con quỷ vô tình giết sạch tất cả mọi người."
  },
  {
    "idx": 3953,
    "start": "01:46:54,977",
    "end": "01:46:55,877",
    "start_sec": 6414.977,
    "end_sec": 6415.877,
    "zh": "进入永德寺",
    "vi": "Đi vào chùa Vĩnh Đức."
  },
  {
    "idx": 3954,
    "start": "01:46:55,877",
    "end": "01:46:57,477",
    "start_sec": 6415.877,
    "end_sec": 6417.477,
    "zh": "琢磨了好一会儿",
    "vi": "Suy nghĩ một hồi lâu."
  },
  {
    "idx": 3955,
    "start": "01:46:57,477",
    "end": "01:46:59,577",
    "start_sec": 6417.477,
    "end_sec": 6419.577,
    "zh": "唐子皮越来越觉得这方法可行",
    "vi": "Đường Tử Bì ngày càng cảm thấy phương pháp này khả thi."
  },
  {
    "idx": 3956,
    "start": "01:46:59,577",
    "end": "01:47:02,077",
    "start_sec": 6419.577,
    "end_sec": 6422.077,
    "zh": "想着唐子皮抬眼看了看小区",
    "vi": "Vừa nghĩ Đường Tử Bì vừa ngước mắt nhìn khu chung cư."
  },
  {
    "idx": 3957,
    "start": "01:47:02,077",
    "end": "01:47:04,117",
    "start_sec": 6422.077,
    "end_sec": 6424.117,
    "zh": "仔细的几次听不到任何声音",
    "vi": "Lắng nghe kỹ vài lần nhưng không nghe thấy bất kỳ âm thanh nào."
  },
  {
    "idx": 3958,
    "start": "01:47:04,117",
    "end": "01:47:06,657",
    "start_sec": 6424.117,
    "end_sec": 6426.657,
    "zh": "看来在三只鬼没完的无情思念下",
    "vi": "Xem ra dưới sự tàn phá không ngừng của ba con quỷ."
  },
  {
    "idx": 3959,
    "start": "01:47:06,657",
    "end": "01:47:08,437",
    "start_sec": 6426.657,
    "end_sec": 6428.437,
    "zh": "小区里几乎没什么活人了",
    "vi": "Trong khu chung cư hầu như không còn người sống nào."
  },
  {
    "idx": 3960,
    "start": "01:47:08,437",
    "end": "01:47:09,957",
    "start_sec": 6428.437,
    "end_sec": 6429.957,
    "zh": "唐子皮掏出手机",
    "vi": "Đường Tử Bì lấy điện thoại ra."
  },
  {
    "idx": 3961,
    "start": "01:47:09,957",
    "end": "01:47:11,897",
    "start_sec": 6429.957,
    "end_sec": 6431.897,
    "zh": "给过去的自己发了条消息",
    "vi": "Cậu gửi một tin nhắn cho chính mình trong quá khứ."
  },
  {
    "idx": 3962,
    "start": "01:47:11,897",
    "end": "01:47:13,777",
    "start_sec": 6431.897,
    "end_sec": 6433.777,
    "zh": "问出了一个困扰许久的问题",
    "vi": "Hỏi về một vấn đề đã làm cậu băn khoăn từ lâu."
  },
  {
    "idx": 3963,
    "start": "01:47:13,777",
    "end": "01:47:14,757",
    "start_sec": 6433.777,
    "end_sec": 6434.757,
    "zh": "喂 香茹",
    "vi": "Này Hương Như."
  },
  {
    "idx": 3964,
    "start": "01:47:14,757",
    "end": "01:47:15,717",
    "start_sec": 6434.757,
    "end_sec": 6435.717,
    "zh": "很好用",
    "vi": "Dùng tốt lắm."
  },
  {
    "idx": 3965,
    "start": "01:47:15,717",
    "end": "01:47:17,677",
    "start_sec": 6435.717,
    "end_sec": 6437.677,
    "zh": "但是永德寺到底供奉的是什么",
    "vi": "Nhưng rốt cuộc chùa Vĩnh Đức thờ phụng cái gì."
  },
  {
    "idx": 3966,
    "start": "01:47:17,677",
    "end": "01:47:19,757",
    "start_sec": 6437.677,
    "end_sec": 6439.757,
    "zh": "第六集的时候我说过呀",
    "vi": "Tập sáu tôi đã nói rồi mà."
  },
  {
    "idx": 3967,
    "start": "01:47:19,757",
    "end": "01:47:20,637",
    "start_sec": 6439.757,
    "end_sec": 6440.637,
    "zh": "没看清是什么",
    "vi": "Tôi không nhìn rõ là gì."
  },
  {
    "idx": 3968,
    "start": "01:47:20,637",
    "end": "01:47:21,917",
    "start_sec": 6440.637,
    "end_sec": 6441.917,
    "zh": "不过应该是土地公公",
    "vi": "Nhưng chắc là ông Thổ Địa."
  },
  {
    "idx": 3969,
    "start": "01:47:21,917",
    "end": "01:47:23,037",
    "start_sec": 6441.917,
    "end_sec": 6443.037,
    "zh": "或者城隍之类的吧",
    "vi": "Hoặc là Thành Hoàng gì đó thôi."
  },
  {
    "idx": 3970,
    "start": "01:47:23,037",
    "end": "01:47:23,817",
    "start_sec": 6443.037,
    "end_sec": 6443.817,
    "zh": "行吧",
    "vi": "Được rồi."
  },
  {
    "idx": 3971,
    "start": "01:47:23,817",
    "end": "01:47:24,117",
    "start_sec": 6443.817,
    "end_sec": 6444.117,
    "zh": "还有",
    "vi": "Còn nữa."
  },
  {
    "idx": 3972,
    "start": "01:47:24,117",
    "end": "01:47:25,337",
    "start_sec": 6444.117,
    "end_sec": 6445.337,
    "zh": "我都假设成立了",
    "vi": "Tôi đã giả định là thành công rồi."
  },
  {
    "idx": 3973,
    "start": "01:47:25,337",
    "end": "01:47:25,977",
    "start_sec": 6445.337,
    "end_sec": 6445.977,
    "zh": "将来不死",
    "vi": "Tương lai sẽ không chết."
  },
  {
    "idx": 3974,
    "start": "01:47:25,977",
    "end": "01:47:26,997",
    "start_sec": 6445.977,
    "end_sec": 6446.997,
    "zh": "我就是不死的",
    "vi": "Tôi chính là kẻ bất tử."
  },
  {
    "idx": 3975,
    "start": "01:47:26,997",
    "end": "01:47:27,417",
    "start_sec": 6446.997,
    "end_sec": 6447.417,
    "zh": "所以",
    "vi": "Cho nên."
  },
  {
    "idx": 3976,
    "start": "01:47:27,417",
    "end": "01:47:28,237",
    "start_sec": 6447.417,
    "end_sec": 6448.237,
    "zh": "你小子",
    "vi": "Cậu nhóc à."
  },
  {
    "idx": 3977,
    "start": "01:47:28,237",
    "end": "01:47:29,137",
    "start_sec": 6448.237,
    "end_sec": 6449.137,
    "zh": "给我好好活着",
    "vi": "Hãy sống cho thật tốt."
  },
  {
    "idx": 3978,
    "start": "01:47:29,137",
    "end": "01:47:29,937",
    "start_sec": 6449.137,
    "end_sec": 6449.937,
    "zh": "别只能活着",
    "vi": "Đừng chỉ sống lay lắt."
  },
  {
    "idx": 3979,
    "start": "01:47:29,937",
    "end": "01:47:30,937",
    "start_sec": 6449.937,
    "end_sec": 6450.937,
    "zh": "以后走我走过的路",
    "vi": "Sau này cứ đi theo con đường tôi đã đi."
  },
  {
    "idx": 3980,
    "start": "01:47:30,937",
    "end": "01:47:31,717",
    "start_sec": 6450.937,
    "end_sec": 6451.717,
    "zh": "就不会有事",
    "vi": "Sẽ không có chuyện gì đâu."
  },
  {
    "idx": 3981,
    "start": "01:47:31,717",
    "end": "01:47:32,377",
    "start_sec": 6451.717,
    "end_sec": 6452.377,
    "zh": "我靠",
    "vi": "Ôi trời."
  },
  {
    "idx": 3982,
    "start": "01:47:32,377",
    "end": "01:47:32,917",
    "start_sec": 6452.377,
    "end_sec": 6452.917,
    "zh": "真的",
    "vi": "Thật sao."
  },
  {
    "idx": 3983,
    "start": "01:47:32,917",
    "end": "01:47:33,777",
    "start_sec": 6452.917,
    "end_sec": 6453.777,
    "zh": "那你也太",
    "vi": "Vậy thì cậu cũng quá."
  },
  {
    "idx": 3984,
    "start": "01:47:33,777",
    "end": "01:47:34,597",
    "start_sec": 6453.777,
    "end_sec": 6454.597,
    "zh": "不对",
    "vi": "Không đúng."
  },
  {
    "idx": 3985,
    "start": "01:47:34,597",
    "end": "01:47:36,077",
    "start_sec": 6454.597,
    "end_sec": 6456.077,
    "zh": "那咱俩也太牛逼了",
    "vi": "Vậy thì cả hai chúng ta quá đỉnh rồi."
  },
  {
    "idx": 3986,
    "start": "01:47:36,077",
    "end": "01:47:37,277",
    "start_sec": 6456.077,
    "end_sec": 6457.277,
    "zh": "这时",
    "vi": "Đúng lúc này."
  },
  {
    "idx": 3987,
    "start": "01:47:37,277",
    "end": "01:47:38,877",
    "start_sec": 6457.277,
    "end_sec": 6458.877,
    "zh": "厨房里传出一阵音声",
    "vi": "Trong bếp truyền ra một tiếng động."
  },
  {
    "idx": 3988,
    "start": "01:47:38,877",
    "end": "01:47:40,237",
    "start_sec": 6458.877,
    "end_sec": 6460.237,
    "zh": "橙子皮这才发觉",
    "vi": "Đường Tử Bì lúc này mới nhận ra."
  },
  {
    "idx": 3989,
    "start": "01:47:40,237",
    "end": "01:47:41,297",
    "start_sec": 6460.237,
    "end_sec": 6461.297,
    "zh": "天已经黑下来了",
    "vi": "Trời đã tối hẳn rồi."
  },
  {
    "idx": 3990,
    "start": "01:47:41,297",
    "end": "01:47:43,077",
    "start_sec": 6461.297,
    "end_sec": 6463.077,
    "zh": "敲门鬼缓缓走了出来",
    "vi": "Con quỷ gõ cửa chậm rãi bước ra."
  },
  {
    "idx": 3991,
    "start": "01:47:43,077",
    "end": "01:47:44,637",
    "start_sec": 6463.077,
    "end_sec": 6464.637,
    "zh": "或许是见多了",
    "vi": "Có lẽ do nhìn thấy nhiều rồi"
  },
  {
    "idx": 3992,
    "start": "01:47:44,637",
    "end": "01:47:45,677",
    "start_sec": 6464.637,
    "end_sec": 6465.677,
    "zh": "或许是有了笔迹",
    "vi": "Hoặc có lẽ là đã tự tin hơn."
  },
  {
    "idx": 3993,
    "start": "01:47:45,677",
    "end": "01:47:47,237",
    "start_sec": 6465.677,
    "end_sec": 6467.237,
    "zh": "橙子皮就捧着香炉",
    "vi": "Trần Tử Bì bưng lư hương"
  },
  {
    "idx": 3994,
    "start": "01:47:47,237",
    "end": "01:47:49,177",
    "start_sec": 6467.237,
    "end_sec": 6469.177,
    "zh": "和敲门鬼面对面站着",
    "vi": "đứng đối mặt với Quỷ gõ cửa."
  },
  {
    "idx": 3995,
    "start": "01:47:49,177",
    "end": "01:47:49,777",
    "start_sec": 6469.177,
    "end_sec": 6469.777,
    "zh": "突然",
    "vi": "Đột nhiên"
  },
  {
    "idx": 3996,
    "start": "01:47:49,777",
    "end": "01:47:51,377",
    "start_sec": 6469.777,
    "end_sec": 6471.377,
    "zh": "橙子皮向前走了一步",
    "vi": "Trần Tử Bì bước lên một bước."
  },
  {
    "idx": 3997,
    "start": "01:47:51,377",
    "end": "01:47:52,997",
    "start_sec": 6471.377,
    "end_sec": 6472.997,
    "zh": "敲门鬼竟然没有后退",
    "vi": "Quỷ gõ cửa vậy mà không lùi lại."
  },
  {
    "idx": 3998,
    "start": "01:47:52,997",
    "end": "01:47:54,297",
    "start_sec": 6472.997,
    "end_sec": 6474.297,
    "zh": "他又向前走了一步",
    "vi": "Cậu ta lại bước lên một bước."
  },
  {
    "idx": 3999,
    "start": "01:47:54,297",
    "end": "01:47:55,937",
    "start_sec": 6474.297,
    "end_sec": 6475.937,
    "zh": "敲门鬼还仓促后退",
    "vi": "Quỷ gõ cửa mới vội vàng lùi lại."
  },
  {
    "idx": 4000,
    "start": "01:47:55,937",
    "end": "01:47:57,457",
    "start_sec": 6475.937,
    "end_sec": 6477.457,
    "zh": "进化的可真快啊",
    "vi": "Tiến hóa thật là nhanh quá đi."
  },
  {
    "idx": 4001,
    "start": "01:47:57,457",
    "end": "01:47:59,337",
    "start_sec": 6477.457,
    "end_sec": 6479.337,
    "zh": "就连香炉对他的威慑都变弱了",
    "vi": "Ngay cả sự uy hiếp của lư hương đối với nó cũng yếu đi rồi."
  },
  {
    "idx": 4002,
    "start": "01:47:59,337",
    "end": "01:48:01,397",
    "start_sec": 6479.337,
    "end_sec": 6481.397,
    "zh": "剪橙子皮接下来没了其他动作",
    "vi": "Thấy Trần Tử Bì tiếp theo không có động tác nào khác"
  },
  {
    "idx": 4003,
    "start": "01:48:01,397",
    "end": "01:48:03,537",
    "start_sec": 6481.397,
    "end_sec": 6483.537,
    "zh": "敲门鬼这才感悦过程写成",
    "vi": "Quỷ gõ cửa lúc này mới dám đi qua cậu ta"
  },
  {
    "idx": 4004,
    "start": "01:48:03,537",
    "end": "01:48:04,477",
    "start_sec": 6483.537,
    "end_sec": 6484.477,
    "zh": "匆匆出门",
    "vi": "vội vàng đi ra ngoài."
  },
  {
    "idx": 4005,
    "start": "01:48:04,477",
    "end": "01:48:06,537",
    "start_sec": 6484.477,
    "end_sec": 6486.537,
    "zh": "然而橙子皮却来了兴致",
    "vi": "Thế nhưng Trần Tử Bì lại thấy hứng thú."
  },
  {
    "idx": 4006,
    "start": "01:48:06,537",
    "end": "01:48:07,797",
    "start_sec": 6486.537,
    "end_sec": 6487.797,
    "zh": "敲门鬼走到哪",
    "vi": "Quỷ gõ cửa đi đến đâu"
  },
  {
    "idx": 4007,
    "start": "01:48:07,797",
    "end": "01:48:09,437",
    "start_sec": 6487.797,
    "end_sec": 6489.437,
    "zh": "橙子皮跟到哪",
    "vi": "Trần Tử Bì đi theo đến đó."
  },
  {
    "idx": 4008,
    "start": "01:48:09,437",
    "end": "01:48:10,137",
    "start_sec": 6489.437,
    "end_sec": 6490.137,
    "zh": "我操",
    "vi": "Vãi thật."
  },
  {
    "idx": 4009,
    "start": "01:48:10,137",
    "end": "01:48:11,797",
    "start_sec": 6490.137,
    "end_sec": 6491.797,
    "zh": "这是要往便利店喝啊",
    "vi": "Đây là muốn đi về phía cửa hàng tiện lợi sao."
  },
  {
    "idx": 4010,
    "start": "01:48:11,797",
    "end": "01:48:13,697",
    "start_sec": 6491.797,
    "end_sec": 6493.697,
    "zh": "郑仇该怎么把你引到便利店",
    "vi": "Đang lo không biết làm sao để dẫn ngươi đến cửa hàng tiện lợi"
  },
  {
    "idx": 4011,
    "start": "01:48:13,697",
    "end": "01:48:15,037",
    "start_sec": 6493.697,
    "end_sec": 6495.037,
    "zh": "没想到你自己就去了",
    "vi": "không ngờ ngươi tự mình đi tới đó luôn."
  },
  {
    "idx": 4012,
    "start": "01:48:15,037",
    "end": "01:48:17,117",
    "start_sec": 6495.037,
    "end_sec": 6497.117,
    "zh": "不过这也侧面说明了",
    "vi": "Nhưng điều này cũng gián tiếp nói lên rằng"
  },
  {
    "idx": 4013,
    "start": "01:48:17,117",
    "end": "01:48:19,217",
    "start_sec": 6497.117,
    "end_sec": 6499.217,
    "zh": "小区里幸存的应该没几人了",
    "vi": "trong khu chung cư chắc không còn mấy người sống sót nữa."
  },
  {
    "idx": 4014,
    "start": "01:48:19,217",
    "end": "01:48:23,257",
    "start_sec": 6499.217,
    "end_sec": 6503.257,
    "zh": "轻轻点",
    "vi": "Nhẹ tay chút."
  },
  {
    "idx": 4015,
    "start": "01:48:23,257",
    "end": "01:48:24,037",
    "start_sec": 6503.257,
    "end_sec": 6504.037,
    "zh": "多姐",
    "vi": "Chị Đóa."
  },
  {
    "idx": 4016,
    "start": "01:48:24,037",
    "end": "01:48:25,497",
    "start_sec": 6504.037,
    "end_sec": 6505.497,
    "zh": "这个力道可以吗",
    "vi": "Lực thế này được chưa."
  },
  {
    "idx": 4017,
    "start": "01:48:25,497",
    "end": "01:48:26,917",
    "start_sec": 6505.497,
    "end_sec": 6506.917,
    "zh": "电力电力正齐了熔融",
    "vi": "Trong cửa hàng tiện lợi đang vô cùng vui vẻ ấm cúng."
  },
  {
    "idx": 4018,
    "start": "01:48:26,917",
    "end": "01:48:27,497",
    "start_sec": 6506.917,
    "end_sec": 6507.497,
    "zh": "突然",
    "vi": "Đột nhiên"
  },
  {
    "idx": 4019,
    "start": "01:48:27,497",
    "end": "01:48:30,077",
    "start_sec": 6507.497,
    "end_sec": 6510.077,
    "zh": "一阵猛烈的敲门声响起",
    "vi": "một tiếng gõ cửa dồn dập vang lên"
  },
  {
    "idx": 4020,
    "start": "01:48:30,077",
    "end": "01:48:31,457",
    "start_sec": 6510.077,
    "end_sec": 6511.457,
    "zh": "既然网的数值深的",
    "vi": "phá vỡ bầu không khí ấm áp này."
  },
  {
    "idx": 4021,
    "start": "01:48:31,457",
    "end": "01:48:32,437",
    "start_sec": 6511.457,
    "end_sec": 6512.437,
    "zh": "多是敲门声",
    "vi": "Tiếng gõ cửa này"
  },
  {
    "idx": 4022,
    "start": "01:48:32,437",
    "end": "01:48:33,657",
    "start_sec": 6512.437,
    "end_sec": 6513.657,
    "zh": "不如多是催命符",
    "vi": "chẳng khác nào bùa đòi mạng."
  },
  {
    "idx": 4023,
    "start": "01:48:33,657",
    "end": "01:48:35,677",
    "start_sec": 6513.657,
    "end_sec": 6515.677,
    "zh": "已经深深刻入了他们骨子里",
    "vi": "Nó đã khắc sâu vào tận xương tủy của họ."
  },
  {
    "idx": 4024,
    "start": "01:48:35,677",
    "end": "01:48:36,217",
    "start_sec": 6515.677,
    "end_sec": 6516.217,
    "zh": "多姐",
    "vi": "Chị Đa."
  },
  {
    "idx": 4025,
    "start": "01:48:36,217",
    "end": "01:48:38,537",
    "start_sec": 6516.217,
    "end_sec": 6518.537,
    "zh": "敲敲门鬼怎么会在我们门外",
    "vi": "Sao con quỷ gõ cửa lại ở ngoài cửa nhà chúng ta thế này."
  },
  {
    "idx": 4026,
    "start": "01:48:38,537",
    "end": "01:48:38,917",
    "start_sec": 6518.537,
    "end_sec": 6518.917,
    "zh": "他",
    "vi": "Nó"
  },
  {
    "idx": 4027,
    "start": "01:48:38,917",
    "end": "01:48:40,757",
    "start_sec": 6518.917,
    "end_sec": 6520.757,
    "zh": "他难道不怕黑狗吗",
    "vi": "chẳng lẽ nó không sợ chó đen sao."
  },
  {
    "idx": 4028,
    "start": "01:48:40,757",
    "end": "01:48:41,997",
    "start_sec": 6520.757,
    "end_sec": 6521.997,
    "zh": "赵德住在收银台",
    "vi": "Triệu Đức đứng ở quầy thu ngân"
  },
  {
    "idx": 4029,
    "start": "01:48:41,997",
    "end": "01:48:42,837",
    "start_sec": 6521.997,
    "end_sec": 6522.837,
    "zh": "通过监控",
    "vi": "thông qua camera giám sát"
  },
  {
    "idx": 4030,
    "start": "01:48:42,837",
    "end": "01:48:44,437",
    "start_sec": 6522.837,
    "end_sec": 6524.437,
    "zh": "往门外看的真真切切",
    "vi": "nhìn ra ngoài cửa rất rõ ràng."
  },
  {
    "idx": 4031,
    "start": "01:48:44,437",
    "end": "01:48:44,957",
    "start_sec": 6524.437,
    "end_sec": 6524.957,
    "zh": "多姐",
    "vi": "Chị Đa."
  },
  {
    "idx": 4032,
    "start": "01:48:44,957",
    "end": "01:48:46,077",
    "start_sec": 6524.957,
    "end_sec": 6526.077,
    "zh": "你说这玩意",
    "vi": "Chị nói xem thứ này"
  },
  {
    "idx": 4033,
    "start": "01:48:46,077",
    "end": "01:48:47,317",
    "start_sec": 6526.077,
    "end_sec": 6527.317,
    "zh": "不会进来吧",
    "vi": "không vào được đây chứ."
  },
  {
    "idx": 4034,
    "start": "01:48:47,317",
    "end": "01:48:48,057",
    "start_sec": 6527.317,
    "end_sec": 6528.057,
    "zh": "不用慌",
    "vi": "Không cần hoảng loạn."
  },
  {
    "idx": 4035,
    "start": "01:48:48,057",
    "end": "01:48:49,297",
    "start_sec": 6528.057,
    "end_sec": 6529.297,
    "zh": "我们有两只黑狗",
    "vi": "Chúng ta có hai con chó đen."
  },
  {
    "idx": 4036,
    "start": "01:48:49,297",
    "end": "01:48:50,097",
    "start_sec": 6529.297,
    "end_sec": 6530.097,
    "zh": "我就不信",
    "vi": "Tôi không tin"
  },
  {
    "idx": 4037,
    "start": "01:48:50,097",
    "end": "01:48:51,097",
    "start_sec": 6530.097,
    "end_sec": 6531.097,
    "zh": "他就赶紧进来",
    "vi": "nó dám xông vào đây."
  },
  {
    "idx": 4038,
    "start": "01:48:51,097",
    "end": "01:48:52,917",
    "start_sec": 6531.097,
    "end_sec": 6532.917,
    "zh": "然而罗剑的话刚说完",
    "vi": "Thế nhưng La Kiếm vừa dứt lời"
  },
  {
    "idx": 4039,
    "start": "01:48:52,917",
    "end": "01:48:55,417",
    "start_sec": 6532.917,
    "end_sec": 6535.417,
    "zh": "厚重的门给敲门鬼掀飞",
    "vi": "cánh cửa dày đã bị quỷ gõ cửa hất tung."
  },
  {
    "idx": 4040,
    "start": "01:48:55,417",
    "end": "01:48:57,217",
    "start_sec": 6535.417,
    "end_sec": 6537.217,
    "zh": "他真进来了",
    "vi": "Nó thực sự đã vào rồi."
  },
  {
    "idx": 4041,
    "start": "01:48:57,217",
    "end": "01:48:57,877",
    "start_sec": 6537.217,
    "end_sec": 6537.877,
    "zh": "虎子",
    "vi": "Hổ Tử."
  },
  {
    "idx": 4042,
    "start": "01:48:57,877",
    "end": "01:48:58,757",
    "start_sec": 6537.877,
    "end_sec": 6538.757,
    "zh": "小墨记",
    "vi": "Tiểu Mặc Ký."
  },
  {
    "idx": 4043,
    "start": "01:48:58,757",
    "end": "01:48:59,817",
    "start_sec": 6538.757,
    "end_sec": 6539.817,
    "zh": "快上",
    "vi": "Mau lên đi."
  },
  {
    "idx": 4044,
    "start": "01:48:59,817",
    "end": "01:49:00,757",
    "start_sec": 6539.817,
    "end_sec": 6540.757,
    "zh": "然而这次",
    "vi": "Thế nhưng lần này"
  },
  {
    "idx": 4045,
    "start": "01:49:00,757",
    "end": "01:49:01,917",
    "start_sec": 6540.757,
    "end_sec": 6541.917,
    "zh": "虎子和小墨记",
    "vi": "Hổ Tử và Tiểu Mặc Ký"
  },
  {
    "idx": 4046,
    "start": "01:49:01,917",
    "end": "01:49:02,917",
    "start_sec": 6541.917,
    "end_sec": 6542.917,
    "zh": "见到敲门鬼",
    "vi": "khi nhìn thấy quỷ gõ cửa"
  },
  {
    "idx": 4047,
    "start": "01:49:02,917",
    "end": "01:49:04,197",
    "start_sec": 6542.917,
    "end_sec": 6544.197,
    "zh": "竟是连叫都不敢叫",
    "vi": "lại đến sủa cũng không dám sủa."
  },
  {
    "idx": 4048,
    "start": "01:49:04,197",
    "end": "01:49:05,657",
    "start_sec": 6544.197,
    "end_sec": 6545.657,
    "zh": "小墨记",
    "vi": "Tiểu Mặc Ký."
  },
  {
    "idx": 4049,
    "start": "01:49:05,657",
    "end": "01:49:06,637",
    "start_sec": 6545.657,
    "end_sec": 6546.637,
    "zh": "我在接你",
    "vi": "Ta đến đón ngươi."
  },
  {
    "idx": 4050,
    "start": "01:49:06,637",
    "end": "01:49:08,217",
    "start_sec": 6546.637,
    "end_sec": 6548.217,
    "zh": "几人见到橙子皮",
    "vi": "Mấy người nhìn thấy Trần Tử Bì."
  },
  {
    "idx": 4051,
    "start": "01:49:08,217",
    "end": "01:49:10,037",
    "start_sec": 6548.217,
    "end_sec": 6550.037,
    "zh": "一直都在敲门鬼身后时",
    "vi": "luôn ở ngay phía sau quỷ gõ cửa"
  },
  {
    "idx": 4052,
    "start": "01:49:10,037",
    "end": "01:49:11,537",
    "start_sec": 6550.037,
    "end_sec": 6551.537,
    "zh": "全都汗流浃背",
    "vi": "ai nấy đều mồ hôi đầm đìa."
  },
  {
    "idx": 4053,
    "start": "01:49:11,537",
    "end": "01:49:12,417",
    "start_sec": 6551.537,
    "end_sec": 6552.417,
    "zh": "你怎么",
    "vi": "Sao ngươi"
  },
  {
    "idx": 4054,
    "start": "01:49:12,417",
    "end": "01:49:13,237",
    "start_sec": 6552.417,
    "end_sec": 6553.237,
    "zh": "怎么会没事",
    "vi": "sao lại không sao chứ."
  },
  {
    "idx": 4055,
    "start": "01:49:13,237",
    "end": "01:49:14,117",
    "start_sec": 6553.237,
    "end_sec": 6554.117,
    "zh": "罗剑",
    "vi": "La Kiếm"
  },
  {
    "idx": 4056,
    "start": "01:49:14,117",
    "end": "01:49:14,577",
    "start_sec": 6554.117,
    "end_sec": 6554.577,
    "zh": "他",
    "vi": "hắn"
  },
  {
    "idx": 4057,
    "start": "01:49:14,577",
    "end": "01:49:16,397",
    "start_sec": 6554.577,
    "end_sec": 6556.397,
    "zh": "他不会能操控鬼的",
    "vi": "không lẽ hắn có thể điều khiển quỷ sao."
  },
  {
    "idx": 4058,
    "start": "01:49:16,397",
    "end": "01:49:17,877",
    "start_sec": 6556.397,
    "end_sec": 6557.877,
    "zh": "橙子皮眼前一样",
    "vi": "Trần Tử Bì nhìn bọn họ."
  },
  {
    "idx": 4059,
    "start": "01:49:17,877",
    "end": "01:49:20,074",
    "start_sec": 6557.877,
    "end_sec": 6560.074,
    "zh": "你们知道,我们和长门鬼一直住一间房都没事,难道我不能操控鬼吗?",
    "vi": "Các ngươi biết đấy, ta và quỷ gõ cửa ở chung một phòng suốt"
  },
  {
    "idx": 4059,
    "start": "01:49:20,074",
    "end": "01:49:21,957",
    "start_sec": 6560.074,
    "end_sec": 6561.957,
    "zh": "你们知道,我们和长门鬼一直住一间房都没事,难道我不能操控鬼吗?",
    "vi": "mà không sao, chẳng lẽ ta không thể điều khiển quỷ sao."
  },
  {
    "idx": 4060,
    "start": "01:49:22,577",
    "end": "01:49:25,997",
    "start_sec": 6562.577,
    "end_sec": 6565.997,
    "zh": "橙子皮,你都不怕鬼了,为什么还来找我们麻烦?",
    "vi": "Trần Tử Bì, ngươi đã không sợ quỷ rồi, tại sao còn đến tìm tụi ta gây phiền phức chứ."
  },
  {
    "idx": 4061,
    "start": "01:49:26,457",
    "end": "01:49:29,437",
    "start_sec": 6566.457,
    "end_sec": 6569.437,
    "zh": "啊,有没有搞错,找麻烦的一直不都是你了吗?",
    "vi": "À, có nhầm không thế, kẻ gây phiền phức từ trước đến nay chẳng phải luôn là ngươi sao."
  },
  {
    "idx": 4062,
    "start": "01:49:29,857",
    "end": "01:49:32,833",
    "start_sec": 6569.857,
    "end_sec": 6572.833,
    "zh": "橙子皮脸色冷色,小门鬼身体稍微前倾了一下,我可瞬间被吓得瘫痪了。",
    "vi": "Vẻ mặt Trần Tử Bì lạnh lùng, quỷ gõ cửa hơi nghiêng người về"
  },
  {
    "idx": 4062,
    "start": "01:49:32,833",
    "end": "01:49:35,597",
    "start_sec": 6572.833,
    "end_sec": 6575.597,
    "zh": "橙子皮脸色冷色,小门鬼身体稍微前倾了一下,我可瞬间被吓得瘫痪了。",
    "vi": "phía trước một chút, ta lập tức bị dọa cho nhũn cả người."
  },
  {
    "idx": 4063,
    "start": "01:49:35,997",
    "end": "01:49:39,937",
    "start_sec": 6575.997,
    "end_sec": 6579.937,
    "zh": "别,别杀我,橙哥哥,只要你不杀我,我什么都会做的。",
    "vi": "Đừng, đừng giết ta, ca ca Trần Tử Bì, chỉ cần huynh không giết ta, ta chuyện gì cũng chịu làm."
  },
  {
    "idx": 4064,
    "start": "01:49:40,277",
    "end": "01:49:42,117",
    "start_sec": 6580.277,
    "end_sec": 6582.117,
    "zh": "吐槽,这一幕怎么有点出现了?",
    "vi": "Thầm nghĩ, cảnh tượng này sao quen thuộc thế nhỉ."
  },
  {
    "idx": 4065,
    "start": "01:49:42,277",
    "end": "01:49:44,557",
    "start_sec": 6582.277,
    "end_sec": 6584.557,
    "zh": "我该死的,我不该找你麻烦的。",
    "vi": "Ta thật đáng chết, ta không nên gây phiền phức cho ngươi."
  },
  {
    "idx": 4066,
    "start": "01:49:44,557",
    "end": "01:49:48,197",
    "start_sec": 6584.557,
    "end_sec": 6588.197,
    "zh": "长子皮后退几步",
    "vi": "Trần Tử Bì lùi lại vài bước."
  },
  {
    "idx": 4067,
    "start": "01:49:48,197",
    "end": "01:49:50,077",
    "start_sec": 6588.197,
    "end_sec": 6590.077,
    "zh": "本以为敲门鬼会扑上去",
    "vi": "Cứ ngỡ quỷ gõ cửa sẽ lao lên"
  },
  {
    "idx": 4068,
    "start": "01:49:50,077",
    "end": "01:49:51,277",
    "start_sec": 6590.077,
    "end_sec": 6591.277,
    "zh": "把所有人都杀了",
    "vi": "giết sạch tất cả mọi người"
  },
  {
    "idx": 4069,
    "start": "01:49:51,277",
    "end": "01:49:52,777",
    "start_sec": 6591.277,
    "end_sec": 6592.777,
    "zh": "但他却站在原地不动",
    "vi": "nhưng nó lại đứng im tại chỗ không nhúc nhích."
  },
  {
    "idx": 4070,
    "start": "01:49:52,777",
    "end": "01:49:54,877",
    "start_sec": 6592.777,
    "end_sec": 6594.877,
    "zh": "看来敲门鬼还没有计划到",
    "vi": "Xem ra quỷ gõ cửa vẫn chưa tiến hóa đến"
  },
  {
    "idx": 4071,
    "start": "01:49:54,877",
    "end": "01:49:57,079",
    "start_sec": 6594.877,
    "end_sec": 6597.079,
    "zh": "敢杀黑狗的地步毕竟黑狗血连涌着四外的无形诡异都能抵挡片刻长子皮皮稍加思想,其实吧,都是邻里邻居的,也没必要闹那么僵,只要你们以后老实本分,别耍小心思,我不仅不会找你们麻烦,还会带门前凭将士的安全撤离点。",
    "vi": "mức dám giết chó đen, dù sao máu chó đen ngay cả sự kỳ"
  },
  {
    "idx": 4071,
    "start": "01:49:57,079",
    "end": "01:49:59,439",
    "start_sec": 6597.079,
    "end_sec": 6599.439,
    "zh": "敢杀黑狗的地步毕竟黑狗血连涌着四外的无形诡异都能抵挡片刻长子皮皮稍加思想,其实吧,都是邻里邻居的,也没必要闹那么僵,只要你们以后老实本分,别耍小心思,我不仅不会找你们麻烦,还会带门前凭将士的安全撤离点。",
    "vi": "dị vô hình tràn ngập xung quanh cũng có thể chống đỡ được một lát"
  },
  {
    "idx": 4071,
    "start": "01:49:59,439",
    "end": "01:50:01,799",
    "start_sec": 6599.439,
    "end_sec": 6601.799,
    "zh": "敢杀黑狗的地步毕竟黑狗血连涌着四外的无形诡异都能抵挡片刻长子皮皮稍加思想,其实吧,都是邻里邻居的,也没必要闹那么僵,只要你们以后老实本分,别耍小心思,我不仅不会找你们麻烦,还会带门前凭将士的安全撤离点。",
    "vi": "Trần Tử Bì suy nghĩ một chút, thật ra thì, đều là hàng xóm láng"
  },
  {
    "idx": 4071,
    "start": "01:50:01,799",
    "end": "01:50:04,158",
    "start_sec": 6601.799,
    "end_sec": 6604.158,
    "zh": "敢杀黑狗的地步毕竟黑狗血连涌着四外的无形诡异都能抵挡片刻长子皮皮稍加思想,其实吧,都是邻里邻居的,也没必要闹那么僵,只要你们以后老实本分,别耍小心思,我不仅不会找你们麻烦,还会带门前凭将士的安全撤离点。",
    "vi": "giềng cả, cũng không cần phải làm căng thẳng như vậy, chỉ cần sau này"
  },
  {
    "idx": 4071,
    "start": "01:50:04,158",
    "end": "01:50:06,517",
    "start_sec": 6604.158,
    "end_sec": 6606.517,
    "zh": "敢杀黑狗的地步毕竟黑狗血连涌着四外的无形诡异都能抵挡片刻长子皮皮稍加思想,其实吧,都是邻里邻居的,也没必要闹那么僵,只要你们以后老实本分,别耍小心思,我不仅不会找你们麻烦,还会带门前凭将士的安全撤离点。",
    "vi": "các ngươi an phận thủ thường, đừng giở trò vặt, ta không những không tìm"
  },
  {
    "idx": 4071,
    "start": "01:50:06,517",
    "end": "01:50:09,034",
    "start_sec": 6606.517,
    "end_sec": 6609.034,
    "zh": "敢杀黑狗的地步毕竟黑狗血连涌着四外的无形诡异都能抵挡片刻长子皮皮稍加思想,其实吧,都是邻里邻居的,也没必要闹那么僵,只要你们以后老实本分,别耍小心思,我不仅不会找你们麻烦,还会带门前凭将士的安全撤离点。",
    "vi": "các ngươi gây phiền phức, mà còn đưa các ngươi đến điểm rút lui an toàn"
  },
  {
    "idx": 4072,
    "start": "01:50:09,494",
    "end": "01:50:11,494",
    "start_sec": 6609.494,
    "end_sec": 6611.494,
    "zh": "几人文言心理一击,接着又是疑惑。",
    "vi": "Mấy người nghe vậy thì trong lòng chấn động, sau đó lại nghi ngờ."
  },
  {
    "idx": 4073,
    "start": "01:50:11,794",
    "end": "01:50:13,634",
    "start_sec": 6611.794,
    "end_sec": 6613.634,
    "zh": "撤离点?成哥哥,真的吗?",
    "vi": "Điểm rút lui sao. Ca ca Trần Tử Bì, có thật không."
  },
  {
    "idx": 4074,
    "start": "01:50:14,174",
    "end": "01:50:16,234",
    "start_sec": 6614.174,
    "end_sec": 6616.234,
    "zh": "有,你们舒适舒适,我们明天就过去。",
    "vi": "Có chứ, các ngươi chuẩn bị đi, ngày mai chúng ta sẽ qua đó."
  },
  {
    "idx": 4075,
    "start": "01:50:16,414",
    "end": "01:50:19,843",
    "start_sec": 6616.414,
    "end_sec": 6619.843,
    "zh": "最后,橙子皮挡在敲门鬼身上,回去,然而敲门鬼依旧站在原地,妈的,回去。",
    "vi": "Cuối cùng, Trần Tử Bì chắn trước quỷ gõ cửa, bảo nó lui lại, thế"
  },
  {
    "idx": 4075,
    "start": "01:50:19,843",
    "end": "01:50:22,814",
    "start_sec": 6619.843,
    "end_sec": 6622.814,
    "zh": "最后,橙子皮挡在敲门鬼身上,回去,然而敲门鬼依旧站在原地,妈的,回去。",
    "vi": "nhưng quỷ gõ cửa vẫn đứng im tại chỗ, mẹ kiếp, lui lại."
  },
  {
    "idx": 4076,
    "start": "01:50:22,814",
    "end": "01:50:24,254",
    "start_sec": 6622.814,
    "end_sec": 6624.254,
    "zh": "祖祖喊了两三遍",
    "vi": "Hắn gọi liên tiếp hai ba lần"
  },
  {
    "idx": 4077,
    "start": "01:50:24,254",
    "end": "01:50:26,014",
    "start_sec": 6624.254,
    "end_sec": 6626.014,
    "zh": "直到橙子皮伸手摸香炉",
    "vi": "cho đến khi Trần Tử Bì đưa tay chạm vào lư hương"
  },
  {
    "idx": 4078,
    "start": "01:50:26,014",
    "end": "01:50:27,574",
    "start_sec": 6626.014,
    "end_sec": 6627.574,
    "zh": "敲门鬼才出来声音",
    "vi": "quỷ gõ cửa mới phát ra âm thanh."
  },
  {
    "idx": 4079,
    "start": "01:50:27,574",
    "end": "01:50:35,994",
    "start_sec": 6627.574,
    "end_sec": 6635.994,
    "zh": "博企你说橙子皮不会是骗我们的吧",
    "vi": "Bác Khải, ngươi nói xem Trần Tử Bì không phải đang lừa chúng ta chứ."
  },
  {
    "idx": 4080,
    "start": "01:50:35,994",
    "end": "01:50:37,334",
    "start_sec": 6635.994,
    "end_sec": 6637.334,
    "zh": "管他是不是骗我们",
    "vi": "Quản chi hắn có lừa chúng ta hay không."
  },
  {
    "idx": 4081,
    "start": "01:50:37,334",
    "end": "01:50:38,954",
    "start_sec": 6637.334,
    "end_sec": 6638.954,
    "zh": "现在我们有别的选择吗",
    "vi": "Bây giờ chúng ta còn lựa chọn nào khác không"
  },
  {
    "idx": 4082,
    "start": "01:50:38,954",
    "end": "01:50:40,214",
    "start_sec": 6638.954,
    "end_sec": 6640.214,
    "zh": "他能控制敲门鬼",
    "vi": "Hắn có thể điều khiển Kẻ Gõ Cửa"
  },
  {
    "idx": 4083,
    "start": "01:50:40,214",
    "end": "01:50:40,934",
    "start_sec": 6640.214,
    "end_sec": 6640.934,
    "zh": "想杀我们",
    "vi": "Muốn giết chúng ta"
  },
  {
    "idx": 4084,
    "start": "01:50:40,934",
    "end": "01:50:42,014",
    "start_sec": 6640.934,
    "end_sec": 6642.014,
    "zh": "刚才不就杀了",
    "vi": "Vừa rồi chẳng phải đã giết rồi sao"
  },
  {
    "idx": 4085,
    "start": "01:50:42,014",
    "end": "01:50:44,434",
    "start_sec": 6642.014,
    "end_sec": 6644.434,
    "zh": "博企说不定真有什么撤离点",
    "vi": "Biết đâu Bác Kỳ nói có điểm sơ tán thật"
  },
  {
    "idx": 4086,
    "start": "01:50:44,434",
    "end": "01:50:46,214",
    "start_sec": 6644.434,
    "end_sec": 6646.214,
    "zh": "你看他天天往外面跑",
    "vi": "Cậu xem ngày nào hắn cũng chạy ra ngoài"
  },
  {
    "idx": 4087,
    "start": "01:50:46,214",
    "end": "01:50:48,174",
    "start_sec": 6646.214,
    "end_sec": 6648.174,
    "zh": "知道的肯定比我们要多",
    "vi": "Chắc chắn biết nhiều hơn chúng ta"
  },
  {
    "idx": 4088,
    "start": "01:50:48,174",
    "end": "01:50:49,074",
    "start_sec": 6648.174,
    "end_sec": 6649.074,
    "zh": "不过",
    "vi": "Nhưng mà"
  },
  {
    "idx": 4089,
    "start": "01:50:49,074",
    "end": "01:50:50,274",
    "start_sec": 6649.074,
    "end_sec": 6650.274,
    "zh": "赵德柱脸色一蓝",
    "vi": "Triệu Đức Trụ sắc mặt tái xanh"
  },
  {
    "idx": 4090,
    "start": "01:50:50,274",
    "end": "01:50:51,714",
    "start_sec": 6650.274,
    "end_sec": 6651.714,
    "zh": "他真敢耍我们",
    "vi": "Hắn dám lừa chúng ta thật"
  },
  {
    "idx": 4091,
    "start": "01:50:51,714",
    "end": "01:50:53,994",
    "start_sec": 6651.714,
    "end_sec": 6653.994,
    "zh": "到时候貌似也要拉他一起垫背",
    "vi": "Đến lúc đó có lẽ cũng phải kéo hắn đi cùng chịu tội"
  },
  {
    "idx": 4092,
    "start": "01:50:53,994",
    "end": "01:50:56,354",
    "start_sec": 6653.994,
    "end_sec": 6656.354,
    "zh": "彻底点是真的有",
    "vi": "Điểm sơ tán thực sự có tồn tại"
  },
  {
    "idx": 4093,
    "start": "01:50:56,354",
    "end": "01:50:57,594",
    "start_sec": 6656.354,
    "end_sec": 6657.594,
    "zh": "但我可不是适当好人",
    "vi": "Nhưng tôi không phải người tốt bụng gì"
  },
  {
    "idx": 4094,
    "start": "01:50:57,594",
    "end": "01:50:58,834",
    "start_sec": 6657.594,
    "end_sec": 6658.834,
    "zh": "明天有一个算一个",
    "vi": "Ngày mai gặp một người tính một người"
  },
  {
    "idx": 4095,
    "start": "01:50:58,834",
    "end": "01:50:59,654",
    "start_sec": 6658.834,
    "end_sec": 6659.654,
    "zh": "小区里的人",
    "vi": "Những người trong khu dân cư"
  },
  {
    "idx": 4096,
    "start": "01:50:59,654",
    "end": "01:51:00,914",
    "start_sec": 6659.654,
    "end_sec": 6660.914,
    "zh": "全都带着去永德寺",
    "vi": "Đều đưa đến Vĩnh Đức Tự"
  },
  {
    "idx": 4097,
    "start": "01:51:00,914",
    "end": "01:51:02,574",
    "start_sec": 6660.914,
    "end_sec": 6662.574,
    "zh": "至于能不能活着走进永德寺",
    "vi": "Còn việc có sống đến được Vĩnh Đức Tự hay không"
  },
  {
    "idx": 4098,
    "start": "01:51:02,574",
    "end": "01:51:03,774",
    "start_sec": 6662.574,
    "end_sec": 6663.774,
    "zh": "那就和我没关系了",
    "vi": "Thì không liên quan đến tôi"
  },
  {
    "idx": 4099,
    "start": "01:51:03,774",
    "end": "01:51:06,654",
    "start_sec": 6663.774,
    "end_sec": 6666.654,
    "zh": "一大早",
    "vi": "Sáng sớm"
  },
  {
    "idx": 4100,
    "start": "01:51:06,654",
    "end": "01:51:08,794",
    "start_sec": 6666.654,
    "end_sec": 6668.794,
    "zh": "橙子皮就站在小区里大喊",
    "vi": "Trần Tử Bì đã đứng trong khu dân cư la hét"
  },
  {
    "idx": 4101,
    "start": "01:51:08,794",
    "end": "01:51:09,874",
    "start_sec": 6668.794,
    "end_sec": 6669.874,
    "zh": "还有没有活着的",
    "vi": "Còn ai sống sót không"
  },
  {
    "idx": 4102,
    "start": "01:51:09,874",
    "end": "01:51:10,394",
    "start_sec": 6669.874,
    "end_sec": 6670.394,
    "zh": "随后",
    "vi": "Sau đó"
  },
  {
    "idx": 4103,
    "start": "01:51:10,394",
    "end": "01:51:11,994",
    "start_sec": 6670.394,
    "end_sec": 6671.994,
    "zh": "零零散散的几个窗口",
    "vi": "Vài cửa sổ lác đác"
  },
  {
    "idx": 4104,
    "start": "01:51:11,994",
    "end": "01:51:12,694",
    "start_sec": 6671.994,
    "end_sec": 6672.694,
    "zh": "探脱脑袋",
    "vi": "Thò đầu ra"
  },
  {
    "idx": 4105,
    "start": "01:51:12,694",
    "end": "01:51:13,234",
    "start_sec": 6672.694,
    "end_sec": 6673.234,
    "zh": "你们",
    "vi": "Các bạn"
  },
  {
    "idx": 4106,
    "start": "01:51:13,234",
    "end": "01:51:14,594",
    "start_sec": 6673.234,
    "end_sec": 6674.594,
    "zh": "现在有个活命的机会",
    "vi": "Bây giờ có cơ hội sống sót"
  },
  {
    "idx": 4107,
    "start": "01:51:14,594",
    "end": "01:51:15,574",
    "start_sec": 6674.594,
    "end_sec": 6675.574,
    "zh": "跟着我去永德寺",
    "vi": "Đi theo tôi đến Vĩnh Đức Tự"
  },
  {
    "idx": 4108,
    "start": "01:51:15,574",
    "end": "01:51:16,834",
    "start_sec": 6675.574,
    "end_sec": 6676.834,
    "zh": "那里是彻底点",
    "vi": "Đó là điểm sơ tán"
  },
  {
    "idx": 4109,
    "start": "01:51:16,834",
    "end": "01:51:17,754",
    "start_sec": 6676.834,
    "end_sec": 6677.754,
    "zh": "或者在家等死",
    "vi": "Hoặc là ở nhà chờ chết"
  },
  {
    "idx": 4110,
    "start": "01:51:17,754",
    "end": "01:51:19,814",
    "start_sec": 6677.754,
    "end_sec": 6679.814,
    "zh": "在橙子皮一番口舌之下",
    "vi": "Dưới sự thuyết phục của Trần Tử Bì"
  },
  {
    "idx": 4111,
    "start": "01:51:19,814",
    "end": "01:51:21,334",
    "start_sec": 6679.814,
    "end_sec": 6681.334,
    "zh": "最终跟橙子皮下来的",
    "vi": "Cuối cùng đi cùng Thành"
  },
  {
    "idx": 4112,
    "start": "01:51:21,334",
    "end": "01:51:22,014",
    "start_sec": 6681.334,
    "end_sec": 6682.014,
    "zh": "只有五人",
    "vi": "Chỉ có năm người."
  },
  {
    "idx": 4113,
    "start": "01:51:22,014",
    "end": "01:51:24,194",
    "start_sec": 6682.014,
    "end_sec": 6684.194,
    "zh": "剩下的一些是已经认命了的",
    "vi": "Những người còn lại một số đã chấp nhận số phận."
  },
  {
    "idx": 4114,
    "start": "01:51:24,194",
    "end": "01:51:26,254",
    "start_sec": 6684.194,
    "end_sec": 6686.254,
    "zh": "一些是连站起来的力气都没了的",
    "vi": "Một số thì đến sức đứng dậy cũng không còn."
  },
  {
    "idx": 4115,
    "start": "01:51:26,254",
    "end": "01:51:28,114",
    "start_sec": 6686.254,
    "end_sec": 6688.114,
    "zh": "加上罗宪等人",
    "vi": "Cộng thêm nhóm của La Hiến"
  },
  {
    "idx": 4116,
    "start": "01:51:28,114",
    "end": "01:51:30,374",
    "start_sec": 6688.114,
    "end_sec": 6690.374,
    "zh": "一行十几人坐上两辆面包车",
    "vi": "Cả nhóm mười mấy người bước lên hai chiếc xe van"
  },
  {
    "idx": 4117,
    "start": "01:51:30,374",
    "end": "01:51:32,174",
    "start_sec": 6690.374,
    "end_sec": 6692.174,
    "zh": "朝着永德寺飞快开去",
    "vi": "Nhanh chóng lái về phía chùa Vĩnh Đức."
  },
  {
    "idx": 4118,
    "start": "01:51:32,174",
    "end": "01:51:33,574",
    "start_sec": 6692.174,
    "end_sec": 6693.574,
    "zh": "临近中午时",
    "vi": "Khi gần đến giữa trưa"
  },
  {
    "idx": 4119,
    "start": "01:51:33,574",
    "end": "01:51:35,674",
    "start_sec": 6693.574,
    "end_sec": 6695.674,
    "zh": "一行人终于到达永德寺范围",
    "vi": "Cả nhóm cuối cùng cũng đến được phạm vi chùa Vĩnh Đức."
  },
  {
    "idx": 4120,
    "start": "01:51:35,674",
    "end": "01:51:38,934",
    "start_sec": 6695.674,
    "end_sec": 6698.934,
    "zh": "将提前编辑好的消息发给过去的自己后",
    "vi": "Sau khi gửi tin nhắn đã soạn sẵn cho bản thân trong quá khứ"
  },
  {
    "idx": 4121,
    "start": "01:51:38,934",
    "end": "01:51:40,454",
    "start_sec": 6698.934,
    "end_sec": 6700.454,
    "zh": "橙子一阵流文踩道",
    "vi": "Thành nhấn mạnh chân ga"
  },
  {
    "idx": 4122,
    "start": "01:51:40,454",
    "end": "01:51:41,434",
    "start_sec": 6700.454,
    "end_sec": 6701.434,
    "zh": "去三次了",
    "vi": "Đi ba lần rồi."
  },
  {
    "idx": 4123,
    "start": "01:51:41,434",
    "end": "01:51:43,474",
    "start_sec": 6701.434,
    "end_sec": 6703.474,
    "zh": "他妈的永德寺老天不信进不去",
    "vi": "Mẹ kiếp chùa Vĩnh Đức tôi không tin là không vào được."
  },
  {
    "idx": 4124,
    "start": "01:51:43,474",
    "end": "01:51:45,214",
    "start_sec": 6703.474,
    "end_sec": 6705.214,
    "zh": "眼看着永德寺越来越近",
    "vi": "Nhìn chùa Vĩnh Đức ngày càng đến gần"
  },
  {
    "idx": 4125,
    "start": "01:51:45,214",
    "end": "01:51:46,994",
    "start_sec": 6705.214,
    "end_sec": 6706.994,
    "zh": "橙子提心神越攻越紧",
    "vi": "Tinh thần của Thành ngày càng căng thẳng."
  },
  {
    "idx": 4126,
    "start": "01:51:51,334",
    "end": "01:51:54,234",
    "start_sec": 6711.334,
    "end_sec": 6714.234,
    "zh": "后车上没飞稿",
    "vi": "Trên chiếc xe phía sau không có pháp khí"
  },
  {
    "idx": 4127,
    "start": "01:51:54,234",
    "end": "01:51:54,994",
    "start_sec": 6714.234,
    "end_sec": 6714.994,
    "zh": "没香炉",
    "vi": "Không có lư hương."
  },
  {
    "idx": 4128,
    "start": "01:51:54,994",
    "end": "01:51:56,474",
    "start_sec": 6714.994,
    "end_sec": 6716.474,
    "zh": "沦陷的也太快了",
    "vi": "Bị thất thủ quá nhanh rồi."
  },
  {
    "idx": 4129,
    "start": "01:51:56,474",
    "end": "01:51:57,414",
    "start_sec": 6716.474,
    "end_sec": 6717.414,
    "zh": "伴随后车沦陷",
    "vi": "Cùng với việc chiếc xe phía sau thất thủ"
  },
  {
    "idx": 4130,
    "start": "01:51:57,414",
    "end": "01:51:58,434",
    "start_sec": 6717.414,
    "end_sec": 6718.434,
    "zh": "躺着疲倦的",
    "vi": "Áp lực trên người Thành"
  },
  {
    "idx": 4131,
    "start": "01:51:58,434",
    "end": "01:51:59,874",
    "start_sec": 6718.434,
    "end_sec": 6719.874,
    "zh": "身上压力也小了几分",
    "vi": "Cũng giảm đi vài phần."
  },
  {
    "idx": 4132,
    "start": "01:51:59,874",
    "end": "01:52:01,634",
    "start_sec": 6719.874,
    "end_sec": 6721.634,
    "zh": "然而仅仅是几分钟的工作",
    "vi": "Thế nhưng chỉ trong vòng vài phút"
  },
  {
    "idx": 4133,
    "start": "01:52:01,634",
    "end": "01:52:03,374",
    "start_sec": 6721.634,
    "end_sec": 6723.374,
    "zh": "那无形压力快速降低",
    "vi": "Áp lực vô hình đó tăng nhanh"
  },
  {
    "idx": 4134,
    "start": "01:52:03,374",
    "end": "01:52:04,694",
    "start_sec": 6723.374,
    "end_sec": 6724.694,
    "zh": "后排的小白脸",
    "vi": "Gã mặt trắng ở hàng ghế sau"
  },
  {
    "idx": 4135,
    "start": "01:52:04,694",
    "end": "01:52:05,894",
    "start_sec": 6724.694,
    "end_sec": 6725.894,
    "zh": "率先承受不住",
    "vi": "Là người đầu tiên không chịu nổi."
  },
  {
    "idx": 4136,
    "start": "01:52:05,894",
    "end": "01:52:07,094",
    "start_sec": 6725.894,
    "end_sec": 6727.094,
    "zh": "被一击压成血泥",
    "vi": "Bị đè bẹp dí thành vũng máu."
  },
  {
    "idx": 4137,
    "start": "01:52:07,094",
    "end": "01:52:10,194",
    "start_sec": 6727.094,
    "end_sec": 6730.194,
    "zh": "诚哥",
    "vi": "Anh Thành."
  },
  {
    "idx": 4138,
    "start": "01:52:10,194",
    "end": "01:52:10,894",
    "start_sec": 6730.194,
    "end_sec": 6730.894,
    "zh": "这是什么",
    "vi": "Đây là cái gì."
  },
  {
    "idx": 4139,
    "start": "01:52:10,894",
    "end": "01:52:11,354",
    "start_sec": 6730.894,
    "end_sec": 6731.354,
    "zh": "什么",
    "vi": "Cái gì."
  },
  {
    "idx": 4140,
    "start": "01:52:11,354",
    "end": "01:52:12,214",
    "start_sec": 6731.354,
    "end_sec": 6732.214,
    "zh": "我们掉头",
    "vi": "Chúng ta quay đầu lại đi."
  },
  {
    "idx": 4141,
    "start": "01:52:12,214",
    "end": "01:52:13,374",
    "start_sec": 6732.214,
    "end_sec": 6733.374,
    "zh": "掉头回去吧",
    "vi": "Quay đầu lại đi."
  },
  {
    "idx": 4142,
    "start": "01:52:13,374",
    "end": "01:52:13,914",
    "start_sec": 6733.374,
    "end_sec": 6733.914,
    "zh": "妈的",
    "vi": "Mẹ kiếp."
  },
  {
    "idx": 4143,
    "start": "01:52:13,914",
    "end": "01:52:14,614",
    "start_sec": 6733.914,
    "end_sec": 6734.614,
    "zh": "妈的",
    "vi": "Mẹ kiếp."
  },
  {
    "idx": 4144,
    "start": "01:52:14,614",
    "end": "01:52:15,294",
    "start_sec": 6734.614,
    "end_sec": 6735.294,
    "zh": "要死了",
    "vi": "Chết mất thôi."
  },
  {
    "idx": 4145,
    "start": "01:52:15,294",
    "end": "01:52:15,934",
    "start_sec": 6735.294,
    "end_sec": 6735.934,
    "zh": "快掉头",
    "vi": "Mau quay đầu lại."
  },
  {
    "idx": 4146,
    "start": "01:52:15,934",
    "end": "01:52:16,614",
    "start_sec": 6735.934,
    "end_sec": 6736.614,
    "zh": "快掉头",
    "vi": "Mau quay đầu lại."
  },
  {
    "idx": 4147,
    "start": "01:52:16,614",
    "end": "01:52:20,394",
    "start_sec": 6736.614,
    "end_sec": 6740.394,
    "zh": "罗剑已经被吓白了",
    "vi": "La Kiếm đã sợ đến mức mặt cắt không còn giọt máu."
  },
  {
    "idx": 4148,
    "start": "01:52:20,394",
    "end": "01:52:22,954",
    "start_sec": 6740.394,
    "end_sec": 6742.954,
    "zh": "快,不想死的话,把胡子甩了放下",
    "vi": "Mau lên, nếu không muốn chết thì vứt bộ râu đó xuống."
  },
  {
    "idx": 4149,
    "start": "01:52:22,954",
    "end": "01:52:25,694",
    "start_sec": 6742.954,
    "end_sec": 6745.694,
    "zh": "就现在,螺旋已经没有了思考的能力",
    "vi": "Ngay lúc này, La Kiếm đã không còn khả năng suy nghĩ."
  },
  {
    "idx": 4150,
    "start": "01:52:25,694",
    "end": "01:52:27,774",
    "start_sec": 6745.694,
    "end_sec": 6747.774,
    "zh": "掏出刀子,就是对着胡子一顿了",
    "vi": "Rút dao ra, cậu ta điên cuồng cắt bộ râu."
  },
  {
    "idx": 4151,
    "start": "01:52:27,774",
    "end": "01:52:35,934",
    "start_sec": 6747.774,
    "end_sec": 6755.934,
    "zh": "好,希望可以撑到永德寺",
    "vi": "Được rồi, hy vọng có thể chống đỡ được đến chùa Vĩnh Đức."
  },
  {
    "idx": 4152,
    "start": "01:52:35,934",
    "end": "01:52:39,954",
    "start_sec": 6755.934,
    "end_sec": 6759.954,
    "zh": "诚哥,我不要死,不要死",
    "vi": "Anh Thành, tôi không muốn chết, không muốn chết đâu."
  },
  {
    "idx": 4153,
    "start": "01:52:39,954",
    "end": "01:52:42,194",
    "start_sec": 6759.954,
    "end_sec": 6762.194,
    "zh": "我知道你有办法,你救我",
    "vi": "Tôi biết anh có cách mà, cứu tôi với."
  },
  {
    "idx": 4154,
    "start": "01:52:42,194",
    "end": "01:52:43,494",
    "start_sec": 6762.194,
    "end_sec": 6763.494,
    "zh": "救,救",
    "vi": "Cứu, cứu tôi."
  },
  {
    "idx": 4155,
    "start": "01:52:43,494",
    "end": "01:52:46,794",
    "start_sec": 6763.494,
    "end_sec": 6766.794,
    "zh": "卧槽,非要死我脸上",
    "vi": "Chết tiệt, cứ phải chết ngay trước mặt tôi sao."
  },
  {
    "idx": 4156,
    "start": "01:52:46,794",
    "end": "01:52:48,374",
    "start_sec": 6766.794,
    "end_sec": 6768.374,
    "zh": "这他妈掌风玻璃胡子都是",
    "vi": "Kính chắn gió chết tiệt này toàn là râu."
  },
  {
    "idx": 4157,
    "start": "01:52:48,374",
    "end": "01:52:52,851",
    "start_sec": 6768.374,
    "end_sec": 6772.851,
    "zh": "失去视野,车子开始剧烈摇晃,肠子皮极力控制着方向,随后,一股无形压力来到他身上,拐给个小磨叽,率先开始运行。",
    "vi": "Mất đi tầm nhìn, chiếc xe bắt đầu rung lắc dữ dội, Trần Tử Bì cố gắng hết sức kiểm soát vô lăng,"
  },
  {
    "idx": 4157,
    "start": "01:52:52,851",
    "end": "01:52:57,134",
    "start_sec": 6772.851,
    "end_sec": 6777.134,
    "zh": "失去视野,车子开始剧烈摇晃,肠子皮极力控制着方向,随后,一股无形压力来到他身上,拐给个小磨叽,率先开始运行。",
    "vi": "ngay sau đó, một áp lực vô hình đè nặng lên người cậu, một món đồ quỷ dị bắt đầu hoạt động."
  },
  {
    "idx": 4158,
    "start": "01:52:57,134",
    "end": "01:53:03,574",
    "start_sec": 6777.134,
    "end_sec": 6783.574,
    "zh": "又要重开了吗?肠子皮低着头,油门踩到脚下身上,他都已经不抱任何希望了。",
    "vi": "Lại phải chơi lại từ đầu sao. Trần Tử Bì cúi đầu, đạp mạnh chân ga, cậu đã không còn hy vọng gì nữa rồi."
  },
  {
    "idx": 4159,
    "start": "01:53:03,574",
    "end": "01:53:08,753",
    "start_sec": 6783.574,
    "end_sec": 6788.753,
    "zh": "眼包车被惯性通缉,猛然撞破远处的板子,眼看车子前方的身上撞的屁灵八字,这时,一个光头和尚抬起手,指晃。",
    "vi": "Chiếc xe van lao đi theo quán tính, tông sầm vào tấm ván phía xa, mắt thấy đầu xe sắp"
  },
  {
    "idx": 4159,
    "start": "01:53:08,753",
    "end": "01:53:13,414",
    "start_sec": 6788.753,
    "end_sec": 6793.414,
    "zh": "眼包车被惯性通缉,猛然撞破远处的板子,眼看车子前方的身上撞的屁灵八字,这时,一个光头和尚抬起手,指晃。",
    "vi": "đâm vào vách núi nát bét, đúng lúc này, một nhà sư đầu trọc giơ tay lên chỉ."
  },
  {
    "idx": 4160,
    "start": "01:53:13,414",
    "end": "01:53:16,914",
    "start_sec": 6793.414,
    "end_sec": 6796.914,
    "zh": "这是",
    "vi": "Đây là."
  },
  {
    "idx": 4161,
    "start": "01:53:16,914",
    "end": "01:53:17,814",
    "start_sec": 6796.914,
    "end_sec": 6797.814,
    "zh": "遇鬼者",
    "vi": "Ngự Quỷ Nhân."
  },
  {
    "idx": 4162,
    "start": "01:53:17,814",
    "end": "01:53:19,114",
    "start_sec": 6797.814,
    "end_sec": 6799.114,
    "zh": "耳晃",
    "vi": "Nhĩ Hoảng."
  },
  {
    "idx": 4163,
    "start": "01:53:19,114",
    "end": "01:53:21,454",
    "start_sec": 6799.114,
    "end_sec": 6801.454,
    "zh": "橙子皮缓缓擦起身体",
    "vi": "Trần Tử Bì chậm rãi đỡ người dậy."
  },
  {
    "idx": 4164,
    "start": "01:53:21,454",
    "end": "01:53:22,274",
    "start_sec": 6801.454,
    "end_sec": 6802.274,
    "zh": "打亮眼的时候",
    "vi": "Khi mở mắt ra nhìn."
  },
  {
    "idx": 4165,
    "start": "01:53:22,274",
    "end": "01:53:23,994",
    "start_sec": 6802.274,
    "end_sec": 6803.994,
    "zh": "几十平的寺庙围满了人",
    "vi": "Ngôi chùa rộng vài chục mét vuông đã chật kín người."
  },
  {
    "idx": 4166,
    "start": "01:53:23,994",
    "end": "01:53:24,934",
    "start_sec": 6803.994,
    "end_sec": 6804.934,
    "zh": "有胖的手的",
    "vi": "Có người béo người gầy."
  },
  {
    "idx": 4167,
    "start": "01:53:24,934",
    "end": "01:53:25,654",
    "start_sec": 6804.934,
    "end_sec": 6805.654,
    "zh": "老的小的",
    "vi": "Người già người trẻ."
  },
  {
    "idx": 4168,
    "start": "01:53:25,654",
    "end": "01:53:26,454",
    "start_sec": 6805.654,
    "end_sec": 6806.454,
    "zh": "穿西装的",
    "vi": "Người mặc vest."
  },
  {
    "idx": 4169,
    "start": "01:53:26,454",
    "end": "01:53:27,834",
    "start_sec": 6806.454,
    "end_sec": 6807.834,
    "zh": "甚至还有穿着睡衣的",
    "vi": "Thậm chí có cả người mặc đồ ngủ."
  },
  {
    "idx": 4170,
    "start": "01:53:27,834",
    "end": "01:53:29,594",
    "start_sec": 6807.834,
    "end_sec": 6809.594,
    "zh": "皆是差异的看着橙子皮",
    "vi": "Tất cả đều kinh ngạc nhìn Trần Tử Bì."
  },
  {
    "idx": 4171,
    "start": "01:53:29,594",
    "end": "01:53:31,894",
    "start_sec": 6809.594,
    "end_sec": 6811.894,
    "zh": "于是",
    "vi": "Thế rồi"
  },
  {
    "idx": 4172,
    "start": "01:53:31,894",
    "end": "01:53:32,794",
    "start_sec": 6811.894,
    "end_sec": 6812.794,
    "zh": "橙子皮",
    "vi": "Teng Zi Pi"
  },
  {
    "idx": 4173,
    "start": "01:53:32,794",
    "end": "01:53:33,694",
    "start_sec": 6812.794,
    "end_sec": 6813.694,
    "zh": "橙舌主",
    "vi": "Teng Zi Zhu"
  },
  {
    "idx": 4174,
    "start": "01:53:33,694",
    "end": "01:53:36,254",
    "start_sec": 6813.694,
    "end_sec": 6816.254,
    "zh": "看来这位只有一只手臂的老和尚",
    "vi": "Xem ra vị hòa thượng già chỉ có một cánh tay này"
  },
  {
    "idx": 4175,
    "start": "01:53:36,254",
    "end": "01:53:37,474",
    "start_sec": 6816.254,
    "end_sec": 6817.474,
    "zh": "就是柳和四的庙主",
    "vi": "chính là chủ trì của chùa Lưu Hòa Tứ"
  },
  {
    "idx": 4176,
    "start": "01:53:37,474",
    "end": "01:53:38,374",
    "start_sec": 6817.474,
    "end_sec": 6818.374,
    "zh": "一个月前的我",
    "vi": "Tôi của một tháng trước"
  },
  {
    "idx": 4177,
    "start": "01:53:38,374",
    "end": "01:53:39,694",
    "start_sec": 6818.374,
    "end_sec": 6819.694,
    "zh": "就是在他这里买的香炉",
    "vi": "chính là mua lư hương ở đây"
  },
  {
    "idx": 4178,
    "start": "01:53:39,694",
    "end": "01:53:40,754",
    "start_sec": 6819.694,
    "end_sec": 6820.754,
    "zh": "庙主先生",
    "vi": "Thưa ngài chủ trì"
  },
  {
    "idx": 4179,
    "start": "01:53:40,754",
    "end": "01:53:41,914",
    "start_sec": 6820.754,
    "end_sec": 6821.914,
    "zh": "好久不见",
    "vi": "Lâu rồi không gặp"
  },
  {
    "idx": 4180,
    "start": "01:53:41,914",
    "end": "01:53:43,154",
    "start_sec": 6821.914,
    "end_sec": 6823.154,
    "zh": "我没记错的话",
    "vi": "Nếu tôi nhớ không nhầm"
  },
  {
    "idx": 4181,
    "start": "01:53:43,154",
    "end": "01:53:45,414",
    "start_sec": 6823.154,
    "end_sec": 6825.414,
    "zh": "您好像是住林平小区的吧",
    "vi": "Ngài ở khu Lâm Bình phải không ạ"
  },
  {
    "idx": 4182,
    "start": "01:53:45,414",
    "end": "01:53:47,874",
    "start_sec": 6825.414,
    "end_sec": 6827.874,
    "zh": "那里离着可不近啊",
    "vi": "Chỗ đó cũng không gần đây đâu"
  },
  {
    "idx": 4183,
    "start": "01:53:47,874",
    "end": "01:53:48,934",
    "start_sec": 6827.874,
    "end_sec": 6828.934,
    "zh": "是我朋友和我说的",
    "vi": "Bạn tôi đã nói với tôi"
  },
  {
    "idx": 4184,
    "start": "01:53:48,934",
    "end": "01:53:49,774",
    "start_sec": 6828.934,
    "end_sec": 6829.774,
    "zh": "这里是特地点的",
    "vi": "Tôi đã cố tình đến đây"
  },
  {
    "idx": 4185,
    "start": "01:53:49,774",
    "end": "01:53:50,454",
    "start_sec": 6829.774,
    "end_sec": 6830.454,
    "zh": "你也认识",
    "vi": "Bạn cũng quen biết"
  },
  {
    "idx": 4186,
    "start": "01:53:50,454",
    "end": "01:53:51,474",
    "start_sec": 6830.454,
    "end_sec": 6831.474,
    "zh": "就是那个周阳吗",
    "vi": "Là cái tên Chu Dương đó sao"
  },
  {
    "idx": 4187,
    "start": "01:53:51,474",
    "end": "01:53:52,974",
    "start_sec": 6831.474,
    "end_sec": 6832.974,
    "zh": "喂",
    "vi": "Này"
  },
  {
    "idx": 4188,
    "start": "01:53:52,974",
    "end": "01:53:54,154",
    "start_sec": 6832.974,
    "end_sec": 6834.154,
    "zh": "我是真好奇啊",
    "vi": "Tôi thực sự tò mò"
  },
  {
    "idx": 4189,
    "start": "01:53:54,154",
    "end": "01:53:54,714",
    "start_sec": 6834.154,
    "end_sec": 6834.714,
    "zh": "你一个人",
    "vi": "Bạn một mình"
  },
  {
    "idx": 4190,
    "start": "01:53:54,714",
    "end": "01:53:55,934",
    "start_sec": 6834.714,
    "end_sec": 6835.934,
    "zh": "是怎么平安无事",
    "vi": "làm sao mà bình an vô sự"
  },
  {
    "idx": 4191,
    "start": "01:53:55,934",
    "end": "01:53:57,214",
    "start_sec": 6835.934,
    "end_sec": 6837.214,
    "zh": "来到这里的呢",
    "vi": "mà đến được đây vậy"
  },
  {
    "idx": 4192,
    "start": "01:53:57,214",
    "end": "01:53:58,014",
    "start_sec": 6837.214,
    "end_sec": 6838.014,
    "zh": "见到林三七",
    "vi": "Nhìn thấy Lâm Tam Thất"
  },
  {
    "idx": 4193,
    "start": "01:53:58,014",
    "end": "01:53:59,614",
    "start_sec": 6838.014,
    "end_sec": 6839.614,
    "zh": "藤子皮脸色微变",
    "vi": "Teng Zi Pi hơi biến sắc"
  },
  {
    "idx": 4194,
    "start": "01:53:59,614",
    "end": "01:54:00,374",
    "start_sec": 6839.614,
    "end_sec": 6840.374,
    "zh": "能进永德寺",
    "vi": "Có thể vào Vĩnh Đức Tự"
  },
  {
    "idx": 4195,
    "start": "01:54:00,374",
    "end": "01:54:01,334",
    "start_sec": 6840.374,
    "end_sec": 6841.334,
    "zh": "看来林三七",
    "vi": "Xem ra Lâm Tam Thất"
  },
  {
    "idx": 4196,
    "start": "01:54:01,334",
    "end": "01:54:02,174",
    "start_sec": 6841.334,
    "end_sec": 6842.174,
    "zh": "还是有点手段",
    "vi": "vẫn có chút bản lĩnh"
  },
  {
    "idx": 4197,
    "start": "01:54:02,174",
    "end": "01:54:04,334",
    "start_sec": 6842.174,
    "end_sec": 6844.334,
    "zh": "妙兔也在打量藤子皮",
    "vi": "Diệu Thố cũng đang quan sát Teng Zi Pi"
  },
  {
    "idx": 4198,
    "start": "01:54:04,334",
    "end": "01:54:05,674",
    "start_sec": 6844.334,
    "end_sec": 6845.674,
    "zh": "显然想细问些什么",
    "vi": "Rõ ràng là muốn hỏi kỹ điều gì đó"
  },
  {
    "idx": 4199,
    "start": "01:54:05,674",
    "end": "01:54:07,274",
    "start_sec": 6845.674,
    "end_sec": 6847.274,
    "zh": "藤子皮嘴角微颤",
    "vi": "Teng Zi Pi khẽ run khóe miệng"
  },
  {
    "idx": 4200,
    "start": "01:54:07,274",
    "end": "01:54:09,054",
    "start_sec": 6847.274,
    "end_sec": 6849.054,
    "zh": "想必林三七这个一回者",
    "vi": "Chắc hẳn Lâm Tam Thất người quay về này"
  },
  {
    "idx": 4201,
    "start": "01:54:09,054",
    "end": "01:54:09,914",
    "start_sec": 6849.054,
    "end_sec": 6849.914,
    "zh": "一路永德寺",
    "vi": "Đường đến chùa Vĩnh Đức."
  },
  {
    "idx": 4202,
    "start": "01:54:09,914",
    "end": "01:54:11,414",
    "start_sec": 6849.914,
    "end_sec": 6851.414,
    "zh": "也是付出了极端的代价",
    "vi": "Cũng phải trả giá cực kỳ đắt."
  },
  {
    "idx": 4203,
    "start": "01:54:11,414",
    "end": "01:54:12,874",
    "start_sec": 6851.414,
    "end_sec": 6852.874,
    "zh": "更何况他一个普通人",
    "vi": "Huống hồ cậu ta chỉ là người bình thường."
  },
  {
    "idx": 4204,
    "start": "01:54:12,874",
    "end": "01:54:14,514",
    "start_sec": 6852.874,
    "end_sec": 6854.514,
    "zh": "面对两名遇鬼者的质疑",
    "vi": "Đối mặt với sự nghi ngờ của hai người ngự quỷ."
  },
  {
    "idx": 4205,
    "start": "01:54:14,514",
    "end": "01:54:17,134",
    "start_sec": 6854.514,
    "end_sec": 6857.134,
    "zh": "随后橙子提步出一副委屈的模样",
    "vi": "Sau đó Trình Tử Bì tỏ ra vẻ mặt oan ức."
  },
  {
    "idx": 4206,
    "start": "01:54:17,134",
    "end": "01:54:17,474",
    "start_sec": 6857.134,
    "end_sec": 6857.474,
    "zh": "啊这",
    "vi": "À thì."
  },
  {
    "idx": 4207,
    "start": "01:54:17,474",
    "end": "01:54:19,454",
    "start_sec": 6857.474,
    "end_sec": 6859.454,
    "zh": "我确实是从一林平小区过来的",
    "vi": "Tôi đúng là từ khu dân cư Nhất Lâm Bình đến đây."
  },
  {
    "idx": 4208,
    "start": "01:54:19,454",
    "end": "01:54:20,394",
    "start_sec": 6859.454,
    "end_sec": 6860.394,
    "zh": "可悲啊",
    "vi": "Thật đáng buồn."
  },
  {
    "idx": 4209,
    "start": "01:54:20,394",
    "end": "01:54:21,434",
    "start_sec": 6860.394,
    "end_sec": 6861.434,
    "zh": "小区里有三只鬼",
    "vi": "Trong khu đó có ba con quỷ."
  },
  {
    "idx": 4210,
    "start": "01:54:21,434",
    "end": "01:54:22,554",
    "start_sec": 6861.434,
    "end_sec": 6862.554,
    "zh": "没剩几个活人了",
    "vi": "Chẳng còn lại mấy người sống sót."
  },
  {
    "idx": 4211,
    "start": "01:54:22,554",
    "end": "01:54:24,574",
    "start_sec": 6862.554,
    "end_sec": 6864.574,
    "zh": "我就跟他们说了永德寺的消息",
    "vi": "Tôi đã nói với họ về tin tức của chùa Vĩnh Đức."
  },
  {
    "idx": 4212,
    "start": "01:54:24,574",
    "end": "01:54:25,854",
    "start_sec": 6864.574,
    "end_sec": 6865.854,
    "zh": "问他们是在家等死",
    "vi": "Hỏi họ là muốn ở nhà chờ chết."
  },
  {
    "idx": 4213,
    "start": "01:54:25,854",
    "end": "01:54:27,354",
    "start_sec": 6865.854,
    "end_sec": 6867.354,
    "zh": "还是要来永德寺搏一搏",
    "vi": "Hay là đến chùa Vĩnh Đức để thử vận may."
  },
  {
    "idx": 4214,
    "start": "01:54:27,354",
    "end": "01:54:29,174",
    "start_sec": 6867.354,
    "end_sec": 6869.174,
    "zh": "说这有没有一行十几人赶来永德寺",
    "vi": "Thế là có hơn mười người cùng đến chùa Vĩnh Đức."
  },
  {
    "idx": 4215,
    "start": "01:54:29,174",
    "end": "01:54:30,274",
    "start_sec": 6869.174,
    "end_sec": 6870.274,
    "zh": "可我真的没想到",
    "vi": "Nhưng tôi thật sự không ngờ."
  },
  {
    "idx": 4216,
    "start": "01:54:30,274",
    "end": "01:54:31,534",
    "start_sec": 6870.274,
    "end_sec": 6871.534,
    "zh": "道路上居然不对劲",
    "vi": "Trên đường lại có chuyện bất thường."
  },
  {
    "idx": 4217,
    "start": "01:54:31,534",
    "end": "01:54:33,254",
    "start_sec": 6871.534,
    "end_sec": 6873.254,
    "zh": "两辆摩托车的人相继死亡",
    "vi": "Những người đi hai xe máy lần lượt tử vong."
  },
  {
    "idx": 4218,
    "start": "01:54:33,254",
    "end": "01:54:34,374",
    "start_sec": 6873.254,
    "end_sec": 6874.374,
    "zh": "我女朋友的身体",
    "vi": "Cơ thể bạn gái tôi."
  },
  {
    "idx": 4219,
    "start": "01:54:34,374",
    "end": "01:54:35,754",
    "start_sec": 6874.374,
    "end_sec": 6875.754,
    "zh": "居然凭空被击爆了",
    "vi": "Đột nhiên nổ tung giữa không trung."
  },
  {
    "idx": 4220,
    "start": "01:54:35,754",
    "end": "01:54:37,514",
    "start_sec": 6875.754,
    "end_sec": 6877.514,
    "zh": "我吓得直接一脚油门踩到底",
    "vi": "Tôi sợ quá nên đạp ga hết cỡ."
  },
  {
    "idx": 4221,
    "start": "01:54:37,514",
    "end": "01:54:39,514",
    "start_sec": 6877.514,
    "end_sec": 6879.514,
    "zh": "结果就有了刚才的一幕,",
    "vi": "Kết quả là xảy ra cảnh tượng vừa rồi."
  },
  {
    "idx": 4222,
    "start": "01:54:39,514",
    "end": "01:54:42,514",
    "start_sec": 6879.514,
    "end_sec": 6882.514,
    "zh": "长得皮说着一副劫后余生的样子。",
    "vi": "Trình Tử Bì nói với vẻ mặt như vừa thoát chết."
  },
  {
    "idx": 4223,
    "start": "01:54:42,514",
    "end": "01:54:43,514",
    "start_sec": 6882.514,
    "end_sec": 6883.514,
    "zh": "你小子倒是捧鱼,",
    "vi": "Cậu nhóc này cũng khôn khéo thật."
  },
  {
    "idx": 4224,
    "start": "01:54:43,514",
    "end": "01:54:46,514",
    "start_sec": 6883.514,
    "end_sec": 6886.514,
    "zh": "那些人全他妈给你挡栽了。",
    "vi": "Đám người đó đều chết thay cho cậu cả rồi."
  },
  {
    "idx": 4225,
    "start": "01:54:46,514",
    "end": "01:54:47,514",
    "start_sec": 6886.514,
    "end_sec": 6887.514,
    "zh": "蜂蜜投火,",
    "vi": "Thật là khổ cho cậu rồi."
  },
  {
    "idx": 4226,
    "start": "01:54:47,514",
    "end": "01:54:48,514",
    "start_sec": 6887.514,
    "end_sec": 6888.514,
    "zh": "程师祖受苦了。",
    "vi": "Trình thí chủ đã chịu khổ rồi."
  },
  {
    "idx": 4227,
    "start": "01:54:48,514",
    "end": "01:54:51,514",
    "start_sec": 6888.514,
    "end_sec": 6891.514,
    "zh": "老庙主一脸慈悲的安慰着程子皮,",
    "vi": "Lão miếu chủ từ bi an ủi Trình Tử Bì."
  },
  {
    "idx": 4228,
    "start": "01:54:51,514",
    "end": "01:54:53,514",
    "start_sec": 6891.514,
    "end_sec": 6893.514,
    "zh": "程师祖既然来了,",
    "vi": "Trình thí chủ đã đến đây rồi."
  },
  {
    "idx": 4229,
    "start": "01:54:53,514",
    "end": "01:54:54,514",
    "start_sec": 6893.514,
    "end_sec": 6894.514,
    "zh": "就随我们一起吧。",
    "vi": "Thì hãy đi cùng chúng tôi đi."
  },
  {
    "idx": 4230,
    "start": "01:54:54,514",
    "end": "01:55:00,710",
    "start_sec": 6894.514,
    "end_sec": 6900.71,
    "zh": "我和这位男慈先生,将带领所有人一起朝着临江市外撤离麻烦庙主随后老庙主和林三七走进殿堂里林三七叫男子",
    "vi": "Tôi và vị tiên sinh này sẽ dẫn mọi người cùng rút lui khỏi thành phố Lâm Giang, làm phiền miếu"
  },
  {
    "idx": 4230,
    "start": "01:55:00,710",
    "end": "01:55:06,611",
    "start_sec": 6900.71,
    "end_sec": 6906.611,
    "zh": "我和这位男慈先生,将带领所有人一起朝着临江市外撤离麻烦庙主随后老庙主和林三七走进殿堂里林三七叫男子",
    "vi": "chủ, sau đó lão miếu chủ và Lâm Tam Thất bước vào điện, Lâm Tam Thất gọi người đàn ông."
  },
  {
    "idx": 4231,
    "start": "01:55:06,611",
    "end": "01:55:08,471",
    "start_sec": 6906.611,
    "end_sec": 6908.471,
    "zh": "他们好像都是御鬼者",
    "vi": "Họ hình như đều là ngự quỷ giả."
  },
  {
    "idx": 4232,
    "start": "01:55:08,471",
    "end": "01:55:10,171",
    "start_sec": 6908.471,
    "end_sec": 6910.171,
    "zh": "应该在鬼医上前都认识了吧",
    "vi": "Chắc là đã quen biết nhau từ trước khi quỷ y xuất hiện."
  },
  {
    "idx": 4233,
    "start": "01:55:10,171",
    "end": "01:55:11,951",
    "start_sec": 6910.171,
    "end_sec": 6911.951,
    "zh": "总感觉哪里有些不对劲",
    "vi": "Nhưng cứ cảm thấy có gì đó không đúng."
  },
  {
    "idx": 4234,
    "start": "01:55:11,951",
    "end": "01:55:17,691",
    "start_sec": 6911.951,
    "end_sec": 6917.691,
    "zh": "长者提寻的阵",
    "vi": "Trình Tử Bì tìm một chỗ."
  },
  {
    "idx": 4235,
    "start": "01:55:17,691",
    "end": "01:55:19,671",
    "start_sec": 6917.691,
    "end_sec": 6919.671,
    "zh": "坐到寺庙的一处角落里",
    "vi": "Ngồi xuống một góc trong ngôi miếu."
  },
  {
    "idx": 4236,
    "start": "01:55:19,671",
    "end": "01:55:23,631",
    "start_sec": 6919.671,
    "end_sec": 6923.631,
    "zh": "殿堂里用红布盖起来的佛像是什么",
    "vi": "Bức tượng Phật được che bằng vải đỏ trong điện thờ là gì thế."
  },
  {
    "idx": 4237,
    "start": "01:55:23,631",
    "end": "01:55:24,991",
    "start_sec": 6923.631,
    "end_sec": 6924.991,
    "zh": "四外诡异那么强",
    "vi": "Sự kiện quỷ dị bên ngoài mạnh như thế."
  },
  {
    "idx": 4238,
    "start": "01:55:24,991",
    "end": "01:55:25,751",
    "start_sec": 6924.991,
    "end_sec": 6925.751,
    "zh": "人在佛像",
    "vi": "Mà bức tượng Phật này."
  },
  {
    "idx": 4239,
    "start": "01:55:25,751",
    "end": "01:55:27,091",
    "start_sec": 6925.751,
    "end_sec": 6927.091,
    "zh": "竟然能保佑四里之恩",
    "vi": "Lại có thể bảo vệ bình an cho vùng đất bốn dặm xung quanh."
  },
  {
    "idx": 4240,
    "start": "01:55:27,091",
    "end": "01:55:28,511",
    "start_sec": 6927.091,
    "end_sec": 6928.511,
    "zh": "干嘛用红布盖着呢",
    "vi": "Tại sao lại phải dùng vải đỏ che lại chứ."
  },
  {
    "idx": 4241,
    "start": "01:55:28,511",
    "end": "01:55:29,731",
    "start_sec": 6928.511,
    "end_sec": 6929.731,
    "zh": "为什么偌大的林江市",
    "vi": "Tại sao thành phố Lâm Giang rộng lớn như vậy."
  },
  {
    "idx": 4242,
    "start": "01:55:29,731",
    "end": "01:55:30,831",
    "start_sec": 6929.731,
    "end_sec": 6930.831,
    "zh": "其他寺庙都没用",
    "vi": "Các ngôi miếu khác đều không có tác dụng."
  },
  {
    "idx": 4243,
    "start": "01:55:30,831",
    "end": "01:55:32,231",
    "start_sec": 6930.831,
    "end_sec": 6932.231,
    "zh": "唯独这里可以避灾呢",
    "vi": "Mà chỉ có nơi này là tránh được tai họa chứ."
  },
  {
    "idx": 4244,
    "start": "01:55:32,231",
    "end": "01:55:33,731",
    "start_sec": 6932.231,
    "end_sec": 6933.731,
    "zh": "长子一想找人问话",
    "vi": "Trình Tử Bì muốn tìm người hỏi chuyện."
  },
  {
    "idx": 4245,
    "start": "01:55:33,731",
    "end": "01:55:34,551",
    "start_sec": 6933.731,
    "end_sec": 6934.551,
    "zh": "套套近乎",
    "vi": "Để bắt chuyện làm quen."
  },
  {
    "idx": 4246,
    "start": "01:55:34,551",
    "end": "01:55:35,391",
    "start_sec": 6934.551,
    "end_sec": 6935.391,
    "zh": "但一眼看见",
    "vi": "Nhưng vừa nhìn qua."
  },
  {
    "idx": 4247,
    "start": "01:55:35,391",
    "end": "01:55:37,311",
    "start_sec": 6935.391,
    "end_sec": 6937.311,
    "zh": "几乎所有人都盘走在里面",
    "vi": "Hầu như tất cả mọi người đều đang ngồi xếp bằng bên trong."
  },
  {
    "idx": 4248,
    "start": "01:55:37,311",
    "end": "01:55:38,551",
    "start_sec": 6937.311,
    "end_sec": 6938.551,
    "zh": "虔诚地盼向佛像",
    "vi": "Thành kính hướng về phía tượng Phật."
  },
  {
    "idx": 4249,
    "start": "01:55:38,551",
    "end": "01:55:39,891",
    "start_sec": 6938.551,
    "end_sec": 6939.891,
    "zh": "看他们的样子",
    "vi": "Nhìn dáng vẻ của họ."
  },
  {
    "idx": 4250,
    "start": "01:55:39,891",
    "end": "01:55:41,671",
    "start_sec": 6939.891,
    "end_sec": 6941.671,
    "zh": "估计连说话的心情都没有",
    "vi": "Ước chừng ngay cả tâm trạng nói chuyện cũng không có."
  },
  {
    "idx": 4251,
    "start": "01:55:41,671",
    "end": "01:55:42,391",
    "start_sec": 6941.671,
    "end_sec": 6942.391,
    "zh": "是大把",
    "vi": "Thôi bỏ đi."
  },
  {
    "idx": 4252,
    "start": "01:55:42,391",
    "end": "01:55:44,071",
    "start_sec": 6942.391,
    "end_sec": 6944.071,
    "zh": "人满为患的寺庙里",
    "vi": "Trong ngôi miếu chật kín người."
  },
  {
    "idx": 4253,
    "start": "01:55:44,071",
    "end": "01:55:44,911",
    "start_sec": 6944.071,
    "end_sec": 6944.911,
    "zh": "安静的可怕",
    "vi": "Lại yên tĩnh đến đáng sợ."
  },
  {
    "idx": 4254,
    "start": "01:55:44,911",
    "end": "01:55:45,811",
    "start_sec": 6944.911,
    "end_sec": 6945.811,
    "zh": "不知不觉间",
    "vi": "Trong lúc vô tri vô giác."
  },
  {
    "idx": 4255,
    "start": "01:55:45,811",
    "end": "01:55:47,151",
    "start_sec": 6945.811,
    "end_sec": 6947.151,
    "zh": "长子皮沉沉实现",
    "vi": "Trình Tử Bì đã chìm vào giấc ngủ sâu."
  },
  {
    "idx": 4256,
    "start": "01:55:47,151",
    "end": "01:55:49,591",
    "start_sec": 6947.151,
    "end_sec": 6949.591,
    "zh": "阿弥陀佛",
    "vi": "A Di Đà Phật."
  },
  {
    "idx": 4257,
    "start": "01:55:49,591",
    "end": "01:55:50,211",
    "start_sec": 6949.591,
    "end_sec": 6950.211,
    "zh": "诸位",
    "vi": "Các vị."
  },
  {
    "idx": 4258,
    "start": "01:55:50,211",
    "end": "01:55:51,191",
    "start_sec": 6950.211,
    "end_sec": 6951.191,
    "zh": "特殊时期",
    "vi": "Thời kỳ đặc biệt."
  },
  {
    "idx": 4259,
    "start": "01:55:51,191",
    "end": "01:55:52,131",
    "start_sec": 6951.191,
    "end_sec": 6952.131,
    "zh": "特殊对待",
    "vi": "Đành phải đơn giản hóa mọi chuyện."
  },
  {
    "idx": 4260,
    "start": "01:55:52,131",
    "end": "01:55:53,471",
    "start_sec": 6952.131,
    "end_sec": 6953.471,
    "zh": "简单吃些食物",
    "vi": "Mọi người hãy ăn tạm chút thức ăn đi."
  },
  {
    "idx": 4261,
    "start": "01:55:53,471",
    "end": "01:55:54,571",
    "start_sec": 6953.471,
    "end_sec": 6954.571,
    "zh": "便坐下休息吧",
    "vi": "Vậy thì ngồi xuống nghỉ ngơi đi."
  },
  {
    "idx": 4262,
    "start": "01:55:54,571",
    "end": "01:55:55,411",
    "start_sec": 6954.571,
    "end_sec": 6955.411,
    "zh": "明天清晨",
    "vi": "Sáng sớm ngày mai,"
  },
  {
    "idx": 4263,
    "start": "01:55:55,411",
    "end": "01:55:57,471",
    "start_sec": 6955.411,
    "end_sec": 6957.471,
    "zh": "我们就将离去临江市里",
    "vi": "chúng ta sẽ rời khỏi thành phố Lâm Giang."
  },
  {
    "idx": 4264,
    "start": "01:55:57,471",
    "end": "01:56:00,651",
    "start_sec": 6957.471,
    "end_sec": 6960.651,
    "zh": "所有人都有条不紊的去拿极少的食物",
    "vi": "Mọi người đều có trật tự đi lấy một ít thức ăn."
  },
  {
    "idx": 4265,
    "start": "01:56:00,651",
    "end": "01:56:01,871",
    "start_sec": 6960.651,
    "end_sec": 6961.871,
    "zh": "唯独橙子皮没有去",
    "vi": "Chỉ có Thang Tử Bì là không đi."
  },
  {
    "idx": 4266,
    "start": "01:56:01,871",
    "end": "01:56:03,391",
    "start_sec": 6961.871,
    "end_sec": 6963.391,
    "zh": "他临行前还带着背包",
    "vi": "Trước khi đi, anh ta còn mang theo ba lô."
  },
  {
    "idx": 4267,
    "start": "01:56:03,391",
    "end": "01:56:04,891",
    "start_sec": 6963.391,
    "end_sec": 6964.891,
    "zh": "包里有几件的口粮",
    "vi": "Trong ba lô có vài phần thức ăn."
  },
  {
    "idx": 4268,
    "start": "01:56:04,891",
    "end": "01:56:07,631",
    "start_sec": 6964.891,
    "end_sec": 6967.631,
    "zh": "油香的气味",
    "vi": "Mùi thơm lừng"
  },
  {
    "idx": 4269,
    "start": "01:56:07,631",
    "end": "01:56:09,471",
    "start_sec": 6967.631,
    "end_sec": 6969.471,
    "zh": "瞬间吸引了不少人看过来",
    "vi": "lập tức thu hút không ít người nhìn tới."
  },
  {
    "idx": 4270,
    "start": "01:56:09,471",
    "end": "01:56:10,791",
    "start_sec": 6969.471,
    "end_sec": 6970.791,
    "zh": "包括庙主和林三星",
    "vi": "Bao gồm cả chủ chùa và Lâm Tam Tinh."
  },
  {
    "idx": 4271,
    "start": "01:56:10,791",
    "end": "01:56:12,051",
    "start_sec": 6970.791,
    "end_sec": 6972.051,
    "zh": "没以为他们会过来抢",
    "vi": "Tôi không nghĩ họ sẽ tới cướp."
  },
  {
    "idx": 4272,
    "start": "01:56:12,051",
    "end": "01:56:13,331",
    "start_sec": 6972.051,
    "end_sec": 6973.331,
    "zh": "但他们脸上除了羡慕",
    "vi": "Nhưng trên mặt họ, ngoài sự ngưỡng mộ,"
  },
  {
    "idx": 4273,
    "start": "01:56:13,331",
    "end": "01:56:14,271",
    "start_sec": 6973.331,
    "end_sec": 6974.271,
    "zh": "就没其他动作",
    "vi": "không có hành động nào khác."
  },
  {
    "idx": 4274,
    "start": "01:56:14,271",
    "end": "01:56:15,251",
    "start_sec": 6974.271,
    "end_sec": 6975.251,
    "zh": "在这个寺庙里面",
    "vi": "Trong ngôi chùa này,"
  },
  {
    "idx": 4275,
    "start": "01:56:15,251",
    "end": "01:56:16,611",
    "start_sec": 6975.251,
    "end_sec": 6976.611,
    "zh": "好像所有事情都很奇怪",
    "vi": "dường như mọi thứ đều rất kỳ lạ."
  },
  {
    "idx": 4276,
    "start": "01:56:16,611",
    "end": "01:56:17,451",
    "start_sec": 6976.611,
    "end_sec": 6977.451,
    "zh": "突然",
    "vi": "Đột nhiên,"
  },
  {
    "idx": 4277,
    "start": "01:56:17,451",
    "end": "01:56:19,551",
    "start_sec": 6977.451,
    "end_sec": 6979.551,
    "zh": "一个胖子戳了戳橙子皮后背",
    "vi": "một gã béo chọc vào lưng Thang Tử Bì."
  },
  {
    "idx": 4278,
    "start": "01:56:19,551",
    "end": "01:56:20,071",
    "start_sec": 6979.551,
    "end_sec": 6980.071,
    "zh": "哥们",
    "vi": "Này anh bạn,"
  },
  {
    "idx": 4279,
    "start": "01:56:20,071",
    "end": "01:56:22,071",
    "start_sec": 6980.071,
    "end_sec": 6982.071,
    "zh": "我知道你刚刚死了女朋友",
    "vi": "tôi biết bạn vừa mới mất bạn gái."
  },
  {
    "idx": 4280,
    "start": "01:56:22,071",
    "end": "01:56:23,651",
    "start_sec": 6982.071,
    "end_sec": 6983.651,
    "zh": "可能心情不太好",
    "vi": "Có lẽ tâm trạng không tốt."
  },
  {
    "idx": 4281,
    "start": "01:56:23,651",
    "end": "01:56:24,611",
    "start_sec": 6983.651,
    "end_sec": 6984.611,
    "zh": "节哀啊",
    "vi": "Xin chia buồn."
  },
  {
    "idx": 4282,
    "start": "01:56:24,611",
    "end": "01:56:24,971",
    "start_sec": 6984.611,
    "end_sec": 6984.971,
    "zh": "那个",
    "vi": "Cái đó,"
  },
  {
    "idx": 4283,
    "start": "01:56:24,971",
    "end": "01:56:25,751",
    "start_sec": 6984.971,
    "end_sec": 6985.751,
    "zh": "那个",
    "vi": "cái đó,"
  },
  {
    "idx": 4284,
    "start": "01:56:25,751",
    "end": "01:56:26,911",
    "start_sec": 6985.751,
    "end_sec": 6986.911,
    "zh": "寺庙里给的",
    "vi": "thức ăn chùa cho"
  },
  {
    "idx": 4285,
    "start": "01:56:26,911",
    "end": "01:56:27,831",
    "start_sec": 6986.911,
    "end_sec": 6987.831,
    "zh": "吃的不管饱",
    "vi": "không đủ no."
  },
  {
    "idx": 4286,
    "start": "01:56:27,831",
    "end": "01:56:29,231",
    "start_sec": 6987.831,
    "end_sec": 6989.231,
    "zh": "晚上还要献血",
    "vi": "Buổi tối còn phải hiến máu."
  },
  {
    "idx": 4287,
    "start": "01:56:29,231",
    "end": "01:56:30,211",
    "start_sec": 6989.231,
    "end_sec": 6990.211,
    "zh": "我这大体责",
    "vi": "Tôi đây sức yếu,"
  },
  {
    "idx": 4288,
    "start": "01:56:30,211",
    "end": "01:56:31,311",
    "start_sec": 6990.211,
    "end_sec": 6991.311,
    "zh": "实在扛不住",
    "vi": "thật sự không chịu nổi."
  },
  {
    "idx": 4289,
    "start": "01:56:31,311",
    "end": "01:56:31,771",
    "start_sec": 6991.311,
    "end_sec": 6991.771,
    "zh": "哥们",
    "vi": "Anh bạn,"
  },
  {
    "idx": 4290,
    "start": "01:56:31,771",
    "end": "01:56:33,311",
    "start_sec": 6991.771,
    "end_sec": 6993.311,
    "zh": "你能分我点吃的吗",
    "vi": "bạn có thể chia cho tôi ít đồ ăn không."
  },
  {
    "idx": 4291,
    "start": "01:56:33,311",
    "end": "01:56:34,571",
    "start_sec": 6993.311,
    "end_sec": 6994.571,
    "zh": "谢谢",
    "vi": "Cảm ơn bạn."
  },
  {
    "idx": 4292,
    "start": "01:56:34,571",
    "end": "01:56:35,611",
    "start_sec": 6994.571,
    "end_sec": 6995.611,
    "zh": "谢什么谢",
    "vi": "Cảm ơn cái gì chứ."
  },
  {
    "idx": 4293,
    "start": "01:56:35,611",
    "end": "01:56:36,771",
    "start_sec": 6995.611,
    "end_sec": 6996.771,
    "zh": "你是新来的",
    "vi": "Bạn là người mới đến."
  },
  {
    "idx": 4294,
    "start": "01:56:36,771",
    "end": "01:56:37,811",
    "start_sec": 6996.771,
    "end_sec": 6997.811,
    "zh": "是不知道吧",
    "vi": "Chắc là chưa biết gì rồi."
  },
  {
    "idx": 4295,
    "start": "01:56:37,811",
    "end": "01:56:38,791",
    "start_sec": 6997.811,
    "end_sec": 6998.791,
    "zh": "庙主人很好",
    "vi": "Chủ ngôi miếu này rất tốt."
  },
  {
    "idx": 4296,
    "start": "01:56:38,791",
    "end": "01:56:40,891",
    "start_sec": 6998.791,
    "end_sec": 7000.891,
    "zh": "将所有食物都控制起来",
    "vi": "Ông ấy kiểm soát toàn bộ lương thực."
  },
  {
    "idx": 4297,
    "start": "01:56:40,891",
    "end": "01:56:42,811",
    "start_sec": 7000.891,
    "end_sec": 7002.811,
    "zh": "保证大家每天能吃上一顿",
    "vi": "Để đảm bảo mỗi ngày mọi người đều được ăn một bữa."
  },
  {
    "idx": 4298,
    "start": "01:56:42,811",
    "end": "01:56:43,551",
    "start_sec": 7002.811,
    "end_sec": 7003.551,
    "zh": "吃完后",
    "vi": "Sau khi ăn xong."
  },
  {
    "idx": 4299,
    "start": "01:56:43,551",
    "end": "01:56:45,051",
    "start_sec": 7003.551,
    "end_sec": 7005.051,
    "zh": "大家一般都是打坐",
    "vi": "Mọi người thường ngồi thiền."
  },
  {
    "idx": 4300,
    "start": "01:56:45,051",
    "end": "01:56:46,651",
    "start_sec": 7005.051,
    "end_sec": 7006.651,
    "zh": "然后等晚上的祈祷",
    "vi": "Rồi chờ đến buổi cầu nguyện tối."
  },
  {
    "idx": 4301,
    "start": "01:56:46,651",
    "end": "01:56:47,331",
    "start_sec": 7006.651,
    "end_sec": 7007.331,
    "zh": "祈祷",
    "vi": "Cầu nguyện."
  },
  {
    "idx": 4302,
    "start": "01:56:47,331",
    "end": "01:56:48,471",
    "start_sec": 7007.331,
    "end_sec": 7008.471,
    "zh": "祈祷什么",
    "vi": "Cầu nguyện cái gì."
  },
  {
    "idx": 4303,
    "start": "01:56:48,471",
    "end": "01:56:50,271",
    "start_sec": 7008.471,
    "end_sec": 7010.271,
    "zh": "就感谢神明之类的",
    "vi": "Chỉ là cảm tạ thần linh các thứ thôi."
  },
  {
    "idx": 4304,
    "start": "01:56:50,271",
    "end": "01:56:52,451",
    "start_sec": 7010.271,
    "end_sec": 7012.451,
    "zh": "这和信息有什么关系吗",
    "vi": "Việc này có liên quan gì đến thông tin không."
  },
  {
    "idx": 4305,
    "start": "01:56:52,451",
    "end": "01:56:53,851",
    "start_sec": 7012.451,
    "end_sec": 7013.851,
    "zh": "其实我也不太懂",
    "vi": "Thật ra tôi cũng không rõ lắm."
  },
  {
    "idx": 4306,
    "start": "01:56:53,851",
    "end": "01:56:55,071",
    "start_sec": 7013.851,
    "end_sec": 7015.071,
    "zh": "就每天晚上",
    "vi": "Chỉ là mỗi tối."
  },
  {
    "idx": 4307,
    "start": "01:56:55,071",
    "end": "01:56:57,751",
    "start_sec": 7015.071,
    "end_sec": 7017.751,
    "zh": "所有人都要用银针挑破宗旨写",
    "vi": "Mọi người đều phải dùng kim bạc chích vào đầu ngón tay."
  },
  {
    "idx": 4308,
    "start": "01:56:57,751",
    "end": "01:56:59,751",
    "start_sec": 7017.751,
    "end_sec": 7019.751,
    "zh": "一记神像前的清水丸里",
    "vi": "Nhỏ một giọt vào bát nước sạch trước tượng thần."
  },
  {
    "idx": 4309,
    "start": "01:56:59,751",
    "end": "01:57:00,731",
    "start_sec": 7019.751,
    "end_sec": 7020.731,
    "zh": "也不用多",
    "vi": "Cũng không cần nhiều."
  },
  {
    "idx": 4310,
    "start": "01:57:00,731",
    "end": "01:57:01,711",
    "start_sec": 7020.731,
    "end_sec": 7021.711,
    "zh": "一记就好",
    "vi": "Một giọt là đủ rồi."
  },
  {
    "idx": 4311,
    "start": "01:57:01,711",
    "end": "01:57:02,391",
    "start_sec": 7021.711,
    "end_sec": 7022.391,
    "zh": "妙主说",
    "vi": "Chủ miếu nói."
  },
  {
    "idx": 4312,
    "start": "01:57:02,391",
    "end": "01:57:04,131",
    "start_sec": 7022.391,
    "end_sec": 7024.131,
    "zh": "这是为了感谢神明大人",
    "vi": "Đây là để cảm tạ thần linh đại nhân."
  },
  {
    "idx": 4313,
    "start": "01:57:04,131",
    "end": "01:57:04,931",
    "start_sec": 7024.131,
    "end_sec": 7024.931,
    "zh": "保护我们",
    "vi": "Đã bảo vệ chúng ta."
  },
  {
    "idx": 4314,
    "start": "01:57:04,931",
    "end": "01:57:05,671",
    "start_sec": 7024.931,
    "end_sec": 7025.671,
    "zh": "敬重他",
    "vi": "Kính trọng ông ấy."
  },
  {
    "idx": 4315,
    "start": "01:57:05,671",
    "end": "01:57:08,231",
    "start_sec": 7025.671,
    "end_sec": 7028.231,
    "zh": "我看你们好像很敬重这里啊",
    "vi": "Tôi thấy các bạn có vẻ rất kính trọng nơi này nhỉ."
  },
  {
    "idx": 4316,
    "start": "01:57:08,231",
    "end": "01:57:09,011",
    "start_sec": 7028.231,
    "end_sec": 7029.011,
    "zh": "炕子闻眼后",
    "vi": "Sau khi nghe xong."
  },
  {
    "idx": 4317,
    "start": "01:57:09,011",
    "end": "01:57:11,031",
    "start_sec": 7029.011,
    "end_sec": 7031.031,
    "zh": "小声唾到城子的身边",
    "vi": "Người đó ghé sát vào tai Thành Tử nói nhỏ."
  },
  {
    "idx": 4318,
    "start": "01:57:11,031",
    "end": "01:57:11,631",
    "start_sec": 7031.031,
    "end_sec": 7031.631,
    "zh": "知不知道",
    "vi": "Bạn có biết không."
  },
  {
    "idx": 4319,
    "start": "01:57:11,631",
    "end": "01:57:12,551",
    "start_sec": 7031.631,
    "end_sec": 7032.551,
    "zh": "在这之前",
    "vi": "Trước đây."
  },
  {
    "idx": 4320,
    "start": "01:57:12,551",
    "end": "01:57:14,691",
    "start_sec": 7032.551,
    "end_sec": 7034.691,
    "zh": "有个刺头曾经闯进来过",
    "vi": "Từng có một kẻ cứng đầu xông vào đây rồi."
  },
  {
    "idx": 4321,
    "start": "01:57:14,691",
    "end": "01:57:15,751",
    "start_sec": 7034.691,
    "end_sec": 7035.751,
    "zh": "对神像不敬",
    "vi": "Không tôn kính tượng thần"
  },
  {
    "idx": 4322,
    "start": "01:57:15,751",
    "end": "01:57:17,811",
    "start_sec": 7035.751,
    "end_sec": 7037.811,
    "zh": "企图拉开神像上的红布",
    "vi": "Định kéo tấm vải đỏ trên tượng thần"
  },
  {
    "idx": 4323,
    "start": "01:57:17,811",
    "end": "01:57:20,591",
    "start_sec": 7037.811,
    "end_sec": 7040.591,
    "zh": "结果就被庙主大人变成纸人了",
    "vi": "Kết quả bị chủ miếu biến thành người giấy"
  },
  {
    "idx": 4324,
    "start": "01:57:20,591",
    "end": "01:57:24,511",
    "start_sec": 7040.591,
    "end_sec": 7044.511,
    "zh": "话说庙主会出庙救人吗",
    "vi": "Nói chủ miếu có ra khỏi miếu cứu người không"
  },
  {
    "idx": 4325,
    "start": "01:57:24,511",
    "end": "01:57:25,291",
    "start_sec": 7044.511,
    "end_sec": 7045.291,
    "zh": "之前救的",
    "vi": "Lần trước cứu"
  },
  {
    "idx": 4326,
    "start": "01:57:25,291",
    "end": "01:57:26,851",
    "start_sec": 7045.291,
    "end_sec": 7046.851,
    "zh": "不过救了一百个人后",
    "vi": "Nhưng sau khi cứu trăm người"
  },
  {
    "idx": 4327,
    "start": "01:57:26,851",
    "end": "01:57:28,331",
    "start_sec": 7046.851,
    "end_sec": 7048.331,
    "zh": "他就没有再出去过",
    "vi": "Ông ta không ra ngoài nữa"
  },
  {
    "idx": 4328,
    "start": "01:57:28,331",
    "end": "01:57:30,131",
    "start_sec": 7048.331,
    "end_sec": 7050.131,
    "zh": "说组织准备离开了",
    "vi": "Nói tổ chức chuẩn bị rời đi"
  },
  {
    "idx": 4329,
    "start": "01:57:30,131",
    "end": "01:57:31,671",
    "start_sec": 7050.131,
    "end_sec": 7051.671,
    "zh": "和胖子说了几句后",
    "vi": "Nói vài câu với gã béo"
  },
  {
    "idx": 4330,
    "start": "01:57:31,671",
    "end": "01:57:33,111",
    "start_sec": 7051.671,
    "end_sec": 7053.111,
    "zh": "橙子皮也没再说话",
    "vi": "Trần Tử Bì cũng không nói gì nữa"
  },
  {
    "idx": 4331,
    "start": "01:57:33,111",
    "end": "01:57:34,031",
    "start_sec": 7053.111,
    "end_sec": 7054.031,
    "zh": "一直到下午",
    "vi": "Cho đến chiều"
  },
  {
    "idx": 4332,
    "start": "01:57:34,031",
    "end": "01:57:35,531",
    "start_sec": 7054.031,
    "end_sec": 7055.531,
    "zh": "手机收到一条消息",
    "vi": "Điện thoại nhận được một tin nhắn"
  },
  {
    "idx": 4333,
    "start": "01:57:35,531",
    "end": "01:57:37,531",
    "start_sec": 7055.531,
    "end_sec": 7057.531,
    "zh": "再码",
    "vi": "Lại gõ chữ"
  },
  {
    "idx": 4334,
    "start": "01:57:37,531",
    "end": "01:57:39,471",
    "start_sec": 7057.531,
    "end_sec": 7059.471,
    "zh": "我还真查到一些关于永德寺的消息",
    "vi": "Tôi thật sự tra được vài tin về Vĩnh Đức Tự"
  },
  {
    "idx": 4335,
    "start": "01:57:39,471",
    "end": "01:57:39,971",
    "start_sec": 7059.471,
    "end_sec": 7059.971,
    "zh": "什么",
    "vi": "Gì cơ"
  },
  {
    "idx": 4336,
    "start": "01:57:39,971",
    "end": "01:57:41,431",
    "start_sec": 7059.971,
    "end_sec": 7061.431,
    "zh": "永德寺的庙主换人",
    "vi": "Chủ miếu Vĩnh Đức Tự đổi người"
  },
  {
    "idx": 4337,
    "start": "01:57:41,431",
    "end": "01:57:42,891",
    "start_sec": 7061.431,
    "end_sec": 7062.891,
    "zh": "之前就是个小土地庙",
    "vi": "Trước đây chỉ là một miếu Thổ Địa nhỏ"
  },
  {
    "idx": 4338,
    "start": "01:57:42,891",
    "end": "01:57:43,971",
    "start_sec": 7062.891,
    "end_sec": 7063.971,
    "zh": "新人庙主过来后",
    "vi": "Sau khi chủ miếu mới đến"
  },
  {
    "idx": 4339,
    "start": "01:57:43,971",
    "end": "01:57:46,151",
    "start_sec": 7063.971,
    "end_sec": 7066.151,
    "zh": "上面配合他将土地庙的佛像撤除",
    "vi": "Cấp trên phối hợp với ông ta dỡ bỏ tượng Phật của miếu Thổ Địa"
  },
  {
    "idx": 4340,
    "start": "01:57:46,151",
    "end": "01:57:47,451",
    "start_sec": 7066.151,
    "end_sec": 7067.451,
    "zh": "他资格带了个佛像",
    "vi": "Ông ta mang một tượng Phật"
  },
  {
    "idx": 4341,
    "start": "01:57:47,451",
    "end": "01:57:48,451",
    "start_sec": 7067.451,
    "end_sec": 7068.451,
    "zh": "放在了里面",
    "vi": "Đặt vào bên trong"
  },
  {
    "idx": 4342,
    "start": "01:57:48,451",
    "end": "01:57:49,691",
    "start_sec": 7068.451,
    "end_sec": 7069.691,
    "zh": "那佛像用红布盖着的",
    "vi": "Tượng Phật đó được phủ vải đỏ"
  },
  {
    "idx": 4343,
    "start": "01:57:49,691",
    "end": "01:57:50,991",
    "start_sec": 7069.691,
    "end_sec": 7070.991,
    "zh": "据说从来没有人见过",
    "vi": "Nghe nói chưa từng có ai nhìn thấy"
  },
  {
    "idx": 4344,
    "start": "01:57:50,991",
    "end": "01:57:52,651",
    "start_sec": 7070.991,
    "end_sec": 7072.651,
    "zh": "红布下的佛像是什么样的",
    "vi": "Tượng Phật dưới tấm vải đỏ trông thế nào"
  },
  {
    "idx": 4345,
    "start": "01:57:52,651",
    "end": "01:57:53,571",
    "start_sec": 7072.651,
    "end_sec": 7073.571,
    "zh": "听说什么",
    "vi": "Nghe nói gì"
  },
  {
    "idx": 4346,
    "start": "01:57:53,571",
    "end": "01:57:54,411",
    "start_sec": 7073.571,
    "end_sec": 7074.411,
    "zh": "就这些",
    "vi": "Chỉ vậy thôi"
  },
  {
    "idx": 4347,
    "start": "01:57:54,411",
    "end": "01:57:55,811",
    "start_sec": 7074.411,
    "end_sec": 7075.811,
    "zh": "其他的但也查不到了",
    "vi": "Những cái khác cũng không tra được"
  },
  {
    "idx": 4348,
    "start": "01:57:55,811",
    "end": "01:57:57,091",
    "start_sec": 7075.811,
    "end_sec": 7077.091,
    "zh": "解锁聊天后",
    "vi": "Sau khi mở khóa trò chuyện"
  },
  {
    "idx": 4349,
    "start": "01:57:57,091",
    "end": "01:57:58,191",
    "start_sec": 7077.091,
    "end_sec": 7078.191,
    "zh": "常泽提想了想",
    "vi": "Trường Trạch Đề suy nghĩ"
  },
  {
    "idx": 4350,
    "start": "01:57:58,191",
    "end": "01:57:59,951",
    "start_sec": 7078.191,
    "end_sec": 7079.951,
    "zh": "给周扬发了一条信息",
    "vi": "Gửi một tin nhắn cho Chu Dương"
  },
  {
    "idx": 4351,
    "start": "01:57:59,951",
    "end": "01:58:00,431",
    "start_sec": 7079.951,
    "end_sec": 7080.431,
    "zh": "周公子",
    "vi": "Công tử Chu."
  },
  {
    "idx": 4352,
    "start": "01:58:00,431",
    "end": "01:58:01,931",
    "start_sec": 7080.431,
    "end_sec": 7081.931,
    "zh": "你当初推荐我去永德寺",
    "vi": "Lúc trước bạn giới thiệu tôi đến chùa Vĩnh Đức."
  },
  {
    "idx": 4353,
    "start": "01:58:01,931",
    "end": "01:58:03,331",
    "start_sec": 7081.931,
    "end_sec": 7083.331,
    "zh": "是知道它有什么不同吗",
    "vi": "Có phải bạn biết nơi đó có gì khác biệt không."
  },
  {
    "idx": 4354,
    "start": "01:58:03,331",
    "end": "01:58:04,111",
    "start_sec": 7083.331,
    "end_sec": 7084.111,
    "zh": "我一会儿",
    "vi": "Một lát nữa."
  },
  {
    "idx": 4355,
    "start": "01:58:04,111",
    "end": "01:58:05,451",
    "start_sec": 7084.111,
    "end_sec": 7085.451,
    "zh": "周扬倒是回信了",
    "vi": "Chu Dương đã hồi âm rồi."
  },
  {
    "idx": 4356,
    "start": "01:58:05,451",
    "end": "01:58:05,851",
    "start_sec": 7085.451,
    "end_sec": 7085.851,
    "zh": "没错",
    "vi": "Đúng vậy."
  },
  {
    "idx": 4357,
    "start": "01:58:05,851",
    "end": "01:58:07,491",
    "start_sec": 7085.851,
    "end_sec": 7087.491,
    "zh": "老庙柱是上面安排的",
    "vi": "Trụ trì ngôi chùa cũ là do cấp trên sắp xếp."
  },
  {
    "idx": 4358,
    "start": "01:58:07,491",
    "end": "01:58:08,491",
    "start_sec": 7087.491,
    "end_sec": 7088.491,
    "zh": "我当时就想",
    "vi": "Lúc đó tôi đã nghĩ."
  },
  {
    "idx": 4359,
    "start": "01:58:08,491",
    "end": "01:58:10,011",
    "start_sec": 7088.491,
    "end_sec": 7090.011,
    "zh": "这是被上面承认的人",
    "vi": "Đây là người được cấp trên công nhận."
  },
  {
    "idx": 4360,
    "start": "01:58:10,011",
    "end": "01:58:11,491",
    "start_sec": 7090.011,
    "end_sec": 7091.491,
    "zh": "既然是上面承认的",
    "vi": "Đã là người được cấp trên công nhận."
  },
  {
    "idx": 4361,
    "start": "01:58:11,491",
    "end": "01:58:12,971",
    "start_sec": 7091.491,
    "end_sec": 7092.971,
    "zh": "怎么着也有些本事吧",
    "vi": "Thế nào cũng phải có chút bản lĩnh chứ."
  },
  {
    "idx": 4362,
    "start": "01:58:12,971",
    "end": "01:58:14,411",
    "start_sec": 7092.971,
    "end_sec": 7094.411,
    "zh": "所以才推荐了永德寺",
    "vi": "Vì vậy tôi mới giới thiệu chùa Vĩnh Đức."
  },
  {
    "idx": 4363,
    "start": "01:58:14,411",
    "end": "01:58:14,931",
    "start_sec": 7094.411,
    "end_sec": 7094.931,
    "zh": "怎么了",
    "vi": "Có chuyện gì sao."
  },
  {
    "idx": 4364,
    "start": "01:58:14,931",
    "end": "01:58:15,791",
    "start_sec": 7094.931,
    "end_sec": 7095.791,
    "zh": "没什么",
    "vi": "Không có gì."
  },
  {
    "idx": 4365,
    "start": "01:58:15,791",
    "end": "01:58:17,171",
    "start_sec": 7095.791,
    "end_sec": 7097.171,
    "zh": "我进永德寺了",
    "vi": "Tôi đã vào được chùa Vĩnh Đức rồi."
  },
  {
    "idx": 4366,
    "start": "01:58:17,171",
    "end": "01:58:20,871",
    "start_sec": 7097.171,
    "end_sec": 7100.871,
    "zh": "厉害啊,只身一人能进去,橙子皮,你也不简单啊。",
    "vi": "Lợi hại thật, một mình mà vào được đó, Trần Tử Bì, bạn cũng không đơn giản đâu."
  },
  {
    "idx": 4367,
    "start": "01:58:21,491",
    "end": "01:58:24,511",
    "start_sec": 7101.491,
    "end_sec": 7104.511,
    "zh": "橙子皮收起手机,总感觉很多事情不得解。",
    "vi": "Trần Tử Bì cất điện thoại, cứ cảm thấy nhiều chuyện vẫn chưa được giải đáp."
  },
  {
    "idx": 4368,
    "start": "01:58:24,931",
    "end": "01:58:27,651",
    "start_sec": 7104.931,
    "end_sec": 7107.651,
    "zh": "算了,如果是上面承认的人,应该没有问题吧。",
    "vi": "Thôi bỏ đi, nếu là người được cấp trên công nhận thì chắc không vấn đề gì đâu."
  },
  {
    "idx": 4369,
    "start": "01:58:29,871",
    "end": "01:58:31,471",
    "start_sec": 7109.871,
    "end_sec": 7111.471,
    "zh": "最后一天,开始吧。",
    "vi": "Ngày cuối cùng, bắt đầu thôi."
  },
  {
    "idx": 4370,
    "start": "01:58:31,891",
    "end": "01:58:32,471",
    "start_sec": 7111.891,
    "end_sec": 7112.471,
    "zh": "开始吧。",
    "vi": "Bắt đầu thôi."
  },
  {
    "idx": 4371,
    "start": "01:58:33,911",
    "end": "01:58:38,551",
    "start_sec": 7113.911,
    "end_sec": 7118.551,
    "zh": "夫卫,今天是最后一次,带着感激之情,有趣前来殿堂祈祷。",
    "vi": "Phu Vệ, hôm nay là lần cuối cùng, mang theo lòng biết ơn, tôi đến điện thờ để cầu nguyện."
  },
  {
    "idx": 4372,
    "start": "01:58:38,811",
    "end": "01:58:43,711",
    "start_sec": 7118.811,
    "end_sec": 7123.711,
    "zh": "我想,只要足够虔诚,神灵会庇佑我们,成功离开灵江市的。",
    "vi": "Tôi nghĩ, chỉ cần đủ thành tâm, thần linh sẽ phù hộ chúng ta rời khỏi thành phố Linh Giang an toàn."
  },
  {
    "idx": 4373,
    "start": "01:58:43,711",
    "end": "01:58:44,771",
    "start_sec": 7123.711,
    "end_sec": 7124.771,
    "zh": "他的声音不大",
    "vi": "Giọng anh ta không lớn."
  },
  {
    "idx": 4374,
    "start": "01:58:44,771",
    "end": "01:58:46,111",
    "start_sec": 7124.771,
    "end_sec": 7126.111,
    "zh": "却充满了感染力",
    "vi": "Nhưng lại đầy sức truyền cảm."
  },
  {
    "idx": 4375,
    "start": "01:58:46,111",
    "end": "01:58:48,351",
    "start_sec": 7126.111,
    "end_sec": 7128.351,
    "zh": "殿堂内用红布盖着的左向前",
    "vi": "Tả Hướng Tiền đang bị phủ vải đỏ trong điện thờ."
  },
  {
    "idx": 4376,
    "start": "01:58:48,351",
    "end": "01:58:50,631",
    "start_sec": 7128.351,
    "end_sec": 7130.631,
    "zh": "已经用一个瓷碗装满了清水",
    "vi": "Đã được đặt một bát sứ đầy nước sạch."
  },
  {
    "idx": 4377,
    "start": "01:58:50,631",
    "end": "01:58:51,851",
    "start_sec": 7130.631,
    "end_sec": 7131.851,
    "zh": "第一个人走进去后",
    "vi": "Sau khi người đầu tiên bước vào."
  },
  {
    "idx": 4378,
    "start": "01:58:51,851",
    "end": "01:58:53,931",
    "start_sec": 7131.851,
    "end_sec": 7133.931,
    "zh": "非常熟练地拿起碗边的银针",
    "vi": "Rất thuần thục cầm lấy cây kim bạc bên cạnh bát."
  },
  {
    "idx": 4379,
    "start": "01:58:53,931",
    "end": "01:58:55,111",
    "start_sec": 7133.931,
    "end_sec": 7135.111,
    "zh": "表达左手中指",
    "vi": "Châm vào ngón giữa tay trái."
  },
  {
    "idx": 4380,
    "start": "01:58:55,111",
    "end": "01:58:59,191",
    "start_sec": 7135.111,
    "end_sec": 7139.191,
    "zh": "谢神明保佑",
    "vi": "Cảm ơn thần linh đã phù hộ."
  },
  {
    "idx": 4381,
    "start": "01:58:59,191",
    "end": "01:59:01,571",
    "start_sec": 7139.191,
    "end_sec": 7141.571,
    "zh": "请神明庇佑我此行顺利",
    "vi": "Xin thần linh phù hộ cho chuyến đi này của tôi được thuận lợi."
  },
  {
    "idx": 4382,
    "start": "01:59:01,571",
    "end": "01:59:03,591",
    "start_sec": 7141.571,
    "end_sec": 7143.591,
    "zh": "人群一时顺序地心血会拜",
    "vi": "Mọi người lần lượt dâng máu tim lên bái tế."
  },
  {
    "idx": 4383,
    "start": "01:59:03,591",
    "end": "01:59:05,671",
    "start_sec": 7143.591,
    "end_sec": 7145.671,
    "zh": "会拜者此刻离拜不远的现场",
    "vi": "Những người bái tế lúc này đang đứng ngay gần đó."
  },
  {
    "idx": 4384,
    "start": "01:59:05,671",
    "end": "01:59:08,031",
    "start_sec": 7145.671,
    "end_sec": 7148.031,
    "zh": "橙子皮头皮发麻地看着这场面",
    "vi": "Trần Tử Bì da đầu tê dại nhìn cảnh tượng này."
  },
  {
    "idx": 4385,
    "start": "01:59:08,031",
    "end": "01:59:09,231",
    "start_sec": 7148.031,
    "end_sec": 7149.231,
    "zh": "觉得无比邪乎",
    "vi": "Cảm thấy vô cùng tà môn."
  },
  {
    "idx": 4386,
    "start": "01:59:09,231",
    "end": "01:59:10,471",
    "start_sec": 7149.231,
    "end_sec": 7150.471,
    "zh": "等所有人会拜完",
    "vi": "Đợi sau khi mọi người đã bái tế xong."
  },
  {
    "idx": 4387,
    "start": "01:59:10,471",
    "end": "01:59:12,131",
    "start_sec": 7150.471,
    "end_sec": 7152.131,
    "zh": "老庙户看向橙子皮",
    "vi": "Lão miếu chủ nhìn về phía Trần Tử Bì."
  },
  {
    "idx": 4388,
    "start": "01:59:12,131",
    "end": "01:59:14,751",
    "start_sec": 7152.131,
    "end_sec": 7154.751,
    "zh": "阿弥陀佛 成师主 你也来吧",
    "vi": "A Di Đà Phật, Thành thí chủ, bạn cũng lại đây đi."
  },
  {
    "idx": 4389,
    "start": "01:59:14,751",
    "end": "01:59:18,331",
    "start_sec": 7154.751,
    "end_sec": 7158.331,
    "zh": "成师主受神明恩惠",
    "vi": "Thành thí chủ đã nhận được ân huệ của thần linh."
  },
  {
    "idx": 4390,
    "start": "01:59:18,331",
    "end": "01:59:21,171",
    "start_sec": 7158.331,
    "end_sec": 7161.171,
    "zh": "不回报的话可是不敬重神明的",
    "vi": "Nếu không báo đáp thì chính là bất kính với thần linh."
  },
  {
    "idx": 4391,
    "start": "01:59:21,171",
    "end": "01:59:22,491",
    "start_sec": 7161.171,
    "end_sec": 7162.491,
    "zh": "纠结片刻后",
    "vi": "Sau một hồi đắn đo."
  },
  {
    "idx": 4392,
    "start": "01:59:22,491",
    "end": "01:59:24,691",
    "start_sec": 7162.491,
    "end_sec": 7164.691,
    "zh": "橙子皮不情不愿的来到佛像前",
    "vi": "Trần Tử Bì miễn cưỡng đi tới trước tượng Phật."
  },
  {
    "idx": 4393,
    "start": "01:59:24,691",
    "end": "01:59:26,571",
    "start_sec": 7164.691,
    "end_sec": 7166.571,
    "zh": "说到对神明的虔诚",
    "vi": "Nói về lòng thành kính với thần linh."
  },
  {
    "idx": 4394,
    "start": "01:59:26,571",
    "end": "01:59:28,791",
    "start_sec": 7166.571,
    "end_sec": 7168.791,
    "zh": "那么作为庙主应该要第一个供奉的吧",
    "vi": "Thế thì với tư cách là miếu chủ, ông phải là người đầu tiên cúng dường chứ."
  },
  {
    "idx": 4395,
    "start": "01:59:28,791",
    "end": "01:59:30,411",
    "start_sec": 7168.791,
    "end_sec": 7170.411,
    "zh": "而且零三七也没有",
    "vi": "Hơn nữa Không Ba Bảy cũng không có."
  },
  {
    "idx": 4396,
    "start": "01:59:30,411",
    "end": "01:59:32,391",
    "start_sec": 7170.411,
    "end_sec": 7172.391,
    "zh": "哪有供奉神明需要你心血的",
    "vi": "Làm gì có chuyện cúng dường thần linh lại cần đến máu tim của bạn."
  },
  {
    "idx": 4397,
    "start": "01:59:32,391",
    "end": "01:59:34,531",
    "start_sec": 7172.391,
    "end_sec": 7174.531,
    "zh": "然而橙子皮却没有任何办法",
    "vi": "Thế nhưng Trần Tử Bì lại không có cách nào khác."
  },
  {
    "idx": 4398,
    "start": "01:59:34,531",
    "end": "01:59:35,671",
    "start_sec": 7174.531,
    "end_sec": 7175.671,
    "zh": "还是自破了宗旨",
    "vi": "Vẫn phải tự phá vỡ nguyên tắc của mình."
  },
  {
    "idx": 4399,
    "start": "01:59:35,671",
    "end": "01:59:37,871",
    "start_sec": 7175.671,
    "end_sec": 7177.871,
    "zh": "等橙子皮日来谢后",
    "vi": "Sau khi Trần Tử Bì dâng máu xong."
  },
  {
    "idx": 4400,
    "start": "01:59:37,871",
    "end": "01:59:39,731",
    "start_sec": 7177.871,
    "end_sec": 7179.731,
    "zh": "老庙主也没管他磕不磕头",
    "vi": "Lão miếu chủ cũng không quan tâm cậu ta có dập đầu hay không."
  },
  {
    "idx": 4401,
    "start": "01:59:39,731",
    "end": "01:59:40,751",
    "start_sec": 7179.731,
    "end_sec": 7180.751,
    "zh": "匆匆走上前",
    "vi": "Vội vàng bước lên phía trước."
  },
  {
    "idx": 4402,
    "start": "01:59:40,751",
    "end": "01:59:43,651",
    "start_sec": 7180.751,
    "end_sec": 7183.651,
    "zh": "钻戒了后将浑浊的鲜血朝浑部拖起",
    "vi": "Nhận lấy rồi nâng dòng máu đục ngầu hướng về phía tấm vải hồn."
  },
  {
    "idx": 4403,
    "start": "01:59:43,651",
    "end": "01:59:46,971",
    "start_sec": 7183.651,
    "end_sec": 7186.971,
    "zh": "下一刻本该是被血水拖得潮湿一片的魂部",
    "vi": "Ngay sau đó, tấm vải hồn đáng lẽ phải bị máu thấm ướt sũng."
  },
  {
    "idx": 4404,
    "start": "01:59:46,971",
    "end": "01:59:49,431",
    "start_sec": 7186.971,
    "end_sec": 7189.431,
    "zh": "在进口过两三秒后开始向你收集",
    "vi": "Nhưng chỉ sau hai ba giây đã bắt đầu co rút lại."
  },
  {
    "idx": 4405,
    "start": "01:59:49,431",
    "end": "01:59:50,411",
    "start_sec": 7189.431,
    "end_sec": 7190.411,
    "zh": "又快速分开",
    "vi": "Rồi lại nhanh chóng giãn ra."
  },
  {
    "idx": 4406,
    "start": "01:59:50,411",
    "end": "01:59:52,771",
    "start_sec": 7190.411,
    "end_sec": 7192.771,
    "zh": "好似魂部后的佛像在吸血一带",
    "vi": "Giống như bức tượng Phật phía sau tấm vải hồn đang hút máu vậy."
  },
  {
    "idx": 4407,
    "start": "01:59:52,771",
    "end": "01:59:54,051",
    "start_sec": 7192.771,
    "end_sec": 7194.051,
    "zh": "魂离佛佛",
    "vi": "Hồn lìa Phật tổ."
  },
  {
    "idx": 4408,
    "start": "01:59:54,051",
    "end": "01:59:56,431",
    "start_sec": 7194.051,
    "end_sec": 7196.431,
    "zh": "神明已经接受到各位的诚意了",
    "vi": "Thần linh đã nhận được lòng thành của mọi người rồi."
  },
  {
    "idx": 4409,
    "start": "01:59:56,431",
    "end": "01:59:59,391",
    "start_sec": 7196.431,
    "end_sec": 7199.391,
    "zh": "相信您早的撤离一定会意外的顺利",
    "vi": "Tin rằng chuyến rút lui sớm của các vị nhất định sẽ vô cùng thuận lợi."
  },
  {
    "idx": 4410,
    "start": "02:00:00,140",
    "end": "02:00:03,060",
    "start_sec": 7200.14,
    "end_sec": 7203.06,
    "zh": "剪橙子皮还站在殿堂内,老庙主笑了笑,",
    "vi": "Thấy Trần Tử Bì vẫn đứng trong điện thờ, lão miếu chủ mỉm cười."
  },
  {
    "idx": 4411,
    "start": "02:00:03,160",
    "end": "02:00:04,600",
    "start_sec": 7203.16,
    "end_sec": 7204.6,
    "zh": "橙施主可以离去了。",
    "vi": "Thí chủ Trần có thể rời đi rồi."
  },
  {
    "idx": 4412,
    "start": "02:00:04,900",
    "end": "02:00:05,460",
    "start_sec": 7204.9,
    "end_sec": 7205.46,
    "zh": "嗯,好。",
    "vi": "Vâng, được."
  },
  {
    "idx": 4413,
    "start": "02:00:05,800",
    "end": "02:00:07,980",
    "start_sec": 7205.8,
    "end_sec": 7207.98,
    "zh": "临走时,橙子皮又看了一眼殿堂,",
    "vi": "Lúc rời đi, Trần Tử Bì lại nhìn vào trong điện thờ một cái."
  },
  {
    "idx": 4414,
    "start": "02:00:08,180",
    "end": "02:00:10,320",
    "start_sec": 7208.18,
    "end_sec": 7210.32,
    "zh": "只见角落里的林三七笑一张神。",
    "vi": "Chỉ thấy Lâm Tam Thất ở góc phòng đang cười một cách quái dị."
  },
  {
    "idx": 4415,
    "start": "02:00:11,080",
    "end": "02:00:14,700",
    "start_sec": 7211.08,
    "end_sec": 7214.7,
    "zh": "刚走出殿堂,院落里已经有一片人趴在地上酣睡,",
    "vi": "Vừa bước ra khỏi điện thờ, trong sân đã có một đám người nằm rạp dưới đất ngủ say."
  },
  {
    "idx": 4416,
    "start": "02:00:15,120",
    "end": "02:00:17,760",
    "start_sec": 7215.12,
    "end_sec": 7217.76,
    "zh": "橙子皮抱着小墨迹,也感觉到困得不行,",
    "vi": "Trần Tử Bì ôm lấy Tiểu Mặc Ký, cũng cảm thấy buồn ngủ không chịu nổi."
  },
  {
    "idx": 4417,
    "start": "02:00:18,140",
    "end": "02:00:19,520",
    "start_sec": 7218.14,
    "end_sec": 7219.52,
    "zh": "估计妈的,不能睡。",
    "vi": "Cậu thầm nghĩ không được ngủ."
  },
  {
    "idx": 4418,
    "start": "02:00:21,020",
    "end": "02:00:23,520",
    "start_sec": 7221.02,
    "end_sec": 7223.52,
    "zh": "估计我,永德四,有,有。",
    "vi": "Cậu nghĩ mình ở chùa Vĩnh Đức này có vấn đề."
  },
  {
    "idx": 4419,
    "start": "02:00:26,200",
    "end": "02:00:28,240",
    "start_sec": 7226.2,
    "end_sec": 7228.24,
    "zh": "恍惚间,橙子皮似乎做了个梦,",
    "vi": "Trong cơn mơ màng, Trần Tử Bì dường như đã mơ một giấc mơ."
  },
  {
    "idx": 4420,
    "start": "02:00:28,240",
    "end": "02:00:30,060",
    "start_sec": 7228.24,
    "end_sec": 7230.06,
    "zh": "梦里他被载在一棵树里",
    "vi": "Trong mơ cậu bị nhốt vào trong một cái cây."
  },
  {
    "idx": 4421,
    "start": "02:00:30,060",
    "end": "02:00:31,000",
    "start_sec": 7230.06,
    "end_sec": 7231.0,
    "zh": "浑身动弹不得",
    "vi": "Toàn thân không thể cử động."
  },
  {
    "idx": 4422,
    "start": "02:00:31,000",
    "end": "02:00:33,460",
    "start_sec": 7231.0,
    "end_sec": 7233.46,
    "zh": "他的脸透过扭曲在树上睁眼不断",
    "vi": "Khuôn mặt cậu hiện lên trên thân cây đang vặn vẹo không ngừng."
  },
  {
    "idx": 4423,
    "start": "02:00:33,460",
    "end": "02:00:35,240",
    "start_sec": 7233.46,
    "end_sec": 7235.24,
    "zh": "突然一阵剧痛传来",
    "vi": "Đột nhiên một cơn đau dữ dội ập đến."
  },
  {
    "idx": 4424,
    "start": "02:00:35,240",
    "end": "02:00:36,840",
    "start_sec": 7235.24,
    "end_sec": 7236.84,
    "zh": "橙子皮缓缓睁开来",
    "vi": "Trần Tử Bì từ từ mở mắt ra."
  },
  {
    "idx": 4425,
    "start": "02:00:36,840",
    "end": "02:00:39,220",
    "start_sec": 7236.84,
    "end_sec": 7239.22,
    "zh": "小墨记竟然正砍着他的脸",
    "vi": "Tiểu Mặc Ký vậy mà đang cắn vào mặt cậu."
  },
  {
    "idx": 4426,
    "start": "02:00:39,220",
    "end": "02:00:40,740",
    "start_sec": 7239.22,
    "end_sec": 7240.74,
    "zh": "试图咬断他脸上的树",
    "vi": "Nó đang cố cắn đứt cái cây trên mặt cậu."
  },
  {
    "idx": 4427,
    "start": "02:00:40,740",
    "end": "02:00:43,020",
    "start_sec": 7240.74,
    "end_sec": 7243.02,
    "zh": "他到底发生了什么",
    "vi": "Rốt cuộc chuyện gì đã xảy ra với cậu."
  },
  {
    "idx": 4428,
    "start": "02:00:43,020",
    "end": "02:00:45,780",
    "start_sec": 7243.02,
    "end_sec": 7245.78,
    "zh": "他的地上的橙子皮浑身被树根包裹",
    "vi": "Trần Tử Bì nằm trên mặt đất với toàn thân bị rễ cây bao bọc."
  },
  {
    "idx": 4429,
    "start": "02:00:45,780",
    "end": "02:00:46,480",
    "start_sec": 7245.78,
    "end_sec": 7246.48,
    "zh": "动弹不得",
    "vi": "Không thể cử động."
  },
  {
    "idx": 4430,
    "start": "02:00:46,480",
    "end": "02:00:48,200",
    "start_sec": 7246.48,
    "end_sec": 7248.2,
    "zh": "他用鱼光扫射一眼周围",
    "vi": "Cậu dùng ánh mắt liếc nhìn xung quanh."
  },
  {
    "idx": 4431,
    "start": "02:00:48,200",
    "end": "02:00:49,060",
    "start_sec": 7248.2,
    "end_sec": 7249.06,
    "zh": "深恶的发现",
    "vi": "Kinh hoàng nhận ra."
  },
  {
    "idx": 4432,
    "start": "02:00:49,060",
    "end": "02:00:51,080",
    "start_sec": 7249.06,
    "end_sec": 7251.08,
    "zh": "竟然每个人体内都长出树根",
    "vi": "Vậy mà trong cơ thể mỗi người đều mọc ra rễ cây."
  },
  {
    "idx": 4433,
    "start": "02:00:51,080",
    "end": "02:00:52,720",
    "start_sec": 7251.08,
    "end_sec": 7252.72,
    "zh": "向殿堂延伸而行",
    "vi": "Chúng đang kéo dài về phía điện thờ."
  },
  {
    "idx": 4434,
    "start": "02:00:52,720",
    "end": "02:00:53,520",
    "start_sec": 7252.72,
    "end_sec": 7253.52,
    "zh": "我操",
    "vi": "Chết tiệt thật."
  },
  {
    "idx": 4435,
    "start": "02:00:53,520",
    "end": "02:00:55,980",
    "start_sec": 7253.52,
    "end_sec": 7255.98,
    "zh": "果然这永德寺也不是个好地方",
    "vi": "Quả nhiên chùa Vĩnh Đức này không phải là nơi tốt lành gì."
  },
  {
    "idx": 4436,
    "start": "02:00:55,980",
    "end": "02:00:57,200",
    "start_sec": 7255.98,
    "end_sec": 7257.2,
    "zh": "还好在昏倒之前",
    "vi": "May mà trước khi ngất đi."
  },
  {
    "idx": 4437,
    "start": "02:00:57,200",
    "end": "02:00:58,800",
    "start_sec": 7257.2,
    "end_sec": 7258.8,
    "zh": "把消息发给了过去的自己",
    "vi": "Cậu đã kịp gửi tin nhắn cho bản thân trong quá khứ."
  },
  {
    "idx": 4438,
    "start": "02:00:58,800",
    "end": "02:01:01,400",
    "start_sec": 7258.8,
    "end_sec": 7261.4,
    "zh": "肠子皮靴的身体越来越虚弱",
    "vi": "Trần Tử Bì cảm thấy cơ thể ngày càng yếu đi."
  },
  {
    "idx": 4439,
    "start": "02:01:01,400",
    "end": "02:01:03,260",
    "start_sec": 7261.4,
    "end_sec": 7263.26,
    "zh": "死亡正向的一点一点显示",
    "vi": "Cái chết đang từng chút một hiện ra."
  },
  {
    "idx": 4440,
    "start": "02:01:03,260",
    "end": "02:01:06,160",
    "start_sec": 7263.26,
    "end_sec": 7266.16,
    "zh": "我死了",
    "vi": "Mình sắp chết rồi."
  },
  {
    "idx": 4441,
    "start": "02:01:06,160",
    "end": "02:01:07,500",
    "start_sec": 7266.16,
    "end_sec": 7267.5,
    "zh": "这不是早上那个胖子",
    "vi": "Đây chẳng phải là gã béo hồi sáng sao."
  },
  {
    "idx": 4442,
    "start": "02:01:07,500",
    "end": "02:01:09,440",
    "start_sec": 7267.5,
    "end_sec": 7269.44,
    "zh": "现在都瘦成人干了",
    "vi": "Giờ đã gầy trơ xương như xác khô rồi."
  },
  {
    "idx": 4443,
    "start": "02:01:09,440",
    "end": "02:01:10,700",
    "start_sec": 7269.44,
    "end_sec": 7270.7,
    "zh": "死里到底是什么鬼东西",
    "vi": "Rốt cuộc thứ quỷ quái gì ở trong đó vậy."
  },
  {
    "idx": 4444,
    "start": "02:01:10,700",
    "end": "02:01:11,840",
    "start_sec": 7270.7,
    "end_sec": 7271.84,
    "zh": "竟然虚视人的虚荣",
    "vi": "Lại có thể hút cạn máu thịt của con người."
  },
  {
    "idx": 4445,
    "start": "02:01:11,840",
    "end": "02:01:12,580",
    "start_sec": 7271.84,
    "end_sec": 7272.58,
    "zh": "突然",
    "vi": "Đột nhiên."
  },
  {
    "idx": 4446,
    "start": "02:01:12,580",
    "end": "02:01:14,540",
    "start_sec": 7272.58,
    "end_sec": 7274.54,
    "zh": "殿堂内传来037的声音",
    "vi": "Từ trong điện truyền đến giọng nói của số 037."
  },
  {
    "idx": 4447,
    "start": "02:01:14,540",
    "end": "02:01:16,020",
    "start_sec": 7274.54,
    "end_sec": 7276.02,
    "zh": "肠子皮慌忙一样看",
    "vi": "Trương Tử Bình vội vàng nhìn sang."
  },
  {
    "idx": 4448,
    "start": "02:01:16,020",
    "end": "02:01:16,880",
    "start_sec": 7276.02,
    "end_sec": 7276.88,
    "zh": "032",
    "vi": "Số 032."
  },
  {
    "idx": 4449,
    "start": "02:01:16,880",
    "end": "02:01:18,120",
    "start_sec": 7276.88,
    "end_sec": 7278.12,
    "zh": "你果然在鬼域里",
    "vi": "Quả nhiên anh đang ở trong quỷ vực."
  },
  {
    "idx": 4450,
    "start": "02:01:18,120",
    "end": "02:01:19,380",
    "start_sec": 7278.12,
    "end_sec": 7279.38,
    "zh": "把这玩意带出来了",
    "vi": "Và đã mang thứ này ra ngoài."
  },
  {
    "idx": 4451,
    "start": "02:01:19,380",
    "end": "02:01:19,940",
    "start_sec": 7279.38,
    "end_sec": 7279.94,
    "zh": "哥",
    "vi": "Anh à."
  },
  {
    "idx": 4452,
    "start": "02:01:19,940",
    "end": "02:01:21,660",
    "start_sec": 7279.94,
    "end_sec": 7281.66,
    "zh": "我为组织付出那么多",
    "vi": "Tôi đã cống hiến cho tổ chức nhiều như vậy."
  },
  {
    "idx": 4453,
    "start": "02:01:21,660",
    "end": "02:01:22,380",
    "start_sec": 7281.66,
    "end_sec": 7282.38,
    "zh": "到头来",
    "vi": "Cuối cùng thì."
  },
  {
    "idx": 4454,
    "start": "02:01:22,380",
    "end": "02:01:24,160",
    "start_sec": 7282.38,
    "end_sec": 7284.16,
    "zh": "只鬼吞噬了我一只手臂",
    "vi": "Con quỷ đó lại nuốt chửng một cánh tay của tôi."
  },
  {
    "idx": 4455,
    "start": "02:01:24,160",
    "end": "02:01:25,060",
    "start_sec": 7284.16,
    "end_sec": 7285.06,
    "zh": "鬼意复苏",
    "vi": "Lệ quỷ thức tỉnh."
  },
  {
    "idx": 4456,
    "start": "02:01:25,060",
    "end": "02:01:26,500",
    "start_sec": 7285.06,
    "end_sec": 7286.5,
    "zh": "组织给了我什么",
    "vi": "Tổ chức đã cho tôi được những gì."
  },
  {
    "idx": 4457,
    "start": "02:01:26,500",
    "end": "02:01:29,380",
    "start_sec": 7286.5,
    "end_sec": 7289.38,
    "zh": "这东西我带出来为了好一番功夫",
    "vi": "Tôi đã tốn rất nhiều công sức mới mang được thứ này ra ngoài."
  },
  {
    "idx": 4458,
    "start": "02:01:29,380",
    "end": "02:01:31,580",
    "start_sec": 7289.38,
    "end_sec": 7291.58,
    "zh": "它可是我现在唯一的盼头了",
    "vi": "Nó là hy vọng duy nhất của tôi lúc này."
  },
  {
    "idx": 4459,
    "start": "02:01:31,580",
    "end": "02:01:33,600",
    "start_sec": 7291.58,
    "end_sec": 7293.6,
    "zh": "037和032",
    "vi": "Số 037 và số 032."
  },
  {
    "idx": 4460,
    "start": "02:01:33,600",
    "end": "02:01:36,960",
    "start_sec": 7293.6,
    "end_sec": 7296.96,
    "zh": "看来他们在鬼降临前就隶属于官方的某个组织",
    "vi": "Xem ra trước khi quỷ xuất hiện, họ đã thuộc về một tổ chức nào đó của chính quyền."
  },
  {
    "idx": 4461,
    "start": "02:01:36,960",
    "end": "02:01:37,420",
    "start_sec": 7296.96,
    "end_sec": 7297.42,
    "zh": "还有",
    "vi": "Còn nữa."
  },
  {
    "idx": 4462,
    "start": "02:01:37,420",
    "end": "02:01:39,040",
    "start_sec": 7297.42,
    "end_sec": 7299.04,
    "zh": "鬼带出来的什么",
    "vi": "Thứ mang ra từ quỷ vực là gì vậy."
  },
  {
    "idx": 4463,
    "start": "02:01:39,040",
    "end": "02:01:41,440",
    "start_sec": 7299.04,
    "end_sec": 7301.44,
    "zh": "这是电脑发出一阵音响",
    "vi": "Lúc này máy tính phát ra một tiếng động."
  },
  {
    "idx": 4464,
    "start": "02:01:41,440",
    "end": "02:01:42,720",
    "start_sec": 7301.44,
    "end_sec": 7302.72,
    "zh": "那红布之下的东西",
    "vi": "Thứ ở bên dưới tấm vải đỏ kia."
  },
  {
    "idx": 4465,
    "start": "02:01:42,720",
    "end": "02:01:44,060",
    "start_sec": 7302.72,
    "end_sec": 7304.06,
    "zh": "似乎活过了一辈子",
    "vi": "Dường như đã sống lại."
  },
  {
    "idx": 4466,
    "start": "02:01:44,060",
    "end": "02:01:44,780",
    "start_sec": 7304.06,
    "end_sec": 7304.78,
    "zh": "开始颤抖",
    "vi": "Bắt đầu run rẩy."
  },
  {
    "idx": 4467,
    "start": "02:01:44,780",
    "end": "02:01:45,320",
    "start_sec": 7304.78,
    "end_sec": 7305.32,
    "zh": "成了",
    "vi": "Thành công rồi."
  },
  {
    "idx": 4468,
    "start": "02:01:45,320",
    "end": "02:01:46,260",
    "start_sec": 7305.32,
    "end_sec": 7306.26,
    "zh": "终于成了",
    "vi": "Cuối cùng cũng thành công rồi."
  },
  {
    "idx": 4469,
    "start": "02:01:46,260",
    "end": "02:01:47,060",
    "start_sec": 7306.26,
    "end_sec": 7307.06,
    "zh": "哗啦一声",
    "vi": "Một tiếng xoạt vang lên."
  },
  {
    "idx": 4470,
    "start": "02:01:47,060",
    "end": "02:01:47,900",
    "start_sec": 7307.06,
    "end_sec": 7307.9,
    "zh": "红布落下",
    "vi": "Tấm vải đỏ rơi xuống."
  },
  {
    "idx": 4471,
    "start": "02:01:47,900",
    "end": "02:01:49,760",
    "start_sec": 7307.9,
    "end_sec": 7309.76,
    "zh": "露出一尊黑褐色的怪兽",
    "vi": "Lộ ra một con quái thú màu nâu đen"
  },
  {
    "idx": 4472,
    "start": "02:01:49,760",
    "end": "02:01:52,140",
    "start_sec": 7309.76,
    "end_sec": 7312.14,
    "zh": "树皮上满是灯灵勇气的人物",
    "vi": "Trên vỏ cây đầy những hình thù kỳ dị"
  },
  {
    "idx": 4473,
    "start": "02:01:52,140",
    "end": "02:01:53,780",
    "start_sec": 7312.14,
    "end_sec": 7313.78,
    "zh": "树顶长出一颗黑色火石",
    "vi": "Trên ngọn cây mọc ra một viên hỏa thạch màu đen"
  },
  {
    "idx": 4474,
    "start": "02:01:53,780",
    "end": "02:01:56,240",
    "start_sec": 7313.78,
    "end_sec": 7316.24,
    "zh": "032为了养出鬼树和鬼果",
    "vi": "032 để nuôi dưỡng cây quỷ và quả quỷ"
  },
  {
    "idx": 4475,
    "start": "02:01:56,240",
    "end": "02:01:57,500",
    "start_sec": 7316.24,
    "end_sec": 7317.5,
    "zh": "你不惜勾杀百人",
    "vi": "Ngươi không tiếc sát hại cả trăm người"
  },
  {
    "idx": 4476,
    "start": "02:01:57,500",
    "end": "02:01:58,460",
    "start_sec": 7317.5,
    "end_sec": 7318.46,
    "zh": "比我还狠啊",
    "vi": "Còn tàn nhẫn hơn cả ta nữa"
  },
  {
    "idx": 4477,
    "start": "02:01:58,460",
    "end": "02:01:59,920",
    "start_sec": 7318.46,
    "end_sec": 7319.92,
    "zh": "与我们御鬼者相比",
    "vi": "So với những người ngự quỷ như chúng ta"
  },
  {
    "idx": 4478,
    "start": "02:01:59,920",
    "end": "02:02:01,160",
    "start_sec": 7319.92,
    "end_sec": 7321.16,
    "zh": "凡人就是个数字",
    "vi": "Người phàm chỉ là những con số"
  },
  {
    "idx": 4479,
    "start": "02:02:01,160",
    "end": "02:02:02,380",
    "start_sec": 7321.16,
    "end_sec": 7322.38,
    "zh": "他们应该庆幸",
    "vi": "Họ nên cảm thấy may mắn"
  },
  {
    "idx": 4480,
    "start": "02:02:02,380",
    "end": "02:02:04,900",
    "start_sec": 7322.38,
    "end_sec": 7324.9,
    "zh": "自己的死能孵化出新的鬼异",
    "vi": "Cái chết của bản thân có thể nuôi dưỡng ra một quỷ dị mới"
  },
  {
    "idx": 4481,
    "start": "02:02:04,900",
    "end": "02:02:05,520",
    "start_sec": 7324.9,
    "end_sec": 7325.52,
    "zh": "上头说",
    "vi": "Cấp trên nói"
  },
  {
    "idx": 4482,
    "start": "02:02:05,520",
    "end": "02:02:06,620",
    "start_sec": 7325.52,
    "end_sec": 7326.62,
    "zh": "让你住在这里",
    "vi": "Cho ngươi ở lại đây"
  },
  {
    "idx": 4483,
    "start": "02:02:06,620",
    "end": "02:02:08,000",
    "start_sec": 7326.62,
    "end_sec": 7328.0,
    "zh": "能救几个算几个",
    "vi": "Cứu được người nào hay người nấy"
  },
  {
    "idx": 4484,
    "start": "02:02:08,000",
    "end": "02:02:08,880",
    "start_sec": 7328.0,
    "end_sec": 7328.88,
    "zh": "谁能想到",
    "vi": "Ai mà ngờ được"
  },
  {
    "idx": 4485,
    "start": "02:02:08,880",
    "end": "02:02:10,400",
    "start_sec": 7328.88,
    "end_sec": 7330.4,
    "zh": "你拿着这些人孵化鬼数",
    "vi": "Ngươi lại dùng những người này để nuôi cây quỷ"
  },
  {
    "idx": 4486,
    "start": "02:02:10,400",
    "end": "02:02:12,580",
    "start_sec": 7330.4,
    "end_sec": 7332.58,
    "zh": "若不是我的纸鬼要发作了",
    "vi": "Nếu không phải quỷ giấy của ta sắp bộc phát"
  },
  {
    "idx": 4487,
    "start": "02:02:12,580",
    "end": "02:02:13,740",
    "start_sec": 7332.58,
    "end_sec": 7333.74,
    "zh": "我也不会这样",
    "vi": "Ta cũng không làm như vậy"
  },
  {
    "idx": 4488,
    "start": "02:02:13,740",
    "end": "02:02:15,380",
    "start_sec": 7333.74,
    "end_sec": 7335.38,
    "zh": "零三七双手抱胸",
    "vi": "037 khoanh hai tay trước ngực"
  },
  {
    "idx": 4489,
    "start": "02:02:15,380",
    "end": "02:02:17,420",
    "start_sec": 7335.38,
    "end_sec": 7337.42,
    "zh": "奶神一直停留在鬼鬼里",
    "vi": "Ánh mắt vẫn luôn nhìn chăm chú vào cây quỷ"
  },
  {
    "idx": 4490,
    "start": "02:02:17,420",
    "end": "02:02:18,000",
    "start_sec": 7337.42,
    "end_sec": 7338.0,
    "zh": "你觉得",
    "vi": "Ngươi nghĩ"
  },
  {
    "idx": 4491,
    "start": "02:02:18,000",
    "end": "02:02:19,740",
    "start_sec": 7338.0,
    "end_sec": 7339.74,
    "zh": "上头给的信息可靠吗",
    "vi": "Tin tức cấp trên đưa ra có đáng tin không."
  },
  {
    "idx": 4492,
    "start": "02:02:19,740",
    "end": "02:02:21,700",
    "start_sec": 7339.74,
    "end_sec": 7341.7,
    "zh": "在身上种下了第二个鬼异",
    "vi": "Cấy thêm một quỷ dị thứ hai vào cơ thể"
  },
  {
    "idx": 4493,
    "start": "02:02:21,700",
    "end": "02:02:23,560",
    "start_sec": 7341.7,
    "end_sec": 7343.56,
    "zh": "就能压制体内的鬼异复苏",
    "vi": "Là có thể áp chế sự phục sinh của quỷ dị trong người"
  },
  {
    "idx": 4494,
    "start": "02:02:23,560",
    "end": "02:02:24,760",
    "start_sec": 7343.56,
    "end_sec": 7344.76,
    "zh": "只有八九吧",
    "vi": "Chắc là tám chín phần mười"
  },
  {
    "idx": 4495,
    "start": "02:02:24,760",
    "end": "02:02:26,140",
    "start_sec": 7344.76,
    "end_sec": 7346.14,
    "zh": "能对付鬼异的",
    "vi": "Thứ có thể đối phó với quỷ dị"
  },
  {
    "idx": 4496,
    "start": "02:02:26,140",
    "end": "02:02:27,100",
    "start_sec": 7346.14,
    "end_sec": 7347.1,
    "zh": "谁有诡异",
    "vi": "Chỉ có thể là quỷ dị"
  },
  {
    "idx": 4497,
    "start": "02:02:27,100",
    "end": "02:02:29,180",
    "start_sec": 7347.1,
    "end_sec": 7349.18,
    "zh": "说来鬼果的效果",
    "vi": "Nói mới nhớ, hiệu quả của quả quỷ"
  },
  {
    "idx": 4498,
    "start": "02:02:29,180",
    "end": "02:02:30,320",
    "start_sec": 7349.18,
    "end_sec": 7350.32,
    "zh": "你知道是什么",
    "vi": "Ngươi có biết là gì không."
  },
  {
    "idx": 4499,
    "start": "02:02:30,320",
    "end": "02:02:31,200",
    "start_sec": 7350.32,
    "end_sec": 7351.2,
    "zh": "不清楚",
    "vi": "Không rõ nữa"
  },
  {
    "idx": 4500,
    "start": "02:02:31,200",
    "end": "02:02:34,100",
    "start_sec": 7351.2,
    "end_sec": 7354.1,
    "zh": "那个鬼域里存在太多不确定因素",
    "vi": "Trong quỷ vực đó có quá nhiều yếu tố không xác định"
  },
  {
    "idx": 4501,
    "start": "02:02:34,100",
    "end": "02:02:37,320",
    "start_sec": 7354.1,
    "end_sec": 7357.32,
    "zh": "我在一间荒庙里发现鬼树的种子",
    "vi": "Tôi tìm thấy hạt của cây quỷ trong một ngôi đền hoang"
  },
  {
    "idx": 4502,
    "start": "02:02:37,320",
    "end": "02:02:40,720",
    "start_sec": 7357.32,
    "end_sec": 7360.72,
    "zh": "荒庙的壁画上倒是撞客的人吞服鬼果后",
    "vi": "Trên bức bích họa của ngôi đền hoang có ghi lại việc người bị ám"
  },
  {
    "idx": 4503,
    "start": "02:02:40,720",
    "end": "02:02:42,080",
    "start_sec": 7360.72,
    "end_sec": 7362.08,
    "zh": "获得力量的记载",
    "vi": "ăn quả quỷ để có được sức mạnh"
  },
  {
    "idx": 4504,
    "start": "02:02:42,080",
    "end": "02:02:43,860",
    "start_sec": 7362.08,
    "end_sec": 7363.86,
    "zh": "至于鬼果是什么能力",
    "vi": "Còn về khả năng của quả quỷ"
  },
  {
    "idx": 4505,
    "start": "02:02:43,860",
    "end": "02:02:45,340",
    "start_sec": 7363.86,
    "end_sec": 7365.34,
    "zh": "可能因人而异吧",
    "vi": "có lẽ tùy thuộc vào mỗi người"
  },
  {
    "idx": 4506,
    "start": "02:02:45,340",
    "end": "02:02:46,840",
    "start_sec": 7365.34,
    "end_sec": 7366.84,
    "zh": "就在两人闲谈之间",
    "vi": "Trong lúc hai người đang trò chuyện"
  },
  {
    "idx": 4507,
    "start": "02:02:46,840",
    "end": "02:02:49,520",
    "start_sec": 7366.84,
    "end_sec": 7369.52,
    "zh": "鬼树上的所有人脸起起痛苦哀嚎着",
    "vi": "Những khuôn mặt trên cây quỷ bắt đầu đau đớn kêu gào"
  },
  {
    "idx": 4508,
    "start": "02:02:49,520",
    "end": "02:02:51,800",
    "start_sec": 7369.52,
    "end_sec": 7371.8,
    "zh": "随后鬼树上的扭曲的脸屁股",
    "vi": "Sau đó những khuôn mặt méo mó trên cây quỷ"
  },
  {
    "idx": 4509,
    "start": "02:02:51,800",
    "end": "02:02:54,020",
    "start_sec": 7371.8,
    "end_sec": 7374.02,
    "zh": "缓缓成为了一张巨大的人脸",
    "vi": "dần biến thành một khuôn mặt người khổng lồ"
  },
  {
    "idx": 4510,
    "start": "02:02:54,020",
    "end": "02:02:55,180",
    "start_sec": 7374.02,
    "end_sec": 7375.18,
    "zh": "果实熟了",
    "vi": "Quả đã chín rồi"
  },
  {
    "idx": 4511,
    "start": "02:02:55,180",
    "end": "02:02:56,980",
    "start_sec": 7375.18,
    "end_sec": 7376.98,
    "zh": "老庙主刚想伸手去接",
    "vi": "Chủ đền già vừa định đưa tay ra đón"
  },
  {
    "idx": 4512,
    "start": "02:02:56,980",
    "end": "02:03:00,380",
    "start_sec": 7376.98,
    "end_sec": 7380.38,
    "zh": "037",
    "vi": "037"
  },
  {
    "idx": 4513,
    "start": "02:03:00,380",
    "end": "02:03:01,440",
    "start_sec": 7380.38,
    "end_sec": 7381.44,
    "zh": "你想干什么",
    "vi": "Ngươi muốn làm gì"
  },
  {
    "idx": 4514,
    "start": "02:03:01,440",
    "end": "02:03:02,580",
    "start_sec": 7381.44,
    "end_sec": 7382.58,
    "zh": "032",
    "vi": "032"
  },
  {
    "idx": 4515,
    "start": "02:03:02,580",
    "end": "02:03:03,120",
    "start_sec": 7382.58,
    "end_sec": 7383.12,
    "zh": "不好意思",
    "vi": "Xin lỗi"
  },
  {
    "idx": 4516,
    "start": "02:03:03,120",
    "end": "02:03:05,560",
    "start_sec": 7383.12,
    "end_sec": 7385.56,
    "zh": "我体内的鬼衣也快压制不住了",
    "vi": "Thứ gọi là \"quỷ y\" trong người ta sắp không kìm nén được nữa rồi"
  },
  {
    "idx": 4517,
    "start": "02:03:05,560",
    "end": "02:03:08,020",
    "start_sec": 7385.56,
    "end_sec": 7388.02,
    "zh": "我觉得这个鬼衣用我来接纳比较好",
    "vi": "Ta nghĩ thứ \"quỷ y\" này nên do ta tiếp nhận thì tốt hơn"
  },
  {
    "idx": 4518,
    "start": "02:03:08,020",
    "end": "02:03:08,640",
    "start_sec": 7388.02,
    "end_sec": 7388.64,
    "zh": "说着",
    "vi": "Nói rồi"
  },
  {
    "idx": 4519,
    "start": "02:03:08,640",
    "end": "02:03:10,380",
    "start_sec": 7388.64,
    "end_sec": 7390.38,
    "zh": "037只要吞服果实",
    "vi": "037 chỉ cần nuốt quả này"
  },
  {
    "idx": 4520,
    "start": "02:03:10,380",
    "end": "02:03:12,580",
    "start_sec": 7390.38,
    "end_sec": 7392.58,
    "zh": "老子辛辛苦苦不取一个月",
    "vi": "Lão tử vất vả lắm mới có được"
  },
  {
    "idx": 4521,
    "start": "02:03:12,580",
    "end": "02:03:14,720",
    "start_sec": 7392.58,
    "end_sec": 7394.72,
    "zh": "你以为是你想要就能要的",
    "vi": "Ngươi tưởng ngươi muốn là có được sao"
  },
  {
    "idx": 4522,
    "start": "02:03:14,720",
    "end": "02:03:18,820",
    "start_sec": 7394.72,
    "end_sec": 7398.82,
    "zh": "老庙主无比的袖口摇晃起来",
    "vi": "Chủ đền già lắc mạnh ống tay áo"
  },
  {
    "idx": 4523,
    "start": "02:03:18,820",
    "end": "02:03:21,080",
    "start_sec": 7398.82,
    "end_sec": 7401.08,
    "zh": "一只指手猛然不算袖口窜出",
    "vi": "Một ngón tay đột nhiên thò ra khỏi ống tay áo"
  },
  {
    "idx": 4524,
    "start": "02:03:21,080",
    "end": "02:03:21,860",
    "start_sec": 7401.08,
    "end_sec": 7401.86,
    "zh": "指晃",
    "vi": "Chỉ vào"
  },
  {
    "idx": 4525,
    "start": "02:03:21,860",
    "end": "02:03:24,140",
    "start_sec": 7401.86,
    "end_sec": 7404.14,
    "zh": "037头发居然渐渐转白",
    "vi": "037 tóc đột nhiên chuyển sang màu trắng"
  },
  {
    "idx": 4526,
    "start": "02:03:24,140",
    "end": "02:03:24,920",
    "start_sec": 7404.14,
    "end_sec": 7404.92,
    "zh": "变成纸片",
    "vi": "Biến thành giấy"
  },
  {
    "idx": 4527,
    "start": "02:03:24,920",
    "end": "02:03:26,820",
    "start_sec": 7404.92,
    "end_sec": 7406.82,
    "zh": "给老子把鬼果放下",
    "vi": "Trả quả quỷ đây cho ta"
  },
  {
    "idx": 4528,
    "start": "02:03:26,820",
    "end": "02:03:29,740",
    "start_sec": 7406.82,
    "end_sec": 7409.74,
    "zh": "被前线淘汰下来",
    "vi": "Bị loại khỏi tiền tuyến"
  },
  {
    "idx": 4529,
    "start": "02:03:29,740",
    "end": "02:03:31,200",
    "start_sec": 7409.74,
    "end_sec": 7411.2,
    "zh": "只负责撤退的老东西",
    "vi": "Chỉ phụ trách rút lui, đồ già"
  },
  {
    "idx": 4530,
    "start": "02:03:31,200",
    "end": "02:03:32,640",
    "start_sec": 7411.2,
    "end_sec": 7412.64,
    "zh": "真以为我怕了你",
    "vi": "Ngươi tưởng ta sợ ngươi sao"
  },
  {
    "idx": 4531,
    "start": "02:03:32,640",
    "end": "02:03:35,240",
    "start_sec": 7412.64,
    "end_sec": 7415.24,
    "zh": "直接零三七头发红着",
    "vi": "Tóc của số 037 lập tức đỏ rực lên."
  },
  {
    "idx": 4532,
    "start": "02:03:35,240",
    "end": "02:03:36,640",
    "start_sec": 7415.24,
    "end_sec": 7416.64,
    "zh": "向老庙主诉读",
    "vi": "Gào thét về phía lão miếu chủ."
  },
  {
    "idx": 4533,
    "start": "02:03:36,640",
    "end": "02:03:38,840",
    "start_sec": 7416.64,
    "end_sec": 7418.84,
    "zh": "好",
    "vi": "Được lắm."
  },
  {
    "idx": 4534,
    "start": "02:03:38,840",
    "end": "02:03:40,780",
    "start_sec": 7418.84,
    "end_sec": 7420.78,
    "zh": "老东西居然用假身",
    "vi": "Lão già kia dám dùng thân xác giả."
  },
  {
    "idx": 4535,
    "start": "02:03:40,780",
    "end": "02:03:42,000",
    "start_sec": 7420.78,
    "end_sec": 7422.0,
    "zh": "老东西",
    "vi": "Lão già kia."
  },
  {
    "idx": 4536,
    "start": "02:03:42,000",
    "end": "02:03:42,840",
    "start_sec": 7422.0,
    "end_sec": 7422.84,
    "zh": "你躲哪呢",
    "vi": "Ngươi trốn ở đâu rồi."
  },
  {
    "idx": 4537,
    "start": "02:03:42,840",
    "end": "02:03:43,920",
    "start_sec": 7422.84,
    "end_sec": 7423.92,
    "zh": "用假身防我",
    "vi": "Dùng thân xác giả để đề phòng ta."
  },
  {
    "idx": 4538,
    "start": "02:03:43,920",
    "end": "02:03:45,320",
    "start_sec": 7423.92,
    "end_sec": 7425.32,
    "zh": "是不是一早就猜到",
    "vi": "Có phải ngay từ đầu đã đoán được."
  },
  {
    "idx": 4539,
    "start": "02:03:45,320",
    "end": "02:03:46,400",
    "start_sec": 7425.32,
    "end_sec": 7426.4,
    "zh": "我会抢鬼果",
    "vi": "Ta sẽ cướp quả quỷ."
  },
  {
    "idx": 4540,
    "start": "02:03:46,400",
    "end": "02:03:47,300",
    "start_sec": 7426.4,
    "end_sec": 7427.3,
    "zh": "既然如此",
    "vi": "Đã như vậy."
  },
  {
    "idx": 4541,
    "start": "02:03:47,300",
    "end": "02:03:48,420",
    "start_sec": 7427.3,
    "end_sec": 7428.42,
    "zh": "那我先把鬼果",
    "vi": "Thì ta sẽ ăn quả quỷ trước."
  },
  {
    "idx": 4542,
    "start": "02:03:48,420",
    "end": "02:03:49,380",
    "start_sec": 7428.42,
    "end_sec": 7429.38,
    "zh": "吃鬼果",
    "vi": "Ăn quả quỷ."
  },
  {
    "idx": 4543,
    "start": "02:03:49,380",
    "end": "02:03:50,600",
    "start_sec": 7429.38,
    "end_sec": 7430.6,
    "zh": "你也要有嘴巴",
    "vi": "Ngươi cũng phải có miệng mới ăn được chứ."
  },
  {
    "idx": 4544,
    "start": "02:03:50,600",
    "end": "02:03:51,840",
    "start_sec": 7430.6,
    "end_sec": 7431.84,
    "zh": "老庙主的话音",
    "vi": "Giọng nói của lão miếu chủ."
  },
  {
    "idx": 4545,
    "start": "02:03:51,840",
    "end": "02:03:53,880",
    "start_sec": 7431.84,
    "end_sec": 7433.88,
    "zh": "从殿堂四面八方飘来",
    "vi": "Vang lên từ khắp bốn phương tám hướng trong điện thờ."
  },
  {
    "idx": 4546,
    "start": "02:03:53,880",
    "end": "02:03:54,900",
    "start_sec": 7433.88,
    "end_sec": 7434.9,
    "zh": "伴随话音落下",
    "vi": "Ngay khi giọng nói vừa dứt."
  },
  {
    "idx": 4547,
    "start": "02:03:54,900",
    "end": "02:03:57,620",
    "start_sec": 7434.9,
    "end_sec": 7437.62,
    "zh": "037的嘴巴竟然被纸画粘合在一起",
    "vi": "Miệng của số 037 bỗng nhiên bị dính chặt lại như tranh giấy."
  },
  {
    "idx": 4548,
    "start": "02:03:57,620",
    "end": "02:03:59,840",
    "start_sec": 7437.62,
    "end_sec": 7439.84,
    "zh": "随即他喉咙里竟然发出无意",
    "vi": "Ngay sau đó trong cổ họng hắn phát ra tiếng rên rỉ."
  },
  {
    "idx": 4549,
    "start": "02:03:59,840",
    "end": "02:04:00,640",
    "start_sec": 7439.84,
    "end_sec": 7440.64,
    "zh": "裙子",
    "vi": "Váy."
  },
  {
    "idx": 4550,
    "start": "02:04:00,640",
    "end": "02:04:01,780",
    "start_sec": 7440.64,
    "end_sec": 7441.78,
    "zh": "我要穿裙子",
    "vi": "Tôi muốn mặc váy."
  },
  {
    "idx": 4551,
    "start": "02:04:01,780",
    "end": "02:04:02,500",
    "start_sec": 7441.78,
    "end_sec": 7442.5,
    "zh": "该死",
    "vi": "Khốn kiếp."
  },
  {
    "idx": 4552,
    "start": "02:04:02,500",
    "end": "02:04:03,420",
    "start_sec": 7442.5,
    "end_sec": 7443.42,
    "zh": "裙子",
    "vi": "Váy."
  },
  {
    "idx": 4553,
    "start": "02:04:03,420",
    "end": "02:04:05,940",
    "start_sec": 7443.42,
    "end_sec": 7445.94,
    "zh": "我操",
    "vi": "Vãi thật."
  },
  {
    "idx": 4554,
    "start": "02:04:05,940",
    "end": "02:04:07,220",
    "start_sec": 7445.94,
    "end_sec": 7447.22,
    "zh": "果然这还是老的辣",
    "vi": "Quả nhiên gừng càng già càng cay."
  },
  {
    "idx": 4555,
    "start": "02:04:07,220",
    "end": "02:04:08,820",
    "start_sec": 7447.22,
    "end_sec": 7448.82,
    "zh": "037这神志不清的模样",
    "vi": "Dáng vẻ thần trí điên loạn này của số 037."
  },
  {
    "idx": 4556,
    "start": "02:04:08,820",
    "end": "02:04:10,880",
    "start_sec": 7448.82,
    "end_sec": 7450.88,
    "zh": "比上次在医院见到还要严重",
    "vi": "Còn nghiêm trọng hơn lần trước gặp ở bệnh viện."
  },
  {
    "idx": 4557,
    "start": "02:04:10,880",
    "end": "02:04:12,180",
    "start_sec": 7450.88,
    "end_sec": 7452.18,
    "zh": "032",
    "vi": "Số 032."
  },
  {
    "idx": 4558,
    "start": "02:04:12,180",
    "end": "02:04:13,220",
    "start_sec": 7452.18,
    "end_sec": 7453.22,
    "zh": "鬼鬼我不要了",
    "vi": "Quả quỷ tôi không cần nữa đâu."
  },
  {
    "idx": 4559,
    "start": "02:04:13,220",
    "end": "02:04:13,940",
    "start_sec": 7453.22,
    "end_sec": 7453.94,
    "zh": "放过我",
    "vi": "Tha cho tôi đi."
  },
  {
    "idx": 4560,
    "start": "02:04:13,940",
    "end": "02:04:14,980",
    "start_sec": 7453.94,
    "end_sec": 7454.98,
    "zh": "放过我",
    "vi": "Tha cho tôi đi."
  },
  {
    "idx": 4561,
    "start": "02:04:14,980",
    "end": "02:04:17,280",
    "start_sec": 7454.98,
    "end_sec": 7457.28,
    "zh": "两个老妙兔没再发出任何声音",
    "vi": "Hai lão chủ miếu không còn phát ra bất kỳ âm thanh nào nữa."
  },
  {
    "idx": 4562,
    "start": "02:04:17,280",
    "end": "02:04:19,580",
    "start_sec": 7457.28,
    "end_sec": 7459.58,
    "zh": "随着037纸画程度越来越深",
    "vi": "Khi Lâm Tam Thất ngày càng bị hóa thành giấy."
  },
  {
    "idx": 4563,
    "start": "02:04:19,580",
    "end": "02:04:20,740",
    "start_sec": 7459.58,
    "end_sec": 7460.74,
    "zh": "他已经神志不清",
    "vi": "Hắn đã không còn tỉnh táo nữa."
  },
  {
    "idx": 4564,
    "start": "02:04:20,740",
    "end": "02:04:22,940",
    "start_sec": 7460.74,
    "end_sec": 7462.94,
    "zh": "体内的女鬼占据主导地位",
    "vi": "Con quỷ cái trong người đã chiếm quyền kiểm soát."
  },
  {
    "idx": 4565,
    "start": "02:04:22,940",
    "end": "02:04:25,180",
    "start_sec": 7462.94,
    "end_sec": 7465.18,
    "zh": "裙子 我要裙子",
    "vi": "Váy, ta muốn váy."
  },
  {
    "idx": 4566,
    "start": "02:04:25,180",
    "end": "02:04:26,260",
    "start_sec": 7465.18,
    "end_sec": 7466.26,
    "zh": "老不停一难着",
    "vi": "Hắn cứ lẩm bẩm không ngừng."
  },
  {
    "idx": 4567,
    "start": "02:04:26,260",
    "end": "02:04:27,860",
    "start_sec": 7466.26,
    "end_sec": 7467.86,
    "zh": "将鬼果随手丢在地上",
    "vi": "Rồi tiện tay ném quả quỷ xuống đất."
  },
  {
    "idx": 4568,
    "start": "02:04:27,860",
    "end": "02:04:29,080",
    "start_sec": 7467.86,
    "end_sec": 7469.08,
    "zh": "快步走向院落里",
    "vi": "Hắn nhanh chân đi về phía sân viện."
  },
  {
    "idx": 4569,
    "start": "02:04:29,080",
    "end": "02:04:30,820",
    "start_sec": 7469.08,
    "end_sec": 7470.82,
    "zh": "一个穿着裙子的昏迷少女",
    "vi": "Nơi có một thiếu nữ mặc váy đang hôn mê."
  },
  {
    "idx": 4570,
    "start": "02:04:30,820",
    "end": "02:04:31,720",
    "start_sec": 7470.82,
    "end_sec": 7471.72,
    "zh": "裙子",
    "vi": "Váy."
  },
  {
    "idx": 4571,
    "start": "02:04:31,720",
    "end": "02:04:32,900",
    "start_sec": 7471.72,
    "end_sec": 7472.9,
    "zh": "此时的林三七",
    "vi": "Lúc này Lâm Tam Thất."
  },
  {
    "idx": 4572,
    "start": "02:04:32,900",
    "end": "02:04:34,600",
    "start_sec": 7472.9,
    "end_sec": 7474.6,
    "zh": "已经完全转化为女鬼",
    "vi": "Đã hoàn toàn biến thành con quỷ cái."
  },
  {
    "idx": 4573,
    "start": "02:04:34,600",
    "end": "02:04:37,540",
    "start_sec": 7474.6,
    "end_sec": 7477.54,
    "zh": "她小精力地扒掉那少女的裙子",
    "vi": "Cô ta vội vàng lột chiếc váy của thiếu nữ kia ra."
  },
  {
    "idx": 4574,
    "start": "02:04:37,540",
    "end": "02:04:40,840",
    "start_sec": 7477.54,
    "end_sec": 7480.84,
    "zh": "一张白纸从房梁上飘落",
    "vi": "Một tờ giấy trắng từ trên xà nhà rơi xuống."
  },
  {
    "idx": 4575,
    "start": "02:04:40,840",
    "end": "02:04:43,000",
    "start_sec": 7480.84,
    "end_sec": 7483.0,
    "zh": "去一间化为老庙主中的",
    "vi": "Ngay lập tức biến thành lão chủ miếu."
  },
  {
    "idx": 4576,
    "start": "02:04:43,000",
    "end": "02:04:45,120",
    "start_sec": 7483.0,
    "end_sec": 7485.12,
    "zh": "我的东西谁也不能觊觎",
    "vi": "Đồ của ta thì không kẻ nào được phép tơ tưởng."
  },
  {
    "idx": 4577,
    "start": "02:04:45,120",
    "end": "02:04:47,040",
    "start_sec": 7485.12,
    "end_sec": 7487.04,
    "zh": "说着老庙主拿起鬼果",
    "vi": "Nói rồi lão chủ miếu nhặt quả quỷ lên."
  },
  {
    "idx": 4578,
    "start": "02:04:47,040",
    "end": "02:04:48,120",
    "start_sec": 7487.04,
    "end_sec": 7488.12,
    "zh": "一口吞咽下去",
    "vi": "Nuốt chửng nó vào bụng."
  },
  {
    "idx": 4579,
    "start": "02:04:48,120",
    "end": "02:04:52,500",
    "start_sec": 7488.12,
    "end_sec": 7492.5,
    "zh": "老庙主那纸画的手臂",
    "vi": "Cánh tay bị hóa giấy của lão chủ miếu."
  },
  {
    "idx": 4580,
    "start": "02:04:52,500",
    "end": "02:04:53,760",
    "start_sec": 7492.5,
    "end_sec": 7493.76,
    "zh": "逐渐有了血色",
    "vi": "Dần dần hồng hào trở lại."
  },
  {
    "idx": 4581,
    "start": "02:04:53,760",
    "end": "02:04:54,520",
    "start_sec": 7493.76,
    "end_sec": 7494.52,
    "zh": "成了",
    "vi": "Thành công rồi."
  },
  {
    "idx": 4582,
    "start": "02:04:54,520",
    "end": "02:04:57,728",
    "start_sec": 7494.52,
    "end_sec": 7497.728,
    "zh": "两个诡异际身果然能相互遏制老妙柱心血挥舞了手臂老杂驴你挥什么挥老妙主猛然低头看向手臂手臂依旧在肿胀",
    "vi": "Hai thực thể quỷ dị ký sinh quả nhiên có thể kiềm chế lẫn nhau"
  },
  {
    "idx": 4582,
    "start": "02:04:57,728",
    "end": "02:04:59,653",
    "start_sec": 7497.728,
    "end_sec": 7499.653,
    "zh": "两个诡异际身果然能相互遏制老妙柱心血挥舞了手臂老杂驴你挥什么挥老妙主猛然低头看向手臂手臂依旧在肿胀",
    "vi": "Lão chủ miếu vui mừng vung vẩy cánh tay"
  },
  {
    "idx": 4582,
    "start": "02:04:59,653",
    "end": "02:05:01,578",
    "start_sec": 7499.653,
    "end_sec": 7501.578,
    "zh": "两个诡异际身果然能相互遏制老妙柱心血挥舞了手臂老杂驴你挥什么挥老妙主猛然低头看向手臂手臂依旧在肿胀",
    "vi": "Lão già kia, ngươi vung vẩy cái gì thế"
  },
  {
    "idx": 4582,
    "start": "02:05:01,578",
    "end": "02:05:03,930",
    "start_sec": 7501.578,
    "end_sec": 7503.93,
    "zh": "两个诡异际身果然能相互遏制老妙柱心血挥舞了手臂老杂驴你挥什么挥老妙主猛然低头看向手臂手臂依旧在肿胀",
    "vi": "Lão chủ miếu đột nhiên cúi đầu nhìn xuống cánh tay"
  },
  {
    "idx": 4582,
    "start": "02:05:03,930",
    "end": "02:05:05,426",
    "start_sec": 7503.93,
    "end_sec": 7505.426,
    "zh": "两个诡异际身果然能相互遏制老妙柱心血挥舞了手臂老杂驴你挥什么挥老妙主猛然低头看向手臂手臂依旧在肿胀",
    "vi": "Cánh tay vẫn đang sưng phồng lên"
  },
  {
    "idx": 4583,
    "start": "02:05:05,426",
    "end": "02:05:06,826",
    "start_sec": 7505.426,
    "end_sec": 7506.826,
    "zh": "缓缓长出一个肉团",
    "vi": "Từ từ mọc ra một cục thịt."
  },
  {
    "idx": 4584,
    "start": "02:05:06,826",
    "end": "02:05:07,306",
    "start_sec": 7506.826,
    "end_sec": 7507.306,
    "zh": "接着",
    "vi": "Tiếp đó."
  },
  {
    "idx": 4585,
    "start": "02:05:07,306",
    "end": "02:05:09,326",
    "start_sec": 7507.306,
    "end_sec": 7509.326,
    "zh": "那肉团上竟然出现一张人脸",
    "vi": "Trên cục thịt đó bỗng xuất hiện một khuôn mặt người."
  },
  {
    "idx": 4586,
    "start": "02:05:09,326",
    "end": "02:05:11,226",
    "start_sec": 7509.326,
    "end_sec": 7511.226,
    "zh": "赫然就是老妙主自己的脸",
    "vi": "Đó chính là khuôn mặt của lão chủ miếu."
  },
  {
    "idx": 4587,
    "start": "02:05:11,226",
    "end": "02:05:11,746",
    "start_sec": 7511.226,
    "end_sec": 7511.746,
    "zh": "你",
    "vi": "Ngươi."
  },
  {
    "idx": 4588,
    "start": "02:05:11,746",
    "end": "02:05:13,766",
    "start_sec": 7511.746,
    "end_sec": 7513.766,
    "zh": "你就是鬼国里的诡异",
    "vi": "Ngươi chính là thực thể quỷ dị trong quả quỷ."
  },
  {
    "idx": 4589,
    "start": "02:05:13,766",
    "end": "02:05:14,466",
    "start_sec": 7513.766,
    "end_sec": 7514.466,
    "zh": "嘿嘿嘿",
    "vi": "Hắc hắc hắc."
  },
  {
    "idx": 4590,
    "start": "02:05:14,466",
    "end": "02:05:15,206",
    "start_sec": 7514.466,
    "end_sec": 7515.206,
    "zh": "老东西",
    "vi": "Lão già kia."
  },
  {
    "idx": 4591,
    "start": "02:05:15,206",
    "end": "02:05:16,426",
    "start_sec": 7515.206,
    "end_sec": 7516.426,
    "zh": "你养育了我",
    "vi": "Ngươi nuôi dưỡng ta."
  },
  {
    "idx": 4592,
    "start": "02:05:16,426",
    "end": "02:05:17,766",
    "start_sec": 7516.426,
    "end_sec": 7517.766,
    "zh": "你为的保我吗",
    "vi": "Ngươi là vì muốn bảo vệ ta sao."
  },
  {
    "idx": 4593,
    "start": "02:05:17,766",
    "end": "02:05:19,766",
    "start_sec": 7517.766,
    "end_sec": 7519.766,
    "zh": "那人脸顺着老妙主的胳膊",
    "vi": "Khuôn mặt người đó men theo cánh tay của lão chủ miếu."
  },
  {
    "idx": 4594,
    "start": "02:05:19,766",
    "end": "02:05:20,746",
    "start_sec": 7519.766,
    "end_sec": 7520.746,
    "zh": "向着脖子主动",
    "vi": "Di chuyển về phía cổ."
  },
  {
    "idx": 4595,
    "start": "02:05:20,746",
    "end": "02:05:22,026",
    "start_sec": 7520.746,
    "end_sec": 7522.026,
    "zh": "你想要干什么",
    "vi": "Ngươi muốn làm gì."
  },
  {
    "idx": 4596,
    "start": "02:05:22,026",
    "end": "02:05:22,846",
    "start_sec": 7522.026,
    "end_sec": 7522.846,
    "zh": "饿了",
    "vi": "Đói rồi."
  },
  {
    "idx": 4597,
    "start": "02:05:22,846",
    "end": "02:05:23,966",
    "start_sec": 7522.846,
    "end_sec": 7523.966,
    "zh": "要吃东西",
    "vi": "Ta muốn ăn."
  },
  {
    "idx": 4598,
    "start": "02:05:24,166",
    "end": "02:05:24,646",
    "start_sec": 7524.166,
    "end_sec": 7524.646,
    "zh": "八蛋",
    "vi": "Khốn kiếp."
  },
  {
    "idx": 4599,
    "start": "02:05:24,646",
    "end": "02:05:26,686",
    "start_sec": 7524.646,
    "end_sec": 7526.686,
    "zh": "我要你知道谁才是主人",
    "vi": "Ta phải cho ngươi biết ai mới là chủ nhân."
  },
  {
    "idx": 4600,
    "start": "02:05:26,686",
    "end": "02:05:27,366",
    "start_sec": 7526.686,
    "end_sec": 7527.366,
    "zh": "指望",
    "vi": "Mơ tưởng sao."
  },
  {
    "idx": 4601,
    "start": "02:05:27,366",
    "end": "02:05:29,246",
    "start_sec": 7527.366,
    "end_sec": 7529.246,
    "zh": "不曾想人脸怪笑一声",
    "vi": "Không ngờ khuôn mặt người cười quái dị một tiếng."
  },
  {
    "idx": 4602,
    "start": "02:05:29,246",
    "end": "02:05:30,906",
    "start_sec": 7529.246,
    "end_sec": 7530.906,
    "zh": "半面满面的一片血",
    "vi": "Nửa khuôn mặt đầy máu."
  },
  {
    "idx": 4603,
    "start": "02:05:30,906",
    "end": "02:05:32,846",
    "start_sec": 7530.906,
    "end_sec": 7532.846,
    "zh": "老庙主的脖子冰冰的",
    "vi": "Cổ của lão chủ miếu lạnh toát."
  },
  {
    "idx": 4604,
    "start": "02:05:32,846",
    "end": "02:05:34,246",
    "start_sec": 7532.846,
    "end_sec": 7534.246,
    "zh": "咬着一牌子",
    "vi": "Bị cắn một phát."
  },
  {
    "idx": 4605,
    "start": "02:05:34,246",
    "end": "02:05:35,866",
    "start_sec": 7534.246,
    "end_sec": 7535.866,
    "zh": "一脸不可置信的捆络着腿上",
    "vi": "Lão quỳ sụp xuống đất với vẻ mặt không thể tin nổi."
  },
  {
    "idx": 4606,
    "start": "02:05:35,866",
    "end": "02:05:38,226",
    "start_sec": 7535.866,
    "end_sec": 7538.226,
    "zh": "人脸瞬息的喷油的鲜血",
    "vi": "Khuôn mặt người lập tức đẫm máu tươi."
  },
  {
    "idx": 4607,
    "start": "02:05:38,226",
    "end": "02:05:40,286",
    "start_sec": 7538.226,
    "end_sec": 7540.286,
    "zh": "缓缓爬到老庙主脑子的位置",
    "vi": "Từ từ bò lên vị trí đầu của lão chủ miếu."
  },
  {
    "idx": 4608,
    "start": "02:05:40,286",
    "end": "02:05:41,846",
    "start_sec": 7540.286,
    "end_sec": 7541.846,
    "zh": "化了老庙主的脑子",
    "vi": "Ăn mòn bộ não của lão chủ miếu."
  },
  {
    "idx": 4609,
    "start": "02:05:41,846",
    "end": "02:05:45,006",
    "start_sec": 7541.846,
    "end_sec": 7545.006,
    "zh": "看来还是我更适合当主人",
    "vi": "Xem ra ta vẫn thích hợp làm chủ nhân hơn."
  },
  {
    "idx": 4610,
    "start": "02:05:45,006",
    "end": "02:05:46,446",
    "start_sec": 7545.006,
    "end_sec": 7546.446,
    "zh": "妈的",
    "vi": "Mẹ kiếp."
  },
  {
    "idx": 4611,
    "start": "02:05:46,446",
    "end": "02:05:48,346",
    "start_sec": 7546.446,
    "end_sec": 7548.346,
    "zh": "这四老头到底咬着什么怪",
    "vi": "Lão già này rốt cuộc đã nuôi thứ quái vật gì vậy."
  },
  {
    "idx": 4612,
    "start": "02:05:48,346",
    "end": "02:05:50,346",
    "start_sec": 7548.346,
    "end_sec": 7550.346,
    "zh": "长子皮把头埋在土里",
    "vi": "Trương Tử Bì chôn đầu vào trong đất."
  },
  {
    "idx": 4613,
    "start": "02:05:50,346",
    "end": "02:05:51,646",
    "start_sec": 7550.346,
    "end_sec": 7551.646,
    "zh": "动也不敢动",
    "vi": "Không dám động đậy chút nào."
  },
  {
    "idx": 4614,
    "start": "02:05:51,646",
    "end": "02:05:54,566",
    "start_sec": 7551.646,
    "end_sec": 7554.566,
    "zh": "喂",
    "vi": "Này."
  },
  {
    "idx": 4615,
    "start": "02:05:54,566",
    "end": "02:05:55,606",
    "start_sec": 7554.566,
    "end_sec": 7555.606,
    "zh": "小东西",
    "vi": "Nhóc con."
  },
  {
    "idx": 4616,
    "start": "02:05:55,606",
    "end": "02:05:56,986",
    "start_sec": 7555.606,
    "end_sec": 7556.986,
    "zh": "给我滚过来",
    "vi": "Cút qua đây cho ta."
  },
  {
    "idx": 4617,
    "start": "02:05:56,986",
    "end": "02:05:57,866",
    "start_sec": 7556.986,
    "end_sec": 7557.866,
    "zh": "我饿了",
    "vi": "Ta đói rồi."
  },
  {
    "idx": 4618,
    "start": "02:05:57,866",
    "end": "02:05:58,946",
    "start_sec": 7557.866,
    "end_sec": 7558.946,
    "zh": "站在老庙中",
    "vi": "Đứng trên đầu lão chủ miếu."
  },
  {
    "idx": 4619,
    "start": "02:05:58,946",
    "end": "02:05:59,666",
    "start_sec": 7558.946,
    "end_sec": 7559.666,
    "zh": "脑袋的鬼",
    "vi": "Con quỷ đó."
  },
  {
    "idx": 4620,
    "start": "02:05:59,666",
    "end": "02:06:00,786",
    "start_sec": 7559.666,
    "end_sec": 7560.786,
    "zh": "指向院落里",
    "vi": "Chỉ vào trong sân."
  },
  {
    "idx": 4621,
    "start": "02:06:00,786",
    "end": "02:06:02,706",
    "start_sec": 7560.786,
    "end_sec": 7562.706,
    "zh": "还在欣赏自己裙子的鬼魂",
    "vi": "Con ma vẫn đang ngắm nghía chiếc váy của mình."
  },
  {
    "idx": 4622,
    "start": "02:06:02,706",
    "end": "02:06:04,486",
    "start_sec": 7562.706,
    "end_sec": 7564.486,
    "zh": "随后抬脚走向院里",
    "vi": "Sau đó nó nhấc chân bước vào sân."
  },
  {
    "idx": 4623,
    "start": "02:06:04,486",
    "end": "02:06:06,106",
    "start_sec": 7564.486,
    "end_sec": 7566.106,
    "zh": "身后是长发女鬼",
    "vi": "Phía sau là con ma nữ tóc dài."
  },
  {
    "idx": 4624,
    "start": "02:06:06,106",
    "end": "02:06:07,206",
    "start_sec": 7566.106,
    "end_sec": 7567.206,
    "zh": "身前是猛狗鬼",
    "vi": "Phía trước là con ma chó dữ."
  },
  {
    "idx": 4625,
    "start": "02:06:07,206",
    "end": "02:06:07,746",
    "start_sec": 7567.206,
    "end_sec": 7567.746,
    "zh": "妈的",
    "vi": "Chết tiệt."
  },
  {
    "idx": 4626,
    "start": "02:06:07,746",
    "end": "02:06:09,306",
    "start_sec": 7567.746,
    "end_sec": 7569.306,
    "zh": "原本两两相争的遇鬼者",
    "vi": "Những kẻ gặp ma vốn đang tranh đấu với nhau."
  },
  {
    "idx": 4627,
    "start": "02:06:09,306",
    "end": "02:06:10,846",
    "start_sec": 7569.306,
    "end_sec": 7570.846,
    "zh": "到最后都变成了鬼",
    "vi": "Cuối cùng đều biến thành ma cả rồi."
  },
  {
    "idx": 4628,
    "start": "02:06:10,846",
    "end": "02:06:12,086",
    "start_sec": 7570.846,
    "end_sec": 7572.086,
    "zh": "我让你滚过来",
    "vi": "Tao bảo mày cút lại đây."
  },
  {
    "idx": 4629,
    "start": "02:06:12,086",
    "end": "02:06:13,146",
    "start_sec": 7572.086,
    "end_sec": 7573.146,
    "zh": "你听不到吗",
    "vi": "Mày không nghe thấy sao."
  },
  {
    "idx": 4630,
    "start": "02:06:13,146",
    "end": "02:06:14,926",
    "start_sec": 7573.146,
    "end_sec": 7574.926,
    "zh": "长发女鬼猛然抬起",
    "vi": "Con ma nữ tóc dài bỗng nhiên ngẩng đầu lên."
  },
  {
    "idx": 4631,
    "start": "02:06:14,926",
    "end": "02:06:16,046",
    "start_sec": 7574.926,
    "end_sec": 7576.046,
    "zh": "你敢吼我",
    "vi": "Mày dám quát tao à."
  },
  {
    "idx": 4632,
    "start": "02:06:16,046",
    "end": "02:06:17,446",
    "start_sec": 7576.046,
    "end_sec": 7577.446,
    "zh": "我不光敢吼你",
    "vi": "Tao không chỉ dám quát mày."
  },
  {
    "idx": 4633,
    "start": "02:06:17,446",
    "end": "02:06:18,566",
    "start_sec": 7577.446,
    "end_sec": 7578.566,
    "zh": "我还要吃你",
    "vi": "Tao còn muốn ăn thịt mày nữa."
  },
  {
    "idx": 4634,
    "start": "02:06:18,566",
    "end": "02:06:20,286",
    "start_sec": 7578.566,
    "end_sec": 7580.286,
    "zh": "胡小人脸怪笑一声",
    "vi": "Gã mặt người cười gằn một tiếng."
  },
  {
    "idx": 4635,
    "start": "02:06:20,286",
    "end": "02:06:22,786",
    "start_sec": 7580.286,
    "end_sec": 7582.786,
    "zh": "当即就朝着长发女鬼飞奔不前",
    "vi": "Ngay lập tức lao thẳng về phía con ma nữ tóc dài."
  },
  {
    "idx": 4636,
    "start": "02:06:22,786",
    "end": "02:06:24,186",
    "start_sec": 7582.786,
    "end_sec": 7584.186,
    "zh": "长发女鬼一来",
    "vi": "Khi con ma nữ tóc dài lao tới."
  },
  {
    "idx": 4637,
    "start": "02:06:24,186",
    "end": "02:06:25,466",
    "start_sec": 7584.186,
    "end_sec": 7585.466,
    "zh": "长发宛如黑马",
    "vi": "Mái tóc dài tựa như ngựa đen."
  },
  {
    "idx": 4638,
    "start": "02:06:25,466",
    "end": "02:06:26,446",
    "start_sec": 7585.466,
    "end_sec": 7586.446,
    "zh": "分化成两团",
    "vi": "Chia làm hai luồng."
  },
  {
    "idx": 4639,
    "start": "02:06:26,446",
    "end": "02:06:27,966",
    "start_sec": 7586.446,
    "end_sec": 7587.966,
    "zh": "朝着苦笑人脸缠了",
    "vi": "Quấn lấy gã mặt người đang cười khổ."
  },
  {
    "idx": 4640,
    "start": "02:06:27,966",
    "end": "02:06:28,766",
    "start_sec": 7587.966,
    "end_sec": 7588.766,
    "zh": "刮了一转",
    "vi": "Quấn lấy một vòng."
  },
  {
    "idx": 4641,
    "start": "02:06:28,766",
    "end": "02:06:29,506",
    "start_sec": 7588.766,
    "end_sec": 7589.506,
    "zh": "苦笑人脸",
    "vi": "Gã mặt người."
  },
  {
    "idx": 4642,
    "start": "02:06:29,506",
    "end": "02:06:30,926",
    "start_sec": 7589.506,
    "end_sec": 7590.926,
    "zh": "当即就摔了个狗狮狮",
    "vi": "Ngã nhào xuống đất ngay lập tức."
  },
  {
    "idx": 4643,
    "start": "02:06:30,926",
    "end": "02:06:31,466",
    "start_sec": 7590.926,
    "end_sec": 7591.466,
    "zh": "果然",
    "vi": "Quả nhiên."
  },
  {
    "idx": 4644,
    "start": "02:06:31,466",
    "end": "02:06:32,326",
    "start_sec": 7591.466,
    "end_sec": 7592.326,
    "zh": "新生的鬼医",
    "vi": "Con quỷ mới sinh."
  },
  {
    "idx": 4645,
    "start": "02:06:32,326",
    "end": "02:06:34,086",
    "start_sec": 7592.326,
    "end_sec": 7594.086,
    "zh": "还是无法和长发女鬼抗衡",
    "vi": "Vẫn không thể đối đầu với con ma nữ tóc dài."
  },
  {
    "idx": 4646,
    "start": "02:06:34,086",
    "end": "02:06:36,286",
    "start_sec": 7594.086,
    "end_sec": 7596.286,
    "zh": "你说我美不美",
    "vi": "Mày nói xem tao có đẹp không."
  },
  {
    "idx": 4647,
    "start": "02:06:36,286",
    "end": "02:06:36,906",
    "start_sec": 7596.286,
    "end_sec": 7596.906,
    "zh": "呵呵",
    "vi": "Hừ hừ."
  },
  {
    "idx": 4648,
    "start": "02:06:36,906",
    "end": "02:06:38,526",
    "start_sec": 7596.906,
    "end_sec": 7598.526,
    "zh": "看起来确实美味",
    "vi": "Trông đúng là rất ngon miệng."
  },
  {
    "idx": 4649,
    "start": "02:06:38,526",
    "end": "02:06:39,626",
    "start_sec": 7598.526,
    "end_sec": 7599.626,
    "zh": "你不会以为",
    "vi": "Mày đừng tưởng rằng."
  },
  {
    "idx": 4650,
    "start": "02:06:39,626",
    "end": "02:06:42,266",
    "start_sec": 7599.626,
    "end_sec": 7602.266,
    "zh": "我是真一个躲不开你的头发吧",
    "vi": "Tao thực sự không né được mái tóc của mày nhé."
  },
  {
    "idx": 4651,
    "start": "02:06:42,266",
    "end": "02:06:43,606",
    "start_sec": 7602.266,
    "end_sec": 7603.606,
    "zh": "长发女鬼一正",
    "vi": "Nữ quỷ tóc dài khựng lại."
  },
  {
    "idx": 4652,
    "start": "02:06:43,606",
    "end": "02:06:44,246",
    "start_sec": 7603.606,
    "end_sec": 7604.246,
    "zh": "没来一声",
    "vi": "Chưa kịp lên tiếng."
  },
  {
    "idx": 4653,
    "start": "02:06:44,246",
    "end": "02:06:45,266",
    "start_sec": 7604.246,
    "end_sec": 7605.266,
    "zh": "她的一头长发",
    "vi": "Mái tóc dài của ả."
  },
  {
    "idx": 4654,
    "start": "02:06:45,266",
    "end": "02:06:46,506",
    "start_sec": 7605.266,
    "end_sec": 7606.506,
    "zh": "像是失去了力量",
    "vi": "Như thể đã mất đi sức mạnh."
  },
  {
    "idx": 4655,
    "start": "02:06:46,506",
    "end": "02:06:47,286",
    "start_sec": 7606.506,
    "end_sec": 7607.286,
    "zh": "乱啪啪的",
    "vi": "Rũ rượi xơ xác."
  },
  {
    "idx": 4656,
    "start": "02:06:47,286",
    "end": "02:06:48,766",
    "start_sec": 7607.286,
    "end_sec": 7608.766,
    "zh": "从苦笑人脸先上飘",
    "vi": "Rơi xuống từ trên khuôn mặt cười khổ."
  },
  {
    "idx": 4657,
    "start": "02:06:48,766",
    "end": "02:06:49,406",
    "start_sec": 7608.766,
    "end_sec": 7609.406,
    "zh": "怎么",
    "vi": "Sao thế."
  },
  {
    "idx": 4658,
    "start": "02:06:49,406",
    "end": "02:06:50,166",
    "start_sec": 7609.406,
    "end_sec": 7610.166,
    "zh": "怎么会",
    "vi": "Sao có thể chứ."
  },
  {
    "idx": 4659,
    "start": "02:06:50,166",
    "end": "02:06:53,186",
    "start_sec": 7610.166,
    "end_sec": 7613.186,
    "zh": "老兔驴",
    "vi": "Lão trọc kia."
  },
  {
    "idx": 4660,
    "start": "02:06:53,186",
    "end": "02:06:54,066",
    "start_sec": 7613.186,
    "end_sec": 7614.066,
    "zh": "你要干嘛",
    "vi": "Ngươi muốn làm gì."
  },
  {
    "idx": 4661,
    "start": "02:06:54,066",
    "end": "02:06:54,866",
    "start_sec": 7614.066,
    "end_sec": 7614.866,
    "zh": "别碰我",
    "vi": "Đừng chạm vào ta."
  },
  {
    "idx": 4662,
    "start": "02:06:54,866",
    "end": "02:06:55,966",
    "start_sec": 7614.866,
    "end_sec": 7615.966,
    "zh": "当然是",
    "vi": "Dĩ nhiên là."
  },
  {
    "idx": 4663,
    "start": "02:06:55,966",
    "end": "02:06:58,726",
    "start_sec": 7615.966,
    "end_sec": 7618.726,
    "zh": "吃了你啊",
    "vi": "Ăn thịt ngươi rồi."
  },
  {
    "idx": 4664,
    "start": "02:06:58,726",
    "end": "02:07:03,206",
    "start_sec": 7618.726,
    "end_sec": 7623.206,
    "zh": "当然是",
    "vi": "Dĩ nhiên là."
  },
  {
    "idx": 4665,
    "start": "02:07:03,206",
    "end": "02:07:04,786",
    "start_sec": 7623.206,
    "end_sec": 7624.786,
    "zh": "吃了你啊",
    "vi": "Ăn thịt ngươi rồi."
  },
  {
    "idx": 4666,
    "start": "02:07:04,786",
    "end": "02:07:12,886",
    "start_sec": 7624.786,
    "end_sec": 7632.886,
    "zh": "一出生就能吃到如此美味的鬼",
    "vi": "Vừa ra đời đã được ăn một con quỷ ngon lành thế này."
  },
  {
    "idx": 4667,
    "start": "02:07:12,886",
    "end": "02:07:14,146",
    "start_sec": 7632.886,
    "end_sec": 7634.146,
    "zh": "真爽啊",
    "vi": "Thật là sướng quá đi."
  },
  {
    "idx": 4668,
    "start": "02:07:14,146",
    "end": "02:07:17,886",
    "start_sec": 7634.146,
    "end_sec": 7637.886,
    "zh": "这就是遇鬼者的宿命啊",
    "vi": "Đây chính là số mệnh của ngự quỷ giả."
  },
  {
    "idx": 4669,
    "start": "02:07:17,886",
    "end": "02:07:20,786",
    "start_sec": 7637.886,
    "end_sec": 7640.786,
    "zh": "苦笑人脸将灵三息吞噬后",
    "vi": "Sau khi khuôn mặt cười khổ nuốt chửng linh thể."
  },
  {
    "idx": 4670,
    "start": "02:07:20,786",
    "end": "02:07:22,046",
    "start_sec": 7640.786,
    "end_sec": 7642.046,
    "zh": "向殿堂走进",
    "vi": "Nó đi về phía điện thờ."
  },
  {
    "idx": 4671,
    "start": "02:07:22,046",
    "end": "02:07:23,586",
    "start_sec": 7642.046,
    "end_sec": 7643.586,
    "zh": "橙子皮指地方眼",
    "vi": "Trần Tử Bì trợn tròn mắt."
  },
  {
    "idx": 4672,
    "start": "02:07:23,586",
    "end": "02:07:24,646",
    "start_sec": 7643.586,
    "end_sec": 7644.646,
    "zh": "不敢发出声音",
    "vi": "Cậu không dám phát ra tiếng động."
  },
  {
    "idx": 4673,
    "start": "02:07:24,646",
    "end": "02:07:25,566",
    "start_sec": 7644.646,
    "end_sec": 7645.566,
    "zh": "妈的",
    "vi": "Mẹ kiếp."
  },
  {
    "idx": 4674,
    "start": "02:07:25,566",
    "end": "02:07:26,166",
    "start_sec": 7645.566,
    "end_sec": 7646.166,
    "zh": "忍住",
    "vi": "Phải nhịn."
  },
  {
    "idx": 4675,
    "start": "02:07:26,166",
    "end": "02:07:27,926",
    "start_sec": 7646.166,
    "end_sec": 7647.926,
    "zh": "等他离开后再想办法脱身",
    "vi": "Đợi hắn rời đi rồi tìm cách thoát thân."
  },
  {
    "idx": 4676,
    "start": "02:07:27,926",
    "end": "02:07:29,346",
    "start_sec": 7647.926,
    "end_sec": 7649.346,
    "zh": "然而",
    "vi": "Thế nhưng."
  },
  {
    "idx": 4677,
    "start": "02:07:29,346",
    "end": "02:07:31,726",
    "start_sec": 7649.346,
    "end_sec": 7651.726,
    "zh": "在人面鬼经过橙子皮身前时",
    "vi": "Khi quỷ mặt người đi qua trước mặt Trần Tử Bì."
  },
  {
    "idx": 4678,
    "start": "02:07:31,726",
    "end": "02:07:32,966",
    "start_sec": 7651.726,
    "end_sec": 7652.966,
    "zh": "猛的转过头来",
    "vi": "Nó đột ngột quay đầu lại."
  },
  {
    "idx": 4679,
    "start": "02:07:32,966",
    "end": "02:07:33,886",
    "start_sec": 7652.966,
    "end_sec": 7653.886,
    "zh": "嘿嘿",
    "vi": "Hắc hắc."
  },
  {
    "idx": 4680,
    "start": "02:07:33,886",
    "end": "02:07:34,966",
    "start_sec": 7653.886,
    "end_sec": 7654.966,
    "zh": "小家伙",
    "vi": "Nhóc con."
  },
  {
    "idx": 4681,
    "start": "02:07:34,966",
    "end": "02:07:36,086",
    "start_sec": 7654.966,
    "end_sec": 7656.086,
    "zh": "你身上",
    "vi": "Trên người ngươi"
  },
  {
    "idx": 4682,
    "start": "02:07:36,086",
    "end": "02:07:38,426",
    "start_sec": 7656.086,
    "end_sec": 7658.426,
    "zh": "有老熟人的气味啊",
    "vi": "Có mùi của người quen cũ."
  },
  {
    "idx": 4683,
    "start": "02:07:38,426",
    "end": "02:07:39,686",
    "start_sec": 7658.426,
    "end_sec": 7659.686,
    "zh": "什么鬼",
    "vi": "Cái quỷ gì thế."
  },
  {
    "idx": 4684,
    "start": "02:07:39,686",
    "end": "02:07:41,066",
    "start_sec": 7659.686,
    "end_sec": 7661.066,
    "zh": "什么老熟人的气味啊",
    "vi": "Mùi người quen cũ gì chứ."
  },
  {
    "idx": 4685,
    "start": "02:07:41,066",
    "end": "02:07:41,726",
    "start_sec": 7661.066,
    "end_sec": 7661.726,
    "zh": "我瞧",
    "vi": "Để xem."
  },
  {
    "idx": 4686,
    "start": "02:07:41,726",
    "end": "02:07:44,346",
    "start_sec": 7661.726,
    "end_sec": 7664.346,
    "zh": "本以为躲过一截的橙子皮",
    "vi": "Trần Tử Bì vốn tưởng đã thoát được một kiếp."
  },
  {
    "idx": 4687,
    "start": "02:07:44,346",
    "end": "02:07:46,486",
    "start_sec": 7664.346,
    "end_sec": 7666.486,
    "zh": "对这句话长得有点猛逼",
    "vi": "Bỗng ngơ ngác trước câu nói này."
  },
  {
    "idx": 4688,
    "start": "02:07:46,486",
    "end": "02:07:49,406",
    "start_sec": 7666.486,
    "end_sec": 7669.406,
    "zh": "眼睁睁看着人面鬼像自己一步一步走来",
    "vi": "Trơ mắt nhìn quỷ mặt người từng bước tiến về phía mình."
  },
  {
    "idx": 4689,
    "start": "02:07:49,406",
    "end": "02:07:50,266",
    "start_sec": 7669.406,
    "end_sec": 7670.266,
    "zh": "哦",
    "vi": "Ồ."
  },
  {
    "idx": 4690,
    "start": "02:07:50,266",
    "end": "02:07:50,886",
    "start_sec": 7670.266,
    "end_sec": 7670.886,
    "zh": "小的",
    "vi": "Nhóc con."
  },
  {
    "idx": 4691,
    "start": "02:07:50,886",
    "end": "02:07:53,026",
    "start_sec": 7670.886,
    "end_sec": 7673.026,
    "zh": "你居然没被鬼术抽干精元",
    "vi": "Ngươi vậy mà không bị quỷ thuật hút cạn tinh nguyên."
  },
  {
    "idx": 4692,
    "start": "02:07:53,026",
    "end": "02:07:54,746",
    "start_sec": 7673.026,
    "end_sec": 7674.746,
    "zh": "是因为他在保护你吗",
    "vi": "Là vì hắn đang bảo vệ ngươi sao."
  },
  {
    "idx": 4693,
    "start": "02:07:54,746",
    "end": "02:07:56,866",
    "start_sec": 7674.746,
    "end_sec": 7676.866,
    "zh": "我没被鬼术抽干精元",
    "vi": "Mình không bị quỷ thuật hút cạn tinh nguyên."
  },
  {
    "idx": 4694,
    "start": "02:07:56,866",
    "end": "02:07:58,866",
    "start_sec": 7676.866,
    "end_sec": 7678.866,
    "zh": "居然是因为小木屐和香炉的原因",
    "vi": "Hóa ra là nhờ chiếc guốc gỗ nhỏ và lư hương."
  },
  {
    "idx": 4695,
    "start": "02:07:58,866",
    "end": "02:08:00,026",
    "start_sec": 7678.866,
    "end_sec": 7680.026,
    "zh": "他说的老熟人",
    "vi": "Người quen cũ mà nó nói."
  },
  {
    "idx": 4696,
    "start": "02:08:00,026",
    "end": "02:08:01,426",
    "start_sec": 7680.026,
    "end_sec": 7681.426,
    "zh": "莫非是我身上的香炉",
    "vi": "Chẳng lẽ là lư hương trên người mình."
  },
  {
    "idx": 4697,
    "start": "02:08:01,426",
    "end": "02:08:03,146",
    "start_sec": 7681.426,
    "end_sec": 7683.146,
    "zh": "香炉难道不是把戒",
    "vi": "Lư hương chẳng lẽ không phải là."
  },
  {
    "idx": 4698,
    "start": "02:08:03,146",
    "end": "02:08:05,866",
    "start_sec": 7683.146,
    "end_sec": 7685.866,
    "zh": "人面鬼并未急着去杀伤自己",
    "vi": "Quỷ mặt người không vội giết hắn."
  },
  {
    "idx": 4699,
    "start": "02:08:05,866",
    "end": "02:08:07,866",
    "start_sec": 7685.866,
    "end_sec": 7687.866,
    "zh": "而是目光连连看向他胸口",
    "vi": "Mà liên tục nhìn vào ngực hắn."
  },
  {
    "idx": 4700,
    "start": "02:08:07,866",
    "end": "02:08:09,486",
    "start_sec": 7687.866,
    "end_sec": 7689.486,
    "zh": "我都这么喊你了",
    "vi": "Ta đã gọi ngươi như thế rồi."
  },
  {
    "idx": 4701,
    "start": "02:08:09,486",
    "end": "02:08:10,486",
    "start_sec": 7689.486,
    "end_sec": 7690.486,
    "zh": "你也没出来",
    "vi": "Mà ngươi vẫn không ra."
  },
  {
    "idx": 4702,
    "start": "02:08:10,486",
    "end": "02:08:11,446",
    "start_sec": 7690.486,
    "end_sec": 7691.446,
    "zh": "老熟人",
    "vi": "Người quen cũ."
  },
  {
    "idx": 4703,
    "start": "02:08:11,446",
    "end": "02:08:13,546",
    "start_sec": 7691.446,
    "end_sec": 7693.546,
    "zh": "看来你也沉睡了",
    "vi": "Xem ra ngươi cũng đã ngủ say rồi."
  },
  {
    "idx": 4704,
    "start": "02:08:13,546",
    "end": "02:08:15,206",
    "start_sec": 7693.546,
    "end_sec": 7695.206,
    "zh": "既然这人类和你有缘",
    "vi": "Đã thế con người này có duyên với ngươi."
  },
  {
    "idx": 4705,
    "start": "02:08:15,206",
    "end": "02:08:17,226",
    "start_sec": 7695.206,
    "end_sec": 7697.226,
    "zh": "那便用它来献祭云影",
    "vi": "Vậy thì dùng nó để hiến tế Vân Ảnh."
  },
  {
    "idx": 4706,
    "start": "02:08:17,226",
    "end": "02:08:24,426",
    "start_sec": 7697.226,
    "end_sec": 7704.426,
    "zh": "你妈",
    "vi": "Mẹ kiếp."
  },
  {
    "idx": 4707,
    "start": "02:08:24,426",
    "end": "02:08:28,066",
    "start_sec": 7704.426,
    "end_sec": 7708.066,
    "zh": "一个人类杂碎",
    "vi": "Một tên rác rưởi loài người."
  },
  {
    "idx": 4708,
    "start": "02:08:28,066",
    "end": "02:08:30,206",
    "start_sec": 7708.066,
    "end_sec": 7710.206,
    "zh": "也配登鼻子上脸和我说话",
    "vi": "Mà cũng xứng được nước lấn tới nói chuyện với ta."
  },
  {
    "idx": 4709,
    "start": "02:08:30,766",
    "end": "02:08:39,326",
    "start_sec": 7710.766,
    "end_sec": 7719.326,
    "zh": "喂兄弟",
    "vi": "Này anh bạn."
  },
  {
    "idx": 4710,
    "start": "02:08:39,326",
    "end": "02:08:41,066",
    "start_sec": 7719.326,
    "end_sec": 7721.066,
    "zh": "能能给我点吃的吗",
    "vi": "Có thể cho tôi xin chút đồ ăn được không."
  },
  {
    "idx": 4711,
    "start": "02:08:41,066",
    "end": "02:08:42,446",
    "start_sec": 7721.066,
    "end_sec": 7722.446,
    "zh": "熟悉的声音传来",
    "vi": "Một giọng nói quen thuộc truyền đến."
  },
  {
    "idx": 4712,
    "start": "02:08:42,446",
    "end": "02:08:43,906",
    "start_sec": 7722.446,
    "end_sec": 7723.906,
    "zh": "床子提经络的回过神",
    "vi": "Trần Tử Bì giật mình tỉnh táo lại."
  },
  {
    "idx": 4713,
    "start": "02:08:43,906",
    "end": "02:08:45,146",
    "start_sec": 7723.906,
    "end_sec": 7725.146,
    "zh": "抬头看向自我",
    "vi": "Cậu ngẩng đầu nhìn xung quanh."
  },
  {
    "idx": 4714,
    "start": "02:08:45,146",
    "end": "02:08:47,406",
    "start_sec": 7725.146,
    "end_sec": 7727.406,
    "zh": "确实回到了白天的勇者寺",
    "vi": "Quả thực đã quay lại chùa Dũng Giả vào ban ngày."
  },
  {
    "idx": 4715,
    "start": "02:08:47,406",
    "end": "02:08:51,206",
    "start_sec": 7727.406,
    "end_sec": 7731.206,
    "zh": "谢谢了哥们",
    "vi": "Cảm ơn cậu nhé người anh em."
  },
  {
    "idx": 4716,
    "start": "02:08:51,206",
    "end": "02:08:52,366",
    "start_sec": 7731.206,
    "end_sec": 7732.366,
    "zh": "等到了安全区",
    "vi": "Đợi đến khi tới khu an toàn."
  },
  {
    "idx": 4717,
    "start": "02:08:52,366",
    "end": "02:08:53,966",
    "start_sec": 7732.366,
    "end_sec": 7733.966,
    "zh": "我一定会请你吃好的",
    "vi": "Tôi nhất định sẽ mời cậu một bữa thật ngon."
  },
  {
    "idx": 4718,
    "start": "02:08:53,966",
    "end": "02:08:56,806",
    "start_sec": 7733.966,
    "end_sec": 7736.806,
    "zh": "安全区能活过今晚再说吧",
    "vi": "Khu an toàn ư, sống sót qua đêm nay rồi hãy nói."
  },
  {
    "idx": 4719,
    "start": "02:08:56,806",
    "end": "02:08:58,286",
    "start_sec": 7736.806,
    "end_sec": 7738.286,
    "zh": "橙子皮没在理会棒子",
    "vi": "Trần Tử Bì không thèm để ý đến Bổng Tử nữa."
  },
  {
    "idx": 4720,
    "start": "02:08:58,286",
    "end": "02:08:59,686",
    "start_sec": 7738.286,
    "end_sec": 7739.686,
    "zh": "抬头向殿堂里看去",
    "vi": "Cậu ngẩng đầu nhìn vào trong điện thờ."
  },
  {
    "idx": 4721,
    "start": "02:08:59,686",
    "end": "02:09:02,186",
    "start_sec": 7739.686,
    "end_sec": 7742.186,
    "zh": "记得灵山区是被老妙珠用假身摆了一道",
    "vi": "Cậu nhớ là Linh Sơn Khu đã bị lão Diệu Châu dùng thế thân lừa một vố."
  },
  {
    "idx": 4722,
    "start": "02:09:02,186",
    "end": "02:09:03,326",
    "start_sec": 7742.186,
    "end_sec": 7743.326,
    "zh": "而老妙珠的真身",
    "vi": "Còn chân thân của lão Diệu Châu."
  },
  {
    "idx": 4723,
    "start": "02:09:03,326",
    "end": "02:09:05,346",
    "start_sec": 7743.326,
    "end_sec": 7745.346,
    "zh": "似乎是从衡阳上飘落下来的",
    "vi": "Dường như là bay từ trên xà ngang xuống."
  },
  {
    "idx": 4724,
    "start": "02:09:05,346",
    "end": "02:09:07,966",
    "start_sec": 7745.346,
    "end_sec": 7747.966,
    "zh": "果然衡阳上隐约有一张白纸贴放着",
    "vi": "Quả nhiên trên xà ngang có một tờ giấy trắng dán ở đó."
  },
  {
    "idx": 4725,
    "start": "02:09:07,966",
    "end": "02:09:09,626",
    "start_sec": 7747.966,
    "end_sec": 7749.626,
    "zh": "橙子皮又描了一眼红布",
    "vi": "Trần Tử Bì lại liếc nhìn tấm vải đỏ."
  },
  {
    "idx": 4726,
    "start": "02:09:09,626",
    "end": "02:09:10,506",
    "start_sec": 7749.626,
    "end_sec": 7750.506,
    "zh": "脸色发冷",
    "vi": "Vẻ mặt cậu trở nên lạnh lùng."
  },
  {
    "idx": 4727,
    "start": "02:09:10,506",
    "end": "02:09:13,326",
    "start_sec": 7750.506,
    "end_sec": 7753.326,
    "zh": "对人念鬼踩进脑袋的那种疼痛感",
    "vi": "Cảm giác đau đớn khi bị Nhân Niệm Quỷ dẫm vào đầu."
  },
  {
    "idx": 4728,
    "start": "02:09:13,326",
    "end": "02:09:14,246",
    "start_sec": 7753.326,
    "end_sec": 7754.246,
    "zh": "依旧让他心惊",
    "vi": "Vẫn khiến cậu rùng mình sợ hãi."
  },
  {
    "idx": 4729,
    "start": "02:09:14,246",
    "end": "02:09:17,426",
    "start_sec": 7754.246,
    "end_sec": 7757.426,
    "zh": "现在要想办法在大厅广众之下避开献血",
    "vi": "Bây giờ phải nghĩ cách tránh việc hiến máu trước mặt mọi người."
  },
  {
    "idx": 4730,
    "start": "02:09:17,426",
    "end": "02:09:19,446",
    "start_sec": 7757.426,
    "end_sec": 7759.446,
    "zh": "可是怎么才能避开呢",
    "vi": "Nhưng làm sao mới tránh được đây."
  },
  {
    "idx": 4731,
    "start": "02:09:19,446",
    "end": "02:09:21,566",
    "start_sec": 7759.446,
    "end_sec": 7761.566,
    "zh": "小墨记",
    "vi": "Tiểu Mặc Ký."
  },
  {
    "idx": 4732,
    "start": "02:09:21,566",
    "end": "02:09:23,246",
    "start_sec": 7761.566,
    "end_sec": 7763.246,
    "zh": "对了",
    "vi": "Đúng rồi."
  },
  {
    "idx": 4733,
    "start": "02:09:23,246",
    "end": "02:09:24,046",
    "start_sec": 7763.246,
    "end_sec": 7764.046,
    "zh": "小墨记",
    "vi": "Tiểu Mặc Ký."
  },
  {
    "idx": 4734,
    "start": "02:09:24,046",
    "end": "02:09:25,126",
    "start_sec": 7764.046,
    "end_sec": 7765.126,
    "zh": "小墨记",
    "vi": "Tiểu Mặc Ký."
  },
  {
    "idx": 4735,
    "start": "02:09:25,126",
    "end": "02:09:25,646",
    "start_sec": 7765.126,
    "end_sec": 7765.646,
    "zh": "乖",
    "vi": "Ngoan nào."
  },
  {
    "idx": 4736,
    "start": "02:09:25,646",
    "end": "02:09:26,766",
    "start_sec": 7765.646,
    "end_sec": 7766.766,
    "zh": "我需要你的一点血",
    "vi": "Ta cần một ít máu của mi."
  },
  {
    "idx": 4737,
    "start": "02:09:26,766",
    "end": "02:09:27,906",
    "start_sec": 7766.766,
    "end_sec": 7767.906,
    "zh": "别怕",
    "vi": "Đừng sợ."
  },
  {
    "idx": 4738,
    "start": "02:09:27,906",
    "end": "02:09:30,586",
    "start_sec": 7767.906,
    "end_sec": 7770.586,
    "zh": "学了小墨记一点血后",
    "vi": "Sau khi lấy một ít máu của Tiểu Mặc Ký."
  },
  {
    "idx": 4739,
    "start": "02:09:30,586",
    "end": "02:09:32,226",
    "start_sec": 7770.586,
    "end_sec": 7772.226,
    "zh": "橙子皮再次陷入唇丝",
    "vi": "Trần Tử Bì lại rơi vào trầm tư."
  },
  {
    "idx": 4740,
    "start": "02:09:32,226",
    "end": "02:09:33,746",
    "start_sec": 7772.226,
    "end_sec": 7773.746,
    "zh": "如果不想用万全之作",
    "vi": "Nếu không muốn dùng kế sách vẹn toàn."
  },
  {
    "idx": 4741,
    "start": "02:09:33,746",
    "end": "02:09:35,266",
    "start_sec": 7773.746,
    "end_sec": 7775.266,
    "zh": "到了晚上它还是要死",
    "vi": "Đến tối nó vẫn sẽ chết"
  },
  {
    "idx": 4742,
    "start": "02:09:35,266",
    "end": "02:09:36,466",
    "start_sec": 7775.266,
    "end_sec": 7776.466,
    "zh": "那苦笑人面鬼",
    "vi": "Cái quỷ mặt người cười khổ kia"
  },
  {
    "idx": 4743,
    "start": "02:09:36,466",
    "end": "02:09:38,026",
    "start_sec": 7776.466,
    "end_sec": 7778.026,
    "zh": "可以无视老妙主的指化",
    "vi": "Có thể bỏ qua sự khống chế của chủ miếu"
  },
  {
    "idx": 4744,
    "start": "02:09:38,026",
    "end": "02:09:39,346",
    "start_sec": 7778.026,
    "end_sec": 7779.346,
    "zh": "对付长发女鬼时",
    "vi": "Khi đối phó với quỷ tóc dài"
  },
  {
    "idx": 4745,
    "start": "02:09:39,346",
    "end": "02:09:40,606",
    "start_sec": 7779.346,
    "end_sec": 7780.606,
    "zh": "长发也失去作用",
    "vi": "Tóc dài cũng mất tác dụng"
  },
  {
    "idx": 4746,
    "start": "02:09:40,606",
    "end": "02:09:41,506",
    "start_sec": 7780.606,
    "end_sec": 7781.506,
    "zh": "如此看来",
    "vi": "Xem ra"
  },
  {
    "idx": 4747,
    "start": "02:09:41,506",
    "end": "02:09:42,486",
    "start_sec": 7781.506,
    "end_sec": 7782.486,
    "zh": "才能力抗生",
    "vi": "Mới có thể chống lại sinh vật"
  },
  {
    "idx": 4748,
    "start": "02:09:42,486",
    "end": "02:09:44,406",
    "start_sec": 7782.486,
    "end_sec": 7784.406,
    "zh": "如果猜想不假",
    "vi": "Nếu suy đoán không sai"
  },
  {
    "idx": 4749,
    "start": "02:09:44,406",
    "end": "02:09:46,186",
    "start_sec": 7784.406,
    "end_sec": 7786.186,
    "zh": "那么这个能力也太变态了",
    "vi": "Vậy thì năng lực này quá biến thái rồi"
  },
  {
    "idx": 4750,
    "start": "02:09:46,186",
    "end": "02:09:47,926",
    "start_sec": 7786.186,
    "end_sec": 7787.926,
    "zh": "要是把这种能力换为其有",
    "vi": "Nếu đổi năng lực này cho người khác"
  },
  {
    "idx": 4751,
    "start": "02:09:47,926",
    "end": "02:09:48,766",
    "start_sec": 7787.926,
    "end_sec": 7788.766,
    "zh": "那岂不是",
    "vi": "Thì chẳng phải là"
  },
  {
    "idx": 4752,
    "start": "02:09:48,766",
    "end": "02:09:49,846",
    "start_sec": 7788.766,
    "end_sec": 7789.846,
    "zh": "还有",
    "vi": "Còn nữa"
  },
  {
    "idx": 4753,
    "start": "02:09:49,846",
    "end": "02:09:51,186",
    "start_sec": 7789.846,
    "end_sec": 7791.186,
    "zh": "老庙主说的鬼域",
    "vi": "Vùng đất quỷ mà chủ miếu nói"
  },
  {
    "idx": 4754,
    "start": "02:09:51,186",
    "end": "02:09:52,786",
    "start_sec": 7791.186,
    "end_sec": 7792.786,
    "zh": "人面鬼说的老熟人",
    "vi": "Người quen cũ mà quỷ mặt người nói"
  },
  {
    "idx": 4755,
    "start": "02:09:52,786",
    "end": "02:09:56,670",
    "start_sec": 7792.786,
    "end_sec": 7796.67,
    "zh": "橙子皮暗自净塞了一整个下午一直到晚间起点如同电影画面重播一样人群再次有序地排队献血到了橙子皮的时候没等老庙主催迫橙子皮主动搞了脱血",
    "vi": "Trần Tử Bì lén lút nhét vào cả buổi chiều cho đến tối, điểm bắt"
  },
  {
    "idx": 4755,
    "start": "02:09:56,670",
    "end": "02:10:00,813",
    "start_sec": 7796.67,
    "end_sec": 7800.813,
    "zh": "橙子皮暗自净塞了一整个下午一直到晚间起点如同电影画面重播一样人群再次有序地排队献血到了橙子皮的时候没等老庙主催迫橙子皮主动搞了脱血",
    "vi": "đầu giống như cảnh phim chiếu lại, đám người lại lần lượt xếp hàng hiến máu"
  },
  {
    "idx": 4755,
    "start": "02:10:00,813",
    "end": "02:10:05,992",
    "start_sec": 7800.813,
    "end_sec": 7805.992,
    "zh": "橙子皮暗自净塞了一整个下午一直到晚间起点如同电影画面重播一样人群再次有序地排队献血到了橙子皮的时候没等老庙主催迫橙子皮主动搞了脱血",
    "vi": "Đến lượt Trần Tử Bì thì chưa cần chủ miếu thúc giục, Trần Tử Bì đã chủ động hiến máu"
  },
  {
    "idx": 4756,
    "start": "02:10:05,992",
    "end": "02:10:08,732",
    "start_sec": 7805.992,
    "end_sec": 7808.732,
    "zh": "橙施主第一次献血就是般主动",
    "vi": "Trần Tử Bì thí chủ lần đầu hiến máu lại chủ động như vậy"
  },
  {
    "idx": 4757,
    "start": "02:10:08,732",
    "end": "02:10:10,372",
    "start_sec": 7808.732,
    "end_sec": 7810.372,
    "zh": "看来你很有佛缘啊",
    "vi": "Xem ra bạn có duyên với Phật lắm"
  },
  {
    "idx": 4758,
    "start": "02:10:10,372",
    "end": "02:10:11,952",
    "start_sec": 7810.372,
    "end_sec": 7811.952,
    "zh": "老庙主一脸欣慰",
    "vi": "Chủ miếu vẻ mặt đầy hài lòng"
  },
  {
    "idx": 4759,
    "start": "02:10:11,952",
    "end": "02:10:13,652",
    "start_sec": 7811.952,
    "end_sec": 7813.652,
    "zh": "而旁边的林三青",
    "vi": "Còn Lâm Tam Thanh bên cạnh"
  },
  {
    "idx": 4760,
    "start": "02:10:13,652",
    "end": "02:10:15,852",
    "start_sec": 7813.652,
    "end_sec": 7815.852,
    "zh": "则是露出一脸鄙夷的笑意",
    "vi": "Thì lộ ra vẻ khinh bỉ"
  },
  {
    "idx": 4761,
    "start": "02:10:15,852",
    "end": "02:10:16,992",
    "start_sec": 7815.852,
    "end_sec": 7816.992,
    "zh": "庙主先生啊",
    "vi": "Thưa ngài chủ miếu"
  },
  {
    "idx": 4762,
    "start": "02:10:16,992",
    "end": "02:10:18,092",
    "start_sec": 7816.992,
    "end_sec": 7818.092,
    "zh": "其实我一直有个疑问",
    "vi": "Thực ra tôi luôn có một thắc mắc"
  },
  {
    "idx": 4763,
    "start": "02:10:18,092",
    "end": "02:10:20,212",
    "start_sec": 7818.092,
    "end_sec": 7820.212,
    "zh": "哦 橙施主有什么问题",
    "vi": "Ồ Trần Tử Bì thí chủ có vấn đề gì"
  },
  {
    "idx": 4764,
    "start": "02:10:20,212",
    "end": "02:10:22,052",
    "start_sec": 7820.212,
    "end_sec": 7822.052,
    "zh": "您身为庙主对待佛祖",
    "vi": "Ngài là chủ miếu đối với Phật tổ"
  },
  {
    "idx": 4765,
    "start": "02:10:22,052",
    "end": "02:10:23,392",
    "start_sec": 7822.052,
    "end_sec": 7823.392,
    "zh": "应该给我们多虔诚",
    "vi": "Lẽ ra phải hết lòng thành kính với chúng tôi"
  },
  {
    "idx": 4766,
    "start": "02:10:23,392",
    "end": "02:10:24,772",
    "start_sec": 7823.392,
    "end_sec": 7824.772,
    "zh": "为什么不进一心去呢",
    "vi": "Tại sao không hết lòng hướng về"
  },
  {
    "idx": 4767,
    "start": "02:10:24,772",
    "end": "02:10:30,252",
    "start_sec": 7824.772,
    "end_sec": 7830.252,
    "zh": "这 阿弥陀佛 老僧日夜供奉佛祖 不差这一点的",
    "vi": "Cái này A Di Đà Phật, lão tăng ngày đêm phụng thờ Phật tổ, không thiếu chút này."
  },
  {
    "idx": 4768,
    "start": "02:10:30,252",
    "end": "02:10:32,992",
    "start_sec": 7830.252,
    "end_sec": 7832.992,
    "zh": "长子皮呕了一声 随后指向灵三七",
    "vi": "Trần Tử Bì nôn khan một tiếng, sau đó chỉ vào Linh Tam Thanh"
  },
  {
    "idx": 4769,
    "start": "02:10:32,992",
    "end": "02:10:37,672",
    "start_sec": 7832.992,
    "end_sec": 7837.672,
    "zh": "那这位南慈先生呢 灵三七的笑容戛然而止 迅速冷下来",
    "vi": "Vậy còn vị tiên sinh Nam Từ này thì sao, nụ cười của Linh Tam Thanh chợt dừng lại, nhanh chóng trở nên lạnh lùng."
  },
  {
    "idx": 4770,
    "start": "02:10:37,672",
    "end": "02:10:39,612",
    "start_sec": 7837.672,
    "end_sec": 7839.612,
    "zh": "喂 小子 你什么意思",
    "vi": "Này nhóc, ý cậu là gì"
  },
  {
    "idx": 4771,
    "start": "02:10:39,612",
    "end": "02:10:42,992",
    "start_sec": 7839.612,
    "end_sec": 7842.992,
    "zh": "我没什么意思啊 我只不觉得庙主说的话有道理",
    "vi": "Tôi không có ý gì cả, tôi chỉ thấy lời của miếu chủ nói rất có lý."
  },
  {
    "idx": 4772,
    "start": "02:10:42,992",
    "end": "02:10:45,135",
    "start_sec": 7842.992,
    "end_sec": 7845.135,
    "zh": "既然大家都受佛祖庇佑 那么你不心虚的话 是不是对佛祖不敬",
    "vi": "Đã là mọi người đều được Phật tổ che chở, vậy nếu anh không"
  },
  {
    "idx": 4772,
    "start": "02:10:45,135",
    "end": "02:10:46,972",
    "start_sec": 7845.135,
    "end_sec": 7846.972,
    "zh": "既然大家都受佛祖庇佑 那么你不心虚的话 是不是对佛祖不敬",
    "vi": "chột dạ, thì có phải là bất kính với Phật tổ không."
  },
  {
    "idx": 4773,
    "start": "02:10:46,972",
    "end": "02:10:50,892",
    "start_sec": 7846.972,
    "end_sec": 7850.892,
    "zh": "仰看灵三七就要出手了 老庙主也要拦在他身前",
    "vi": "Thấy Linh Tam Thanh sắp ra tay, lão miếu chủ liền cản trước mặt anh ta."
  },
  {
    "idx": 4774,
    "start": "02:10:50,892",
    "end": "02:10:51,672",
    "start_sec": 7850.892,
    "end_sec": 7851.672,
    "zh": "藤施主",
    "vi": "Đằng thí chủ"
  },
  {
    "idx": 4775,
    "start": "02:10:51,672",
    "end": "02:10:52,932",
    "start_sec": 7851.672,
    "end_sec": 7852.932,
    "zh": "南慈先生他",
    "vi": "Nam Từ tiên sinh, cậu ấy"
  },
  {
    "idx": 4776,
    "start": "02:10:52,932",
    "end": "02:10:54,292",
    "start_sec": 7852.932,
    "end_sec": 7854.292,
    "zh": "有血液类的疾病",
    "vi": "Có bệnh về đường máu"
  },
  {
    "idx": 4777,
    "start": "02:10:54,292",
    "end": "02:10:55,352",
    "start_sec": 7854.292,
    "end_sec": 7855.352,
    "zh": "不适合供奉",
    "vi": "Không thích hợp để phụng thờ"
  },
  {
    "idx": 4778,
    "start": "02:10:55,352",
    "end": "02:10:56,932",
    "start_sec": 7855.352,
    "end_sec": 7856.932,
    "zh": "不会是艾滋吧",
    "vi": "Không phải là bệnh thế kỷ chứ."
  },
  {
    "idx": 4779,
    "start": "02:10:56,932",
    "end": "02:10:58,132",
    "start_sec": 7856.932,
    "end_sec": 7858.132,
    "zh": "那确实不适合",
    "vi": "Thế thì đúng là không thích hợp thật."
  },
  {
    "idx": 4780,
    "start": "02:10:58,132",
    "end": "02:11:00,492",
    "start_sec": 7858.132,
    "end_sec": 7860.492,
    "zh": "毕竟我们这么多人用这么一根银针",
    "vi": "Dù sao nhiều người chúng ta dùng chung một cây kim bạc thế này"
  },
  {
    "idx": 4781,
    "start": "02:11:00,492",
    "end": "02:11:02,252",
    "start_sec": 7860.492,
    "end_sec": 7862.252,
    "zh": "可不能碰到什么脏东西",
    "vi": "Không thể để dính phải thứ gì bẩn thỉu được"
  },
  {
    "idx": 4782,
    "start": "02:11:02,252",
    "end": "02:11:03,052",
    "start_sec": 7862.252,
    "end_sec": 7863.052,
    "zh": "你",
    "vi": "Mày"
  },
  {
    "idx": 4783,
    "start": "02:11:03,052",
    "end": "02:11:03,712",
    "start_sec": 7863.052,
    "end_sec": 7863.712,
    "zh": "你他妈",
    "vi": "Mẹ kiếp mày"
  },
  {
    "idx": 4784,
    "start": "02:11:03,712",
    "end": "02:11:04,772",
    "start_sec": 7863.712,
    "end_sec": 7864.772,
    "zh": "小子你找死",
    "vi": "Thằng nhóc kia, mày tìm chết rồi."
  },
  {
    "idx": 4785,
    "start": "02:11:04,772",
    "end": "02:11:06,012",
    "start_sec": 7864.772,
    "end_sec": 7866.012,
    "zh": "南慈施主",
    "vi": "Nam Từ thí chủ"
  },
  {
    "idx": 4786,
    "start": "02:11:06,012",
    "end": "02:11:06,812",
    "start_sec": 7866.012,
    "end_sec": 7866.812,
    "zh": "没必要",
    "vi": "Không cần thiết đâu"
  },
  {
    "idx": 4787,
    "start": "02:11:06,812",
    "end": "02:11:08,252",
    "start_sec": 7866.812,
    "end_sec": 7868.252,
    "zh": "大家伙明天就散",
    "vi": "Ngày mai mọi người đều giải tán rồi"
  },
  {
    "idx": 4788,
    "start": "02:11:08,252",
    "end": "02:11:09,152",
    "start_sec": 7868.252,
    "end_sec": 7869.152,
    "zh": "没必要",
    "vi": "Không cần thiết đâu"
  },
  {
    "idx": 4789,
    "start": "02:11:09,152",
    "end": "02:11:12,212",
    "start_sec": 7869.152,
    "end_sec": 7872.212,
    "zh": "反正这些晚上都变成死人了",
    "vi": "Dù sao tối nay bọn họ cũng thành người chết cả rồi"
  },
  {
    "idx": 4790,
    "start": "02:11:12,212",
    "end": "02:11:13,652",
    "start_sec": 7872.212,
    "end_sec": 7873.652,
    "zh": "你计较这么多干嘛",
    "vi": "Anh tính toán nhiều thế làm gì."
  },
  {
    "idx": 4791,
    "start": "02:11:13,652",
    "end": "02:11:16,412",
    "start_sec": 7873.652,
    "end_sec": 7876.412,
    "zh": "趁着老庙主和林三七说话之际",
    "vi": "Nhân lúc lão miếu chủ và Linh Tam Thanh đang nói chuyện"
  },
  {
    "idx": 4792,
    "start": "02:11:16,412",
    "end": "02:11:17,752",
    "start_sec": 7876.412,
    "end_sec": 7877.752,
    "zh": "肠子皮装不作样的",
    "vi": "Trần Tử Bì giả vờ giả vịt"
  },
  {
    "idx": 4793,
    "start": "02:11:17,752",
    "end": "02:11:19,372",
    "start_sec": 7877.752,
    "end_sec": 7879.372,
    "zh": "用银针朝顶天插了下",
    "vi": "Dùng kim bạc đâm vào Đỉnh Thiên một cái"
  },
  {
    "idx": 4794,
    "start": "02:11:19,372",
    "end": "02:11:20,852",
    "start_sec": 7879.372,
    "end_sec": 7880.852,
    "zh": "而滴出来的是袖口",
    "vi": "Nhưng giọt chảy ra lại là từ cổ tay áo"
  },
  {
    "idx": 4795,
    "start": "02:11:20,852",
    "end": "02:11:23,232",
    "start_sec": 7880.852,
    "end_sec": 7883.232,
    "zh": "既然蓝瓷先生有这种病",
    "vi": "Đã là Nam Từ tiên sinh có bệnh này"
  },
  {
    "idx": 4796,
    "start": "02:11:23,232",
    "end": "02:11:24,052",
    "start_sec": 7883.232,
    "end_sec": 7884.052,
    "zh": "倒是我唐突",
    "vi": "Vậy là tôi đường đột rồi"
  },
  {
    "idx": 4797,
    "start": "02:11:24,052",
    "end": "02:11:24,812",
    "start_sec": 7884.052,
    "end_sec": 7884.812,
    "zh": "抱歉抱歉",
    "vi": "Xin lỗi xin lỗi"
  },
  {
    "idx": 4798,
    "start": "02:11:24,812",
    "end": "02:11:25,532",
    "start_sec": 7884.812,
    "end_sec": 7885.532,
    "zh": "那朱先生",
    "vi": "Vậy Chu tiên sinh"
  },
  {
    "idx": 4799,
    "start": "02:11:25,532",
    "end": "02:11:26,732",
    "start_sec": 7885.532,
    "end_sec": 7886.732,
    "zh": "要不我多滴几滴血",
    "vi": "Hay là tôi nhỏ thêm vài giọt máu"
  },
  {
    "idx": 4800,
    "start": "02:11:26,732",
    "end": "02:11:27,692",
    "start_sec": 7886.732,
    "end_sec": 7887.692,
    "zh": "你补一下我的病",
    "vi": "Anh bù vào phần của tôi đi"
  },
  {
    "idx": 4801,
    "start": "02:11:27,692",
    "end": "02:11:28,952",
    "start_sec": 7887.692,
    "end_sec": 7888.952,
    "zh": "老妙不开眼",
    "vi": "Lão Diệu không mở mắt."
  },
  {
    "idx": 4802,
    "start": "02:11:28,952",
    "end": "02:11:30,492",
    "start_sec": 7888.952,
    "end_sec": 7890.492,
    "zh": "橙子皮手指上的血迹",
    "vi": "Vết máu trên ngón tay Trần Tử Bì."
  },
  {
    "idx": 4803,
    "start": "02:11:30,492",
    "end": "02:11:31,432",
    "start_sec": 7890.492,
    "end_sec": 7891.432,
    "zh": "冷哼一声",
    "vi": "Hắn hừ lạnh một tiếng."
  },
  {
    "idx": 4804,
    "start": "02:11:31,432",
    "end": "02:11:31,792",
    "start_sec": 7891.432,
    "end_sec": 7891.792,
    "zh": "不用",
    "vi": "Không cần."
  },
  {
    "idx": 4805,
    "start": "02:11:31,792",
    "end": "02:11:32,832",
    "start_sec": 7891.792,
    "end_sec": 7892.832,
    "zh": "文言",
    "vi": "Văn Ngôn."
  },
  {
    "idx": 4806,
    "start": "02:11:32,832",
    "end": "02:11:34,632",
    "start_sec": 7892.832,
    "end_sec": 7894.632,
    "zh": "橙子皮快速转身离开",
    "vi": "Trần Tử Bì nhanh chóng quay người rời đi."
  },
  {
    "idx": 4807,
    "start": "02:11:34,632",
    "end": "02:11:37,872",
    "start_sec": 7894.632,
    "end_sec": 7897.872,
    "zh": "他走出殿堂没一会儿",
    "vi": "Cậu ta vừa bước ra khỏi điện thờ không lâu."
  },
  {
    "idx": 4808,
    "start": "02:11:37,872",
    "end": "02:11:38,892",
    "start_sec": 7897.872,
    "end_sec": 7898.892,
    "zh": "那回音笔下的佛像",
    "vi": "Bức tượng Phật dưới bút hồi âm."
  },
  {
    "idx": 4809,
    "start": "02:11:38,892",
    "end": "02:11:39,892",
    "start_sec": 7898.892,
    "end_sec": 7899.892,
    "zh": "剧热正在响",
    "vi": "Đang rung chuyển dữ dội."
  },
  {
    "idx": 4810,
    "start": "02:11:39,892",
    "end": "02:11:41,812",
    "start_sec": 7899.892,
    "end_sec": 7901.812,
    "zh": "发生什么事了",
    "vi": "Đã xảy ra chuyện gì vậy."
  },
  {
    "idx": 4811,
    "start": "02:11:41,812",
    "end": "02:11:43,132",
    "start_sec": 7901.812,
    "end_sec": 7903.132,
    "zh": "佛像怎么在动啊",
    "vi": "Tại sao tượng Phật lại cử động."
  },
  {
    "idx": 4812,
    "start": "02:11:43,132",
    "end": "02:11:44,692",
    "start_sec": 7903.132,
    "end_sec": 7904.692,
    "zh": "不会是佛祖显灵了吧",
    "vi": "Chẳng lẽ Phật tổ hiển linh rồi sao."
  },
  {
    "idx": 4813,
    "start": "02:11:44,692",
    "end": "02:11:46,432",
    "start_sec": 7904.692,
    "end_sec": 7906.432,
    "zh": "不应该啊",
    "vi": "Không nên như vậy chứ."
  },
  {
    "idx": 4814,
    "start": "02:11:46,432",
    "end": "02:11:46,972",
    "start_sec": 7906.432,
    "end_sec": 7906.972,
    "zh": "按时间",
    "vi": "Theo thời gian."
  },
  {
    "idx": 4815,
    "start": "02:11:46,972",
    "end": "02:11:47,932",
    "start_sec": 7906.972,
    "end_sec": 7907.932,
    "zh": "鬼果孕育",
    "vi": "Quỷ quả thai nghén."
  },
  {
    "idx": 4816,
    "start": "02:11:47,932",
    "end": "02:11:49,212",
    "start_sec": 7907.932,
    "end_sec": 7909.212,
    "zh": "应该是午夜啊",
    "vi": "Đáng lẽ phải là nửa đêm mới đúng."
  },
  {
    "idx": 4817,
    "start": "02:11:49,212",
    "end": "02:11:51,032",
    "start_sec": 7909.212,
    "end_sec": 7911.032,
    "zh": "难道是多了一人的缘故",
    "vi": "Chẳng lẽ là do có thêm một người."
  },
  {
    "idx": 4818,
    "start": "02:11:51,032",
    "end": "02:11:52,692",
    "start_sec": 7911.032,
    "end_sec": 7912.692,
    "zh": "就在众人疑惑不解时",
    "vi": "Ngay khi mọi người đang hoang mang khó hiểu."
  },
  {
    "idx": 4819,
    "start": "02:11:52,692",
    "end": "02:11:53,412",
    "start_sec": 7912.692,
    "end_sec": 7913.412,
    "zh": "哗啦一声",
    "vi": "Một tiếng xoạt vang lên."
  },
  {
    "idx": 4820,
    "start": "02:11:53,412",
    "end": "02:11:54,212",
    "start_sec": 7913.412,
    "end_sec": 7914.212,
    "zh": "红布掉了",
    "vi": "Tấm vải đỏ rơi xuống."
  },
  {
    "idx": 4821,
    "start": "02:11:54,212",
    "end": "02:11:57,812",
    "start_sec": 7914.212,
    "end_sec": 7917.812,
    "zh": "那是谁",
    "vi": "Đó là ai."
  },
  {
    "idx": 4822,
    "start": "02:11:57,812",
    "end": "02:11:58,552",
    "start_sec": 7917.812,
    "end_sec": 7918.552,
    "zh": "是谁",
    "vi": "Là ai vậy."
  },
  {
    "idx": 4823,
    "start": "02:11:58,552",
    "end": "02:12:00,072",
    "start_sec": 7918.552,
    "end_sec": 7920.072,
    "zh": "买让我喝乌雀",
    "vi": "Đừng bắt tôi uống nước chim quạ."
  },
  {
    "idx": 4824,
    "start": "02:12:00,072",
    "end": "02:12:01,512",
    "start_sec": 7920.072,
    "end_sec": 7921.512,
    "zh": "伊藤的嘶吼声",
    "vi": "Tiếng gào thét của Y Đằng."
  },
  {
    "idx": 4825,
    "start": "02:12:01,512",
    "end": "02:12:02,752",
    "start_sec": 7921.512,
    "end_sec": 7922.752,
    "zh": "在永德村里回答",
    "vi": "Vang vọng khắp thôn Vĩnh Đức."
  },
  {
    "idx": 4826,
    "start": "02:12:02,752",
    "end": "02:12:03,892",
    "start_sec": 7922.752,
    "end_sec": 7923.892,
    "zh": "所有人看着鬼树",
    "vi": "Mọi người nhìn về phía cây quỷ."
  },
  {
    "idx": 4827,
    "start": "02:12:03,892",
    "end": "02:12:04,712",
    "start_sec": 7923.892,
    "end_sec": 7924.712,
    "zh": "面色散发",
    "vi": "Sắc mặt tái nhợt."
  },
  {
    "idx": 4828,
    "start": "02:12:04,712",
    "end": "02:12:05,392",
    "start_sec": 7924.712,
    "end_sec": 7925.392,
    "zh": "不是吧",
    "vi": "Không thể nào."
  },
  {
    "idx": 4829,
    "start": "02:12:05,392",
    "end": "02:12:06,752",
    "start_sec": 7925.392,
    "end_sec": 7926.752,
    "zh": "我们每天喝口袋",
    "vi": "Thứ chúng ta uống mỗi ngày."
  },
  {
    "idx": 4830,
    "start": "02:12:06,752",
    "end": "02:12:07,912",
    "start_sec": 7926.752,
    "end_sec": 7927.912,
    "zh": "是这玩意儿啊",
    "vi": "Chính là thứ này sao."
  },
  {
    "idx": 4831,
    "start": "02:12:07,912",
    "end": "02:12:08,272",
    "start_sec": 7927.912,
    "end_sec": 7928.272,
    "zh": "妈",
    "vi": "Mẹ."
  },
  {
    "idx": 4832,
    "start": "02:12:08,272",
    "end": "02:12:09,952",
    "start_sec": 7928.272,
    "end_sec": 7929.952,
    "zh": "我们每天给的东西谢谢",
    "vi": "Cảm ơn những thứ chúng ta đã dâng hiến mỗi ngày."
  },
  {
    "idx": 4833,
    "start": "02:12:09,952",
    "end": "02:12:10,952",
    "start_sec": 7929.952,
    "end_sec": 7930.952,
    "zh": "我操了",
    "vi": "Chết tiệt thật."
  },
  {
    "idx": 4834,
    "start": "02:12:10,952",
    "end": "02:12:12,492",
    "start_sec": 7930.952,
    "end_sec": 7932.492,
    "zh": "谁家博物长这样啊",
    "vi": "Ai lại có bảo vật trông thế này chứ."
  },
  {
    "idx": 4835,
    "start": "02:12:12,492",
    "end": "02:12:12,952",
    "start_sec": 7932.492,
    "end_sec": 7932.952,
    "zh": "乌雀",
    "vi": "Ô Tước."
  },
  {
    "idx": 4836,
    "start": "02:12:12,952",
    "end": "02:12:13,752",
    "start_sec": 7932.952,
    "end_sec": 7933.752,
    "zh": "什么乌雀",
    "vi": "Ô Tước gì cơ."
  },
  {
    "idx": 4837,
    "start": "02:12:13,752",
    "end": "02:12:15,352",
    "start_sec": 7933.752,
    "end_sec": 7935.352,
    "zh": "谁给鬼树喝了乌雀",
    "vi": "Ai đã cho cây quỷ uống Ô Tước thế."
  },
  {
    "idx": 4838,
    "start": "02:12:15,352",
    "end": "02:12:15,992",
    "start_sec": 7935.352,
    "end_sec": 7935.992,
    "zh": "喂",
    "vi": "Này."
  },
  {
    "idx": 4839,
    "start": "02:12:15,992",
    "end": "02:12:16,692",
    "start_sec": 7935.992,
    "end_sec": 7936.692,
    "zh": "林三二",
    "vi": "Lâm Tam Nhị."
  },
  {
    "idx": 4840,
    "start": "02:12:16,692",
    "end": "02:12:17,572",
    "start_sec": 7936.692,
    "end_sec": 7937.572,
    "zh": "现在怎么办",
    "vi": "Bây giờ phải làm sao đây."
  },
  {
    "idx": 4841,
    "start": "02:12:17,572",
    "end": "02:12:19,052",
    "start_sec": 7937.572,
    "end_sec": 7939.052,
    "zh": "哎 只能",
    "vi": "Haiz, chỉ đành vậy thôi."
  },
  {
    "idx": 4842,
    "start": "02:12:19,052",
    "end": "02:12:22,732",
    "start_sec": 7939.052,
    "end_sec": 7942.732,
    "zh": "虽然过早催化鬼果会拉低精生诡异的强度",
    "vi": "Mặc dù thúc chín quả quỷ quá sớm sẽ làm giảm sức mạnh của quỷ sinh ra."
  },
  {
    "idx": 4843,
    "start": "02:12:22,732",
    "end": "02:12:24,292",
    "start_sec": 7942.732,
    "end_sec": 7944.292,
    "zh": "但现在也来不及了",
    "vi": "Nhưng bây giờ cũng không kịp nữa rồi."
  },
  {
    "idx": 4844,
    "start": "02:12:24,292",
    "end": "02:12:33,092",
    "start_sec": 7944.292,
    "end_sec": 7953.092,
    "zh": "最后 鬼树顶端一颗刺牙缓缓伸展出来",
    "vi": "Cuối cùng, một chiếc răng nhọn ở đỉnh cây quỷ từ từ vươn ra."
  },
  {
    "idx": 4845,
    "start": "02:12:33,092",
    "end": "02:12:35,432",
    "start_sec": 7953.092,
    "end_sec": 7955.432,
    "zh": "接触一颗乒乓球大小的黑色火石",
    "vi": "Tiếp xúc với một viên hỏa thạch màu đen to bằng quả bóng bàn."
  },
  {
    "idx": 4846,
    "start": "02:12:35,432",
    "end": "02:12:38,732",
    "start_sec": 7955.432,
    "end_sec": 7958.732,
    "zh": "与此同时 无数黑色树根在院落里滥凉开",
    "vi": "Đồng thời, vô số rễ cây màu đen lan tràn khắp sân."
  },
  {
    "idx": 4847,
    "start": "02:12:38,732",
    "end": "02:12:41,132",
    "start_sec": 7958.732,
    "end_sec": 7961.132,
    "zh": "一些羡慕起来的人全部抽出去了",
    "vi": "Một số người đang ngưỡng mộ đều bị quất bay đi."
  },
  {
    "idx": 4848,
    "start": "02:12:41,132",
    "end": "02:12:43,552",
    "start_sec": 7961.132,
    "end_sec": 7963.552,
    "zh": "院落里仿佛变成人生烟雾",
    "vi": "Trong sân dường như biến thành một làn sương máu."
  },
  {
    "idx": 4849,
    "start": "02:12:43,552",
    "end": "02:12:45,492",
    "start_sec": 7963.552,
    "end_sec": 7965.492,
    "zh": "血水与烂肉将地面铺满",
    "vi": "Máu và thịt nát phủ đầy mặt đất."
  },
  {
    "idx": 4850,
    "start": "02:12:45,492",
    "end": "02:12:47,112",
    "start_sec": 7965.492,
    "end_sec": 7967.112,
    "zh": "长得疲乏在尸体下面",
    "vi": "Hắn nằm dưới đống xác chết."
  },
  {
    "idx": 4851,
    "start": "02:12:47,112",
    "end": "02:12:48,412",
    "start_sec": 7967.112,
    "end_sec": 7968.412,
    "zh": "一脸的疯狂抽搐",
    "vi": "Khuôn mặt co giật điên cuồng."
  },
  {
    "idx": 4852,
    "start": "02:12:48,412",
    "end": "02:12:51,392",
    "start_sec": 7968.412,
    "end_sec": 7971.392,
    "zh": "快了快了",
    "vi": "Sắp rồi, sắp rồi."
  },
  {
    "idx": 4853,
    "start": "02:12:51,392",
    "end": "02:12:52,932",
    "start_sec": 7971.392,
    "end_sec": 7972.932,
    "zh": "鬼果要成熟了",
    "vi": "Quả quỷ sắp chín rồi."
  },
  {
    "idx": 4854,
    "start": "02:12:52,932",
    "end": "02:12:55,952",
    "start_sec": 7972.932,
    "end_sec": 7975.952,
    "zh": "037",
    "vi": "Không ba bảy."
  },
  {
    "idx": 4855,
    "start": "02:12:55,952",
    "end": "02:12:57,372",
    "start_sec": 7975.952,
    "end_sec": 7977.372,
    "zh": "你想干什么",
    "vi": "Ngươi muốn làm gì."
  },
  {
    "idx": 4856,
    "start": "02:12:57,372",
    "end": "02:12:57,952",
    "start_sec": 7977.372,
    "end_sec": 7977.952,
    "zh": "干什么",
    "vi": "Làm gì á."
  },
  {
    "idx": 4857,
    "start": "02:12:57,952",
    "end": "02:12:59,952",
    "start_sec": 7977.952,
    "end_sec": 7979.952,
    "zh": "当然是准备吃鬼果啊",
    "vi": "Dĩ nhiên là chuẩn bị ăn quả quỷ rồi."
  },
  {
    "idx": 4858,
    "start": "02:12:59,952",
    "end": "02:13:01,252",
    "start_sec": 7979.952,
    "end_sec": 7981.252,
    "zh": "熟悉的争吵声传来",
    "vi": "Tiếng cãi vã quen thuộc truyền đến."
  },
  {
    "idx": 4859,
    "start": "02:13:01,252",
    "end": "02:13:04,892",
    "start_sec": 7981.252,
    "end_sec": 7984.892,
    "zh": "037和032不出意外的为鬼果争执起来",
    "vi": "Không ba bảy và Không ba hai không ngoài dự đoán đã tranh chấp vì quả quỷ."
  },
  {
    "idx": 4860,
    "start": "02:13:04,892",
    "end": "02:13:05,412",
    "start_sec": 7984.892,
    "end_sec": 7985.412,
    "zh": "小摸鸡",
    "vi": "Tiểu Mô Kê."
  },
  {
    "idx": 4861,
    "start": "02:13:05,412",
    "end": "02:13:06,632",
    "start_sec": 7985.412,
    "end_sec": 7986.632,
    "zh": "一会能不能成功",
    "vi": "Lát nữa có thành công hay không"
  },
  {
    "idx": 4862,
    "start": "02:13:06,632",
    "end": "02:13:07,912",
    "start_sec": 7986.632,
    "end_sec": 7987.912,
    "zh": "可就要看你了",
    "vi": "phải trông cậy vào mày rồi."
  },
  {
    "idx": 4863,
    "start": "02:13:07,912",
    "end": "02:13:09,832",
    "start_sec": 7987.912,
    "end_sec": 7989.832,
    "zh": "感激于我的东西",
    "vi": "Biết ơn món đồ của tao đi."
  },
  {
    "idx": 4864,
    "start": "02:13:09,832",
    "end": "02:13:10,532",
    "start_sec": 7989.832,
    "end_sec": 7990.532,
    "zh": "纸画",
    "vi": "Tranh giấy."
  },
  {
    "idx": 4865,
    "start": "02:13:10,532",
    "end": "02:13:13,452",
    "start_sec": 7990.532,
    "end_sec": 7993.452,
    "zh": "老东西",
    "vi": "Lão già kia."
  },
  {
    "idx": 4866,
    "start": "02:13:13,452",
    "end": "02:13:16,412",
    "start_sec": 7993.452,
    "end_sec": 7996.412,
    "zh": "那就看谁身体里的鬼会先复兵",
    "vi": "Vậy thì xem con quỷ trong cơ thể ai sẽ bộc phát trước."
  },
  {
    "idx": 4867,
    "start": "02:13:16,412",
    "end": "02:13:23,132",
    "start_sec": 7996.412,
    "end_sec": 8003.132,
    "zh": "老东西竟敢用假身防",
    "vi": "Lão già kia dám dùng thân xác giả để phòng bị."
  },
  {
    "idx": 4868,
    "start": "02:13:23,132",
    "end": "02:13:26,452",
    "start_sec": 8003.132,
    "end_sec": 8006.452,
    "zh": "吃鬼果你也要有嘴巴",
    "vi": "Muốn ăn quả quỷ thì mày cũng phải có miệng đã."
  },
  {
    "idx": 4869,
    "start": "02:13:26,452",
    "end": "02:13:28,572",
    "start_sec": 8006.452,
    "end_sec": 8008.572,
    "zh": "林三二",
    "vi": "Không Ba Hai."
  },
  {
    "idx": 4870,
    "start": "02:13:28,572",
    "end": "02:13:28,832",
    "start_sec": 8008.572,
    "end_sec": 8008.832,
    "zh": "我",
    "vi": "Tao"
  },
  {
    "idx": 4871,
    "start": "02:13:28,832",
    "end": "02:13:29,512",
    "start_sec": 8008.832,
    "end_sec": 8009.512,
    "zh": "裙子",
    "vi": "váy"
  },
  {
    "idx": 4872,
    "start": "02:13:29,512",
    "end": "02:13:30,352",
    "start_sec": 8009.512,
    "end_sec": 8010.352,
    "zh": "我错了",
    "vi": "tao sai rồi."
  },
  {
    "idx": 4873,
    "start": "02:13:30,352",
    "end": "02:13:30,892",
    "start_sec": 8010.352,
    "end_sec": 8010.892,
    "zh": "我不敢",
    "vi": "Tao không dám nữa."
  },
  {
    "idx": 4874,
    "start": "02:13:30,892",
    "end": "02:13:31,452",
    "start_sec": 8010.892,
    "end_sec": 8011.452,
    "zh": "裙子",
    "vi": "Váy"
  },
  {
    "idx": 4875,
    "start": "02:13:31,452",
    "end": "02:13:32,612",
    "start_sec": 8011.452,
    "end_sec": 8012.612,
    "zh": "我要穿裙子",
    "vi": "tao muốn mặc váy."
  },
  {
    "idx": 4876,
    "start": "02:13:32,612",
    "end": "02:13:35,112",
    "start_sec": 8012.612,
    "end_sec": 8015.112,
    "zh": "这时一道声音从院落一层",
    "vi": "Lúc này một giọng nói truyền ra từ tầng một của sân viện."
  },
  {
    "idx": 4877,
    "start": "02:13:35,112",
    "end": "02:13:36,772",
    "start_sec": 8015.112,
    "end_sec": 8016.772,
    "zh": "他的真身藏在山上",
    "vi": "Thân xác thật của ông ta trốn ở trên núi."
  },
  {
    "idx": 4878,
    "start": "02:13:36,772",
    "end": "02:13:37,892",
    "start_sec": 8016.772,
    "end_sec": 8017.892,
    "zh": "什么",
    "vi": "Cái gì."
  },
  {
    "idx": 4879,
    "start": "02:13:37,892",
    "end": "02:13:42,012",
    "start_sec": 8017.892,
    "end_sec": 8022.012,
    "zh": "林三二",
    "vi": "Không Ba Hai."
  },
  {
    "idx": 4880,
    "start": "02:13:42,012",
    "end": "02:13:43,452",
    "start_sec": 8022.012,
    "end_sec": 8023.452,
    "zh": "你居然真的藏在这",
    "vi": "Mày thực sự trốn ở đây sao."
  },
  {
    "idx": 4881,
    "start": "02:13:43,452",
    "end": "02:13:45,232",
    "start_sec": 8023.452,
    "end_sec": 8025.232,
    "zh": "你 你居然还有帮手",
    "vi": "Mày, mày lại còn có đồng bọn sao."
  },
  {
    "idx": 4882,
    "start": "02:13:45,232",
    "end": "02:13:46,272",
    "start_sec": 8025.232,
    "end_sec": 8026.272,
    "zh": "什么帮手",
    "vi": "Đồng bọn gì chứ."
  },
  {
    "idx": 4883,
    "start": "02:13:46,272",
    "end": "02:13:48,372",
    "start_sec": 8026.272,
    "end_sec": 8028.372,
    "zh": "你先把纸画给我解除了",
    "vi": "Mày mau giải trừ tranh giấy cho tao trước đã."
  },
  {
    "idx": 4884,
    "start": "02:13:48,372",
    "end": "02:13:50,572",
    "start_sec": 8028.372,
    "end_sec": 8030.572,
    "zh": "林三七 你他妈你个猪脑子",
    "vi": "Không Ba Bảy, mẹ kiếp mày đúng là đồ óc lợn."
  },
  {
    "idx": 4885,
    "start": "02:13:50,572",
    "end": "02:13:53,032",
    "start_sec": 8030.572,
    "end_sec": 8033.032,
    "zh": "你有想过那个说话的人是谁吗",
    "vi": "Mày có nghĩ xem người vừa nói là ai không."
  },
  {
    "idx": 4886,
    "start": "02:13:53,032",
    "end": "02:13:54,052",
    "start_sec": 8033.032,
    "end_sec": 8034.052,
    "zh": "我们相互内道",
    "vi": "Chúng ta đấu đá lẫn nhau"
  },
  {
    "idx": 4887,
    "start": "02:13:54,052",
    "end": "02:13:55,372",
    "start_sec": 8034.052,
    "end_sec": 8035.372,
    "zh": "到最后写对了",
    "vi": "cuối cùng sẽ làm lợi cho kẻ khác thôi."
  },
  {
    "idx": 4888,
    "start": "02:13:55,372",
    "end": "02:13:57,932",
    "start_sec": 8035.372,
    "end_sec": 8037.932,
    "zh": "你先把纸画给我解除了",
    "vi": "Mày mau giải trừ tranh giấy cho tao trước đã."
  },
  {
    "idx": 4889,
    "start": "02:13:57,932",
    "end": "02:13:58,592",
    "start_sec": 8037.932,
    "end_sec": 8038.592,
    "zh": "不可能",
    "vi": "Không đời nào."
  },
  {
    "idx": 4890,
    "start": "02:13:58,592",
    "end": "02:14:00,892",
    "start_sec": 8038.592,
    "end_sec": 8040.892,
    "zh": "那你先帮我压制体内的女鬼",
    "vi": "Vậy thì mày phải giúp tao áp chế con quỷ cái trong người trước."
  },
  {
    "idx": 4891,
    "start": "02:14:00,892",
    "end": "02:14:02,772",
    "start_sec": 8040.892,
    "end_sec": 8042.772,
    "zh": "眼灵三七情况越发严重",
    "vi": "Tình trạng của Linh Tam Thất ngày càng nghiêm trọng."
  },
  {
    "idx": 4892,
    "start": "02:14:02,772",
    "end": "02:14:03,792",
    "start_sec": 8042.772,
    "end_sec": 8043.792,
    "zh": "老妙的冷笑",
    "vi": "Lão Miêu cười lạnh."
  },
  {
    "idx": 4893,
    "start": "02:14:03,792",
    "end": "02:14:05,352",
    "start_sec": 8043.792,
    "end_sec": 8045.352,
    "zh": "我突然改变主意了",
    "vi": "Tôi đột nhiên đổi ý rồi."
  },
  {
    "idx": 4894,
    "start": "02:14:05,352",
    "end": "02:14:07,212",
    "start_sec": 8045.352,
    "end_sec": 8047.212,
    "zh": "你还是先变成鬼吧",
    "vi": "Anh cứ biến thành quỷ trước đi."
  },
  {
    "idx": 4895,
    "start": "02:14:07,212",
    "end": "02:14:08,952",
    "start_sec": 8047.212,
    "end_sec": 8048.952,
    "zh": "至于那个藏起来的家伙",
    "vi": "Còn tên đang trốn kia."
  },
  {
    "idx": 4896,
    "start": "02:14:08,952",
    "end": "02:14:11,372",
    "start_sec": 8048.952,
    "end_sec": 8051.372,
    "zh": "我不认为能对我造成什么威胁",
    "vi": "Tôi không nghĩ hắn có thể uy hiếp được tôi."
  },
  {
    "idx": 4897,
    "start": "02:14:11,372",
    "end": "02:14:13,372",
    "start_sec": 8051.372,
    "end_sec": 8053.372,
    "zh": "在接我永德寺前面",
    "vi": "Trước khi đến Vĩnh Đức Tự của tôi."
  },
  {
    "idx": 4898,
    "start": "02:14:13,372",
    "end": "02:14:15,152",
    "start_sec": 8053.372,
    "end_sec": 8055.152,
    "zh": "零三七牺牲全部队友",
    "vi": "Linh Tam Thất đã hy sinh toàn bộ đồng đội."
  },
  {
    "idx": 4899,
    "start": "02:14:15,152",
    "end": "02:14:16,992",
    "start_sec": 8055.152,
    "end_sec": 8056.992,
    "zh": "将体内诡异压榨到极点",
    "vi": "Vắt kiệt sức mạnh quỷ dị trong cơ thể đến cực hạn."
  },
  {
    "idx": 4900,
    "start": "02:14:16,992",
    "end": "02:14:18,792",
    "start_sec": 8056.992,
    "end_sec": 8058.792,
    "zh": "才九死一生的进入永德寺",
    "vi": "Mới liều chết chín lần mới vào được Vĩnh Đức Tự."
  },
  {
    "idx": 4901,
    "start": "02:14:18,792",
    "end": "02:14:20,292",
    "start_sec": 8058.792,
    "end_sec": 8060.292,
    "zh": "现在与老庙主交手",
    "vi": "Giờ lại giao đấu với Lão Miêu Chủ."
  },
  {
    "idx": 4902,
    "start": "02:14:20,292",
    "end": "02:14:20,832",
    "start_sec": 8060.292,
    "end_sec": 8060.832,
    "zh": "不出片刻",
    "vi": "Chưa đầy một khắc."
  },
  {
    "idx": 4903,
    "start": "02:14:20,832",
    "end": "02:14:21,832",
    "start_sec": 8060.832,
    "end_sec": 8061.832,
    "zh": "也失去人质",
    "vi": "Cũng mất đi con tin."
  },
  {
    "idx": 4904,
    "start": "02:14:21,832",
    "end": "02:14:22,712",
    "start_sec": 8061.832,
    "end_sec": 8062.712,
    "zh": "完全无效",
    "vi": "Hoàn toàn vô hiệu."
  },
  {
    "idx": 4905,
    "start": "02:14:22,712",
    "end": "02:14:25,352",
    "start_sec": 8062.712,
    "end_sec": 8065.352,
    "zh": "虽然这女鬼对我没有太大威胁",
    "vi": "Tuy con ma nữ này không uy hiếp tôi lắm."
  },
  {
    "idx": 4906,
    "start": "02:14:25,352",
    "end": "02:14:27,452",
    "start_sec": 8065.352,
    "end_sec": 8067.452,
    "zh": "但对付起来也比较麻烦",
    "vi": "Nhưng đối phó cũng khá phiền phức."
  },
  {
    "idx": 4907,
    "start": "02:14:27,452",
    "end": "02:14:29,392",
    "start_sec": 8067.452,
    "end_sec": 8069.392,
    "zh": "院子里还藏着一个隐患",
    "vi": "Trong sân còn giấu một mối nguy hiểm."
  },
  {
    "idx": 4908,
    "start": "02:14:29,392",
    "end": "02:14:30,652",
    "start_sec": 8069.392,
    "end_sec": 8070.652,
    "zh": "必须要先解除掉",
    "vi": "Phải giải quyết trước đã."
  },
  {
    "idx": 4909,
    "start": "02:14:30,652",
    "end": "02:14:32,692",
    "start_sec": 8070.652,
    "end_sec": 8072.692,
    "zh": "一切都在按照既定即行",
    "vi": "Mọi thứ đang diễn ra theo đúng kế hoạch."
  },
  {
    "idx": 4910,
    "start": "02:14:32,692",
    "end": "02:14:34,392",
    "start_sec": 8072.692,
    "end_sec": 8074.392,
    "zh": "身上压着的尸堆精血",
    "vi": "Tinh huyết của đống thi thể đè trên người."
  },
  {
    "idx": 4911,
    "start": "02:14:34,392",
    "end": "02:14:35,312",
    "start_sec": 8074.392,
    "end_sec": 8075.312,
    "zh": "几乎被抽干",
    "vi": "Gần như bị rút cạn."
  },
  {
    "idx": 4912,
    "start": "02:14:35,312",
    "end": "02:14:37,312",
    "start_sec": 8075.312,
    "end_sec": 8077.312,
    "zh": "肠子皮似乎觉得轻了几十斤",
    "vi": "Ruột gan dường như nhẹ đi mấy chục cân."
  },
  {
    "idx": 4913,
    "start": "02:14:37,312",
    "end": "02:14:38,812",
    "start_sec": 8077.312,
    "end_sec": 8078.812,
    "zh": "她从怀里掏出手机",
    "vi": "Cô ta lấy điện thoại ra khỏi túi."
  },
  {
    "idx": 4914,
    "start": "02:14:38,812",
    "end": "02:14:40,192",
    "start_sec": 8078.812,
    "end_sec": 8080.192,
    "zh": "给过去的自己编辑",
    "vi": "Soạn tin nhắn gửi cho chính mình trong quá khứ."
  },
  {
    "idx": 4915,
    "start": "02:14:40,192",
    "end": "02:14:41,492",
    "start_sec": 8080.192,
    "end_sec": 8081.492,
    "zh": "发送了一条消息",
    "vi": "Gửi đi một tin nhắn."
  },
  {
    "idx": 4916,
    "start": "02:14:41,492",
    "end": "02:14:42,272",
    "start_sec": 8081.492,
    "end_sec": 8082.272,
    "zh": "过去的我",
    "vi": "Bản thân trong quá khứ."
  },
  {
    "idx": 4917,
    "start": "02:14:42,272",
    "end": "02:14:42,832",
    "start_sec": 8082.272,
    "end_sec": 8082.832,
    "zh": "请注意",
    "vi": "Xin hãy chú ý."
  },
  {
    "idx": 4918,
    "start": "02:14:42,832",
    "end": "02:14:44,312",
    "start_sec": 8082.832,
    "end_sec": 8084.312,
    "zh": "我发送这条信息的时间",
    "vi": "Thời điểm tôi gửi tin nhắn này."
  },
  {
    "idx": 4919,
    "start": "02:14:44,312",
    "end": "02:14:45,372",
    "start_sec": 8084.312,
    "end_sec": 8085.372,
    "zh": "接下来的半个小时",
    "vi": "Trong nửa tiếng tiếp theo."
  },
  {
    "idx": 4920,
    "start": "02:14:45,372",
    "end": "02:14:46,252",
    "start_sec": 8085.372,
    "end_sec": 8086.252,
    "zh": "我都在担心",
    "vi": "Tôi đều đang lo lắng."
  },
  {
    "idx": 4921,
    "start": "02:14:46,252",
    "end": "02:14:47,352",
    "start_sec": 8086.252,
    "end_sec": 8087.352,
    "zh": "要是半个小时后",
    "vi": "Nếu nửa tiếng sau"
  },
  {
    "idx": 4922,
    "start": "02:14:47,352",
    "end": "02:14:48,252",
    "start_sec": 8087.352,
    "end_sec": 8088.252,
    "zh": "我回复了你",
    "vi": "tôi trả lời bạn"
  },
  {
    "idx": 4923,
    "start": "02:14:48,252",
    "end": "02:14:49,272",
    "start_sec": 8088.252,
    "end_sec": 8089.272,
    "zh": "就当无事发生",
    "vi": "thì cứ coi như không có chuyện gì xảy ra."
  },
  {
    "idx": 4924,
    "start": "02:14:49,272",
    "end": "02:14:50,392",
    "start_sec": 8089.272,
    "end_sec": 8090.392,
    "zh": "要是半个小时后",
    "vi": "Nếu nửa tiếng sau"
  },
  {
    "idx": 4925,
    "start": "02:14:50,392",
    "end": "02:14:51,252",
    "start_sec": 8090.392,
    "end_sec": 8091.252,
    "zh": "我没有回答",
    "vi": "tôi không trả lời"
  },
  {
    "idx": 4926,
    "start": "02:14:51,252",
    "end": "02:14:51,932",
    "start_sec": 8091.252,
    "end_sec": 8091.932,
    "zh": "请记住",
    "vi": "thì hãy nhớ"
  },
  {
    "idx": 4927,
    "start": "02:14:51,932",
    "end": "02:14:53,212",
    "start_sec": 8091.932,
    "end_sec": 8093.212,
    "zh": "来到永德寺头",
    "vi": "đến chùa Vĩnh Đức"
  },
  {
    "idx": 4928,
    "start": "02:14:53,212",
    "end": "02:14:54,012",
    "start_sec": 8093.212,
    "end_sec": 8094.012,
    "zh": "要离开现选",
    "vi": "phải rời khỏi đây ngay."
  },
  {
    "idx": 4929,
    "start": "02:14:54,012",
    "end": "02:14:55,516",
    "start_sec": 8094.012,
    "end_sec": 8095.516,
    "zh": "尽早想办法离开院子里藏着的我不管你是出于什么目的帮助林三七最好不要干预我的事情他已经是强弩之木等我吃了鬼果一切都将是定的",
    "vi": "Hãy mau chóng tìm cách rời đi"
  },
  {
    "idx": 4929,
    "start": "02:14:55,516",
    "end": "02:14:58,525",
    "start_sec": 8095.516,
    "end_sec": 8098.525,
    "zh": "尽早想办法离开院子里藏着的我不管你是出于什么目的帮助林三七最好不要干预我的事情他已经是强弩之木等我吃了鬼果一切都将是定的",
    "vi": "Kẻ đang trốn trong sân kia, tôi không quan tâm bạn giúp Lâm Tam"
  },
  {
    "idx": 4929,
    "start": "02:14:58,525",
    "end": "02:15:01,534",
    "start_sec": 8098.525,
    "end_sec": 8101.534,
    "zh": "尽早想办法离开院子里藏着的我不管你是出于什么目的帮助林三七最好不要干预我的事情他已经是强弩之木等我吃了鬼果一切都将是定的",
    "vi": "Thất vì mục đích gì, tốt nhất đừng can thiệp vào chuyện của tôi"
  },
  {
    "idx": 4929,
    "start": "02:15:01,534",
    "end": "02:15:05,618",
    "start_sec": 8101.534,
    "end_sec": 8105.618,
    "zh": "尽早想办法离开院子里藏着的我不管你是出于什么目的帮助林三七最好不要干预我的事情他已经是强弩之木等我吃了鬼果一切都将是定的",
    "vi": "Hắn đã sức tàn lực kiệt rồi, đợi tôi ăn Quỷ Quả xong, mọi chuyện sẽ được định đoạt"
  },
  {
    "idx": 4930,
    "start": "02:15:05,618",
    "end": "02:15:07,518",
    "start_sec": 8105.618,
    "end_sec": 8107.518,
    "zh": "突然寂静的院中",
    "vi": "Đột nhiên, trong cái sân yên tĩnh"
  },
  {
    "idx": 4931,
    "start": "02:15:07,518",
    "end": "02:15:08,698",
    "start_sec": 8107.518,
    "end_sec": 8108.698,
    "zh": "喘了一声起来",
    "vi": "vang lên một tiếng thở dốc."
  },
  {
    "idx": 4932,
    "start": "02:15:08,698",
    "end": "02:15:09,898",
    "start_sec": 8108.698,
    "end_sec": 8109.898,
    "zh": "老妙多抬扬了",
    "vi": "Lão Diệu Đa ngẩng đầu lên."
  },
  {
    "idx": 4933,
    "start": "02:15:09,898",
    "end": "02:15:11,378",
    "start_sec": 8109.898,
    "end_sec": 8111.378,
    "zh": "居然是你",
    "vi": "Hóa ra là bạn."
  },
  {
    "idx": 4934,
    "start": "02:15:11,378",
    "end": "02:15:12,198",
    "start_sec": 8111.378,
    "end_sec": 8112.198,
    "zh": "传师祖",
    "vi": "Truyền sư tổ."
  },
  {
    "idx": 4935,
    "start": "02:15:12,198",
    "end": "02:15:13,698",
    "start_sec": 8112.198,
    "end_sec": 8113.698,
    "zh": "为什么不能是我呢",
    "vi": "Tại sao lại không thể là tôi chứ."
  },
  {
    "idx": 4936,
    "start": "02:15:13,698",
    "end": "02:15:15,398",
    "start_sec": 8113.698,
    "end_sec": 8115.398,
    "zh": "老妙多脸色微冷",
    "vi": "Sắc mặt Lão Diệu Đa hơi lạnh lùng."
  },
  {
    "idx": 4937,
    "start": "02:15:15,398",
    "end": "02:15:15,838",
    "start_sec": 8115.398,
    "end_sec": 8115.838,
    "zh": "明的鬼",
    "vi": "Minh Quỷ."
  },
  {
    "idx": 4938,
    "start": "02:15:15,838",
    "end": "02:15:16,518",
    "start_sec": 8115.838,
    "end_sec": 8116.518,
    "zh": "原来",
    "vi": "Hóa ra"
  },
  {
    "idx": 4939,
    "start": "02:15:16,518",
    "end": "02:15:18,938",
    "start_sec": 8116.518,
    "end_sec": 8118.938,
    "zh": "那个给鬼祭最优秀的人是你啊",
    "vi": "người hiến tế cho quỷ xuất sắc nhất chính là bạn."
  },
  {
    "idx": 4940,
    "start": "02:15:18,938",
    "end": "02:15:21,038",
    "start_sec": 8118.938,
    "end_sec": 8121.038,
    "zh": "我说你怎么没事找啥呢",
    "vi": "Tôi tự hỏi sao bạn lại tự dưng kiếm chuyện như vậy."
  },
  {
    "idx": 4941,
    "start": "02:15:21,038",
    "end": "02:15:21,678",
    "start_sec": 8121.038,
    "end_sec": 8121.678,
    "zh": "确实是我",
    "vi": "Đúng là tôi."
  },
  {
    "idx": 4942,
    "start": "02:15:21,678",
    "end": "02:15:22,858",
    "start_sec": 8121.678,
    "end_sec": 8122.858,
    "zh": "只是让我没想到的是",
    "vi": "Chỉ là tôi không ngờ rằng"
  },
  {
    "idx": 4943,
    "start": "02:15:22,858",
    "end": "02:15:24,358",
    "start_sec": 8122.858,
    "end_sec": 8124.358,
    "zh": "零三七会鬼化的这么快",
    "vi": "Lâm Tam Thất lại quỷ hóa nhanh như vậy."
  },
  {
    "idx": 4944,
    "start": "02:15:24,358",
    "end": "02:15:26,118",
    "start_sec": 8124.358,
    "end_sec": 8126.118,
    "zh": "本以为你俩能拼得一死活",
    "vi": "Vốn tưởng hai người có thể đấu một trận sinh tử."
  },
  {
    "idx": 4945,
    "start": "02:15:26,118",
    "end": "02:15:27,418",
    "start_sec": 8126.118,
    "end_sec": 8127.418,
    "zh": "再不去养呆去啥呢",
    "vi": "Giờ không đi thu hoạch thì làm gì nữa."
  },
  {
    "idx": 4946,
    "start": "02:15:27,418",
    "end": "02:15:27,998",
    "start_sec": 8127.418,
    "end_sec": 8127.998,
    "zh": "说完",
    "vi": "Nói xong"
  },
  {
    "idx": 4947,
    "start": "02:15:27,998",
    "end": "02:15:29,378",
    "start_sec": 8127.998,
    "end_sec": 8129.378,
    "zh": "橙子皮蹲下身子",
    "vi": "Trần Tử Bì ngồi xổm xuống"
  },
  {
    "idx": 4948,
    "start": "02:15:29,378",
    "end": "02:15:30,578",
    "start_sec": 8129.378,
    "end_sec": 8130.578,
    "zh": "缓缓扒掉地上",
    "vi": "chậm rãi cởi bỏ"
  },
  {
    "idx": 4949,
    "start": "02:15:30,578",
    "end": "02:15:31,738",
    "start_sec": 8130.578,
    "end_sec": 8131.738,
    "zh": "一具女士的裙子",
    "vi": "chiếc váy của một xác chết nữ trên mặt đất."
  },
  {
    "idx": 4950,
    "start": "02:15:31,738",
    "end": "02:15:33,078",
    "start_sec": 8131.738,
    "end_sec": 8133.078,
    "zh": "老妙中摸的口袋",
    "vi": "Lão Diệu Đa lục lọi túi áo."
  },
  {
    "idx": 4951,
    "start": "02:15:33,078",
    "end": "02:15:33,698",
    "start_sec": 8133.078,
    "end_sec": 8133.698,
    "zh": "饺子",
    "vi": "Sủi Cảo."
  },
  {
    "idx": 4952,
    "start": "02:15:33,698",
    "end": "02:15:35,098",
    "start_sec": 8133.698,
    "end_sec": 8135.098,
    "zh": "你是真变态啊",
    "vi": "Mày đúng là đồ biến thái."
  },
  {
    "idx": 4953,
    "start": "02:15:35,098",
    "end": "02:15:35,978",
    "start_sec": 8135.098,
    "end_sec": 8135.978,
    "zh": "人都死了",
    "vi": "Người ta chết rồi."
  },
  {
    "idx": 4954,
    "start": "02:15:35,978",
    "end": "02:15:37,558",
    "start_sec": 8135.978,
    "end_sec": 8137.558,
    "zh": "一扒人家裙子干嘛",
    "vi": "Sao mày lại đi lột váy người ta."
  },
  {
    "idx": 4955,
    "start": "02:15:37,558",
    "end": "02:15:39,078",
    "start_sec": 8137.558,
    "end_sec": 8139.078,
    "zh": "将裙子拿在手中",
    "vi": "Cầm chiếc váy trên tay."
  },
  {
    "idx": 4956,
    "start": "02:15:39,078",
    "end": "02:15:40,578",
    "start_sec": 8139.078,
    "end_sec": 8140.578,
    "zh": "橙子皮也损死了",
    "vi": "Trần Tử Bì cũng thật là khốn nạn."
  },
  {
    "idx": 4957,
    "start": "02:15:40,578",
    "end": "02:15:41,158",
    "start_sec": 8140.578,
    "end_sec": 8141.158,
    "zh": "小磨叽",
    "vi": "Tiểu Mặc Kỷ."
  },
  {
    "idx": 4958,
    "start": "02:15:41,158",
    "end": "02:15:41,958",
    "start_sec": 8141.158,
    "end_sec": 8141.958,
    "zh": "杀了你",
    "vi": "Giết nó đi."
  },
  {
    "idx": 4959,
    "start": "02:15:41,958",
    "end": "02:15:43,218",
    "start_sec": 8141.958,
    "end_sec": 8143.218,
    "zh": "把这老头咬死了",
    "vi": "Cắn chết lão già này cho tao."
  },
  {
    "idx": 4960,
    "start": "02:15:43,218",
    "end": "02:15:45,998",
    "start_sec": 8143.218,
    "end_sec": 8145.998,
    "zh": "你不会以为靠只黑狗就能对付我吧",
    "vi": "Mày không nghĩ là chỉ dựa vào một con chó đen mà đối phó được tao đấy chứ."
  },
  {
    "idx": 4961,
    "start": "02:15:45,998",
    "end": "02:15:47,018",
    "start_sec": 8145.998,
    "end_sec": 8147.018,
    "zh": "虽然不明白",
    "vi": "Dù không hiểu."
  },
  {
    "idx": 4962,
    "start": "02:15:47,018",
    "end": "02:15:48,078",
    "start_sec": 8147.018,
    "end_sec": 8148.078,
    "zh": "你是怎么知道",
    "vi": "Sao mày biết được."
  },
  {
    "idx": 4963,
    "start": "02:15:48,078",
    "end": "02:15:50,058",
    "start_sec": 8148.078,
    "end_sec": 8150.058,
    "zh": "陷阱和我在藏身之处的",
    "vi": "Bẫy và nơi ẩn náu của tao."
  },
  {
    "idx": 4964,
    "start": "02:15:50,058",
    "end": "02:15:52,178",
    "start_sec": 8150.058,
    "end_sec": 8152.178,
    "zh": "但凡人对于玉鬼者而言",
    "vi": "Nhưng phàm nhân đối với Ngự Quỷ Giả."
  },
  {
    "idx": 4965,
    "start": "02:15:52,178",
    "end": "02:15:53,438",
    "start_sec": 8152.178,
    "end_sec": 8153.438,
    "zh": "终究只是素子",
    "vi": "Rốt cuộc cũng chỉ là vật tế."
  },
  {
    "idx": 4966,
    "start": "02:15:53,438",
    "end": "02:15:54,058",
    "start_sec": 8153.438,
    "end_sec": 8154.058,
    "zh": "指化",
    "vi": "Hóa thành tro bụi."
  },
  {
    "idx": 4967,
    "start": "02:15:54,058",
    "end": "02:15:56,778",
    "start_sec": 8154.058,
    "end_sec": 8156.778,
    "zh": "老妙处解释看向奔跑的小墨记",
    "vi": "Lão Diệu Đa nhìn về phía Tiểu Mặc Kỷ đang chạy tới."
  },
  {
    "idx": 4968,
    "start": "02:15:56,778",
    "end": "02:15:58,858",
    "start_sec": 8156.778,
    "end_sec": 8158.858,
    "zh": "小墨记的前肢就开始指化",
    "vi": "Chân trước của Tiểu Mặc Kỷ bắt đầu tan biến."
  },
  {
    "idx": 4969,
    "start": "02:15:58,858",
    "end": "02:16:00,958",
    "start_sec": 8158.858,
    "end_sec": 8160.958,
    "zh": "小墨记无助的看向橙子皮",
    "vi": "Tiểu Mặc Kỷ bất lực nhìn Trần Tử Bì."
  },
  {
    "idx": 4970,
    "start": "02:16:00,958",
    "end": "02:16:02,438",
    "start_sec": 8160.958,
    "end_sec": 8162.438,
    "zh": "橙子皮攥着裙子",
    "vi": "Trần Tử Bì nắm chặt chiếc váy."
  },
  {
    "idx": 4971,
    "start": "02:16:02,438",
    "end": "02:16:03,178",
    "start_sec": 8162.438,
    "end_sec": 8163.178,
    "zh": "脸色一蓝",
    "vi": "Sắc mặt tối sầm."
  },
  {
    "idx": 4972,
    "start": "02:16:03,178",
    "end": "02:16:04,758",
    "start_sec": 8163.178,
    "end_sec": 8164.758,
    "zh": "接下来就是你想的",
    "vi": "Tiếp theo đúng như mày nghĩ đấy."
  },
  {
    "idx": 4973,
    "start": "02:16:04,758",
    "end": "02:16:06,398",
    "start_sec": 8164.758,
    "end_sec": 8166.398,
    "zh": "敢打扰玉肥者的事",
    "vi": "Dám cản trở việc của Ngự Quỷ Giả."
  },
  {
    "idx": 4974,
    "start": "02:16:06,398",
    "end": "02:16:07,398",
    "start_sec": 8166.398,
    "end_sec": 8167.398,
    "zh": "活腻歪了",
    "vi": "Chán sống rồi à."
  },
  {
    "idx": 4975,
    "start": "02:16:07,398",
    "end": "02:16:08,838",
    "start_sec": 8167.398,
    "end_sec": 8168.838,
    "zh": "裙子",
    "vi": "Váy."
  },
  {
    "idx": 4976,
    "start": "02:16:08,838",
    "end": "02:16:09,978",
    "start_sec": 8168.838,
    "end_sec": 8169.978,
    "zh": "我要穿裙子",
    "vi": "Tao muốn mặc váy."
  },
  {
    "idx": 4977,
    "start": "02:16:09,978",
    "end": "02:16:10,698",
    "start_sec": 8169.978,
    "end_sec": 8170.698,
    "zh": "老秃驴",
    "vi": "Lão trọc kia."
  },
  {
    "idx": 4978,
    "start": "02:16:10,698",
    "end": "02:16:11,858",
    "start_sec": 8170.698,
    "end_sec": 8171.858,
    "zh": "你有没有裙子",
    "vi": "Mày có váy không."
  },
  {
    "idx": 4979,
    "start": "02:16:11,858",
    "end": "02:16:13,178",
    "start_sec": 8171.858,
    "end_sec": 8173.178,
    "zh": "凭是低下的鬼",
    "vi": "Đồ quỷ hạ đẳng."
  },
  {
    "idx": 4980,
    "start": "02:16:13,178",
    "end": "02:16:14,298",
    "start_sec": 8173.178,
    "end_sec": 8174.298,
    "zh": "把鬼给我拿来",
    "vi": "Đưa váy cho tao mau."
  },
  {
    "idx": 4981,
    "start": "02:16:14,298",
    "end": "02:16:15,118",
    "start_sec": 8174.298,
    "end_sec": 8175.118,
    "zh": "老秃驴",
    "vi": "Lão lừa trọc."
  },
  {
    "idx": 4982,
    "start": "02:16:15,118",
    "end": "02:16:16,098",
    "start_sec": 8175.118,
    "end_sec": 8176.098,
    "zh": "不给我裙子",
    "vi": "Không đưa váy cho ta."
  },
  {
    "idx": 4983,
    "start": "02:16:16,098",
    "end": "02:16:17,238",
    "start_sec": 8176.098,
    "end_sec": 8177.238,
    "zh": "就想拿我的东西",
    "vi": "Mà đòi lấy đồ của ta sao."
  },
  {
    "idx": 4984,
    "start": "02:16:17,238",
    "end": "02:16:17,838",
    "start_sec": 8177.238,
    "end_sec": 8177.838,
    "zh": "去死",
    "vi": "Đi chết đi."
  },
  {
    "idx": 4985,
    "start": "02:16:17,838",
    "end": "02:16:20,738",
    "start_sec": 8177.838,
    "end_sec": 8180.738,
    "zh": "看着女鬼争斗起来的老妙子",
    "vi": "Lão Diệu Tử nhìn nữ quỷ đánh nhau."
  },
  {
    "idx": 4986,
    "start": "02:16:20,738",
    "end": "02:16:22,418",
    "start_sec": 8180.738,
    "end_sec": 8182.418,
    "zh": "橙子皮嘴角突出小脸",
    "vi": "Trần Tử Bì nhếch mép cười thầm."
  },
  {
    "idx": 4987,
    "start": "02:16:22,418",
    "end": "02:16:22,858",
    "start_sec": 8182.418,
    "end_sec": 8182.858,
    "zh": "喂",
    "vi": "Này."
  },
  {
    "idx": 4988,
    "start": "02:16:22,858",
    "end": "02:16:23,818",
    "start_sec": 8182.858,
    "end_sec": 8183.818,
    "zh": "这里有裙子",
    "vi": "Ở đây có váy này."
  },
  {
    "idx": 4989,
    "start": "02:16:23,818",
    "end": "02:16:25,058",
    "start_sec": 8183.818,
    "end_sec": 8185.058,
    "zh": "你把手里的东西给我",
    "vi": "Ngươi đưa thứ trong tay cho ta."
  },
  {
    "idx": 4990,
    "start": "02:16:25,058",
    "end": "02:16:26,278",
    "start_sec": 8185.058,
    "end_sec": 8186.278,
    "zh": "我把裙子给你",
    "vi": "Ta sẽ đưa váy cho ngươi."
  },
  {
    "idx": 4991,
    "start": "02:16:26,278",
    "end": "02:16:26,978",
    "start_sec": 8186.278,
    "end_sec": 8186.978,
    "zh": "听到裙子",
    "vi": "Nghe thấy từ chiếc váy."
  },
  {
    "idx": 4992,
    "start": "02:16:26,978",
    "end": "02:16:28,978",
    "start_sec": 8186.978,
    "end_sec": 8188.978,
    "zh": "长发女鬼像应急反应一样",
    "vi": "Nữ quỷ tóc dài phản ứng ngay lập tức."
  },
  {
    "idx": 4993,
    "start": "02:16:28,978",
    "end": "02:16:30,398",
    "start_sec": 8188.978,
    "end_sec": 8190.398,
    "zh": "朝橙子皮看来",
    "vi": "Nhìn về phía Trần Tử Bì."
  },
  {
    "idx": 4994,
    "start": "02:16:30,398",
    "end": "02:16:30,898",
    "start_sec": 8190.398,
    "end_sec": 8190.898,
    "zh": "裙子",
    "vi": "Váy."
  },
  {
    "idx": 4995,
    "start": "02:16:30,898",
    "end": "02:16:31,478",
    "start_sec": 8190.898,
    "end_sec": 8191.478,
    "zh": "裙子",
    "vi": "Váy."
  },
  {
    "idx": 4996,
    "start": "02:16:31,478",
    "end": "02:16:32,018",
    "start_sec": 8191.478,
    "end_sec": 8192.018,
    "zh": "你给我",
    "vi": "Ngươi đưa cho ta."
  },
  {
    "idx": 4997,
    "start": "02:16:32,018",
    "end": "02:16:33,298",
    "start_sec": 8192.018,
    "end_sec": 8193.298,
    "zh": "拿去",
    "vi": "Cầm lấy đi."
  },
  {
    "idx": 4998,
    "start": "02:16:33,298",
    "end": "02:16:35,458",
    "start_sec": 8193.298,
    "end_sec": 8195.458,
    "zh": "橙子皮将裙子丢向空中",
    "vi": "Trần Tử Bì ném chiếc váy lên không trung."
  },
  {
    "idx": 4999,
    "start": "02:16:35,458",
    "end": "02:16:36,058",
    "start_sec": 8195.458,
    "end_sec": 8196.058,
    "zh": "下一道",
    "vi": "Ngay sau đó."
  },
  {
    "idx": 5000,
    "start": "02:16:36,058",
    "end": "02:16:37,698",
    "start_sec": 8196.058,
    "end_sec": 8197.698,
    "zh": "长发女鬼大为怨恙",
    "vi": "Nữ quỷ tóc dài vô cùng mừng rỡ."
  },
  {
    "idx": 5001,
    "start": "02:16:37,698",
    "end": "02:16:38,338",
    "start_sec": 8197.698,
    "end_sec": 8198.338,
    "zh": "推向橙子",
    "vi": "Lao về phía Trần Tử Bì."
  },
  {
    "idx": 5002,
    "start": "02:16:38,338",
    "end": "02:16:40,958",
    "start_sec": 8198.338,
    "end_sec": 8200.958,
    "zh": "他随手将鬼果丢在地上",
    "vi": "Ả tiện tay ném quả quỷ xuống đất."
  },
  {
    "idx": 5003,
    "start": "02:16:40,958",
    "end": "02:16:42,498",
    "start_sec": 8200.958,
    "end_sec": 8202.498,
    "zh": "双手爱惜地捧着裙子",
    "vi": "Hai tay nâng niu ôm lấy chiếc váy."
  },
  {
    "idx": 5004,
    "start": "02:16:42,498",
    "end": "02:16:44,418",
    "start_sec": 8202.498,
    "end_sec": 8204.418,
    "zh": "小子",
    "vi": "Thằng ranh."
  },
  {
    "idx": 5005,
    "start": "02:16:44,418",
    "end": "02:16:44,898",
    "start_sec": 8204.418,
    "end_sec": 8204.898,
    "zh": "你敢",
    "vi": "Ngươi dám."
  },
  {
    "idx": 5006,
    "start": "02:16:44,898",
    "end": "02:16:45,498",
    "start_sec": 8204.898,
    "end_sec": 8205.498,
    "zh": "只晃",
    "vi": "Chỉ thấy bóng người loáng lên."
  },
  {
    "idx": 5007,
    "start": "02:16:45,498",
    "end": "02:16:46,078",
    "start_sec": 8205.498,
    "end_sec": 8206.078,
    "zh": "只晃",
    "vi": "Loáng một cái."
  },
  {
    "idx": 5008,
    "start": "02:16:46,078",
    "end": "02:16:48,478",
    "start_sec": 8206.078,
    "end_sec": 8208.478,
    "zh": "眼看橙子皮拿到鬼果往嘴里送",
    "vi": "Thấy Trần Tử Bì nhặt quả quỷ định bỏ vào miệng."
  },
  {
    "idx": 5009,
    "start": "02:16:48,478",
    "end": "02:16:49,538",
    "start_sec": 8208.478,
    "end_sec": 8209.538,
    "zh": "老妙主机眼眉",
    "vi": "Lão Diệu Tử sốt ruột đỏ cả mắt."
  },
  {
    "idx": 5010,
    "start": "02:16:49,538",
    "end": "02:16:50,578",
    "start_sec": 8209.538,
    "end_sec": 8210.578,
    "zh": "他可也想不到",
    "vi": "Lão cũng không thể ngờ tới."
  },
  {
    "idx": 5011,
    "start": "02:16:50,578",
    "end": "02:16:52,738",
    "start_sec": 8210.578,
    "end_sec": 8212.738,
    "zh": "橙子皮竟敢要命地用裙子",
    "vi": "Trần Tử Bì dám liều mạng dùng chiếc váy của mình"
  },
  {
    "idx": 5012,
    "start": "02:16:52,738",
    "end": "02:16:54,058",
    "start_sec": 8212.738,
    "end_sec": 8214.058,
    "zh": "去勾引长话灵魂",
    "vi": "để dụ dỗ linh hồn giấy hóa."
  },
  {
    "idx": 5013,
    "start": "02:16:54,058",
    "end": "02:16:57,418",
    "start_sec": 8214.058,
    "end_sec": 8217.418,
    "zh": "小木屐",
    "vi": "Guốc Gỗ Nhỏ."
  },
  {
    "idx": 5014,
    "start": "02:16:57,418",
    "end": "02:16:59,758",
    "start_sec": 8217.418,
    "end_sec": 8219.758,
    "zh": "在橙子皮嘴巴将要指化出去",
    "vi": "Ngay khi miệng của Trần Tử Bì sắp bị giấy hóa hoàn toàn"
  },
  {
    "idx": 5015,
    "start": "02:16:59,758",
    "end": "02:17:01,358",
    "start_sec": 8219.758,
    "end_sec": 8221.358,
    "zh": "小木屐蹬着两只后腿",
    "vi": "Guốc Gỗ Nhỏ đạp mạnh hai chân sau"
  },
  {
    "idx": 5016,
    "start": "02:17:01,358",
    "end": "02:17:02,958",
    "start_sec": 8221.358,
    "end_sec": 8222.958,
    "zh": "一口咬着老妙子小腿",
    "vi": "cắn chặt vào bắp chân của Lão Miếu Chủ."
  },
  {
    "idx": 5017,
    "start": "02:17:02,958",
    "end": "02:17:03,638",
    "start_sec": 8222.958,
    "end_sec": 8223.638,
    "zh": "臭东西",
    "vi": "Đồ súc sinh."
  },
  {
    "idx": 5018,
    "start": "02:17:03,638",
    "end": "02:17:04,498",
    "start_sec": 8223.638,
    "end_sec": 8224.498,
    "zh": "你个死狗",
    "vi": "Con chó chết tiệt này."
  },
  {
    "idx": 5019,
    "start": "02:17:04,498",
    "end": "02:17:06,118",
    "start_sec": 8224.498,
    "end_sec": 8226.118,
    "zh": "老子搞不开过来你",
    "vi": "Tao phải xử mày trước đã."
  },
  {
    "idx": 5020,
    "start": "02:17:06,118",
    "end": "02:17:08,698",
    "start_sec": 8226.118,
    "end_sec": 8228.698,
    "zh": "等老妙主再次看向橙子皮子",
    "vi": "Đến khi Lão Miếu Chủ nhìn lại Trần Tử Bì"
  },
  {
    "idx": 5021,
    "start": "02:17:08,698",
    "end": "02:17:10,698",
    "start_sec": 8228.698,
    "end_sec": 8230.698,
    "zh": "鬼果被吞得连果都不剩",
    "vi": "thì quả quỷ đã bị nuốt chửng không còn một mảnh."
  },
  {
    "idx": 5022,
    "start": "02:17:10,698",
    "end": "02:17:11,798",
    "start_sec": 8230.698,
    "end_sec": 8231.798,
    "zh": "好好好",
    "vi": "Tốt tốt tốt."
  },
  {
    "idx": 5023,
    "start": "02:17:11,798",
    "end": "02:17:12,818",
    "start_sec": 8231.798,
    "end_sec": 8232.818,
    "zh": "妈的该死",
    "vi": "Mẹ kiếp thật đáng chết."
  },
  {
    "idx": 5024,
    "start": "02:17:12,818",
    "end": "02:17:13,778",
    "start_sec": 8232.818,
    "end_sec": 8233.778,
    "zh": "真该死",
    "vi": "Thật đáng chết mà."
  },
  {
    "idx": 5025,
    "start": "02:17:13,778",
    "end": "02:17:15,178",
    "start_sec": 8233.778,
    "end_sec": 8235.178,
    "zh": "就算你吃了鬼果",
    "vi": "Cho dù mày có ăn quả quỷ đi nữa"
  },
  {
    "idx": 5026,
    "start": "02:17:15,178",
    "end": "02:17:16,738",
    "start_sec": 8235.178,
    "end_sec": 8236.738,
    "zh": "一个新生的玉鬼者",
    "vi": "thì một Ngự Quỷ Giả mới thức tỉnh"
  },
  {
    "idx": 5027,
    "start": "02:17:16,738",
    "end": "02:17:17,898",
    "start_sec": 8236.738,
    "end_sec": 8237.898,
    "zh": "凭什么和我当",
    "vi": "lấy cái gì để đối đầu với tao."
  },
  {
    "idx": 5028,
    "start": "02:17:17,898",
    "end": "02:17:19,178",
    "start_sec": 8237.898,
    "end_sec": 8239.178,
    "zh": "老子要你死",
    "vi": "Tao muốn mày phải chết."
  },
  {
    "idx": 5029,
    "start": "02:17:19,178",
    "end": "02:17:19,578",
    "start_sec": 8239.178,
    "end_sec": 8239.578,
    "zh": "不",
    "vi": "Không."
  },
  {
    "idx": 5030,
    "start": "02:17:19,578",
    "end": "02:17:21,378",
    "start_sec": 8239.578,
    "end_sec": 8241.378,
    "zh": "老子要你生不如死",
    "vi": "Tao muốn mày sống không bằng chết."
  },
  {
    "idx": 5031,
    "start": "02:17:21,378",
    "end": "02:17:22,058",
    "start_sec": 8241.378,
    "end_sec": 8242.058,
    "zh": "指化",
    "vi": "Giấy hóa."
  },
  {
    "idx": 5032,
    "start": "02:17:22,058",
    "end": "02:17:22,698",
    "start_sec": 8242.058,
    "end_sec": 8242.698,
    "zh": "指化",
    "vi": "Giấy hóa."
  },
  {
    "idx": 5033,
    "start": "02:17:22,698",
    "end": "02:17:23,598",
    "start_sec": 8242.698,
    "end_sec": 8243.598,
    "zh": "吃完鬼果",
    "vi": "Sau khi ăn quả quỷ xong"
  },
  {
    "idx": 5034,
    "start": "02:17:23,598",
    "end": "02:17:24,658",
    "start_sec": 8243.598,
    "end_sec": 8244.658,
    "zh": "橙子皮发现",
    "vi": "Trần Tử Bì phát hiện ra"
  },
  {
    "idx": 5035,
    "start": "02:17:24,658",
    "end": "02:17:26,358",
    "start_sec": 8244.658,
    "end_sec": 8246.358,
    "zh": "身上几处被指化的部位",
    "vi": "những bộ phận bị giấy hóa trên cơ thể"
  },
  {
    "idx": 5036,
    "start": "02:17:26,358",
    "end": "02:17:27,098",
    "start_sec": 8246.358,
    "end_sec": 8247.098,
    "zh": "已经灰了",
    "vi": "đã khôi phục lại bình thường."
  },
  {
    "idx": 5037,
    "start": "02:17:27,098",
    "end": "02:17:27,898",
    "start_sec": 8247.098,
    "end_sec": 8247.898,
    "zh": "果然如此",
    "vi": "Quả nhiên là như vậy."
  },
  {
    "idx": 5038,
    "start": "02:17:27,898",
    "end": "02:17:29,138",
    "start_sec": 8247.898,
    "end_sec": 8249.138,
    "zh": "鬼果预计出来的能力",
    "vi": "Năng lực sinh ra từ quả quỷ"
  },
  {
    "idx": 5039,
    "start": "02:17:29,138",
    "end": "02:17:30,418",
    "start_sec": 8249.138,
    "end_sec": 8250.418,
    "zh": "是无效化",
    "vi": "chính là vô hiệu hóa."
  },
  {
    "idx": 5040,
    "start": "02:17:30,418",
    "end": "02:17:32,038",
    "start_sec": 8250.418,
    "end_sec": 8252.038,
    "zh": "无效化任何诡异的力量",
    "vi": "Vô hiệu hóa bất kỳ sức mạnh quỷ dị nào."
  },
  {
    "idx": 5041,
    "start": "02:17:32,038",
    "end": "02:17:32,678",
    "start_sec": 8252.038,
    "end_sec": 8252.678,
    "zh": "不好意思",
    "vi": "Xin lỗi."
  },
  {
    "idx": 5042,
    "start": "02:17:32,678",
    "end": "02:17:34,618",
    "start_sec": 8252.678,
    "end_sec": 8254.618,
    "zh": "现在情况一转了",
    "vi": "Tình hình đã thay đổi rồi."
  },
  {
    "idx": 5043,
    "start": "02:17:34,618",
    "end": "02:17:35,198",
    "start_sec": 8254.618,
    "end_sec": 8255.198,
    "zh": "一转",
    "vi": "Thay đổi rồi."
  },
  {
    "idx": 5044,
    "start": "02:17:35,198",
    "end": "02:17:36,398",
    "start_sec": 8255.198,
    "end_sec": 8256.398,
    "zh": "你以为你是谁",
    "vi": "Ngươi nghĩ ngươi là ai chứ."
  },
  {
    "idx": 5045,
    "start": "02:17:36,398",
    "end": "02:17:37,298",
    "start_sec": 8256.398,
    "end_sec": 8257.298,
    "zh": "你一个心",
    "vi": "Ngươi một trái tim."
  },
  {
    "idx": 5046,
    "start": "02:17:37,298",
    "end": "02:17:38,058",
    "start_sec": 8257.298,
    "end_sec": 8258.058,
    "zh": "不对",
    "vi": "Không đúng."
  },
  {
    "idx": 5047,
    "start": "02:17:38,058",
    "end": "02:17:39,618",
    "start_sec": 8258.058,
    "end_sec": 8259.618,
    "zh": "你怎么还没被指化",
    "vi": "Sao ngươi vẫn chưa bị hóa đá vậy."
  },
  {
    "idx": 5048,
    "start": "02:17:39,618",
    "end": "02:17:40,658",
    "start_sec": 8259.618,
    "end_sec": 8260.658,
    "zh": "现在的你",
    "vi": "Ngươi bây giờ."
  },
  {
    "idx": 5049,
    "start": "02:17:40,658",
    "end": "02:17:41,278",
    "start_sec": 8260.658,
    "end_sec": 8261.278,
    "zh": "对我而言",
    "vi": "Đối với ta."
  },
  {
    "idx": 5050,
    "start": "02:17:41,278",
    "end": "02:17:42,498",
    "start_sec": 8261.278,
    "end_sec": 8262.498,
    "zh": "就是一个普通老头",
    "vi": "Chỉ là một ông già bình thường."
  },
  {
    "idx": 5051,
    "start": "02:17:42,498",
    "end": "02:17:43,238",
    "start_sec": 8262.498,
    "end_sec": 8263.238,
    "zh": "甚至好弱",
    "vi": "Thậm chí còn yếu."
  },
  {
    "idx": 5052,
    "start": "02:17:43,238",
    "end": "02:17:43,838",
    "start_sec": 8263.238,
    "end_sec": 8263.838,
    "zh": "现在",
    "vi": "Bây giờ."
  },
  {
    "idx": 5053,
    "start": "02:17:43,838",
    "end": "02:17:44,878",
    "start_sec": 8263.838,
    "end_sec": 8264.878,
    "zh": "我给你一次机会",
    "vi": "Ta cho ngươi một cơ hội."
  },
  {
    "idx": 5054,
    "start": "02:17:44,878",
    "end": "02:17:45,918",
    "start_sec": 8264.878,
    "end_sec": 8265.918,
    "zh": "你给我好好说说",
    "vi": "Ngươi nói rõ cho ta nghe đi."
  },
  {
    "idx": 5055,
    "start": "02:17:45,918",
    "end": "02:17:46,998",
    "start_sec": 8265.918,
    "end_sec": 8266.998,
    "zh": "在诡异降临之前",
    "vi": "Trước khi quỷ dị giáng lâm."
  },
  {
    "idx": 5056,
    "start": "02:17:46,998",
    "end": "02:17:48,178",
    "start_sec": 8266.998,
    "end_sec": 8268.178,
    "zh": "你给我的黄香炉",
    "vi": "Ngươi cho ta cái lư hương vàng đó."
  },
  {
    "idx": 5057,
    "start": "02:17:48,178",
    "end": "02:17:48,938",
    "start_sec": 8268.178,
    "end_sec": 8268.938,
    "zh": "什么来着",
    "vi": "Là cái gì vậy."
  },
  {
    "idx": 5058,
    "start": "02:17:48,938",
    "end": "02:17:50,358",
    "start_sec": 8268.938,
    "end_sec": 8270.358,
    "zh": "无效化",
    "vi": "Vô hiệu hóa."
  },
  {
    "idx": 5059,
    "start": "02:17:50,358",
    "end": "02:17:51,018",
    "start_sec": 8270.358,
    "end_sec": 8271.018,
    "zh": "我不信",
    "vi": "Ta không tin."
  },
  {
    "idx": 5060,
    "start": "02:17:51,018",
    "end": "02:17:52,338",
    "start_sec": 8271.018,
    "end_sec": 8272.338,
    "zh": "指晃指晃",
    "vi": "Đang run rẩy."
  },
  {
    "idx": 5061,
    "start": "02:17:52,338",
    "end": "02:17:54,738",
    "start_sec": 8272.338,
    "end_sec": 8274.738,
    "zh": "老妙术疯狂推动体内诡异力量",
    "vi": "Lão Miêu Thuật điên cuồng thúc đẩy sức mạnh quỷ dị trong cơ thể."
  },
  {
    "idx": 5062,
    "start": "02:17:54,738",
    "end": "02:17:56,378",
    "start_sec": 8274.738,
    "end_sec": 8276.378,
    "zh": "导致体内诡异复苏加剧",
    "vi": "Khiến quỷ dị trong cơ thể phục hồi mạnh mẽ hơn."
  },
  {
    "idx": 5063,
    "start": "02:17:56,378",
    "end": "02:17:57,818",
    "start_sec": 8276.378,
    "end_sec": 8277.818,
    "zh": "整个身体开始指晃",
    "vi": "Toàn bộ cơ thể bắt đầu run rẩy."
  },
  {
    "idx": 5064,
    "start": "02:17:57,818",
    "end": "02:18:00,678",
    "start_sec": 8277.818,
    "end_sec": 8280.678,
    "zh": "我再问你",
    "vi": "Ta hỏi ngươi lần nữa."
  },
  {
    "idx": 5065,
    "start": "02:18:00,678",
    "end": "02:18:01,818",
    "start_sec": 8280.678,
    "end_sec": 8281.818,
    "zh": "青炉哪来的",
    "vi": "Cái lư hương xanh đó từ đâu ra."
  },
  {
    "idx": 5066,
    "start": "02:18:01,818",
    "end": "02:18:03,558",
    "start_sec": 8281.818,
    "end_sec": 8283.558,
    "zh": "老妙术彻底决忘了",
    "vi": "Lão Miêu Thuật hoàn toàn tuyệt vọng."
  },
  {
    "idx": 5067,
    "start": "02:18:03,558",
    "end": "02:18:04,618",
    "start_sec": 8283.558,
    "end_sec": 8284.618,
    "zh": "前后不到半小时",
    "vi": "Chưa đầy nửa tiếng."
  },
  {
    "idx": 5068,
    "start": "02:18:04,618",
    "end": "02:18:06,678",
    "start_sec": 8284.618,
    "end_sec": 8286.678,
    "zh": "那个在他眼里如同数次的白人",
    "vi": "Người mà trong mắt hắn từng như rác rưởi."
  },
  {
    "idx": 5069,
    "start": "02:18:06,678",
    "end": "02:18:09,078",
    "start_sec": 8286.678,
    "end_sec": 8289.078,
    "zh": "现在竟然如同藐视蝼蚁般藐视自己",
    "vi": "Giờ lại khinh thường hắn như coi thường một con kiến."
  },
  {
    "idx": 5070,
    "start": "02:18:09,078",
    "end": "02:18:10,898",
    "start_sec": 8289.078,
    "end_sec": 8290.898,
    "zh": "他的身体急剧指化着",
    "vi": "Cơ thể hắn đang hóa đá nhanh chóng."
  },
  {
    "idx": 5071,
    "start": "02:18:10,898",
    "end": "02:18:12,418",
    "start_sec": 8290.898,
    "end_sec": 8292.418,
    "zh": "这是橙子皮伸出手",
    "vi": "Đó là lúc Trần Tử Bì đưa tay ra"
  },
  {
    "idx": 5072,
    "start": "02:18:12,418",
    "end": "02:18:14,278",
    "start_sec": 8292.418,
    "end_sec": 8294.278,
    "zh": "他的胳膊上鼓出一个重包",
    "vi": "Trên cánh tay của hắn nổi lên một cục bướu lớn"
  },
  {
    "idx": 5073,
    "start": "02:18:14,278",
    "end": "02:18:16,758",
    "start_sec": 8294.278,
    "end_sec": 8296.758,
    "zh": "一张与橙子皮一模一样的人脸不动",
    "vi": "Một khuôn mặt người giống hệt Trần Tử Bì nằm im bất động"
  },
  {
    "idx": 5074,
    "start": "02:18:16,758",
    "end": "02:18:18,378",
    "start_sec": 8296.758,
    "end_sec": 8298.378,
    "zh": "随着人脸发出笑容",
    "vi": "Khi khuôn mặt đó nở nụ cười"
  },
  {
    "idx": 5075,
    "start": "02:18:18,378",
    "end": "02:18:21,238",
    "start_sec": 8298.378,
    "end_sec": 8301.238,
    "zh": "老庙主的身体居然重新变回人形",
    "vi": "Cơ thể của lão miếu chủ bỗng nhiên biến trở lại thành hình người"
  },
  {
    "idx": 5076,
    "start": "02:18:21,238",
    "end": "02:18:23,378",
    "start_sec": 8301.238,
    "end_sec": 8303.378,
    "zh": "你 你的能力到底是什么",
    "vi": "Ngươi. Năng lực của ngươi rốt cuộc là gì."
  },
  {
    "idx": 5077,
    "start": "02:18:23,378",
    "end": "02:18:25,298",
    "start_sec": 8303.378,
    "end_sec": 8305.298,
    "zh": "凭什么你能如此贤淑的",
    "vi": "Dựa vào đâu mà ngươi có thể thành thạo như vậy"
  },
  {
    "idx": 5078,
    "start": "02:18:25,298",
    "end": "02:18:26,298",
    "start_sec": 8305.298,
    "end_sec": 8306.298,
    "zh": "反控无效法",
    "vi": "Khống chế ngược lại vô hiệu pháp"
  },
  {
    "idx": 5079,
    "start": "02:18:26,298",
    "end": "02:18:28,438",
    "start_sec": 8306.298,
    "end_sec": 8308.438,
    "zh": "还因你在永恒寺里的所作所为",
    "vi": "Lại thêm những việc ngươi đã làm ở chùa Vĩnh Hằng"
  },
  {
    "idx": 5080,
    "start": "02:18:28,438",
    "end": "02:18:29,878",
    "start_sec": 8308.438,
    "end_sec": 8309.878,
    "zh": "仿佛能动达一切",
    "vi": "Dường như có thể thấu suốt mọi việc"
  },
  {
    "idx": 5081,
    "start": "02:18:29,878",
    "end": "02:18:30,958",
    "start_sec": 8309.878,
    "end_sec": 8310.958,
    "zh": "你到底是谁",
    "vi": "Ngươi rốt cuộc là ai."
  },
  {
    "idx": 5082,
    "start": "02:18:30,958",
    "end": "02:18:32,058",
    "start_sec": 8310.958,
    "end_sec": 8312.058,
    "zh": "在死亡面前",
    "vi": "Đối mặt với cái chết"
  },
  {
    "idx": 5083,
    "start": "02:18:32,058",
    "end": "02:18:33,618",
    "start_sec": 8312.058,
    "end_sec": 8313.618,
    "zh": "老庙主恍然回神",
    "vi": "Lão miếu chủ bừng tỉnh lấy lại tinh thần"
  },
  {
    "idx": 5084,
    "start": "02:18:33,618",
    "end": "02:18:35,118",
    "start_sec": 8313.618,
    "end_sec": 8315.118,
    "zh": "正正的看着城子里",
    "vi": "Lão nhìn chằm chằm vào Trần Tử Bì"
  },
  {
    "idx": 5085,
    "start": "02:18:35,118",
    "end": "02:18:37,478",
    "start_sec": 8315.118,
    "end_sec": 8317.478,
    "zh": "没来由的恐惧感从心底深入",
    "vi": "Nỗi sợ hãi vô cớ dâng lên từ tận đáy lòng"
  },
  {
    "idx": 5086,
    "start": "02:18:37,478",
    "end": "02:18:38,538",
    "start_sec": 8317.478,
    "end_sec": 8318.538,
    "zh": "我在里面",
    "vi": "Ta ở bên trong"
  },
  {
    "idx": 5087,
    "start": "02:18:38,538",
    "end": "02:18:39,318",
    "start_sec": 8318.538,
    "end_sec": 8319.318,
    "zh": "香炉的问题",
    "vi": "Vấn đề của chiếc lư hương"
  },
  {
    "idx": 5088,
    "start": "02:18:39,318",
    "end": "02:18:41,518",
    "start_sec": 8319.318,
    "end_sec": 8321.518,
    "zh": "你 你 香炉",
    "vi": "Ngươi. Ngươi. Lư hương."
  },
  {
    "idx": 5089,
    "start": "02:18:41,518",
    "end": "02:18:43,818",
    "start_sec": 8321.518,
    "end_sec": 8323.818,
    "zh": "香炉是和鬼叔一起发现的",
    "vi": "Chiếc lư hương đó là ta cùng Quỷ thúc tìm thấy"
  },
  {
    "idx": 5090,
    "start": "02:18:43,818",
    "end": "02:18:45,798",
    "start_sec": 8323.818,
    "end_sec": 8325.798,
    "zh": "当时我在鬼狱的一间庙里",
    "vi": "Khi đó ta đang ở trong một ngôi miếu tại Quỷ ngục"
  },
  {
    "idx": 5091,
    "start": "02:18:45,798",
    "end": "02:18:48,018",
    "start_sec": 8325.798,
    "end_sec": 8328.018,
    "zh": "我看到了鬼叔和祭祀的地方",
    "vi": "Ta đã nhìn thấy Quỷ thúc và nơi tế lễ"
  },
  {
    "idx": 5092,
    "start": "02:18:48,018",
    "end": "02:18:51,518",
    "start_sec": 8328.018,
    "end_sec": 8331.518,
    "zh": "而那个香炉则是摆在鬼树的祭祀台前",
    "vi": "Còn chiếc lư hương đó được đặt trước bàn thờ tế của Quỷ thụ"
  },
  {
    "idx": 5093,
    "start": "02:18:51,518",
    "end": "02:18:53,758",
    "start_sec": 8331.518,
    "end_sec": 8333.758,
    "zh": "我以为它就是个装血的器皿",
    "vi": "Ta cứ nghĩ nó chỉ là một vật dụng để đựng máu"
  },
  {
    "idx": 5094,
    "start": "02:18:53,758",
    "end": "02:18:55,538",
    "start_sec": 8333.758,
    "end_sec": 8335.538,
    "zh": "似少就一起带了回来",
    "vi": "Nên đã tiện tay mang nó về cùng luôn"
  },
  {
    "idx": 5095,
    "start": "02:18:55,538",
    "end": "02:18:57,138",
    "start_sec": 8335.538,
    "end_sec": 8337.138,
    "zh": "我研究了些许时日",
    "vi": "Ta đã nghiên cứu nó một thời gian"
  },
  {
    "idx": 5096,
    "start": "02:18:57,138",
    "end": "02:18:59,418",
    "start_sec": 8337.138,
    "end_sec": 8339.418,
    "zh": "发现它确实没有什么可出之处",
    "vi": "Nhận ra nó thực sự không có điểm gì đặc biệt"
  },
  {
    "idx": 5097,
    "start": "02:18:59,418",
    "end": "02:19:02,538",
    "start_sec": 8339.418,
    "end_sec": 8342.538,
    "zh": "所以那天周公子带你上门求法器",
    "vi": "Cho nên hôm đó khi Chu công tử dẫn ngươi đến tìm pháp khí"
  },
  {
    "idx": 5098,
    "start": "02:19:02,538",
    "end": "02:19:04,958",
    "start_sec": 8342.538,
    "end_sec": 8344.958,
    "zh": "我想那沾染了鬼树气息的香炉",
    "vi": "Ta nghĩ chiếc lư hương đã ám khí tức của Quỷ thụ đó"
  },
  {
    "idx": 5099,
    "start": "02:19:04,958",
    "end": "02:19:07,298",
    "start_sec": 8344.958,
    "end_sec": 8347.298,
    "zh": "足以帮你摆平任何血绪了",
    "vi": "Đủ để giúp ngươi giải quyết mọi tai ương về máu rồi"
  },
  {
    "idx": 5100,
    "start": "02:19:07,298",
    "end": "02:19:09,838",
    "start_sec": 8347.298,
    "end_sec": 8349.838,
    "zh": "于是就当作废物处理给你了",
    "vi": "Thế nên ta mới xem như đồ bỏ đi mà đưa cho ngươi"
  },
  {
    "idx": 5101,
    "start": "02:19:09,838",
    "end": "02:19:12,338",
    "start_sec": 8349.838,
    "end_sec": 8352.338,
    "zh": "难道香炉真的是因为沾染了鬼树气息",
    "vi": "Chẳng lẽ lư hương thực sự là vì nhiễm phải khí tức của quỷ thụ"
  },
  {
    "idx": 5102,
    "start": "02:19:12,338",
    "end": "02:19:13,418",
    "start_sec": 8352.338,
    "end_sec": 8353.418,
    "zh": "才让鬼医害怕的吗",
    "vi": "mới khiến quỷ y sợ hãi sao."
  },
  {
    "idx": 5103,
    "start": "02:19:13,418",
    "end": "02:19:15,038",
    "start_sec": 8353.418,
    "end_sec": 8355.038,
    "zh": "但仅仅沾染了鬼树的气息",
    "vi": "But chỉ nhiễm phải khí tức của quỷ thụ"
  },
  {
    "idx": 5104,
    "start": "02:19:15,038",
    "end": "02:19:16,158",
    "start_sec": 8355.038,
    "end_sec": 8356.158,
    "zh": "就能压制敲门鬼",
    "vi": "mà đã có thể áp chế được quỷ gõ cửa."
  },
  {
    "idx": 5105,
    "start": "02:19:16,158",
    "end": "02:19:17,398",
    "start_sec": 8356.158,
    "end_sec": 8357.398,
    "zh": "甚至在有的四外",
    "vi": "Thậm chí trong một số trường hợp"
  },
  {
    "idx": 5106,
    "start": "02:19:17,398",
    "end": "02:19:18,978",
    "start_sec": 8357.398,
    "end_sec": 8358.978,
    "zh": "无形诡异会避开香无",
    "vi": "sự quỷ dị vô hình sẽ tránh né lư hương"
  },
  {
    "idx": 5107,
    "start": "02:19:18,978",
    "end": "02:19:20,438",
    "start_sec": 8358.978,
    "end_sec": 8360.438,
    "zh": "优先虐杀林三星啊",
    "vi": "và ưu tiên sát hại Lâm Tam Tinh trước."
  },
  {
    "idx": 5108,
    "start": "02:19:20,438",
    "end": "02:19:21,018",
    "start_sec": 8360.438,
    "end_sec": 8361.018,
    "zh": "不对",
    "vi": "Không đúng."
  },
  {
    "idx": 5109,
    "start": "02:19:21,018",
    "end": "02:19:22,358",
    "start_sec": 8361.018,
    "end_sec": 8362.358,
    "zh": "应该还有其他说法",
    "vi": "Chắc chắn còn có nguyên nhân khác."
  },
  {
    "idx": 5110,
    "start": "02:19:22,358",
    "end": "02:19:23,578",
    "start_sec": 8362.358,
    "end_sec": 8363.578,
    "zh": "毕竟狐笑人面鬼",
    "vi": "Dù sao thì quỷ mặt người cười như cáo"
  },
  {
    "idx": 5111,
    "start": "02:19:23,578",
    "end": "02:19:24,758",
    "start_sec": 8363.578,
    "end_sec": 8364.758,
    "zh": "都叫香无老熟人",
    "vi": "cũng gọi lư hương là người quen cũ."
  },
  {
    "idx": 5112,
    "start": "02:19:24,758",
    "end": "02:19:26,678",
    "start_sec": 8364.758,
    "end_sec": 8366.678,
    "zh": "喂",
    "vi": "Này."
  },
  {
    "idx": 5113,
    "start": "02:19:26,678",
    "end": "02:19:27,418",
    "start_sec": 8366.678,
    "end_sec": 8367.418,
    "zh": "我问你",
    "vi": "Tôi hỏi bà."
  },
  {
    "idx": 5114,
    "start": "02:19:27,418",
    "end": "02:19:28,358",
    "start_sec": 8367.418,
    "end_sec": 8368.358,
    "zh": "诡异又是什么",
    "vi": "Quỷ dị rốt cuộc là cái gì."
  },
  {
    "idx": 5115,
    "start": "02:19:28,358",
    "end": "02:19:30,518",
    "start_sec": 8368.358,
    "end_sec": 8370.518,
    "zh": "老妙妇突然惨叫起来",
    "vi": "Bà lão đột nhiên hét lên thảm thiết."
  },
  {
    "idx": 5116,
    "start": "02:19:30,518",
    "end": "02:19:31,858",
    "start_sec": 8370.518,
    "end_sec": 8371.858,
    "zh": "她的体内的诡异后苏",
    "vi": "Sự quỷ dị trong cơ thể bà ta đang thức tỉnh"
  },
  {
    "idx": 5117,
    "start": "02:19:31,858",
    "end": "02:19:33,418",
    "start_sec": 8371.858,
    "end_sec": 8373.418,
    "zh": "最终彻底变为白症",
    "vi": "cuối cùng hoàn toàn biến thành xác trắng."
  },
  {
    "idx": 5118,
    "start": "02:19:33,418",
    "end": "02:19:35,958",
    "start_sec": 8373.418,
    "end_sec": 8375.958,
    "zh": "就在橙子皮抬脚",
    "vi": "Ngay khi Trần Tử Bì nhấc chân lên"
  },
  {
    "idx": 5119,
    "start": "02:19:35,958",
    "end": "02:19:37,778",
    "start_sec": 8375.958,
    "end_sec": 8377.778,
    "zh": "准备踩碎她的这心脏子",
    "vi": "chuẩn bị giẫm nát trái tim của bà ta"
  },
  {
    "idx": 5120,
    "start": "02:19:37,778",
    "end": "02:19:39,098",
    "start_sec": 8377.778,
    "end_sec": 8379.098,
    "zh": "手臂上的那根肉包",
    "vi": "thì mụn thịt trên cánh tay của anh"
  },
  {
    "idx": 5121,
    "start": "02:19:39,098",
    "end": "02:19:39,878",
    "start_sec": 8379.098,
    "end_sec": 8379.878,
    "zh": "越拉膨胀",
    "vi": "ngày càng phình to ra."
  },
  {
    "idx": 5122,
    "start": "02:19:39,878",
    "end": "02:19:40,758",
    "start_sec": 8379.878,
    "end_sec": 8380.758,
    "zh": "嘿嘿",
    "vi": "Hắc hắc."
  },
  {
    "idx": 5123,
    "start": "02:19:40,758",
    "end": "02:19:41,378",
    "start_sec": 8380.758,
    "end_sec": 8381.378,
    "zh": "小子",
    "vi": "Nhóc con."
  },
  {
    "idx": 5124,
    "start": "02:19:41,378",
    "end": "02:19:42,418",
    "start_sec": 8381.378,
    "end_sec": 8382.418,
    "zh": "我的力量",
    "vi": "Sức mạnh của ta"
  },
  {
    "idx": 5125,
    "start": "02:19:42,418",
    "end": "02:19:44,678",
    "start_sec": 8382.418,
    "end_sec": 8384.678,
    "zh": "是不是让你很痴迷啊",
    "vi": "có phải khiến ngươi rất mê mẩn không."
  },
  {
    "idx": 5126,
    "start": "02:19:44,678",
    "end": "02:19:45,438",
    "start_sec": 8384.678,
    "end_sec": 8385.438,
    "zh": "男人",
    "vi": "Là nam nhi"
  },
  {
    "idx": 5127,
    "start": "02:19:45,438",
    "end": "02:19:46,638",
    "start_sec": 8385.438,
    "end_sec": 8386.638,
    "zh": "你要懂得感恩",
    "vi": "ngươi phải biết ơn."
  },
  {
    "idx": 5128,
    "start": "02:19:46,638",
    "end": "02:19:47,958",
    "start_sec": 8386.638,
    "end_sec": 8387.958,
    "zh": "你要供养我",
    "vi": "Ngươi phải nuôi dưỡng ta"
  },
  {
    "idx": 5129,
    "start": "02:19:47,958",
    "end": "02:19:48,738",
    "start_sec": 8387.958,
    "end_sec": 8388.738,
    "zh": "热的指人",
    "vi": "bằng những người giấy ấm áp"
  },
  {
    "idx": 5130,
    "start": "02:19:48,738",
    "end": "02:19:50,338",
    "start_sec": 8388.738,
    "end_sec": 8390.338,
    "zh": "还有那个长发女鬼",
    "vi": "và cả nữ quỷ tóc dài kia nữa."
  },
  {
    "idx": 5131,
    "start": "02:19:50,338",
    "end": "02:19:51,798",
    "start_sec": 8390.338,
    "end_sec": 8391.798,
    "zh": "我需要吃了她们",
    "vi": "Ta cần phải ăn thịt chúng."
  },
  {
    "idx": 5132,
    "start": "02:19:51,798",
    "end": "02:19:53,038",
    "start_sec": 8391.798,
    "end_sec": 8393.038,
    "zh": "成为我的养分",
    "vi": "Để làm chất dinh dưỡng cho ta."
  },
  {
    "idx": 5133,
    "start": "02:19:53,038",
    "end": "02:19:55,498",
    "start_sec": 8393.038,
    "end_sec": 8395.498,
    "zh": "这是你作为使用我的代价",
    "vi": "Đây là cái giá ngươi phải trả khi sử dụng ta."
  },
  {
    "idx": 5134,
    "start": "02:19:55,498",
    "end": "02:19:56,858",
    "start_sec": 8395.498,
    "end_sec": 8396.858,
    "zh": "胡笑人脸阴冷的",
    "vi": "Khuôn mặt cười của Hồ Tiếu Nhân lạnh lùng"
  },
  {
    "idx": 5135,
    "start": "02:19:56,858",
    "end": "02:19:57,778",
    "start_sec": 8396.858,
    "end_sec": 8397.778,
    "zh": "看向橙子皮",
    "vi": "nhìn về phía Trình Tử Bì."
  },
  {
    "idx": 5136,
    "start": "02:19:57,778",
    "end": "02:19:58,818",
    "start_sec": 8397.778,
    "end_sec": 8398.818,
    "zh": "语气带着命令",
    "vi": "Giọng điệu mang theo vẻ ra lệnh"
  },
  {
    "idx": 5137,
    "start": "02:19:58,818",
    "end": "02:19:59,798",
    "start_sec": 8398.818,
    "end_sec": 8399.798,
    "zh": "仿佛他才是",
    "vi": "như thể hắn mới là"
  },
  {
    "idx": 5138,
    "start": "02:20:00,000",
    "end": "02:20:01,080",
    "start_sec": 8400.0,
    "end_sec": 8401.08,
    "zh": "你身体的主导者",
    "vi": "kẻ làm chủ cơ thể của ngươi."
  },
  {
    "idx": 5139,
    "start": "02:20:01,080",
    "end": "02:20:01,820",
    "start_sec": 8401.08,
    "end_sec": 8401.82,
    "zh": "你公养你",
    "vi": "Ta nuôi dưỡng ngươi"
  },
  {
    "idx": 5140,
    "start": "02:20:01,820",
    "end": "02:20:03,040",
    "start_sec": 8401.82,
    "end_sec": 8403.04,
    "zh": "只怕在使用你",
    "vi": "chỉ sợ khi sử dụng ngươi"
  },
  {
    "idx": 5141,
    "start": "02:20:03,040",
    "end": "02:20:04,340",
    "start_sec": 8403.04,
    "end_sec": 8404.34,
    "zh": "你就要复苏长出来",
    "vi": "ngươi sẽ hồi phục rồi lớn lên"
  },
  {
    "idx": 5142,
    "start": "02:20:04,340",
    "end": "02:20:05,460",
    "start_sec": 8404.34,
    "end_sec": 8405.46,
    "zh": "爬到我的脑袋上",
    "vi": "bò lên trên đầu ta"
  },
  {
    "idx": 5143,
    "start": "02:20:05,460",
    "end": "02:20:06,140",
    "start_sec": 8405.46,
    "end_sec": 8406.14,
    "zh": "顶替我了吧",
    "vi": "và thay thế ta luôn đúng không."
  },
  {
    "idx": 5144,
    "start": "02:20:06,140",
    "end": "02:20:08,680",
    "start_sec": 8406.14,
    "end_sec": 8408.68,
    "zh": "你 你怎么知道我在想什么的",
    "vi": "Ngươi, sao ngươi biết ta đang nghĩ gì."
  },
  {
    "idx": 5145,
    "start": "02:20:08,680",
    "end": "02:20:10,060",
    "start_sec": 8408.68,
    "end_sec": 8410.06,
    "zh": "因为我亲眼见过",
    "vi": "Bởi vì ta đã tận mắt chứng kiến."
  },
  {
    "idx": 5146,
    "start": "02:20:10,060",
    "end": "02:20:11,160",
    "start_sec": 8410.06,
    "end_sec": 8411.16,
    "zh": "亲眼见过",
    "vi": "Tận mắt chứng kiến."
  },
  {
    "idx": 5147,
    "start": "02:20:11,160",
    "end": "02:20:12,320",
    "start_sec": 8411.16,
    "end_sec": 8412.32,
    "zh": "你在胡说什么",
    "vi": "Ngươi đang nói bậy bạ gì đó."
  },
  {
    "idx": 5148,
    "start": "02:20:12,320",
    "end": "02:20:13,600",
    "start_sec": 8412.32,
    "end_sec": 8413.6,
    "zh": "如果过度使用你",
    "vi": "Nếu lạm dụng ngươi quá mức"
  },
  {
    "idx": 5149,
    "start": "02:20:13,600",
    "end": "02:20:14,740",
    "start_sec": 8413.6,
    "end_sec": 8414.74,
    "zh": "你就会越长越大",
    "vi": "ngươi sẽ ngày càng lớn hơn."
  },
  {
    "idx": 5150,
    "start": "02:20:14,740",
    "end": "02:20:15,460",
    "start_sec": 8414.74,
    "end_sec": 8415.46,
    "zh": "若是头位",
    "vi": "Nếu như để ngươi"
  },
  {
    "idx": 5151,
    "start": "02:20:15,460",
    "end": "02:20:16,160",
    "start_sec": 8415.46,
    "end_sec": 8416.16,
    "zh": "你吃鬼意",
    "vi": "ăn lệ quỷ"
  },
  {
    "idx": 5152,
    "start": "02:20:16,160",
    "end": "02:20:17,700",
    "start_sec": 8416.16,
    "end_sec": 8417.7,
    "zh": "你会越来越难以控制",
    "vi": "ngươi sẽ ngày càng khó kiểm soát hơn."
  },
  {
    "idx": 5153,
    "start": "02:20:17,700",
    "end": "02:20:18,680",
    "start_sec": 8417.7,
    "end_sec": 8418.68,
    "zh": "我说的不错吧",
    "vi": "Ta nói không sai chứ."
  },
  {
    "idx": 5154,
    "start": "02:20:18,680",
    "end": "02:20:19,560",
    "start_sec": 8418.68,
    "end_sec": 8419.56,
    "zh": "我所推测的是",
    "vi": "Điều ta suy đoán là"
  },
  {
    "idx": 5155,
    "start": "02:20:19,560",
    "end": "02:20:21,560",
    "start_sec": 8419.56,
    "end_sec": 8421.56,
    "zh": "上次往暴猪吃完鬼果后",
    "vi": "lần trước sau khi Vương Bạo Trư ăn quả quỷ xong"
  },
  {
    "idx": 5156,
    "start": "02:20:21,560",
    "end": "02:20:23,000",
    "start_sec": 8421.56,
    "end_sec": 8423.0,
    "zh": "只怕的手臂则已恢复",
    "vi": "cánh tay bị đứt đã hồi phục."
  },
  {
    "idx": 5157,
    "start": "02:20:23,000",
    "end": "02:20:25,440",
    "start_sec": 8423.0,
    "end_sec": 8425.44,
    "zh": "其实并非体内两只鬼意互相制衡",
    "vi": "Thực ra không phải hai con quỷ trong người tự kiềm chế lẫn nhau"
  },
  {
    "idx": 5158,
    "start": "02:20:25,440",
    "end": "02:20:27,900",
    "start_sec": 8425.44,
    "end_sec": 8427.9,
    "zh": "而是你把只鬼吞噬了",
    "vi": "mà là ngươi đã nuốt chửng con quỷ kia rồi."
  },
  {
    "idx": 5159,
    "start": "02:20:27,900",
    "end": "02:20:30,280",
    "start_sec": 8427.9,
    "end_sec": 8430.28,
    "zh": "我笑着脸完全听不懂程子皮在说什么",
    "vi": "Khuôn mặt cười hoàn toàn không hiểu Trình Tử Bì đang nói gì."
  },
  {
    "idx": 5160,
    "start": "02:20:30,280",
    "end": "02:20:31,900",
    "start_sec": 8430.28,
    "end_sec": 8431.9,
    "zh": "什么老妙柱吃鬼果",
    "vi": "Cái gì mà Vương Bạo Trư ăn quả quỷ chứ."
  },
  {
    "idx": 5161,
    "start": "02:20:31,900",
    "end": "02:20:33,460",
    "start_sec": 8431.9,
    "end_sec": 8433.46,
    "zh": "我怎么就吞噬吃鬼了",
    "vi": "Sao ta lại nuốt chửng Ngạ Quỷ được chứ."
  },
  {
    "idx": 5162,
    "start": "02:20:33,460",
    "end": "02:20:34,780",
    "start_sec": 8433.46,
    "end_sec": 8434.78,
    "zh": "我知道你很特殊",
    "vi": "Ta biết ngươi rất đặc biệt."
  },
  {
    "idx": 5163,
    "start": "02:20:34,780",
    "end": "02:20:36,220",
    "start_sec": 8434.78,
    "end_sec": 8436.22,
    "zh": "是从鬼域出来的",
    "vi": "Ngươi bước ra từ Quỷ Vực."
  },
  {
    "idx": 5164,
    "start": "02:20:36,220",
    "end": "02:20:38,000",
    "start_sec": 8436.22,
    "end_sec": 8438.0,
    "zh": "你从一出生就具备灵智",
    "vi": "Ngươi vừa sinh ra đã có linh trí."
  },
  {
    "idx": 5165,
    "start": "02:20:38,000",
    "end": "02:20:39,880",
    "start_sec": 8438.0,
    "end_sec": 8439.88,
    "zh": "具有无效化这样特殊的能力",
    "vi": "Sở hữu năng lực đặc biệt là vô hiệu hóa."
  },
  {
    "idx": 5166,
    "start": "02:20:39,880",
    "end": "02:20:41,360",
    "start_sec": 8439.88,
    "end_sec": 8441.36,
    "zh": "等级肯定要比吃鬼高",
    "vi": "Cấp bậc chắc chắn cao hơn Ngạ Quỷ."
  },
  {
    "idx": 5167,
    "start": "02:20:41,360",
    "end": "02:20:44,120",
    "start_sec": 8441.36,
    "end_sec": 8444.12,
    "zh": "能悄无声息的吞噬掉老妙柱体内的吃鬼",
    "vi": "Có thể âm thầm nuốt chửng Ngạ Quỷ trong cơ thể lão Diệu Trụ."
  },
  {
    "idx": 5168,
    "start": "02:20:44,120",
    "end": "02:20:45,060",
    "start_sec": 8444.12,
    "end_sec": 8445.06,
    "zh": "是一种当然",
    "vi": "Cũng là điều đương nhiên."
  },
  {
    "idx": 5169,
    "start": "02:20:45,060",
    "end": "02:20:47,740",
    "start_sec": 8445.06,
    "end_sec": 8447.74,
    "zh": "虽然不知道你是如何探出我的计划",
    "vi": "Tuy không biết làm sao ngươi phát hiện ra kế hoạch của ta."
  },
  {
    "idx": 5170,
    "start": "02:20:47,740",
    "end": "02:20:49,080",
    "start_sec": 8447.74,
    "end_sec": 8449.08,
    "zh": "但不得不说",
    "vi": "Nhưng phải thừa nhận rằng."
  },
  {
    "idx": 5171,
    "start": "02:20:49,080",
    "end": "02:20:50,660",
    "start_sec": 8449.08,
    "end_sec": 8450.66,
    "zh": "小哥你很聪明",
    "vi": "Cậu em, ngươi rất thông minh."
  },
  {
    "idx": 5172,
    "start": "02:20:50,660",
    "end": "02:20:53,060",
    "start_sec": 8450.66,
    "end_sec": 8453.06,
    "zh": "不过我就是要请待你",
    "vi": "Nhưng ta vẫn sẽ chiếm đoạt ngươi."
  },
  {
    "idx": 5173,
    "start": "02:20:53,060",
    "end": "02:20:53,840",
    "start_sec": 8453.06,
    "end_sec": 8453.84,
    "zh": "你又能如何",
    "vi": "Ngươi thì làm gì được ta chứ."
  },
  {
    "idx": 5174,
    "start": "02:20:53,840",
    "end": "02:20:54,820",
    "start_sec": 8453.84,
    "end_sec": 8454.82,
    "zh": "凡人之躯",
    "vi": "Thân xác phàm trần."
  },
  {
    "idx": 5175,
    "start": "02:20:54,820",
    "end": "02:20:56,160",
    "start_sec": 8454.82,
    "end_sec": 8456.16,
    "zh": "你妄不驾驭我",
    "vi": "Ngươi đừng hòng ngự trị ta."
  },
  {
    "idx": 5176,
    "start": "02:20:56,160",
    "end": "02:20:57,400",
    "start_sec": 8456.16,
    "end_sec": 8457.4,
    "zh": "简直痴心妄想",
    "vi": "Đúng là si tâm vọng tưởng."
  },
  {
    "idx": 5177,
    "start": "02:20:57,400",
    "end": "02:20:58,220",
    "start_sec": 8457.4,
    "end_sec": 8458.22,
    "zh": "小子",
    "vi": "Thằng nhóc."
  },
  {
    "idx": 5178,
    "start": "02:20:58,220",
    "end": "02:20:59,160",
    "start_sec": 8458.22,
    "end_sec": 8459.16,
    "zh": "你的身体",
    "vi": "Cơ thể của ngươi."
  },
  {
    "idx": 5179,
    "start": "02:20:59,160",
    "end": "02:21:00,120",
    "start_sec": 8459.16,
    "end_sec": 8460.12,
    "zh": "归我了",
    "vi": "Thuộc về ta rồi."
  },
  {
    "idx": 5180,
    "start": "02:21:00,120",
    "end": "02:21:00,860",
    "start_sec": 8460.12,
    "end_sec": 8460.86,
    "zh": "是吗",
    "vi": "Thế sao."
  },
  {
    "idx": 5181,
    "start": "02:21:00,860",
    "end": "02:21:02,120",
    "start_sec": 8460.86,
    "end_sec": 8462.12,
    "zh": "鬼将你了这几天",
    "vi": "Mấy ngày nay bị quỷ ám."
  },
  {
    "idx": 5182,
    "start": "02:21:02,120",
    "end": "02:21:03,280",
    "start_sec": 8462.12,
    "end_sec": 8463.28,
    "zh": "我可没少死过",
    "vi": "Tao đã chết không ít lần đâu."
  },
  {
    "idx": 5183,
    "start": "02:21:03,280",
    "end": "02:21:04,860",
    "start_sec": 8463.28,
    "end_sec": 8464.86,
    "zh": "我现在最不缺的",
    "vi": "Thứ bây giờ tao không thiếu nhất."
  },
  {
    "idx": 5184,
    "start": "02:21:04,860",
    "end": "02:21:05,920",
    "start_sec": 8464.86,
    "end_sec": 8465.92,
    "zh": "就是你",
    "vi": "Chính là mạng."
  },
  {
    "idx": 5185,
    "start": "02:21:05,920",
    "end": "02:21:08,100",
    "start_sec": 8465.92,
    "end_sec": 8468.1,
    "zh": "老子和你赌命",
    "vi": "Tao đánh cược mạng sống với mày."
  },
  {
    "idx": 5186,
    "start": "02:21:08,100",
    "end": "02:21:09,900",
    "start_sec": 8468.1,
    "end_sec": 8469.9,
    "zh": "说完",
    "vi": "Nói xong."
  },
  {
    "idx": 5187,
    "start": "02:21:09,900",
    "end": "02:21:11,320",
    "start_sec": 8469.9,
    "end_sec": 8471.32,
    "zh": "张子军大手一挥",
    "vi": "Trương Tử Quân vung mạnh tay."
  },
  {
    "idx": 5188,
    "start": "02:21:11,320",
    "end": "02:21:12,300",
    "start_sec": 8471.32,
    "end_sec": 8472.3,
    "zh": "一片烟红",
    "vi": "Một màu đỏ tươi."
  },
  {
    "idx": 5189,
    "start": "02:21:12,300",
    "end": "02:21:13,300",
    "start_sec": 8472.3,
    "end_sec": 8473.3,
    "zh": "马上哭笑着",
    "vi": "Liền vừa khóc vừa cười."
  },
  {
    "idx": 5190,
    "start": "02:21:13,300",
    "end": "02:21:15,200",
    "start_sec": 8473.3,
    "end_sec": 8475.2,
    "zh": "鲜血浆浆浆的脸泼满",
    "vi": "Máu tươi chảy ròng ròng xối đầy mặt."
  },
  {
    "idx": 5191,
    "start": "02:21:15,200",
    "end": "02:21:16,980",
    "start_sec": 8475.2,
    "end_sec": 8476.98,
    "zh": "发出嘶嘶作响的呼吸声",
    "vi": "Phát ra tiếng thở rít lên khe khẽ"
  },
  {
    "idx": 5192,
    "start": "02:21:16,980",
    "end": "02:21:18,480",
    "start_sec": 8476.98,
    "end_sec": 8478.48,
    "zh": "吴雪",
    "vi": "Máu đen"
  },
  {
    "idx": 5193,
    "start": "02:21:18,480",
    "end": "02:21:19,160",
    "start_sec": 8478.48,
    "end_sec": 8479.16,
    "zh": "吴雪",
    "vi": "Máu đen"
  },
  {
    "idx": 5194,
    "start": "02:21:19,160",
    "end": "02:21:19,880",
    "start_sec": 8479.16,
    "end_sec": 8479.88,
    "zh": "小子",
    "vi": "Thằng nhóc"
  },
  {
    "idx": 5195,
    "start": "02:21:19,880",
    "end": "02:21:21,580",
    "start_sec": 8479.88,
    "end_sec": 8481.58,
    "zh": "原来就是你给我喝的吴雪",
    "vi": "Hóa ra chính ngươi đã cho ta uống máu đen"
  },
  {
    "idx": 5196,
    "start": "02:21:21,580",
    "end": "02:21:22,920",
    "start_sec": 8481.58,
    "end_sec": 8482.92,
    "zh": "你好大的胆子",
    "vi": "Ngươi gan to thật đấy"
  },
  {
    "idx": 5197,
    "start": "02:21:22,920",
    "end": "02:21:23,520",
    "start_sec": 8482.92,
    "end_sec": 8483.52,
    "zh": "怎么",
    "vi": "Sao thế"
  },
  {
    "idx": 5198,
    "start": "02:21:23,520",
    "end": "02:21:25,220",
    "start_sec": 8483.52,
    "end_sec": 8485.22,
    "zh": "不是要爬到我的脑袋上吗",
    "vi": "Không phải muốn trèo lên đầu ta ngồi sao"
  },
  {
    "idx": 5199,
    "start": "02:21:25,220",
    "end": "02:21:25,780",
    "start_sec": 8485.22,
    "end_sec": 8485.78,
    "zh": "你爬呀",
    "vi": "Ngươi trèo đi"
  },
  {
    "idx": 5200,
    "start": "02:21:25,780",
    "end": "02:21:27,300",
    "start_sec": 8485.78,
    "end_sec": 8487.3,
    "zh": "我知道你和其他鬼一不靠",
    "vi": "Ta biết ngươi không giống những con quỷ khác"
  },
  {
    "idx": 5201,
    "start": "02:21:27,300",
    "end": "02:21:28,300",
    "start_sec": 8487.3,
    "end_sec": 8488.3,
    "zh": "不好意思啊",
    "vi": "Xin lỗi nhé"
  },
  {
    "idx": 5202,
    "start": "02:21:28,300",
    "end": "02:21:29,100",
    "start_sec": 8488.3,
    "end_sec": 8489.1,
    "zh": "我也和其他人不同",
    "vi": "Ta cũng khác với những người khác"
  },
  {
    "idx": 5203,
    "start": "02:21:29,100",
    "end": "02:21:30,920",
    "start_sec": 8489.1,
    "end_sec": 8490.92,
    "zh": "我有的是命和你赌",
    "vi": "Ta có cả mạng sống để cược với ngươi"
  },
  {
    "idx": 5204,
    "start": "02:21:30,920",
    "end": "02:21:31,660",
    "start_sec": 8490.92,
    "end_sec": 8491.66,
    "zh": "你",
    "vi": "Ngươi"
  },
  {
    "idx": 5205,
    "start": "02:21:31,660",
    "end": "02:21:32,260",
    "start_sec": 8491.66,
    "end_sec": 8492.26,
    "zh": "你",
    "vi": "Ngươi"
  },
  {
    "idx": 5206,
    "start": "02:21:32,260",
    "end": "02:21:33,940",
    "start_sec": 8492.26,
    "end_sec": 8493.94,
    "zh": "你他妈就是个疯子",
    "vi": "Ngươi đúng là một tên điên"
  },
  {
    "idx": 5207,
    "start": "02:21:33,940",
    "end": "02:21:35,620",
    "start_sec": 8493.94,
    "end_sec": 8495.62,
    "zh": "似乎因为黑狗血的缘故",
    "vi": "Dường như vì có máu chó đen"
  },
  {
    "idx": 5208,
    "start": "02:21:35,620",
    "end": "02:21:37,720",
    "start_sec": 8495.62,
    "end_sec": 8497.72,
    "zh": "狐孝仁脸鼓胀到人工床铺后",
    "vi": "Sau khi mặt của Hồ Hiếu Nhân phồng to lên"
  },
  {
    "idx": 5209,
    "start": "02:21:37,720",
    "end": "02:21:38,680",
    "start_sec": 8497.72,
    "end_sec": 8498.68,
    "zh": "又快速回复",
    "vi": "Lại nhanh chóng xẹp xuống"
  },
  {
    "idx": 5210,
    "start": "02:21:38,680",
    "end": "02:21:40,460",
    "start_sec": 8498.68,
    "end_sec": 8500.46,
    "zh": "像是一个武器放弃的星球",
    "vi": "Giống như một quả bóng bay bị xì hơi"
  },
  {
    "idx": 5211,
    "start": "02:21:40,460",
    "end": "02:21:41,060",
    "start_sec": 8500.46,
    "end_sec": 8501.06,
    "zh": "看来",
    "vi": "Xem ra"
  },
  {
    "idx": 5212,
    "start": "02:21:41,060",
    "end": "02:21:42,260",
    "start_sec": 8501.06,
    "end_sec": 8502.26,
    "zh": "是我赌对了",
    "vi": "Ta đã cược đúng rồi"
  },
  {
    "idx": 5213,
    "start": "02:21:42,260",
    "end": "02:21:43,240",
    "start_sec": 8502.26,
    "end_sec": 8503.24,
    "zh": "一滴黑狗血",
    "vi": "Chỉ một giọt máu chó đen"
  },
  {
    "idx": 5214,
    "start": "02:21:43,240",
    "end": "02:21:44,180",
    "start_sec": 8503.24,
    "end_sec": 8504.18,
    "zh": "就逼得老庙主",
    "vi": "Đã ép lão miếu chủ"
  },
  {
    "idx": 5215,
    "start": "02:21:44,180",
    "end": "02:21:45,340",
    "start_sec": 8504.18,
    "end_sec": 8505.34,
    "zh": "把你提前运出来",
    "vi": "Phải đưa ngươi ra ngoài trước thời hạn"
  },
  {
    "idx": 5216,
    "start": "02:21:45,340",
    "end": "02:21:45,1000",
    "start_sec": 8505.34,
    "end_sec": 8506.0,
    "zh": "我不信",
    "vi": "Ta không tin"
  },
  {
    "idx": 5217,
    "start": "02:21:45,1000",
    "end": "02:21:47,180",
    "start_sec": 8506.0,
    "end_sec": 8507.18,
    "zh": "明天我和小木居",
    "vi": "明天我和小木居"
  },
  {
    "idx": 5218,
    "start": "02:21:47,180",
    "end": "02:21:47,940",
    "start_sec": 8507.18,
    "end_sec": 8507.94,
    "zh": "待在这旁边",
    "vi": "Sẽ ở ngay bên cạnh này"
  },
  {
    "idx": 5219,
    "start": "02:21:47,940",
    "end": "02:21:48,880",
    "start_sec": 8507.94,
    "end_sec": 8508.88,
    "zh": "他迈回不了你",
    "vi": "Hắn không cứu được ngươi đâu"
  },
  {
    "idx": 5220,
    "start": "02:21:48,880",
    "end": "02:21:49,760",
    "start_sec": 8508.88,
    "end_sec": 8509.76,
    "zh": "说话之间",
    "vi": "Trong lúc nói chuyện"
  },
  {
    "idx": 5221,
    "start": "02:21:49,760",
    "end": "02:21:51,380",
    "start_sec": 8509.76,
    "end_sec": 8511.38,
    "zh": "老庙主的那颗人心脏",
    "vi": "Trái tim của lão miếu chủ"
  },
  {
    "idx": 5222,
    "start": "02:21:51,380",
    "end": "02:21:52,820",
    "start_sec": 8511.38,
    "end_sec": 8512.82,
    "zh": "早已成骨一散碎",
    "vi": "Đã sớm tan thành mảnh vụn"
  },
  {
    "idx": 5223,
    "start": "02:21:52,820",
    "end": "02:21:54,380",
    "start_sec": 8512.82,
    "end_sec": 8514.38,
    "zh": "小木居只化着前肢",
    "vi": "Tiểu Mộc Cư chỉ hóa ra chi trước"
  },
  {
    "idx": 5224,
    "start": "02:21:54,380",
    "end": "02:21:55,200",
    "start_sec": 8514.38,
    "end_sec": 8515.2,
    "zh": "也随之恢复",
    "vi": "Cũng theo đó mà hồi phục"
  },
  {
    "idx": 5225,
    "start": "02:21:55,200",
    "end": "02:21:56,740",
    "start_sec": 8515.2,
    "end_sec": 8516.74,
    "zh": "这才有了行动的能力",
    "vi": "Mới có được khả năng hành động"
  },
  {
    "idx": 5226,
    "start": "02:21:56,740",
    "end": "02:21:59,880",
    "start_sec": 8516.74,
    "end_sec": 8519.88,
    "zh": "好好好",
    "vi": "Được được được"
  },
  {
    "idx": 5227,
    "start": "02:21:59,880",
    "end": "02:22:00,760",
    "start_sec": 8519.88,
    "end_sec": 8520.76,
    "zh": "飞剑的蝼蚁",
    "vi": "Đồ kiến hôi dùng phi kiếm"
  },
  {
    "idx": 5228,
    "start": "02:22:00,760",
    "end": "02:22:02,360",
    "start_sec": 8520.76,
    "end_sec": 8522.36,
    "zh": "真以为靠着黑狗血",
    "vi": "Ngươi thật sự nghĩ rằng dựa vào máu chó đen"
  },
  {
    "idx": 5229,
    "start": "02:22:02,360",
    "end": "02:22:04,140",
    "start_sec": 8522.36,
    "end_sec": 8524.14,
    "zh": "就能阻止我吃了你吗",
    "vi": "Là có thể ngăn cản ta ăn thịt ngươi sao"
  },
  {
    "idx": 5230,
    "start": "02:22:04,140",
    "end": "02:22:04,720",
    "start_sec": 8524.14,
    "end_sec": 8524.72,
    "zh": "说完",
    "vi": "Nói xong"
  },
  {
    "idx": 5231,
    "start": "02:22:04,720",
    "end": "02:22:06,300",
    "start_sec": 8524.72,
    "end_sec": 8526.3,
    "zh": "虎啸人脸强忍着腹食",
    "vi": "Mặt người hổ gầm cố nén cơn đau bụng"
  },
  {
    "idx": 5232,
    "start": "02:22:06,300",
    "end": "02:22:09,360",
    "start_sec": 8526.3,
    "end_sec": 8529.36,
    "zh": "诚哥一面子一吼",
    "vi": "Thành ca gầm lên một tiếng"
  },
  {
    "idx": 5233,
    "start": "02:22:09,360",
    "end": "02:22:10,740",
    "start_sec": 8529.36,
    "end_sec": 8530.74,
    "zh": "拗着自己脖子夹紧",
    "vi": "Gồng cổ mình lên siết chặt"
  },
  {
    "idx": 5234,
    "start": "02:22:10,740",
    "end": "02:22:12,140",
    "start_sec": 8530.74,
    "end_sec": 8532.14,
    "zh": "脸色因为挤压冲血",
    "vi": "Sắc mặt vì bị ép mà sung huyết"
  },
  {
    "idx": 5235,
    "start": "02:22:12,140",
    "end": "02:22:12,800",
    "start_sec": 8532.14,
    "end_sec": 8532.8,
    "zh": "变得黑红",
    "vi": "Trở nên đen đỏ"
  },
  {
    "idx": 5236,
    "start": "02:22:12,800",
    "end": "02:22:14,560",
    "start_sec": 8532.8,
    "end_sec": 8534.56,
    "zh": "那虎啸人脸也跟着发紫",
    "vi": "Gương mặt người hổ gầm kia cũng tím tái theo"
  },
  {
    "idx": 5237,
    "start": "02:22:14,560",
    "end": "02:22:14,980",
    "start_sec": 8534.56,
    "end_sec": 8534.98,
    "zh": "来",
    "vi": "Đến đây"
  },
  {
    "idx": 5238,
    "start": "02:22:14,980",
    "end": "02:22:15,920",
    "start_sec": 8534.98,
    "end_sec": 8535.92,
    "zh": "我倒要看看",
    "vi": "Ta muốn xem thử"
  },
  {
    "idx": 5239,
    "start": "02:22:15,920",
    "end": "02:22:17,180",
    "start_sec": 8535.92,
    "end_sec": 8537.18,
    "zh": "是你先被我掐死",
    "vi": "Là ngươi bị ta bóp chết trước"
  },
  {
    "idx": 5240,
    "start": "02:22:17,180",
    "end": "02:22:18,520",
    "start_sec": 8537.18,
    "end_sec": 8538.52,
    "zh": "还是我扛不住先死",
    "vi": "Hay là ta không chịu nổi mà chết trước"
  },
  {
    "idx": 5241,
    "start": "02:22:18,520",
    "end": "02:22:19,280",
    "start_sec": 8538.52,
    "end_sec": 8539.28,
    "zh": "你",
    "vi": "Ngươi"
  },
  {
    "idx": 5242,
    "start": "02:22:19,280",
    "end": "02:22:20,800",
    "start_sec": 8539.28,
    "end_sec": 8540.8,
    "zh": "你他妈是疯子吗",
    "vi": "Mẹ kiếp ngươi là kẻ điên sao"
  },
  {
    "idx": 5243,
    "start": "02:22:20,800",
    "end": "02:22:22,360",
    "start_sec": 8540.8,
    "end_sec": 8542.36,
    "zh": "你是真的不怕死吗",
    "vi": "Ngươi thật sự không sợ chết sao"
  },
  {
    "idx": 5244,
    "start": "02:22:22,360",
    "end": "02:22:23,220",
    "start_sec": 8542.36,
    "end_sec": 8543.22,
    "zh": "我和你",
    "vi": "Ta và ngươi"
  },
  {
    "idx": 5245,
    "start": "02:22:23,220",
    "end": "02:22:24,620",
    "start_sec": 8543.22,
    "end_sec": 8544.62,
    "zh": "去用什么血口深仇",
    "vi": "Có thâm thù đại hận gì"
  },
  {
    "idx": 5246,
    "start": "02:22:24,620",
    "end": "02:22:25,840",
    "start_sec": 8544.62,
    "end_sec": 8545.84,
    "zh": "值得你这样念顿",
    "vi": "Mà đáng để ngươi làm thế này"
  },
  {
    "idx": 5247,
    "start": "02:22:25,840",
    "end": "02:22:28,300",
    "start_sec": 8545.84,
    "end_sec": 8548.3,
    "zh": "长子提想起这苦笑人面鬼",
    "vi": "Trường Tử nhớ lại cảnh tượng con quỷ mặt người hổ gầm này"
  },
  {
    "idx": 5248,
    "start": "02:22:28,300",
    "end": "02:22:29,560",
    "start_sec": 8548.3,
    "end_sec": 8549.56,
    "zh": "踩进脑袋的场景",
    "vi": "Dẫm nát đầu người"
  },
  {
    "idx": 5249,
    "start": "02:22:29,560",
    "end": "02:22:30,820",
    "start_sec": 8549.56,
    "end_sec": 8550.82,
    "zh": "脸色更加阴冷",
    "vi": "Sắc mặt càng thêm lạnh lẽo"
  },
  {
    "idx": 5250,
    "start": "02:22:30,820",
    "end": "02:22:32,620",
    "start_sec": 8550.82,
    "end_sec": 8552.62,
    "zh": "夹着脖子的时候更加冷清",
    "vi": "Lúc siết cổ càng thêm tàn nhẫn"
  },
  {
    "idx": 5251,
    "start": "02:22:32,620",
    "end": "02:22:33,360",
    "start_sec": 8552.62,
    "end_sec": 8553.36,
    "zh": "小子",
    "vi": "Tên nhóc"
  },
  {
    "idx": 5252,
    "start": "02:22:33,360",
    "end": "02:22:34,540",
    "start_sec": 8553.36,
    "end_sec": 8554.54,
    "zh": "你真是疯子",
    "vi": "Mày đúng là đồ điên"
  },
  {
    "idx": 5253,
    "start": "02:22:34,540",
    "end": "02:22:36,640",
    "start_sec": 8554.54,
    "end_sec": 8556.64,
    "zh": "脑袋还是头一次见自杀这么卖力",
    "vi": "Đầu óc lần đầu tiên tao thấy có kẻ liều mạng tự sát đến vậy"
  },
  {
    "idx": 5254,
    "start": "02:22:36,640",
    "end": "02:22:38,180",
    "start_sec": 8556.64,
    "end_sec": 8558.18,
    "zh": "这次算你赢了",
    "vi": "Lần này coi như mày thắng"
  },
  {
    "idx": 5255,
    "start": "02:22:38,180",
    "end": "02:22:39,120",
    "start_sec": 8558.18,
    "end_sec": 8559.12,
    "zh": "你给我等着",
    "vi": "Mày cứ chờ đấy"
  },
  {
    "idx": 5256,
    "start": "02:22:39,120",
    "end": "02:22:39,980",
    "start_sec": 8559.12,
    "end_sec": 8559.98,
    "zh": "我迟早",
    "vi": "Sớm muộn gì"
  },
  {
    "idx": 5257,
    "start": "02:22:39,980",
    "end": "02:22:41,740",
    "start_sec": 8559.98,
    "end_sec": 8561.74,
    "zh": "迟早会让你后悔的",
    "vi": "Sớm muộn gì tao cũng bắt mày phải hối hận"
  },
  {
    "idx": 5258,
    "start": "02:22:54,620",
    "end": "02:23:00,080",
    "start_sec": 8574.62,
    "end_sec": 8580.08,
    "zh": "我没死",
    "vi": "Tao chưa chết"
  },
  {
    "idx": 5259,
    "start": "02:23:00,080",
    "end": "02:23:02,620",
    "start_sec": 8580.08,
    "end_sec": 8582.62,
    "zh": "看来这次只是昏不去了",
    "vi": "Xem ra lần này chỉ là ngất đi thôi"
  },
  {
    "idx": 5260,
    "start": "02:23:02,620",
    "end": "02:23:03,380",
    "start_sec": 8582.62,
    "end_sec": 8583.38,
    "zh": "裙子",
    "vi": "Cái váy"
  },
  {
    "idx": 5261,
    "start": "02:23:03,380",
    "end": "02:23:06,600",
    "start_sec": 8583.38,
    "end_sec": 8586.6,
    "zh": "好在这长发女鬼灵智不高",
    "vi": "May mà con ma nữ tóc dài này trí tuệ không cao"
  },
  {
    "idx": 5262,
    "start": "02:23:06,600",
    "end": "02:23:07,640",
    "start_sec": 8586.6,
    "end_sec": 8587.64,
    "zh": "在我昏迷的时候",
    "vi": "Lúc tao bất tỉnh"
  },
  {
    "idx": 5263,
    "start": "02:23:07,640",
    "end": "02:23:08,860",
    "start_sec": 8587.64,
    "end_sec": 8588.86,
    "zh": "只是板中的裙子",
    "vi": "Chỉ lấy cái váy trong túi"
  },
  {
    "idx": 5264,
    "start": "02:23:08,860",
    "end": "02:23:10,060",
    "start_sec": 8588.86,
    "end_sec": 8590.06,
    "zh": "没有对我动手",
    "vi": "Chứ không động thủ với tao"
  },
  {
    "idx": 5265,
    "start": "02:23:10,060",
    "end": "02:23:12,000",
    "start_sec": 8590.06,
    "end_sec": 8592.0,
    "zh": "老妙柱早就死了",
    "vi": "Lão Miêu Trụ đã chết từ lâu"
  },
  {
    "idx": 5266,
    "start": "02:23:12,000",
    "end": "02:23:14,500",
    "start_sec": 8592.0,
    "end_sec": 8594.5,
    "zh": "看来她体内的吃鬼也不死了",
    "vi": "Xem ra con quỷ ăn thịt trong người bà ta cũng chết rồi"
  },
  {
    "idx": 5267,
    "start": "02:23:14,500",
    "end": "02:23:16,340",
    "start_sec": 8594.5,
    "end_sec": 8596.34,
    "zh": "最后长子一摸了摸脖子",
    "vi": "Cuối cùng Trưởng Tử sờ cổ mình"
  },
  {
    "idx": 5268,
    "start": "02:23:16,340",
    "end": "02:23:17,980",
    "start_sec": 8596.34,
    "end_sec": 8597.98,
    "zh": "做出一块皱巴巴的皮肤",
    "vi": "Thấy một mảng da nhăn nhúm"
  },
  {
    "idx": 5269,
    "start": "02:23:17,980",
    "end": "02:23:20,040",
    "start_sec": 8597.98,
    "end_sec": 8600.04,
    "zh": "上面就是一个苦笑人脸的花纹",
    "vi": "Trên đó có hoa văn khuôn mặt người đang cười khổ"
  },
  {
    "idx": 5270,
    "start": "02:23:20,040",
    "end": "02:23:21,040",
    "start_sec": 8600.04,
    "end_sec": 8601.04,
    "zh": "苦笑人脸",
    "vi": "Khuôn mặt cười khổ"
  },
  {
    "idx": 5271,
    "start": "02:23:21,040",
    "end": "02:23:21,760",
    "start_sec": 8601.04,
    "end_sec": 8601.76,
    "zh": "无笑话",
    "vi": "Không có gì buồn cười"
  },
  {
    "idx": 5272,
    "start": "02:23:21,760",
    "end": "02:23:22,720",
    "start_sec": 8601.76,
    "end_sec": 8602.72,
    "zh": "从现在开始",
    "vi": "Từ bây giờ"
  },
  {
    "idx": 5273,
    "start": "02:23:22,720",
    "end": "02:23:23,900",
    "start_sec": 8602.72,
    "end_sec": 8603.9,
    "zh": "我也是一鬼之王",
    "vi": "Tao cũng là vua của một loài quỷ"
  },
  {
    "idx": 5274,
    "start": "02:23:23,900",
    "end": "02:23:25,500",
    "start_sec": 8603.9,
    "end_sec": 8605.5,
    "zh": "橙子皮抱起小墨镜",
    "vi": "Trưởng Tử bế Tiểu Mặc Kính lên"
  },
  {
    "idx": 5275,
    "start": "02:23:25,500",
    "end": "02:23:27,100",
    "start_sec": 8605.5,
    "end_sec": 8607.1,
    "zh": "朝着寺庙殿堂走进",
    "vi": "Bước vào đại điện của ngôi chùa"
  },
  {
    "idx": 5276,
    "start": "02:23:27,100",
    "end": "02:23:28,960",
    "start_sec": 8607.1,
    "end_sec": 8608.96,
    "zh": "殿堂内",
    "vi": "Trong đại điện"
  },
  {
    "idx": 5277,
    "start": "02:23:28,960",
    "end": "02:23:30,440",
    "start_sec": 8608.96,
    "end_sec": 8610.44,
    "zh": "鬼树的树根还盘紧",
    "vi": "Rễ cây Quỷ Thụ vẫn đang quấn chặt"
  },
  {
    "idx": 5278,
    "start": "02:23:30,440",
    "end": "02:23:33,000",
    "start_sec": 8610.44,
    "end_sec": 8613.0,
    "zh": "橙子皮看见了满身扭曲人脸的鬼树",
    "vi": "Trưởng Tử nhìn thấy cây Quỷ Thụ với đầy khuôn mặt người méo mó"
  },
  {
    "idx": 5279,
    "start": "02:23:33,000",
    "end": "02:23:33,940",
    "start_sec": 8613.0,
    "end_sec": 8613.94,
    "zh": "眼神闪烁",
    "vi": "Ánh mắt lóe lên"
  },
  {
    "idx": 5280,
    "start": "02:23:33,940",
    "end": "02:23:35,460",
    "start_sec": 8613.94,
    "end_sec": 8615.46,
    "zh": "献祭一百个人给鬼树",
    "vi": "Hiến tế một trăm người cho cây Quỷ Thụ"
  },
  {
    "idx": 5281,
    "start": "02:23:35,460",
    "end": "02:23:36,420",
    "start_sec": 8615.46,
    "end_sec": 8616.42,
    "zh": "便能催生鬼果",
    "vi": "Thì có thể thúc chín Quỷ Quả."
  },
  {
    "idx": 5282,
    "start": "02:23:36,420",
    "end": "02:23:38,100",
    "start_sec": 8616.42,
    "end_sec": 8618.1,
    "zh": "如果再忽悠一百个人来",
    "vi": "Nếu lại lừa thêm một trăm người đến."
  },
  {
    "idx": 5283,
    "start": "02:23:38,100",
    "end": "02:23:39,680",
    "start_sec": 8618.1,
    "end_sec": 8619.68,
    "zh": "岂不是可以得到第二颗鬼果",
    "vi": "Chẳng phải là có thể có được quả Quỷ Quả thứ hai sao."
  },
  {
    "idx": 5284,
    "start": "02:23:39,680",
    "end": "02:23:41,660",
    "start_sec": 8619.68,
    "end_sec": 8621.66,
    "zh": "但是这心思只是生出片刻",
    "vi": "Nhưng suy nghĩ này chỉ vừa xuất hiện trong chốc lát."
  },
  {
    "idx": 5285,
    "start": "02:23:41,660",
    "end": "02:23:43,500",
    "start_sec": 8621.66,
    "end_sec": 8623.5,
    "zh": "便被橙子皮抛出脑后",
    "vi": "Đã bị Trần Tử Bì quẳng ra sau đầu."
  },
  {
    "idx": 5286,
    "start": "02:23:43,500",
    "end": "02:23:44,100",
    "start_sec": 8623.5,
    "end_sec": 8624.1,
    "zh": "在这末世",
    "vi": "Trong thời mạt thế này."
  },
  {
    "idx": 5287,
    "start": "02:23:44,100",
    "end": "02:23:45,080",
    "start_sec": 8624.1,
    "end_sec": 8625.08,
    "zh": "要找一百人",
    "vi": "Muốn tìm một trăm người."
  },
  {
    "idx": 5288,
    "start": "02:23:45,080",
    "end": "02:23:45,820",
    "start_sec": 8625.08,
    "end_sec": 8625.82,
    "zh": "却是不像话",
    "vi": "Lại không hề dễ dàng."
  },
  {
    "idx": 5289,
    "start": "02:23:45,820",
    "end": "02:23:46,800",
    "start_sec": 8625.82,
    "end_sec": 8626.8,
    "zh": "再者",
    "vi": "Hơn nữa."
  },
  {
    "idx": 5290,
    "start": "02:23:46,800",
    "end": "02:23:48,840",
    "start_sec": 8626.8,
    "end_sec": 8628.84,
    "zh": "我现在有个无效化的鬼异机身",
    "vi": "Hiện tại ta đang có một cơ thể quỷ dị vô hiệu hóa."
  },
  {
    "idx": 5291,
    "start": "02:23:48,840",
    "end": "02:23:50,280",
    "start_sec": 8628.84,
    "end_sec": 8630.28,
    "zh": "吸收第二个鬼异的法",
    "vi": "Nếu hấp thụ thêm năng lượng quỷ dị thứ hai."
  },
  {
    "idx": 5292,
    "start": "02:23:50,280",
    "end": "02:23:52,000",
    "start_sec": 8630.28,
    "end_sec": 8632.0,
    "zh": "老不准要被苦笑人面鬼吞噬",
    "vi": "Rất có thể sẽ bị mặt quỷ dở khóc dở cười nuốt chửng."
  },
  {
    "idx": 5293,
    "start": "02:23:52,000",
    "end": "02:23:53,300",
    "start_sec": 8632.0,
    "end_sec": 8633.3,
    "zh": "要是不得老庙主后尘",
    "vi": "Nếu đi vào vết xe đổ của lão miếu chủ."
  },
  {
    "idx": 5294,
    "start": "02:23:53,300",
    "end": "02:23:54,240",
    "start_sec": 8633.3,
    "end_sec": 8634.24,
    "zh": "就得不成失望",
    "vi": "Thì sẽ không thể thoát khỏi cái chết."
  },
  {
    "idx": 5295,
    "start": "02:23:54,240",
    "end": "02:23:55,080",
    "start_sec": 8634.24,
    "end_sec": 8635.08,
    "zh": "而且",
    "vi": "Hơn nữa."
  },
  {
    "idx": 5296,
    "start": "02:23:55,080",
    "end": "02:23:56,500",
    "start_sec": 8635.08,
    "end_sec": 8636.5,
    "zh": "坑杀百人这种事",
    "vi": "Việc hại chết trăm người như thế này."
  },
  {
    "idx": 5297,
    "start": "02:23:56,500",
    "end": "02:23:57,980",
    "start_sec": 8636.5,
    "end_sec": 8637.98,
    "zh": "肠子皮陷入沉默",
    "vi": "Trần Tử Bì rơi vào trầm mặc."
  },
  {
    "idx": 5298,
    "start": "02:23:57,980",
    "end": "02:23:59,640",
    "start_sec": 8637.98,
    "end_sec": 8639.64,
    "zh": "无效化的鬼力虽然强",
    "vi": "Sức mạnh quỷ dị vô hiệu hóa tuy mạnh."
  },
  {
    "idx": 5299,
    "start": "02:23:59,640",
    "end": "02:24:00,740",
    "start_sec": 8639.64,
    "end_sec": 8640.74,
    "zh": "后病却也不少",
    "vi": "Nhưng di chứng cũng không ít."
  },
  {
    "idx": 5300,
    "start": "02:24:00,740",
    "end": "02:24:01,400",
    "start_sec": 8640.74,
    "end_sec": 8641.4,
    "zh": "也不知道",
    "vi": "Cũng không biết."
  },
  {
    "idx": 5301,
    "start": "02:24:01,400",
    "end": "02:24:03,060",
    "start_sec": 8641.4,
    "end_sec": 8643.06,
    "zh": "老庙主的彻底路线是什么",
    "vi": "Con đường hoàn chỉnh của lão miếu chủ là gì."
  },
  {
    "idx": 5302,
    "start": "02:24:03,060",
    "end": "02:24:04,920",
    "start_sec": 8643.06,
    "end_sec": 8644.92,
    "zh": "一个人果然还是麻烦的",
    "vi": "Một mình quả nhiên vẫn rất phiền phức."
  },
  {
    "idx": 5303,
    "start": "02:24:04,920",
    "end": "02:24:05,760",
    "start_sec": 8644.92,
    "end_sec": 8645.76,
    "zh": "这鬼术是个宝贝",
    "vi": "Thuật quỷ này là một bảo vật."
  },
  {
    "idx": 5304,
    "start": "02:24:05,760",
    "end": "02:24:06,620",
    "start_sec": 8645.76,
    "end_sec": 8646.62,
    "zh": "该有点不早",
    "vi": "Mang đi cũng không tiện."
  },
  {
    "idx": 5305,
    "start": "02:24:06,620",
    "end": "02:24:07,440",
    "start_sec": 8646.62,
    "end_sec": 8647.44,
    "zh": "扔也不能扔",
    "vi": "Vứt cũng không thể vứt."
  },
  {
    "idx": 5306,
    "start": "02:24:07,440",
    "end": "02:24:08,020",
    "start_sec": 8647.44,
    "end_sec": 8648.02,
    "zh": "看来",
    "vi": "Xem ra."
  },
  {
    "idx": 5307,
    "start": "02:24:08,020",
    "end": "02:24:09,480",
    "start_sec": 8648.02,
    "end_sec": 8649.48,
    "zh": "只能先找个地方埋了",
    "vi": "Chỉ có thể tìm một nơi chôn nó trước."
  },
  {
    "idx": 5308,
    "start": "02:24:09,480",
    "end": "02:24:10,800",
    "start_sec": 8649.48,
    "end_sec": 8650.8,
    "zh": "等以后再回来去吧",
    "vi": "Đợi sau này quay lại lấy sau."
  },
  {
    "idx": 5309,
    "start": "02:24:10,800",
    "end": "02:24:11,660",
    "start_sec": 8650.8,
    "end_sec": 8651.66,
    "zh": "心思纠结间",
    "vi": "Trong lúc tâm trí đang rối bời."
  },
  {
    "idx": 5310,
    "start": "02:24:11,660",
    "end": "02:24:12,820",
    "start_sec": 8651.66,
    "end_sec": 8652.82,
    "zh": "肠子皮胸口",
    "vi": "Lồng ngực của Trần Tử Bì."
  },
  {
    "idx": 5311,
    "start": "02:24:12,820",
    "end": "02:24:13,800",
    "start_sec": 8652.82,
    "end_sec": 8653.8,
    "zh": "传来一阵震动",
    "vi": "Truyền đến một trận rung động."
  },
  {
    "idx": 5312,
    "start": "02:24:13,800",
    "end": "02:24:14,780",
    "start_sec": 8653.8,
    "end_sec": 8654.78,
    "zh": "献祭鬼木",
    "vi": "Hiến tế gỗ quỷ."
  },
  {
    "idx": 5313,
    "start": "02:24:14,780",
    "end": "02:24:15,360",
    "start_sec": 8654.78,
    "end_sec": 8655.36,
    "zh": "鬼意",
    "vi": "Quỷ ý."
  },
  {
    "idx": 5314,
    "start": "02:24:15,360",
    "end": "02:24:16,740",
    "start_sec": 8655.36,
    "end_sec": 8656.74,
    "zh": "换取一定信息",
    "vi": "Đổi lấy thông tin nhất định."
  },
  {
    "idx": 5315,
    "start": "02:24:16,740",
    "end": "02:24:17,760",
    "start_sec": 8656.74,
    "end_sec": 8657.76,
    "zh": "对等着另一",
    "vi": "Đối ứng với một cái khác."
  },
  {
    "idx": 5316,
    "start": "02:24:17,760",
    "end": "02:24:18,720",
    "start_sec": 8657.76,
    "end_sec": 8658.72,
    "zh": "谁在说话",
    "vi": "Ai đang nói đó."
  },
  {
    "idx": 5317,
    "start": "02:24:18,720",
    "end": "02:24:19,140",
    "start_sec": 8658.72,
    "end_sec": 8659.14,
    "zh": "谁",
    "vi": "Ai thế."
  },
  {
    "idx": 5318,
    "start": "02:24:19,140",
    "end": "02:24:21,240",
    "start_sec": 8659.14,
    "end_sec": 8661.24,
    "zh": "是你吗",
    "vi": "Là ngươi sao."
  },
  {
    "idx": 5319,
    "start": "02:24:21,240",
    "end": "02:24:23,000",
    "start_sec": 8661.24,
    "end_sec": 8663.0,
    "zh": "香炉是否献祭",
    "vi": "Có hiến tế cho lư hương không."
  },
  {
    "idx": 5320,
    "start": "02:24:23,000",
    "end": "02:24:23,680",
    "start_sec": 8663.0,
    "end_sec": 8663.68,
    "zh": "献祭",
    "vi": "Hiến tế."
  },
  {
    "idx": 5321,
    "start": "02:24:23,680",
    "end": "02:24:24,580",
    "start_sec": 8663.68,
    "end_sec": 8664.58,
    "zh": "献祭什么",
    "vi": "Hiến tế cái gì."
  },
  {
    "idx": 5322,
    "start": "02:24:24,580",
    "end": "02:24:25,500",
    "start_sec": 8664.58,
    "end_sec": 8665.5,
    "zh": "拿什么献祭",
    "vi": "Lấy cái gì để hiến tế."
  },
  {
    "idx": 5323,
    "start": "02:24:25,500",
    "end": "02:24:26,100",
    "start_sec": 8665.5,
    "end_sec": 8666.1,
    "zh": "鬼树",
    "vi": "Cây quỷ."
  },
  {
    "idx": 5324,
    "start": "02:24:26,100",
    "end": "02:24:27,980",
    "start_sec": 8666.1,
    "end_sec": 8667.98,
    "zh": "你能吃得下那么大一个树",
    "vi": "Ngươi có thể nuốt trôi một cái cây lớn như vậy sao."
  },
  {
    "idx": 5325,
    "start": "02:24:27,980",
    "end": "02:24:28,600",
    "start_sec": 8667.98,
    "end_sec": 8668.6,
    "zh": "可以",
    "vi": "Được."
  },
  {
    "idx": 5326,
    "start": "02:24:28,600",
    "end": "02:24:30,660",
    "start_sec": 8668.6,
    "end_sec": 8670.66,
    "zh": "鬼树这种不可多得的宝贝",
    "vi": "Một bảo vật hiếm có như cây quỷ."
  },
  {
    "idx": 5327,
    "start": "02:24:30,660",
    "end": "02:24:32,500",
    "start_sec": 8670.66,
    "end_sec": 8672.5,
    "zh": "能这么随便交给一个香炉吗",
    "vi": "Có thể tùy tiện giao cho một cái lư hương như vậy sao."
  },
  {
    "idx": 5328,
    "start": "02:24:32,500",
    "end": "02:24:33,480",
    "start_sec": 8672.5,
    "end_sec": 8673.48,
    "zh": "是否献祭",
    "vi": "Có hiến tế không."
  },
  {
    "idx": 5329,
    "start": "02:24:33,480",
    "end": "02:24:34,580",
    "start_sec": 8673.48,
    "end_sec": 8674.58,
    "zh": "我献祭给你东西",
    "vi": "Ta hiến tế đồ vật cho ngươi."
  },
  {
    "idx": 5330,
    "start": "02:24:34,580",
    "end": "02:24:35,680",
    "start_sec": 8674.58,
    "end_sec": 8675.68,
    "zh": "你能给我什么",
    "vi": "Ngươi có thể cho ta cái gì."
  },
  {
    "idx": 5331,
    "start": "02:24:35,680",
    "end": "02:24:36,880",
    "start_sec": 8675.68,
    "end_sec": 8676.88,
    "zh": "三个金钱",
    "vi": "Ba đồng tiền."
  },
  {
    "idx": 5332,
    "start": "02:24:36,880",
    "end": "02:24:38,900",
    "start_sec": 8676.88,
    "end_sec": 8678.9,
    "zh": "或者一个对等新生鬼迹",
    "vi": "Hoặc là một vết tích quỷ mới sinh tương đương."
  },
  {
    "idx": 5333,
    "start": "02:24:38,900",
    "end": "02:24:41,200",
    "start_sec": 8678.9,
    "end_sec": 8681.2,
    "zh": "这条件听起来的确诱人",
    "vi": "Điều kiện này nghe quả thực rất hấp dẫn."
  },
  {
    "idx": 5334,
    "start": "02:24:41,200",
    "end": "02:24:42,100",
    "start_sec": 8681.2,
    "end_sec": 8682.1,
    "zh": "如果是真的话",
    "vi": "Nếu đó là sự thật."
  },
  {
    "idx": 5335,
    "start": "02:24:42,100",
    "end": "02:24:44,060",
    "start_sec": 8682.1,
    "end_sec": 8684.06,
    "zh": "一起一株不能随身携带的鬼树",
    "vi": "So với một cây quỷ không thể mang theo bên người."
  },
  {
    "idx": 5336,
    "start": "02:24:44,060",
    "end": "02:24:45,200",
    "start_sec": 8684.06,
    "end_sec": 8685.2,
    "zh": "确实要有用很多",
    "vi": "Thì quả thực có ích hơn nhiều."
  },
  {
    "idx": 5337,
    "start": "02:24:45,200",
    "end": "02:24:47,480",
    "start_sec": 8685.2,
    "end_sec": 8687.48,
    "zh": "但是香炉的话可信吗",
    "vi": "Nhưng lời của lư hương có đáng tin không."
  },
  {
    "idx": 5338,
    "start": "02:24:47,480",
    "end": "02:24:49,440",
    "start_sec": 8687.48,
    "end_sec": 8689.44,
    "zh": "回想到香炉多次救过他的命",
    "vi": "Nghĩ đến việc lư hương đã nhiều lần cứu mạng mình."
  },
  {
    "idx": 5339,
    "start": "02:24:49,440",
    "end": "02:24:51,720",
    "start_sec": 8689.44,
    "end_sec": 8691.72,
    "zh": "床子皮最终还是决定先子",
    "vi": "Trần Tử Bì cuối cùng vẫn quyết định hiến tế."
  },
  {
    "idx": 5340,
    "start": "02:24:51,720",
    "end": "02:24:52,540",
    "start_sec": 8691.72,
    "end_sec": 8692.54,
    "zh": "换诡异的话",
    "vi": "Để đổi lấy quỷ dị."
  },
  {
    "idx": 5341,
    "start": "02:24:52,540",
    "end": "02:24:54,960",
    "start_sec": 8692.54,
    "end_sec": 8694.96,
    "zh": "且不说他会不会与苦笑人脸相互排斥",
    "vi": "Chưa nói đến việc nó có bài xích với khuôn mặt dở khóc dở cười kia hay không."
  },
  {
    "idx": 5342,
    "start": "02:24:54,960",
    "end": "02:24:58,221",
    "start_sec": 8694.96,
    "end_sec": 8698.221,
    "zh": "就我目前这水平估计也无法驾驭两只鬼床子皮想了想我写三个信息息还有,你这消息可靠吗?可靠那我之前拥有你的时候,你为什么从来不说献祭之类的话?",
    "vi": "Chỉ với thực lực hiện tại của ta thì ước chừng cũng không thể khống chế được hai con quỷ"
  },
  {
    "idx": 5342,
    "start": "02:24:58,221",
    "end": "02:25:00,503",
    "start_sec": 8698.221,
    "end_sec": 8700.503,
    "zh": "就我目前这水平估计也无法驾驭两只鬼床子皮想了想我写三个信息息还有,你这消息可靠吗?可靠那我之前拥有你的时候,你为什么从来不说献祭之类的话?",
    "vi": "Trương Tử Bì suy nghĩ một lát rồi nói, ta muốn ba tin tức"
  },
  {
    "idx": 5342,
    "start": "02:25:00,503",
    "end": "02:25:02,296",
    "start_sec": 8700.503,
    "end_sec": 8702.296,
    "zh": "就我目前这水平估计也无法驾驭两只鬼床子皮想了想我写三个信息息还有,你这消息可靠吗?可靠那我之前拥有你的时候,你为什么从来不说献祭之类的话?",
    "vi": "Ngoài ra, tin tức này của ngươi có đáng tin không"
  },
  {
    "idx": 5342,
    "start": "02:25:02,296",
    "end": "02:25:02,622",
    "start_sec": 8702.296,
    "end_sec": 8702.622,
    "zh": "就我目前这水平估计也无法驾驭两只鬼床子皮想了想我写三个信息息还有,你这消息可靠吗?可靠那我之前拥有你的时候,你为什么从来不说献祭之类的话?",
    "vi": "Đáng tin"
  },
  {
    "idx": 5342,
    "start": "02:25:02,622",
    "end": "02:25:05,557",
    "start_sec": 8702.622,
    "end_sec": 8705.557,
    "zh": "就我目前这水平估计也无法驾驭两只鬼床子皮想了想我写三个信息息还有,你这消息可靠吗?可靠那我之前拥有你的时候,你为什么从来不说献祭之类的话?",
    "vi": "Vậy lúc trước khi ta sở hữu ngươi, tại sao ngươi chưa từng nói về chuyện hiến tế"
  },
  {
    "idx": 5343,
    "start": "02:25:05,937",
    "end": "02:25:07,537",
    "start_sec": 8705.937,
    "end_sec": 8707.537,
    "zh": "附近没有合格的献祭品",
    "vi": "Xung quanh không có vật hiến tế nào phù hợp."
  },
  {
    "idx": 5344,
    "start": "02:25:07,537",
    "end": "02:25:08,777",
    "start_sec": 8707.537,
    "end_sec": 8708.777,
    "zh": "哦,要怎么献祭?",
    "vi": "Ồ, phải hiến tế thế nào."
  },
  {
    "idx": 5345,
    "start": "02:25:09,117",
    "end": "02:25:11,017",
    "start_sec": 8709.117,
    "end_sec": 8711.017,
    "zh": "只需将献祭品放入炉中",
    "vi": "Chỉ cần đặt vật hiến tế vào trong lư hương."
  },
  {
    "idx": 5346,
    "start": "02:25:11,017",
    "end": "02:25:14,117",
    "start_sec": 8711.017,
    "end_sec": 8714.117,
    "zh": "与香炉沟通着,长子皮来到鬼树正下方",
    "vi": "Vừa giao tiếp với lư hương, Trương Tử Bì vừa đi đến ngay dưới gốc cây quỷ."
  },
  {
    "idx": 5347,
    "start": "02:25:14,117",
    "end": "02:25:16,137",
    "start_sec": 8714.117,
    "end_sec": 8716.137,
    "zh": "他抽出一根树根,塞进炉中",
    "vi": "Hắn rút ra một chiếc rễ cây rồi nhét vào trong lư hương."
  },
  {
    "idx": 5348,
    "start": "02:25:24,997",
    "end": "02:25:30,757",
    "start_sec": 8724.997,
    "end_sec": 8730.757,
    "zh": "你想要什么",
    "vi": "Ngươi muốn cái gì."
  },
  {
    "idx": 5349,
    "start": "02:25:30,757",
    "end": "02:25:32,217",
    "start_sec": 8730.757,
    "end_sec": 8732.217,
    "zh": "我想要三个信息",
    "vi": "Ta muốn biết ba tin tức."
  },
  {
    "idx": 5350,
    "start": "02:25:32,217",
    "end": "02:25:32,617",
    "start_sec": 8732.217,
    "end_sec": 8732.617,
    "zh": "请问",
    "vi": "Xin cứ hỏi."
  },
  {
    "idx": 5351,
    "start": "02:25:32,617",
    "end": "02:25:33,277",
    "start_sec": 8732.617,
    "end_sec": 8733.277,
    "zh": "第一个",
    "vi": "Câu hỏi thứ nhất."
  },
  {
    "idx": 5352,
    "start": "02:25:33,277",
    "end": "02:25:34,597",
    "start_sec": 8733.277,
    "end_sec": 8734.597,
    "zh": "不是脖子上的鬼面",
    "vi": "Mặt quỷ trên cổ."
  },
  {
    "idx": 5353,
    "start": "02:25:34,597",
    "end": "02:25:35,497",
    "start_sec": 8734.597,
    "end_sec": 8735.497,
    "zh": "到底是什么",
    "vi": "Rốt cuộc là cái gì."
  },
  {
    "idx": 5354,
    "start": "02:25:35,497",
    "end": "02:25:38,077",
    "start_sec": 8735.497,
    "end_sec": 8738.077,
    "zh": "由鬼玉鬼树养出的鬼果孕育而出",
    "vi": "Được sinh ra từ quả quỷ do cây quỷ nuôi dưỡng bằng ngọc quỷ."
  },
  {
    "idx": 5355,
    "start": "02:25:38,077",
    "end": "02:25:39,117",
    "start_sec": 8738.077,
    "end_sec": 8739.117,
    "zh": "鬼面扭曲",
    "vi": "Mặt quỷ vặn vẹo."
  },
  {
    "idx": 5356,
    "start": "02:25:39,117",
    "end": "02:25:41,137",
    "start_sec": 8739.117,
    "end_sec": 8741.137,
    "zh": "可使一般鬼异的能力失效",
    "vi": "Có thể làm vô hiệu hóa năng lực của những con quỷ thông thường."
  },
  {
    "idx": 5357,
    "start": "02:25:41,137",
    "end": "02:25:43,177",
    "start_sec": 8741.137,
    "end_sec": 8743.177,
    "zh": "投喂鬼面疮一定鬼异",
    "vi": "Cho mặt quỷ ăn một số loại quỷ nhất định."
  },
  {
    "idx": 5358,
    "start": "02:25:43,177",
    "end": "02:25:45,157",
    "start_sec": 8743.177,
    "end_sec": 8745.157,
    "zh": "可使其能力具象化提升",
    "vi": "Có thể giúp năng lực của nó được cụ thể hóa và nâng cao."
  },
  {
    "idx": 5359,
    "start": "02:25:45,157",
    "end": "02:25:46,717",
    "start_sec": 8745.157,
    "end_sec": 8746.717,
    "zh": "收入与风险并存",
    "vi": "Lợi ích và rủi ro luôn đi đôi với nhau."
  },
  {
    "idx": 5360,
    "start": "02:25:46,717",
    "end": "02:25:47,737",
    "start_sec": 8746.717,
    "end_sec": 8747.737,
    "zh": "鬼异越强",
    "vi": "Quỷ dị càng mạnh."
  },
  {
    "idx": 5361,
    "start": "02:25:47,737",
    "end": "02:25:49,397",
    "start_sec": 8747.737,
    "end_sec": 8749.397,
    "zh": "自身越是无法控制",
    "vi": "Bản thân ngươi càng không thể khống chế được."
  },
  {
    "idx": 5362,
    "start": "02:25:49,397",
    "end": "02:25:51,237",
    "start_sec": 8749.397,
    "end_sec": 8751.237,
    "zh": "时刻注意自己的脖子",
    "vi": "Hãy luôn chú ý đến chiếc cổ của mình."
  },
  {
    "idx": 5363,
    "start": "02:25:51,237",
    "end": "02:25:52,537",
    "start_sec": 8751.237,
    "end_sec": 8752.537,
    "zh": "人脸长出之际",
    "vi": "Khi khuôn mặt người hoàn toàn mọc ra."
  },
  {
    "idx": 5364,
    "start": "02:25:52,537",
    "end": "02:25:53,997",
    "start_sec": 8752.537,
    "end_sec": 8753.997,
    "zh": "激素者茂密之下",
    "vi": "Cũng là lúc vật chủ sẽ mất mạng."
  },
  {
    "idx": 5365,
    "start": "02:25:53,997",
    "end": "02:25:56,237",
    "start_sec": 8753.997,
    "end_sec": 8756.237,
    "zh": "原来这玩意叫鬼灭坑",
    "vi": "Hóa ra thứ này được gọi là mặt quỷ."
  },
  {
    "idx": 5366,
    "start": "02:25:56,237",
    "end": "02:25:58,277",
    "start_sec": 8756.237,
    "end_sec": 8758.277,
    "zh": "这玩意有能遏制个鬼迷吗",
    "vi": "Thứ này có thể khống chế được quỷ không."
  },
  {
    "idx": 5367,
    "start": "02:25:58,277",
    "end": "02:26:00,137",
    "start_sec": 8758.277,
    "end_sec": 8760.137,
    "zh": "有奉献一遁鬼迷",
    "vi": "Có, hãy hiến tế một con quỷ."
  },
  {
    "idx": 5368,
    "start": "02:26:00,137",
    "end": "02:26:02,177",
    "start_sec": 8760.137,
    "end_sec": 8762.177,
    "zh": "我可以为你提供对应鬼迷的线索",
    "vi": "Ta có thể cung cấp cho ngươi manh mối về con quỷ tương ứng."
  },
  {
    "idx": 5369,
    "start": "02:26:02,177",
    "end": "02:26:03,677",
    "start_sec": 8762.177,
    "end_sec": 8763.677,
    "zh": "这是没了",
    "vi": "Thế là hết rồi sao."
  },
  {
    "idx": 5370,
    "start": "02:26:03,677",
    "end": "02:26:05,117",
    "start_sec": 8763.677,
    "end_sec": 8765.117,
    "zh": "你还有最后一个问题",
    "vi": "Ngươi vẫn còn một câu hỏi cuối cùng."
  },
  {
    "idx": 5371,
    "start": "02:26:05,117",
    "end": "02:26:08,097",
    "start_sec": 8765.117,
    "end_sec": 8768.097,
    "zh": "那么请给我一条目前最优秀的逃离路线",
    "vi": "Vậy hãy cho tôi một tuyến đường trốn thoát tốt nhất hiện tại."
  },
  {
    "idx": 5372,
    "start": "02:26:08,097",
    "end": "02:26:10,617",
    "start_sec": 8768.097,
    "end_sec": 8770.617,
    "zh": "根据区域内的鬼迷能够分析",
    "vi": "Dựa trên phân tích về sương mù quỷ trong khu vực"
  },
  {
    "idx": 5373,
    "start": "02:26:10,617",
    "end": "02:26:12,117",
    "start_sec": 8770.617,
    "end_sec": 8772.117,
    "zh": "百里之外的河面上",
    "vi": "Trên mặt sông cách đây trăm dặm"
  },
  {
    "idx": 5374,
    "start": "02:26:12,117",
    "end": "02:26:13,577",
    "start_sec": 8772.117,
    "end_sec": 8773.577,
    "zh": "有一艘游轮最安全",
    "vi": "Có một chiếc du thuyền là an toàn nhất."
  },
  {
    "idx": 5375,
    "start": "02:26:13,577",
    "end": "02:26:15,717",
    "start_sec": 8773.577,
    "end_sec": 8775.717,
    "zh": "根据它的行驶速度判断",
    "vi": "Dựa vào tốc độ di chuyển của nó"
  },
  {
    "idx": 5376,
    "start": "02:26:15,717",
    "end": "02:26:17,877",
    "start_sec": 8775.717,
    "end_sec": 8777.877,
    "zh": "三天后它将经过南城河大小",
    "vi": "Ba ngày sau nó sẽ đi qua sông Nam Thành."
  },
  {
    "idx": 5377,
    "start": "02:26:17,877",
    "end": "02:26:20,537",
    "start_sec": 8777.877,
    "end_sec": 8780.537,
    "zh": "你可以从永国寺后方经过深山行航",
    "vi": "Bạn có thể đi từ phía sau chùa Vĩnh Quốc băng qua núi sâu"
  },
  {
    "idx": 5378,
    "start": "02:26:20,537",
    "end": "02:26:23,637",
    "start_sec": 8780.537,
    "end_sec": 8783.637,
    "zh": "乘坐恶鬼巴士到达南城河另外一端",
    "vi": "Đi xe buýt ác quỷ để đến đầu bên kia của sông Nam Thành."
  },
  {
    "idx": 5379,
    "start": "02:26:23,637",
    "end": "02:26:24,977",
    "start_sec": 8783.637,
    "end_sec": 8784.977,
    "zh": "罪鬼八世",
    "vi": "Xe buýt ác quỷ sao."
  },
  {
    "idx": 5380,
    "start": "02:26:24,977",
    "end": "02:26:26,017",
    "start_sec": 8784.977,
    "end_sec": 8786.017,
    "zh": "那是什么玩意儿",
    "vi": "Đó là cái quái gì thế."
  },
  {
    "idx": 5381,
    "start": "02:26:26,017",
    "end": "02:26:28,217",
    "start_sec": 8786.017,
    "end_sec": 8788.217,
    "zh": "你的问题已经提问结束",
    "vi": "Câu hỏi của bạn đã kết thúc."
  },
  {
    "idx": 5382,
    "start": "02:26:28,217",
    "end": "02:26:29,397",
    "start_sec": 8788.217,
    "end_sec": 8789.397,
    "zh": "想要新的信息",
    "vi": "Muốn có thông tin mới"
  },
  {
    "idx": 5383,
    "start": "02:26:29,397",
    "end": "02:26:30,877",
    "start_sec": 8789.397,
    "end_sec": 8790.877,
    "zh": "请提供新的贡品",
    "vi": "Hãy cung cấp vật tế mới."
  },
  {
    "idx": 5384,
    "start": "02:26:30,877",
    "end": "02:26:31,897",
    "start_sec": 8790.877,
    "end_sec": 8791.897,
    "zh": "我操",
    "vi": "Mẹ kiếp."
  },
  {
    "idx": 5385,
    "start": "02:26:31,897",
    "end": "02:26:32,957",
    "start_sec": 8791.897,
    "end_sec": 8792.957,
    "zh": "这就没了",
    "vi": "Thế là hết rồi sao."
  },
  {
    "idx": 5386,
    "start": "02:26:32,957",
    "end": "02:26:35,337",
    "start_sec": 8792.957,
    "end_sec": 8795.337,
    "zh": "炉子表面的色泽渐渐变回清洁",
    "vi": "Màu sắc trên bề mặt lư hương dần trở lại bình thường."
  },
  {
    "idx": 5387,
    "start": "02:26:35,337",
    "end": "02:26:36,777",
    "start_sec": 8795.337,
    "end_sec": 8796.777,
    "zh": "橙子皮再怎么询问",
    "vi": "Dù Trần Tử Bì có hỏi thế nào"
  },
  {
    "idx": 5388,
    "start": "02:26:36,777",
    "end": "02:26:38,057",
    "start_sec": 8796.777,
    "end_sec": 8798.057,
    "zh": "香炉都没有了回应",
    "vi": "Lư hương cũng không còn phản hồi."
  },
  {
    "idx": 5389,
    "start": "02:26:38,057",
    "end": "02:26:38,717",
    "start_sec": 8798.057,
    "end_sec": 8798.717,
    "zh": "这炉子",
    "vi": "Cái lư hương này"
  },
  {
    "idx": 5390,
    "start": "02:26:38,717",
    "end": "02:26:40,317",
    "start_sec": 8798.717,
    "end_sec": 8800.317,
    "zh": "其实是一个单独的寄宝台",
    "vi": "Thực chất là một đài gửi bảo vật độc lập."
  },
  {
    "idx": 5391,
    "start": "02:26:40,317",
    "end": "02:26:41,557",
    "start_sec": 8800.317,
    "end_sec": 8801.557,
    "zh": "它是没进来的",
    "vi": "Nó không thuộc về nơi này."
  },
  {
    "idx": 5392,
    "start": "02:26:41,557",
    "end": "02:26:42,017",
    "start_sec": 8801.557,
    "end_sec": 8802.017,
    "zh": "献祭什么",
    "vi": "Tế nạp cái gì"
  },
  {
    "idx": 5393,
    "start": "02:26:42,017",
    "end": "02:26:43,697",
    "start_sec": 8802.017,
    "end_sec": 8803.697,
    "zh": "我就能得到香衣的好处",
    "vi": "Thì tôi sẽ nhận được lợi ích tương ứng."
  },
  {
    "idx": 5394,
    "start": "02:26:43,697",
    "end": "02:26:45,817",
    "start_sec": 8803.697,
    "end_sec": 8805.817,
    "zh": "献祭给谁呢",
    "vi": "Nhưng tế nạp cho ai chứ."
  },
  {
    "idx": 5395,
    "start": "02:26:45,817",
    "end": "02:26:46,797",
    "start_sec": 8805.817,
    "end_sec": 8806.797,
    "zh": "又送去了哪里",
    "vi": "Và nó được gửi đi đâu."
  },
  {
    "idx": 5396,
    "start": "02:26:46,797",
    "end": "02:26:47,957",
    "start_sec": 8806.797,
    "end_sec": 8807.957,
    "zh": "算了",
    "vi": "Bỏ đi."
  },
  {
    "idx": 5397,
    "start": "02:26:47,957",
    "end": "02:26:49,157",
    "start_sec": 8807.957,
    "end_sec": 8809.157,
    "zh": "暂时有这么个东西",
    "vi": "Tạm thời có một thứ như thế này"
  },
  {
    "idx": 5398,
    "start": "02:26:49,157",
    "end": "02:26:49,757",
    "start_sec": 8809.157,
    "end_sec": 8809.757,
    "zh": "倒也不错",
    "vi": "Cũng không tệ."
  },
  {
    "idx": 5399,
    "start": "02:26:49,757",
    "end": "02:26:51,017",
    "start_sec": 8809.757,
    "end_sec": 8811.017,
    "zh": "收起香炉",
    "vi": "Cất lư hương đi"
  },
  {
    "idx": 5400,
    "start": "02:26:51,017",
    "end": "02:26:52,557",
    "start_sec": 8811.017,
    "end_sec": 8812.557,
    "zh": "橙子皮走出殿堂",
    "vi": "Trần Tử Bì bước ra khỏi điện thờ."
  },
  {
    "idx": 5401,
    "start": "02:26:52,557",
    "end": "02:26:53,517",
    "start_sec": 8812.557,
    "end_sec": 8813.517,
    "zh": "依然看了它",
    "vi": "Vẫn nhìn nó."
  },
  {
    "idx": 5402,
    "start": "02:26:53,517",
    "end": "02:26:54,817",
    "start_sec": 8813.517,
    "end_sec": 8814.817,
    "zh": "永德寺那个残座",
    "vi": "Chỗ ngồi đổ nát ở Vĩnh Đức Tự."
  },
  {
    "idx": 5403,
    "start": "02:26:54,817",
    "end": "02:26:55,817",
    "start_sec": 8814.817,
    "end_sec": 8815.817,
    "zh": "有些时辰",
    "vi": "Đã bao lâu rồi."
  },
  {
    "idx": 5404,
    "start": "02:26:55,817",
    "end": "02:26:56,737",
    "start_sec": 8815.817,
    "end_sec": 8816.737,
    "zh": "来之前",
    "vi": "Trước khi đến đây."
  },
  {
    "idx": 5405,
    "start": "02:26:56,737",
    "end": "02:26:58,117",
    "start_sec": 8816.737,
    "end_sec": 8818.117,
    "zh": "这里是多么生气勃勃",
    "vi": "Nơi này từng tràn đầy sức sống."
  },
  {
    "idx": 5406,
    "start": "02:26:58,117",
    "end": "02:26:59,157",
    "start_sec": 8818.117,
    "end_sec": 8819.157,
    "zh": "一个充满希望的地方",
    "vi": "Một nơi đầy hy vọng."
  },
  {
    "idx": 5407,
    "start": "02:26:59,157",
    "end": "02:27:00,077",
    "start_sec": 8819.157,
    "end_sec": 8820.077,
    "zh": "仅仅一晚",
    "vi": "Chỉ một đêm."
  },
  {
    "idx": 5408,
    "start": "02:27:00,077",
    "end": "02:27:01,337",
    "start_sec": 8820.077,
    "end_sec": 8821.337,
    "zh": "就成了无间地狱",
    "vi": "Đã biến thành địa ngục."
  },
  {
    "idx": 5409,
    "start": "02:27:01,337",
    "end": "02:27:02,957",
    "start_sec": 8821.337,
    "end_sec": 8822.957,
    "zh": "该死的末日",
    "vi": "Ngày tận thế chết tiệt."
  },
  {
    "idx": 5410,
    "start": "02:27:02,957",
    "end": "02:27:03,917",
    "start_sec": 8822.957,
    "end_sec": 8823.917,
    "zh": "不止有鬼吃人",
    "vi": "Không chỉ có quỷ ăn người."
  },
  {
    "idx": 5411,
    "start": "02:27:03,917",
    "end": "02:27:05,237",
    "start_sec": 8823.917,
    "end_sec": 8825.237,
    "zh": "人他妈也吃人",
    "vi": "Mà người cũng ăn thịt người."
  },
  {
    "idx": 5412,
    "start": "02:27:05,237",
    "end": "02:27:06,457",
    "start_sec": 8825.237,
    "end_sec": 8826.457,
    "zh": "寒风吹荡在庙内",
    "vi": "Gió lạnh thổi trong chùa."
  },
  {
    "idx": 5413,
    "start": "02:27:06,457",
    "end": "02:27:08,437",
    "start_sec": 8826.457,
    "end_sec": 8828.437,
    "zh": "长发女鬼和胡说的直鬼",
    "vi": "Ma nữ tóc dài và ma quỷ nói nhảm."
  },
  {
    "idx": 5414,
    "start": "02:27:08,437",
    "end": "02:27:10,577",
    "start_sec": 8828.437,
    "end_sec": 8830.577,
    "zh": "或许是异当苦笑人脸的奇迹",
    "vi": "Có lẽ là một phép màu kỳ lạ khi nhìn thấy khuôn mặt người."
  },
  {
    "idx": 5415,
    "start": "02:27:10,577",
    "end": "02:27:11,277",
    "start_sec": 8830.577,
    "end_sec": 8831.277,
    "zh": "没得总",
    "vi": "Không còn gì nữa."
  },
  {
    "idx": 5416,
    "start": "02:27:11,277",
    "end": "02:27:13,477",
    "start_sec": 8831.277,
    "end_sec": 8833.477,
    "zh": "相互说",
    "vi": "Nói với nhau."
  },
  {
    "idx": 5417,
    "start": "02:27:13,477",
    "end": "02:27:14,237",
    "start_sec": 8833.477,
    "end_sec": 8834.237,
    "zh": "三天后",
    "vi": "Ba ngày sau."
  },
  {
    "idx": 5418,
    "start": "02:27:14,237",
    "end": "02:27:15,717",
    "start_sec": 8834.237,
    "end_sec": 8835.717,
    "zh": "游轮会经过来程和大事",
    "vi": "Du thuyền sẽ đi qua."
  },
  {
    "idx": 5419,
    "start": "02:27:15,717",
    "end": "02:27:16,777",
    "start_sec": 8835.717,
    "end_sec": 8836.777,
    "zh": "也就是说",
    "vi": "Nói cách khác."
  },
  {
    "idx": 5420,
    "start": "02:27:16,777",
    "end": "02:27:17,897",
    "start_sec": 8836.777,
    "end_sec": 8837.897,
    "zh": "他已经帮我算好了",
    "vi": "Anh ta đã tính toán cho tôi rồi."
  },
  {
    "idx": 5421,
    "start": "02:27:17,897",
    "end": "02:27:19,317",
    "start_sec": 8837.897,
    "end_sec": 8839.317,
    "zh": "最好的与游轮接触时机",
    "vi": "Thời điểm tốt nhất để tiếp xúc với du thuyền."
  },
  {
    "idx": 5422,
    "start": "02:27:19,317",
    "end": "02:27:20,877",
    "start_sec": 8839.317,
    "end_sec": 8840.877,
    "zh": "他居然能算到三天后",
    "vi": "Anh ta có thể tính toán được ba ngày sau."
  },
  {
    "idx": 5423,
    "start": "02:27:20,877",
    "end": "02:27:21,857",
    "start_sec": 8840.877,
    "end_sec": 8841.857,
    "zh": "确实厉害",
    "vi": "Thật sự lợi hại."
  },
  {
    "idx": 5424,
    "start": "02:27:21,857",
    "end": "02:27:22,337",
    "start_sec": 8841.857,
    "end_sec": 8842.337,
    "zh": "那游轮",
    "vi": "Vậy thì du thuyền."
  },
  {
    "idx": 5425,
    "start": "02:27:22,337",
    "end": "02:27:23,617",
    "start_sec": 8842.337,
    "end_sec": 8843.617,
    "zh": "应该就是周扬说的",
    "vi": "Chắc là điểm an toàn đến Kinh thị mà Chu Dương nói."
  },
  {
    "idx": 5426,
    "start": "02:27:23,617",
    "end": "02:27:25,117",
    "start_sec": 8843.617,
    "end_sec": 8845.117,
    "zh": "撤离到京市的安全点吧",
    "vi": "Để sơ tán đến đó."
  },
  {
    "idx": 5427,
    "start": "02:27:25,117",
    "end": "02:27:32,557",
    "start_sec": 8845.117,
    "end_sec": 8852.557,
    "zh": "夜间遇到鬼迷的几率更大",
    "vi": "Khả năng gặp ma vào ban đêm càng lớn."
  },
  {
    "idx": 5428,
    "start": "02:27:32,557",
    "end": "02:27:34,577",
    "start_sec": 8852.557,
    "end_sec": 8854.577,
    "zh": "虽说我现在具有对抗鬼迷的能力",
    "vi": "Mặc dù bây giờ tôi có khả năng chống lại ma."
  },
  {
    "idx": 5429,
    "start": "02:27:34,577",
    "end": "02:27:36,177",
    "start_sec": 8854.577,
    "end_sec": 8856.177,
    "zh": "但过多使用人面窗的力量",
    "vi": "Nhưng việc sử dụng quá nhiều sức mạnh của khuôn mặt người."
  },
  {
    "idx": 5430,
    "start": "02:27:36,177",
    "end": "02:27:36,937",
    "start_sec": 8856.177,
    "end_sec": 8856.937,
    "zh": "对我也不利",
    "vi": "Cũng không có lợi cho tôi."
  },
  {
    "idx": 5431,
    "start": "02:27:36,937",
    "end": "02:27:37,657",
    "start_sec": 8856.937,
    "end_sec": 8857.657,
    "zh": "想着",
    "vi": "Nghĩ vậy"
  },
  {
    "idx": 5432,
    "start": "02:27:37,657",
    "end": "02:27:39,137",
    "start_sec": 8857.657,
    "end_sec": 8859.137,
    "zh": "橙子皮操作手机",
    "vi": "Trần Tử bấm điện thoại"
  },
  {
    "idx": 5433,
    "start": "02:27:39,137",
    "end": "02:27:40,397",
    "start_sec": 8859.137,
    "end_sec": 8860.397,
    "zh": "打算从周扬那里",
    "vi": "định là từ chỗ Chu Dương"
  },
  {
    "idx": 5434,
    "start": "02:27:40,397",
    "end": "02:27:41,997",
    "start_sec": 8860.397,
    "end_sec": 8861.997,
    "zh": "套取一些邮轮的线索",
    "vi": "dò hỏi một số manh mối về chiếc du thuyền."
  },
  {
    "idx": 5435,
    "start": "02:27:41,997",
    "end": "02:27:42,297",
    "start_sec": 8861.997,
    "end_sec": 8862.297,
    "zh": "于此",
    "vi": "Đúng lúc này"
  },
  {
    "idx": 5436,
    "start": "02:27:42,297",
    "end": "02:27:44,357",
    "start_sec": 8862.297,
    "end_sec": 8864.357,
    "zh": "过去的自己却发了消息",
    "vi": "bản thân trong quá khứ lại gửi tin nhắn đến."
  },
  {
    "idx": 5437,
    "start": "02:27:44,357",
    "end": "02:27:44,977",
    "start_sec": 8864.357,
    "end_sec": 8864.977,
    "zh": "喂",
    "vi": "Này"
  },
  {
    "idx": 5438,
    "start": "02:27:44,977",
    "end": "02:27:46,597",
    "start_sec": 8864.977,
    "end_sec": 8866.597,
    "zh": "半个小时早都过了",
    "vi": "đã qua nửa tiếng từ lâu rồi"
  },
  {
    "idx": 5439,
    "start": "02:27:46,597",
    "end": "02:27:47,397",
    "start_sec": 8866.597,
    "end_sec": 8867.397,
    "zh": "你没事吧",
    "vi": "bạn không sao chứ."
  },
  {
    "idx": 5440,
    "start": "02:27:47,397",
    "end": "02:27:48,277",
    "start_sec": 8867.397,
    "end_sec": 8868.277,
    "zh": "没事了",
    "vi": "Không sao rồi"
  },
  {
    "idx": 5441,
    "start": "02:27:48,277",
    "end": "02:27:48,917",
    "start_sec": 8868.277,
    "end_sec": 8868.917,
    "zh": "赌过了",
    "vi": "đã vượt qua rồi."
  },
  {
    "idx": 5442,
    "start": "02:27:48,917",
    "end": "02:27:49,417",
    "start_sec": 8868.917,
    "end_sec": 8869.417,
    "zh": "对了",
    "vi": "Đúng rồi"
  },
  {
    "idx": 5443,
    "start": "02:27:49,417",
    "end": "02:27:50,297",
    "start_sec": 8869.417,
    "end_sec": 8870.297,
    "zh": "你帮我查一下",
    "vi": "bạn giúp tôi tra cứu một chút"
  },
  {
    "idx": 5444,
    "start": "02:27:50,297",
    "end": "02:27:52,497",
    "start_sec": 8870.297,
    "end_sec": 8872.497,
    "zh": "鬼将之前有没有死亡巴士这东西",
    "vi": "trước đây Quỷ Tướng có thứ gọi là xe buýt tử thần không."
  },
  {
    "idx": 5445,
    "start": "02:27:52,497",
    "end": "02:27:53,977",
    "start_sec": 8872.497,
    "end_sec": 8873.977,
    "zh": "那是什么",
    "vi": "Đó là cái gì."
  },
  {
    "idx": 5446,
    "start": "02:27:53,977",
    "end": "02:27:55,097",
    "start_sec": 8873.977,
    "end_sec": 8875.097,
    "zh": "我也不知道",
    "vi": "Tôi cũng không biết"
  },
  {
    "idx": 5447,
    "start": "02:27:55,097",
    "end": "02:27:56,377",
    "start_sec": 8875.097,
    "end_sec": 8876.377,
    "zh": "相互提供的消息",
    "vi": "tin tức do bên kia cung cấp"
  },
  {
    "idx": 5448,
    "start": "02:27:56,377",
    "end": "02:27:57,437",
    "start_sec": 8876.377,
    "end_sec": 8877.437,
    "zh": "要麻烦你查一下",
    "vi": "phải làm phiền bạn tra cứu giúp rồi."
  },
  {
    "idx": 5449,
    "start": "02:27:57,437",
    "end": "02:27:58,617",
    "start_sec": 8877.437,
    "end_sec": 8878.617,
    "zh": "OKOK",
    "vi": "Được rồi được rồi"
  },
  {
    "idx": 5450,
    "start": "02:27:58,617",
    "end": "02:27:59,417",
    "start_sec": 8878.617,
    "end_sec": 8879.417,
    "zh": "我这就去",
    "vi": "tôi đi làm ngay đây."
  },
  {
    "idx": 5451,
    "start": "02:27:59,417",
    "end": "02:28:02,417",
    "start_sec": 8879.417,
    "end_sec": 8882.417,
    "zh": "就是寺庙外渐渐变化的天色",
    "vi": "Chính là bầu trời ngoài chùa đang dần thay đổi"
  },
  {
    "idx": 5452,
    "start": "02:28:02,417",
    "end": "02:28:03,437",
    "start_sec": 8882.417,
    "end_sec": 8883.437,
    "zh": "红日出现",
    "vi": "mặt trời đỏ xuất hiện"
  },
  {
    "idx": 5453,
    "start": "02:28:03,437",
    "end": "02:28:05,277",
    "start_sec": 8883.437,
    "end_sec": 8885.277,
    "zh": "橙子提报的小墨镜",
    "vi": "Trần Tử đeo chiếc kính râm nhỏ"
  },
  {
    "idx": 5454,
    "start": "02:28:05,277",
    "end": "02:28:06,817",
    "start_sec": 8885.277,
    "end_sec": 8886.817,
    "zh": "爬上永德寺的后墙",
    "vi": "trèo lên bức tường phía sau của chùa Vĩnh Đức"
  },
  {
    "idx": 5455,
    "start": "02:28:06,817",
    "end": "02:28:09,257",
    "start_sec": 8886.817,
    "end_sec": 8889.257,
    "zh": "总是在你跳的出去",
    "vi": "cuối cùng cũng nhảy ra ngoài được."
  },
  {
    "idx": 5456,
    "start": "02:28:09,257",
    "end": "02:28:15,397",
    "start_sec": 8889.257,
    "end_sec": 8895.397,
    "zh": "永德寺终于出来了",
    "vi": "Cuối cùng cũng ra khỏi chùa Vĩnh Đức rồi"
  },
  {
    "idx": 5457,
    "start": "02:28:15,397",
    "end": "02:28:18,057",
    "start_sec": 8895.397,
    "end_sec": 8898.057,
    "zh": "前山路",
    "vi": "Đường Tiền Sơn"
  },
  {
    "idx": 5458,
    "start": "02:28:18,057",
    "end": "02:28:20,237",
    "start_sec": 8898.057,
    "end_sec": 8900.237,
    "zh": "这就是通往深山隧道的必经之路",
    "vi": "đây chính là con đường bắt buộc phải đi để đến đường hầm trong núi sâu."
  },
  {
    "idx": 5459,
    "start": "02:28:20,237",
    "end": "02:28:22,997",
    "start_sec": 8900.237,
    "end_sec": 8902.997,
    "zh": "路到两旁还有无数助力的单元楼",
    "vi": "Hai bên đường còn có vô số tòa nhà chung cư"
  },
  {
    "idx": 5460,
    "start": "02:28:22,997",
    "end": "02:28:26,397",
    "start_sec": 8902.997,
    "end_sec": 8906.397,
    "zh": "只可惜单元楼里再也看不到任何人活动的踪迹",
    "vi": "chỉ tiếc là trong các tòa nhà không còn thấy bất kỳ dấu vết hoạt động nào của con người nữa."
  },
  {
    "idx": 5461,
    "start": "02:28:26,397",
    "end": "02:28:28,237",
    "start_sec": 8906.397,
    "end_sec": 8908.237,
    "zh": "开始的末日鬼才降临",
    "vi": "Ngày tận thế bắt đầu ập đến."
  },
  {
    "idx": 5462,
    "start": "02:28:28,237",
    "end": "02:28:31,037",
    "start_sec": 8908.237,
    "end_sec": 8911.037,
    "zh": "不到一周世界已经死寂的像废土一样",
    "vi": "Chưa đầy một tuần thế giới đã tĩnh lặng như vùng đất chết."
  },
  {
    "idx": 5463,
    "start": "02:28:31,037",
    "end": "02:28:33,937",
    "start_sec": 8911.037,
    "end_sec": 8913.937,
    "zh": "一人一狗默默走在前山路上",
    "vi": "Một người và một con chó lặng lẽ bước đi trên con đường núi phía trước."
  },
  {
    "idx": 5464,
    "start": "02:28:33,937",
    "end": "02:28:36,517",
    "start_sec": 8913.937,
    "end_sec": 8916.517,
    "zh": "橙子皮莫名有种被世界孤立的错觉",
    "vi": "Trần Tử Bì bỗng nhiên có cảm giác như bị cả thế giới cô lập."
  },
  {
    "idx": 5465,
    "start": "02:28:36,517",
    "end": "02:28:38,297",
    "start_sec": 8916.517,
    "end_sec": 8918.297,
    "zh": "从早上一直走到现在",
    "vi": "Từ sáng đến giờ vẫn cứ đi mãi."
  },
  {
    "idx": 5466,
    "start": "02:28:38,297",
    "end": "02:28:39,497",
    "start_sec": 8918.297,
    "end_sec": 8919.497,
    "zh": "一路都异常的平静",
    "vi": "Dọc đường đi vô cùng yên tĩnh."
  },
  {
    "idx": 5467,
    "start": "02:28:39,497",
    "end": "02:28:40,597",
    "start_sec": 8919.497,
    "end_sec": 8920.597,
    "zh": "是鬼灭窗的原因",
    "vi": "Là do cửa sổ Quỷ Diệt."
  },
  {
    "idx": 5468,
    "start": "02:28:40,597",
    "end": "02:28:42,677",
    "start_sec": 8920.597,
    "end_sec": 8922.677,
    "zh": "还是说归功于香炉推荐的路线",
    "vi": "Hay là nhờ vào lộ trình mà lư hương gợi ý."
  },
  {
    "idx": 5469,
    "start": "02:28:42,677",
    "end": "02:28:44,857",
    "start_sec": 8922.677,
    "end_sec": 8924.857,
    "zh": "如果香炉真的能一直给出最优选择",
    "vi": "Nếu lư hương thực sự luôn đưa ra lựa chọn tối ưu."
  },
  {
    "idx": 5470,
    "start": "02:28:44,857",
    "end": "02:28:47,277",
    "start_sec": 8924.857,
    "end_sec": 8927.277,
    "zh": "那我是不是可以依靠自身回省重生的优势",
    "vi": "Vậy tôi có thể dựa vào lợi thế hồi sinh sau khi chết."
  },
  {
    "idx": 5471,
    "start": "02:28:47,277",
    "end": "02:28:49,937",
    "start_sec": 8927.277,
    "end_sec": 8929.937,
    "zh": "用自杀的方法来多次套取些香炉的情报",
    "vi": "Dùng cách tự sát để khai thác thêm thông tin từ lư hương."
  },
  {
    "idx": 5472,
    "start": "02:28:49,937",
    "end": "02:28:53,317",
    "start_sec": 8929.937,
    "end_sec": 8933.317,
    "zh": "当然这也只是橙子皮心里一个疯狂的想法",
    "vi": "Tất nhiên đây chỉ là một ý nghĩ điên rồ trong đầu Trần Tử Bì."
  },
  {
    "idx": 5473,
    "start": "02:28:53,317",
    "end": "02:28:54,317",
    "start_sec": 8933.317,
    "end_sec": 8934.317,
    "zh": "但是还是算了吧",
    "vi": "Nhưng thôi bỏ đi."
  },
  {
    "idx": 5474,
    "start": "02:28:54,317",
    "end": "02:28:56,217",
    "start_sec": 8934.317,
    "end_sec": 8936.217,
    "zh": "毕竟现在还没遇到无法解脱的困难",
    "vi": "Dù sao hiện tại vẫn chưa gặp khó khăn nào không thể giải quyết."
  },
  {
    "idx": 5475,
    "start": "02:28:56,217",
    "end": "02:28:57,657",
    "start_sec": 8936.217,
    "end_sec": 8937.657,
    "zh": "就算有我也不能随便死",
    "vi": "Ngay cả khi có thì tôi cũng không thể chết tùy tiện."
  },
  {
    "idx": 5476,
    "start": "02:28:57,657",
    "end": "02:28:59,817",
    "start_sec": 8937.657,
    "end_sec": 8939.817,
    "zh": "一方面死亡的体验是完全真实的",
    "vi": "Một mặt là trải nghiệm cái chết hoàn toàn chân thực."
  },
  {
    "idx": 5477,
    "start": "02:28:59,817",
    "end": "02:29:00,797",
    "start_sec": 8939.817,
    "end_sec": 8940.797,
    "zh": "每死一次都是折磨",
    "vi": "Mỗi lần chết đều là một sự tra tấn."
  },
  {
    "idx": 5478,
    "start": "02:29:00,797",
    "end": "02:29:03,777",
    "start_sec": 8940.797,
    "end_sec": 8943.777,
    "zh": "另一方面死亡回溯的地点就不确定性",
    "vi": "Mặt khác là sự không chắc chắn của địa điểm hồi sinh sau khi chết."
  },
  {
    "idx": 5479,
    "start": "02:29:03,777",
    "end": "02:29:05,077",
    "start_sec": 8943.777,
    "end_sec": 8945.077,
    "zh": "可能这几次是运气好",
    "vi": "Có lẽ vài lần này là do may mắn."
  },
  {
    "idx": 5480,
    "start": "02:29:05,077",
    "end": "02:29:06,937",
    "start_sec": 8945.077,
    "end_sec": 8946.937,
    "zh": "万一下子死亡回溯在诡异点上",
    "vi": "Lỡ như lần tới hồi sinh ngay tại điểm quỷ dị."
  },
  {
    "idx": 5481,
    "start": "02:29:06,937",
    "end": "02:29:08,457",
    "start_sec": 8946.937,
    "end_sec": 8948.457,
    "zh": "来不及给过去的自己发消息",
    "vi": "Chưa kịp gửi tin nhắn cho bản thân trong quá khứ."
  },
  {
    "idx": 5482,
    "start": "02:29:08,457",
    "end": "02:29:09,157",
    "start_sec": 8948.457,
    "end_sec": 8949.157,
    "zh": "就被秒杀",
    "vi": "Đã bị giết ngay lập tức."
  },
  {
    "idx": 5483,
    "start": "02:29:09,157",
    "end": "02:29:10,177",
    "start_sec": 8949.157,
    "end_sec": 8950.177,
    "zh": "那不就完错了",
    "vi": "Thế thì tiêu đời rồi."
  },
  {
    "idx": 5484,
    "start": "02:29:10,177",
    "end": "02:29:11,537",
    "start_sec": 8950.177,
    "end_sec": 8951.537,
    "zh": "随意吃了点东西",
    "vi": "Ăn tạm chút đồ ăn."
  },
  {
    "idx": 5485,
    "start": "02:29:11,537",
    "end": "02:29:13,137",
    "start_sec": 8951.537,
    "end_sec": 8953.137,
    "zh": "橙子皮领着小墨镜",
    "vi": "Trần Tử Bì dẫn theo Tiểu Mặc Kính."
  },
  {
    "idx": 5486,
    "start": "02:29:13,137",
    "end": "02:29:15,457",
    "start_sec": 8953.137,
    "end_sec": 8955.457,
    "zh": "终于是看到了前山路的尽头",
    "vi": "Cuối cùng cũng nhìn thấy điểm cuối của con đường núi."
  },
  {
    "idx": 5487,
    "start": "02:29:15,457",
    "end": "02:29:18,197",
    "start_sec": 8955.457,
    "end_sec": 8958.197,
    "zh": "前山路的尽头处是一间加油站",
    "vi": "Cuối con đường núi là một trạm xăng."
  },
  {
    "idx": 5488,
    "start": "02:29:18,197",
    "end": "02:29:19,957",
    "start_sec": 8958.197,
    "end_sec": 8959.957,
    "zh": "加油站在往前十几米",
    "vi": "Cách trạm xăng hơn mười mét về phía trước."
  },
  {
    "idx": 5489,
    "start": "02:29:19,957",
    "end": "02:29:22,157",
    "start_sec": 8959.957,
    "end_sec": 8962.157,
    "zh": "就是幽暗的深山隧道",
    "vi": "Chính là đường hầm núi sâu u ám."
  },
  {
    "idx": 5490,
    "start": "02:29:22,157",
    "end": "02:29:22,997",
    "start_sec": 8962.157,
    "end_sec": 8962.997,
    "zh": "似乎这条隧道",
    "vi": "Dường như con đường hầm này."
  },
  {
    "idx": 5491,
    "start": "02:29:22,997",
    "end": "02:29:24,637",
    "start_sec": 8962.997,
    "end_sec": 8964.637,
    "zh": "是刨穿临江市的长眠山",
    "vi": "Nó xuyên qua núi Trường Miên ở thành phố Lâm Giang."
  },
  {
    "idx": 5492,
    "start": "02:29:24,637",
    "end": "02:29:25,657",
    "start_sec": 8964.637,
    "end_sec": 8965.657,
    "zh": "有三千米长",
    "vi": "Dài ba nghìn mét."
  },
  {
    "idx": 5493,
    "start": "02:29:25,657",
    "end": "02:29:26,877",
    "start_sec": 8965.657,
    "end_sec": 8966.877,
    "zh": "通过这条隧道后",
    "vi": "Sau khi đi qua đường hầm này."
  },
  {
    "idx": 5494,
    "start": "02:29:26,877",
    "end": "02:29:27,957",
    "start_sec": 8966.877,
    "end_sec": 8967.957,
    "zh": "再往前几千米",
    "vi": "Đi tiếp vài nghìn mét nữa."
  },
  {
    "idx": 5495,
    "start": "02:29:27,957",
    "end": "02:29:30,057",
    "start_sec": 8967.957,
    "end_sec": 8970.057,
    "zh": "就能看到离开临江市的南城河大桥",
    "vi": "Sẽ thấy cầu Nam Thành Hà để rời khỏi thành phố Lâm Giang."
  },
  {
    "idx": 5496,
    "start": "02:29:30,057",
    "end": "02:29:31,277",
    "start_sec": 8970.057,
    "end_sec": 8971.277,
    "zh": "按这速度",
    "vi": "Với tốc độ này."
  },
  {
    "idx": 5497,
    "start": "02:29:31,277",
    "end": "02:29:32,117",
    "start_sec": 8971.277,
    "end_sec": 8972.117,
    "zh": "感觉不用三天五",
    "vi": "Tôi nghĩ không cần đến ba năm ngày."
  },
  {
    "idx": 5498,
    "start": "02:29:32,117",
    "end": "02:29:33,157",
    "start_sec": 8972.117,
    "end_sec": 8973.157,
    "zh": "就能到南城河大桥",
    "vi": "Là có thể đến cầu Nam Thành Hà."
  },
  {
    "idx": 5499,
    "start": "02:29:33,157",
    "end": "02:29:37,757",
    "start_sec": 8973.157,
    "end_sec": 8977.757,
    "zh": "加油站里",
    "vi": "Trong trạm xăng."
  },
  {
    "idx": 5500,
    "start": "02:29:37,757",
    "end": "02:29:39,237",
    "start_sec": 8977.757,
    "end_sec": 8979.237,
    "zh": "五个大学生面面相见",
    "vi": "Năm sinh viên đại học nhìn nhau."
  },
  {
    "idx": 5501,
    "start": "02:29:39,237",
    "end": "02:29:42,337",
    "start_sec": 8979.237,
    "end_sec": 8982.337,
    "zh": "他 他是人吗",
    "vi": "Anh ta, anh ta có phải là người không."
  },
  {
    "idx": 5502,
    "start": "02:29:42,337",
    "end": "02:29:44,017",
    "start_sec": 8982.337,
    "end_sec": 8984.017,
    "zh": "是吧 应该是人吧",
    "vi": "Chắc là phải, chắc là người thôi."
  },
  {
    "idx": 5503,
    "start": "02:29:44,017",
    "end": "02:29:44,957",
    "start_sec": 8984.017,
    "end_sec": 8984.957,
    "zh": "他怎么敢的",
    "vi": "Sao anh ta dám làm vậy."
  },
  {
    "idx": 5504,
    "start": "02:29:44,957",
    "end": "02:29:46,297",
    "start_sec": 8984.957,
    "end_sec": 8986.297,
    "zh": "他怎么敢出去的",
    "vi": "Sao anh ta dám đi ra ngoài chứ."
  },
  {
    "idx": 5505,
    "start": "02:29:46,297",
    "end": "02:29:48,377",
    "start_sec": 8986.297,
    "end_sec": 8988.377,
    "zh": "帅哥帅哥",
    "vi": "Anh đẹp trai ơi."
  },
  {
    "idx": 5506,
    "start": "02:29:48,377",
    "end": "02:29:50,437",
    "start_sec": 8988.377,
    "end_sec": 8990.437,
    "zh": "你是要去深山隧道吗",
    "vi": "Anh định đi vào đường hầm núi sâu đó sao."
  },
  {
    "idx": 5507,
    "start": "02:29:50,437",
    "end": "02:29:51,597",
    "start_sec": 8990.437,
    "end_sec": 8991.597,
    "zh": "千万别去啊",
    "vi": "Đừng đi vào đó."
  },
  {
    "idx": 5508,
    "start": "02:29:51,597",
    "end": "02:29:52,457",
    "start_sec": 8991.597,
    "end_sec": 8992.457,
    "zh": "那里有问题",
    "vi": "Nơi đó có vấn đề."
  },
  {
    "idx": 5509,
    "start": "02:29:52,457",
    "end": "02:29:54,017",
    "start_sec": 8992.457,
    "end_sec": 8994.017,
    "zh": "不如和我们组队吧",
    "vi": "Chi bằng hãy lập nhóm với chúng tôi đi."
  },
  {
    "idx": 5510,
    "start": "02:29:54,017",
    "end": "02:29:57,610",
    "start_sec": 8994.017,
    "end_sec": 8997.61,
    "zh": "长者一抬头看了看他们没有理会物自走向深山隧道在这末世里别说是大学生就算是七十八岁的小孩,都不能清醒现在我能信的,只有过去的自己和小默契了",
    "vi": "Tôi ngẩng đầu nhìn họ rồi lờ đi, tự mình bước về phía đường hầm"
  },
  {
    "idx": 5510,
    "start": "02:29:57,610",
    "end": "02:30:02,880",
    "start_sec": 8997.61,
    "end_sec": 9002.88,
    "zh": "长者一抬头看了看他们没有理会物自走向深山隧道在这末世里别说是大学生就算是七十八岁的小孩,都不能清醒现在我能信的,只有过去的自己和小默契了",
    "vi": "Trong thời tận thế này, đừng nói là sinh viên, ngay cả đứa trẻ bảy tám tuổi cũng không thể tin được"
  },
  {
    "idx": 5510,
    "start": "02:30:02,880",
    "end": "02:30:05,994",
    "start_sec": 9002.88,
    "end_sec": 9005.994,
    "zh": "长者一抬头看了看他们没有理会物自走向深山隧道在这末世里别说是大学生就算是七十八岁的小孩,都不能清醒现在我能信的,只有过去的自己和小默契了",
    "vi": "Giờ tôi chỉ có thể tin vào bản thân mình và Tiểu Mặc"
  },
  {
    "idx": 5511,
    "start": "02:30:06,554",
    "end": "02:30:13,434",
    "start_sec": 9006.554,
    "end_sec": 9013.434,
    "zh": "这时的,如心不黑的,一眼都望不到头",
    "vi": "Lúc này, đường hầm tối đen như mực, nhìn mãi không thấy điểm cuối."
  },
  {
    "idx": 5512,
    "start": "02:30:13,434",
    "end": "02:30:16,214",
    "start_sec": 9013.434,
    "end_sec": 9016.214,
    "zh": "那群大学生受的危险,到底有什么危险呢",
    "vi": "Đám sinh viên đó nói có nguy hiểm, rốt cuộc là nguy hiểm gì."
  },
  {
    "idx": 5513,
    "start": "02:30:24,994",
    "end": "02:30:30,554",
    "start_sec": 9024.994,
    "end_sec": 9030.554,
    "zh": "最近三千米的隧道",
    "vi": "Đường hầm dài ba nghìn mét."
  },
  {
    "idx": 5514,
    "start": "02:30:30,554",
    "end": "02:30:31,414",
    "start_sec": 9030.554,
    "end_sec": 9031.414,
    "zh": "就算是爬",
    "vi": "Dù là bò đi chăng nữa."
  },
  {
    "idx": 5515,
    "start": "02:30:31,414",
    "end": "02:30:33,834",
    "start_sec": 9031.414,
    "end_sec": 9033.834,
    "zh": "这也该是看到尽头的光源了",
    "vi": "Thì cũng phải nhìn thấy ánh sáng ở cuối đường rồi."
  },
  {
    "idx": 5516,
    "start": "02:30:33,834",
    "end": "02:30:38,214",
    "start_sec": 9033.834,
    "end_sec": 9038.214,
    "zh": "走了早就超过三千米了",
    "vi": "Tôi đã đi quá ba nghìn mét từ lâu rồi."
  },
  {
    "idx": 5517,
    "start": "02:30:38,214",
    "end": "02:30:40,574",
    "start_sec": 9038.214,
    "end_sec": 9040.574,
    "zh": "这是鬼打墙吗",
    "vi": "Đây là quỷ đả tường sao."
  },
  {
    "idx": 5518,
    "start": "02:30:40,574",
    "end": "02:30:45,614",
    "start_sec": 9040.574,
    "end_sec": 9045.614,
    "zh": "深山隧道没想象中那么简单",
    "vi": "Đường hầm núi sâu này không đơn giản như mình nghĩ."
  },
  {
    "idx": 5519,
    "start": "02:30:45,614",
    "end": "02:30:46,634",
    "start_sec": 9045.614,
    "end_sec": 9046.634,
    "zh": "要破局的话",
    "vi": "Nếu muốn phá giải."
  },
  {
    "idx": 5520,
    "start": "02:30:46,634",
    "end": "02:30:48,234",
    "start_sec": 9046.634,
    "end_sec": 9048.234,
    "zh": "估计得用鬼面窗的能力",
    "vi": "Chắc phải dùng đến năng lực của Quỷ Diện Song."
  },
  {
    "idx": 5521,
    "start": "02:30:48,234",
    "end": "02:30:50,094",
    "start_sec": 9048.234,
    "end_sec": 9050.094,
    "zh": "万一使用鬼面窗时间太久",
    "vi": "Nếu đeo mặt nạ quỷ quá lâu"
  },
  {
    "idx": 5522,
    "start": "02:30:50,094",
    "end": "02:30:51,474",
    "start_sec": 9050.094,
    "end_sec": 9051.474,
    "zh": "还没能走出深山隧道",
    "vi": "mà vẫn chưa ra khỏi đường hầm sâu"
  },
  {
    "idx": 5523,
    "start": "02:30:51,474",
    "end": "02:30:53,034",
    "start_sec": 9051.474,
    "end_sec": 9053.034,
    "zh": "导致它复苏就不好了",
    "vi": "thì nó sẽ hồi sinh mất"
  },
  {
    "idx": 5524,
    "start": "02:30:53,034",
    "end": "02:30:53,994",
    "start_sec": 9053.034,
    "end_sec": 9053.994,
    "zh": "保险起点",
    "vi": "Bảo hiểm ban đầu"
  },
  {
    "idx": 5525,
    "start": "02:30:53,994",
    "end": "02:30:56,734",
    "start_sec": 9053.994,
    "end_sec": 9056.734,
    "zh": "橙子皮还是给过期的自己发的条消息",
    "vi": "Trần Tử Bì đã gửi tin nhắn cho chính mình lúc hết hạn"
  },
  {
    "idx": 5526,
    "start": "02:30:56,734",
    "end": "02:30:57,754",
    "start_sec": 9056.734,
    "end_sec": 9057.754,
    "zh": "好",
    "vi": "Được"
  },
  {
    "idx": 5527,
    "start": "02:30:57,754",
    "end": "02:30:59,634",
    "start_sec": 9057.754,
    "end_sec": 9059.634,
    "zh": "还好多带了几部手机和充电宝",
    "vi": "May mà mang theo mấy cái điện thoại và sạc dự phòng"
  },
  {
    "idx": 5528,
    "start": "02:30:59,634",
    "end": "02:31:00,194",
    "start_sec": 9059.634,
    "end_sec": 9060.194,
    "zh": "这是",
    "vi": "Đây là"
  },
  {
    "idx": 5529,
    "start": "02:31:00,194",
    "end": "02:31:01,534",
    "start_sec": 9060.194,
    "end_sec": 9061.534,
    "zh": "自己的隧道内",
    "vi": "trong đường hầm của mình"
  },
  {
    "idx": 5530,
    "start": "02:31:01,534",
    "end": "02:31:03,154",
    "start_sec": 9061.534,
    "end_sec": 9063.154,
    "zh": "医生来电的交道而行",
    "vi": "Đi theo chỉ dẫn của bác sĩ gọi đến"
  },
  {
    "idx": 5531,
    "start": "02:31:03,154",
    "end": "02:31:07,814",
    "start_sec": 9063.154,
    "end_sec": 9067.814,
    "zh": "这是给死人烧的煸香",
    "vi": "Đây là hương đốt cho người chết"
  },
  {
    "idx": 5532,
    "start": "02:31:07,814",
    "end": "02:31:09,694",
    "start_sec": 9067.814,
    "end_sec": 9069.694,
    "zh": "这么大的香物",
    "vi": "Hương lớn như vậy"
  },
  {
    "idx": 5533,
    "start": "02:31:09,694",
    "end": "02:31:10,994",
    "start_sec": 9069.694,
    "end_sec": 9070.994,
    "zh": "这得烧多少个香啊",
    "vi": "Phải đốt bao nhiêu cây hương đây"
  },
  {
    "idx": 5534,
    "start": "02:31:12,574",
    "end": "02:31:15,354",
    "start_sec": 9072.574,
    "end_sec": 9075.354,
    "zh": "卧槽",
    "vi": "Chết tiệt"
  },
  {
    "idx": 5535,
    "start": "02:31:15,354",
    "end": "02:31:16,334",
    "start_sec": 9075.354,
    "end_sec": 9076.334,
    "zh": "什么东西",
    "vi": "Cái gì vậy"
  },
  {
    "idx": 5536,
    "start": "02:31:16,334",
    "end": "02:31:21,314",
    "start_sec": 9076.334,
    "end_sec": 9081.314,
    "zh": "这是什么鬼",
    "vi": "Đây là cái quái gì"
  },
  {
    "idx": 5537,
    "start": "02:31:21,314",
    "end": "02:31:22,314",
    "start_sec": 9081.314,
    "end_sec": 9082.314,
    "zh": "饿死鬼吗",
    "vi": "Quỷ đói à"
  },
  {
    "idx": 5538,
    "start": "02:31:22,314",
    "end": "02:31:23,514",
    "start_sec": 9082.314,
    "end_sec": 9083.514,
    "zh": "碗里插着三炷香",
    "vi": "Ba nén hương cắm trong bát"
  },
  {
    "idx": 5539,
    "start": "02:31:23,994",
    "end": "02:31:42,734",
    "start_sec": 9083.994,
    "end_sec": 9102.734,
    "zh": "你是第二主星吗",
    "vi": "Bạn là ngôi sao thứ hai à"
  },
  {
    "idx": 5540,
    "start": "02:31:42,734",
    "end": "02:31:47,714",
    "start_sec": 9102.734,
    "end_sec": 9107.714,
    "zh": "你是第二主星吗",
    "vi": "Bạn là ngôi sao thứ hai à"
  },
  {
    "idx": 5541,
    "start": "02:31:47,714",
    "end": "02:31:48,474",
    "start_sec": 9107.714,
    "end_sec": 9108.474,
    "zh": "第二主星",
    "vi": "Ngôi sao thứ hai"
  },
  {
    "idx": 5542,
    "start": "02:31:48,474",
    "end": "02:31:49,894",
    "start_sec": 9108.474,
    "end_sec": 9109.894,
    "zh": "什么第二主星",
    "vi": "Ngôi sao thứ hai gì chứ"
  },
  {
    "idx": 5543,
    "start": "02:31:49,894",
    "end": "02:31:51,774",
    "start_sec": 9109.894,
    "end_sec": 9111.774,
    "zh": "那张鬼脸被滥落覆盖",
    "vi": "Khuôn mặt quỷ đó bị che phủ bởi bụi bẩn"
  },
  {
    "idx": 5544,
    "start": "02:31:51,774",
    "end": "02:31:53,434",
    "start_sec": 9111.774,
    "end_sec": 9113.434,
    "zh": "看得橙子皮直翻我字",
    "vi": "Khiến Trần Tử Bì nhìn mà phát nôn"
  },
  {
    "idx": 5545,
    "start": "02:31:53,434",
    "end": "02:32:01,554",
    "start_sec": 9113.434,
    "end_sec": 9121.554,
    "zh": "你 你能打我",
    "vi": "Bạn Bạn có thể đánh tôi"
  },
  {
    "idx": 5546,
    "start": "02:32:01,554",
    "end": "02:32:03,594",
    "start_sec": 9121.554,
    "end_sec": 9123.594,
    "zh": "你不是攻击者",
    "vi": "Bạn không phải kẻ tấn công"
  },
  {
    "idx": 5547,
    "start": "02:32:03,594",
    "end": "02:32:04,234",
    "start_sec": 9123.594,
    "end_sec": 9124.234,
    "zh": "我好",
    "vi": "Tôi tốt"
  },
  {
    "idx": 5548,
    "start": "02:32:04,234",
    "end": "02:32:06,214",
    "start_sec": 9124.234,
    "end_sec": 9126.214,
    "zh": "下意识里动了鬼面窗的能力",
    "vi": "Theo bản năng đã kích hoạt năng lực mặt nạ quỷ"
  },
  {
    "idx": 5549,
    "start": "02:32:06,214",
    "end": "02:32:08,294",
    "start_sec": 9126.214,
    "end_sec": 9128.294,
    "zh": "还好这玩意没感应",
    "vi": "May mà thứ này không có cảm ứng"
  },
  {
    "idx": 5550,
    "start": "02:32:08,294",
    "end": "02:32:10,314",
    "start_sec": 9128.294,
    "end_sec": 9130.314,
    "zh": "长子皮抬头怕了颜色的",
    "vi": "Trần Tử Bì ngẩng đầu lên và sợ hãi"
  },
  {
    "idx": 5551,
    "start": "02:32:10,314",
    "end": "02:32:11,334",
    "start_sec": 9130.314,
    "end_sec": 9131.334,
    "zh": "除了香不消失",
    "vi": "Ngoại trừ nén nhang không biến mất."
  },
  {
    "idx": 5552,
    "start": "02:32:11,334",
    "end": "02:32:13,094",
    "start_sec": 9131.334,
    "end_sec": 9133.094,
    "zh": "这道理依旧没有任何光亮",
    "vi": "Nơi này vẫn không có một chút ánh sáng nào."
  },
  {
    "idx": 5553,
    "start": "02:32:13,094",
    "end": "02:32:14,234",
    "start_sec": 9133.094,
    "end_sec": 9134.234,
    "zh": "本来我都打算走了",
    "vi": "Vốn dĩ ta đã định đi rồi."
  },
  {
    "idx": 5554,
    "start": "02:32:14,234",
    "end": "02:32:15,674",
    "start_sec": 9134.234,
    "end_sec": 9135.674,
    "zh": "你说你非要拦我不干嘛",
    "vi": "Ngươi nói xem ngươi tự dưng cản ta lại làm gì."
  },
  {
    "idx": 5555,
    "start": "02:32:15,674",
    "end": "02:32:16,914",
    "start_sec": 9135.674,
    "end_sec": 9136.914,
    "zh": "既然这么动手了",
    "vi": "Đã ra tay thế này rồi."
  },
  {
    "idx": 5556,
    "start": "02:32:16,914",
    "end": "02:32:18,294",
    "start_sec": 9136.914,
    "end_sec": 9138.294,
    "zh": "就没有必要畏畏缩缩了",
    "vi": "Thì không cần phải rụt rè sợ hãi nữa."
  },
  {
    "idx": 5557,
    "start": "02:32:18,294",
    "end": "02:32:20,334",
    "start_sec": 9138.294,
    "end_sec": 9140.334,
    "zh": "你 你是运不离者",
    "vi": "Ngươi, ngươi là Vận Bất Ly Giả."
  },
  {
    "idx": 5558,
    "start": "02:32:23,434",
    "end": "02:32:25,094",
    "start_sec": 9143.434,
    "end_sec": 9145.094,
    "zh": "你 你要干嘛",
    "vi": "Ngươi, ngươi muốn làm gì."
  },
  {
    "idx": 5559,
    "start": "02:32:25,094",
    "end": "02:32:26,474",
    "start_sec": 9145.094,
    "end_sec": 9146.474,
    "zh": "为你点黑的事",
    "vi": "Để thắp bóng tối cho ngươi."
  },
  {
    "idx": 5560,
    "start": "02:32:26,474",
    "end": "02:32:28,654",
    "start_sec": 9146.474,
    "end_sec": 9148.654,
    "zh": "你为什么不用诡异",
    "vi": "Tại sao ngươi không dùng quỷ dị."
  },
  {
    "idx": 5561,
    "start": "02:32:28,654",
    "end": "02:32:29,354",
    "start_sec": 9148.654,
    "end_sec": 9149.354,
    "zh": "我怎么",
    "vi": "Ta làm sao."
  },
  {
    "idx": 5562,
    "start": "02:32:29,354",
    "end": "02:32:31,554",
    "start_sec": 9149.354,
    "end_sec": 9151.554,
    "zh": "我总不能说鬼面窗的能力特殊",
    "vi": "Ta không thể nói là năng lực của Quỷ Diện Song rất đặc biệt."
  },
  {
    "idx": 5563,
    "start": "02:32:31,554",
    "end": "02:32:32,414",
    "start_sec": 9151.554,
    "end_sec": 9152.414,
    "zh": "没有攻击手段",
    "vi": "Không có phương thức tấn công."
  },
  {
    "idx": 5564,
    "start": "02:32:32,414",
    "end": "02:32:34,774",
    "start_sec": 9152.414,
    "end_sec": 9154.774,
    "zh": "就在长者皮想要靠近他时",
    "vi": "Ngay khi Trưởng Tử Bì muốn tiếp cận hắn."
  },
  {
    "idx": 5565,
    "start": "02:32:34,774",
    "end": "02:32:37,414",
    "start_sec": 9154.774,
    "end_sec": 9157.414,
    "zh": "惊恶地发现自己与他的距离越来越远",
    "vi": "Kinh hoàng phát hiện khoảng cách giữa mình và hắn ngày càng xa."
  },
  {
    "idx": 5566,
    "start": "02:32:37,414",
    "end": "02:32:39,794",
    "start_sec": 9157.414,
    "end_sec": 9159.794,
    "zh": "与刚刚想要避开他时如同一种",
    "vi": "Giống hệt như lúc nãy khi muốn tránh né hắn."
  },
  {
    "idx": 5567,
    "start": "02:32:39,794",
    "end": "02:32:41,834",
    "start_sec": 9159.794,
    "end_sec": 9161.834,
    "zh": "你的能力是能迷糊人的感知",
    "vi": "Năng lực của ngươi là làm mơ hồ cảm giác của người khác."
  },
  {
    "idx": 5568,
    "start": "02:32:41,834",
    "end": "02:32:44,034",
    "start_sec": 9161.834,
    "end_sec": 9164.034,
    "zh": "还是能控制缘物的空间",
    "vi": "Hay là có thể khống chế không gian xung quanh vật thể."
  },
  {
    "idx": 5569,
    "start": "02:32:44,034",
    "end": "02:32:47,994",
    "start_sec": 9164.034,
    "end_sec": 9167.994,
    "zh": "鬼者 等我吃完香再来找你",
    "vi": "Quỷ Giả, đợi ta ăn xong nén nhang này sẽ lại đến tìm ngươi."
  },
  {
    "idx": 5570,
    "start": "02:32:47,994",
    "end": "02:32:50,154",
    "start_sec": 9167.994,
    "end_sec": 9170.154,
    "zh": "灰色的声音回荡在隧道中",
    "vi": "Giọng nói âm u vang vọng trong đường hầm."
  },
  {
    "idx": 5571,
    "start": "02:32:50,154",
    "end": "02:32:51,574",
    "start_sec": 9170.154,
    "end_sec": 9171.574,
    "zh": "不过刹那间的风吹",
    "vi": "Nhưng chỉ trong một cơn gió thổi qua."
  },
  {
    "idx": 5572,
    "start": "02:32:51,574",
    "end": "02:32:53,214",
    "start_sec": 9171.574,
    "end_sec": 9173.214,
    "zh": "那飞影已然彻底消失了",
    "vi": "Bóng đen đó đã hoàn toàn biến mất."
  },
  {
    "idx": 5573,
    "start": "02:32:53,214",
    "end": "02:32:54,094",
    "start_sec": 9173.214,
    "end_sec": 9174.094,
    "zh": "这东西",
    "vi": "Thứ này."
  },
  {
    "idx": 5574,
    "start": "02:32:54,094",
    "end": "02:32:56,154",
    "start_sec": 9174.094,
    "end_sec": 9176.154,
    "zh": "莫非是什么规则内的诡异吗",
    "vi": "Chẳng lẽ là một loại quỷ dị trong quy tắc sao."
  },
  {
    "idx": 5575,
    "start": "02:32:56,154",
    "end": "02:32:57,474",
    "start_sec": 9176.154,
    "end_sec": 9177.474,
    "zh": "长子皮拿了个鼓",
    "vi": "Trưởng Tử Bì cầm lấy một chiếc trống."
  },
  {
    "idx": 5576,
    "start": "02:32:57,474",
    "end": "02:32:59,734",
    "start_sec": 9177.474,
    "end_sec": 9179.734,
    "zh": "拉着小磨叽朝着来时入睡去",
    "vi": "Kéo Tiểu Ma Ky đi về hướng lúc đến để ngủ."
  },
  {
    "idx": 5577,
    "start": "02:32:59,734",
    "end": "02:33:01,314",
    "start_sec": 9179.734,
    "end_sec": 9181.314,
    "zh": "也不知过了多久",
    "vi": "Cũng không biết đã qua bao lâu."
  },
  {
    "idx": 5578,
    "start": "02:33:01,314",
    "end": "02:33:03,594",
    "start_sec": 9181.314,
    "end_sec": 9183.594,
    "zh": "赫然能听到又一阵脚步声响起",
    "vi": "Bỗng nhiên có thể nghe thấy một tiếng bước chân khác vang lên."
  },
  {
    "idx": 5579,
    "start": "02:33:03,594",
    "end": "02:33:05,334",
    "start_sec": 9183.594,
    "end_sec": 9185.334,
    "zh": "喂 倩倩",
    "vi": "Này, Thiến Thiến."
  },
  {
    "idx": 5580,
    "start": "02:33:05,334",
    "end": "02:33:05,934",
    "start_sec": 9185.334,
    "end_sec": 9185.934,
    "zh": "你说",
    "vi": "Ngươi nói đi."
  },
  {
    "idx": 5581,
    "start": "02:33:05,934",
    "end": "02:33:09,534",
    "start_sec": 9185.934,
    "end_sec": 9189.534,
    "zh": "真的能在那鬼东西吃人的时候尝试穿过隧道吗",
    "vi": "Liệu chúng ta có thực sự băng qua đường hầm được khi con quỷ đó đang ăn thịt người không."
  },
  {
    "idx": 5582,
    "start": "02:33:09,534",
    "end": "02:33:10,494",
    "start_sec": 9189.534,
    "end_sec": 9190.494,
    "zh": "嗯 五鸣",
    "vi": "Ừm Ngũ Minh."
  },
  {
    "idx": 5583,
    "start": "02:33:10,494",
    "end": "02:33:11,494",
    "start_sec": 9190.494,
    "end_sec": 9191.494,
    "zh": "你还记得吗",
    "vi": "Ngươi còn nhớ không."
  },
  {
    "idx": 5584,
    "start": "02:33:11,494",
    "end": "02:33:14,154",
    "start_sec": 9191.494,
    "end_sec": 9194.154,
    "zh": "上次我们几个来这里走不出去的时候",
    "vi": "Lần trước mấy đứa mình đến đây mà không tìm được lối ra."
  },
  {
    "idx": 5585,
    "start": "02:33:14,154",
    "end": "02:33:16,234",
    "start_sec": 9194.154,
    "end_sec": 9196.234,
    "zh": "赵有为被那个东西抓了啃食",
    "vi": "Triệu Hữu Vi đã bị thứ đó bắt lấy và ăn thịt."
  },
  {
    "idx": 5586,
    "start": "02:33:16,234",
    "end": "02:33:17,574",
    "start_sec": 9196.234,
    "end_sec": 9197.574,
    "zh": "我们就跑出来了",
    "vi": "Chúng ta mới chạy thoát được."
  },
  {
    "idx": 5587,
    "start": "02:33:17,574",
    "end": "02:33:18,194",
    "start_sec": 9197.574,
    "end_sec": 9198.194,
    "zh": "也对",
    "vi": "Cũng đúng."
  },
  {
    "idx": 5588,
    "start": "02:33:18,194",
    "end": "02:33:18,654",
    "start_sec": 9198.194,
    "end_sec": 9198.654,
    "zh": "可是",
    "vi": "Nhưng mà."
  },
  {
    "idx": 5589,
    "start": "02:33:18,654",
    "end": "02:33:20,474",
    "start_sec": 9198.654,
    "end_sec": 9200.474,
    "zh": "你说那个牵着黑狗的家伙",
    "vi": "Ngươi nói xem gã dắt chó đen kia."
  },
  {
    "idx": 5590,
    "start": "02:33:20,474",
    "end": "02:33:21,994",
    "start_sec": 9200.474,
    "end_sec": 9201.994,
    "zh": "现在是不是已经没了",
    "vi": "Giờ này chắc đã xong đời rồi nhỉ."
  },
  {
    "idx": 5591,
    "start": "02:33:21,994",
    "end": "02:33:24,354",
    "start_sec": 9201.994,
    "end_sec": 9204.354,
    "zh": "应该不至于我们速度快点",
    "vi": "Chắc là chưa đâu chúng ta đi nhanh một chút."
  },
  {
    "idx": 5592,
    "start": "02:33:24,354",
    "end": "02:33:26,154",
    "start_sec": 9204.354,
    "end_sec": 9206.154,
    "zh": "分曲在他被吃完的时候",
    "vi": "Tranh thủ lúc hắn đang bị ăn thịt."
  },
  {
    "idx": 5593,
    "start": "02:33:26,154",
    "end": "02:33:27,334",
    "start_sec": 9206.154,
    "end_sec": 9207.334,
    "zh": "我们走出隧道",
    "vi": "Chúng ta sẽ ra khỏi đường hầm."
  },
  {
    "idx": 5594,
    "start": "02:33:27,334",
    "end": "02:33:29,974",
    "start_sec": 9207.334,
    "end_sec": 9209.974,
    "zh": "这两个声音",
    "vi": "Hai giọng nói này."
  },
  {
    "idx": 5595,
    "start": "02:33:29,974",
    "end": "02:33:32,914",
    "start_sec": 9209.974,
    "end_sec": 9212.914,
    "zh": "好像是今天遇到的躲在加油站里的大学生",
    "vi": "Hình như là mấy sinh viên đại học trốn trong trạm xăng mà mình gặp hôm nay."
  },
  {
    "idx": 5596,
    "start": "02:33:32,914",
    "end": "02:33:34,274",
    "start_sec": 9212.914,
    "end_sec": 9214.274,
    "zh": "趁鬼没吃我的时候",
    "vi": "Tranh thủ lúc quỷ chưa ăn thịt ta."
  },
  {
    "idx": 5597,
    "start": "02:33:34,274",
    "end": "02:33:35,194",
    "start_sec": 9214.274,
    "end_sec": 9215.194,
    "zh": "你们走出隧道",
    "vi": "Các ngươi ra khỏi đường hầm."
  },
  {
    "idx": 5598,
    "start": "02:33:35,194",
    "end": "02:33:36,074",
    "start_sec": 9215.194,
    "end_sec": 9216.074,
    "zh": "有点意思",
    "vi": "Thú vị thật."
  },
  {
    "idx": 5599,
    "start": "02:33:36,074",
    "end": "02:33:37,674",
    "start_sec": 9216.074,
    "end_sec": 9217.674,
    "zh": "肠子皮默默讲着",
    "vi": "Tràng Tử Bì thầm nghĩ."
  },
  {
    "idx": 5600,
    "start": "02:33:37,674",
    "end": "02:33:38,274",
    "start_sec": 9217.674,
    "end_sec": 9218.274,
    "zh": "有些不知",
    "vi": "Có chút khó hiểu."
  },
  {
    "idx": 5601,
    "start": "02:33:38,274",
    "end": "02:33:39,014",
    "start_sec": 9218.274,
    "end_sec": 9219.014,
    "zh": "按理说",
    "vi": "Theo lý mà nói."
  },
  {
    "idx": 5602,
    "start": "02:33:39,014",
    "end": "02:33:40,794",
    "start_sec": 9219.014,
    "end_sec": 9220.794,
    "zh": "他们是从隧道口进来的",
    "vi": "Họ đi vào từ cửa đường hầm."
  },
  {
    "idx": 5603,
    "start": "02:33:40,794",
    "end": "02:33:42,454",
    "start_sec": 9220.794,
    "end_sec": 9222.454,
    "zh": "声音应该是在我们身后才吃",
    "vi": "Âm thanh đáng lẽ phải ở phía sau chúng ta mới đúng."
  },
  {
    "idx": 5604,
    "start": "02:33:42,454",
    "end": "02:33:44,314",
    "start_sec": 9222.454,
    "end_sec": 9224.314,
    "zh": "为什么会从前面传来",
    "vi": "Tại sao lại truyền đến từ phía trước."
  },
  {
    "idx": 5605,
    "start": "02:33:44,314",
    "end": "02:33:46,754",
    "start_sec": 9224.314,
    "end_sec": 9226.754,
    "zh": "想着肠子皮朝着身边源头走进",
    "vi": "Nghĩ đoạn Tràng Tử Bì bước về phía nguồn âm thanh."
  },
  {
    "idx": 5606,
    "start": "02:33:46,754",
    "end": "02:33:47,914",
    "start_sec": 9226.754,
    "end_sec": 9227.914,
    "zh": "但走出隧道后",
    "vi": "Nhưng sau khi ra khỏi đường hầm."
  },
  {
    "idx": 5607,
    "start": "02:33:47,914",
    "end": "02:33:49,894",
    "start_sec": 9227.914,
    "end_sec": 9229.894,
    "zh": "那两道脚步声就越来越响",
    "vi": "Hai tiếng bước chân đó lại càng lúc càng lớn."
  },
  {
    "idx": 5608,
    "start": "02:33:49,894",
    "end": "02:33:50,594",
    "start_sec": 9229.894,
    "end_sec": 9230.594,
    "zh": "感知",
    "vi": "Cảm giác."
  },
  {
    "idx": 5609,
    "start": "02:33:50,594",
    "end": "02:33:51,774",
    "start_sec": 9230.594,
    "end_sec": 9231.774,
    "zh": "似乎变得混乱",
    "vi": "Dường như trở nên hỗn loạn."
  },
  {
    "idx": 5610,
    "start": "02:33:51,774",
    "end": "02:33:53,134",
    "start_sec": 9231.774,
    "end_sec": 9233.134,
    "zh": "原地停下脚步",
    "vi": "Tại chỗ dừng bước lại."
  },
  {
    "idx": 5611,
    "start": "02:33:53,134",
    "end": "02:33:54,674",
    "start_sec": 9233.134,
    "end_sec": 9234.674,
    "zh": "橙子皮火性不动了",
    "vi": "Trần Tử Bì không còn động đậy nữa."
  },
  {
    "idx": 5612,
    "start": "02:33:54,674",
    "end": "02:33:55,074",
    "start_sec": 9234.674,
    "end_sec": 9235.074,
    "zh": "这一次",
    "vi": "Lần này."
  },
  {
    "idx": 5613,
    "start": "02:33:55,074",
    "end": "02:33:56,714",
    "start_sec": 9235.074,
    "end_sec": 9236.714,
    "zh": "声音从更后方传来",
    "vi": "Âm thanh truyền đến từ phía sau xa hơn."
  },
  {
    "idx": 5614,
    "start": "02:33:56,714",
    "end": "02:33:57,874",
    "start_sec": 9236.714,
    "end_sec": 9237.874,
    "zh": "倩倩啊",
    "vi": "Thiến Thiến à."
  },
  {
    "idx": 5615,
    "start": "02:33:57,874",
    "end": "02:33:59,394",
    "start_sec": 9237.874,
    "end_sec": 9239.394,
    "zh": "你为什么只带我出来啊",
    "vi": "Sao bạn chỉ đưa tôi ra ngoài thế."
  },
  {
    "idx": 5616,
    "start": "02:33:59,394",
    "end": "02:34:01,294",
    "start_sec": 9239.394,
    "end_sec": 9241.294,
    "zh": "你是不是对我有好感啊",
    "vi": "Có phải bạn có cảm tình với tôi không."
  },
  {
    "idx": 5617,
    "start": "02:34:01,294",
    "end": "02:34:02,014",
    "start_sec": 9241.294,
    "end_sec": 9242.014,
    "zh": "是啊是啊",
    "vi": "Đúng vậy đúng vậy."
  },
  {
    "idx": 5618,
    "start": "02:34:02,014",
    "end": "02:34:02,914",
    "start_sec": 9242.014,
    "end_sec": 9242.914,
    "zh": "我跟你说",
    "vi": "Tôi nói cho bạn nghe."
  },
  {
    "idx": 5619,
    "start": "02:34:02,914",
    "end": "02:34:03,994",
    "start_sec": 9242.914,
    "end_sec": 9243.994,
    "zh": "只要穿过这里",
    "vi": "Chỉ cần đi qua chỗ này."
  },
  {
    "idx": 5620,
    "start": "02:34:03,994",
    "end": "02:34:05,714",
    "start_sec": 9243.994,
    "end_sec": 9245.714,
    "zh": "我们通过南城河大桥",
    "vi": "Chúng ta đi qua cầu Nam Thành Hà."
  },
  {
    "idx": 5621,
    "start": "02:34:05,714",
    "end": "02:34:06,754",
    "start_sec": 9245.714,
    "end_sec": 9246.754,
    "zh": "离开临江市",
    "vi": "Rời khỏi thành phố Lâm Giang."
  },
  {
    "idx": 5622,
    "start": "02:34:06,754",
    "end": "02:34:08,914",
    "start_sec": 9246.754,
    "end_sec": 9248.914,
    "zh": "说不定还能回到以前的生活呢",
    "vi": "Biết đâu còn có thể quay lại cuộc sống trước kia."
  },
  {
    "idx": 5623,
    "start": "02:34:08,914",
    "end": "02:34:09,634",
    "start_sec": 9248.914,
    "end_sec": 9249.634,
    "zh": "真的吗",
    "vi": "Thật sao."
  },
  {
    "idx": 5624,
    "start": "02:34:09,634",
    "end": "02:34:11,354",
    "start_sec": 9249.634,
    "end_sec": 9251.354,
    "zh": "可是不带上雅萍她们",
    "vi": "Nhưng không đưa bọn Nhã Bình đi cùng."
  },
  {
    "idx": 5625,
    "start": "02:34:11,354",
    "end": "02:34:12,214",
    "start_sec": 9251.354,
    "end_sec": 9252.214,
    "zh": "这好吗",
    "vi": "Như vậy có ổn không."
  },
  {
    "idx": 5626,
    "start": "02:34:12,214",
    "end": "02:34:13,114",
    "start_sec": 9252.214,
    "end_sec": 9253.114,
    "zh": "带她们干嘛",
    "vi": "Đưa bọn họ theo làm gì."
  },
  {
    "idx": 5627,
    "start": "02:34:13,114",
    "end": "02:34:14,454",
    "start_sec": 9253.114,
    "end_sec": 9254.454,
    "zh": "加油站里的食物",
    "vi": "Thức ăn trong trạm xăng."
  },
  {
    "idx": 5628,
    "start": "02:34:14,454",
    "end": "02:34:16,514",
    "start_sec": 9254.454,
    "end_sec": 9256.514,
    "zh": "她们每天晚上都偷偷藏一点",
    "vi": "Mỗi tối bọn họ đều lén giấu đi một ít."
  },
  {
    "idx": 5629,
    "start": "02:34:16,514",
    "end": "02:34:18,414",
    "start_sec": 9256.514,
    "end_sec": 9258.414,
    "zh": "根本就没把我们当自己人",
    "vi": "Hoàn toàn không coi chúng ta là người bên mình."
  },
  {
    "idx": 5630,
    "start": "02:34:18,414",
    "end": "02:34:18,894",
    "start_sec": 9258.414,
    "end_sec": 9258.894,
    "zh": "哦",
    "vi": "Ồ."
  },
  {
    "idx": 5631,
    "start": "02:34:18,894",
    "end": "02:34:19,474",
    "start_sec": 9258.894,
    "end_sec": 9259.474,
    "zh": "好吧",
    "vi": "Được rồi."
  },
  {
    "idx": 5632,
    "start": "02:34:19,474",
    "end": "02:34:20,574",
    "start_sec": 9259.474,
    "end_sec": 9260.574,
    "zh": "倩倩你放心",
    "vi": "Thiến Thiến bạn yên tâm đi."
  },
  {
    "idx": 5633,
    "start": "02:34:20,574",
    "end": "02:34:22,814",
    "start_sec": 9260.574,
    "end_sec": 9262.814,
    "zh": "一会儿有危险我一定会保护你的",
    "vi": "Lát nữa có nguy hiểm tôi nhất định sẽ bảo vệ bạn."
  },
  {
    "idx": 5634,
    "start": "02:34:22,814",
    "end": "02:34:27,894",
    "start_sec": 9262.814,
    "end_sec": 9267.894,
    "zh": "倩倩",
    "vi": "Thiến Thiến."
  },
  {
    "idx": 5635,
    "start": "02:34:27,894",
    "end": "02:34:30,654",
    "start_sec": 9267.894,
    "end_sec": 9270.654,
    "zh": "我 我刚刚好像看到一个黑影飘过去了",
    "vi": "Tôi, tôi vừa mới như nhìn thấy một bóng đen lướt qua."
  },
  {
    "idx": 5636,
    "start": "02:34:30,654",
    "end": "02:34:32,014",
    "start_sec": 9270.654,
    "end_sec": 9272.014,
    "zh": "五明 五明",
    "vi": "Ngũ Minh, Ngũ Minh."
  },
  {
    "idx": 5637,
    "start": "02:34:32,014",
    "end": "02:34:33,494",
    "start_sec": 9272.014,
    "end_sec": 9273.494,
    "zh": "你看 那些到顶上",
    "vi": "Bạn nhìn kìa, trên nóc kia."
  },
  {
    "idx": 5638,
    "start": "02:34:33,494",
    "end": "02:34:34,874",
    "start_sec": 9273.494,
    "end_sec": 9274.874,
    "zh": "有 有个老婆在爬",
    "vi": "Có, có một bà lão đang bò."
  },
  {
    "idx": 5639,
    "start": "02:34:34,874",
    "end": "02:34:36,994",
    "start_sec": 9274.874,
    "end_sec": 9276.994,
    "zh": "她 她就是上次那个怪物",
    "vi": "Bà ta, bà ta chính là con quái vật lần trước."
  },
  {
    "idx": 5640,
    "start": "02:34:36,994",
    "end": "02:34:39,334",
    "start_sec": 9276.994,
    "end_sec": 9279.334,
    "zh": "她怎么没去吃那个带着黑狗的家伙",
    "vi": "Sao bà ta không đi ăn thịt kẻ dắt theo con chó đen kia."
  },
  {
    "idx": 5641,
    "start": "02:34:39,334",
    "end": "02:34:42,794",
    "start_sec": 9279.334,
    "end_sec": 9282.794,
    "zh": "原来 你而住的在这里啊",
    "vi": "Hóa ra ngươi sống ở đây sao."
  },
  {
    "idx": 5642,
    "start": "02:34:46,974",
    "end": "02:34:48,854",
    "start_sec": 9286.974,
    "end_sec": 9288.854,
    "zh": "五明 快跑 快跑",
    "vi": "Ngũ Minh, chạy mau, chạy mau."
  },
  {
    "idx": 5643,
    "start": "02:34:48,854",
    "end": "02:34:51,934",
    "start_sec": 9288.854,
    "end_sec": 9291.934,
    "zh": "声音确实是从后面传来的",
    "vi": "Âm thanh quả thực là truyền đến từ phía sau."
  },
  {
    "idx": 5644,
    "start": "02:34:51,934",
    "end": "02:34:53,134",
    "start_sec": 9291.934,
    "end_sec": 9293.134,
    "zh": "现在基本可以断定",
    "vi": "Bây giờ cơ bản có thể khẳng định."
  },
  {
    "idx": 5645,
    "start": "02:34:53,134",
    "end": "02:34:54,334",
    "start_sec": 9293.134,
    "end_sec": 9294.334,
    "zh": "那个吃香的老家伙",
    "vi": "Lão già thích ăn nhang đó."
  },
  {
    "idx": 5646,
    "start": "02:34:54,334",
    "end": "02:34:56,182",
    "start_sec": 9294.334,
    "end_sec": 9296.182,
    "zh": "可以影响他人的感知这样的话一时半会儿也无法走出狮山水岛听到两人的意思,石山鬼应该在吃人的时候,扰乱感知的能力会暂时消失。既然你们一开始就想利用我会吃的时候跑出隧道,",
    "vi": "Có thể ảnh hưởng đến nhận thức của người khác"
  },
  {
    "idx": 5646,
    "start": "02:34:56,182",
    "end": "02:34:58,954",
    "start_sec": 9296.182,
    "end_sec": 9298.954,
    "zh": "可以影响他人的感知这样的话一时半会儿也无法走出狮山水岛听到两人的意思,石山鬼应该在吃人的时候,扰乱感知的能力会暂时消失。既然你们一开始就想利用我会吃的时候跑出隧道,",
    "vi": "Như vậy thì trong chốc lát cũng không thể ra khỏi đường hầm Thạch Sơn"
  },
  {
    "idx": 5646,
    "start": "02:34:58,954",
    "end": "02:35:03,574",
    "start_sec": 9298.954,
    "end_sec": 9303.574,
    "zh": "可以影响他人的感知这样的话一时半会儿也无法走出狮山水岛听到两人的意思,石山鬼应该在吃人的时候,扰乱感知的能力会暂时消失。既然你们一开始就想利用我会吃的时候跑出隧道,",
    "vi": "Nghe ý của hai người họ, Thạch Sơn Quỷ khi ăn thịt người thì năng lượng gây nhiễu nhận thức sẽ tạm thời biến mất"
  },
  {
    "idx": 5646,
    "start": "02:35:03,574",
    "end": "02:35:07,271",
    "start_sec": 9303.574,
    "end_sec": 9307.271,
    "zh": "可以影响他人的感知这样的话一时半会儿也无法走出狮山水岛听到两人的意思,石山鬼应该在吃人的时候,扰乱感知的能力会暂时消失。既然你们一开始就想利用我会吃的时候跑出隧道,",
    "vi": "Nếu các người ngay từ đầu đã muốn lợi dụng lúc ta ăn thịt để chạy trốn khỏi đường hầm"
  },
  {
    "idx": 5647,
    "start": "02:35:07,491",
    "end": "02:35:09,491",
    "start_sec": 9307.491,
    "end_sec": 9309.491,
    "zh": "现在看来,你们才是被利用的了。",
    "vi": "Thì bây giờ xem ra, các người mới là kẻ bị lợi dụng."
  },
  {
    "idx": 5648,
    "start": "02:35:10,091",
    "end": "02:35:11,751",
    "start_sec": 9310.091,
    "end_sec": 9311.751,
    "zh": "五名,你快走,快走了。",
    "vi": "Ngũ Minh, cậu mau đi đi, mau đi đi."
  },
  {
    "idx": 5649,
    "start": "02:35:13,491",
    "end": "02:35:16,471",
    "start_sec": 9313.491,
    "end_sec": 9316.471,
    "zh": "不,先生,我一定会保护你的,我来拖住他。",
    "vi": "Không, thưa thầy, con nhất định sẽ bảo vệ thầy, con sẽ giữ chân hắn."
  },
  {
    "idx": 5650,
    "start": "02:35:20,031",
    "end": "02:35:22,991",
    "start_sec": 9320.031,
    "end_sec": 9322.991,
    "zh": "什么情况,一程不变的隧道里,怎么会有个石头堆?",
    "vi": "Có chuyện gì thế này, trong đường hầm vốn không có gì thay đổi, sao lại có một đống đá thế này."
  },
  {
    "idx": 5651,
    "start": "02:35:24,991",
    "end": "02:35:29,831",
    "start_sec": 9324.991,
    "end_sec": 9329.831,
    "zh": "一具无头尸体",
    "vi": "Một cái xác không đầu."
  },
  {
    "idx": 5652,
    "start": "02:35:29,831",
    "end": "02:35:32,311",
    "start_sec": 9329.831,
    "end_sec": 9332.311,
    "zh": "被石头埋住小腿",
    "vi": "Bị đá đè lên bắp chân."
  },
  {
    "idx": 5653,
    "start": "02:35:32,311",
    "end": "02:35:33,231",
    "start_sec": 9332.311,
    "end_sec": 9333.231,
    "zh": "有腐烂味",
    "vi": "Có mùi thối rữa."
  },
  {
    "idx": 5654,
    "start": "02:35:33,231",
    "end": "02:35:34,951",
    "start_sec": 9333.231,
    "end_sec": 9334.951,
    "zh": "但身上没有腐烂痕迹",
    "vi": "Nhưng trên người không có vết thối rữa nào."
  },
  {
    "idx": 5655,
    "start": "02:35:34,951",
    "end": "02:35:36,371",
    "start_sec": 9334.951,
    "end_sec": 9336.371,
    "zh": "投入双臂锻炼土",
    "vi": "Chỗ đứt lìa của đầu và hai tay."
  },
  {
    "idx": 5656,
    "start": "02:35:36,371",
    "end": "02:35:37,631",
    "start_sec": 9336.371,
    "end_sec": 9337.631,
    "zh": "显然刚结痂不久",
    "vi": "Rõ ràng là mới đóng vảy chưa lâu."
  },
  {
    "idx": 5657,
    "start": "02:35:37,631",
    "end": "02:35:41,171",
    "start_sec": 9337.631,
    "end_sec": 9341.171,
    "zh": "看样子",
    "vi": "Xem ra."
  },
  {
    "idx": 5658,
    "start": "02:35:41,171",
    "end": "02:35:43,231",
    "start_sec": 9341.171,
    "end_sec": 9343.231,
    "zh": "这石堆下面应该还有一具尸体",
    "vi": "Dưới đống đá này chắc là vẫn còn một cái xác nữa."
  },
  {
    "idx": 5659,
    "start": "02:35:43,231",
    "end": "02:35:44,851",
    "start_sec": 9343.231,
    "end_sec": 9344.851,
    "zh": "隧道里出现新路况",
    "vi": "Trong đường hầm xuất hiện lối đi mới."
  },
  {
    "idx": 5660,
    "start": "02:35:44,851",
    "end": "02:35:45,591",
    "start_sec": 9344.851,
    "end_sec": 9345.591,
    "zh": "也就是说",
    "vi": "Nghĩa là."
  },
  {
    "idx": 5661,
    "start": "02:35:45,591",
    "end": "02:35:47,111",
    "start_sec": 9345.591,
    "end_sec": 9347.111,
    "zh": "我现在并不是在往回走",
    "vi": "Bây giờ tôi không phải đang đi giật lùi."
  },
  {
    "idx": 5662,
    "start": "02:35:47,111",
    "end": "02:35:48,871",
    "start_sec": 9347.111,
    "end_sec": 9348.871,
    "zh": "而是在往深山隧道出口走",
    "vi": "Mà là đang đi về phía lối ra của đường hầm sâu trong núi."
  },
  {
    "idx": 5663,
    "start": "02:35:48,871",
    "end": "02:35:50,071",
    "start_sec": 9348.871,
    "end_sec": 9350.071,
    "zh": "这样的话",
    "vi": "Nếu đã như vậy."
  },
  {
    "idx": 5664,
    "start": "02:35:50,071",
    "end": "02:35:51,891",
    "start_sec": 9350.071,
    "end_sec": 9351.891,
    "zh": "趁着那两名大学生遇害的时候",
    "vi": "Nhân lúc hai sinh viên kia gặp nạn."
  },
  {
    "idx": 5665,
    "start": "02:35:51,891",
    "end": "02:35:53,811",
    "start_sec": 9351.891,
    "end_sec": 9353.811,
    "zh": "我可以趁机跑出深山隧道",
    "vi": "Tôi có thể tranh thủ chạy thoát khỏi đường hầm này."
  },
  {
    "idx": 5666,
    "start": "02:35:53,811",
    "end": "02:35:55,411",
    "start_sec": 9353.811,
    "end_sec": 9355.411,
    "zh": "橙子皮想也没想",
    "vi": "Trần Tử Bì không cần suy nghĩ."
  },
  {
    "idx": 5667,
    "start": "02:35:55,411",
    "end": "02:35:56,431",
    "start_sec": 9355.411,
    "end_sec": 9356.431,
    "zh": "抱着小莫子",
    "vi": "Bế Tiểu Mạc Tử lên."
  },
  {
    "idx": 5668,
    "start": "02:35:56,431",
    "end": "02:35:57,851",
    "start_sec": 9356.431,
    "end_sec": 9357.851,
    "zh": "踩着坑坑哇哇的",
    "vi": "Giẫm lên những lối đi gồ ghề."
  },
  {
    "idx": 5669,
    "start": "02:35:57,851",
    "end": "02:35:58,471",
    "start_sec": 9357.851,
    "end_sec": 9358.471,
    "zh": "虽是狂奔",
    "vi": "Và điên cuồng chạy trốn."
  },
  {
    "idx": 5670,
    "start": "02:35:58,471",
    "end": "02:35:59,631",
    "start_sec": 9358.471,
    "end_sec": 9359.631,
    "zh": "但是越往前跑",
    "vi": "Nhưng càng chạy về phía trước."
  },
  {
    "idx": 5671,
    "start": "02:35:59,631",
    "end": "02:36:01,151",
    "start_sec": 9359.631,
    "end_sec": 9361.151,
    "zh": "脚下的血管越来越少",
    "vi": "Mạch máu dưới chân ngày càng ít đi."
  },
  {
    "idx": 5672,
    "start": "02:36:01,151",
    "end": "02:36:02,331",
    "start_sec": 9361.151,
    "end_sec": 9362.331,
    "zh": "橙子皮心头",
    "vi": "Trong lòng Trần Tử Bì"
  },
  {
    "idx": 5673,
    "start": "02:36:02,331",
    "end": "02:36:03,871",
    "start_sec": 9362.331,
    "end_sec": 9363.871,
    "zh": "顿时生出不好的预感",
    "vi": "chợt dấy lên một điềm báo chẳng lành."
  },
  {
    "idx": 5674,
    "start": "02:36:03,871",
    "end": "02:36:06,431",
    "start_sec": 9363.871,
    "end_sec": 9366.431,
    "zh": "五民五民",
    "vi": "Ngũ Dân, Ngũ Dân."
  },
  {
    "idx": 5675,
    "start": "02:36:06,431",
    "end": "02:36:07,271",
    "start_sec": 9366.431,
    "end_sec": 9367.271,
    "zh": "倩倩",
    "vi": "Thiến Thiến."
  },
  {
    "idx": 5676,
    "start": "02:36:07,271",
    "end": "02:36:08,111",
    "start_sec": 9367.271,
    "end_sec": 9368.111,
    "zh": "赶快走吧",
    "vi": "Mau đi đi."
  },
  {
    "idx": 5677,
    "start": "02:36:08,111",
    "end": "02:36:08,771",
    "start_sec": 9368.111,
    "end_sec": 9368.771,
    "zh": "走吧",
    "vi": "Đi đi."
  },
  {
    "idx": 5678,
    "start": "02:36:08,771",
    "end": "02:36:10,391",
    "start_sec": 9368.771,
    "end_sec": 9370.391,
    "zh": "吐息的声音含泪",
    "vi": "Giọng nói thều thào nghẹn ngào nước mắt."
  },
  {
    "idx": 5679,
    "start": "02:36:10,391",
    "end": "02:36:12,251",
    "start_sec": 9370.391,
    "end_sec": 9372.251,
    "zh": "橙子皮知道他又跑回来了",
    "vi": "Trần Tử Bì biết mình lại chạy vòng về chỗ cũ."
  },
  {
    "idx": 5680,
    "start": "02:36:12,251",
    "end": "02:36:13,291",
    "start_sec": 9372.251,
    "end_sec": 9373.291,
    "zh": "顿时脸色一深",
    "vi": "Sắc mặt anh lập tức sa sầm xuống."
  },
  {
    "idx": 5681,
    "start": "02:36:13,291",
    "end": "02:36:14,071",
    "start_sec": 9373.291,
    "end_sec": 9374.071,
    "zh": "我操",
    "vi": "Mẹ kiếp."
  },
  {
    "idx": 5682,
    "start": "02:36:14,071",
    "end": "02:36:15,731",
    "start_sec": 9374.071,
    "end_sec": 9375.731,
    "zh": "嘟嘟转转跑了一圈",
    "vi": "Chạy lòng vòng một hồi."
  },
  {
    "idx": 5683,
    "start": "02:36:15,731",
    "end": "02:36:17,631",
    "start_sec": 9375.731,
    "end_sec": 9377.631,
    "zh": "居然给我跑到你们这了",
    "vi": "Lại chạy đến đúng chỗ các người thế này."
  },
  {
    "idx": 5684,
    "start": "02:36:19,631",
    "end": "02:36:20,111",
    "start_sec": 9379.631,
    "end_sec": 9380.111,
    "zh": "橙子",
    "vi": "Tử Bì."
  },
  {
    "idx": 5685,
    "start": "02:36:20,111",
    "end": "02:36:20,751",
    "start_sec": 9380.111,
    "end_sec": 9380.751,
    "zh": "对了",
    "vi": "Phải rồi."
  },
  {
    "idx": 5686,
    "start": "02:36:20,751",
    "end": "02:36:22,451",
    "start_sec": 9380.751,
    "end_sec": 9382.451,
    "zh": "只要在进隧道时",
    "vi": "Chỉ cần lúc vào đường hầm."
  },
  {
    "idx": 5687,
    "start": "02:36:22,451",
    "end": "02:36:23,631",
    "start_sec": 9382.451,
    "end_sec": 9383.631,
    "zh": "外系上一根绳子",
    "vi": "Buộc một sợi dây thừng ở ngoài."
  },
  {
    "idx": 5688,
    "start": "02:36:23,631",
    "end": "02:36:25,891",
    "start_sec": 9383.631,
    "end_sec": 9385.891,
    "zh": "摸着绳子走就不会重复走路",
    "vi": "Men theo sợi dây sẽ không đi lặp lại đường cũ."
  },
  {
    "idx": 5689,
    "start": "02:36:25,891",
    "end": "02:36:27,671",
    "start_sec": 9385.891,
    "end_sec": 9387.671,
    "zh": "你 你竟然还活着",
    "vi": "Cậu, cậu vẫn còn sống sao."
  },
  {
    "idx": 5690,
    "start": "02:36:27,671",
    "end": "02:36:29,651",
    "start_sec": 9387.671,
    "end_sec": 9389.651,
    "zh": "兄弟 我不求你救我",
    "vi": "Người anh em, tôi không cầu xin cậu cứu tôi."
  },
  {
    "idx": 5691,
    "start": "02:36:29,651",
    "end": "02:36:31,691",
    "start_sec": 9389.651,
    "end_sec": 9391.691,
    "zh": "你 你帮我照顾倩倩好不好",
    "vi": "Cậu, cậu giúp tôi chăm sóc Thiến Thiến được không."
  },
  {
    "idx": 5692,
    "start": "02:36:31,691",
    "end": "02:36:33,411",
    "start_sec": 9391.691,
    "end_sec": 9393.411,
    "zh": "跟着她你能跑出这里来",
    "vi": "Đi theo cô ấy cậu có thể chạy thoát khỏi đây."
  },
  {
    "idx": 5693,
    "start": "02:36:33,411",
    "end": "02:36:35,031",
    "start_sec": 9393.411,
    "end_sec": 9395.031,
    "zh": "唐泽皮没有回答",
    "vi": "Trần Tử Bì không trả lời."
  },
  {
    "idx": 5694,
    "start": "02:36:35,031",
    "end": "02:36:37,191",
    "start_sec": 9395.031,
    "end_sec": 9397.191,
    "zh": "只是一个劲的追上那个女大学生",
    "vi": "Chỉ cắm đầu đuổi theo cô nữ sinh đại học kia."
  },
  {
    "idx": 5695,
    "start": "02:36:37,191",
    "end": "02:36:40,151",
    "start_sec": 9397.191,
    "end_sec": 9400.151,
    "zh": "没事的 倩倩",
    "vi": "Không sao đâu, Thiến Thiến."
  },
  {
    "idx": 5696,
    "start": "02:36:40,151",
    "end": "02:36:41,791",
    "start_sec": 9400.151,
    "end_sec": 9401.791,
    "zh": "你一定会没事的",
    "vi": "Em nhất định sẽ không sao đâu."
  },
  {
    "idx": 5697,
    "start": "02:36:41,791",
    "end": "02:36:44,471",
    "start_sec": 9401.791,
    "end_sec": 9404.471,
    "zh": "为了你 一切 一切都值",
    "vi": "Vì em, mọi thứ, mọi thứ đều xứng"
  },
  {
    "idx": 5698,
    "start": "02:36:44,471",
    "end": "02:36:46,091",
    "start_sec": 9404.471,
    "end_sec": 9406.091,
    "zh": "得",
    "vi": "đáng."
  },
  {
    "idx": 5699,
    "start": "02:36:53,631",
    "end": "02:36:55,531",
    "start_sec": 9413.631,
    "end_sec": 9415.531,
    "zh": "喂 停下",
    "vi": "Này, dừng lại đi."
  },
  {
    "idx": 5700,
    "start": "02:36:55,531",
    "end": "02:36:57,591",
    "start_sec": 9415.531,
    "end_sec": 9417.591,
    "zh": "你不怕被那怪物单独追上吗",
    "vi": "Cậu không sợ bị con quái vật đó đuổi kịp sao."
  },
  {
    "idx": 5701,
    "start": "02:36:57,591",
    "end": "02:36:59,351",
    "start_sec": 9417.591,
    "end_sec": 9419.351,
    "zh": "橙子皮急忙喊了一句",
    "vi": "Da cam vội vàng kêu lên"
  },
  {
    "idx": 5702,
    "start": "02:36:59,351",
    "end": "02:37:01,311",
    "start_sec": 9419.351,
    "end_sec": 9421.311,
    "zh": "毕竟眼下能出隧道的办法",
    "vi": "Rốt cuộc, cách duy nhất để ra khỏi đường hầm"
  },
  {
    "idx": 5703,
    "start": "02:37:01,311",
    "end": "02:37:02,591",
    "start_sec": 9421.311,
    "end_sec": 9422.591,
    "zh": "似乎只有你可以成功",
    "vi": "Có vẻ như chỉ có bạn mới làm được"
  },
  {
    "idx": 5704,
    "start": "02:37:02,591",
    "end": "02:37:04,031",
    "start_sec": 9422.591,
    "end_sec": 9424.031,
    "zh": "然而橙子皮越喊",
    "vi": "Thế nhưng Da cam càng gọi"
  },
  {
    "idx": 5705,
    "start": "02:37:04,031",
    "end": "02:37:05,891",
    "start_sec": 9424.031,
    "end_sec": 9425.891,
    "zh": "那女大学生跑得越紧",
    "vi": "Nữ sinh viên kia càng chạy nhanh hơn"
  },
  {
    "idx": 5706,
    "start": "02:37:05,891",
    "end": "02:37:07,771",
    "start_sec": 9425.891,
    "end_sec": 9427.771,
    "zh": "她似乎在有一甩单",
    "vi": "Cô ta dường như đang cố gắng"
  },
  {
    "idx": 5707,
    "start": "02:37:07,771",
    "end": "02:37:10,711",
    "start_sec": 9427.771,
    "end_sec": 9430.711,
    "zh": "想看女生就要跑出手电筒光照范围",
    "vi": "Chạy ra khỏi phạm vi chiếu sáng của đèn pin"
  },
  {
    "idx": 5708,
    "start": "02:37:10,711",
    "end": "02:37:12,171",
    "start_sec": 9430.711,
    "end_sec": 9432.171,
    "zh": "橙子皮也急了",
    "vi": "Da cam cũng sốt ruột"
  },
  {
    "idx": 5709,
    "start": "02:37:12,171",
    "end": "02:37:14,891",
    "start_sec": 9432.171,
    "end_sec": 9434.891,
    "zh": "好 小摸鸡去捉住她",
    "vi": "Được rồi, Tiểu Mạc Kê, mau bắt lấy cô ta"
  },
  {
    "idx": 5710,
    "start": "02:37:14,891",
    "end": "02:37:23,351",
    "start_sec": 9434.891,
    "end_sec": 9443.351,
    "zh": "你别 别咬我",
    "vi": "Đừng, đừng cắn tôi"
  },
  {
    "idx": 5711,
    "start": "02:37:23,351",
    "end": "02:37:25,891",
    "start_sec": 9443.351,
    "end_sec": 9445.891,
    "zh": "我,我只是太快了,别养我。",
    "vi": "Tôi, tôi chỉ hơi hoảng thôi, đừng cắn tôi."
  },
  {
    "idx": 5712,
    "start": "02:37:27,751",
    "end": "02:37:31,551",
    "start_sec": 9447.751,
    "end_sec": 9451.551,
    "zh": "哭成这样,难道真的只是太害怕,还是故意装作这样的?",
    "vi": "Khóc lóc như vậy, lẽ nào chỉ là quá sợ hãi, hay cố tình giả vờ như vậy"
  },
  {
    "idx": 5713,
    "start": "02:37:33,071",
    "end": "02:37:36,471",
    "start_sec": 9453.071,
    "end_sec": 9456.471,
    "zh": "你来过隧道两次,知道那怪物吃人的时候,暂时是安全的,知道在进隧道时,外系一根绳子。",
    "vi": "Bạn đã đến đường hầm hai lần, biết rằng quái vật ăn thịt người thì tạm thời"
  },
  {
    "idx": 5713,
    "start": "02:37:36,471",
    "end": "02:37:39,471",
    "start_sec": 9456.471,
    "end_sec": 9459.471,
    "zh": "你来过隧道两次,知道那怪物吃人的时候,暂时是安全的,知道在进隧道时,外系一根绳子。",
    "vi": "an toàn, biết rằng khi vào đường hầm thì buộc một sợi dây bên ngoài."
  },
  {
    "idx": 5714,
    "start": "02:37:40,051",
    "end": "02:37:43,019",
    "start_sec": 9460.051,
    "end_sec": 9463.019,
    "zh": "你有足够冷静的理由,却依旧表现得如此惶恐,我是不是可以理解为,你在演我?",
    "vi": "Bạn có đủ lý do để bình tĩnh, nhưng vẫn tỏ ra hoảng sợ như"
  },
  {
    "idx": 5714,
    "start": "02:37:43,019",
    "end": "02:37:45,591",
    "start_sec": 9463.019,
    "end_sec": 9465.591,
    "zh": "你有足够冷静的理由,却依旧表现得如此惶恐,我是不是可以理解为,你在演我?",
    "vi": "vậy, tôi có thể hiểu rằng bạn đang diễn kịch với tôi không?"
  },
  {
    "idx": 5715,
    "start": "02:37:46,191",
    "end": "02:37:50,811",
    "start_sec": 9466.191,
    "end_sec": 9470.811,
    "zh": "我真的是太害怕了,对不起,对不起五鸣,我只想着跑,对不起。",
    "vi": "Tôi thật sự rất sợ, xin lỗi, xin lỗi Ngũ Minh, tôi chỉ muốn chạy thôi, xin lỗi."
  },
  {
    "idx": 5716,
    "start": "02:37:50,811",
    "end": "02:37:52,371",
    "start_sec": 9470.811,
    "end_sec": 9472.371,
    "zh": "看着梨花带雨的模样",
    "vi": "Nhìn bộ dạng nước mắt lưng tròng"
  },
  {
    "idx": 5717,
    "start": "02:37:52,371",
    "end": "02:37:53,871",
    "start_sec": 9472.371,
    "end_sec": 9473.871,
    "zh": "橙子皮依着呼吁",
    "vi": "Da cam mềm lòng"
  },
  {
    "idx": 5718,
    "start": "02:37:53,871",
    "end": "02:37:54,451",
    "start_sec": 9473.871,
    "end_sec": 9474.451,
    "zh": "算了",
    "vi": "Thôi được"
  },
  {
    "idx": 5719,
    "start": "02:37:54,451",
    "end": "02:37:55,211",
    "start_sec": 9474.451,
    "end_sec": 9475.211,
    "zh": "你带我出去",
    "vi": "Dẫn tôi ra ngoài đi"
  },
  {
    "idx": 5720,
    "start": "02:37:55,211",
    "end": "02:37:56,431",
    "start_sec": 9475.211,
    "end_sec": 9476.431,
    "zh": "那鬼老头来了",
    "vi": "Ông lão kia đến rồi"
  },
  {
    "idx": 5721,
    "start": "02:37:56,431",
    "end": "02:37:57,571",
    "start_sec": 9476.431,
    "end_sec": 9477.571,
    "zh": "我保你无事",
    "vi": "Tôi đảm bảo bạn sẽ an toàn"
  },
  {
    "idx": 5722,
    "start": "02:37:57,571",
    "end": "02:37:59,471",
    "start_sec": 9477.571,
    "end_sec": 9479.471,
    "zh": "急速的奔跑",
    "vi": "Chạy thật nhanh"
  },
  {
    "idx": 5723,
    "start": "02:37:59,471",
    "end": "02:38:02,271",
    "start_sec": 9479.471,
    "end_sec": 9482.271,
    "zh": "眼前终于看见了隧道口的光亮",
    "vi": "Cuối cùng cũng nhìn thấy ánh sáng ở cửa hầm"
  },
  {
    "idx": 5724,
    "start": "02:38:02,271",
    "end": "02:38:02,771",
    "start_sec": 9482.271,
    "end_sec": 9482.771,
    "zh": "认出了",
    "vi": "Nhận ra"
  },
  {
    "idx": 5725,
    "start": "02:38:02,771",
    "end": "02:38:04,971",
    "start_sec": 9482.771,
    "end_sec": 9484.971,
    "zh": "总算是出来了",
    "vi": "Cuối cùng cũng ra ngoài rồi"
  },
  {
    "idx": 5726,
    "start": "02:38:04,971",
    "end": "02:38:06,871",
    "start_sec": 9484.971,
    "end_sec": 9486.871,
    "zh": "虽然在一个三十米的隧道里",
    "vi": "Mặc dù chỉ ở trong một đường hầm dài ba mươi mét"
  },
  {
    "idx": 5727,
    "start": "02:38:06,871",
    "end": "02:38:07,831",
    "start_sec": 9486.871,
    "end_sec": 9487.831,
    "zh": "待了一个下午",
    "vi": "Suốt cả buổi chiều"
  },
  {
    "idx": 5728,
    "start": "02:38:07,831",
    "end": "02:38:08,451",
    "start_sec": 9487.831,
    "end_sec": 9488.451,
    "zh": "果然",
    "vi": "Đúng vậy"
  },
  {
    "idx": 5729,
    "start": "02:38:08,451",
    "end": "02:38:09,531",
    "start_sec": 9488.451,
    "end_sec": 9489.531,
    "zh": "现在的情况",
    "vi": "Tình hình hiện tại"
  },
  {
    "idx": 5730,
    "start": "02:38:09,531",
    "end": "02:38:11,351",
    "start_sec": 9489.531,
    "end_sec": 9491.351,
    "zh": "就不存在一帆风顺这一说",
    "vi": "Không có chuyện gì suôn sẻ cả"
  },
  {
    "idx": 5731,
    "start": "02:38:11,351",
    "end": "02:38:12,311",
    "start_sec": 9491.351,
    "end_sec": 9492.311,
    "zh": "那个",
    "vi": "Này."
  },
  {
    "idx": 5732,
    "start": "02:38:12,311",
    "end": "02:38:13,631",
    "start_sec": 9492.311,
    "end_sec": 9493.631,
    "zh": "谢谢你带我出来",
    "vi": "Cảm ơn bạn đã đưa tôi ra ngoài."
  },
  {
    "idx": 5733,
    "start": "02:38:13,631",
    "end": "02:38:14,691",
    "start_sec": 9493.631,
    "end_sec": 9494.691,
    "zh": "我叫罗千千",
    "vi": "Tôi tên là La Thiên Thiên."
  },
  {
    "idx": 5734,
    "start": "02:38:14,691",
    "end": "02:38:15,231",
    "start_sec": 9494.691,
    "end_sec": 9495.231,
    "zh": "先生",
    "vi": "Này bạn."
  },
  {
    "idx": 5735,
    "start": "02:38:15,231",
    "end": "02:38:15,691",
    "start_sec": 9495.231,
    "end_sec": 9495.691,
    "zh": "你",
    "vi": "Bạn."
  },
  {
    "idx": 5736,
    "start": "02:38:15,691",
    "end": "02:38:16,851",
    "start_sec": 9495.691,
    "end_sec": 9496.851,
    "zh": "罗千千",
    "vi": "La Thiên Thiên."
  },
  {
    "idx": 5737,
    "start": "02:38:16,851",
    "end": "02:38:18,151",
    "start_sec": 9496.851,
    "end_sec": 9498.151,
    "zh": "听到这个名字",
    "vi": "Nghe thấy cái tên này."
  },
  {
    "idx": 5738,
    "start": "02:38:18,151",
    "end": "02:38:20,351",
    "start_sec": 9498.151,
    "end_sec": 9500.351,
    "zh": "橙子皮莫名想到小区里的罗千",
    "vi": "Trần Tử Bình bỗng nhiên nghĩ đến La Thiên ở khu chung cư."
  },
  {
    "idx": 5739,
    "start": "02:38:20,351",
    "end": "02:38:21,491",
    "start_sec": 9500.351,
    "end_sec": 9501.491,
    "zh": "我叫陈子平",
    "vi": "Tôi tên là Trần Tử Bình."
  },
  {
    "idx": 5740,
    "start": "02:38:21,491",
    "end": "02:38:22,791",
    "start_sec": 9501.491,
    "end_sec": 9502.791,
    "zh": "陈 陈先生",
    "vi": "Trần, Anh Trần."
  },
  {
    "idx": 5741,
    "start": "02:38:22,791",
    "end": "02:38:24,331",
    "start_sec": 9502.791,
    "end_sec": 9504.331,
    "zh": "你看天色都黑了",
    "vi": "Bạn xem trời tối rồi."
  },
  {
    "idx": 5742,
    "start": "02:38:24,331",
    "end": "02:38:26,251",
    "start_sec": 9504.331,
    "end_sec": 9506.251,
    "zh": "这些道附近也没什么休息地",
    "vi": "Xung quanh con đường này cũng không có chỗ nghỉ ngơi."
  },
  {
    "idx": 5743,
    "start": "02:38:26,251",
    "end": "02:38:28,151",
    "start_sec": 9506.251,
    "end_sec": 9508.151,
    "zh": "你要不要和我一起回加油站",
    "vi": "Bạn có muốn cùng tôi quay lại trạm xăng không."
  },
  {
    "idx": 5744,
    "start": "02:38:28,151",
    "end": "02:38:31,831",
    "start_sec": 9508.151,
    "end_sec": 9511.831,
    "zh": "首先 加油站不是你们",
    "vi": "Thứ nhất, trạm xăng không phải của các bạn."
  },
  {
    "idx": 5745,
    "start": "02:38:31,831",
    "end": "02:38:34,151",
    "start_sec": 9511.831,
    "end_sec": 9514.151,
    "zh": "其次 我一个人习惯了",
    "vi": "Thứ hai, tôi quen đi một mình rồi."
  },
  {
    "idx": 5746,
    "start": "02:38:34,151",
    "end": "02:38:35,391",
    "start_sec": 9514.151,
    "end_sec": 9515.391,
    "zh": "加油站我会去",
    "vi": "Tôi sẽ đến trạm xăng."
  },
  {
    "idx": 5747,
    "start": "02:38:35,391",
    "end": "02:38:36,811",
    "start_sec": 9515.391,
    "end_sec": 9516.811,
    "zh": "不过不是和你们一起",
    "vi": "Nhưng không phải đi cùng các bạn."
  },
  {
    "idx": 5748,
    "start": "02:38:36,811",
    "end": "02:38:45,991",
    "start_sec": 9516.811,
    "end_sec": 9525.991,
    "zh": "倩倩 你怎么和他回来了",
    "vi": "Thiên Thiên, sao bạn lại về cùng anh ta thế."
  },
  {
    "idx": 5749,
    "start": "02:38:45,991",
    "end": "02:38:47,031",
    "start_sec": 9525.991,
    "end_sec": 9527.031,
    "zh": "五鸣呢",
    "vi": "Ngô Minh đâu rồi."
  },
  {
    "idx": 5750,
    "start": "02:38:47,031",
    "end": "02:38:48,751",
    "start_sec": 9527.031,
    "end_sec": 9528.751,
    "zh": "五鸣 五鸣",
    "vi": "Ngô Minh, Ngô Minh."
  },
  {
    "idx": 5751,
    "start": "02:38:48,751",
    "end": "02:38:53,811",
    "start_sec": 9528.751,
    "end_sec": 9533.811,
    "zh": "倩倩",
    "vi": "Thiên Thiên."
  },
  {
    "idx": 5752,
    "start": "02:38:53,811",
    "end": "02:38:54,791",
    "start_sec": 9533.811,
    "end_sec": 9534.791,
    "zh": "我也没想到",
    "vi": "Tôi cũng không ngờ."
  },
  {
    "idx": 5753,
    "start": "02:38:54,791",
    "end": "02:38:56,351",
    "start_sec": 9534.791,
    "end_sec": 9536.351,
    "zh": "你为了去提醒那家伙",
    "vi": "Bạn vì đi cảnh báo cho tên đó."
  },
  {
    "idx": 5754,
    "start": "02:38:56,351",
    "end": "02:38:58,311",
    "start_sec": 9536.351,
    "end_sec": 9538.311,
    "zh": "居然还把五名搭进去了",
    "vi": "Mà lại hại luôn cả Ngô Minh."
  },
  {
    "idx": 5755,
    "start": "02:38:58,311",
    "end": "02:39:00,551",
    "start_sec": 9538.311,
    "end_sec": 9540.551,
    "zh": "倩倩",
    "vi": "Thiên Thiên."
  },
  {
    "idx": 5756,
    "start": "02:39:00,551",
    "end": "02:39:01,191",
    "start_sec": 9540.551,
    "end_sec": 9541.191,
    "zh": "别挨",
    "vi": "Đừng chạm vào."
  },
  {
    "idx": 5757,
    "start": "02:39:01,191",
    "end": "02:39:02,311",
    "start_sec": 9541.191,
    "end_sec": 9542.311,
    "zh": "我藏",
    "vi": "Tôi bẩn."
  },
  {
    "idx": 5758,
    "start": "02:39:02,311",
    "end": "02:39:03,891",
    "start_sec": 9542.311,
    "end_sec": 9543.891,
    "zh": "妥妥的心机表啊",
    "vi": "Đúng là một kẻ mưu mô."
  },
  {
    "idx": 5759,
    "start": "02:39:03,891",
    "end": "02:39:05,231",
    "start_sec": 9543.891,
    "end_sec": 9545.231,
    "zh": "什么叫你不能给我提醒",
    "vi": "Cái gì mà bạn không thể cảnh báo cho tôi."
  },
  {
    "idx": 5760,
    "start": "02:39:05,231",
    "end": "02:39:07,831",
    "start_sec": 9545.231,
    "end_sec": 9547.831,
    "zh": "我倒成了你假仁假义的借口了",
    "vi": "Tôi lại trở thành cái cớ cho sự giả nhân giả nghĩa của bạn rồi."
  },
  {
    "idx": 5761,
    "start": "02:39:07,831",
    "end": "02:39:09,991",
    "start_sec": 9547.831,
    "end_sec": 9549.991,
    "zh": "长子皮并未点破什么",
    "vi": "Trương Tử Bì không vạch trần điều gì."
  },
  {
    "idx": 5762,
    "start": "02:39:09,991",
    "end": "02:39:11,731",
    "start_sec": 9549.991,
    "end_sec": 9551.731,
    "zh": "给小莫记为了跟活腿后",
    "vi": "Đưa cho Tiểu Mạc vài cây xúc xích."
  },
  {
    "idx": 5763,
    "start": "02:39:11,731",
    "end": "02:39:12,731",
    "start_sec": 9551.731,
    "end_sec": 9552.731,
    "zh": "自己喷几年包",
    "vi": "Tự mình ăn vài miếng bánh mì."
  },
  {
    "idx": 5764,
    "start": "02:39:12,731",
    "end": "02:39:15,131",
    "start_sec": 9552.731,
    "end_sec": 9555.131,
    "zh": "喂 哥们",
    "vi": "Này người anh em."
  },
  {
    "idx": 5765,
    "start": "02:39:15,131",
    "end": "02:39:15,811",
    "start_sec": 9555.131,
    "end_sec": 9555.811,
    "zh": "认识一下",
    "vi": "Làm quen chút đi."
  },
  {
    "idx": 5766,
    "start": "02:39:15,811",
    "end": "02:39:16,651",
    "start_sec": 9555.811,
    "end_sec": 9556.651,
    "zh": "我是徐东来",
    "vi": "Tôi là Từ Đông Lai."
  },
  {
    "idx": 5767,
    "start": "02:39:16,651",
    "end": "02:39:17,151",
    "start_sec": 9556.651,
    "end_sec": 9557.151,
    "zh": "哥们",
    "vi": "Này người anh em."
  },
  {
    "idx": 5768,
    "start": "02:39:17,151",
    "end": "02:39:18,611",
    "start_sec": 9557.151,
    "end_sec": 9558.611,
    "zh": "你接下来有什么打算",
    "vi": "Tiếp theo bạn có dự định gì không."
  },
  {
    "idx": 5769,
    "start": "02:39:18,611",
    "end": "02:39:19,451",
    "start_sec": 9558.611,
    "end_sec": 9559.451,
    "zh": "打算",
    "vi": "Dự định sao."
  },
  {
    "idx": 5770,
    "start": "02:39:19,451",
    "end": "02:39:20,491",
    "start_sec": 9559.451,
    "end_sec": 9560.491,
    "zh": "暂时没有",
    "vi": "Tạm thời chưa có."
  },
  {
    "idx": 5771,
    "start": "02:39:20,491",
    "end": "02:39:22,011",
    "start_sec": 9560.491,
    "end_sec": 9562.011,
    "zh": "哥们要不这样",
    "vi": "Hay là thế này đi người anh em."
  },
  {
    "idx": 5772,
    "start": "02:39:22,011",
    "end": "02:39:23,031",
    "start_sec": 9562.011,
    "end_sec": 9563.031,
    "zh": "你加入我们",
    "vi": "Bạn gia nhập với chúng tôi đi."
  },
  {
    "idx": 5773,
    "start": "02:39:23,031",
    "end": "02:39:25,311",
    "start_sec": 9563.031,
    "end_sec": 9565.311,
    "zh": "我们到时候再试试穿越深山隧道",
    "vi": "Đến lúc đó chúng ta sẽ thử băng qua đường hầm trong núi sâu."
  },
  {
    "idx": 5774,
    "start": "02:39:25,311",
    "end": "02:39:25,871",
    "start_sec": 9565.311,
    "end_sec": 9565.871,
    "zh": "如何",
    "vi": "Thấy sao."
  },
  {
    "idx": 5775,
    "start": "02:39:25,871",
    "end": "02:39:29,391",
    "start_sec": 9565.871,
    "end_sec": 9569.391,
    "zh": "你们不怕死的吗",
    "vi": "Các người không sợ chết sao."
  },
  {
    "idx": 5776,
    "start": "02:39:29,391",
    "end": "02:39:30,071",
    "start_sec": 9569.391,
    "end_sec": 9570.071,
    "zh": "怕啊",
    "vi": "Sợ chứ."
  },
  {
    "idx": 5777,
    "start": "02:39:30,071",
    "end": "02:39:31,211",
    "start_sec": 9570.071,
    "end_sec": 9571.211,
    "zh": "怕也要试试啊",
    "vi": "Nhưng sợ thì vẫn phải thử thôi."
  },
  {
    "idx": 5778,
    "start": "02:39:31,211",
    "end": "02:39:34,011",
    "start_sec": 9571.211,
    "end_sec": 9574.011,
    "zh": "能离开临江市的最优路线就在眼前",
    "vi": "Tuyến đường tốt nhất để rời khỏi thành phố Lâm Giang đã ở ngay trước mắt."
  },
  {
    "idx": 5779,
    "start": "02:39:34,011",
    "end": "02:39:36,051",
    "start_sec": 9574.011,
    "end_sec": 9576.051,
    "zh": "我们总不至于不去尝试吧",
    "vi": "Chúng ta không thể không thử một lần đúng không."
  },
  {
    "idx": 5780,
    "start": "02:39:36,051",
    "end": "02:39:37,551",
    "start_sec": 9576.051,
    "end_sec": 9577.551,
    "zh": "你也要离开临江市",
    "vi": "Bạn cũng muốn rời khỏi thành phố Lâm Giang sao."
  },
  {
    "idx": 5781,
    "start": "02:39:37,551",
    "end": "02:39:39,971",
    "start_sec": 9577.551,
    "end_sec": 9579.971,
    "zh": "你怎么知道深山隧道是最优路线",
    "vi": "Sao bạn biết đường hầm trong núi sâu là tuyến đường tốt nhất."
  },
  {
    "idx": 5782,
    "start": "02:39:39,971",
    "end": "02:39:40,951",
    "start_sec": 9579.971,
    "end_sec": 9580.951,
    "zh": "不瞒你说",
    "vi": "Không giấu gì bạn."
  },
  {
    "idx": 5783,
    "start": "02:39:40,951",
    "end": "02:39:43,011",
    "start_sec": 9580.951,
    "end_sec": 9583.011,
    "zh": "我是临江大学的学生会会长",
    "vi": "Tôi là chủ tịch hội sinh viên của Đại học Lâm Giang."
  },
  {
    "idx": 5784,
    "start": "02:39:43,011",
    "end": "02:39:44,111",
    "start_sec": 9583.011,
    "end_sec": 9584.111,
    "zh": "我爸是校长",
    "vi": "Bố tôi là hiệu trưởng."
  },
  {
    "idx": 5785,
    "start": "02:39:44,111",
    "end": "02:39:45,831",
    "start_sec": 9584.111,
    "end_sec": 9585.831,
    "zh": "多少知道一点内部消息",
    "vi": "Nên tôi cũng biết được một chút thông tin nội bộ."
  },
  {
    "idx": 5786,
    "start": "02:39:45,831",
    "end": "02:39:48,071",
    "start_sec": 9585.831,
    "end_sec": 9588.071,
    "zh": "他说在隔壁望海市有安全地",
    "vi": "Ông ấy nói ở thành phố Vọng Hải bên cạnh có khu vực an toàn."
  },
  {
    "idx": 5787,
    "start": "02:39:48,071",
    "end": "02:39:49,891",
    "start_sec": 9588.071,
    "end_sec": 9589.891,
    "zh": "让我想办法离开临江市",
    "vi": "Bảo tôi nghĩ cách rời khỏi thành phố Lâm Giang."
  },
  {
    "idx": 5788,
    "start": "02:39:49,891",
    "end": "02:39:51,591",
    "start_sec": 9589.891,
    "end_sec": 9591.591,
    "zh": "到时候派车来接我",
    "vi": "Đến lúc đó sẽ cử xe đến đón tôi."
  },
  {
    "idx": 5789,
    "start": "02:39:51,591",
    "end": "02:39:52,391",
    "start_sec": 9591.591,
    "end_sec": 9592.391,
    "zh": "汪海市",
    "vi": "Thành phố Vọng Hải sao."
  },
  {
    "idx": 5790,
    "start": "02:39:52,391",
    "end": "02:39:53,891",
    "start_sec": 9592.391,
    "end_sec": 9593.891,
    "zh": "看来周扬家里",
    "vi": "Xem ra gia đình Chu Dương."
  },
  {
    "idx": 5791,
    "start": "02:39:53,891",
    "end": "02:39:55,891",
    "start_sec": 9593.891,
    "end_sec": 9595.891,
    "zh": "应该要一个大学校长的能量大不少",
    "vi": "Năng lượng của một hiệu trưởng đại học lớn hơn nhiều."
  },
  {
    "idx": 5792,
    "start": "02:39:55,891",
    "end": "02:39:56,871",
    "start_sec": 9595.891,
    "end_sec": 9596.871,
    "zh": "他给我的消息",
    "vi": "Tin tức anh ta đưa cho tôi."
  },
  {
    "idx": 5793,
    "start": "02:39:56,871",
    "end": "02:39:58,871",
    "start_sec": 9596.871,
    "end_sec": 9598.871,
    "zh": "可是直接乘坐邮轮直奔京市",
    "vi": "Có thể đi thẳng tàu du lịch đến thành phố Kinh."
  },
  {
    "idx": 5794,
    "start": "02:39:58,871",
    "end": "02:39:59,491",
    "start_sec": 9598.871,
    "end_sec": 9599.491,
    "zh": "哥们",
    "vi": "Này anh bạn."
  },
  {
    "idx": 5795,
    "start": "02:40:00,160",
    "end": "02:40:02,742",
    "start_sec": 9600.16,
    "end_sec": 9602.742,
    "zh": "加入我们,一旦跑出隧道,跨过南城和大桥,我保证带你去安全点。",
    "vi": "Gia nhập với chúng tôi đi, một khi thoát khỏi đường hầm, băng qua"
  },
  {
    "idx": 5795,
    "start": "02:40:02,742",
    "end": "02:40:05,140",
    "start_sec": 9602.742,
    "end_sec": 9605.14,
    "zh": "加入我们,一旦跑出隧道,跨过南城和大桥,我保证带你去安全点。",
    "vi": "cầu Nam Thành, tôi đảm bảo sẽ đưa bạn đến nơi an toàn."
  },
  {
    "idx": 5796,
    "start": "02:40:05,860",
    "end": "02:40:08,180",
    "start_sec": 9605.86,
    "end_sec": 9608.18,
    "zh": "抱歉,我暂时没打算组团送死。",
    "vi": "Xin lỗi, tôi tạm thời không có ý định lập nhóm đi chịu chết."
  },
  {
    "idx": 5797,
    "start": "02:40:10,880",
    "end": "02:40:12,520",
    "start_sec": 9610.88,
    "end_sec": 9612.52,
    "zh": "你,你这是什么态度?",
    "vi": "Anh, anh có thái độ gì thế hả."
  },
  {
    "idx": 5798,
    "start": "02:40:13,080",
    "end": "02:40:16,960",
    "start_sec": 9613.08,
    "end_sec": 9616.96,
    "zh": "东来哥亲自拉你入伙,而且为了提醒你,五名都死了。",
    "vi": "Anh Đông Lai đích thân mời anh gia nhập, hơn nữa còn vì nhắc nhở anh mà năm người đã chết rồi."
  },
  {
    "idx": 5799,
    "start": "02:40:17,400",
    "end": "02:40:19,720",
    "start_sec": 9617.4,
    "end_sec": 9619.72,
    "zh": "你这人,怎么一点感恩的心都没有?",
    "vi": "Con người anh sao lại không có chút lòng biết ơn nào vậy."
  },
  {
    "idx": 5800,
    "start": "02:40:21,580",
    "end": "02:40:26,520",
    "start_sec": 9621.58,
    "end_sec": 9626.52,
    "zh": "艾森南,这位兄弟有自己的想法,既然他不想加入,你也不能强求。",
    "vi": "A Sâm Nam, người anh em này có suy nghĩ riêng, nếu cậu ấy không muốn gia nhập thì anh cũng đừng ép buộc."
  },
  {
    "idx": 5801,
    "start": "02:40:30,000",
    "end": "02:40:32,759",
    "start_sec": 9630.0,
    "end_sec": 9632.759,
    "zh": "兄弟,最后问你一次,过些天我们都会尝试去深山隧道,你真的不加入我们?",
    "vi": "Người anh em, hỏi cậu lần cuối, vài ngày nữa chúng tôi sẽ thử"
  },
  {
    "idx": 5801,
    "start": "02:40:32,759",
    "end": "02:40:35,320",
    "start_sec": 9632.759,
    "end_sec": 9635.32,
    "zh": "兄弟,最后问你一次,过些天我们都会尝试去深山隧道,你真的不加入我们?",
    "vi": "đi vào đường hầm Thâm Sơn, cậu thực sự không gia nhập sao."
  },
  {
    "idx": 5802,
    "start": "02:40:35,820",
    "end": "02:40:39,240",
    "start_sec": 9635.82,
    "end_sec": 9639.24,
    "zh": "简徐东来还不死心的模样,床子皮已经懒得理会了。",
    "vi": "Thấy Từ Đông Lai vẫn chưa từ bỏ ý định, Chu Tử Bì đã lười quan tâm."
  },
  {
    "idx": 5803,
    "start": "02:40:40,000",
    "end": "02:40:44,740",
    "start_sec": 9640.0,
    "end_sec": 9644.74,
    "zh": "隧道里的规律,我大致已经了解,现在再去闯一次,根本没有太大效益。",
    "vi": "Quy luật trong đường hầm tôi đã nắm rõ, giờ có xông vào lần nữa cũng chẳng có lợi ích gì."
  },
  {
    "idx": 5804,
    "start": "02:40:46,520",
    "end": "02:40:49,245",
    "start_sec": 9646.52,
    "end_sec": 9649.245,
    "zh": "想要赶上三天后,刚好途径这里的邮轮,必须在明天就走出深山隧道。",
    "vi": "Muốn kịp chuyến tàu du lịch đi ngang qua đây sau ba ngày nữa,"
  },
  {
    "idx": 5804,
    "start": "02:40:49,245",
    "end": "02:40:51,580",
    "start_sec": 9649.245,
    "end_sec": 9651.58,
    "zh": "想要赶上三天后,刚好途径这里的邮轮,必须在明天就走出深山隧道。",
    "vi": "bắt buộc phải ra khỏi đường hầm Thâm Sơn vào ngày mai."
  },
  {
    "idx": 5805,
    "start": "02:40:52,500",
    "end": "02:40:55,554",
    "start_sec": 9652.5,
    "end_sec": 9655.554,
    "zh": "下午在隧道时,遇到一处石堆,像是他帮导致的,会不会与隧道里的诡异有关系呢?",
    "vi": "Chiều nay ở trong hầm gặp một đống đá, trông như do bang phái gây"
  },
  {
    "idx": 5805,
    "start": "02:40:55,554",
    "end": "02:40:58,200",
    "start_sec": 9655.554,
    "end_sec": 9658.2,
    "zh": "下午在隧道时,遇到一处石堆,像是他帮导致的,会不会与隧道里的诡异有关系呢?",
    "vi": "ra, liệu có liên quan đến điều kỳ quái trong hầm không nhỉ."
  },
  {
    "idx": 5806,
    "start": "02:40:58,200",
    "end": "02:41:00,620",
    "start_sec": 9658.2,
    "end_sec": 9660.62,
    "zh": "喂 干嘛",
    "vi": "Alo, làm gì đấy."
  },
  {
    "idx": 5807,
    "start": "02:41:00,620",
    "end": "02:41:01,740",
    "start_sec": 9660.62,
    "end_sec": 9661.74,
    "zh": "我这边不方便",
    "vi": "Tôi đang không tiện."
  },
  {
    "idx": 5808,
    "start": "02:41:01,740",
    "end": "02:41:04,680",
    "start_sec": 9661.74,
    "end_sec": 9664.68,
    "zh": "你能查到关于前山路深山隧道的资料吗",
    "vi": "Bạn có thể tra cứu thông tin về đường hầm Thâm Sơn ở đường Tiền Sơn không."
  },
  {
    "idx": 5809,
    "start": "02:41:04,680",
    "end": "02:41:06,420",
    "start_sec": 9664.68,
    "end_sec": 9666.42,
    "zh": "深山隧道 怎么了",
    "vi": "Đường hầm Thâm Sơn, sao thế."
  },
  {
    "idx": 5810,
    "start": "02:41:06,420",
    "end": "02:41:08,660",
    "start_sec": 9666.42,
    "end_sec": 9668.66,
    "zh": "遇到点暂时不能解决的麻烦",
    "vi": "Gặp chút rắc rối tạm thời chưa giải quyết được."
  },
  {
    "idx": 5811,
    "start": "02:41:08,660",
    "end": "02:41:09,680",
    "start_sec": 9668.66,
    "end_sec": 9669.68,
    "zh": "你去搜一下资料",
    "vi": "Bạn đi tìm tài liệu đi."
  },
  {
    "idx": 5812,
    "start": "02:41:09,680",
    "end": "02:41:11,300",
    "start_sec": 9669.68,
    "end_sec": 9671.3,
    "zh": "好 我这个桌去看看",
    "vi": "Được, tôi sẽ đến đó xem sao."
  },
  {
    "idx": 5813,
    "start": "02:41:11,300",
    "end": "02:41:12,980",
    "start_sec": 9671.3,
    "end_sec": 9672.98,
    "zh": "别别别 你别去",
    "vi": "Đừng đừng đừng, bạn đừng đi."
  },
  {
    "idx": 5814,
    "start": "02:41:12,980",
    "end": "02:41:15,000",
    "start_sec": 9672.98,
    "end_sec": 9675.0,
    "zh": "我推测隧道有他帮砸死了人",
    "vi": "Tôi suy đoán trong hầm có bang phái đã giết người."
  },
  {
    "idx": 5815,
    "start": "02:41:15,000",
    "end": "02:41:16,800",
    "start_sec": 9675.0,
    "end_sec": 9676.8,
    "zh": "但是不知道什么时候探查",
    "vi": "Nhưng không biết khi nào thì nên đi thám thính."
  },
  {
    "idx": 5816,
    "start": "02:41:16,800",
    "end": "02:41:18,300",
    "start_sec": 9676.8,
    "end_sec": 9678.3,
    "zh": "不怕你过去有什么危险",
    "vi": "Sợ bạn qua đó sẽ gặp nguy hiểm."
  },
  {
    "idx": 5817,
    "start": "02:41:18,300",
    "end": "02:41:19,880",
    "start_sec": 9678.3,
    "end_sec": 9679.88,
    "zh": "不怕一万就怕万一",
    "vi": "Cẩn thận vẫn hơn."
  },
  {
    "idx": 5818,
    "start": "02:41:19,880",
    "end": "02:41:22,620",
    "start_sec": 9679.88,
    "end_sec": 9682.62,
    "zh": "这样的话就只能单独查查资料",
    "vi": "Nếu vậy thì chỉ có thể tự mình tra cứu tài liệu thôi."
  },
  {
    "idx": 5819,
    "start": "02:41:22,620",
    "end": "02:41:24,360",
    "start_sec": 9682.62,
    "end_sec": 9684.36,
    "zh": "嗯 实在不行",
    "vi": "Ừ, nếu không được nữa."
  },
  {
    "idx": 5820,
    "start": "02:41:24,360",
    "end": "02:41:26,100",
    "start_sec": 9684.36,
    "end_sec": 9686.1,
    "zh": "找找论坛消息的什么也好",
    "vi": "Thì tìm kiếm tin tức trên diễn đàn cũng được."
  },
  {
    "idx": 5821,
    "start": "02:41:26,100",
    "end": "02:41:28,000",
    "start_sec": 9686.1,
    "end_sec": 9688.0,
    "zh": "之所以让我去探自己",
    "vi": "Sở dĩ anh ta bảo tôi tự mình đi tra cứu"
  },
  {
    "idx": 5822,
    "start": "02:41:28,000",
    "end": "02:41:29,680",
    "start_sec": 9688.0,
    "end_sec": 9689.68,
    "zh": "查有关深山隧道的信息",
    "vi": "thông tin về đường hầm Thâm Sơn"
  },
  {
    "idx": 5823,
    "start": "02:41:29,680",
    "end": "02:41:32,000",
    "start_sec": 9689.68,
    "end_sec": 9692.0,
    "zh": "是因为橙子皮已经尝试搜索过",
    "vi": "là vì Cam Tử Bì đã thử tìm kiếm trước đó rồi."
  },
  {
    "idx": 5824,
    "start": "02:41:32,000",
    "end": "02:41:33,420",
    "start_sec": 9692.0,
    "end_sec": 9693.42,
    "zh": "自从鬼一降临后",
    "vi": "Kể từ khi Quỷ Nhất xuất hiện"
  },
  {
    "idx": 5825,
    "start": "02:41:33,420",
    "end": "02:41:35,900",
    "start_sec": 9693.42,
    "end_sec": 9695.9,
    "zh": "绝大多数信息网站都变成404",
    "vi": "hầu hết các trang web thông tin đều bị lỗi 404"
  },
  {
    "idx": 5826,
    "start": "02:41:35,900",
    "end": "02:41:36,480",
    "start_sec": 9695.9,
    "end_sec": 9696.48,
    "zh": "Not Found",
    "vi": "Không tìm thấy trang."
  },
  {
    "idx": 5827,
    "start": "02:41:36,480",
    "end": "02:41:38,740",
    "start_sec": 9696.48,
    "end_sec": 9698.74,
    "zh": "不知不觉间",
    "vi": "Không biết từ lúc nào"
  },
  {
    "idx": 5828,
    "start": "02:41:38,740",
    "end": "02:41:39,540",
    "start_sec": 9698.74,
    "end_sec": 9699.54,
    "zh": "血液升级",
    "vi": "dòng máu đã được nâng cấp."
  },
  {
    "idx": 5829,
    "start": "02:41:39,540",
    "end": "02:41:41,400",
    "start_sec": 9699.54,
    "end_sec": 9701.4,
    "zh": "加油站里被月子染的血",
    "vi": "Vết máu của Nguyệt Tử ở trạm xăng"
  },
  {
    "idx": 5830,
    "start": "02:41:41,400",
    "end": "02:41:42,840",
    "start_sec": 9701.4,
    "end_sec": 9702.84,
    "zh": "那四名大学生",
    "vi": "bốn sinh viên đại học đó"
  },
  {
    "idx": 5831,
    "start": "02:41:42,840",
    "end": "02:41:44,640",
    "start_sec": 9702.84,
    "end_sec": 9704.64,
    "zh": "频急向橙子皮扫射了",
    "vi": "đã liên tục bắn về phía Cam Tử Bì."
  },
  {
    "idx": 5832,
    "start": "02:41:44,640",
    "end": "02:41:47,460",
    "start_sec": 9704.64,
    "end_sec": 9707.46,
    "zh": "而橙子皮只是必然等待着消息",
    "vi": "Nhưng Cam Tử Bì chỉ kiên nhẫn chờ đợi tin tức."
  },
  {
    "idx": 5833,
    "start": "02:41:47,460",
    "end": "02:41:49,000",
    "start_sec": 9707.46,
    "end_sec": 9709.0,
    "zh": "我找到了",
    "vi": "Tôi tìm thấy rồi."
  },
  {
    "idx": 5834,
    "start": "02:41:49,000",
    "end": "02:41:49,980",
    "start_sec": 9709.0,
    "end_sec": 9709.98,
    "zh": "在正规途径",
    "vi": "Nếu tìm theo cách thông thường"
  },
  {
    "idx": 5835,
    "start": "02:41:49,980",
    "end": "02:41:51,320",
    "start_sec": 9709.98,
    "end_sec": 9711.32,
    "zh": "我是一点东西没查到",
    "vi": "thì tôi chẳng tra được gì cả."
  },
  {
    "idx": 5836,
    "start": "02:41:51,320",
    "end": "02:41:52,480",
    "start_sec": 9711.32,
    "end_sec": 9712.48,
    "zh": "但是找了几个问台",
    "vi": "Nhưng sau khi tìm trên vài diễn đàn"
  },
  {
    "idx": 5837,
    "start": "02:41:52,480",
    "end": "02:41:54,520",
    "start_sec": 9712.48,
    "end_sec": 9714.52,
    "zh": "还真给我找到了点有用的东西",
    "vi": "tôi thực sự đã tìm được một số thông tin hữu ích."
  },
  {
    "idx": 5838,
    "start": "02:41:54,520",
    "end": "02:41:55,140",
    "start_sec": 9714.52,
    "end_sec": 9715.14,
    "zh": "什么",
    "vi": "Thông tin gì thế."
  },
  {
    "idx": 5839,
    "start": "02:41:55,140",
    "end": "02:41:56,580",
    "start_sec": 9715.14,
    "end_sec": 9716.58,
    "zh": "求生问台上",
    "vi": "Trên diễn đàn sinh tồn"
  },
  {
    "idx": 5840,
    "start": "02:41:56,580",
    "end": "02:41:57,880",
    "start_sec": 9716.58,
    "end_sec": 9717.88,
    "zh": "有个叫声香人的",
    "vi": "có một người tên là Thanh Hương Nhân"
  },
  {
    "idx": 5841,
    "start": "02:41:57,880",
    "end": "02:41:58,960",
    "start_sec": 9717.88,
    "end_sec": 9718.96,
    "zh": "发了个帖子",
    "vi": "đã đăng một bài viết"
  },
  {
    "idx": 5842,
    "start": "02:41:58,960",
    "end": "02:42:00,040",
    "start_sec": 9718.96,
    "end_sec": 9720.04,
    "zh": "略取了深山隧道",
    "vi": "nói sơ qua về đường hầm Thâm Sơn"
  },
  {
    "idx": 5843,
    "start": "02:42:00,040",
    "end": "02:42:02,400",
    "start_sec": 9720.04,
    "end_sec": 9722.4,
    "zh": "以及南城和大桥的劣质施工问题",
    "vi": "và vấn đề thi công kém chất lượng của cầu Nam Thành."
  },
  {
    "idx": 5844,
    "start": "02:42:02,400",
    "end": "02:42:03,680",
    "start_sec": 9722.4,
    "end_sec": 9723.68,
    "zh": "帖子的主人还说",
    "vi": "Chủ bài viết còn nói"
  },
  {
    "idx": 5845,
    "start": "02:42:03,680",
    "end": "02:42:05,140",
    "start_sec": 9723.68,
    "end_sec": 9725.14,
    "zh": "在修建隧道的过程中",
    "vi": "trong quá trình xây dựng đường hầm"
  },
  {
    "idx": 5846,
    "start": "02:42:05,140",
    "end": "02:42:06,500",
    "start_sec": 9725.14,
    "end_sec": 9726.5,
    "zh": "因为劣质工程塌方",
    "vi": "do công trình kém chất lượng bị sập"
  },
  {
    "idx": 5847,
    "start": "02:42:06,500",
    "end": "02:42:07,740",
    "start_sec": 9726.5,
    "end_sec": 9727.74,
    "zh": "就死过不少人",
    "vi": "nên đã có rất nhiều người chết."
  },
  {
    "idx": 5848,
    "start": "02:42:07,740",
    "end": "02:42:08,720",
    "start_sec": 9727.74,
    "end_sec": 9728.72,
    "zh": "项目竣工后",
    "vi": "Sau khi dự án hoàn thành"
  },
  {
    "idx": 5849,
    "start": "02:42:08,720",
    "end": "02:42:10,140",
    "start_sec": 9728.72,
    "end_sec": 9730.14,
    "zh": "他就一直给死去的人",
    "vi": "anh ta vẫn luôn thắp hương bái tế"
  },
  {
    "idx": 5850,
    "start": "02:42:10,140",
    "end": "02:42:11,620",
    "start_sec": 9730.14,
    "end_sec": 9731.62,
    "zh": "在隧道里烧香请拜",
    "vi": "cho những người đã khuất ở trong đường hầm."
  },
  {
    "idx": 5851,
    "start": "02:42:11,620",
    "end": "02:42:12,460",
    "start_sec": 9731.62,
    "end_sec": 9732.46,
    "zh": "对他说",
    "vi": "Nói với anh ta rằng"
  },
  {
    "idx": 5852,
    "start": "02:42:12,460",
    "end": "02:42:13,700",
    "start_sec": 9732.46,
    "end_sec": 9733.7,
    "zh": "人吃饭鬼吃香",
    "vi": "người ăn thì no, ma ăn thì thơm"
  },
  {
    "idx": 5853,
    "start": "02:42:13,700",
    "end": "02:42:14,920",
    "start_sec": 9733.7,
    "end_sec": 9734.92,
    "zh": "等鬼吃饱了",
    "vi": "Chờ ma ăn no rồi"
  },
  {
    "idx": 5854,
    "start": "02:42:14,920",
    "end": "02:42:15,780",
    "start_sec": 9734.92,
    "end_sec": 9735.78,
    "zh": "怨气散了",
    "vi": "hết oán khí"
  },
  {
    "idx": 5855,
    "start": "02:42:15,780",
    "end": "02:42:17,380",
    "start_sec": 9735.78,
    "end_sec": 9737.38,
    "zh": "就能向他们提出一个要求",
    "vi": "thì có thể đưa ra một yêu cầu cho họ"
  },
  {
    "idx": 5856,
    "start": "02:42:17,380",
    "end": "02:42:18,720",
    "start_sec": 9737.38,
    "end_sec": 9738.72,
    "zh": "送向人的要求是",
    "vi": "Yêu cầu gửi đến người là"
  },
  {
    "idx": 5857,
    "start": "02:42:18,720",
    "end": "02:42:20,200",
    "start_sec": 9738.72,
    "end_sec": 9740.2,
    "zh": "希望他们早日如轮回",
    "vi": "mong họ sớm được đầu thai"
  },
  {
    "idx": 5858,
    "start": "02:42:20,200",
    "end": "02:42:21,020",
    "start_sec": 9740.2,
    "end_sec": 9741.02,
    "zh": "还有吗",
    "vi": "Còn gì nữa không"
  },
  {
    "idx": 5859,
    "start": "02:42:21,020",
    "end": "02:42:21,880",
    "start_sec": 9741.02,
    "end_sec": 9741.88,
    "zh": "没了",
    "vi": "Hết rồi"
  },
  {
    "idx": 5860,
    "start": "02:42:21,880",
    "end": "02:42:23,040",
    "start_sec": 9741.88,
    "end_sec": 9743.04,
    "zh": "不过发帖子的人",
    "vi": "Nhưng người đăng bài"
  },
  {
    "idx": 5861,
    "start": "02:42:23,040",
    "end": "02:42:24,200",
    "start_sec": 9743.04,
    "end_sec": 9744.2,
    "zh": "似乎一直在坚持",
    "vi": "dường như vẫn luôn kiên trì"
  },
  {
    "idx": 5862,
    "start": "02:42:24,200",
    "end": "02:42:25,660",
    "start_sec": 9744.2,
    "end_sec": 9745.66,
    "zh": "举报神秘方的劣质施工",
    "vi": "tố cáo công trình kém chất lượng của bên bí ẩn"
  },
  {
    "idx": 5863,
    "start": "02:42:25,660",
    "end": "02:42:27,680",
    "start_sec": 9745.66,
    "end_sec": 9747.68,
    "zh": "好像还有个孙女在帮他发帖",
    "vi": "Hình như còn có một cháu gái giúp ông ấy đăng bài"
  },
  {
    "idx": 5864,
    "start": "02:42:27,680",
    "end": "02:42:29,120",
    "start_sec": 9747.68,
    "end_sec": 9749.12,
    "zh": "但就是一直没有回应",
    "vi": "Nhưng vẫn chưa có hồi đáp"
  },
  {
    "idx": 5865,
    "start": "02:42:29,120",
    "end": "02:42:32,620",
    "start_sec": 9749.12,
    "end_sec": 9752.62,
    "zh": "难道那十个项面腐烂的那只尸体",
    "vi": "Chẳng lẽ mười cái xác thối rữa trong dự án đó"
  },
  {
    "idx": 5866,
    "start": "02:42:32,620",
    "end": "02:42:34,580",
    "start_sec": 9752.62,
    "end_sec": 9754.58,
    "zh": "就是每天往隧道里送香的人",
    "vi": "chính là người mỗi ngày mang hương vào đường hầm"
  },
  {
    "idx": 5867,
    "start": "02:42:34,580",
    "end": "02:42:36,940",
    "start_sec": 9754.58,
    "end_sec": 9756.94,
    "zh": "这么一来就解释得通了",
    "vi": "Nếu vậy thì mọi chuyện sẽ hợp lý"
  },
  {
    "idx": 5868,
    "start": "02:42:36,940",
    "end": "02:42:38,360",
    "start_sec": 9756.94,
    "end_sec": 9758.36,
    "zh": "送香人就是食香鬼",
    "vi": "Người mang hương chính là ma ăn hương"
  },
  {
    "idx": 5869,
    "start": "02:42:38,360",
    "end": "02:42:39,620",
    "start_sec": 9758.36,
    "end_sec": 9759.62,
    "zh": "零三七说过",
    "vi": "037 đã nói"
  },
  {
    "idx": 5870,
    "start": "02:42:39,620",
    "end": "02:42:41,460",
    "start_sec": 9759.62,
    "end_sec": 9761.46,
    "zh": "带有极其激烈的情绪死后",
    "vi": "Sau khi chết với cảm xúc cực kỳ mãnh liệt"
  },
  {
    "idx": 5871,
    "start": "02:42:41,460",
    "end": "02:42:42,880",
    "start_sec": 9761.46,
    "end_sec": 9762.88,
    "zh": "有概率变成鬼运",
    "vi": "có khả năng biến thành ma vận"
  },
  {
    "idx": 5872,
    "start": "02:42:42,880",
    "end": "02:42:46,040",
    "start_sec": 9762.88,
    "end_sec": 9766.04,
    "zh": "如果能让送香人在鬼运降临前的一个月不去送香",
    "vi": "Nếu có thể khiến người mang hương không mang hương trong một tháng trước khi ma vận giáng xuống"
  },
  {
    "idx": 5873,
    "start": "02:42:46,040",
    "end": "02:42:47,940",
    "start_sec": 9766.04,
    "end_sec": 9767.94,
    "zh": "那么就能从根源上解决问题",
    "vi": "thì có thể giải quyết vấn đề từ gốc rễ"
  },
  {
    "idx": 5874,
    "start": "02:42:47,940",
    "end": "02:42:50,160",
    "start_sec": 9767.94,
    "end_sec": 9770.16,
    "zh": "深山隧道里就不会有食香鬼",
    "vi": "Trong đường hầm núi sâu sẽ không có ma ăn hương"
  },
  {
    "idx": 5875,
    "start": "02:42:50,160",
    "end": "02:42:52,500",
    "start_sec": 9770.16,
    "end_sec": 9772.5,
    "zh": "想着藏子自陪过去的自己",
    "vi": "Nghĩ đến việc tự mình mang con đi"
  },
  {
    "idx": 5876,
    "start": "02:42:52,500",
    "end": "02:42:53,460",
    "start_sec": 9772.5,
    "end_sec": 9773.46,
    "zh": "回了小小姐",
    "vi": "Đã về với tiểu thư"
  },
  {
    "idx": 5877,
    "start": "02:42:53,460",
    "end": "02:42:56,020",
    "start_sec": 9773.46,
    "end_sec": 9776.02,
    "zh": "你看看能不能私信联系到孙生人",
    "vi": "Em xem có thể liên hệ riêng với người họ Tôn không"
  },
  {
    "idx": 5878,
    "start": "02:42:56,020",
    "end": "02:42:58,120",
    "start_sec": 9776.02,
    "end_sec": 9778.12,
    "zh": "想办法让他一个月内别去超乡",
    "vi": "Tìm cách để ông ấy không đi siêu độ trong một tháng"
  },
  {
    "idx": 5879,
    "start": "02:42:58,120",
    "end": "02:43:00,200",
    "start_sec": 9778.12,
    "end_sec": 9780.2,
    "zh": "还有你千万不能冒险",
    "vi": "Và em tuyệt đối không được mạo hiểm"
  },
  {
    "idx": 5880,
    "start": "02:43:00,200",
    "end": "02:43:02,060",
    "start_sec": 9780.2,
    "end_sec": 9782.06,
    "zh": "行你等我消息",
    "vi": "Được rồi, chờ tin của anh"
  },
  {
    "idx": 5881,
    "start": "02:43:02,060",
    "end": "02:43:03,920",
    "start_sec": 9782.06,
    "end_sec": 9783.92,
    "zh": "交代完事以后",
    "vi": "Sau khi dặn dò xong mọi chuyện"
  },
  {
    "idx": 5882,
    "start": "02:43:03,920",
    "end": "02:43:05,120",
    "start_sec": 9783.92,
    "end_sec": 9785.12,
    "zh": "橙子皮松了口气",
    "vi": "Trần Tử Bì thở phào nhẹ nhõm"
  },
  {
    "idx": 5883,
    "start": "02:43:05,120",
    "end": "02:43:06,900",
    "start_sec": 9785.12,
    "end_sec": 9786.9,
    "zh": "抬头看向那四名大雪魔",
    "vi": "Ngẩng đầu nhìn bốn con đại tuyết ma kia"
  },
  {
    "idx": 5884,
    "start": "02:43:06,900",
    "end": "02:43:07,580",
    "start_sec": 9786.9,
    "end_sec": 9787.58,
    "zh": "我操",
    "vi": "Chết tiệt"
  },
  {
    "idx": 5885,
    "start": "02:43:07,580",
    "end": "02:43:08,340",
    "start_sec": 9787.58,
    "end_sec": 9788.34,
    "zh": "神啊",
    "vi": "Thần linh ơi"
  },
  {
    "idx": 5886,
    "start": "02:43:08,340",
    "end": "02:43:10,360",
    "start_sec": 9788.34,
    "end_sec": 9790.36,
    "zh": "橙子皮走出加油站",
    "vi": "Trần Tử Bì bước ra khỏi trạm xăng"
  },
  {
    "idx": 5887,
    "start": "02:43:10,360",
    "end": "02:43:12,280",
    "start_sec": 9790.36,
    "end_sec": 9792.28,
    "zh": "朝着远处深山隧道看着",
    "vi": "Nhìn về phía đường hầm sâu trong núi ở đằng xa"
  },
  {
    "idx": 5888,
    "start": "02:43:12,280",
    "end": "02:43:15,580",
    "start_sec": 9792.28,
    "end_sec": 9795.58,
    "zh": "果然看到自分绑在对白外绿化树上的山脚",
    "vi": "Quả nhiên nhìn thấy đầu dây mình buộc vào hàng cây xanh bên lề đường"
  },
  {
    "idx": 5889,
    "start": "02:43:15,580",
    "end": "02:43:17,860",
    "start_sec": 9795.58,
    "end_sec": 9797.86,
    "zh": "这群家伙真不怕死吗",
    "vi": "Lũ người này thật sự không sợ chết sao."
  },
  {
    "idx": 5890,
    "start": "02:43:17,860",
    "end": "02:43:19,440",
    "start_sec": 9797.86,
    "end_sec": 9799.44,
    "zh": "看着黑油油的隧道",
    "vi": "Nhìn vào đường hầm tối đen như mực"
  },
  {
    "idx": 5891,
    "start": "02:43:19,440",
    "end": "02:43:20,640",
    "start_sec": 9799.44,
    "end_sec": 9800.64,
    "zh": "橙子皮思索片刻",
    "vi": "Trần Tử Bì suy nghĩ một lát"
  },
  {
    "idx": 5892,
    "start": "02:43:20,640",
    "end": "02:43:22,220",
    "start_sec": 9800.64,
    "end_sec": 9802.22,
    "zh": "拽起其中一个翔子",
    "vi": "Kéo một trong những sợi dây lên"
  },
  {
    "idx": 5893,
    "start": "02:43:22,220",
    "end": "02:43:25,300",
    "start_sec": 9802.22,
    "end_sec": 9805.3,
    "zh": "带着小磨叽朝隧道内走了进去",
    "vi": "Dẫn theo Tiểu Mặc Kê đi vào trong đường hầm"
  },
  {
    "idx": 5894,
    "start": "02:43:25,300",
    "end": "02:43:27,840",
    "start_sec": 9805.3,
    "end_sec": 9807.84,
    "zh": "橙子皮拽着其中一根绳子",
    "vi": "Trần Tử Bì kéo một trong những sợi dây thừng"
  },
  {
    "idx": 5895,
    "start": "02:43:27,840",
    "end": "02:43:30,280",
    "start_sec": 9807.84,
    "end_sec": 9810.28,
    "zh": "带着小磨叽朝隧道内走了进去",
    "vi": "Dẫn theo Tiểu Mặc Kê đi vào trong đường hầm"
  },
  {
    "idx": 5896,
    "start": "02:43:30,280",
    "end": "02:43:32,800",
    "start_sec": 9810.28,
    "end_sec": 9812.8,
    "zh": "为什么有根短绳子",
    "vi": "Tại sao lại có một sợi dây ngắn thế này."
  },
  {
    "idx": 5897,
    "start": "02:43:32,800",
    "end": "02:43:33,260",
    "start_sec": 9812.8,
    "end_sec": 9813.26,
    "zh": "最近",
    "vi": "Gần quá"
  },
  {
    "idx": 5898,
    "start": "02:43:33,260",
    "end": "02:43:34,100",
    "start_sec": 9813.26,
    "end_sec": 9814.1,
    "zh": "算了",
    "vi": "Bỏ đi"
  },
  {
    "idx": 5899,
    "start": "02:43:34,100",
    "end": "02:43:35,640",
    "start_sec": 9814.1,
    "end_sec": 9815.64,
    "zh": "还是回加油站吧",
    "vi": "Hay là quay lại trạm xăng đi."
  },
  {
    "idx": 5900,
    "start": "02:43:35,640",
    "end": "02:43:37,140",
    "start_sec": 9815.64,
    "end_sec": 9817.14,
    "zh": "哥",
    "vi": "Anh ơi"
  },
  {
    "idx": 5901,
    "start": "02:43:37,140",
    "end": "02:43:37,820",
    "start_sec": 9817.14,
    "end_sec": 9817.82,
    "zh": "文莱",
    "vi": "Văn Lai"
  },
  {
    "idx": 5902,
    "start": "02:43:37,820",
    "end": "02:43:38,780",
    "start_sec": 9817.82,
    "end_sec": 9818.78,
    "zh": "你说的是真的",
    "vi": "Những gì anh nói là thật sao."
  },
  {
    "idx": 5903,
    "start": "02:43:38,780",
    "end": "02:43:39,740",
    "start_sec": 9818.78,
    "end_sec": 9819.74,
    "zh": "这么走",
    "vi": "Đi như thế này"
  },
  {
    "idx": 5904,
    "start": "02:43:39,740",
    "end": "02:43:41,040",
    "start_sec": 9819.74,
    "end_sec": 9821.04,
    "zh": "果然能看到出路",
    "vi": "Quả nhiên có thể tìm thấy lối ra sao."
  },
  {
    "idx": 5905,
    "start": "02:43:41,040",
    "end": "02:43:42,580",
    "start_sec": 9821.04,
    "end_sec": 9822.58,
    "zh": "声音怎么会这么紧",
    "vi": "Sao âm thanh lại gần như thế này."
  },
  {
    "idx": 5906,
    "start": "02:43:42,580",
    "end": "02:43:43,500",
    "start_sec": 9822.58,
    "end_sec": 9823.5,
    "zh": "出路",
    "vi": "Lối ra sao."
  },
  {
    "idx": 5907,
    "start": "02:43:43,500",
    "end": "02:43:45,760",
    "start_sec": 9823.5,
    "end_sec": 9825.76,
    "zh": "莫非他们洞悉了十相鬼运的规则",
    "vi": "Chẳng lẽ họ đã hiểu rõ quy luật của Thập Tướng Quỷ Vận rồi sao."
  },
  {
    "idx": 5908,
    "start": "02:43:45,760",
    "end": "02:43:46,700",
    "start_sec": 9825.76,
    "end_sec": 9826.7,
    "zh": "还是说",
    "vi": "Hay là"
  },
  {
    "idx": 5909,
    "start": "02:43:46,700",
    "end": "02:43:47,720",
    "start_sec": 9826.7,
    "end_sec": 9827.72,
    "zh": "另有所谋",
    "vi": "Họ còn có âm mưu khác."
  },
  {
    "idx": 5910,
    "start": "02:43:47,720",
    "end": "02:43:49,160",
    "start_sec": 9827.72,
    "end_sec": 9829.16,
    "zh": "到底是回加油站",
    "vi": "Rốt cuộc là nên quay lại trạm xăng"
  },
  {
    "idx": 5911,
    "start": "02:43:49,160",
    "end": "02:43:50,420",
    "start_sec": 9829.16,
    "end_sec": 9830.42,
    "zh": "还是朝姻缘走进",
    "vi": "Vẫn đi về phía nhân duyên."
  },
  {
    "idx": 5912,
    "start": "02:43:50,420",
    "end": "02:43:52,140",
    "start_sec": 9830.42,
    "end_sec": 9832.14,
    "zh": "橙子皮指犹豫了一秒",
    "vi": "Trần Tử Bì chỉ do dự một giây."
  },
  {
    "idx": 5913,
    "start": "02:43:52,140",
    "end": "02:43:54,840",
    "start_sec": 9832.14,
    "end_sec": 9834.84,
    "zh": "我倒要看看你们葫芦里卖的什么样子",
    "vi": "Tôi muốn xem các người đang giở trò gì."
  },
  {
    "idx": 5914,
    "start": "02:43:54,840",
    "end": "02:43:56,620",
    "start_sec": 9834.84,
    "end_sec": 9836.62,
    "zh": "东莱哥",
    "vi": "Anh Đông Lai."
  },
  {
    "idx": 5915,
    "start": "02:43:56,620",
    "end": "02:43:57,800",
    "start_sec": 9836.62,
    "end_sec": 9837.8,
    "zh": "你说的一点没错",
    "vi": "Anh nói không sai một chút nào."
  },
  {
    "idx": 5916,
    "start": "02:43:57,800",
    "end": "02:43:59,460",
    "start_sec": 9837.8,
    "end_sec": 9839.46,
    "zh": "这家伙真的跟来了",
    "vi": "Tên này thực sự đi theo rồi."
  },
  {
    "idx": 5917,
    "start": "02:43:59,460",
    "end": "02:44:00,800",
    "start_sec": 9839.46,
    "end_sec": 9840.8,
    "zh": "怎么了",
    "vi": "Sao thế."
  },
  {
    "idx": 5918,
    "start": "02:44:00,800",
    "end": "02:44:03,420",
    "start_sec": 9840.8,
    "end_sec": 9843.42,
    "zh": "哥们不是说好了不来送死吗",
    "vi": "Người anh em, không phải đã nói là không đến nộp mạng sao."
  },
  {
    "idx": 5919,
    "start": "02:44:03,420",
    "end": "02:44:05,840",
    "start_sec": 9843.42,
    "end_sec": 9845.84,
    "zh": "猜到了",
    "vi": "Đoán được rồi."
  },
  {
    "idx": 5920,
    "start": "02:44:05,840",
    "end": "02:44:07,240",
    "start_sec": 9845.84,
    "end_sec": 9847.24,
    "zh": "你们果然在算计我",
    "vi": "Các người quả nhiên đang tính kế tôi."
  },
  {
    "idx": 5921,
    "start": "02:44:07,240",
    "end": "02:44:09,520",
    "start_sec": 9847.24,
    "end_sec": 9849.52,
    "zh": "怎么能是算计呢",
    "vi": "Sao lại gọi là tính kế được chứ."
  },
  {
    "idx": 5922,
    "start": "02:44:09,520",
    "end": "02:44:11,240",
    "start_sec": 9849.52,
    "end_sec": 9851.24,
    "zh": "你不是也想穿越隧道",
    "vi": "Không phải bạn cũng muốn đi qua đường hầm sao."
  },
  {
    "idx": 5923,
    "start": "02:44:11,240",
    "end": "02:44:14,420",
    "start_sec": 9851.24,
    "end_sec": 9854.42,
    "zh": "但是这隧道一开始就是此局",
    "vi": "Nhưng đường hầm này ngay từ đầu đã là một cạm bẫy chết người."
  },
  {
    "idx": 5924,
    "start": "02:44:14,420",
    "end": "02:44:16,280",
    "start_sec": 9854.42,
    "end_sec": 9856.28,
    "zh": "本来一切都计划好了的",
    "vi": "Vốn dĩ mọi thứ đã được lên kế hoạch rồi."
  },
  {
    "idx": 5925,
    "start": "02:44:16,280",
    "end": "02:44:18,020",
    "start_sec": 9856.28,
    "end_sec": 9858.02,
    "zh": "没想到你却突然出现",
    "vi": "Không ngờ bạn lại đột nhiên xuất hiện."
  },
  {
    "idx": 5926,
    "start": "02:44:18,020",
    "end": "02:44:18,920",
    "start_sec": 9858.02,
    "end_sec": 9858.92,
    "zh": "如此一来",
    "vi": "Như vậy thì."
  },
  {
    "idx": 5927,
    "start": "02:44:18,920",
    "end": "02:44:20,100",
    "start_sec": 9858.92,
    "end_sec": 9860.1,
    "zh": "千千就不用走了",
    "vi": "Thiên Thiên không cần phải đi nữa."
  },
  {
    "idx": 5928,
    "start": "02:44:20,100",
    "end": "02:44:21,120",
    "start_sec": 9860.1,
    "end_sec": 9861.12,
    "zh": "什么意思",
    "vi": "Ý gì thế."
  },
  {
    "idx": 5929,
    "start": "02:44:21,120",
    "end": "02:44:22,840",
    "start_sec": 9861.12,
    "end_sec": 9862.84,
    "zh": "什么倩倩就不用走了",
    "vi": "Cái gì mà Thiên Thiên không cần phải đi nữa."
  },
  {
    "idx": 5930,
    "start": "02:44:22,840",
    "end": "02:44:26,040",
    "start_sec": 9862.84,
    "end_sec": 9866.04,
    "zh": "十香鬼",
    "vi": "Thập Hương Quỷ."
  },
  {
    "idx": 5931,
    "start": "02:44:26,040",
    "end": "02:44:27,000",
    "start_sec": 9866.04,
    "end_sec": 9867.0,
    "zh": "第三炷香",
    "vi": "Nén hương thứ ba."
  },
  {
    "idx": 5932,
    "start": "02:44:27,000",
    "end": "02:44:27,980",
    "start_sec": 9867.0,
    "end_sec": 9867.98,
    "zh": "我给你送来了",
    "vi": "Tôi mang đến cho ngươi rồi."
  },
  {
    "idx": 5933,
    "start": "02:44:27,980",
    "end": "02:44:33,820",
    "start_sec": 9867.98,
    "end_sec": 9873.82,
    "zh": "第三炷香",
    "vi": "Nén hương thứ ba."
  },
  {
    "idx": 5934,
    "start": "02:44:33,820",
    "end": "02:44:35,280",
    "start_sec": 9873.82,
    "end_sec": 9875.28,
    "zh": "为什么不是第二炷香",
    "vi": "Tại sao không phải là nén hương thứ hai."
  },
  {
    "idx": 5935,
    "start": "02:44:35,280",
    "end": "02:44:36,580",
    "start_sec": 9875.28,
    "end_sec": 9876.58,
    "zh": "第一炷香又是什么",
    "vi": "Còn nén hương thứ nhất là gì."
  },
  {
    "idx": 5936,
    "start": "02:44:36,580",
    "end": "02:44:37,760",
    "start_sec": 9876.58,
    "end_sec": 9877.76,
    "zh": "难道",
    "vi": "Không lẽ."
  },
  {
    "idx": 5937,
    "start": "02:44:37,760",
    "end": "02:44:39,420",
    "start_sec": 9877.76,
    "end_sec": 9879.42,
    "zh": "你供奉诡异",
    "vi": "Anh thờ cúng quỷ dị."
  },
  {
    "idx": 5938,
    "start": "02:44:39,420",
    "end": "02:44:40,700",
    "start_sec": 9879.42,
    "end_sec": 9880.7,
    "zh": "你又能得到什么",
    "vi": "Anh lại có thể nhận được gì chứ."
  },
  {
    "idx": 5939,
    "start": "02:44:40,700",
    "end": "02:44:42,100",
    "start_sec": 9880.7,
    "end_sec": 9882.1,
    "zh": "一个将死之人",
    "vi": "Một kẻ sắp chết."
  },
  {
    "idx": 5940,
    "start": "02:44:42,100",
    "end": "02:44:43,560",
    "start_sec": 9882.1,
    "end_sec": 9883.56,
    "zh": "需要知道这么多吗",
    "vi": "Có cần phải biết nhiều thế không."
  },
  {
    "idx": 5941,
    "start": "02:44:43,560",
    "end": "02:44:45,040",
    "start_sec": 9883.56,
    "end_sec": 9885.04,
    "zh": "也就是你运气好",
    "vi": "Cũng là do cậu may mắn thôi."
  },
  {
    "idx": 5942,
    "start": "02:44:45,040",
    "end": "02:44:46,540",
    "start_sec": 9885.04,
    "end_sec": 9886.54,
    "zh": "本来以为你是第二个",
    "vi": "Vốn dĩ tưởng cậu là người thứ hai."
  },
  {
    "idx": 5943,
    "start": "02:44:46,540",
    "end": "02:44:48,280",
    "start_sec": 9886.54,
    "end_sec": 9888.28,
    "zh": "无名能顺者成为第三个",
    "vi": "Tên đạo sĩ vô danh kia sẽ thuận thế trở thành người thứ ba."
  },
  {
    "idx": 5944,
    "start": "02:44:48,280",
    "end": "02:44:50,340",
    "start_sec": 9888.28,
    "end_sec": 9890.34,
    "zh": "没想到倩倩带他进去后",
    "vi": "Không ngờ sau khi Thiến Thiến đưa hắn vào."
  },
  {
    "idx": 5945,
    "start": "02:44:50,340",
    "end": "02:44:51,540",
    "start_sec": 9890.34,
    "end_sec": 9891.54,
    "zh": "你居然还没死",
    "vi": "Cậu lại vẫn chưa chết."
  },
  {
    "idx": 5946,
    "start": "02:44:51,540",
    "end": "02:44:53,100",
    "start_sec": 9891.54,
    "end_sec": 9893.1,
    "zh": "五名道士成了第二个",
    "vi": "Tên đạo sĩ vô danh kia lại trở thành người thứ hai."
  },
  {
    "idx": 5947,
    "start": "02:44:53,100",
    "end": "02:44:54,260",
    "start_sec": 9893.1,
    "end_sec": 9894.26,
    "zh": "我倒要看看",
    "vi": "Để tôi xem thử."
  },
  {
    "idx": 5948,
    "start": "02:44:54,260",
    "end": "02:44:56,340",
    "start_sec": 9894.26,
    "end_sec": 9896.34,
    "zh": "你这次是不是还这么好运好运我运气确实不差但你觉得我能活到现在靠的是运气吗每等橙子皮够完徐东来摸着腰间的绳子",
    "vi": "Lần này cậu có còn may mắn như vậy không"
  },
  {
    "idx": 5948,
    "start": "02:44:56,340",
    "end": "02:44:56,964",
    "start_sec": 9896.34,
    "end_sec": 9896.964,
    "zh": "你这次是不是还这么好运好运我运气确实不差但你觉得我能活到现在靠的是运气吗每等橙子皮够完徐东来摸着腰间的绳子",
    "vi": "May mắn sao"
  },
  {
    "idx": 5948,
    "start": "02:44:56,964",
    "end": "02:45:01,332",
    "start_sec": 9896.964,
    "end_sec": 9901.332,
    "zh": "你这次是不是还这么好运好运我运气确实不差但你觉得我能活到现在靠的是运气吗每等橙子皮够完徐东来摸着腰间的绳子",
    "vi": "Vận may của tôi đúng là không tệ, nhưng cậu nghĩ tôi sống được đến giờ là nhờ may mắn sao"
  },
  {
    "idx": 5948,
    "start": "02:45:01,332",
    "end": "02:45:05,077",
    "start_sec": 9901.332,
    "end_sec": 9905.077,
    "zh": "你这次是不是还这么好运好运我运气确实不差但你觉得我能活到现在靠的是运气吗每等橙子皮够完徐东来摸着腰间的绳子",
    "vi": "Chưa đợi Trần Tử Bì bóc xong, Từ Đông Lai đã sờ vào sợi dây thừng bên hông"
  },
  {
    "idx": 5949,
    "start": "02:45:05,077",
    "end": "02:45:07,977",
    "start_sec": 9905.077,
    "end_sec": 9907.977,
    "zh": "拉着没有绳子的吴雅芹退入迷雾中",
    "vi": "Kéo Ngô Nhã Sảnh không có dây thừng lùi vào trong sương mù."
  },
  {
    "idx": 5950,
    "start": "02:45:07,977",
    "end": "02:45:09,517",
    "start_sec": 9907.977,
    "end_sec": 9909.517,
    "zh": "这么看来",
    "vi": "Xem ra."
  },
  {
    "idx": 5951,
    "start": "02:45:09,517",
    "end": "02:45:10,777",
    "start_sec": 9909.517,
    "end_sec": 9910.777,
    "zh": "徐东来是送箱人",
    "vi": "Từ Đông Lai là người đưa hương."
  },
  {
    "idx": 5952,
    "start": "02:45:10,777",
    "end": "02:45:11,877",
    "start_sec": 9910.777,
    "end_sec": 9911.877,
    "zh": "我是第三炷香",
    "vi": "Tôi là nén hương thứ ba."
  },
  {
    "idx": 5953,
    "start": "02:45:11,877",
    "end": "02:45:14,917",
    "start_sec": 9911.877,
    "end_sec": 9914.917,
    "zh": "第一炷香应该是隧道里那具无头尸体",
    "vi": "Nén hương đầu tiên chắc là cái xác không đầu trong đường hầm."
  },
  {
    "idx": 5954,
    "start": "02:45:14,917",
    "end": "02:45:16,497",
    "start_sec": 9914.917,
    "end_sec": 9916.497,
    "zh": "罗倩倩也是送箱人",
    "vi": "La Thiến Thiến cũng là người đưa hương."
  },
  {
    "idx": 5955,
    "start": "02:45:16,497",
    "end": "02:45:18,497",
    "start_sec": 9916.497,
    "end_sec": 9918.497,
    "zh": "那么第二炷香应该就是我们",
    "vi": "Vậy thì nén hương thứ hai chắc là chúng tôi."
  },
  {
    "idx": 5956,
    "start": "02:45:18,497",
    "end": "02:45:20,977",
    "start_sec": 9918.497,
    "end_sec": 9920.977,
    "zh": "送完三炷香后会怎么样呢",
    "vi": "Sau khi đưa xong ba nén hương thì sẽ thế nào."
  },
  {
    "idx": 5957,
    "start": "02:45:20,977",
    "end": "02:45:22,457",
    "start_sec": 9920.977,
    "end_sec": 9922.457,
    "zh": "就能出隧道吗",
    "vi": "Có thể ra khỏi đường hầm không."
  },
  {
    "idx": 5958,
    "start": "02:45:22,457",
    "end": "02:45:23,057",
    "start_sec": 9922.457,
    "end_sec": 9923.057,
    "zh": "两路中",
    "vi": "Trong sương mù."
  },
  {
    "idx": 5959,
    "start": "02:45:23,057",
    "end": "02:45:24,777",
    "start_sec": 9923.057,
    "end_sec": 9924.777,
    "zh": "徐东来的气血上传来",
    "vi": "Tiếng cười quái dị của Từ Đông Lai truyền đến."
  },
  {
    "idx": 5960,
    "start": "02:45:24,777",
    "end": "02:45:27,157",
    "start_sec": 9924.777,
    "end_sec": 9927.157,
    "zh": "吃香鬼吃下这第三炷香",
    "vi": "Quỷ ăn hương, hãy ăn nén hương thứ ba này đi."
  },
  {
    "idx": 5961,
    "start": "02:45:27,157",
    "end": "02:45:37,217",
    "start_sec": 9927.157,
    "end_sec": 9937.217,
    "zh": "吃我",
    "vi": "Ăn tôi."
  },
  {
    "idx": 5962,
    "start": "02:45:37,217",
    "end": "02:45:39,377",
    "start_sec": 9937.217,
    "end_sec": 9939.377,
    "zh": "吃吃吧你",
    "vi": "Ăn mày nè."
  },
  {
    "idx": 5963,
    "start": "02:45:39,377",
    "end": "02:45:41,777",
    "start_sec": 9939.377,
    "end_sec": 9941.777,
    "zh": "小子",
    "vi": "Nhóc con."
  },
  {
    "idx": 5964,
    "start": "02:45:41,777",
    "end": "02:45:42,777",
    "start_sec": 9941.777,
    "end_sec": 9942.777,
    "zh": "你看吧",
    "vi": "Cậu thấy chưa."
  },
  {
    "idx": 5965,
    "start": "02:45:42,777",
    "end": "02:45:44,337",
    "start_sec": 9942.777,
    "end_sec": 9944.337,
    "zh": "你还是需要我的力量",
    "vi": "Cậu vẫn cần đến sức mạnh của tôi."
  },
  {
    "idx": 5966,
    "start": "02:45:44,337",
    "end": "02:45:45,217",
    "start_sec": 9944.337,
    "end_sec": 9945.217,
    "zh": "所以我说",
    "vi": "Cho nên tôi mới nói."
  },
  {
    "idx": 5967,
    "start": "02:45:45,217",
    "end": "02:45:47,257",
    "start_sec": 9945.217,
    "end_sec": 9947.257,
    "zh": "我更适合当身体的食材人",
    "vi": "Tôi hợp làm người làm chủ cơ thể này hơn."
  },
  {
    "idx": 5968,
    "start": "02:45:47,257",
    "end": "02:45:48,297",
    "start_sec": 9947.257,
    "end_sec": 9948.297,
    "zh": "你闭嘴",
    "vi": "Ngươi câm miệng lại đi."
  },
  {
    "idx": 5969,
    "start": "02:45:48,297",
    "end": "02:45:50,177",
    "start_sec": 9948.297,
    "end_sec": 9950.177,
    "zh": "黑狗血没喝够是吧",
    "vi": "Chưa uống đủ máu chó đen đúng không."
  },
  {
    "idx": 5970,
    "start": "02:45:50,177",
    "end": "02:45:50,637",
    "start_sec": 9950.177,
    "end_sec": 9950.637,
    "zh": "你",
    "vi": "Ngươi."
  },
  {
    "idx": 5971,
    "start": "02:45:50,637",
    "end": "02:45:51,337",
    "start_sec": 9950.637,
    "end_sec": 9951.337,
    "zh": "你",
    "vi": "Mày"
  },
  {
    "idx": 5972,
    "start": "02:45:51,337",
    "end": "02:45:53,097",
    "start_sec": 9951.337,
    "end_sec": 9953.097,
    "zh": "你",
    "vi": "Mày"
  },
  {
    "idx": 5973,
    "start": "02:45:53,097",
    "end": "02:45:53,617",
    "start_sec": 9953.097,
    "end_sec": 9953.617,
    "zh": "你",
    "vi": "Mày"
  },
  {
    "idx": 5974,
    "start": "02:45:53,617",
    "end": "02:45:54,857",
    "start_sec": 9953.617,
    "end_sec": 9954.857,
    "zh": "怎么又是你",
    "vi": "Sao lại là mày nữa."
  },
  {
    "idx": 5975,
    "start": "02:45:54,857",
    "end": "02:45:55,617",
    "start_sec": 9954.857,
    "end_sec": 9955.617,
    "zh": "同时",
    "vi": "Đồng thời"
  },
  {
    "idx": 5976,
    "start": "02:45:55,617",
    "end": "02:45:56,837",
    "start_sec": 9955.617,
    "end_sec": 9956.837,
    "zh": "烟雾一发露后",
    "vi": "Khi làn khói tỏa ra"
  },
  {
    "idx": 5977,
    "start": "02:45:56,837",
    "end": "02:45:58,717",
    "start_sec": 9956.837,
    "end_sec": 9958.717,
    "zh": "石香鬼随随消失在烟雾里",
    "vi": "Thạch Hương Quỷ dần biến mất trong làn khói"
  },
  {
    "idx": 5978,
    "start": "02:45:58,717",
    "end": "02:45:59,857",
    "start_sec": 9958.717,
    "end_sec": 9959.857,
    "zh": "不是要吃我吗",
    "vi": "Không phải muốn ăn thịt tao sao."
  },
  {
    "idx": 5979,
    "start": "02:45:59,857",
    "end": "02:46:01,757",
    "start_sec": 9959.857,
    "end_sec": 9961.757,
    "zh": "你也就只敢躲着我了",
    "vi": "Mày cũng chỉ dám trốn tránh tao thôi"
  },
  {
    "idx": 5980,
    "start": "02:46:01,757",
    "end": "02:46:05,777",
    "start_sec": 9961.757,
    "end_sec": 9965.777,
    "zh": "你这家伙居然是遇鬼者",
    "vi": "Mày hóa ra là kẻ ngự quỷ"
  },
  {
    "idx": 5981,
    "start": "02:46:05,777",
    "end": "02:46:06,517",
    "start_sec": 9965.777,
    "end_sec": 9966.517,
    "zh": "该死",
    "vi": "Đáng chết"
  },
  {
    "idx": 5982,
    "start": "02:46:06,517",
    "end": "02:46:07,137",
    "start_sec": 9966.517,
    "end_sec": 9967.137,
    "zh": "该死",
    "vi": "Đáng chết"
  },
  {
    "idx": 5983,
    "start": "02:46:07,137",
    "end": "02:46:08,717",
    "start_sec": 9967.137,
    "end_sec": 9968.717,
    "zh": "你明明是遇鬼者",
    "vi": "Mày rõ ràng là kẻ ngự quỷ"
  },
  {
    "idx": 5984,
    "start": "02:46:08,717",
    "end": "02:46:10,377",
    "start_sec": 9968.717,
    "end_sec": 9970.377,
    "zh": "为什么不早点离开这里",
    "vi": "Sao không rời khỏi đây sớm hơn."
  },
  {
    "idx": 5985,
    "start": "02:46:10,377",
    "end": "02:46:11,297",
    "start_sec": 9970.377,
    "end_sec": 9971.297,
    "zh": "将来",
    "vi": "Giang Lai"
  },
  {
    "idx": 5986,
    "start": "02:46:11,297",
    "end": "02:46:11,817",
    "start_sec": 9971.297,
    "end_sec": 9971.817,
    "zh": "这",
    "vi": "Chuyện này"
  },
  {
    "idx": 5987,
    "start": "02:46:11,817",
    "end": "02:46:12,937",
    "start_sec": 9971.817,
    "end_sec": 9972.937,
    "zh": "这鬼不吃他",
    "vi": "Con quỷ này không ăn thịt nó"
  },
  {
    "idx": 5988,
    "start": "02:46:12,937",
    "end": "02:46:13,877",
    "start_sec": 9972.937,
    "end_sec": 9973.877,
    "zh": "我们怎么办",
    "vi": "Chúng ta phải làm sao đây."
  },
  {
    "idx": 5989,
    "start": "02:46:13,877",
    "end": "02:46:15,017",
    "start_sec": 9973.877,
    "end_sec": 9975.017,
    "zh": "不是说好了",
    "vi": "Không phải đã nói trước rồi sao."
  },
  {
    "idx": 5990,
    "start": "02:46:15,017",
    "end": "02:46:15,857",
    "start_sec": 9975.017,
    "end_sec": 9975.857,
    "zh": "天他来",
    "vi": "Lừa nó đến"
  },
  {
    "idx": 5991,
    "start": "02:46:15,857",
    "end": "02:46:16,797",
    "start_sec": 9975.857,
    "end_sec": 9976.797,
    "zh": "让鬼吃他",
    "vi": "Để quỷ ăn thịt nó"
  },
  {
    "idx": 5992,
    "start": "02:46:16,797",
    "end": "02:46:17,597",
    "start_sec": 9976.797,
    "end_sec": 9977.597,
    "zh": "我们跑吗",
    "vi": "Chúng ta chạy trốn sao."
  },
  {
    "idx": 5993,
    "start": "02:46:17,597",
    "end": "02:46:18,537",
    "start_sec": 9977.597,
    "end_sec": 9978.537,
    "zh": "吴亚情",
    "vi": "Ngô Á Tình"
  },
  {
    "idx": 5994,
    "start": "02:46:18,537",
    "end": "02:46:19,957",
    "start_sec": 9978.537,
    "end_sec": 9979.957,
    "zh": "你给老子闭嘴",
    "vi": "Mày câm miệng lại cho tao"
  },
  {
    "idx": 5995,
    "start": "02:46:19,957",
    "end": "02:46:20,537",
    "start_sec": 9979.957,
    "end_sec": 9980.537,
    "zh": "他不死",
    "vi": "Nó không chết"
  },
  {
    "idx": 5996,
    "start": "02:46:20,537",
    "end": "02:46:21,197",
    "start_sec": 9980.537,
    "end_sec": 9981.197,
    "zh": "你死",
    "vi": "Mày chết"
  },
  {
    "idx": 5997,
    "start": "02:46:23,617",
    "end": "02:46:26,257",
    "start_sec": 9983.617,
    "end_sec": 9986.257,
    "zh": "东来",
    "vi": "Đông Lai"
  },
  {
    "idx": 5998,
    "start": "02:46:26,257",
    "end": "02:46:27,097",
    "start_sec": 9986.257,
    "end_sec": 9987.097,
    "zh": "东来",
    "vi": "Đông Lai"
  },
  {
    "idx": 5999,
    "start": "02:46:27,097",
    "end": "02:46:27,617",
    "start_sec": 9987.097,
    "end_sec": 9987.617,
    "zh": "别",
    "vi": "Đừng"
  },
  {
    "idx": 6000,
    "start": "02:46:27,617",
    "end": "02:46:28,817",
    "start_sec": 9987.617,
    "end_sec": 9988.817,
    "zh": "别丢下我",
    "vi": "Đừng bỏ tao lại"
  },
  {
    "idx": 6001,
    "start": "02:46:28,817",
    "end": "02:46:30,477",
    "start_sec": 9988.817,
    "end_sec": 9990.477,
    "zh": "长子皮冷脸看着",
    "vi": "Trưởng Tử Bì lạnh lùng nhìn."
  },
  {
    "idx": 6002,
    "start": "02:46:30,477",
    "end": "02:46:31,797",
    "start_sec": 9990.477,
    "end_sec": 9991.797,
    "zh": "抬手摸了摸摸的",
    "vi": "Nâng tay lên sờ sờ chỗ đó."
  },
  {
    "idx": 6003,
    "start": "02:46:31,797",
    "end": "02:46:32,397",
    "start_sec": 9991.797,
    "end_sec": 9992.397,
    "zh": "好在",
    "vi": "May mắn thay."
  },
  {
    "idx": 6004,
    "start": "02:46:32,397",
    "end": "02:46:34,517",
    "start_sec": 9992.397,
    "end_sec": 9994.517,
    "zh": "这玩意暂时只是鼓起个小包",
    "vi": "Thứ này tạm thời chỉ nổi lên một cục nhỏ."
  },
  {
    "idx": 6005,
    "start": "02:46:34,517",
    "end": "02:46:36,037",
    "start_sec": 9994.517,
    "end_sec": 9996.037,
    "zh": "没有要剧烈发作的意思",
    "vi": "Chưa có dấu hiệu gì là sẽ bộc phát dữ dội."
  },
  {
    "idx": 6006,
    "start": "02:46:36,037",
    "end": "02:46:38,137",
    "start_sec": 9996.037,
    "end_sec": 9998.137,
    "zh": "鬼小子",
    "vi": "Nhóc quỷ à."
  },
  {
    "idx": 6007,
    "start": "02:46:38,137",
    "end": "02:46:39,297",
    "start_sec": 9998.137,
    "end_sec": 9999.297,
    "zh": "打个商量如何",
    "vi": "Thương lượng một chút nhé."
  },
  {
    "idx": 6008,
    "start": "02:46:39,297",
    "end": "02:46:40,377",
    "start_sec": 9999.297,
    "end_sec": 10000.377,
    "zh": "这下见了诡异",
    "vi": "Lần này gặp phải thứ quỷ dị."
  },
  {
    "idx": 6009,
    "start": "02:46:40,377",
    "end": "02:46:41,577",
    "start_sec": 10000.377,
    "end_sec": 10001.577,
    "zh": "我帮你解决了",
    "vi": "Ta giúp bạn giải quyết nó."
  },
  {
    "idx": 6010,
    "start": "02:46:41,577",
    "end": "02:46:42,777",
    "start_sec": 10001.577,
    "end_sec": 10002.777,
    "zh": "你把它给我吃了",
    "vi": "Bạn hãy để ta ăn nó đi."
  },
  {
    "idx": 6011,
    "start": "02:46:42,777",
    "end": "02:46:44,717",
    "start_sec": 10002.777,
    "end_sec": 10004.717,
    "zh": "我以后绝对不侵蚀你了",
    "vi": "Sau này ta tuyệt đối không xâm chiếm bạn nữa."
  },
  {
    "idx": 6012,
    "start": "02:46:44,717",
    "end": "02:46:45,277",
    "start_sec": 10004.717,
    "end_sec": 10005.277,
    "zh": "如何",
    "vi": "Thế nào."
  },
  {
    "idx": 6013,
    "start": "02:46:45,277",
    "end": "02:46:46,297",
    "start_sec": 10005.277,
    "end_sec": 10006.297,
    "zh": "乖",
    "vi": "Ngoan nào."
  },
  {
    "idx": 6014,
    "start": "02:46:46,297",
    "end": "02:46:47,537",
    "start_sec": 10006.297,
    "end_sec": 10007.537,
    "zh": "别以为老子不知道",
    "vi": "Đừng tưởng ta không biết."
  },
  {
    "idx": 6015,
    "start": "02:46:47,537",
    "end": "02:46:48,457",
    "start_sec": 10007.537,
    "end_sec": 10008.457,
    "zh": "你在想什么",
    "vi": "Bạn đang nghĩ gì."
  },
  {
    "idx": 6016,
    "start": "02:46:48,457",
    "end": "02:46:50,737",
    "start_sec": 10008.457,
    "end_sec": 10010.737,
    "zh": "长子皮没有理会鬼面疮",
    "vi": "Trưởng Tử Bì không thèm để ý đến Quỷ Diện Sang."
  },
  {
    "idx": 6017,
    "start": "02:46:50,737",
    "end": "02:46:52,697",
    "start_sec": 10010.737,
    "end_sec": 10012.697,
    "zh": "更没心情理会那几个大姐",
    "vi": "Càng không có tâm trạng quan tâm mấy người phụ nữ kia."
  },
  {
    "idx": 6018,
    "start": "02:46:52,697",
    "end": "02:46:53,837",
    "start_sec": 10012.697,
    "end_sec": 10013.837,
    "zh": "这个徐东来",
    "vi": "Tên Từ Đông Lai này."
  },
  {
    "idx": 6019,
    "start": "02:46:53,837",
    "end": "02:46:56,097",
    "start_sec": 10013.837,
    "end_sec": 10016.097,
    "zh": "恐怕一开始就打算陷进乌鸦里",
    "vi": "E là ngay từ đầu đã định lừa vào trong quạ đen rồi."
  },
  {
    "idx": 6020,
    "start": "02:46:56,097",
    "end": "02:46:58,477",
    "start_sec": 10016.097,
    "end_sec": 10018.477,
    "zh": "罗倩倩和那个僧男又去哪了",
    "vi": "La Thiến Thiến và gã đàn ông tu hành kia đi đâu rồi."
  },
  {
    "idx": 6021,
    "start": "02:46:58,477",
    "end": "02:46:59,397",
    "start_sec": 10018.477,
    "end_sec": 10019.397,
    "zh": "早着早着",
    "vi": "Sớm thôi sớm thôi."
  },
  {
    "idx": 6022,
    "start": "02:46:59,397",
    "end": "02:47:01,077",
    "start_sec": 10019.397,
    "end_sec": 10021.077,
    "zh": "眼前烟雾逐渐变淡",
    "vi": "Làn khói trước mắt dần tan đi."
  },
  {
    "idx": 6023,
    "start": "02:47:01,077",
    "end": "02:47:03,777",
    "start_sec": 10021.077,
    "end_sec": 10023.777,
    "zh": "长子皮居然找到了当时算上的地方",
    "vi": "Trưởng Tử Bì vậy mà tìm được nơi lúc trước đã tính toán."
  },
  {
    "idx": 6024,
    "start": "02:47:03,777",
    "end": "02:47:04,577",
    "start_sec": 10023.777,
    "end_sec": 10024.577,
    "zh": "果然",
    "vi": "Quả nhiên là vậy."
  },
  {
    "idx": 6025,
    "start": "02:47:04,577",
    "end": "02:47:05,917",
    "start_sec": 10024.577,
    "end_sec": 10025.917,
    "zh": "在浓烟起来的时候",
    "vi": "Khi khói đặc bốc lên."
  },
  {
    "idx": 6026,
    "start": "02:47:05,917",
    "end": "02:47:06,857",
    "start_sec": 10025.917,
    "end_sec": 10026.857,
    "zh": "越是想要去",
    "vi": "Càng muốn đi đến đâu."
  },
  {
    "idx": 6027,
    "start": "02:47:06,857",
    "end": "02:47:08,657",
    "start_sec": 10026.857,
    "end_sec": 10028.657,
    "zh": "就越会反其道而行之",
    "vi": "Thì lại càng đi ngược lại với hướng đó."
  },
  {
    "idx": 6028,
    "start": "02:47:08,657",
    "end": "02:47:09,377",
    "start_sec": 10028.657,
    "end_sec": 10029.377,
    "zh": "逆反",
    "vi": "Sự phản nghịch."
  },
  {
    "idx": 6029,
    "start": "02:47:09,377",
    "end": "02:47:10,877",
    "start_sec": 10029.377,
    "end_sec": 10030.877,
    "zh": "就是这里的规则",
    "vi": "Chính là quy tắc ở nơi này."
  },
  {
    "idx": 6030,
    "start": "02:47:10,877",
    "end": "02:47:14,077",
    "start_sec": 10030.877,
    "end_sec": 10034.077,
    "zh": "我想要走出深山隧道的话",
    "vi": "Nếu ta muốn bước ra khỏi đường hầm trong núi sâu."
  },
  {
    "idx": 6031,
    "start": "02:47:14,077",
    "end": "02:47:15,137",
    "start_sec": 10034.077,
    "end_sec": 10035.137,
    "zh": "心里就要想着",
    "vi": "Trong lòng phải nghĩ đến việc"
  },
  {
    "idx": 6032,
    "start": "02:47:15,137",
    "end": "02:47:16,717",
    "start_sec": 10035.137,
    "end_sec": 10036.717,
    "zh": "找到深山隧道的路口",
    "vi": "tìm thấy lối vào của đường hầm trong núi sâu."
  },
  {
    "idx": 6033,
    "start": "02:47:16,717",
    "end": "02:47:18,137",
    "start_sec": 10036.717,
    "end_sec": 10038.137,
    "zh": "一旦中途想法变动",
    "vi": "Một khi giữa chừng suy nghĩ thay đổi."
  },
  {
    "idx": 6034,
    "start": "02:47:18,137",
    "end": "02:47:19,897",
    "start_sec": 10038.137,
    "end_sec": 10039.897,
    "zh": "我就会在原地来回打穿",
    "vi": "Ta sẽ chỉ đi vòng quanh tại chỗ."
  },
  {
    "idx": 6035,
    "start": "02:47:19,897",
    "end": "02:47:21,957",
    "start_sec": 10039.897,
    "end_sec": 10041.957,
    "zh": "长子皮踏了眼小梦底",
    "vi": "Trương Tử Bì nhìn xuống Tiểu Mặc Kê."
  },
  {
    "idx": 6036,
    "start": "02:47:21,957",
    "end": "02:47:23,757",
    "start_sec": 10041.957,
    "end_sec": 10043.757,
    "zh": "人的想法杂乱容易改变",
    "vi": "Suy nghĩ của con người rất hỗn loạn và dễ thay đổi."
  },
  {
    "idx": 6037,
    "start": "02:47:23,757",
    "end": "02:47:24,677",
    "start_sec": 10043.757,
    "end_sec": 10044.677,
    "zh": "那狗呢",
    "vi": "Vậy còn chó thì sao."
  },
  {
    "idx": 6038,
    "start": "02:47:24,677",
    "end": "02:47:25,597",
    "start_sec": 10044.677,
    "end_sec": 10045.597,
    "zh": "小磨叽",
    "vi": "Tiểu Mặc Kê."
  },
  {
    "idx": 6039,
    "start": "02:47:25,597",
    "end": "02:47:26,157",
    "start_sec": 10045.597,
    "end_sec": 10046.157,
    "zh": "走",
    "vi": "Đi nào."
  },
  {
    "idx": 6040,
    "start": "02:47:26,157",
    "end": "02:47:27,517",
    "start_sec": 10046.157,
    "end_sec": 10047.517,
    "zh": "带我找到入口",
    "vi": "Dẫn ta tìm thấy lối vào."
  },
  {
    "idx": 6041,
    "start": "02:47:27,517",
    "end": "02:47:32,957",
    "start_sec": 10047.517,
    "end_sec": 10052.957,
    "zh": "长者皮故意让小磨叽去找入口",
    "vi": "Trương Tử Bì cố ý để Tiểu Mặc Kê đi tìm lối vào."
  },
  {
    "idx": 6042,
    "start": "02:47:32,957",
    "end": "02:47:35,377",
    "start_sec": 10052.957,
    "end_sec": 10055.377,
    "zh": "小磨叽就跟坚定不移的去找入口",
    "vi": "Tiểu Mặc Kê kiên định đi tìm lối vào."
  },
  {
    "idx": 6043,
    "start": "02:47:35,377",
    "end": "02:47:37,397",
    "start_sec": 10055.377,
    "end_sec": 10057.397,
    "zh": "再加上石箱腿的逆向规则",
    "vi": "Cộng thêm quy tắc ngược của Thạch Tương Thối."
  },
  {
    "idx": 6044,
    "start": "02:47:37,397",
    "end": "02:47:40,157",
    "start_sec": 10057.397,
    "end_sec": 10060.157,
    "zh": "那么他们狗子坚定不移的方向就是出口",
    "vi": "Thì hướng đi kiên định của chú chó chính là lối ra."
  },
  {
    "idx": 6045,
    "start": "02:47:40,157",
    "end": "02:47:41,537",
    "start_sec": 10060.157,
    "end_sec": 10061.537,
    "zh": "果然",
    "vi": "Quả nhiên."
  },
  {
    "idx": 6046,
    "start": "02:47:41,537",
    "end": "02:47:43,557",
    "start_sec": 10061.537,
    "end_sec": 10063.557,
    "zh": "随着小磨叽的一路的狂奔",
    "vi": "Theo bước chạy điên cuồng của Tiểu Mặc Kê."
  },
  {
    "idx": 6047,
    "start": "02:47:43,557",
    "end": "02:47:45,057",
    "start_sec": 10063.557,
    "end_sec": 10065.057,
    "zh": "长者皮跟着他",
    "vi": "Trương Tử Bì đi theo nó."
  },
  {
    "idx": 6048,
    "start": "02:47:45,057",
    "end": "02:47:46,897",
    "start_sec": 10065.057,
    "end_sec": 10066.897,
    "zh": "来到了那个熟悉的石堆前",
    "vi": "Đến trước đống đá quen thuộc đó."
  },
  {
    "idx": 6049,
    "start": "02:47:46,897",
    "end": "02:47:50,417",
    "start_sec": 10066.897,
    "end_sec": 10070.417,
    "zh": "这里果然是正确的前进方向",
    "vi": "Nơi này quả nhiên là hướng đi chính xác."
  },
  {
    "idx": 6050,
    "start": "02:47:51,957",
    "end": "02:47:55,417",
    "start_sec": 10071.957,
    "end_sec": 10075.417,
    "zh": "这是五明",
    "vi": "Đây là Ngũ Minh."
  },
  {
    "idx": 6051,
    "start": "02:47:55,417",
    "end": "02:47:56,797",
    "start_sec": 10075.417,
    "end_sec": 10076.797,
    "zh": "也就是第二炷香",
    "vi": "Cũng chính là nén hương thứ hai."
  },
  {
    "idx": 6052,
    "start": "02:47:56,797",
    "end": "02:47:58,357",
    "start_sec": 10076.797,
    "end_sec": 10078.357,
    "zh": "头和手臂都还在",
    "vi": "Đầu và cánh tay vẫn còn."
  },
  {
    "idx": 6053,
    "start": "02:47:58,357",
    "end": "02:47:59,517",
    "start_sec": 10078.357,
    "end_sec": 10079.517,
    "zh": "只有脖子被打断",
    "vi": "Chỉ có cổ là bị bẻ gãy."
  },
  {
    "idx": 6054,
    "start": "02:47:59,517",
    "end": "02:48:00,477",
    "start_sec": 10079.517,
    "end_sec": 10080.477,
    "zh": "看这模样",
    "vi": "Nhìn dáng vẻ này."
  },
  {
    "idx": 6055,
    "start": "02:48:00,477",
    "end": "02:48:02,877",
    "start_sec": 10080.477,
    "end_sec": 10082.877,
    "zh": "此前应该承受了极大的痛苦",
    "vi": "Trước đó chắc hẳn đã phải chịu đau đớn tột cùng."
  },
  {
    "idx": 6056,
    "start": "02:48:02,877",
    "end": "02:48:04,817",
    "start_sec": 10082.877,
    "end_sec": 10084.817,
    "zh": "五明要比第一炷香高不少",
    "vi": "Ngũ Minh cao hơn nén hương thứ nhất khá nhiều."
  },
  {
    "idx": 6057,
    "start": "02:48:04,817",
    "end": "02:48:06,457",
    "start_sec": 10084.817,
    "end_sec": 10086.457,
    "zh": "所以是中间的第二炷香",
    "vi": "Nên nó là nén hương thứ hai ở giữa."
  },
  {
    "idx": 6058,
    "start": "02:48:06,457",
    "end": "02:48:08,557",
    "start_sec": 10086.457,
    "end_sec": 10088.557,
    "zh": "那么第三炷香应该是短香",
    "vi": "Vậy thì nén hương thứ ba chắc là nén hương ngắn."
  },
  {
    "idx": 6059,
    "start": "02:48:08,557",
    "end": "02:48:10,377",
    "start_sec": 10088.557,
    "end_sec": 10090.377,
    "zh": "也会被削去脑袋和手臂吧",
    "vi": "Cũng sẽ bị chặt đầu và cánh tay chứ."
  },
  {
    "idx": 6060,
    "start": "02:48:10,377",
    "end": "02:48:12,577",
    "start_sec": 10090.377,
    "end_sec": 10092.577,
    "zh": "但是刚才看徐东来的模样",
    "vi": "Nhưng nhìn dáng vẻ của Từ Đông Lai vừa rồi."
  },
  {
    "idx": 6061,
    "start": "02:48:12,577",
    "end": "02:48:13,697",
    "start_sec": 10092.577,
    "end_sec": 10093.697,
    "zh": "还有他说的",
    "vi": "Còn cả câu anh ta nói nữa."
  },
  {
    "idx": 6062,
    "start": "02:48:13,697",
    "end": "02:48:15,057",
    "start_sec": 10093.697,
    "end_sec": 10095.057,
    "zh": "倩倩就不会死了",
    "vi": "Thiến Thiến sẽ không phải chết."
  },
  {
    "idx": 6063,
    "start": "02:48:15,057",
    "end": "02:48:16,717",
    "start_sec": 10095.057,
    "end_sec": 10096.717,
    "zh": "仿佛他早就断定",
    "vi": "Giống như anh ta đã sớm khẳng định rằng."
  },
  {
    "idx": 6064,
    "start": "02:48:16,717",
    "end": "02:48:18,757",
    "start_sec": 10096.717,
    "end_sec": 10098.757,
    "zh": "他们这些人除了徐东来自己",
    "vi": "Những người này ngoại trừ bản thân Từ Đông Lai ra."
  },
  {
    "idx": 6065,
    "start": "02:48:18,757",
    "end": "02:48:20,037",
    "start_sec": 10098.757,
    "end_sec": 10100.037,
    "zh": "其他人都要死",
    "vi": "Những người khác đều phải chết."
  },
  {
    "idx": 6066,
    "start": "02:48:20,037",
    "end": "02:48:21,277",
    "start_sec": 10100.037,
    "end_sec": 10101.277,
    "zh": "如果死的话",
    "vi": "Nếu như chết."
  },
  {
    "idx": 6067,
    "start": "02:48:21,277",
    "end": "02:48:23,757",
    "start_sec": 10101.277,
    "end_sec": 10103.757,
    "zh": "那人数和箱数不对应",
    "vi": "Thì số người và số nén hương không khớp nhau."
  },
  {
    "idx": 6068,
    "start": "02:48:23,757",
    "end": "02:48:24,997",
    "start_sec": 10103.757,
    "end_sec": 10104.997,
    "zh": "不对",
    "vi": "Không đúng."
  },
  {
    "idx": 6069,
    "start": "02:48:24,997",
    "end": "02:48:28,417",
    "start_sec": 10104.997,
    "end_sec": 10108.417,
    "zh": "我潜意识里一直都是要贡献三炷香",
    "vi": "Trong tiềm thức của tôi luôn nghĩ là phải dâng ba nén hương."
  },
  {
    "idx": 6070,
    "start": "02:48:28,417",
    "end": "02:48:29,677",
    "start_sec": 10108.417,
    "end_sec": 10109.677,
    "zh": "如果是五炷香",
    "vi": "Nếu như là năm nén hương."
  },
  {
    "idx": 6071,
    "start": "02:48:29,677",
    "end": "02:48:31,817",
    "start_sec": 10109.677,
    "end_sec": 10111.817,
    "zh": "那么人数就对应得上了",
    "vi": "Thì số người sẽ khớp nhau rồi."
  },
  {
    "idx": 6072,
    "start": "02:48:31,817",
    "end": "02:48:32,577",
    "start_sec": 10111.817,
    "end_sec": 10112.577,
    "zh": "是啊",
    "vi": "Đúng vậy."
  },
  {
    "idx": 6073,
    "start": "02:48:32,577",
    "end": "02:48:34,617",
    "start_sec": 10112.577,
    "end_sec": 10114.617,
    "zh": "三炷香请神显灵",
    "vi": "Ba nén hương là để thỉnh thần hiển linh."
  },
  {
    "idx": 6074,
    "start": "02:48:34,617",
    "end": "02:48:36,097",
    "start_sec": 10114.617,
    "end_sec": 10116.097,
    "zh": "但隧道里只有鬼",
    "vi": "Nhưng trong đường hầm chỉ có quỷ."
  },
  {
    "idx": 6075,
    "start": "02:48:36,097",
    "end": "02:48:38,677",
    "start_sec": 10116.097,
    "end_sec": 10118.677,
    "zh": "五炷香才是驱邪除魔",
    "vi": "Năm nén hương mới là để trừ tà diệt ma."
  },
  {
    "idx": 6076,
    "start": "02:48:38,677",
    "end": "02:48:41,897",
    "start_sec": 10118.677,
    "end_sec": 10121.897,
    "zh": "自己扩张着",
    "vi": "Tự mình suy diễn thêm."
  },
  {
    "idx": 6077,
    "start": "02:48:41,897",
    "end": "02:48:43,997",
    "start_sec": 10121.897,
    "end_sec": 10123.997,
    "zh": "常子皮精神看了好一会儿视频",
    "vi": "Thường Tử Bì tập trung xem video một lúc lâu."
  },
  {
    "idx": 6078,
    "start": "02:48:43,997",
    "end": "02:48:46,877",
    "start_sec": 10123.997,
    "end_sec": 10126.877,
    "zh": "可是徐东二和罗倩倩给鬼送香",
    "vi": "Nhưng Từ Đông Lai và La Thiến Thiến dâng hương cho quỷ."
  },
  {
    "idx": 6079,
    "start": "02:48:46,877",
    "end": "02:48:48,877",
    "start_sec": 10126.877,
    "end_sec": 10128.877,
    "zh": "目的就是为了走出十三隧道门",
    "vi": "Mục đích chính là để đi ra khỏi cánh cửa đường hầm số mười ba."
  },
  {
    "idx": 6080,
    "start": "02:48:48,877",
    "end": "02:48:50,877",
    "start_sec": 10128.877,
    "end_sec": 10130.877,
    "zh": "和十三鬼的逆反规则反着来",
    "vi": "Làm ngược lại với quy tắc nghịch đảo của mười ba con quỷ."
  },
  {
    "idx": 6081,
    "start": "02:48:50,877",
    "end": "02:48:53,317",
    "start_sec": 10130.877,
    "end_sec": 10133.317,
    "zh": "难道不才是走出隧道的办法吗",
    "vi": "Chẳng lẽ đó mới là cách để đi ra khỏi đường hầm sao."
  },
  {
    "idx": 6082,
    "start": "02:48:53,317",
    "end": "02:48:56,437",
    "start_sec": 10133.317,
    "end_sec": 10136.437,
    "zh": "长者皮突然对自己的推断有些更了解了",
    "vi": "Thường Tử Bì đột nhiên hiểu rõ hơn về suy luận của mình."
  },
  {
    "idx": 6083,
    "start": "02:48:56,437",
    "end": "02:48:56,917",
    "start_sec": 10136.437,
    "end_sec": 10136.917,
    "zh": "算了",
    "vi": "Bỏ đi."
  },
  {
    "idx": 6084,
    "start": "02:48:56,917",
    "end": "02:48:58,157",
    "start_sec": 10136.917,
    "end_sec": 10138.157,
    "zh": "你爱怎样怎样",
    "vi": "Cậu muốn thế nào thì tùy."
  },
  {
    "idx": 6085,
    "start": "02:48:58,157",
    "end": "02:49:01,037",
    "start_sec": 10138.157,
    "end_sec": 10141.037,
    "zh": "我只要试着走出深山隧道就好",
    "vi": "Tôi chỉ cần cố gắng đi ra khỏi đường hầm trong núi sâu này là được."
  },
  {
    "idx": 6086,
    "start": "02:49:01,037",
    "end": "02:49:01,617",
    "start_sec": 10141.037,
    "end_sec": 10141.617,
    "zh": "小墨迹",
    "vi": "Tiểu Mặc Tích."
  },
  {
    "idx": 6087,
    "start": "02:49:01,617",
    "end": "02:49:02,437",
    "start_sec": 10141.617,
    "end_sec": 10142.437,
    "zh": "接着走",
    "vi": "Đi tiếp thôi."
  },
  {
    "idx": 6088,
    "start": "02:49:02,437",
    "end": "02:49:04,517",
    "start_sec": 10142.437,
    "end_sec": 10144.517,
    "zh": "一人一口绕着隧道",
    "vi": "Từng người một đi vòng quanh đường hầm."
  },
  {
    "idx": 6089,
    "start": "02:49:04,517",
    "end": "02:49:06,737",
    "start_sec": 10144.517,
    "end_sec": 10146.737,
    "zh": "朝着最后的碎石通道走进",
    "vi": "Đi về phía lối đi đầy đá vụn ở cuối đường."
  },
  {
    "idx": 6090,
    "start": "02:49:06,737",
    "end": "02:49:09,757",
    "start_sec": 10146.737,
    "end_sec": 10149.757,
    "zh": "我操",
    "vi": "Chết tiệt."
  },
  {
    "idx": 6091,
    "start": "02:49:09,757",
    "end": "02:49:11,237",
    "start_sec": 10149.757,
    "end_sec": 10151.237,
    "zh": "深山隧道的尽头",
    "vi": "Phía cuối đường hầm trong núi sâu"
  },
  {
    "idx": 6092,
    "start": "02:49:11,237",
    "end": "02:49:14,077",
    "start_sec": 10151.237,
    "end_sec": 10154.077,
    "zh": "居然是一条被他帮基石堵塞的死路",
    "vi": "Lại là một con đường cụt bị đất đá sạt lở chặn đứng."
  },
  {
    "idx": 6093,
    "start": "02:49:14,077",
    "end": "02:49:15,117",
    "start_sec": 10154.077,
    "end_sec": 10155.117,
    "zh": "原来",
    "vi": "Hóa ra"
  },
  {
    "idx": 6094,
    "start": "02:49:15,117",
    "end": "02:49:16,897",
    "start_sec": 10155.117,
    "end_sec": 10156.897,
    "zh": "这里压根就没有出口",
    "vi": "Nơi này hoàn toàn không có lối ra."
  },
  {
    "idx": 6095,
    "start": "02:49:16,897",
    "end": "02:49:18,317",
    "start_sec": 10156.897,
    "end_sec": 10158.317,
    "zh": "怪不得体动来说",
    "vi": "Chẳng trách Từ Đông Lai nói"
  },
  {
    "idx": 6096,
    "start": "02:49:18,317",
    "end": "02:49:19,917",
    "start_sec": 10158.317,
    "end_sec": 10159.917,
    "zh": "隧道一开始就是死局",
    "vi": "Đường hầm này ngay từ đầu đã là một ngõ cụt."
  },
  {
    "idx": 6097,
    "start": "02:49:19,917",
    "end": "02:49:21,877",
    "start_sec": 10159.917,
    "end_sec": 10161.877,
    "zh": "还有香炉",
    "vi": "Còn lư hương nữa."
  },
  {
    "idx": 6098,
    "start": "02:49:21,877",
    "end": "02:49:23,637",
    "start_sec": 10161.877,
    "end_sec": 10163.637,
    "zh": "我那么大一颗鬼数",
    "vi": "Tôi đổi một cây quỷ thụ lớn như vậy"
  },
  {
    "idx": 6099,
    "start": "02:49:23,637",
    "end": "02:49:25,817",
    "start_sec": 10163.637,
    "end_sec": 10165.817,
    "zh": "不换来你的假情报是吧",
    "vi": "Chỉ để lấy thông tin giả của ngươi thôi sao."
  },
  {
    "idx": 6100,
    "start": "02:49:25,817",
    "end": "02:49:26,957",
    "start_sec": 10165.817,
    "end_sec": 10166.957,
    "zh": "情报保证",
    "vi": "Thông tin đảm bảo chính xác."
  },
  {
    "idx": 6101,
    "start": "02:49:26,957",
    "end": "02:49:28,717",
    "start_sec": 10166.957,
    "end_sec": 10168.717,
    "zh": "深山隧道有方法出去",
    "vi": "Đường hầm núi sâu có cách để đi ra."
  },
  {
    "idx": 6102,
    "start": "02:49:28,717",
    "end": "02:49:30,877",
    "start_sec": 10168.717,
    "end_sec": 10170.877,
    "zh": "南城和大桥也有方法过",
    "vi": "Nam Thành và cầu lớn cũng có cách để đi qua."
  },
  {
    "idx": 6103,
    "start": "02:49:30,877",
    "end": "02:49:33,637",
    "start_sec": 10170.877,
    "end_sec": 10173.637,
    "zh": "我说的最优路线是最简单的路线",
    "vi": "Tuyến đường tối ưu tôi nói là tuyến đường đơn giản nhất."
  },
  {
    "idx": 6104,
    "start": "02:49:33,637",
    "end": "02:49:35,137",
    "start_sec": 10173.637,
    "end_sec": 10175.137,
    "zh": "但不代表没有障碍",
    "vi": "Nhưng không có nghĩa là không có chướng ngại vật."
  },
  {
    "idx": 6105,
    "start": "02:49:35,137",
    "end": "02:49:36,257",
    "start_sec": 10175.137,
    "end_sec": 10176.257,
    "zh": "也是",
    "vi": "Cũng đúng."
  },
  {
    "idx": 6106,
    "start": "02:49:36,257",
    "end": "02:49:38,217",
    "start_sec": 10176.257,
    "end_sec": 10178.217,
    "zh": "要是我走其他路线",
    "vi": "Nếu tôi đi con đường khác"
  },
  {
    "idx": 6107,
    "start": "02:49:38,217",
    "end": "02:49:39,677",
    "start_sec": 10178.217,
    "end_sec": 10179.677,
    "zh": "只不定碰上更强的鬼力",
    "vi": "Biết đâu lại đụng phải thế lực quỷ dị mạnh hơn."
  },
  {
    "idx": 6108,
    "start": "02:49:39,677",
    "end": "02:49:41,677",
    "start_sec": 10179.677,
    "end_sec": 10181.677,
    "zh": "既然正常路线出不去",
    "vi": "Đã không thể ra ngoài bằng con đường bình thường"
  },
  {
    "idx": 6109,
    "start": "02:49:41,677",
    "end": "02:49:42,837",
    "start_sec": 10181.677,
    "end_sec": 10182.837,
    "zh": "那么出去的方法",
    "vi": "Vậy thì cách để đi ra"
  },
  {
    "idx": 6110,
    "start": "02:49:42,837",
    "end": "02:49:44,537",
    "start_sec": 10182.837,
    "end_sec": 10184.537,
    "zh": "就要从石香鬼身上入手",
    "vi": "Phải bắt đầu từ chỗ Thực Hương Quỷ."
  },
  {
    "idx": 6111,
    "start": "02:49:44,537",
    "end": "02:49:46,277",
    "start_sec": 10184.537,
    "end_sec": 10186.277,
    "zh": "人吃蛋鬼吃香",
    "vi": "Người ăn cơm quỷ ăn hương."
  },
  {
    "idx": 6112,
    "start": "02:49:46,277",
    "end": "02:49:48,317",
    "start_sec": 10186.277,
    "end_sec": 10188.317,
    "zh": "过去的我查到松香人说过",
    "vi": "Bản thân tôi trong quá khứ từng tra được người đưa hương nói rằng"
  },
  {
    "idx": 6113,
    "start": "02:49:48,317",
    "end": "02:49:50,477",
    "start_sec": 10188.317,
    "end_sec": 10190.477,
    "zh": "给死在隧道他方里的人喂饱了香",
    "vi": "Cho những người chết trong vụ sập đường hầm ăn no hương"
  },
  {
    "idx": 6114,
    "start": "02:49:50,477",
    "end": "02:49:52,077",
    "start_sec": 10190.477,
    "end_sec": 10192.077,
    "zh": "他们会满足你一个愿望",
    "vi": "Họ sẽ thực hiện một nguyện vọng của ngươi."
  },
  {
    "idx": 6115,
    "start": "02:49:52,077",
    "end": "02:49:52,897",
    "start_sec": 10192.077,
    "end_sec": 10192.897,
    "zh": "这样的话",
    "vi": "Nếu đã như vậy"
  },
  {
    "idx": 6116,
    "start": "02:49:52,897",
    "end": "02:49:54,357",
    "start_sec": 10192.897,
    "end_sec": 10194.357,
    "zh": "把食香鬼喂饱了",
    "vi": "Cho Thực Hương Quỷ ăn no"
  },
  {
    "idx": 6117,
    "start": "02:49:54,357",
    "end": "02:49:57,165",
    "start_sec": 10194.357,
    "end_sec": 10197.165,
    "zh": "是不是就能许愿走出隧道所以徐东来和罗倩倩一直都在忽悠同伴当乡喂给吃香鬼要是只能通过许愿的方法走出碎岛",
    "vi": "Có phải là có thể ước để đi ra khỏi đường hầm"
  },
  {
    "idx": 6117,
    "start": "02:49:57,165",
    "end": "02:50:02,313",
    "start_sec": 10197.165,
    "end_sec": 10202.313,
    "zh": "是不是就能许愿走出隧道所以徐东来和罗倩倩一直都在忽悠同伴当乡喂给吃香鬼要是只能通过许愿的方法走出碎岛",
    "vi": "Cho nên Từ Đông Lai và La Thiến Thiến luôn lừa gạt đồng đội làm nhang để cho Thực Hương Quỷ ăn"
  },
  {
    "idx": 6117,
    "start": "02:50:02,313",
    "end": "02:50:05,354",
    "start_sec": 10202.313,
    "end_sec": 10205.354,
    "zh": "是不是就能许愿走出隧道所以徐东来和罗倩倩一直都在忽悠同伴当乡喂给吃香鬼要是只能通过许愿的方法走出碎岛",
    "vi": "Nếu chỉ có thể đi ra khỏi đường hầm bằng cách ước nguyện"
  },
  {
    "idx": 6118,
    "start": "02:50:05,354",
    "end": "02:50:07,574",
    "start_sec": 10205.354,
    "end_sec": 10207.574,
    "zh": "那这个吃香鬼现在还不能消失",
    "vi": "Thì con Thực Hương Quỷ này hiện tại vẫn chưa thể biến mất."
  },
  {
    "idx": 6119,
    "start": "02:50:07,574",
    "end": "02:50:09,074",
    "start_sec": 10207.574,
    "end_sec": 10209.074,
    "zh": "不然我找谁许愿去",
    "vi": "Nếu không tôi biết tìm ai để ước đây."
  },
  {
    "idx": 6120,
    "start": "02:50:09,074",
    "end": "02:50:11,474",
    "start_sec": 10209.074,
    "end_sec": 10211.474,
    "zh": "橙子皮猛的反应过来",
    "vi": "Trần Tử Bì chợt nhận ra."
  },
  {
    "idx": 6121,
    "start": "02:50:11,474",
    "end": "02:50:12,514",
    "start_sec": 10211.474,
    "end_sec": 10212.514,
    "zh": "刚刚在加油站",
    "vi": "Vừa rồi ở trạm xăng"
  },
  {
    "idx": 6122,
    "start": "02:50:12,514",
    "end": "02:50:14,994",
    "start_sec": 10212.514,
    "end_sec": 10214.994,
    "zh": "他还让过去的自己去劝说送香人",
    "vi": "Anh ta còn bảo bản thân trong quá khứ đi khuyên nhủ người gửi nhang"
  },
  {
    "idx": 6123,
    "start": "02:50:14,994",
    "end": "02:50:16,174",
    "start_sec": 10214.994,
    "end_sec": 10216.174,
    "zh": "不要去深山碎岛",
    "vi": "Đừng đi đến đảo đá trong núi sâu"
  },
  {
    "idx": 6124,
    "start": "02:50:16,174",
    "end": "02:50:19,154",
    "start_sec": 10216.174,
    "end_sec": 10219.154,
    "zh": "此时过去的自己也发来了消息",
    "vi": "Lúc này bản thân trong quá khứ cũng gửi tin nhắn đến"
  },
  {
    "idx": 6125,
    "start": "02:50:19,154",
    "end": "02:50:19,814",
    "start_sec": 10219.154,
    "end_sec": 10219.814,
    "zh": "喂",
    "vi": "Alo"
  },
  {
    "idx": 6126,
    "start": "02:50:19,814",
    "end": "02:50:22,314",
    "start_sec": 10219.814,
    "end_sec": 10222.314,
    "zh": "我跟贴把底的送香人联系上了",
    "vi": "Tôi đã liên lạc được với người gửi nhang ở dưới bài đăng rồi"
  },
  {
    "idx": 6127,
    "start": "02:50:22,314",
    "end": "02:50:23,834",
    "start_sec": 10222.314,
    "end_sec": 10223.834,
    "zh": "最近深山碎岛又塌了",
    "vi": "Gần đây đảo đá trong núi sâu lại bị sập"
  },
  {
    "idx": 6128,
    "start": "02:50:23,834",
    "end": "02:50:26,274",
    "start_sec": 10223.834,
    "end_sec": 10226.274,
    "zh": "宋相仁本人去现场帮忙了",
    "vi": "Bản thân Tống Tương Nhân đã đến hiện trường để giúp đỡ"
  },
  {
    "idx": 6129,
    "start": "02:50:26,274",
    "end": "02:50:27,174",
    "start_sec": 10226.274,
    "end_sec": 10227.174,
    "zh": "现在这个账号",
    "vi": "Tài khoản này hiện tại"
  },
  {
    "idx": 6130,
    "start": "02:50:27,174",
    "end": "02:50:28,834",
    "start_sec": 10227.174,
    "end_sec": 10228.834,
    "zh": "是由他孙女带来的运营",
    "vi": "Là do cháu gái của ông ấy quản lý"
  },
  {
    "idx": 6131,
    "start": "02:50:28,834",
    "end": "02:50:31,174",
    "start_sec": 10228.834,
    "end_sec": 10231.174,
    "zh": "他孙女说要坚持爆荒劣质工程",
    "vi": "Cháu gái ông ấy nói muốn kiên trì vạch trần công trình kém chất lượng"
  },
  {
    "idx": 6132,
    "start": "02:50:31,174",
    "end": "02:50:33,434",
    "start_sec": 10231.174,
    "end_sec": 10233.434,
    "zh": "所以这个账号一直在活跃",
    "vi": "Nên tài khoản này vẫn luôn hoạt động"
  },
  {
    "idx": 6133,
    "start": "02:50:33,434",
    "end": "02:50:34,734",
    "start_sec": 10233.434,
    "end_sec": 10234.734,
    "zh": "我已经劝了他",
    "vi": "Tôi đã khuyên cô ấy rồi"
  },
  {
    "idx": 6134,
    "start": "02:50:34,734",
    "end": "02:50:36,034",
    "start_sec": 10234.734,
    "end_sec": 10236.034,
    "zh": "要他管住他爷爷",
    "vi": "Bảo cô ấy phải quản lý ông nội của mình"
  },
  {
    "idx": 6135,
    "start": "02:50:36,034",
    "end": "02:50:37,834",
    "start_sec": 10236.034,
    "end_sec": 10237.834,
    "zh": "隧道随时还有他放的可能",
    "vi": "Đường hầm vẫn có khả năng bị sập bất cứ lúc nào"
  },
  {
    "idx": 6136,
    "start": "02:50:37,834",
    "end": "02:50:38,974",
    "start_sec": 10237.834,
    "end_sec": 10238.974,
    "zh": "我操",
    "vi": "Chết tiệt"
  },
  {
    "idx": 6137,
    "start": "02:50:38,974",
    "end": "02:50:40,194",
    "start_sec": 10238.974,
    "end_sec": 10240.194,
    "zh": "怎么了吗",
    "vi": "Có chuyện gì vậy."
  },
  {
    "idx": 6138,
    "start": "02:50:40,194",
    "end": "02:50:41,534",
    "start_sec": 10240.194,
    "end_sec": 10241.534,
    "zh": "你要是救下宋相仁",
    "vi": "Nếu bạn cứu Tống Tương Nhân"
  },
  {
    "idx": 6139,
    "start": "02:50:41,534",
    "end": "02:50:42,654",
    "start_sec": 10241.534,
    "end_sec": 10242.654,
    "zh": "我可就惨了",
    "vi": "Thì tôi sẽ thảm lắm đấy"
  },
  {
    "idx": 6140,
    "start": "02:50:42,654",
    "end": "02:50:43,794",
    "start_sec": 10242.654,
    "end_sec": 10243.794,
    "zh": "他变成了吃香鬼",
    "vi": "Ông ta đã biến thành Thực Hương Quỷ"
  },
  {
    "idx": 6141,
    "start": "02:50:43,794",
    "end": "02:50:45,134",
    "start_sec": 10243.794,
    "end_sec": 10245.134,
    "zh": "我现在能不能出隧道",
    "vi": "Bây giờ tôi có thể ra khỏi đường hầm hay không"
  },
  {
    "idx": 6142,
    "start": "02:50:45,134",
    "end": "02:50:46,294",
    "start_sec": 10245.134,
    "end_sec": 10246.294,
    "zh": "可就靠他了",
    "vi": "Đều phải trông cậy vào ông ta đấy"
  },
  {
    "idx": 6143,
    "start": "02:50:46,294",
    "end": "02:50:47,534",
    "start_sec": 10246.294,
    "end_sec": 10247.534,
    "zh": "一个月前的我",
    "vi": "Bản thân tôi của một tháng trước"
  },
  {
    "idx": 6144,
    "start": "02:50:47,534",
    "end": "02:50:49,714",
    "start_sec": 10247.534,
    "end_sec": 10249.714,
    "zh": "还真是个热心肠的老好人啊",
    "vi": "Đúng là một người tốt bụng nhiệt tình mà"
  },
  {
    "idx": 6145,
    "start": "02:50:49,714",
    "end": "02:50:51,014",
    "start_sec": 10249.714,
    "end_sec": 10251.014,
    "zh": "本以为无望走出隧道",
    "vi": "Vốn tưởng rằng không còn hy vọng ra khỏi đường hầm"
  },
  {
    "idx": 6146,
    "start": "02:50:51,014",
    "end": "02:50:52,654",
    "start_sec": 10251.014,
    "end_sec": 10252.654,
    "zh": "只能换入现在的成熟题",
    "vi": "Chỉ có thể đổi sang cơ thể trưởng thành hiện tại"
  },
  {
    "idx": 6147,
    "start": "02:50:52,654",
    "end": "02:50:53,534",
    "start_sec": 10252.654,
    "end_sec": 10253.534,
    "zh": "惊喜的法轮",
    "vi": "Kinh ngạc phát hiện ra"
  },
  {
    "idx": 6148,
    "start": "02:50:53,534",
    "end": "02:50:55,334",
    "start_sec": 10253.534,
    "end_sec": 10255.334,
    "zh": "隧道里的烟雾依旧浓郁",
    "vi": "Khói sương trong đường hầm vẫn dày đặc như cũ"
  },
  {
    "idx": 6149,
    "start": "02:50:55,334",
    "end": "02:50:57,254",
    "start_sec": 10255.334,
    "end_sec": 10257.254,
    "zh": "没有半点要消失的痕迹",
    "vi": "Không có chút dấu vết nào là sắp biến mất"
  },
  {
    "idx": 6150,
    "start": "02:50:57,254",
    "end": "02:50:57,834",
    "start_sec": 10257.254,
    "end_sec": 10257.834,
    "zh": "看来",
    "vi": "Xem ra"
  },
  {
    "idx": 6151,
    "start": "02:50:57,834",
    "end": "02:50:59,714",
    "start_sec": 10257.834,
    "end_sec": 10259.714,
    "zh": "送香人被隧道他方砸死的",
    "vi": "Người đưa hương bị sập hầm đè chết."
  },
  {
    "idx": 6152,
    "start": "02:50:59,714",
    "end": "02:51:01,234",
    "start_sec": 10259.714,
    "end_sec": 10261.234,
    "zh": "既定事实还没被改变",
    "vi": "Sự thật đã định vẫn chưa bị thay đổi."
  },
  {
    "idx": 6153,
    "start": "02:51:01,234",
    "end": "02:51:01,934",
    "start_sec": 10261.234,
    "end_sec": 10261.934,
    "zh": "也是",
    "vi": "Cũng đúng."
  },
  {
    "idx": 6154,
    "start": "02:51:01,934",
    "end": "02:51:03,834",
    "start_sec": 10261.934,
    "end_sec": 10263.834,
    "zh": "一个一辈子都在送香",
    "vi": "Một người cả đời đi đưa hương"
  },
  {
    "idx": 6155,
    "start": "02:51:03,834",
    "end": "02:51:05,454",
    "start_sec": 10263.834,
    "end_sec": 10265.454,
    "zh": "和某些势力做斗争的人",
    "vi": "và đấu tranh với các thế lực nào đó"
  },
  {
    "idx": 6156,
    "start": "02:51:05,454",
    "end": "02:51:06,474",
    "start_sec": 10265.454,
    "end_sec": 10266.474,
    "zh": "怎么可能因为",
    "vi": "sao có thể chỉ vì"
  },
  {
    "idx": 6157,
    "start": "02:51:06,474",
    "end": "02:51:07,874",
    "start_sec": 10266.474,
    "end_sec": 10267.874,
    "zh": "陌生网友的三两句劝说",
    "vi": "vài lời khuyên của cư dân mạng xa lạ"
  },
  {
    "idx": 6158,
    "start": "02:51:07,874",
    "end": "02:51:09,634",
    "start_sec": 10267.874,
    "end_sec": 10269.634,
    "zh": "就放弃每天的送香呢",
    "vi": "mà từ bỏ việc đưa hương mỗi ngày chứ."
  },
  {
    "idx": 6159,
    "start": "02:51:09,634",
    "end": "02:51:10,794",
    "start_sec": 10269.634,
    "end_sec": 10270.794,
    "zh": "死神鬼的诞生",
    "vi": "Sự ra đời của Tử Thần Quỷ"
  },
  {
    "idx": 6160,
    "start": "02:51:10,794",
    "end": "02:51:11,774",
    "start_sec": 10270.794,
    "end_sec": 10271.774,
    "zh": "不是偶然",
    "vi": "không phải là ngẫu nhiên"
  },
  {
    "idx": 6161,
    "start": "02:51:11,774",
    "end": "02:51:12,734",
    "start_sec": 10271.774,
    "end_sec": 10272.734,
    "zh": "而是必然",
    "vi": "mà là điều tất yếu."
  },
  {
    "idx": 6162,
    "start": "02:51:12,734",
    "end": "02:51:14,334",
    "start_sec": 10272.734,
    "end_sec": 10274.334,
    "zh": "对了",
    "vi": "Đúng rồi."
  },
  {
    "idx": 6163,
    "start": "02:51:14,334",
    "end": "02:51:15,674",
    "start_sec": 10274.334,
    "end_sec": 10275.674,
    "zh": "我和送香人的婚姻",
    "vi": "Tôi và em gái của người đưa hương"
  },
  {
    "idx": 6164,
    "start": "02:51:15,674",
    "end": "02:51:16,614",
    "start_sec": 10275.674,
    "end_sec": 10276.614,
    "zh": "聊得挺来的",
    "vi": "nói chuyện khá hợp nhau."
  },
  {
    "idx": 6165,
    "start": "02:51:16,614",
    "end": "02:51:18,254",
    "start_sec": 10276.614,
    "end_sec": 10278.254,
    "zh": "我给他转发了帖子",
    "vi": "Tôi đã chia sẻ bài viết cho cô ấy."
  },
  {
    "idx": 6166,
    "start": "02:51:18,254",
    "end": "02:51:19,734",
    "start_sec": 10278.254,
    "end_sec": 10279.734,
    "zh": "他说要请我吃饭呢",
    "vi": "Cô ấy nói muốn mời tôi đi ăn."
  },
  {
    "idx": 6167,
    "start": "02:51:19,734",
    "end": "02:51:21,314",
    "start_sec": 10279.734,
    "end_sec": 10281.314,
    "zh": "是个大学生妹妹呢",
    "vi": "Cô ấy là một nữ sinh đại học đó."
  },
  {
    "idx": 6168,
    "start": "02:51:21,314",
    "end": "02:51:22,274",
    "start_sec": 10281.314,
    "end_sec": 10282.274,
    "zh": "说正事",
    "vi": "Nói chuyện chính đi."
  },
  {
    "idx": 6169,
    "start": "02:51:22,274",
    "end": "02:51:23,514",
    "start_sec": 10282.274,
    "end_sec": 10283.514,
    "zh": "还有其他信息吗",
    "vi": "Còn thông tin nào khác không."
  },
  {
    "idx": 6170,
    "start": "02:51:23,514",
    "end": "02:51:24,154",
    "start_sec": 10283.514,
    "end_sec": 10284.154,
    "zh": "有",
    "vi": "Có."
  },
  {
    "idx": 6171,
    "start": "02:51:24,154",
    "end": "02:51:25,714",
    "start_sec": 10284.154,
    "end_sec": 10285.714,
    "zh": "这个妹妹挺纠结的",
    "vi": "Cô em này đang khá đắn đo."
  },
  {
    "idx": 6172,
    "start": "02:51:25,714",
    "end": "02:51:27,634",
    "start_sec": 10285.714,
    "end_sec": 10287.634,
    "zh": "她好像接触到了一些上层圈子",
    "vi": "Hình như cô ấy đã tiếp xúc với giới thượng lưu."
  },
  {
    "idx": 6173,
    "start": "02:51:27,634",
    "end": "02:51:28,374",
    "start_sec": 10287.634,
    "end_sec": 10288.374,
    "zh": "据她说",
    "vi": "Theo lời cô ấy kể"
  },
  {
    "idx": 6174,
    "start": "02:51:28,374",
    "end": "02:51:29,954",
    "start_sec": 10288.374,
    "end_sec": 10289.954,
    "zh": "如果有这个圈子的人帮忙",
    "vi": "nếu có người trong giới đó giúp đỡ"
  },
  {
    "idx": 6175,
    "start": "02:51:29,954",
    "end": "02:51:31,714",
    "start_sec": 10289.954,
    "end_sec": 10291.714,
    "zh": "她应该可以摆挡那四个企业",
    "vi": "cô ấy có thể thoát khỏi bốn doanh nghiệp đó."
  },
  {
    "idx": 6176,
    "start": "02:51:31,714",
    "end": "02:51:32,354",
    "start_sec": 10291.714,
    "end_sec": 10292.354,
    "zh": "是不",
    "vi": "Có điều."
  },
  {
    "idx": 6177,
    "start": "02:51:32,354",
    "end": "02:51:33,694",
    "start_sec": 10292.354,
    "end_sec": 10293.694,
    "zh": "那个圈子的人",
    "vi": "những người trong giới đó"
  },
  {
    "idx": 6178,
    "start": "02:51:33,694",
    "end": "02:51:35,694",
    "start_sec": 10293.694,
    "end_sec": 10295.694,
    "zh": "要她伪造很多子虚乌有的经历",
    "vi": "yêu cầu cô ấy làm giả nhiều trải nghiệm không có thật"
  },
  {
    "idx": 6179,
    "start": "02:51:35,694",
    "end": "02:51:36,434",
    "start_sec": 10295.694,
    "end_sec": 10296.434,
    "zh": "她还说",
    "vi": "cô ấy còn nói"
  },
  {
    "idx": 6180,
    "start": "02:51:36,434",
    "end": "02:51:37,774",
    "start_sec": 10296.434,
    "end_sec": 10297.774,
    "zh": "可能要陪某些人来上",
    "vi": "có thể phải đi tiếp vài người."
  },
  {
    "idx": 6181,
    "start": "02:51:37,774",
    "end": "02:51:39,794",
    "start_sec": 10297.774,
    "end_sec": 10299.794,
    "zh": "她说的那四个企业是什么",
    "vi": "Bốn doanh nghiệp mà cô ấy nói là gì vậy."
  },
  {
    "idx": 6182,
    "start": "02:51:39,794",
    "end": "02:51:42,574",
    "start_sec": 10299.794,
    "end_sec": 10302.574,
    "zh": "就是用劣质材料建造最高的企业吗",
    "vi": "Có phải là những doanh nghiệp dùng vật liệu kém chất lượng để xây dựng công trình cao nhất không."
  },
  {
    "idx": 6183,
    "start": "02:51:42,574",
    "end": "02:51:43,514",
    "start_sec": 10302.574,
    "end_sec": 10303.514,
    "zh": "对",
    "vi": "Đúng vậy."
  },
  {
    "idx": 6184,
    "start": "02:51:43,514",
    "end": "02:51:44,514",
    "start_sec": 10303.514,
    "end_sec": 10304.514,
    "zh": "分别是",
    "vi": "Lần lượt là"
  },
  {
    "idx": 6185,
    "start": "02:51:44,514",
    "end": "02:51:45,394",
    "start_sec": 10304.514,
    "end_sec": 10305.394,
    "zh": "钞石中工",
    "vi": "Sao Thạch Trung Công"
  },
  {
    "idx": 6186,
    "start": "02:51:45,394",
    "end": "02:51:46,294",
    "start_sec": 10305.394,
    "end_sec": 10306.294,
    "zh": "无事管理",
    "vi": "Vô Sự Quản Lý"
  },
  {
    "idx": 6187,
    "start": "02:51:46,294",
    "end": "02:51:47,294",
    "start_sec": 10306.294,
    "end_sec": 10307.294,
    "zh": "无事开采",
    "vi": "Vô Sự Khai Thác"
  },
  {
    "idx": 6188,
    "start": "02:51:47,294",
    "end": "02:51:48,254",
    "start_sec": 10307.294,
    "end_sec": 10308.254,
    "zh": "随时运输",
    "vi": "Tùy Thời Vận Chuyển"
  },
  {
    "idx": 6189,
    "start": "02:51:48,254",
    "end": "02:51:49,454",
    "start_sec": 10308.254,
    "end_sec": 10309.454,
    "zh": "好家伙",
    "vi": "Hay thật đấy."
  },
  {
    "idx": 6190,
    "start": "02:51:49,454",
    "end": "02:51:50,134",
    "start_sec": 10309.454,
    "end_sec": 10310.134,
    "zh": "赵一卫",
    "vi": "Triệu Nhất Vệ"
  },
  {
    "idx": 6191,
    "start": "02:51:50,134",
    "end": "02:51:51,074",
    "start_sec": 10310.134,
    "end_sec": 10311.074,
    "zh": "吴亚平",
    "vi": "Ngô Á Bình"
  },
  {
    "idx": 6192,
    "start": "02:51:51,074",
    "end": "02:51:51,974",
    "start_sec": 10311.074,
    "end_sec": 10311.974,
    "zh": "李明",
    "vi": "Lý Minh"
  },
  {
    "idx": 6193,
    "start": "02:51:51,974",
    "end": "02:51:52,834",
    "start_sec": 10311.974,
    "end_sec": 10312.834,
    "zh": "云燃",
    "vi": "Vân Nhiên"
  },
  {
    "idx": 6194,
    "start": "02:51:52,834",
    "end": "02:51:54,134",
    "start_sec": 10312.834,
    "end_sec": 10314.134,
    "zh": "感情这罗倩倩",
    "vi": "Hóa ra La Thiến Thiến này"
  },
  {
    "idx": 6195,
    "start": "02:51:54,134",
    "end": "02:51:56,074",
    "start_sec": 10314.134,
    "end_sec": 10316.074,
    "zh": "是把私家独立企业的太子爷",
    "vi": "đã đem thiếu gia của bốn doanh nghiệp tư nhân độc lập này"
  },
  {
    "idx": 6196,
    "start": "02:51:56,074",
    "end": "02:51:57,174",
    "start_sec": 10316.074,
    "end_sec": 10317.174,
    "zh": "当乡送给鬼了",
    "vi": "làm vật tế dâng cho quỷ rồi."
  },
  {
    "idx": 6197,
    "start": "02:51:57,174",
    "end": "02:51:57,834",
    "start_sec": 10317.174,
    "end_sec": 10317.834,
    "zh": "对",
    "vi": "Đúng vậy."
  },
  {
    "idx": 6198,
    "start": "02:51:57,834",
    "end": "02:51:58,934",
    "start_sec": 10317.834,
    "end_sec": 10318.934,
    "zh": "送乡人的孙女",
    "vi": "Cháu gái của người tiễn hương"
  },
  {
    "idx": 6199,
    "start": "02:51:58,934",
    "end": "02:51:59,934",
    "start_sec": 10318.934,
    "end_sec": 10319.934,
    "zh": "就叫罗倩倩",
    "vi": "chính là La Thiến Thiến."
  },
  {
    "idx": 6200,
    "start": "02:51:59,934",
    "end": "02:52:00,834",
    "start_sec": 10319.934,
    "end_sec": 10320.834,
    "zh": "你记住她",
    "vi": "Bạn hãy nhớ kỹ cô ấy."
  },
  {
    "idx": 6201,
    "start": "02:52:00,834",
    "end": "02:52:02,094",
    "start_sec": 10320.834,
    "end_sec": 10322.094,
    "zh": "罗倩倩",
    "vi": "La Thiến Thiến."
  },
  {
    "idx": 6202,
    "start": "02:52:02,094",
    "end": "02:52:03,614",
    "start_sec": 10322.094,
    "end_sec": 10323.614,
    "zh": "竟然是徐香鬼的孙女",
    "vi": "Hóa ra lại là cháu gái của Từ Hương Quỷ."
  },
  {
    "idx": 6203,
    "start": "02:52:03,614",
    "end": "02:52:04,354",
    "start_sec": 10323.614,
    "end_sec": 10324.354,
    "zh": "罗倩倩",
    "vi": "La Thiến Thiến."
  },
  {
    "idx": 6204,
    "start": "02:52:04,354",
    "end": "02:52:05,214",
    "start_sec": 10324.354,
    "end_sec": 10325.214,
    "zh": "她咋了",
    "vi": "Cô ấy làm sao thế."
  },
  {
    "idx": 6205,
    "start": "02:52:05,214",
    "end": "02:52:06,234",
    "start_sec": 10325.214,
    "end_sec": 10326.234,
    "zh": "要是可以找她",
    "vi": "Nếu có thể tìm thấy cô ấy"
  },
  {
    "idx": 6206,
    "start": "02:52:06,234",
    "end": "02:52:07,334",
    "start_sec": 10326.234,
    "end_sec": 10327.334,
    "zh": "你帮帮她吧",
    "vi": "bạn hãy giúp đỡ cô ấy nhé."
  },
  {
    "idx": 6207,
    "start": "02:52:07,334",
    "end": "02:52:08,314",
    "start_sec": 10327.334,
    "end_sec": 10328.314,
    "zh": "挺可怜的一个女孩",
    "vi": "Một cô gái rất đáng thương"
  },
  {
    "idx": 6208,
    "start": "02:52:08,314",
    "end": "02:52:09,454",
    "start_sec": 10328.314,
    "end_sec": 10329.454,
    "zh": "一直跟着爷爷",
    "vi": "luôn đi theo ông nội"
  },
  {
    "idx": 6209,
    "start": "02:52:09,454",
    "end": "02:52:11,034",
    "start_sec": 10329.454,
    "end_sec": 10331.034,
    "zh": "与那些土败势力和斗争",
    "vi": "để đấu tranh với những thế lực thối nát đó."
  },
  {
    "idx": 6210,
    "start": "02:52:11,034",
    "end": "02:52:11,914",
    "start_sec": 10331.034,
    "end_sec": 10331.914,
    "zh": "到最后",
    "vi": "Cho đến cuối cùng"
  },
  {
    "idx": 6211,
    "start": "02:52:11,914",
    "end": "02:52:12,934",
    "start_sec": 10331.914,
    "end_sec": 10332.934,
    "zh": "爷爷也死了",
    "vi": "Ông nội cô ấy cũng đã mất rồi."
  },
  {
    "idx": 6212,
    "start": "02:52:12,934",
    "end": "02:52:14,234",
    "start_sec": 10332.934,
    "end_sec": 10334.234,
    "zh": "行",
    "vi": "Được thôi."
  },
  {
    "idx": 6213,
    "start": "02:52:14,234",
    "end": "02:52:15,234",
    "start_sec": 10334.234,
    "end_sec": 10335.234,
    "zh": "我答应你",
    "vi": "Tôi hứa với bạn."
  },
  {
    "idx": 6214,
    "start": "02:52:15,234",
    "end": "02:52:16,814",
    "start_sec": 10335.234,
    "end_sec": 10336.814,
    "zh": "她将会是徐东来口中的",
    "vi": "Cô ấy sẽ là người mà Từ Đông Lai nhắc đến."
  },
  {
    "idx": 6215,
    "start": "02:52:16,814",
    "end": "02:52:17,574",
    "start_sec": 10336.814,
    "end_sec": 10337.574,
    "zh": "最后一炷香",
    "vi": "Nén hương cuối cùng."
  },
  {
    "idx": 6216,
    "start": "02:52:17,574",
    "end": "02:52:18,674",
    "start_sec": 10337.574,
    "end_sec": 10338.674,
    "zh": "要是来得及的话",
    "vi": "Nếu còn kịp thời gian."
  },
  {
    "idx": 6217,
    "start": "02:52:18,674",
    "end": "02:52:19,834",
    "start_sec": 10338.674,
    "end_sec": 10339.834,
    "zh": "我就她一命",
    "vi": "Tôi sẽ cứu mạng cô ấy."
  },
  {
    "idx": 6218,
    "start": "02:52:19,834",
    "end": "02:52:23,154",
    "start_sec": 10339.834,
    "end_sec": 10343.154,
    "zh": "东来",
    "vi": "Đông Lai."
  },
  {
    "idx": 6219,
    "start": "02:52:23,154",
    "end": "02:52:23,794",
    "start_sec": 10343.154,
    "end_sec": 10343.794,
    "zh": "东来",
    "vi": "Đông Lai."
  },
  {
    "idx": 6220,
    "start": "02:52:23,794",
    "end": "02:52:25,274",
    "start_sec": 10343.794,
    "end_sec": 10345.274,
    "zh": "你为什么要丢下我",
    "vi": "Tại sao bạn lại bỏ rơi tôi."
  },
  {
    "idx": 6221,
    "start": "02:52:25,274",
    "end": "02:52:26,554",
    "start_sec": 10345.274,
    "end_sec": 10346.554,
    "zh": "就算是香鬼不吃",
    "vi": "Ngay cả khi Hương Quỷ không ăn."
  },
  {
    "idx": 6222,
    "start": "02:52:26,554",
    "end": "02:52:27,794",
    "start_sec": 10346.554,
    "end_sec": 10347.794,
    "zh": "那个带着黑狗的家伙",
    "vi": "Thì gã mang theo con chó đen đó."
  },
  {
    "idx": 6223,
    "start": "02:52:27,794",
    "end": "02:52:28,954",
    "start_sec": 10347.794,
    "end_sec": 10348.954,
    "zh": "我们也完全可以",
    "vi": "Chúng ta hoàn toàn có thể."
  },
  {
    "idx": 6224,
    "start": "02:52:28,954",
    "end": "02:52:30,414",
    "start_sec": 10348.954,
    "end_sec": 10350.414,
    "zh": "牺牲罗倩倩不是吗",
    "vi": "Hy sinh La Thiến Thiến mà phải không."
  },
  {
    "idx": 6225,
    "start": "02:52:30,414",
    "end": "02:52:32,294",
    "start_sec": 10350.414,
    "end_sec": 10352.294,
    "zh": "她一个没身份没地位的群鬼",
    "vi": "Cô ta chỉ là một con quỷ không thân phận không địa vị."
  },
  {
    "idx": 6226,
    "start": "02:52:32,294",
    "end": "02:52:33,794",
    "start_sec": 10352.294,
    "end_sec": 10353.794,
    "zh": "凭什么跟我们混在一起",
    "vi": "Dựa vào đâu mà đi cùng chúng ta."
  },
  {
    "idx": 6227,
    "start": "02:52:33,794",
    "end": "02:52:34,954",
    "start_sec": 10353.794,
    "end_sec": 10354.954,
    "zh": "呵呵",
    "vi": "Ha ha."
  },
  {
    "idx": 6228,
    "start": "02:52:34,954",
    "end": "02:52:35,654",
    "start_sec": 10354.954,
    "end_sec": 10355.654,
    "zh": "吴亚婷",
    "vi": "Ngô Á Đình."
  },
  {
    "idx": 6229,
    "start": "02:52:35,654",
    "end": "02:52:37,354",
    "start_sec": 10355.654,
    "end_sec": 10357.354,
    "zh": "其实你也在计划之中",
    "vi": "Thực ra bạn cũng nằm trong kế hoạch."
  },
  {
    "idx": 6230,
    "start": "02:52:37,354",
    "end": "02:52:38,454",
    "start_sec": 10357.354,
    "end_sec": 10358.454,
    "zh": "毕竟罗倩倩",
    "vi": "Dù sao thì La Thiến Thiến."
  },
  {
    "idx": 6231,
    "start": "02:52:38,454",
    "end": "02:52:39,574",
    "start_sec": 10358.454,
    "end_sec": 10359.574,
    "zh": "她也是一炷香",
    "vi": "Cô ấy cũng là một nén hương."
  },
  {
    "idx": 6232,
    "start": "02:52:39,574",
    "end": "02:52:40,394",
    "start_sec": 10359.574,
    "end_sec": 10360.394,
    "zh": "没办法",
    "vi": "Không còn cách nào khác."
  },
  {
    "idx": 6233,
    "start": "02:52:40,394",
    "end": "02:52:42,214",
    "start_sec": 10360.394,
    "end_sec": 10362.214,
    "zh": "本来是想着带你们来去道里",
    "vi": "Vốn dĩ tôi định đưa các bạn đến Đạo Lý."
  },
  {
    "idx": 6234,
    "start": "02:52:42,214",
    "end": "02:52:44,354",
    "start_sec": 10362.214,
    "end_sec": 10364.354,
    "zh": "从你们四个身上揭开一些事的",
    "vi": "Để làm sáng tỏ vài chuyện từ bốn người các bạn."
  },
  {
    "idx": 6235,
    "start": "02:52:44,354",
    "end": "02:52:45,154",
    "start_sec": 10364.354,
    "end_sec": 10365.154,
    "zh": "可没想到",
    "vi": "Nhưng không ngờ tới."
  },
  {
    "idx": 6236,
    "start": "02:52:45,154",
    "end": "02:52:46,974",
    "start_sec": 10365.154,
    "end_sec": 10366.974,
    "zh": "这他妈的什么诡异说来就来",
    "vi": "Mấy thứ quỷ quái này lại xuất hiện nhanh như vậy."
  },
  {
    "idx": 6237,
    "start": "02:52:46,974",
    "end": "02:52:49,014",
    "start_sec": 10366.974,
    "end_sec": 10369.014,
    "zh": "而且老头子和我电话说了",
    "vi": "Hơn nữa ông già đã gọi điện nói với tôi."
  },
  {
    "idx": 6238,
    "start": "02:52:49,014",
    "end": "02:52:51,234",
    "start_sec": 10369.014,
    "end_sec": 10371.234,
    "zh": "罗倩倩的死鬼爷爷因为某些原因",
    "vi": "Ông nội đã chết của La Thiến Thiến vì vài lý do."
  },
  {
    "idx": 6239,
    "start": "02:52:51,234",
    "end": "02:52:53,054",
    "start_sec": 10371.234,
    "end_sec": 10373.054,
    "zh": "将会是很好驯服的诡异",
    "vi": "Sẽ là một thực thể quỷ rất dễ thuần phục."
  },
  {
    "idx": 6240,
    "start": "02:52:53,054",
    "end": "02:52:54,714",
    "start_sec": 10373.054,
    "end_sec": 10374.714,
    "zh": "要不是为了成为御鬼者",
    "vi": "Nếu không phải vì muốn trở thành Ngự Quỷ Giả."
  },
  {
    "idx": 6241,
    "start": "02:52:54,714",
    "end": "02:52:57,794",
    "start_sec": 10374.714,
    "end_sec": 10377.794,
    "zh": "我才懒得和你们这些兔虫二代在这里纠缠",
    "vi": "Ta lười dây dưa với mấy đứa con ông cháu cha như các ngươi lắm."
  },
  {
    "idx": 6242,
    "start": "02:52:57,794",
    "end": "02:52:59,094",
    "start_sec": 10377.794,
    "end_sec": 10379.094,
    "zh": "你在说什么",
    "vi": "Ngươi đang nói gì vậy."
  },
  {
    "idx": 6243,
    "start": "02:52:59,094",
    "end": "02:53:00,214",
    "start_sec": 10379.094,
    "end_sec": 10380.214,
    "zh": "什么御鬼者",
    "vi": "Cái gì mà người khống chế ma quỷ."
  },
  {
    "idx": 6244,
    "start": "02:53:00,214",
    "end": "02:53:02,034",
    "start_sec": 10380.214,
    "end_sec": 10382.034,
    "zh": "你想从我身上揭开什么",
    "vi": "Ngươi muốn moi móc gì từ ta."
  },
  {
    "idx": 6245,
    "start": "02:53:02,034",
    "end": "02:53:03,554",
    "start_sec": 10382.034,
    "end_sec": 10383.554,
    "zh": "你们四个爹犯的错",
    "vi": "Lỗi lầm mà bốn ông bố của các ngươi gây ra."
  },
  {
    "idx": 6246,
    "start": "02:53:03,554",
    "end": "02:53:05,654",
    "start_sec": 10383.554,
    "end_sec": 10385.654,
    "zh": "都去和罗倩倩爷爷解释吧",
    "vi": "Tất cả đi mà giải thích với ông nội của La Thiến Thiến đi."
  },
  {
    "idx": 6247,
    "start": "02:53:05,654",
    "end": "02:53:07,214",
    "start_sec": 10385.654,
    "end_sec": 10387.214,
    "zh": "什么",
    "vi": "Cái gì."
  },
  {
    "idx": 6248,
    "start": "02:53:07,214",
    "end": "02:53:08,134",
    "start_sec": 10387.214,
    "end_sec": 10388.134,
    "zh": "怎么会",
    "vi": "Sao lại thế được."
  },
  {
    "idx": 6249,
    "start": "02:53:08,134",
    "end": "02:53:10,614",
    "start_sec": 10388.134,
    "end_sec": 10390.614,
    "zh": "那鬼东西是罗倩倩太爷吗",
    "vi": "Cái thứ ma quỷ đó là ông cố của La Thiến Thiến sao."
  },
  {
    "idx": 6250,
    "start": "02:53:19,014",
    "end": "02:53:38,934",
    "start_sec": 10399.014,
    "end_sec": 10418.934,
    "zh": "还有两炷香",
    "vi": "Còn hai nén hương nữa."
  },
  {
    "idx": 6251,
    "start": "02:53:40,934",
    "end": "02:53:41,554",
    "start_sec": 10420.934,
    "end_sec": 10421.554,
    "zh": "倩倩",
    "vi": "Thiến Thiến."
  },
  {
    "idx": 6252,
    "start": "02:53:41,554",
    "end": "02:53:44,054",
    "start_sec": 10421.554,
    "end_sec": 10424.054,
    "zh": "你说余会长的计划能成功吗",
    "vi": "Cậu có nghĩ kế hoạch của hội trưởng Dư sẽ thành công không."
  },
  {
    "idx": 6253,
    "start": "02:53:44,054",
    "end": "02:53:45,454",
    "start_sec": 10424.054,
    "end_sec": 10425.454,
    "zh": "应该能行吧",
    "vi": "Chắc là được thôi."
  },
  {
    "idx": 6254,
    "start": "02:53:45,454",
    "end": "02:53:46,534",
    "start_sec": 10425.454,
    "end_sec": 10426.534,
    "zh": "你看那个诡异",
    "vi": "Nhìn cái thứ kỳ lạ kia kìa."
  },
  {
    "idx": 6255,
    "start": "02:53:46,534",
    "end": "02:53:48,134",
    "start_sec": 10426.534,
    "end_sec": 10428.134,
    "zh": "现在都没来找我们",
    "vi": "Đến giờ vẫn chưa tìm đến chúng ta."
  },
  {
    "idx": 6256,
    "start": "02:53:48,134",
    "end": "02:53:50,374",
    "start_sec": 10428.134,
    "end_sec": 10430.374,
    "zh": "一定是去吃那个牵狗的家伙了",
    "vi": "Chắc chắn là đi ăn tên dắt chó kia rồi."
  },
  {
    "idx": 6257,
    "start": "02:53:50,374",
    "end": "02:53:51,854",
    "start_sec": 10430.374,
    "end_sec": 10431.854,
    "zh": "可是我搞不懂",
    "vi": "Nhưng mà mình không hiểu."
  },
  {
    "idx": 6258,
    "start": "02:53:51,854",
    "end": "02:53:53,454",
    "start_sec": 10431.854,
    "end_sec": 10433.454,
    "zh": "为什么要两两分对呢",
    "vi": "Tại sao lại phải chia thành hai cặp."
  },
  {
    "idx": 6259,
    "start": "02:53:53,454",
    "end": "02:53:54,714",
    "start_sec": 10433.454,
    "end_sec": 10434.714,
    "zh": "我们四个一起",
    "vi": "Chúng ta bốn người cùng nhau."
  },
  {
    "idx": 6260,
    "start": "02:53:54,714",
    "end": "02:53:57,414",
    "start_sec": 10434.714,
    "end_sec": 10437.414,
    "zh": "用两根绳紧拥那家伙不就好了吗",
    "vi": "Dùng hai sợi dây siết chặt tên đó không phải là được rồi sao."
  },
  {
    "idx": 6261,
    "start": "02:53:57,414",
    "end": "02:53:59,354",
    "start_sec": 10437.414,
    "end_sec": 10439.354,
    "zh": "这大概",
    "vi": "Cái này chắc là."
  },
  {
    "idx": 6262,
    "start": "02:53:59,354",
    "end": "02:54:00,774",
    "start_sec": 10439.354,
    "end_sec": 10440.774,
    "zh": "大概是分开的话",
    "vi": "Chắc là chia ra thì."
  },
  {
    "idx": 6263,
    "start": "02:54:00,774",
    "end": "02:54:02,434",
    "start_sec": 10440.774,
    "end_sec": 10442.434,
    "zh": "更容易混小视频吧",
    "vi": "Dễ dàng làm video ngắn hơn nhỉ."
  },
  {
    "idx": 6264,
    "start": "02:54:02,434",
    "end": "02:54:04,674",
    "start_sec": 10442.434,
    "end_sec": 10444.674,
    "zh": "哎",
    "vi": "Ai."
  },
  {
    "idx": 6265,
    "start": "02:54:04,674",
    "end": "02:54:05,314",
    "start_sec": 10444.674,
    "end_sec": 10445.314,
    "zh": "倩倩",
    "vi": "Thiến Thiến."
  },
  {
    "idx": 6266,
    "start": "02:54:05,314",
    "end": "02:54:08,154",
    "start_sec": 10445.314,
    "end_sec": 10448.154,
    "zh": "你说为什么我们还没走到隧道尽头啊",
    "vi": "Cậu có biết tại sao chúng ta vẫn chưa đi hết đường hầm không."
  },
  {
    "idx": 6267,
    "start": "02:54:08,154",
    "end": "02:54:10,214",
    "start_sec": 10448.154,
    "end_sec": 10450.214,
    "zh": "怎么感觉一直在原地打转呢",
    "vi": "Sao có cảm giác cứ loanh quanh mãi vậy."
  },
  {
    "idx": 6268,
    "start": "02:54:10,214",
    "end": "02:54:12,074",
    "start_sec": 10450.214,
    "end_sec": 10452.074,
    "zh": "因为你越是想出去",
    "vi": "Bởi vì ngươi càng muốn đi ra."
  },
  {
    "idx": 6269,
    "start": "02:54:12,074",
    "end": "02:54:13,654",
    "start_sec": 10452.074,
    "end_sec": 10453.654,
    "zh": "就越是出不去啊",
    "vi": "Càng không thể đi ra được."
  },
  {
    "idx": 6270,
    "start": "02:54:13,654",
    "end": "02:54:14,934",
    "start_sec": 10453.654,
    "end_sec": 10454.934,
    "zh": "你在说什么",
    "vi": "Ngươi đang nói gì vậy."
  },
  {
    "idx": 6271,
    "start": "02:54:14,934",
    "end": "02:54:18,154",
    "start_sec": 10454.934,
    "end_sec": 10458.154,
    "zh": "就好比一个退休送乡的世道开学工",
    "vi": "Giống như một người thợ mỏ già đã nghỉ hưu làm nghề tiễn biệt."
  },
  {
    "idx": 6272,
    "start": "02:54:18,154",
    "end": "02:54:19,814",
    "start_sec": 10458.154,
    "end_sec": 10459.814,
    "zh": "他越是想要接班什么",
    "vi": "Ông ta càng muốn tiếp quản cái gì."
  },
  {
    "idx": 6273,
    "start": "02:54:19,814",
    "end": "02:54:21,294",
    "start_sec": 10459.814,
    "end_sec": 10461.294,
    "zh": "就越是遇到困难",
    "vi": "Thì lại càng gặp nhiều khó khăn."
  },
  {
    "idx": 6274,
    "start": "02:54:21,294",
    "end": "02:54:22,174",
    "start_sec": 10461.294,
    "end_sec": 10462.174,
    "zh": "遇到丧命",
    "vi": "Thậm chí là mất mạng."
  },
  {
    "idx": 6275,
    "start": "02:54:22,174",
    "end": "02:54:24,734",
    "start_sec": 10462.174,
    "end_sec": 10464.734,
    "zh": "你知道害死了多少人吗",
    "vi": "Mày có biết đã hại chết bao nhiêu người rồi không."
  },
  {
    "idx": 6276,
    "start": "02:54:24,734",
    "end": "02:54:29,674",
    "start_sec": 10464.734,
    "end_sec": 10469.674,
    "zh": "狗东西",
    "vi": "Đồ chó chết."
  },
  {
    "idx": 6277,
    "start": "02:54:29,674",
    "end": "02:54:31,114",
    "start_sec": 10469.674,
    "end_sec": 10471.114,
    "zh": "你是个什么玩意儿",
    "vi": "Mày là cái thá gì chứ."
  },
  {
    "idx": 6278,
    "start": "02:54:31,114",
    "end": "02:54:33,914",
    "start_sec": 10471.114,
    "end_sec": 10473.914,
    "zh": "就你那些见命能治多少钱",
    "vi": "Mấy cái mạng rẻ rách của các người đáng giá bao nhiêu tiền chứ."
  },
  {
    "idx": 6279,
    "start": "02:54:33,914",
    "end": "02:54:34,754",
    "start_sec": 10473.914,
    "end_sec": 10474.754,
    "zh": "你们",
    "vi": "Các người."
  },
  {
    "idx": 6280,
    "start": "02:54:34,754",
    "end": "02:54:36,374",
    "start_sec": 10474.754,
    "end_sec": 10476.374,
    "zh": "我要检举你们",
    "vi": "Tôi sẽ tố cáo các người."
  },
  {
    "idx": 6281,
    "start": "02:54:36,374",
    "end": "02:54:37,374",
    "start_sec": 10476.374,
    "end_sec": 10477.374,
    "zh": "死老头",
    "vi": "Lão già chết tiệt."
  },
  {
    "idx": 6282,
    "start": "02:54:37,374",
    "end": "02:54:38,754",
    "start_sec": 10477.374,
    "end_sec": 10478.754,
    "zh": "真是给你脸了",
    "vi": "Đúng là cho mặt mũi mà không cần."
  },
  {
    "idx": 6283,
    "start": "02:54:38,754",
    "end": "02:54:40,094",
    "start_sec": 10478.754,
    "end_sec": 10480.094,
    "zh": "不是要检举我们吗",
    "vi": "Không phải muốn tố cáo chúng tao sao."
  },
  {
    "idx": 6284,
    "start": "02:54:40,094",
    "end": "02:54:41,194",
    "start_sec": 10480.094,
    "end_sec": 10481.194,
    "zh": "我给你这个机会",
    "vi": "Tao cho mày cơ hội này đấy."
  },
  {
    "idx": 6285,
    "start": "02:54:41,194",
    "end": "02:54:42,114",
    "start_sec": 10481.194,
    "end_sec": 10482.114,
    "zh": "我倒要看看",
    "vi": "Tao để xem."
  },
  {
    "idx": 6286,
    "start": "02:54:42,114",
    "end": "02:54:43,474",
    "start_sec": 10482.114,
    "end_sec": 10483.474,
    "zh": "有谁会理你",
    "vi": "Có ai thèm quan tâm đến mày không."
  },
  {
    "idx": 6287,
    "start": "02:54:44,934",
    "end": "02:54:49,019",
    "start_sec": 10484.934,
    "end_sec": 10489.019,
    "zh": "爷爷,这已经是第28次检举了,都被他们用孤伐手段压下去了,我们,我们还要继续吗?",
    "vi": "Ông nội, đây đã là lần tố cáo thứ hai mươi tám rồi, đều bị bọn"
  },
  {
    "idx": 6287,
    "start": "02:54:49,019",
    "end": "02:54:52,594",
    "start_sec": 10489.019,
    "end_sec": 10492.594,
    "zh": "爷爷,这已经是第28次检举了,都被他们用孤伐手段压下去了,我们,我们还要继续吗?",
    "vi": "họ dùng thủ đoạn đè xuống hết, chúng ta có tiếp tục nữa không."
  },
  {
    "idx": 6288,
    "start": "02:54:53,054",
    "end": "02:54:56,976",
    "start_sec": 10493.054,
    "end_sec": 10496.976,
    "zh": "继续,除非我死了,不然我会一直检举下去,那被非常塌方砸死的无辜人和我的朋友都需要一个交代足够的死者们啊是我没用",
    "vi": "Tiếp tục chứ, trừ khi ông chết, nếu không ông sẽ luôn tố cáo đến cùng"
  },
  {
    "idx": 6288,
    "start": "02:54:56,976",
    "end": "02:55:03,104",
    "start_sec": 10496.976,
    "end_sec": 10503.104,
    "zh": "继续,除非我死了,不然我会一直检举下去,那被非常塌方砸死的无辜人和我的朋友都需要一个交代足够的死者们啊是我没用",
    "vi": "Những người vô tội bị đá đè chết trong vụ sập hầm bất hợp pháp và bạn của ông đều cần một lời giải thích"
  },
  {
    "idx": 6288,
    "start": "02:55:03,104",
    "end": "02:55:05,311",
    "start_sec": 10503.104,
    "end_sec": 10505.311,
    "zh": "继续,除非我死了,不然我会一直检举下去,那被非常塌方砸死的无辜人和我的朋友都需要一个交代足够的死者们啊是我没用",
    "vi": "Những người đã khuất ơi, là tôi vô dụng"
  },
  {
    "idx": 6289,
    "start": "02:55:05,311",
    "end": "02:55:07,511",
    "start_sec": 10505.311,
    "end_sec": 10507.511,
    "zh": "我没能帮你们申冤成功",
    "vi": "Tôi đã không thể giúp các bạn rửa sạch oan khuất."
  },
  {
    "idx": 6290,
    "start": "02:55:07,511",
    "end": "02:55:09,091",
    "start_sec": 10507.511,
    "end_sec": 10509.091,
    "zh": "我来给你们送香了",
    "vi": "Tôi đến thắp hương cho các bạn đây."
  },
  {
    "idx": 6291,
    "start": "02:55:09,091",
    "end": "02:55:10,471",
    "start_sec": 10509.091,
    "end_sec": 10510.471,
    "zh": "吃吧 吃吧",
    "vi": "Ăn đi, ăn đi."
  },
  {
    "idx": 6292,
    "start": "02:55:10,471",
    "end": "02:55:12,351",
    "start_sec": 10510.471,
    "end_sec": 10512.351,
    "zh": "据说你们吃饱了能满足",
    "vi": "Nghe nói khi các bạn ăn no có thể đáp ứng."
  },
  {
    "idx": 6293,
    "start": "02:55:12,351",
    "end": "02:55:13,991",
    "start_sec": 10512.351,
    "end_sec": 10513.991,
    "zh": "送香人一个愿望",
    "vi": "Một tâm nguyện của người tiễn biệt."
  },
  {
    "idx": 6294,
    "start": "02:55:13,991",
    "end": "02:55:15,051",
    "start_sec": 10513.991,
    "end_sec": 10515.051,
    "zh": "我的愿望啊",
    "vi": "Tâm nguyện của tôi."
  },
  {
    "idx": 6295,
    "start": "02:55:15,051",
    "end": "02:55:16,931",
    "start_sec": 10515.051,
    "end_sec": 10516.931,
    "zh": "就是希望你们能安静",
    "vi": "Chính là hy vọng các bạn có thể yên nghỉ."
  },
  {
    "idx": 6296,
    "start": "02:55:16,931",
    "end": "02:55:18,911",
    "start_sec": 10516.931,
    "end_sec": 10518.911,
    "zh": "不好了 不好了",
    "vi": "Không xong rồi, không xong rồi."
  },
  {
    "idx": 6297,
    "start": "02:55:18,911",
    "end": "02:55:20,391",
    "start_sec": 10518.911,
    "end_sec": 10520.391,
    "zh": "这都又塌方了",
    "vi": "Ở đây lại sập hầm rồi."
  },
  {
    "idx": 6298,
    "start": "02:55:20,391",
    "end": "02:55:21,231",
    "start_sec": 10520.391,
    "end_sec": 10521.231,
    "zh": "里面的人",
    "vi": "Người bên trong."
  },
  {
    "idx": 6299,
    "start": "02:55:21,231",
    "end": "02:55:22,511",
    "start_sec": 10521.231,
    "end_sec": 10522.511,
    "zh": "快 快出来",
    "vi": "Mau, mau ra ngoài đi."
  },
  {
    "idx": 6300,
    "start": "02:55:22,511",
    "end": "02:55:24,431",
    "start_sec": 10522.511,
    "end_sec": 10524.431,
    "zh": "早就这样",
    "vi": "Đã sớm như vậy rồi."
  },
  {
    "idx": 6301,
    "start": "02:55:24,431",
    "end": "02:55:26,291",
    "start_sec": 10524.431,
    "end_sec": 10526.291,
    "zh": "还不如不接发补去送箱",
    "vi": "Thà rằng không nhận việc vận chuyển này còn hơn."
  },
  {
    "idx": 6302,
    "start": "02:55:26,291",
    "end": "02:55:28,231",
    "start_sec": 10526.291,
    "end_sec": 10528.231,
    "zh": "你在讲什么啊",
    "vi": "Anh đang nói cái gì vậy."
  },
  {
    "idx": 6303,
    "start": "02:55:28,231",
    "end": "02:55:30,051",
    "start_sec": 10528.231,
    "end_sec": 10530.051,
    "zh": "我在讲分身运输的信息",
    "vi": "Tôi đang nói về thông tin vận chuyển phân thân."
  },
  {
    "idx": 6304,
    "start": "02:55:30,051",
    "end": "02:55:31,051",
    "start_sec": 10530.051,
    "end_sec": 10531.051,
    "zh": "按照标准",
    "vi": "Theo tiêu chuẩn."
  },
  {
    "idx": 6305,
    "start": "02:55:31,051",
    "end": "02:55:32,531",
    "start_sec": 10531.051,
    "end_sec": 10532.531,
    "zh": "日每年都要翻新的吧",
    "vi": "Mỗi năm đều phải trùng tu lại chứ."
  },
  {
    "idx": 6306,
    "start": "02:55:32,531",
    "end": "02:55:34,291",
    "start_sec": 10532.531,
    "end_sec": 10534.291,
    "zh": "给你们拿着巨大的翻新费",
    "vi": "Giao cho các người khoản phí trùng tu khổng lồ."
  },
  {
    "idx": 6307,
    "start": "02:55:34,291",
    "end": "02:55:34,871",
    "start_sec": 10534.291,
    "end_sec": 10534.871,
    "zh": "不作为",
    "vi": "Nhưng các người lại không làm gì."
  },
  {
    "idx": 6308,
    "start": "02:55:34,871",
    "end": "02:55:35,991",
    "start_sec": 10534.871,
    "end_sec": 10535.991,
    "zh": "导致他当时",
    "vi": "Dẫn đến việc lúc đó."
  },
  {
    "idx": 6309,
    "start": "02:55:35,991",
    "end": "02:55:37,311",
    "start_sec": 10535.991,
    "end_sec": 10537.311,
    "zh": "现实性出现故障",
    "vi": "Hệ thống xảy ra sự cố."
  },
  {
    "idx": 6310,
    "start": "02:55:37,311",
    "end": "02:55:38,871",
    "start_sec": 10537.311,
    "end_sec": 10538.871,
    "zh": "没有第一时间就出人",
    "vi": "Đã không cứu người ngay lập tức."
  },
  {
    "idx": 6311,
    "start": "02:55:38,871",
    "end": "02:55:39,371",
    "start_sec": 10538.871,
    "end_sec": 10539.371,
    "zh": "你说",
    "vi": "Anh nói xem."
  },
  {
    "idx": 6312,
    "start": "02:55:39,371",
    "end": "02:55:40,111",
    "start_sec": 10539.371,
    "end_sec": 10540.111,
    "zh": "出人命",
    "vi": "Việc mất mạng này."
  },
  {
    "idx": 6313,
    "start": "02:55:40,111",
    "end": "02:55:41,231",
    "start_sec": 10540.111,
    "end_sec": 10541.231,
    "zh": "是怪天灾呢",
    "vi": "Là do thiên tai."
  },
  {
    "idx": 6314,
    "start": "02:55:41,231",
    "end": "02:55:42,351",
    "start_sec": 10541.231,
    "end_sec": 10542.351,
    "zh": "还是怪人祸呢",
    "vi": "Hay là do nhân họa đây."
  },
  {
    "idx": 6315,
    "start": "02:55:42,351",
    "end": "02:55:43,071",
    "start_sec": 10542.351,
    "end_sec": 10543.071,
    "zh": "罗倩倩",
    "vi": "La Thiến Thiến."
  },
  {
    "idx": 6316,
    "start": "02:55:43,071",
    "end": "02:55:44,371",
    "start_sec": 10543.071,
    "end_sec": 10544.371,
    "zh": "你在胡扯些什么",
    "vi": "Cô đang nói nhảm nhí gì thế."
  },
  {
    "idx": 6317,
    "start": "02:55:44,371",
    "end": "02:55:46,631",
    "start_sec": 10544.371,
    "end_sec": 10546.631,
    "zh": "我们现在可是在找隧道出口啊",
    "vi": "Chúng ta hiện đang tìm lối ra đường hầm mà."
  },
  {
    "idx": 6318,
    "start": "02:55:46,631",
    "end": "02:55:48,491",
    "start_sec": 10546.631,
    "end_sec": 10548.491,
    "zh": "你说这些有什么联系吗",
    "vi": "Cô nói những điều này thì có liên quan gì chứ."
  },
  {
    "idx": 6319,
    "start": "02:55:48,491",
    "end": "02:55:50,331",
    "start_sec": 10548.491,
    "end_sec": 10550.331,
    "zh": "当然有啊",
    "vi": "Đương nhiên là có rồi."
  },
  {
    "idx": 6320,
    "start": "02:55:50,331",
    "end": "02:55:50,691",
    "start_sec": 10550.331,
    "end_sec": 10550.691,
    "zh": "因为",
    "vi": "Bởi vì."
  },
  {
    "idx": 6321,
    "start": "02:55:50,691",
    "end": "02:55:51,611",
    "start_sec": 10550.691,
    "end_sec": 10551.611,
    "zh": "不炸子墙",
    "vi": "Nếu không nổ bức tường này."
  },
  {
    "idx": 6322,
    "start": "02:55:51,611",
    "end": "02:55:52,731",
    "start_sec": 10551.611,
    "end_sec": 10552.731,
    "zh": "你不会真的觉得",
    "vi": "Anh không thực sự nghĩ rằng."
  },
  {
    "idx": 6323,
    "start": "02:55:52,731",
    "end": "02:55:53,991",
    "start_sec": 10552.731,
    "end_sec": 10553.991,
    "zh": "你配走出这里吧",
    "vi": "Anh xứng đáng bước ra khỏi đây chứ."
  },
  {
    "idx": 6324,
    "start": "02:55:53,991",
    "end": "02:55:56,731",
    "start_sec": 10553.991,
    "end_sec": 10556.731,
    "zh": "吃香鬼吃香了",
    "vi": "Chết đến nơi rồi."
  },
  {
    "idx": 6325,
    "start": "02:55:56,731",
    "end": "02:55:58,871",
    "start_sec": 10556.731,
    "end_sec": 10558.871,
    "zh": "罗倩倩",
    "vi": "La Thiến Thiến."
  },
  {
    "idx": 6326,
    "start": "02:55:58,871",
    "end": "02:55:59,771",
    "start_sec": 10558.871,
    "end_sec": 10559.771,
    "zh": "你个疯子",
    "vi": "Cô đúng là đồ điên."
  },
  {
    "idx": 6327,
    "start": "02:55:59,771",
    "end": "02:56:01,131",
    "start_sec": 10559.771,
    "end_sec": 10561.131,
    "zh": "你到底要干什么",
    "vi": "Rốt cuộc cô muốn làm gì hả."
  },
  {
    "idx": 6328,
    "start": "02:56:01,131",
    "end": "02:56:02,791",
    "start_sec": 10561.131,
    "end_sec": 10562.791,
    "zh": "吃人血蛮托的企业",
    "vi": "Một doanh nghiệp hút máu người như vậy."
  },
  {
    "idx": 6329,
    "start": "02:56:02,791",
    "end": "02:56:03,811",
    "start_sec": 10562.791,
    "end_sec": 10563.811,
    "zh": "有没有想过",
    "vi": "Có từng nghĩ đến việc."
  },
  {
    "idx": 6330,
    "start": "02:56:03,811",
    "end": "02:56:05,571",
    "start_sec": 10563.811,
    "end_sec": 10565.571,
    "zh": "说有一天要下地狱",
    "vi": "Sẽ có ngày phải xuống địa ngục không."
  },
  {
    "idx": 6331,
    "start": "02:56:05,571",
    "end": "02:56:07,391",
    "start_sec": 10565.571,
    "end_sec": 10567.391,
    "zh": "爷爷",
    "vi": "Ông nội"
  },
  {
    "idx": 6332,
    "start": "02:56:07,391",
    "end": "02:56:09,671",
    "start_sec": 10567.391,
    "end_sec": 10569.671,
    "zh": "孙女给您上香了",
    "vi": "Cháu gái thắp hương cho ông đây"
  },
  {
    "idx": 6333,
    "start": "02:56:09,671",
    "end": "02:56:12,811",
    "start_sec": 10569.671,
    "end_sec": 10572.811,
    "zh": "你你说什么",
    "vi": "Mày mày nói cái gì"
  },
  {
    "idx": 6334,
    "start": "02:56:12,811",
    "end": "02:56:13,711",
    "start_sec": 10572.811,
    "end_sec": 10573.711,
    "zh": "爷爷",
    "vi": "Ông nội"
  },
  {
    "idx": 6335,
    "start": "02:56:13,711",
    "end": "02:56:15,311",
    "start_sec": 10573.711,
    "end_sec": 10575.311,
    "zh": "吃香鬼去你爷爷",
    "vi": "Quỷ ăn hương chính là ông nội của mày"
  },
  {
    "idx": 6336,
    "start": "02:56:15,311",
    "end": "02:56:17,011",
    "start_sec": 10575.311,
    "end_sec": 10577.011,
    "zh": "如果法律还在的话",
    "vi": "Nếu pháp luật còn tồn tại"
  },
  {
    "idx": 6337,
    "start": "02:56:17,011",
    "end": "02:56:18,471",
    "start_sec": 10577.011,
    "end_sec": 10578.471,
    "zh": "可能你不用死",
    "vi": "Có lẽ anh không phải chết"
  },
  {
    "idx": 6338,
    "start": "02:56:18,471",
    "end": "02:56:19,951",
    "start_sec": 10578.471,
    "end_sec": 10579.951,
    "zh": "但是爷爷现在",
    "vi": "Nhưng bây giờ ông nội"
  },
  {
    "idx": 6339,
    "start": "02:56:19,951",
    "end": "02:56:22,091",
    "start_sec": 10579.951,
    "end_sec": 10582.091,
    "zh": "也为了报答时会长",
    "vi": "Cũng là để báo đáp Thạch hội trưởng"
  },
  {
    "idx": 6340,
    "start": "02:56:22,091",
    "end": "02:56:23,791",
    "start_sec": 10582.091,
    "end_sec": 10583.791,
    "zh": "所以你上路吧",
    "vi": "Nên anh lên đường đi"
  },
  {
    "idx": 6341,
    "start": "02:56:23,791",
    "end": "02:56:27,411",
    "start_sec": 10583.791,
    "end_sec": 10587.411,
    "zh": "倩倩不要不要别杀我",
    "vi": "Thiến Thiến đừng mà đừng giết tôi"
  },
  {
    "idx": 6342,
    "start": "02:56:27,411",
    "end": "02:56:28,891",
    "start_sec": 10587.411,
    "end_sec": 10588.891,
    "zh": "那都是我爹做的事",
    "vi": "Đó đều là những việc cha tôi làm"
  },
  {
    "idx": 6343,
    "start": "02:56:28,891",
    "end": "02:56:30,911",
    "start_sec": 10588.891,
    "end_sec": 10590.911,
    "zh": "我不知情放过我",
    "vi": "Tôi không hề biết gì xin tha cho tôi"
  },
  {
    "idx": 6344,
    "start": "02:56:30,911",
    "end": "02:56:34,131",
    "start_sec": 10590.911,
    "end_sec": 10594.131,
    "zh": "虽说你不知情",
    "vi": "Dù anh không biết gì"
  },
  {
    "idx": 6345,
    "start": "02:56:34,131",
    "end": "02:56:35,371",
    "start_sec": 10594.131,
    "end_sec": 10595.371,
    "zh": "作为受益者",
    "vi": "Nhưng với tư cách là người hưởng lợi"
  },
  {
    "idx": 6346,
    "start": "02:56:35,371",
    "end": "02:56:38,131",
    "start_sec": 10595.371,
    "end_sec": 10598.131,
    "zh": "从小就是吃人血馒头长大的你",
    "vi": "Từ nhỏ đã lớn lên bằng cách hút máu người khác"
  },
  {
    "idx": 6347,
    "start": "02:56:38,131",
    "end": "02:56:40,191",
    "start_sec": 10598.131,
    "end_sec": 10600.191,
    "zh": "又怎么算得上无辜呢",
    "vi": "Thì sao anh có thể coi là vô tội được"
  },
  {
    "idx": 6348,
    "start": "02:56:40,191",
    "end": "02:56:46,171",
    "start_sec": 10600.191,
    "end_sec": 10606.171,
    "zh": "雷爷你真的认不出我了吗",
    "vi": "Ông Lôi ông thực sự không nhận ra cháu sao"
  },
  {
    "idx": 6349,
    "start": "02:56:46,171",
    "end": "02:56:47,191",
    "start_sec": 10606.171,
    "end_sec": 10607.191,
    "zh": "你不是说过",
    "vi": "Không phải ông từng nói"
  },
  {
    "idx": 6350,
    "start": "02:56:47,191",
    "end": "02:56:49,531",
    "start_sec": 10607.191,
    "end_sec": 10609.531,
    "zh": "以后还想看到我长男朋友吗",
    "vi": "Sau này vẫn muốn thấy cháu có bạn trai sao"
  },
  {
    "idx": 6351,
    "start": "02:56:49,531",
    "end": "02:56:52,191",
    "start_sec": 10609.531,
    "end_sec": 10612.191,
    "zh": "让我把你的事做成事情发出去吗",
    "vi": "Muốn cháu viết lại câu chuyện của ông để đăng lên sao"
  },
  {
    "idx": 6352,
    "start": "02:56:52,191",
    "end": "02:56:54,631",
    "start_sec": 10612.191,
    "end_sec": 10614.631,
    "zh": "石香鬼没有理会罗倩倩",
    "vi": "Quỷ ăn hương không để ý đến La Thiến Thiến"
  },
  {
    "idx": 6353,
    "start": "02:56:54,631",
    "end": "02:56:56,951",
    "start_sec": 10614.631,
    "end_sec": 10616.951,
    "zh": "背着孙楠的无头尸体坏作",
    "vi": "Cõng xác không đầu của Tôn Nam rời đi"
  },
  {
    "idx": 6354,
    "start": "02:56:56,951",
    "end": "02:57:03,411",
    "start_sec": 10616.951,
    "end_sec": 10623.411,
    "zh": "倩倩都搞定了吧",
    "vi": "Thiến Thiến giải quyết xong hết rồi chứ"
  },
  {
    "idx": 6355,
    "start": "02:57:03,411",
    "end": "02:57:06,391",
    "start_sec": 10623.411,
    "end_sec": 10626.391,
    "zh": "孙楠是第四炷香的话",
    "vi": "Nếu Tôn Nam là nén hương thứ tư"
  },
  {
    "idx": 6356,
    "start": "02:57:06,391",
    "end": "02:57:07,551",
    "start_sec": 10626.391,
    "end_sec": 10627.551,
    "zh": "你一个人来",
    "vi": "Cậu đi một mình"
  },
  {
    "idx": 6357,
    "start": "02:57:07,551",
    "end": "02:57:09,891",
    "start_sec": 10627.551,
    "end_sec": 10629.891,
    "zh": "第三炷香是吴亚婷吗",
    "vi": "Nén hương thứ ba là Ngô Á Đình sao"
  },
  {
    "idx": 6358,
    "start": "02:57:09,891",
    "end": "02:57:12,811",
    "start_sec": 10629.891,
    "end_sec": 10632.811,
    "zh": "对倩倩我是真没辙",
    "vi": "Đúng vậy đối với Thiến Thiến tôi thực sự bó tay"
  },
  {
    "idx": 6359,
    "start": "02:57:12,811",
    "end": "02:57:15,231",
    "start_sec": 10632.811,
    "end_sec": 10635.231,
    "zh": "要是那个什么橙子蹄被杀了也好",
    "vi": "Nếu kẻ tên Trình Tử Kỳ kia bị giết thì tốt rồi"
  },
  {
    "idx": 6360,
    "start": "02:57:15,231",
    "end": "02:57:16,791",
    "start_sec": 10635.231,
    "end_sec": 10636.791,
    "zh": "你甚至都不用死了",
    "vi": "Thậm chí cậu còn không phải chết"
  },
  {
    "idx": 6361,
    "start": "02:57:16,791",
    "end": "02:57:18,091",
    "start_sec": 10636.791,
    "end_sec": 10638.091,
    "zh": "结果我没想到啊",
    "vi": "Kết quả là tôi không ngờ tới"
  },
  {
    "idx": 6362,
    "start": "02:57:18,091",
    "end": "02:57:19,331",
    "start_sec": 10638.091,
    "end_sec": 10639.331,
    "zh": "她居然是玉回者",
    "vi": "cô ta lại là người luân hồi"
  },
  {
    "idx": 6363,
    "start": "02:57:19,331",
    "end": "02:57:20,731",
    "start_sec": 10639.331,
    "end_sec": 10640.731,
    "zh": "不好意思了倩倩",
    "vi": "Xin lỗi nhé Thiến Thiến"
  },
  {
    "idx": 6364,
    "start": "02:57:20,731",
    "end": "02:57:22,391",
    "start_sec": 10640.731,
    "end_sec": 10642.391,
    "zh": "你要成为第五炷香了",
    "vi": "cô phải trở thành nén hương thứ năm rồi"
  },
  {
    "idx": 6365,
    "start": "02:57:22,391",
    "end": "02:57:23,051",
    "start_sec": 10642.391,
    "end_sec": 10643.051,
    "zh": "无碍",
    "vi": "Không sao"
  },
  {
    "idx": 6366,
    "start": "02:57:23,051",
    "end": "02:57:23,971",
    "start_sec": 10643.051,
    "end_sec": 10643.971,
    "zh": "徐会长",
    "vi": "Hội trưởng Từ"
  },
  {
    "idx": 6367,
    "start": "02:57:23,971",
    "end": "02:57:24,971",
    "start_sec": 10643.971,
    "end_sec": 10644.971,
    "zh": "按照约定",
    "vi": "Theo như giao ước"
  },
  {
    "idx": 6368,
    "start": "02:57:24,971",
    "end": "02:57:27,391",
    "start_sec": 10644.971,
    "end_sec": 10647.391,
    "zh": "你帮我找到四个企业的二代",
    "vi": "ông giúp tôi tìm thế hệ thứ hai của bốn doanh nghiệp"
  },
  {
    "idx": 6369,
    "start": "02:57:27,391",
    "end": "02:57:29,011",
    "start_sec": 10647.391,
    "end_sec": 10649.011,
    "zh": "靠出心去举报他们",
    "vi": "để tố cáo bọn họ"
  },
  {
    "idx": 6370,
    "start": "02:57:29,011",
    "end": "02:57:30,151",
    "start_sec": 10649.011,
    "end_sec": 10650.151,
    "zh": "我帮你成名",
    "vi": "tôi giúp ông nổi tiếng"
  },
  {
    "idx": 6371,
    "start": "02:57:30,151",
    "end": "02:57:32,211",
    "start_sec": 10650.151,
    "end_sec": 10652.211,
    "zh": "现在爷爷需要五炷香",
    "vi": "Bây giờ ông nội cần năm nén hương"
  },
  {
    "idx": 6372,
    "start": "02:57:32,211",
    "end": "02:57:33,091",
    "start_sec": 10652.211,
    "end_sec": 10653.091,
    "zh": "才能安心",
    "vi": "mới có thể an lòng"
  },
  {
    "idx": 6373,
    "start": "02:57:33,091",
    "end": "02:57:34,231",
    "start_sec": 10653.091,
    "end_sec": 10654.231,
    "zh": "四个仇人",
    "vi": "Bốn kẻ thù"
  },
  {
    "idx": 6374,
    "start": "02:57:34,231",
    "end": "02:57:35,891",
    "start_sec": 10654.231,
    "end_sec": 10655.891,
    "zh": "加上一个亲孙女",
    "vi": "cộng thêm một đứa cháu gái ruột"
  },
  {
    "idx": 6375,
    "start": "02:57:35,891",
    "end": "02:57:37,431",
    "start_sec": 10655.891,
    "end_sec": 10657.431,
    "zh": "也算是善始善终",
    "vi": "cũng coi như trọn nghĩa vẹn tình"
  },
  {
    "idx": 6376,
    "start": "02:57:37,431",
    "end": "02:57:38,271",
    "start_sec": 10657.431,
    "end_sec": 10658.271,
    "zh": "没去",
    "vi": "Đúng vậy"
  },
  {
    "idx": 6377,
    "start": "02:57:38,271",
    "end": "02:57:39,071",
    "start_sec": 10658.271,
    "end_sec": 10659.071,
    "zh": "应该的",
    "vi": "Đó là điều nên làm"
  },
  {
    "idx": 6378,
    "start": "02:57:39,071",
    "end": "02:57:39,911",
    "start_sec": 10659.071,
    "end_sec": 10659.911,
    "zh": "我们走吧",
    "vi": "Chúng ta đi thôi"
  },
  {
    "idx": 6379,
    "start": "02:57:39,911",
    "end": "02:57:41,551",
    "start_sec": 10659.911,
    "end_sec": 10661.551,
    "zh": "去送罗爷爷最后一程",
    "vi": "đi tiễn ông nội La chặng đường cuối cùng"
  },
  {
    "idx": 6380,
    "start": "02:57:41,551",
    "end": "02:57:45,831",
    "start_sec": 10661.551,
    "end_sec": 10665.831,
    "zh": "两人来到十地前程",
    "vi": "Hai người đi đến trước linh cữu"
  },
  {
    "idx": 6381,
    "start": "02:57:45,831",
    "end": "02:57:47,371",
    "start_sec": 10665.831,
    "end_sec": 10667.371,
    "zh": "十三岁这么贪婪的",
    "vi": "Ba dài hai ngắn thế này"
  },
  {
    "idx": 6382,
    "start": "02:57:47,371",
    "end": "02:57:49,011",
    "start_sec": 10667.371,
    "end_sec": 10669.011,
    "zh": "竟然是个必杀的节日",
    "vi": "hóa ra lại là một thế cục tất sát"
  },
  {
    "idx": 6383,
    "start": "02:57:49,011",
    "end": "02:57:50,231",
    "start_sec": 10669.011,
    "end_sec": 10670.231,
    "zh": "短长长短",
    "vi": "Ngắn dài dài ngắn"
  },
  {
    "idx": 6384,
    "start": "02:57:50,231",
    "end": "02:57:52,071",
    "start_sec": 10670.231,
    "end_sec": 10672.071,
    "zh": "现在还差最后一炷香",
    "vi": "Bây giờ vẫn còn thiếu nén hương cuối cùng"
  },
  {
    "idx": 6385,
    "start": "02:57:52,071",
    "end": "02:57:54,891",
    "start_sec": 10672.071,
    "end_sec": 10674.891,
    "zh": "现选第五炷香",
    "vi": "Dâng nén hương thứ năm"
  },
  {
    "idx": 6386,
    "start": "02:57:54,891",
    "end": "02:57:55,871",
    "start_sec": 10674.891,
    "end_sec": 10675.871,
    "zh": "上香",
    "vi": "Thắp hương"
  },
  {
    "idx": 6387,
    "start": "02:57:55,871",
    "end": "02:57:57,791",
    "start_sec": 10675.871,
    "end_sec": 10677.791,
    "zh": "爷爷",
    "vi": "Ông nội"
  },
  {
    "idx": 6388,
    "start": "02:57:57,791",
    "end": "02:57:59,431",
    "start_sec": 10677.791,
    "end_sec": 10679.431,
    "zh": "你曾经和我说过",
    "vi": "ông từng nói với cháu"
  },
  {
    "idx": 6389,
    "start": "02:57:59,431",
    "end": "02:58:01,491",
    "start_sec": 10679.431,
    "end_sec": 10681.491,
    "zh": "三炷香用来取神显灵",
    "vi": "ba nén hương dùng để thỉnh thần hiển linh"
  },
  {
    "idx": 6390,
    "start": "02:58:01,491",
    "end": "02:58:02,871",
    "start_sec": 10681.491,
    "end_sec": 10682.871,
    "zh": "四炷香照应",
    "vi": "bốn nén hương để chiếu ứng"
  },
  {
    "idx": 6391,
    "start": "02:58:02,871",
    "end": "02:58:06,111",
    "start_sec": 10682.871,
    "end_sec": 10686.111,
    "zh": "四炷香照应儿孙不沾尘",
    "vi": "Bốn nén hương chiếu ứng con cháu không vướng bụi trần."
  },
  {
    "idx": 6392,
    "start": "02:58:06,111",
    "end": "02:58:08,371",
    "start_sec": 10686.111,
    "end_sec": 10688.371,
    "zh": "那第五炷香呢",
    "vi": "Vậy còn nén hương thứ năm thì sao."
  },
  {
    "idx": 6393,
    "start": "02:58:08,371",
    "end": "02:58:11,891",
    "start_sec": 10688.371,
    "end_sec": 10691.891,
    "zh": "五炷香用来驱邪除模糊幼子孙",
    "vi": "Năm nén hương dùng để trừ tà diệt ma, che chở con cháu."
  },
  {
    "idx": 6394,
    "start": "02:58:11,891",
    "end": "02:58:12,851",
    "start_sec": 10691.891,
    "end_sec": 10692.851,
    "zh": "香啊",
    "vi": "Thơm quá."
  },
  {
    "idx": 6395,
    "start": "02:58:12,851",
    "end": "02:58:14,331",
    "start_sec": 10692.851,
    "end_sec": 10694.331,
    "zh": "香喜两碗一肠",
    "vi": "Thơm quá, hai bát một khúc ruột."
  },
  {
    "idx": 6396,
    "start": "02:58:14,331",
    "end": "02:58:16,871",
    "start_sec": 10694.331,
    "end_sec": 10696.871,
    "zh": "醉气三肠两碗",
    "vi": "Say sưa ba khúc ruột hai bát."
  },
  {
    "idx": 6397,
    "start": "02:58:16,871",
    "end": "02:58:18,551",
    "start_sec": 10696.871,
    "end_sec": 10698.551,
    "zh": "五炷香",
    "vi": "Năm nén hương."
  },
  {
    "idx": 6398,
    "start": "02:58:18,551",
    "end": "02:58:20,651",
    "start_sec": 10698.551,
    "end_sec": 10700.651,
    "zh": "现在还差一炷长香",
    "vi": "Bây giờ vẫn còn thiếu một nén hương dài."
  },
  {
    "idx": 6399,
    "start": "02:58:20,651",
    "end": "02:58:24,751",
    "start_sec": 10700.651,
    "end_sec": 10704.751,
    "zh": "我便来送您解脱",
    "vi": "Tôi đến để giúp ông giải thoát."
  },
  {
    "idx": 6400,
    "start": "02:58:24,751",
    "end": "02:58:27,371",
    "start_sec": 10704.751,
    "end_sec": 10707.371,
    "zh": "也当作是对徐会长的报答",
    "vi": "Cũng coi như là để báo đáp Hội trưởng Từ."
  },
  {
    "idx": 6401,
    "start": "02:58:27,371",
    "end": "02:58:29,091",
    "start_sec": 10707.371,
    "end_sec": 10709.091,
    "zh": "第五炷香",
    "vi": "Nén hương thứ năm."
  },
  {
    "idx": 6402,
    "start": "02:58:29,091",
    "end": "02:58:30,071",
    "start_sec": 10709.091,
    "end_sec": 10710.071,
    "zh": "燃香",
    "vi": "Thắp hương."
  },
  {
    "idx": 6403,
    "start": "02:58:30,071",
    "end": "02:58:32,831",
    "start_sec": 10710.071,
    "end_sec": 10712.831,
    "zh": "好吃",
    "vi": "Ngon quá."
  },
  {
    "idx": 6404,
    "start": "02:58:32,831",
    "end": "02:58:35,851",
    "start_sec": 10712.831,
    "end_sec": 10715.851,
    "zh": "从前人说出你的愿望",
    "vi": "Người đi trước, hãy nói ra nguyện vọng của ông."
  },
  {
    "idx": 6405,
    "start": "02:58:35,851",
    "end": "02:58:37,451",
    "start_sec": 10715.851,
    "end_sec": 10717.451,
    "zh": "这个愿望请",
    "vi": "Nguyện vọng này xin hãy."
  },
  {
    "idx": 6406,
    "start": "02:58:37,451",
    "end": "02:58:39,491",
    "start_sec": 10717.451,
    "end_sec": 10719.491,
    "zh": "请给徐徐",
    "vi": "Xin hãy dành cho Từ, Từ."
  },
  {
    "idx": 6407,
    "start": "02:58:39,491",
    "end": "02:58:42,551",
    "start_sec": 10719.491,
    "end_sec": 10722.551,
    "zh": "请给徐徐会",
    "vi": "Xin hãy dành cho Hội trưởng Từ."
  },
  {
    "idx": 6408,
    "start": "02:58:42,551",
    "end": "02:58:45,171",
    "start_sec": 10722.551,
    "end_sec": 10725.171,
    "zh": "罗倩倩",
    "vi": "La Thiến Thiến."
  },
  {
    "idx": 6409,
    "start": "02:58:45,171",
    "end": "02:58:46,511",
    "start_sec": 10725.171,
    "end_sec": 10726.511,
    "zh": "你真的想好了吗",
    "vi": "Cô thực sự nghĩ kỹ chưa."
  },
  {
    "idx": 6410,
    "start": "02:58:46,511",
    "end": "02:58:48,411",
    "start_sec": 10726.511,
    "end_sec": 10728.411,
    "zh": "你爷爷的愿望是什么",
    "vi": "Nguyện vọng của ông nội cô là gì."
  },
  {
    "idx": 6411,
    "start": "02:58:48,411",
    "end": "02:58:52,951",
    "start_sec": 10728.411,
    "end_sec": 10732.951,
    "zh": "你爷爷的愿望到底是什么",
    "vi": "Rốt cuộc nguyện vọng của ông nội cô là gì."
  },
  {
    "idx": 6412,
    "start": "02:58:52,951",
    "end": "02:58:55,611",
    "start_sec": 10732.951,
    "end_sec": 10735.611,
    "zh": "程 程先生",
    "vi": "Trình, anh Trình."
  },
  {
    "idx": 6413,
    "start": "02:58:55,611",
    "end": "02:58:56,951",
    "start_sec": 10735.611,
    "end_sec": 10736.951,
    "zh": "你怎么会知道",
    "vi": "Sao anh lại biết được."
  },
  {
    "idx": 6414,
    "start": "02:58:56,951",
    "end": "02:58:58,071",
    "start_sec": 10736.951,
    "end_sec": 10738.071,
    "zh": "程子提",
    "vi": "Trình Tử Đề."
  },
  {
    "idx": 6415,
    "start": "02:58:58,071",
    "end": "02:58:59,931",
    "start_sec": 10738.071,
    "end_sec": 10739.931,
    "zh": "你 你来干什么",
    "vi": "Anh, anh đến đây làm gì."
  },
  {
    "idx": 6416,
    "start": "02:58:59,931",
    "end": "02:59:03,811",
    "start_sec": 10739.931,
    "end_sec": 10743.811,
    "zh": "什么地位不像",
    "vi": "Thế mạng gì chứ."
  },
  {
    "idx": 6417,
    "start": "02:59:03,811",
    "end": "02:59:04,751",
    "start_sec": 10743.811,
    "end_sec": 10744.751,
    "zh": "什么许愿",
    "vi": "Ước nguyện gì chứ."
  },
  {
    "idx": 6418,
    "start": "02:59:04,751",
    "end": "02:59:06,351",
    "start_sec": 10744.751,
    "end_sec": 10746.351,
    "zh": "你以为你这样做",
    "vi": "Cô nghĩ cô làm như vậy."
  },
  {
    "idx": 6419,
    "start": "02:59:06,351",
    "end": "02:59:07,951",
    "start_sec": 10746.351,
    "end_sec": 10747.951,
    "zh": "你爷爷就能开心吗",
    "vi": "Thì ông nội cô sẽ vui sao."
  },
  {
    "idx": 6420,
    "start": "02:59:07,951",
    "end": "02:59:08,871",
    "start_sec": 10747.951,
    "end_sec": 10748.871,
    "zh": "程子提",
    "vi": "Trình Tử Đề."
  },
  {
    "idx": 6421,
    "start": "02:59:08,871",
    "end": "02:59:10,211",
    "start_sec": 10748.871,
    "end_sec": 10750.211,
    "zh": "你他妈要干什么",
    "vi": "Mẹ kiếp, cô muốn làm cái quái gì thế."
  },
  {
    "idx": 6422,
    "start": "02:59:10,211",
    "end": "02:59:11,171",
    "start_sec": 10750.211,
    "end_sec": 10751.171,
    "zh": "程先生",
    "vi": "Anh Trình."
  },
  {
    "idx": 6423,
    "start": "02:59:11,171",
    "end": "02:59:13,731",
    "start_sec": 10751.171,
    "end_sec": 10753.731,
    "zh": "虽然不知道为什么您要救我",
    "vi": "Dù không biết tại sao anh lại cứu tôi."
  },
  {
    "idx": 6424,
    "start": "02:59:13,731",
    "end": "02:59:16,411",
    "start_sec": 10753.731,
    "end_sec": 10756.411,
    "zh": "但是这是我牵徐会长的",
    "vi": "Nhưng đây là món nợ tôi nợ Hội trưởng Từ."
  },
  {
    "idx": 6425,
    "start": "02:59:16,411",
    "end": "02:59:18,191",
    "start_sec": 10756.411,
    "end_sec": 10758.191,
    "zh": "就让我和爷爷一起走吧",
    "vi": "Hãy để tôi đi cùng ông nội đi."
  },
  {
    "idx": 6426,
    "start": "02:59:18,191",
    "end": "02:59:19,211",
    "start_sec": 10758.191,
    "end_sec": 10759.211,
    "zh": "你欠他",
    "vi": "Cô nợ ông ta."
  },
  {
    "idx": 6427,
    "start": "02:59:19,211",
    "end": "02:59:20,211",
    "start_sec": 10759.211,
    "end_sec": 10760.211,
    "zh": "你欠他什么",
    "vi": "Cô nợ ông ta cái gì chứ."
  },
  {
    "idx": 6428,
    "start": "02:59:20,211",
    "end": "02:59:21,591",
    "start_sec": 10760.211,
    "end_sec": 10761.591,
    "zh": "他把你当妻子用",
    "vi": "Ông ta coi cô như quân cờ để lợi dụng."
  },
  {
    "idx": 6429,
    "start": "02:59:21,591",
    "end": "02:59:22,431",
    "start_sec": 10761.591,
    "end_sec": 10762.431,
    "zh": "到头来",
    "vi": "Đến cuối cùng,"
  },
  {
    "idx": 6430,
    "start": "02:59:22,431",
    "end": "02:59:24,491",
    "start_sec": 10762.431,
    "end_sec": 10764.491,
    "zh": "你悲的是天下皆知吗",
    "vi": "cô muốn gánh chịu tiếng xấu mà cả thiên hạ đều biết sao."
  },
  {
    "idx": 6431,
    "start": "02:59:24,491",
    "end": "02:59:25,091",
    "start_sec": 10764.491,
    "end_sec": 10765.091,
    "zh": "可",
    "vi": "Nhưng,"
  },
  {
    "idx": 6432,
    "start": "02:59:25,091",
    "end": "02:59:27,251",
    "start_sec": 10765.091,
    "end_sec": 10767.251,
    "zh": "可我也算是给爷爷报了仇",
    "vi": "nhưng tôi cũng coi như đã trả thù cho ông nội rồi."
  },
  {
    "idx": 6433,
    "start": "02:59:27,251",
    "end": "02:59:28,011",
    "start_sec": 10767.251,
    "end_sec": 10768.011,
    "zh": "你报个屁",
    "vi": "Trả thù cái khỉ gì chứ."
  },
  {
    "idx": 6434,
    "start": "02:59:28,011",
    "end": "02:59:29,411",
    "start_sec": 10768.011,
    "end_sec": 10769.411,
    "zh": "你杀了这些二十族",
    "vi": "Cô giết những gia tộc này,"
  },
  {
    "idx": 6435,
    "start": "02:59:29,411",
    "end": "02:59:30,791",
    "start_sec": 10769.411,
    "end_sec": 10770.791,
    "zh": "你是出气了",
    "vi": "cô hả giận rồi,"
  },
  {
    "idx": 6436,
    "start": "02:59:30,791",
    "end": "02:59:31,951",
    "start_sec": 10770.791,
    "end_sec": 10771.951,
    "zh": "但真正的罪魁祸首",
    "vi": "nhưng kẻ chủ mưu thực sự"
  },
  {
    "idx": 6437,
    "start": "02:59:31,951",
    "end": "02:59:32,971",
    "start_sec": 10771.951,
    "end_sec": 10772.971,
    "zh": "得到报应了吗",
    "vi": "đã bị trừng phạt chưa."
  },
  {
    "idx": 6438,
    "start": "02:59:32,971",
    "end": "02:59:34,031",
    "start_sec": 10772.971,
    "end_sec": 10774.031,
    "zh": "你有没有想过",
    "vi": "Cô đã từng nghĩ chưa,"
  },
  {
    "idx": 6439,
    "start": "02:59:34,031",
    "end": "02:59:35,271",
    "start_sec": 10774.031,
    "end_sec": 10775.271,
    "zh": "哪怕是你不动手",
    "vi": "ngay cả khi cô không ra tay,"
  },
  {
    "idx": 6440,
    "start": "02:59:35,271",
    "end": "02:59:36,131",
    "start_sec": 10775.271,
    "end_sec": 10776.131,
    "zh": "他徐东南",
    "vi": "thì Từ Đông Nam ông ta"
  },
  {
    "idx": 6441,
    "start": "02:59:36,131",
    "end": "02:59:37,351",
    "start_sec": 10776.131,
    "end_sec": 10777.351,
    "zh": "也要一个一个阻挡你",
    "vi": "cũng sẽ lần lượt ngăn cản cô."
  },
  {
    "idx": 6442,
    "start": "02:59:37,351",
    "end": "02:59:38,011",
    "start_sec": 10777.351,
    "end_sec": 10778.011,
    "zh": "因为",
    "vi": "Bởi vì,"
  },
  {
    "idx": 6443,
    "start": "02:59:38,011",
    "end": "02:59:39,311",
    "start_sec": 10778.011,
    "end_sec": 10779.311,
    "zh": "他需要这个愿望",
    "vi": "ông ta cần điều ước này."
  },
  {
    "idx": 6444,
    "start": "02:59:39,311",
    "end": "02:59:40,611",
    "start_sec": 10779.311,
    "end_sec": 10780.611,
    "zh": "他守在这里",
    "vi": "Ông ta canh giữ ở đây"
  },
  {
    "idx": 6445,
    "start": "02:59:40,611",
    "end": "02:59:42,491",
    "start_sec": 10780.611,
    "end_sec": 10782.491,
    "zh": "可不是为了穿过隧道离开",
    "vi": "không phải để đi qua đường hầm và rời đi,"
  },
  {
    "idx": 6446,
    "start": "02:59:42,491",
    "end": "02:59:44,171",
    "start_sec": 10782.491,
    "end_sec": 10784.171,
    "zh": "而是为了驾驭你爷爷",
    "vi": "mà là để chế ngự ông nội cô,"
  },
  {
    "idx": 6447,
    "start": "02:59:44,171",
    "end": "02:59:45,131",
    "start_sec": 10784.171,
    "end_sec": 10785.131,
    "zh": "成为御鬼者",
    "vi": "trở thành người ngự quỷ."
  },
  {
    "idx": 6448,
    "start": "02:59:45,131",
    "end": "02:59:45,851",
    "start_sec": 10785.131,
    "end_sec": 10785.851,
    "zh": "什么",
    "vi": "Cái gì cơ."
  },
  {
    "idx": 6449,
    "start": "02:59:45,851",
    "end": "02:59:46,871",
    "start_sec": 10785.851,
    "end_sec": 10786.871,
    "zh": "徐队长",
    "vi": "Đội trưởng Từ,"
  },
  {
    "idx": 6450,
    "start": "02:59:46,871",
    "end": "02:59:47,471",
    "start_sec": 10786.871,
    "end_sec": 10787.471,
    "zh": "你",
    "vi": "ông."
  },
  {
    "idx": 6451,
    "start": "02:59:47,471",
    "end": "02:59:49,131",
    "start_sec": 10787.471,
    "end_sec": 10789.131,
    "zh": "罗倩倩",
    "vi": "La Thiến Thiến."
  },
  {
    "idx": 6452,
    "start": "02:59:49,131",
    "end": "02:59:50,471",
    "start_sec": 10789.131,
    "end_sec": 10790.471,
    "zh": "你要你爷爷死后",
    "vi": "Cô muốn ông nội cô sau khi chết."
  },
  {
    "idx": 6453,
    "start": "02:59:50,471",
    "end": "02:59:51,631",
    "start_sec": 10790.471,
    "end_sec": 10791.631,
    "zh": "送给他支配吗",
    "vi": "bị hắn ta khống chế sao."
  },
  {
    "idx": 6454,
    "start": "02:59:51,631",
    "end": "02:59:52,171",
    "start_sec": 10791.631,
    "end_sec": 10792.171,
    "zh": "你",
    "vi": "Anh."
  },
  {
    "idx": 6455,
    "start": "02:59:52,171",
    "end": "02:59:53,751",
    "start_sec": 10792.171,
    "end_sec": 10793.751,
    "zh": "你怎么会知道这么多",
    "vi": "sao anh lại biết nhiều như vậy."
  },
  {
    "idx": 6456,
    "start": "02:59:53,751",
    "end": "02:59:54,811",
    "start_sec": 10793.751,
    "end_sec": 10794.811,
    "zh": "程先生",
    "vi": "Anh Trình."
  },
  {
    "idx": 6457,
    "start": "02:59:54,811",
    "end": "02:59:55,591",
    "start_sec": 10794.811,
    "end_sec": 10795.591,
    "zh": "或许",
    "vi": "có lẽ."
  },
  {
    "idx": 6458,
    "start": "02:59:55,591",
    "end": "02:59:58,091",
    "start_sec": 10795.591,
    "end_sec": 10798.091,
    "zh": "或许你说的没错",
    "vi": "có lẽ những gì anh nói là đúng."
  },
  {
    "idx": 6459,
    "start": "02:59:58,091",
    "end": "02:59:59,851",
    "start_sec": 10798.091,
    "end_sec": 10799.851,
    "zh": "但是徐会长确实",
    "vi": "Nhưng Chủ tịch Từ thực sự."
  },
  {
    "idx": 6460,
    "start": "03:00:00,000",
    "end": "03:00:00,360",
    "start_sec": 10800.0,
    "end_sec": 10800.36,
    "zh": "哇",
    "vi": "Này."
  },
  {
    "idx": 6461,
    "start": "03:00:00,360",
    "end": "03:00:03,080",
    "start_sec": 10800.36,
    "end_sec": 10803.08,
    "zh": "傻逼啊你",
    "vi": "Cô bị ngốc à."
  },
  {
    "idx": 6462,
    "start": "03:00:03,080",
    "end": "03:00:05,200",
    "start_sec": 10803.08,
    "end_sec": 10805.2,
    "zh": "你从头到尾都被人利用",
    "vi": "Cô bị người ta lợi dụng từ đầu đến cuối."
  },
  {
    "idx": 6463,
    "start": "03:00:05,200",
    "end": "03:00:06,460",
    "start_sec": 10805.2,
    "end_sec": 10806.46,
    "zh": "你欠个屁的人情",
    "vi": "Cô nợ ân tình cái nỗi gì."
  },
  {
    "idx": 6464,
    "start": "03:00:06,460",
    "end": "03:00:08,480",
    "start_sec": 10806.46,
    "end_sec": 10808.48,
    "zh": "如果说真要欠谁",
    "vi": "Nếu thực sự nợ ai đó."
  },
  {
    "idx": 6465,
    "start": "03:00:08,480",
    "end": "03:00:10,620",
    "start_sec": 10808.48,
    "end_sec": 10810.62,
    "zh": "有个教室间没有后悔药的网友",
    "vi": "thì có một cư dân mạng tên là Thế gian không có thuốc hối hận."
  },
  {
    "idx": 6466,
    "start": "03:00:10,620",
    "end": "03:00:11,820",
    "start_sec": 10810.62,
    "end_sec": 10811.82,
    "zh": "曾经帮助过你",
    "vi": "đã từng giúp đỡ cô."
  },
  {
    "idx": 6467,
    "start": "03:00:11,820",
    "end": "03:00:13,780",
    "start_sec": 10811.82,
    "end_sec": 10813.78,
    "zh": "还劝你让你爷爷别去送审",
    "vi": "còn khuyên cô đừng để ông nội đi giám định."
  },
  {
    "idx": 6468,
    "start": "03:00:13,780",
    "end": "03:00:14,480",
    "start_sec": 10813.78,
    "end_sec": 10814.48,
    "zh": "是不是",
    "vi": "đúng không."
  },
  {
    "idx": 6469,
    "start": "03:00:14,480",
    "end": "03:00:16,140",
    "start_sec": 10814.48,
    "end_sec": 10816.14,
    "zh": "陈先生",
    "vi": "Anh Trình."
  },
  {
    "idx": 6470,
    "start": "03:00:16,140",
    "end": "03:00:16,720",
    "start_sec": 10816.14,
    "end_sec": 10816.72,
    "zh": "你",
    "vi": "Anh."
  },
  {
    "idx": 6471,
    "start": "03:00:16,720",
    "end": "03:00:17,880",
    "start_sec": 10816.72,
    "end_sec": 10817.88,
    "zh": "你怎么会知道",
    "vi": "sao anh lại biết chuyện đó."
  },
  {
    "idx": 6472,
    "start": "03:00:17,880",
    "end": "03:00:18,760",
    "start_sec": 10817.88,
    "end_sec": 10818.76,
    "zh": "因为",
    "vi": "Bởi vì."
  },
  {
    "idx": 6473,
    "start": "03:00:18,760",
    "end": "03:00:20,440",
    "start_sec": 10818.76,
    "end_sec": 10820.44,
    "zh": "我就是宿间没有后悔药",
    "vi": "tôi chính là Thế gian không có thuốc hối hận."
  },
  {
    "idx": 6474,
    "start": "03:00:20,440",
    "end": "03:00:21,280",
    "start_sec": 10820.44,
    "end_sec": 10821.28,
    "zh": "什么",
    "vi": "Cái gì."
  },
  {
    "idx": 6475,
    "start": "03:00:21,280",
    "end": "03:00:22,440",
    "start_sec": 10821.28,
    "end_sec": 10822.44,
    "zh": "既然是你",
    "vi": "Không ngờ lại là anh."
  },
  {
    "idx": 6476,
    "start": "03:00:22,440",
    "end": "03:00:23,100",
    "start_sec": 10822.44,
    "end_sec": 10823.1,
    "zh": "说不起",
    "vi": "Xin lỗi anh."
  },
  {
    "idx": 6477,
    "start": "03:00:23,100",
    "end": "03:00:23,980",
    "start_sec": 10823.1,
    "end_sec": 10823.98,
    "zh": "陈先生",
    "vi": "Anh Trình."
  },
  {
    "idx": 6478,
    "start": "03:00:23,980",
    "end": "03:00:24,560",
    "start_sec": 10823.98,
    "end_sec": 10824.56,
    "zh": "我",
    "vi": "Tôi."
  },
  {
    "idx": 6479,
    "start": "03:00:24,560",
    "end": "03:00:26,200",
    "start_sec": 10824.56,
    "end_sec": 10826.2,
    "zh": "我竟然还算计过你",
    "vi": "tôi vậy mà còn từng tính kế anh."
  },
  {
    "idx": 6480,
    "start": "03:00:26,200",
    "end": "03:00:27,900",
    "start_sec": 10826.2,
    "end_sec": 10827.9,
    "zh": "我帮你转发动态",
    "vi": "Tôi đã giúp anh chia sẻ bài viết."
  },
  {
    "idx": 6481,
    "start": "03:00:27,900",
    "end": "03:00:29,160",
    "start_sec": 10827.9,
    "end_sec": 10829.16,
    "zh": "你说要请我吃饭",
    "vi": "Anh nói muốn mời tôi ăn cơm"
  },
  {
    "idx": 6482,
    "start": "03:00:29,160",
    "end": "03:00:30,040",
    "start_sec": 10829.16,
    "end_sec": 10830.04,
    "zh": "到现在都没实现,",
    "vi": "Đến giờ vẫn chưa thực hiện"
  },
  {
    "idx": 6483,
    "start": "03:00:30,380",
    "end": "03:00:31,200",
    "start_sec": 10830.38,
    "end_sec": 10831.2,
    "zh": "你还欠我一顿饭,",
    "vi": "Anh còn nợ tôi một bữa ăn"
  },
  {
    "idx": 6484,
    "start": "03:00:31,500",
    "end": "03:00:31,760",
    "start_sec": 10831.5,
    "end_sec": 10831.76,
    "zh": "对吧?",
    "vi": "Đúng không."
  },
  {
    "idx": 6485,
    "start": "03:00:32,200",
    "end": "03:00:32,700",
    "start_sec": 10832.2,
    "end_sec": 10832.7,
    "zh": "对不起,",
    "vi": "Xin lỗi"
  },
  {
    "idx": 6486,
    "start": "03:00:33,040",
    "end": "03:00:33,880",
    "start_sec": 10833.04,
    "end_sec": 10833.88,
    "zh": "因为那天,",
    "vi": "Vì hôm đó"
  },
  {
    "idx": 6487,
    "start": "03:00:34,180",
    "end": "03:00:34,480",
    "start_sec": 10834.18,
    "end_sec": 10834.48,
    "zh": "我,",
    "vi": "Tôi"
  },
  {
    "idx": 6488,
    "start": "03:00:34,820",
    "end": "03:00:36,020",
    "start_sec": 10834.82,
    "end_sec": 10836.02,
    "zh": "我爷爷刚好出事,",
    "vi": "Ông nội tôi vừa hay gặp chuyện"
  },
  {
    "idx": 6489,
    "start": "03:00:36,400",
    "end": "03:00:36,700",
    "start_sec": 10836.4,
    "end_sec": 10836.7,
    "zh": "所以,",
    "vi": "Cho nên"
  },
  {
    "idx": 6490,
    "start": "03:00:38,100",
    "end": "03:00:39,700",
    "start_sec": 10838.1,
    "end_sec": 10839.7,
    "zh": "所以,",
    "vi": "Cho nên"
  },
  {
    "idx": 6491,
    "start": "03:00:40,760",
    "end": "03:00:42,160",
    "start_sec": 10840.76,
    "end_sec": 10842.16,
    "zh": "你现在给老子出来,",
    "vi": "Bây giờ anh ra đây ngay cho tôi"
  },
  {
    "idx": 6492,
    "start": "03:00:42,500",
    "end": "03:00:43,140",
    "start_sec": 10842.5,
    "end_sec": 10843.14,
    "zh": "陪我一顿饭,",
    "vi": "Ăn với tôi một bữa"
  },
  {
    "idx": 6493,
    "start": "03:00:44,400",
    "end": "03:00:44,700",
    "start_sec": 10844.4,
    "end_sec": 10844.7,
    "zh": "不,",
    "vi": "Không"
  },
  {
    "idx": 6494,
    "start": "03:00:45,020",
    "end": "03:00:45,680",
    "start_sec": 10845.02,
    "end_sec": 10845.68,
    "zh": "不行的,",
    "vi": "Không được đâu"
  },
  {
    "idx": 6495,
    "start": "03:00:45,940",
    "end": "03:00:46,480",
    "start_sec": 10845.94,
    "end_sec": 10846.48,
    "zh": "我走了,",
    "vi": "Tôi mà đi"
  },
  {
    "idx": 6496,
    "start": "03:00:46,880",
    "end": "03:00:47,720",
    "start_sec": 10846.88,
    "end_sec": 10847.72,
    "zh": "陷阱被打断,",
    "vi": "Bẫy bị gián đoạn"
  },
  {
    "idx": 6497,
    "start": "03:00:48,040",
    "end": "03:00:49,140",
    "start_sec": 10848.04,
    "end_sec": 10849.14,
    "zh": "爷爷会发狂的,",
    "vi": "Ông nội sẽ phát điên mất"
  },
  {
    "idx": 6498,
    "start": "03:00:49,600",
    "end": "03:00:50,000",
    "start_sec": 10849.6,
    "end_sec": 10850.0,
    "zh": "怕什么?",
    "vi": "Sợ gì chứ."
  },
  {
    "idx": 6499,
    "start": "03:00:50,580",
    "end": "03:00:51,600",
    "start_sec": 10850.58,
    "end_sec": 10851.6,
    "zh": "那不是有个人吗?",
    "vi": "Kia không phải có một người sao."
  },
  {
    "idx": 6500,
    "start": "03:00:52,220",
    "end": "03:00:52,860",
    "start_sec": 10852.22,
    "end_sec": 10852.86,
    "zh": "拿他点,",
    "vi": "Dùng hắn thế chỗ"
  },
  {
    "idx": 6501,
    "start": "03:00:53,300",
    "end": "03:00:53,520",
    "start_sec": 10853.3,
    "end_sec": 10853.52,
    "zh": "不,",
    "vi": "Không"
  },
  {
    "idx": 6502,
    "start": "03:00:53,740",
    "end": "03:00:53,960",
    "start_sec": 10853.74,
    "end_sec": 10853.96,
    "zh": "不,",
    "vi": "Không"
  },
  {
    "idx": 6503,
    "start": "03:00:54,420",
    "end": "03:00:54,980",
    "start_sec": 10854.42,
    "end_sec": 10854.98,
    "zh": "罗倩倩,",
    "vi": "La Thiến Thiến"
  },
  {
    "idx": 6504,
    "start": "03:00:55,200",
    "end": "03:00:56,520",
    "start_sec": 10855.2,
    "end_sec": 10856.52,
    "zh": "你不能忘恩负义,",
    "vi": "Cô không thể vong ân bội nghĩa"
  },
  {
    "idx": 6505,
    "start": "03:00:57,000",
    "end": "03:00:57,660",
    "start_sec": 10857.0,
    "end_sec": 10857.66,
    "zh": "我帮过你,",
    "vi": "Tôi từng giúp cô"
  },
  {
    "idx": 6506,
    "start": "03:00:58,140",
    "end": "03:00:58,720",
    "start_sec": 10858.14,
    "end_sec": 10858.72,
    "zh": "成此题,",
    "vi": "Thành Thử Đề"
  },
  {
    "idx": 6507,
    "start": "03:00:58,720",
    "end": "03:01:00,380",
    "start_sec": 10858.72,
    "end_sec": 10860.38,
    "zh": "我爸就在曙光邮轮上",
    "vi": "Bố tôi đang ở trên du thuyền Hừng Đông"
  },
  {
    "idx": 6508,
    "start": "03:01:00,380",
    "end": "03:01:01,560",
    "start_sec": 10860.38,
    "end_sec": 10861.56,
    "zh": "你要是敢弄死我",
    "vi": "Nếu cô dám hại chết tôi"
  },
  {
    "idx": 6509,
    "start": "03:01:01,560",
    "end": "03:01:03,280",
    "start_sec": 10861.56,
    "end_sec": 10863.28,
    "zh": "我爸有的是手段找到你",
    "vi": "Bố tôi có đầy cách để tìm ra cô"
  },
  {
    "idx": 6510,
    "start": "03:01:03,280",
    "end": "03:01:04,660",
    "start_sec": 10863.28,
    "end_sec": 10864.66,
    "zh": "以后生存者基地里",
    "vi": "Sau này trong căn cứ người sống sót"
  },
  {
    "idx": 6511,
    "start": "03:01:04,660",
    "end": "03:01:06,020",
    "start_sec": 10864.66,
    "end_sec": 10866.02,
    "zh": "你绝对寸步难行",
    "vi": "Ông tuyệt đối sẽ không thể đi đâu được."
  },
  {
    "idx": 6512,
    "start": "03:01:06,020",
    "end": "03:01:06,560",
    "start_sec": 10866.02,
    "end_sec": 10866.56,
    "zh": "哦",
    "vi": "Ồ."
  },
  {
    "idx": 6513,
    "start": "03:01:06,560",
    "end": "03:01:08,560",
    "start_sec": 10866.56,
    "end_sec": 10868.56,
    "zh": "不是去隔壁问海事吗",
    "vi": "Không phải là sang bên cạnh hỏi chuyện hàng hải sao."
  },
  {
    "idx": 6514,
    "start": "03:01:08,560",
    "end": "03:01:09,800",
    "start_sec": 10868.56,
    "end_sec": 10869.8,
    "zh": "你真正的目的是",
    "vi": "Mục đích thật sự của ông là"
  },
  {
    "idx": 6515,
    "start": "03:01:09,800",
    "end": "03:01:10,980",
    "start_sec": 10869.8,
    "end_sec": 10870.98,
    "zh": "融合食山鬼",
    "vi": "dung hợp Thực Sơn Quỷ"
  },
  {
    "idx": 6516,
    "start": "03:01:10,980",
    "end": "03:01:11,940",
    "start_sec": 10870.98,
    "end_sec": 10871.94,
    "zh": "成为异鬼者",
    "vi": "để trở thành Dị Quỷ Nhân"
  },
  {
    "idx": 6517,
    "start": "03:01:11,940",
    "end": "03:01:14,320",
    "start_sec": 10871.94,
    "end_sec": 10874.32,
    "zh": "然后乘坐两天后的邮轮吧",
    "vi": "rồi lên chiếc du thuyền hai ngày sau đúng không."
  },
  {
    "idx": 6518,
    "start": "03:01:14,320",
    "end": "03:01:16,920",
    "start_sec": 10874.32,
    "end_sec": 10876.92,
    "zh": "鬼面窗",
    "vi": "Quỷ Diện Song."
  },
  {
    "idx": 6519,
    "start": "03:01:16,920",
    "end": "03:01:17,520",
    "start_sec": 10876.92,
    "end_sec": 10877.52,
    "zh": "出来",
    "vi": "Ra đây."
  },
  {
    "idx": 6520,
    "start": "03:01:17,520",
    "end": "03:01:25,280",
    "start_sec": 10877.52,
    "end_sec": 10885.28,
    "zh": "你",
    "vi": "Ông"
  },
  {
    "idx": 6521,
    "start": "03:01:25,280",
    "end": "03:01:26,240",
    "start_sec": 10885.28,
    "end_sec": 10886.24,
    "zh": "你要干什么",
    "vi": "ông muốn làm gì."
  },
  {
    "idx": 6522,
    "start": "03:01:26,240",
    "end": "03:01:27,580",
    "start_sec": 10886.24,
    "end_sec": 10887.58,
    "zh": "干什么",
    "vi": "Làm gì sao."
  },
  {
    "idx": 6523,
    "start": "03:01:27,580",
    "end": "03:01:29,540",
    "start_sec": 10887.58,
    "end_sec": 10889.54,
    "zh": "当然是拿你做第五炷香",
    "vi": "Dĩ nhiên là dùng ông làm cây nhang thứ năm rồi."
  },
  {
    "idx": 6524,
    "start": "03:01:29,540",
    "end": "03:01:33,660",
    "start_sec": 10889.54,
    "end_sec": 10893.66,
    "zh": "程子齐",
    "vi": "Trình Tử Tề."
  },
  {
    "idx": 6525,
    "start": "03:01:33,660",
    "end": "03:01:35,040",
    "start_sec": 10893.66,
    "end_sec": 10895.04,
    "zh": "你绝对不敢杀我",
    "vi": "Mày tuyệt đối không dám giết tao."
  },
  {
    "idx": 6526,
    "start": "03:01:35,040",
    "end": "03:01:36,520",
    "start_sec": 10895.04,
    "end_sec": 10896.52,
    "zh": "我赌你不敢杀我",
    "vi": "Tao cá là mày không dám giết tao."
  },
  {
    "idx": 6527,
    "start": "03:01:36,520",
    "end": "03:01:38,860",
    "start_sec": 10896.52,
    "end_sec": 10898.86,
    "zh": "那你赌错了",
    "vi": "Vậy thì ông cược sai rồi."
  },
  {
    "idx": 6528,
    "start": "03:01:38,860",
    "end": "03:01:40,480",
    "start_sec": 10898.86,
    "end_sec": 10900.48,
    "zh": "一直以来我都是和鬼赌命",
    "vi": "Từ trước đến nay tôi đều cược mạng với quỷ."
  },
  {
    "idx": 6529,
    "start": "03:01:40,480",
    "end": "03:01:42,540",
    "start_sec": 10900.48,
    "end_sec": 10902.54,
    "zh": "今天倒是和你赌上命了",
    "vi": "Hôm nay lại cược mạng với ông rồi."
  },
  {
    "idx": 6530,
    "start": "03:01:42,540",
    "end": "03:01:45,460",
    "start_sec": 10902.54,
    "end_sec": 10905.46,
    "zh": "罗倩倩",
    "vi": "La Thiến Thiến."
  },
  {
    "idx": 6531,
    "start": "03:01:45,460",
    "end": "03:01:46,500",
    "start_sec": 10905.46,
    "end_sec": 10906.5,
    "zh": "出来",
    "vi": "Ra đây đi."
  },
  {
    "idx": 6532,
    "start": "03:01:46,500",
    "end": "03:01:47,780",
    "start_sec": 10906.5,
    "end_sec": 10907.78,
    "zh": "对不起",
    "vi": "Xin lỗi."
  },
  {
    "idx": 6533,
    "start": "03:01:47,780",
    "end": "03:01:48,580",
    "start_sec": 10907.78,
    "end_sec": 10908.58,
    "zh": "程",
    "vi": "Anh"
  },
  {
    "idx": 6534,
    "start": "03:01:48,580",
    "end": "03:01:49,600",
    "start_sec": 10908.58,
    "end_sec": 10909.6,
    "zh": "程先生",
    "vi": "anh Trình."
  },
  {
    "idx": 6535,
    "start": "03:01:49,600",
    "end": "03:01:51,280",
    "start_sec": 10909.6,
    "end_sec": 10911.28,
    "zh": "你杀了徐会长",
    "vi": "Anh giết Từ hội trưởng rồi"
  },
  {
    "idx": 6536,
    "start": "03:01:51,280",
    "end": "03:01:52,020",
    "start_sec": 10911.28,
    "end_sec": 10912.02,
    "zh": "以后",
    "vi": "sau này"
  },
  {
    "idx": 6537,
    "start": "03:01:52,020",
    "end": "03:01:53,560",
    "start_sec": 10912.02,
    "end_sec": 10913.56,
    "zh": "以后会有麻烦的",
    "vi": "sau này sẽ gặp rắc rối đó."
  },
  {
    "idx": 6538,
    "start": "03:01:53,560",
    "end": "03:01:56,020",
    "start_sec": 10913.56,
    "end_sec": 10916.02,
    "zh": "我不想你以后会有什么危险",
    "vi": "Em không muốn sau này anh gặp nguy hiểm gì cả."
  },
  {
    "idx": 6539,
    "start": "03:01:56,020",
    "end": "03:01:56,620",
    "start_sec": 10916.02,
    "end_sec": 10916.62,
    "zh": "这",
    "vi": "Cây"
  },
  {
    "idx": 6540,
    "start": "03:01:56,620",
    "end": "03:01:59,020",
    "start_sec": 10916.62,
    "end_sec": 10919.02,
    "zh": "这第五珠箱还是我",
    "vi": "cây nhang thứ năm này hay là để em đi."
  },
  {
    "idx": 6541,
    "start": "03:01:59,020",
    "end": "03:01:59,940",
    "start_sec": 10919.02,
    "end_sec": 10919.94,
    "zh": "我来吧",
    "vi": "Để tôi đi"
  },
  {
    "idx": 6542,
    "start": "03:01:59,940",
    "end": "03:02:00,640",
    "start_sec": 10919.94,
    "end_sec": 10920.64,
    "zh": "而且",
    "vi": "Hơn nữa"
  },
  {
    "idx": 6543,
    "start": "03:02:00,640",
    "end": "03:02:01,400",
    "start_sec": 10920.64,
    "end_sec": 10921.4,
    "zh": "而且",
    "vi": "Hơn nữa"
  },
  {
    "idx": 6544,
    "start": "03:02:01,400",
    "end": "03:02:02,700",
    "start_sec": 10921.4,
    "end_sec": 10922.7,
    "zh": "我已经",
    "vi": "Tôi đã"
  },
  {
    "idx": 6545,
    "start": "03:02:02,700",
    "end": "03:02:04,160",
    "start_sec": 10922.7,
    "end_sec": 10924.16,
    "zh": "已经出行了",
    "vi": "Đã ra ngoài rồi"
  },
  {
    "idx": 6546,
    "start": "03:02:04,160",
    "end": "03:02:06,000",
    "start_sec": 10924.16,
    "end_sec": 10926.0,
    "zh": "十三鬼一夜",
    "vi": "Mười ba con quỷ một đêm"
  },
  {
    "idx": 6547,
    "start": "03:02:06,000",
    "end": "03:02:06,780",
    "start_sec": 10926.0,
    "end_sec": 10926.78,
    "zh": "这个愿望",
    "vi": "Nguyện vọng này"
  },
  {
    "idx": 6548,
    "start": "03:02:06,780",
    "end": "03:02:07,300",
    "start_sec": 10926.78,
    "end_sec": 10927.3,
    "zh": "给",
    "vi": "Trao"
  },
  {
    "idx": 6549,
    "start": "03:02:07,300",
    "end": "03:02:08,660",
    "start_sec": 10927.3,
    "end_sec": 10928.66,
    "zh": "给程先生吧",
    "vi": "Cho tiên sinh Trình đi"
  },
  {
    "idx": 6550,
    "start": "03:02:08,660",
    "end": "03:02:09,360",
    "start_sec": 10928.66,
    "end_sec": 10929.36,
    "zh": "说完",
    "vi": "Nói xong"
  },
  {
    "idx": 6551,
    "start": "03:02:09,360",
    "end": "03:02:11,180",
    "start_sec": 10929.36,
    "end_sec": 10931.18,
    "zh": "罗倩倩已经彻底断了记",
    "vi": "La Thiến Thiến đã hoàn toàn mất trí nhớ"
  },
  {
    "idx": 6552,
    "start": "03:02:11,180",
    "end": "03:02:12,200",
    "start_sec": 10931.18,
    "end_sec": 10932.2,
    "zh": "实际上",
    "vi": "Thực ra"
  },
  {
    "idx": 6553,
    "start": "03:02:12,200",
    "end": "03:02:13,100",
    "start_sec": 10932.2,
    "end_sec": 10933.1,
    "zh": "无计是几话",
    "vi": "Không biết mấy lời"
  },
  {
    "idx": 6554,
    "start": "03:02:13,100",
    "end": "03:02:13,580",
    "start_sec": 10933.1,
    "end_sec": 10933.58,
    "zh": "为红针",
    "vi": "Vì kim đỏ"
  },
  {
    "idx": 6555,
    "start": "03:02:13,580",
    "end": "03:02:14,740",
    "start_sec": 10933.58,
    "end_sec": 10934.74,
    "zh": "消散了眼睛",
    "vi": "Đã làm mờ mắt"
  },
  {
    "idx": 6556,
    "start": "03:02:14,740",
    "end": "03:02:17,020",
    "start_sec": 10934.74,
    "end_sec": 10937.02,
    "zh": "说吧",
    "vi": "Nói đi"
  },
  {
    "idx": 6557,
    "start": "03:02:17,020",
    "end": "03:02:18,640",
    "start_sec": 10937.02,
    "end_sec": 10938.64,
    "zh": "说出你的愿望",
    "vi": "Nói ra nguyện vọng của ngươi đi"
  },
  {
    "idx": 6558,
    "start": "03:02:18,640",
    "end": "03:02:19,980",
    "start_sec": 10938.64,
    "end_sec": 10939.98,
    "zh": "等等",
    "vi": "Khoan đã"
  },
  {
    "idx": 6559,
    "start": "03:02:19,980",
    "end": "03:02:20,880",
    "start_sec": 10939.98,
    "end_sec": 10940.88,
    "zh": "程子皮",
    "vi": "Trình Tử Bì"
  },
  {
    "idx": 6560,
    "start": "03:02:20,880",
    "end": "03:02:21,980",
    "start_sec": 10940.88,
    "end_sec": 10941.98,
    "zh": "程子皮",
    "vi": "Trình Tử Bì"
  },
  {
    "idx": 6561,
    "start": "03:02:21,980",
    "end": "03:02:23,740",
    "start_sec": 10941.98,
    "end_sec": 10943.74,
    "zh": "你说让我成为他的御鬼者",
    "vi": "Ngươi nói để ta trở thành người điều khiển quỷ của hắn"
  },
  {
    "idx": 6562,
    "start": "03:02:23,740",
    "end": "03:02:24,720",
    "start_sec": 10943.74,
    "end_sec": 10944.72,
    "zh": "听见没",
    "vi": "Nghe thấy không"
  },
  {
    "idx": 6563,
    "start": "03:02:24,720",
    "end": "03:02:25,980",
    "start_sec": 10944.72,
    "end_sec": 10945.98,
    "zh": "你这么说了",
    "vi": "Ngươi đã nói vậy rồi"
  },
  {
    "idx": 6564,
    "start": "03:02:25,980",
    "end": "03:02:27,680",
    "start_sec": 10945.98,
    "end_sec": 10947.68,
    "zh": "我保你以后在游轮上",
    "vi": "Ta đảm bảo ngươi sẽ sống sung túc trên tàu và trong căn cứ người sống sót"
  },
  {
    "idx": 6565,
    "start": "03:02:27,680",
    "end": "03:02:29,500",
    "start_sec": 10947.68,
    "end_sec": 10949.5,
    "zh": "和净存者基地里衣食无忧",
    "vi": "Vô lo vô nghĩ"
  },
  {
    "idx": 6566,
    "start": "03:02:29,500",
    "end": "03:02:31,200",
    "start_sec": 10949.5,
    "end_sec": 10951.2,
    "zh": "傻逼吧你",
    "vi": "Ngươi đúng là đồ ngu"
  },
  {
    "idx": 6567,
    "start": "03:02:31,200",
    "end": "03:02:32,980",
    "start_sec": 10951.2,
    "end_sec": 10952.98,
    "zh": "老子正一步走火呢",
    "vi": "Lão tử đang trên đà thăng tiến"
  },
  {
    "idx": 6568,
    "start": "03:02:32,980",
    "end": "03:02:34,480",
    "start_sec": 10952.98,
    "end_sec": 10954.48,
    "zh": "你还敢有脸要求我",
    "vi": "Ngươi còn dám yêu cầu ta"
  },
  {
    "idx": 6569,
    "start": "03:02:34,480",
    "end": "03:02:35,860",
    "start_sec": 10954.48,
    "end_sec": 10955.86,
    "zh": "你不敢杀我",
    "vi": "Ngươi không dám giết ta"
  },
  {
    "idx": 6570,
    "start": "03:02:35,860",
    "end": "03:02:37,400",
    "start_sec": 10955.86,
    "end_sec": 10957.4,
    "zh": "你就是不敢杀我",
    "vi": "Ngươi không dám giết ta"
  },
  {
    "idx": 6571,
    "start": "03:02:37,400",
    "end": "03:02:39,820",
    "start_sec": 10957.4,
    "end_sec": 10959.82,
    "zh": "你也要去南城河大桥的另一边码头",
    "vi": "Ngươi cũng muốn đến bến tàu phía bên kia cầu sông Nam Thành"
  },
  {
    "idx": 6572,
    "start": "03:02:39,820",
    "end": "03:02:40,800",
    "start_sec": 10959.82,
    "end_sec": 10960.8,
    "zh": "再游两天",
    "vi": "Bơi thêm hai ngày nữa"
  },
  {
    "idx": 6573,
    "start": "03:02:40,800",
    "end": "03:02:42,380",
    "start_sec": 10960.8,
    "end_sec": 10962.38,
    "zh": "曙光号就会经过这里",
    "vi": "Tàu Thự Quang sẽ đi ngang qua đây"
  },
  {
    "idx": 6574,
    "start": "03:02:42,380",
    "end": "03:02:43,120",
    "start_sec": 10962.38,
    "end_sec": 10963.12,
    "zh": "到时候",
    "vi": "Đến lúc đó"
  },
  {
    "idx": 6575,
    "start": "03:02:43,120",
    "end": "03:02:44,460",
    "start_sec": 10963.12,
    "end_sec": 10964.46,
    "zh": "我爸带人来找我",
    "vi": "Cha ta dẫn người đến tìm ta"
  },
  {
    "idx": 6576,
    "start": "03:02:44,460",
    "end": "03:02:45,600",
    "start_sec": 10964.46,
    "end_sec": 10965.6,
    "zh": "要是没见到我",
    "vi": "Nếu không thấy ta"
  },
  {
    "idx": 6577,
    "start": "03:02:45,600",
    "end": "03:02:46,660",
    "start_sec": 10965.6,
    "end_sec": 10966.66,
    "zh": "你说他会怎么样",
    "vi": "Ngươi nói xem ông ấy sẽ làm gì"
  },
  {
    "idx": 6578,
    "start": "03:02:46,660",
    "end": "03:02:49,080",
    "start_sec": 10966.66,
    "end_sec": 10969.08,
    "zh": "他要是见到你还活着而我却死呢",
    "vi": "Nếu ông ấy thấy ngươi còn sống mà ta lại chết"
  },
  {
    "idx": 6579,
    "start": "03:02:49,080",
    "end": "03:02:50,980",
    "start_sec": 10969.08,
    "end_sec": 10970.98,
    "zh": "到时候你肯定会生不如死",
    "vi": "Đến lúc đó ngươi chắc chắn sẽ sống không bằng chết"
  },
  {
    "idx": 6580,
    "start": "03:02:50,980",
    "end": "03:02:53,320",
    "start_sec": 10970.98,
    "end_sec": 10973.32,
    "zh": "你们这些投了个好胎的二十度",
    "vi": "Các ngươi là những kẻ đầu thai tốt số"
  },
  {
    "idx": 6581,
    "start": "03:02:53,320",
    "end": "03:02:55,100",
    "start_sec": 10973.32,
    "end_sec": 10975.1,
    "zh": "到底哪里来的盲目的自信",
    "vi": "Rốt cuộc lấy đâu ra sự tự tin mù quáng đó"
  },
  {
    "idx": 6582,
    "start": "03:02:55,980",
    "end": "03:02:59,607",
    "start_sec": 10975.98,
    "end_sec": 10979.607,
    "zh": "是啊,我不杀你,你既然这么想和石像鬼融合,那就让他吃了你,也算是一种方式满足你的愿望。",
    "vi": "Phải rồi ta không giết ngươi vì ngươi muốn hòa làm một với tượng quỷ thì"
  },
  {
    "idx": 6582,
    "start": "03:02:59,607",
    "end": "03:03:02,780",
    "start_sec": 10979.607,
    "end_sec": 10982.78,
    "zh": "是啊,我不杀你,你既然这么想和石像鬼融合,那就让他吃了你,也算是一种方式满足你的愿望。",
    "vi": "cứ để nó ăn thịt ngươi xem như thỏa mãn nguyện vọng của ngươi"
  },
  {
    "idx": 6583,
    "start": "03:03:08,940",
    "end": "03:03:13,040",
    "start_sec": 10988.94,
    "end_sec": 10993.04,
    "zh": "我让你把龙身身碎,等等,我能不能许愿直接跟上游轮?",
    "vi": "Ta bảo ngươi phá nát thân rồng khoan đã ta có thể ước trực tiếp đuổi kịp du thuyền không"
  },
  {
    "idx": 6584,
    "start": "03:03:13,700",
    "end": "03:03:17,480",
    "start_sec": 10993.7,
    "end_sec": 10997.48,
    "zh": "不能,这个愿望只能在随中范围内实现。",
    "vi": "Không được nguyện vọng này chỉ có thể thực hiện trong phạm vi nhất định"
  },
  {
    "idx": 6585,
    "start": "03:03:17,980",
    "end": "03:03:21,325",
    "start_sec": 10997.98,
    "end_sec": 11001.325,
    "zh": "我考,果然,石像鬼的能力还是不够,不然我直接许愿天下鬼异都消失,岂不是更好?",
    "vi": "Chết tiệt quả nhiên năng lực của tượng quỷ vẫn chưa đủ nếu không ta ước"
  },
  {
    "idx": 6585,
    "start": "03:03:21,325",
    "end": "03:03:24,460",
    "start_sec": 11001.325,
    "end_sec": 11004.46,
    "zh": "我考,果然,石像鬼的能力还是不够,不然我直接许愿天下鬼异都消失,岂不是更好?",
    "vi": "cho tất cả quỷ dị trên thế gian biến mất chẳng phải tốt hơn sao"
  },
  {
    "idx": 6586,
    "start": "03:03:24,460",
    "end": "03:03:25,340",
    "start_sec": 11004.46,
    "end_sec": 11005.34,
    "zh": "算了",
    "vi": "Thôi bỏ đi"
  },
  {
    "idx": 6587,
    "start": "03:03:25,340",
    "end": "03:03:27,060",
    "start_sec": 11005.34,
    "end_sec": 11007.06,
    "zh": "你还是改通深山隧道吧",
    "vi": "Ngươi vẫn nên thông đường hầm núi sâu đi"
  },
  {
    "idx": 6588,
    "start": "03:03:27,060",
    "end": "03:03:27,720",
    "start_sec": 11007.06,
    "end_sec": 11007.72,
    "zh": "说完",
    "vi": "Nói xong"
  },
  {
    "idx": 6589,
    "start": "03:03:27,720",
    "end": "03:03:30,160",
    "start_sec": 11007.72,
    "end_sec": 11010.16,
    "zh": "石香鬼没有任何感情的点点头",
    "vi": "Tượng quỷ gật đầu không chút cảm xúc"
  },
  {
    "idx": 6590,
    "start": "03:03:30,160",
    "end": "03:03:31,600",
    "start_sec": 11010.16,
    "end_sec": 11011.6,
    "zh": "继而退入烟雾之中",
    "vi": "Rồi lùi vào trong làn khói"
  },
  {
    "idx": 6591,
    "start": "03:03:31,600",
    "end": "03:03:33,420",
    "start_sec": 11011.6,
    "end_sec": 11013.42,
    "zh": "随后",
    "vi": "Sau đó"
  },
  {
    "idx": 6592,
    "start": "03:03:33,420",
    "end": "03:03:35,760",
    "start_sec": 11013.42,
    "end_sec": 11015.76,
    "zh": "隧道尽头将是传来的阵阵哗哩",
    "vi": "Cuối đường hầm truyền đến những tiếng ồn ào"
  },
  {
    "idx": 6593,
    "start": "03:03:35,760",
    "end": "03:03:36,640",
    "start_sec": 11015.76,
    "end_sec": 11016.64,
    "zh": "隧道面",
    "vi": "Trong đường hầm"
  },
  {
    "idx": 6594,
    "start": "03:03:36,640",
    "end": "03:03:39,140",
    "start_sec": 11016.64,
    "end_sec": 11019.14,
    "zh": "下一个王贵的风声从尽头出推来",
    "vi": "Luồng gió mạnh thổi đến từ phía cuối đường"
  },
  {
    "idx": 6595,
    "start": "03:03:39,140",
    "end": "03:03:40,400",
    "start_sec": 11019.14,
    "end_sec": 11020.4,
    "zh": "满隧道的烟雾",
    "vi": "Làn khói đầy đường hầm"
  },
  {
    "idx": 6596,
    "start": "03:03:40,400",
    "end": "03:03:41,680",
    "start_sec": 11020.4,
    "end_sec": 11021.68,
    "zh": "四合顿时消散",
    "vi": "Tức thì tan biến"
  },
  {
    "idx": 6597,
    "start": "03:03:41,680",
    "end": "03:03:45,280",
    "start_sec": 11021.68,
    "end_sec": 11025.28,
    "zh": "说来",
    "vi": "Nói đi cũng phải nói lại"
  },
  {
    "idx": 6598,
    "start": "03:03:45,280",
    "end": "03:03:46,940",
    "start_sec": 11025.28,
    "end_sec": 11026.94,
    "zh": "过去的我对罗倩倩有好感",
    "vi": "Tôi của quá khứ từng có cảm tình với La Thiến Thiến"
  },
  {
    "idx": 6599,
    "start": "03:03:46,940",
    "end": "03:03:48,240",
    "start_sec": 11026.94,
    "end_sec": 11028.24,
    "zh": "某种意义上来说",
    "vi": "Xét theo một ý nghĩa nào đó"
  },
  {
    "idx": 6600,
    "start": "03:03:48,240",
    "end": "03:03:49,620",
    "start_sec": 11028.24,
    "end_sec": 11029.62,
    "zh": "现在的我对罗倩倩",
    "vi": "Tôi của hiện tại đối với La Thiến Thiến"
  },
  {
    "idx": 6601,
    "start": "03:03:49,620",
    "end": "03:03:51,080",
    "start_sec": 11029.62,
    "end_sec": 11031.08,
    "zh": "也会有一次异样的感觉",
    "vi": "Cũng sẽ có một cảm giác kỳ lạ."
  },
  {
    "idx": 6602,
    "start": "03:03:51,080",
    "end": "03:03:52,600",
    "start_sec": 11031.08,
    "end_sec": 11032.6,
    "zh": "为什么罗倩倩死的时候",
    "vi": "Tại sao khi La Thiến Thiến chết"
  },
  {
    "idx": 6603,
    "start": "03:03:52,600",
    "end": "03:03:54,080",
    "start_sec": 11032.6,
    "end_sec": 11034.08,
    "zh": "我就生不出来一点伤感",
    "vi": "Tôi lại không hề cảm thấy đau lòng chút nào."
  },
  {
    "idx": 6604,
    "start": "03:03:54,080",
    "end": "03:03:57,600",
    "start_sec": 11034.08,
    "end_sec": 11037.6,
    "zh": "难道是我已经习惯这诡异末日下的生与死别",
    "vi": "Phải chăng tôi đã quen với sự chia lìa sinh tử trong ngày tận thế kỳ quái này."
  },
  {
    "idx": 6605,
    "start": "03:03:57,600",
    "end": "03:03:59,320",
    "start_sec": 11037.6,
    "end_sec": 11039.32,
    "zh": "所以才变得愈发冷血吗",
    "vi": "Nên mới ngày càng trở nên máu lạnh hơn."
  },
  {
    "idx": 6606,
    "start": "03:03:59,320",
    "end": "03:04:01,120",
    "start_sec": 11039.32,
    "end_sec": 11041.12,
    "zh": "换作是一个月前的我",
    "vi": "Nếu là tôi của một tháng trước"
  },
  {
    "idx": 6607,
    "start": "03:04:01,120",
    "end": "03:04:02,640",
    "start_sec": 11041.12,
    "end_sec": 11042.64,
    "zh": "肯定会大哭一场吧",
    "vi": "Chắc chắn sẽ khóc một trận thật to."
  },
  {
    "idx": 6608,
    "start": "03:04:02,640",
    "end": "03:04:04,920",
    "start_sec": 11042.64,
    "end_sec": 11044.92,
    "zh": "橙子皮剃头朝着叶子里走进",
    "vi": "Trần Tử Bì cúi đầu đi vào trong màn đêm."
  },
  {
    "idx": 6609,
    "start": "03:04:04,920",
    "end": "03:04:06,160",
    "start_sec": 11044.92,
    "end_sec": 11046.16,
    "zh": "风声越来越大",
    "vi": "Tiếng gió ngày càng lớn hơn."
  },
  {
    "idx": 6610,
    "start": "03:04:09,400",
    "end": "03:04:11,200",
    "start_sec": 11049.4,
    "end_sec": 11051.2,
    "zh": "深山隧道终于出来了",
    "vi": "Cuối cùng cũng ra khỏi đường hầm Thâm Sơn rồi."
  },
  {
    "idx": 6611,
    "start": "03:04:11,200",
    "end": "03:04:13,920",
    "start_sec": 11051.2,
    "end_sec": 11053.92,
    "zh": "接下来就是走过南城河大桥了吧",
    "vi": "Tiếp theo là đi qua cầu sông Nam Thành phải không."
  },
  {
    "idx": 6612,
    "start": "03:04:13,920",
    "end": "03:04:18,080",
    "start_sec": 11053.92,
    "end_sec": 11058.08,
    "zh": "离开深山隧道",
    "vi": "Rời khỏi đường hầm Thâm Sơn"
  },
  {
    "idx": 6613,
    "start": "03:04:18,080",
    "end": "03:04:20,480",
    "start_sec": 11058.08,
    "end_sec": 11060.48,
    "zh": "橙子皮快步迈向南城河大桥",
    "vi": "Trần Tử Bì rảo bước đi về phía cầu sông Nam Thành."
  },
  {
    "idx": 6614,
    "start": "03:04:20,480",
    "end": "03:04:23,820",
    "start_sec": 11060.48,
    "end_sec": 11063.82,
    "zh": "南城河大桥上分布着三个公交车站点",
    "vi": "Trên cầu sông Nam Thành có ba trạm xe buýt"
  },
  {
    "idx": 6615,
    "start": "03:04:23,820",
    "end": "03:04:25,360",
    "start_sec": 11063.82,
    "end_sec": 11065.36,
    "zh": "随到出口的桥头一处",
    "vi": "Một trạm ở đầu cầu ngay lối ra đường hầm"
  },
  {
    "idx": 6616,
    "start": "03:04:25,360",
    "end": "03:04:26,660",
    "start_sec": 11065.36,
    "end_sec": 11066.66,
    "zh": "大桥中间一处",
    "vi": "Một trạm ở giữa cầu"
  },
  {
    "idx": 6617,
    "start": "03:04:26,660",
    "end": "03:04:28,380",
    "start_sec": 11066.66,
    "end_sec": 11068.38,
    "zh": "以及大桥尽头一处",
    "vi": "Và một trạm ở cuối cầu"
  },
  {
    "idx": 6618,
    "start": "03:04:28,380",
    "end": "03:04:30,700",
    "start_sec": 11068.38,
    "end_sec": 11070.7,
    "zh": "诚子提踏了看出口处的公交站台",
    "vi": "Trần Tử Bì nhìn trạm xe buýt ở lối ra"
  },
  {
    "idx": 6619,
    "start": "03:04:30,700",
    "end": "03:04:32,160",
    "start_sec": 11070.7,
    "end_sec": 11072.16,
    "zh": "苏刚玻璃脑就不堪",
    "vi": "Tấm kính cường lực đã vỡ nát tiêu điều"
  },
  {
    "idx": 6620,
    "start": "03:04:32,160",
    "end": "03:04:34,260",
    "start_sec": 11072.16,
    "end_sec": 11074.26,
    "zh": "上面也直截了一个公交车上",
    "vi": "Trên đó chỉ ghi một trạm xe buýt"
  },
  {
    "idx": 6621,
    "start": "03:04:34,260",
    "end": "03:04:37,480",
    "start_sec": 11074.26,
    "end_sec": 11077.48,
    "zh": "难道就是在这里乘坐什么恶鬼巴士吗",
    "vi": "Chẳng lẽ phải đón chuyến xe buýt quỷ dữ nào đó ở đây sao."
  },
  {
    "idx": 6622,
    "start": "03:04:37,480",
    "end": "03:04:40,120",
    "start_sec": 11077.48,
    "end_sec": 11080.12,
    "zh": "虽说乘巴士是香茹提出来的意见",
    "vi": "Mặc dù đi xe buýt là ý kiến do Hương Như đưa ra"
  },
  {
    "idx": 6623,
    "start": "03:04:40,120",
    "end": "03:04:42,780",
    "start_sec": 11080.12,
    "end_sec": 11082.78,
    "zh": "但蓝河桥全程也才几千米长度",
    "vi": "Nhưng toàn bộ cầu sông Nam Thành cũng chỉ dài vài cây số"
  },
  {
    "idx": 6624,
    "start": "03:04:42,780",
    "end": "03:04:44,320",
    "start_sec": 11082.78,
    "end_sec": 11084.32,
    "zh": "顶多半个小时的小程",
    "vi": "Đi bộ cùng lắm mất nửa tiếng đồng hồ"
  },
  {
    "idx": 6625,
    "start": "03:04:44,320",
    "end": "03:04:46,420",
    "start_sec": 11084.32,
    "end_sec": 11086.42,
    "zh": "走",
    "vi": "Đi thôi"
  },
  {
    "idx": 6626,
    "start": "03:04:46,420",
    "end": "03:04:47,260",
    "start_sec": 11086.42,
    "end_sec": 11087.26,
    "zh": "小木屐",
    "vi": "Tiểu Mộc Kê"
  },
  {
    "idx": 6627,
    "start": "03:04:47,260",
    "end": "03:04:48,640",
    "start_sec": 11087.26,
    "end_sec": 11088.64,
    "zh": "咱们先走过去看看",
    "vi": "Chúng ta cứ đi qua đó xem thử trước đã"
  },
  {
    "idx": 6628,
    "start": "03:04:48,640",
    "end": "03:04:50,700",
    "start_sec": 11088.64,
    "end_sec": 11090.7,
    "zh": "今天是个阴雨天",
    "vi": "Hôm nay là một ngày âm u mưa gió"
  },
  {
    "idx": 6629,
    "start": "03:04:50,700",
    "end": "03:04:53,000",
    "start_sec": 11090.7,
    "end_sec": 11093.0,
    "zh": "浓厚的乌云阴沉得大于不然",
    "vi": "Những đám mây đen dày đặc âm u như sắp có mưa lớn"
  },
  {
    "idx": 6630,
    "start": "03:04:53,000",
    "end": "03:04:54,940",
    "start_sec": 11093.0,
    "end_sec": 11094.94,
    "zh": "桥两边的河水泛着涟漪",
    "vi": "Nước sông hai bên cầu đang gợn sóng"
  },
  {
    "idx": 6631,
    "start": "03:04:54,940",
    "end": "03:05:00,527",
    "start_sec": 11094.94,
    "end_sec": 11100.527,
    "zh": "四周死寂森然快步走到南河桥中间的站点时橙子皮搅晃一顿我讨原来是瞧他了怪不得香炉说要坐恶鬼巴士",
    "vi": "Xung quanh im lặng đến rợn người, tôi bước nhanh đến trạm giữa cầu Nam Hà thì Trần Tử Bì lắc lư,"
  },
  {
    "idx": 6631,
    "start": "03:05:00,527",
    "end": "03:05:05,606",
    "start_sec": 11100.527,
    "end_sec": 11105.606,
    "zh": "四周死寂森然快步走到南河桥中间的站点时橙子皮搅晃一顿我讨原来是瞧他了怪不得香炉说要坐恶鬼巴士",
    "vi": "tôi nhận ra mình đang nhìn anh ta, không trách sao Hương Lô nói phải đi xe buýt ma quỷ."
  },
  {
    "idx": 6632,
    "start": "03:05:05,606",
    "end": "03:05:07,526",
    "start_sec": 11105.606,
    "end_sec": 11107.526,
    "zh": "这南河深不见底",
    "vi": "Sông Nam Hà này sâu không đáy."
  },
  {
    "idx": 6633,
    "start": "03:05:07,526",
    "end": "03:05:09,526",
    "start_sec": 11107.526,
    "end_sec": 11109.526,
    "zh": "他现在地板又有十斤一块",
    "vi": "Bây giờ sàn nhà nặng mười cân một mét."
  },
  {
    "idx": 6634,
    "start": "03:05:09,526",
    "end": "03:05:11,186",
    "start_sec": 11109.526,
    "end_sec": 11111.186,
    "zh": "坐巴士能过去吗",
    "vi": "Đi xe buýt có qua được không."
  },
  {
    "idx": 6635,
    "start": "03:05:11,186",
    "end": "03:05:12,826",
    "start_sec": 11111.186,
    "end_sec": 11112.826,
    "zh": "林车是吧",
    "vi": "Xe buýt ma quỷ phải không."
  },
  {
    "idx": 6636,
    "start": "03:05:12,826",
    "end": "03:05:14,626",
    "start_sec": 11112.826,
    "end_sec": 11114.626,
    "zh": "敢情乘坐恶鬼巴士",
    "vi": "Hóa ra là đi xe buýt ma quỷ."
  },
  {
    "idx": 6637,
    "start": "03:05:14,626",
    "end": "03:05:16,046",
    "start_sec": 11114.626,
    "end_sec": 11116.046,
    "zh": "是要借助诡异的力量",
    "vi": "Muốn mượn sức mạnh kỳ dị."
  },
  {
    "idx": 6638,
    "start": "03:05:16,046",
    "end": "03:05:17,666",
    "start_sec": 11116.046,
    "end_sec": 11117.666,
    "zh": "渡过他现在大桥啊",
    "vi": "Để vượt qua cây cầu này sao."
  },
  {
    "idx": 6639,
    "start": "03:05:17,666",
    "end": "03:05:18,546",
    "start_sec": 11117.666,
    "end_sec": 11118.546,
    "zh": "人力不可为之",
    "vi": "Sức người không làm được."
  },
  {
    "idx": 6640,
    "start": "03:05:18,546",
    "end": "03:05:19,706",
    "start_sec": 11118.546,
    "end_sec": 11119.706,
    "zh": "皆由诡异承担",
    "vi": "Tất cả đều do kỳ dị gánh vác."
  },
  {
    "idx": 6641,
    "start": "03:05:19,706",
    "end": "03:05:20,806",
    "start_sec": 11119.706,
    "end_sec": 11120.806,
    "zh": "不愧是香炉",
    "vi": "Không hổ là Hương Lô."
  },
  {
    "idx": 6642,
    "start": "03:05:20,806",
    "end": "03:05:21,946",
    "start_sec": 11120.806,
    "end_sec": 11121.946,
    "zh": "想出来的路线",
    "vi": "Nghĩ ra được lộ trình."
  },
  {
    "idx": 6643,
    "start": "03:05:21,946",
    "end": "03:05:23,246",
    "start_sec": 11121.946,
    "end_sec": 11123.246,
    "zh": "全靠诡异开路",
    "vi": "Dựa vào kỳ dị để mở đường."
  },
  {
    "idx": 6644,
    "start": "03:05:23,246",
    "end": "03:05:27,886",
    "start_sec": 11123.246,
    "end_sec": 11127.886,
    "zh": "程子皮郁闷的走回南城河桥中的公交站点内坐下",
    "vi": "Trình Tử Bì buồn bã đi bộ trở lại trạm xe buýt giữa cầu Nam Hà rồi ngồi xuống."
  },
  {
    "idx": 6645,
    "start": "03:05:27,886",
    "end": "03:05:31,406",
    "start_sec": 11127.886,
    "end_sec": 11131.406,
    "zh": "南河桥卡线应该是和深山隧道一样",
    "vi": "Cầu Nam Hà bị lỗi có lẽ giống như đường hầm sâu trong núi."
  },
  {
    "idx": 6646,
    "start": "03:05:31,406",
    "end": "03:05:33,006",
    "start_sec": 11131.406,
    "end_sec": 11133.006,
    "zh": "因为劣质施工导致的吧",
    "vi": "Là do thi công kém chất lượng gây ra."
  },
  {
    "idx": 6647,
    "start": "03:05:33,006",
    "end": "03:05:34,726",
    "start_sec": 11133.006,
    "end_sec": 11134.726,
    "zh": "有那些独有企业的存在",
    "vi": "Có sự tồn tại của những doanh nghiệp đó."
  },
  {
    "idx": 6648,
    "start": "03:05:34,726",
    "end": "03:05:36,286",
    "start_sec": 11134.726,
    "end_sec": 11136.286,
    "zh": "这些意外都不是偶然",
    "vi": "Những tai nạn này không phải ngẫu nhiên."
  },
  {
    "idx": 6649,
    "start": "03:05:36,286",
    "end": "03:05:37,226",
    "start_sec": 11136.286,
    "end_sec": 11137.226,
    "zh": "而是必然",
    "vi": "Mà là tất yếu."
  },
  {
    "idx": 6650,
    "start": "03:05:37,226",
    "end": "03:05:40,526",
    "start_sec": 11137.226,
    "end_sec": 11140.526,
    "zh": "只可惜过去的我只是个平平无奇的上班族",
    "vi": "Chỉ tiếc là quá khứ tôi chỉ là một nhân viên văn phòng bình thường."
  },
  {
    "idx": 6651,
    "start": "03:05:40,526",
    "end": "03:05:43,586",
    "start_sec": 11140.526,
    "end_sec": 11143.586,
    "zh": "没那么大的能量去干预隧道和大桥的修筑",
    "vi": "Không có nhiều năng lực để can thiệp vào việc xây dựng đường hầm và cầu."
  },
  {
    "idx": 6652,
    "start": "03:05:43,586",
    "end": "03:05:45,526",
    "start_sec": 11143.586,
    "end_sec": 11145.526,
    "zh": "不然这些意外也不会发生了吧",
    "vi": "Nếu không những tai nạn này đã không xảy ra rồi."
  },
  {
    "idx": 6653,
    "start": "03:05:45,526",
    "end": "03:05:47,126",
    "start_sec": 11145.526,
    "end_sec": 11147.126,
    "zh": "坐在公交站台",
    "vi": "Ngồi ở trạm xe buýt."
  },
  {
    "idx": 6654,
    "start": "03:05:47,126",
    "end": "03:05:49,246",
    "start_sec": 11147.126,
    "end_sec": 11149.246,
    "zh": "程子皮无聊的刷着手机",
    "vi": "Trình Tử Bì nhàm chán lướt điện thoại."
  },
  {
    "idx": 6655,
    "start": "03:05:49,246",
    "end": "03:05:52,326",
    "start_sec": 11149.246,
    "end_sec": 11152.326,
    "zh": "直到手机上的时间来到9点30分",
    "vi": "Cho đến khi điện thoại hiển thị 9 giờ 30 phút."
  },
  {
    "idx": 6656,
    "start": "03:05:53,246",
    "end": "03:05:54,886",
    "start_sec": 11153.246,
    "end_sec": 11154.886,
    "zh": "南河桥桥头方向",
    "vi": "Hướng đầu cầu Nam Hà."
  },
  {
    "idx": 6657,
    "start": "03:05:54,886",
    "end": "03:05:56,246",
    "start_sec": 11154.886,
    "end_sec": 11156.246,
    "zh": "一辆四路公交车",
    "vi": "Một chiếc xe buýt số 4."
  },
  {
    "idx": 6658,
    "start": "03:05:56,246",
    "end": "03:05:57,146",
    "start_sec": 11156.246,
    "end_sec": 11157.146,
    "zh": "万用银子",
    "vi": "Xe buýt ma quỷ."
  },
  {
    "idx": 6659,
    "start": "03:05:57,146",
    "end": "03:05:59,486",
    "start_sec": 11157.146,
    "end_sec": 11159.486,
    "zh": "我操",
    "vi": "Đệt."
  },
  {
    "idx": 6660,
    "start": "03:05:59,486",
    "end": "03:06:00,966",
    "start_sec": 11159.486,
    "end_sec": 11160.966,
    "zh": "还真的有公交车来",
    "vi": "Thật sự có xe buýt đến."
  },
  {
    "idx": 6661,
    "start": "03:06:00,966",
    "end": "03:06:02,886",
    "start_sec": 11160.966,
    "end_sec": 11162.886,
    "zh": "这车子怎么跟新的一样",
    "vi": "Sao chiếc xe này trông như mới vậy."
  },
  {
    "idx": 6662,
    "start": "03:06:02,886",
    "end": "03:06:07,046",
    "start_sec": 11162.886,
    "end_sec": 11167.046,
    "zh": "小车",
    "vi": "Tiểu Mạc."
  },
  {
    "idx": 6663,
    "start": "03:06:07,046",
    "end": "03:06:08,686",
    "start_sec": 11167.046,
    "end_sec": 11168.686,
    "zh": "长者提没说话",
    "vi": "Trưởng giả không nói gì cả."
  },
  {
    "idx": 6664,
    "start": "03:06:08,686",
    "end": "03:06:09,546",
    "start_sec": 11168.686,
    "end_sec": 11169.546,
    "zh": "犹豫天后",
    "vi": "Sau khi do dự."
  },
  {
    "idx": 6665,
    "start": "03:06:09,546",
    "end": "03:06:11,826",
    "start_sec": 11169.546,
    "end_sec": 11171.826,
    "zh": "抱着小莫系上了车",
    "vi": "Ông bế Tiểu Mạc bước lên xe."
  },
  {
    "idx": 6666,
    "start": "03:06:11,826",
    "end": "03:06:15,606",
    "start_sec": 11171.826,
    "end_sec": 11175.606,
    "zh": "乘车请自觉投币",
    "vi": "Lên xe vui lòng tự giác bỏ tiền xu."
  },
  {
    "idx": 6667,
    "start": "03:06:15,606",
    "end": "03:06:16,906",
    "start_sec": 11175.606,
    "end_sec": 11176.906,
    "zh": "前上后下",
    "vi": "Lên cửa trước xuống cửa sau."
  },
  {
    "idx": 6668,
    "start": "03:06:16,906",
    "end": "03:06:17,986",
    "start_sec": 11176.906,
    "end_sec": 11177.986,
    "zh": "先老爱幼",
    "vi": "Kính lão đắc thọ."
  },
  {
    "idx": 6669,
    "start": "03:06:17,986",
    "end": "03:06:19,546",
    "start_sec": 11177.986,
    "end_sec": 11179.546,
    "zh": "闻名你我",
    "vi": "Văn minh lịch sự."
  },
  {
    "idx": 6670,
    "start": "03:06:19,546",
    "end": "03:06:20,566",
    "start_sec": 11179.546,
    "end_sec": 11180.566,
    "zh": "我操",
    "vi": "Chết tiệt."
  },
  {
    "idx": 6671,
    "start": "03:06:20,566",
    "end": "03:06:21,846",
    "start_sec": 11180.566,
    "end_sec": 11181.846,
    "zh": "多莫日子还要投币",
    "vi": "Xe ma mà cũng cần bỏ tiền xu sao."
  },
  {
    "idx": 6672,
    "start": "03:06:21,846",
    "end": "03:06:23,966",
    "start_sec": 11181.846,
    "end_sec": 11183.966,
    "zh": "还好多里有穿进去的习惯",
    "vi": "Cũng may là tôi có thói quen mang theo tiền."
  },
  {
    "idx": 6673,
    "start": "03:06:23,966",
    "end": "03:06:26,366",
    "start_sec": 11183.966,
    "end_sec": 11186.366,
    "zh": "小伙子",
    "vi": "Này chàng trai."
  },
  {
    "idx": 6674,
    "start": "03:06:26,366",
    "end": "03:06:28,126",
    "start_sec": 11186.366,
    "end_sec": 11188.126,
    "zh": "你哪有谁逃避啊",
    "vi": "Sao cậu lại trốn vé thế."
  },
  {
    "idx": 6675,
    "start": "03:06:28,126",
    "end": "03:06:29,726",
    "start_sec": 11188.126,
    "end_sec": 11189.726,
    "zh": "坏了",
    "vi": "Hỏng rồi."
  },
  {
    "idx": 6676,
    "start": "03:06:29,726",
    "end": "03:06:31,326",
    "start_sec": 11189.726,
    "end_sec": 11191.326,
    "zh": "普通硬币果然不行",
    "vi": "Tiền xu bình thường quả nhiên không dùng được."
  },
  {
    "idx": 6677,
    "start": "03:06:31,326",
    "end": "03:06:33,066",
    "start_sec": 11191.326,
    "end_sec": 11193.066,
    "zh": "毕竟这是辆鬼车呀",
    "vi": "Dù sao đây cũng là xe buýt ma mà."
  },
  {
    "idx": 6678,
    "start": "03:06:33,066",
    "end": "03:06:34,446",
    "start_sec": 11193.066,
    "end_sec": 11194.446,
    "zh": "乌泱泱的公交车里",
    "vi": "Trong chiếc xe buýt đông đúc."
  },
  {
    "idx": 6679,
    "start": "03:06:34,446",
    "end": "03:06:36,326",
    "start_sec": 11194.446,
    "end_sec": 11196.326,
    "zh": "比一个目光纷纷看来",
    "vi": "Từng ánh mắt đổ dồn về phía này."
  },
  {
    "idx": 6680,
    "start": "03:06:36,326",
    "end": "03:06:39,546",
    "start_sec": 11196.326,
    "end_sec": 11199.546,
    "zh": "像你这样的人",
    "vi": "Những kẻ như cậu."
  },
  {
    "idx": 6681,
    "start": "03:06:39,546",
    "end": "03:06:40,506",
    "start_sec": 11199.546,
    "end_sec": 11200.506,
    "zh": "我见多了",
    "vi": "Tôi thấy nhiều rồi."
  },
  {
    "idx": 6682,
    "start": "03:06:40,506",
    "end": "03:06:41,906",
    "start_sec": 11200.506,
    "end_sec": 11201.906,
    "zh": "没素质的家伙",
    "vi": "Đồ không có ý thức."
  },
  {
    "idx": 6683,
    "start": "03:06:41,906",
    "end": "03:06:42,466",
    "start_sec": 11201.906,
    "end_sec": 11202.466,
    "zh": "是啊",
    "vi": "Đúng vậy."
  },
  {
    "idx": 6684,
    "start": "03:06:42,466",
    "end": "03:06:43,426",
    "start_sec": 11202.466,
    "end_sec": 11203.426,
    "zh": "小伙子",
    "vi": "Chàng trai à."
  },
  {
    "idx": 6685,
    "start": "03:06:43,426",
    "end": "03:06:45,666",
    "start_sec": 11203.426,
    "end_sec": 11205.666,
    "zh": "几块钱你都逃单啊",
    "vi": "Chỉ vài đồng bạc mà cậu cũng trốn vé sao."
  },
  {
    "idx": 6686,
    "start": "03:06:45,666",
    "end": "03:06:46,666",
    "start_sec": 11205.666,
    "end_sec": 11206.666,
    "zh": "你鬼车图什么",
    "vi": "Xe ma thì cần cái gì chứ."
  },
  {
    "idx": 6687,
    "start": "03:06:46,666",
    "end": "03:06:47,586",
    "start_sec": 11206.666,
    "end_sec": 11207.586,
    "zh": "明币吗",
    "vi": "Tiền âm phủ à."
  },
  {
    "idx": 6688,
    "start": "03:06:47,586",
    "end": "03:06:48,246",
    "start_sec": 11207.586,
    "end_sec": 11208.246,
    "zh": "鬼知道",
    "vi": "Quỷ mới biết được."
  },
  {
    "idx": 6689,
    "start": "03:06:48,246",
    "end": "03:06:50,706",
    "start_sec": 11208.246,
    "end_sec": 11210.706,
    "zh": "恶鬼巴士说的是什么钱币啊",
    "vi": "Xe buýt ma này rốt cuộc dùng loại tiền nào."
  },
  {
    "idx": 6690,
    "start": "03:06:50,706",
    "end": "03:06:52,166",
    "start_sec": 11210.706,
    "end_sec": 11212.166,
    "zh": "打亮着车内所有人",
    "vi": "Tôi quan sát tất cả mọi người trên xe."
  },
  {
    "idx": 6691,
    "start": "03:06:52,166",
    "end": "03:06:53,646",
    "start_sec": 11212.166,
    "end_sec": 11213.646,
    "zh": "橙子皮眼角突然一亮",
    "vi": "Mắt Trần Tử Bì bỗng sáng lên."
  },
  {
    "idx": 6692,
    "start": "03:06:53,646",
    "end": "03:06:54,806",
    "start_sec": 11213.646,
    "end_sec": 11214.806,
    "zh": "徐东来",
    "vi": "Từ Đông Lai."
  },
  {
    "idx": 6693,
    "start": "03:06:54,806",
    "end": "03:06:55,846",
    "start_sec": 11214.806,
    "end_sec": 11215.846,
    "zh": "橙子皮",
    "vi": "Trần Tử Bì."
  },
  {
    "idx": 6694,
    "start": "03:06:55,846",
    "end": "03:06:56,866",
    "start_sec": 11215.846,
    "end_sec": 11216.866,
    "zh": "想不到吧",
    "vi": "Không ngờ tới đúng không."
  },
  {
    "idx": 6695,
    "start": "03:06:56,866",
    "end": "03:06:57,566",
    "start_sec": 11216.866,
    "end_sec": 11217.566,
    "zh": "坐鬼车",
    "vi": "Đi xe ma."
  },
  {
    "idx": 6696,
    "start": "03:06:57,566",
    "end": "03:06:58,686",
    "start_sec": 11217.566,
    "end_sec": 11218.686,
    "zh": "你能得什么呢",
    "vi": "Ngươi có thể được gì chứ."
  },
  {
    "idx": 6697,
    "start": "03:06:58,686",
    "end": "03:07:00,726",
    "start_sec": 11218.686,
    "end_sec": 11220.726,
    "zh": "你怎么还没死呢",
    "vi": "Sao ngươi vẫn chưa chết thế."
  },
  {
    "idx": 6698,
    "start": "03:07:00,726",
    "end": "03:07:01,066",
    "start_sec": 11220.726,
    "end_sec": 11221.066,
    "zh": "你说",
    "vi": "Nói đi."
  },
  {
    "idx": 6699,
    "start": "03:07:01,066",
    "end": "03:07:02,026",
    "start_sec": 11221.066,
    "end_sec": 11222.026,
    "zh": "我没点依仗",
    "vi": "Nếu ta không có chỗ dựa."
  },
  {
    "idx": 6700,
    "start": "03:07:02,026",
    "end": "03:07:03,966",
    "start_sec": 11222.026,
    "end_sec": 11223.966,
    "zh": "我爸能放心我在这浪呢",
    "vi": "Bố ta có thể yên tâm để ta quậy phá ở đây sao."
  },
  {
    "idx": 6701,
    "start": "03:07:03,966",
    "end": "03:07:04,366",
    "start_sec": 11223.966,
    "end_sec": 11224.366,
    "zh": "依仗",
    "vi": "Chỗ dựa sao."
  },
  {
    "idx": 6702,
    "start": "03:07:04,366",
    "end": "03:07:05,866",
    "start_sec": 11224.366,
    "end_sec": 11225.866,
    "zh": "莫非时光来身上",
    "vi": "Chẳng lẽ trên người Từ Đông Lai."
  },
  {
    "idx": 6703,
    "start": "03:07:05,866",
    "end": "03:07:07,166",
    "start_sec": 11225.866,
    "end_sec": 11227.166,
    "zh": "有什么法器之类的",
    "vi": "Có pháp khí gì đó sao."
  },
  {
    "idx": 6704,
    "start": "03:07:07,166",
    "end": "03:07:08,126",
    "start_sec": 11227.166,
    "end_sec": 11228.126,
    "zh": "什么法器",
    "vi": "Pháp khí gì chứ."
  },
  {
    "idx": 6705,
    "start": "03:07:08,126",
    "end": "03:07:09,506",
    "start_sec": 11228.126,
    "end_sec": 11229.506,
    "zh": "能让死了的人复活",
    "vi": "Mà có thể làm người chết sống lại."
  },
  {
    "idx": 6706,
    "start": "03:07:09,506",
    "end": "03:07:10,986",
    "start_sec": 11229.506,
    "end_sec": 11230.986,
    "zh": "没助智的东西",
    "vi": "Đồ ngu xuẩn."
  },
  {
    "idx": 6707,
    "start": "03:07:10,986",
    "end": "03:07:12,086",
    "start_sec": 11230.986,
    "end_sec": 11232.086,
    "zh": "没教养的家伙",
    "vi": "Kẻ vô giáo dục."
  },
  {
    "idx": 6708,
    "start": "03:07:12,086",
    "end": "03:07:12,786",
    "start_sec": 11232.086,
    "end_sec": 11232.786,
    "zh": "下车",
    "vi": "Xuống xe."
  },
  {
    "idx": 6709,
    "start": "03:07:12,786",
    "end": "03:07:13,466",
    "start_sec": 11232.786,
    "end_sec": 11233.466,
    "zh": "下车",
    "vi": "Xuống xe."
  },
  {
    "idx": 6710,
    "start": "03:07:13,466",
    "end": "03:07:14,366",
    "start_sec": 11233.466,
    "end_sec": 11234.366,
    "zh": "此时",
    "vi": "Lúc này."
  },
  {
    "idx": 6711,
    "start": "03:07:14,366",
    "end": "03:07:16,106",
    "start_sec": 11234.366,
    "end_sec": 11236.106,
    "zh": "橙子皮也顾不上徐东来",
    "vi": "Trần Tử Bì cũng không thèm quan tâm đến Từ Đông Lai."
  },
  {
    "idx": 6712,
    "start": "03:07:16,106",
    "end": "03:07:17,526",
    "start_sec": 11236.106,
    "end_sec": 11237.526,
    "zh": "从车里的敞口",
    "vi": "Từ khoảng hở trong xe."
  },
  {
    "idx": 6713,
    "start": "03:07:17,526",
    "end": "03:07:18,226",
    "start_sec": 11237.526,
    "end_sec": 11238.226,
    "zh": "正在",
    "vi": "Đang."
  },
  {
    "idx": 6714,
    "start": "03:07:18,226",
    "end": "03:07:19,786",
    "start_sec": 11238.226,
    "end_sec": 11239.786,
    "zh": "都在向橙子皮",
    "vi": "Đều đang hướng về phía Trần Tử Bì."
  },
  {
    "idx": 6715,
    "start": "03:07:19,786",
    "end": "03:07:21,106",
    "start_sec": 11239.786,
    "end_sec": 11241.106,
    "zh": "我等啊",
    "vi": "Ta đợi đây."
  },
  {
    "idx": 6716,
    "start": "03:07:21,106",
    "end": "03:07:22,306",
    "start_sec": 11241.106,
    "end_sec": 11242.306,
    "zh": "此状不让啊",
    "vi": "Tình hình này không thể nhượng bộ."
  },
  {
    "idx": 6717,
    "start": "03:07:22,306",
    "end": "03:07:23,146",
    "start_sec": 11242.306,
    "end_sec": 11243.146,
    "zh": "这辆车的诡异",
    "vi": "Sự kỳ quái của chiếc xe này."
  },
  {
    "idx": 6718,
    "start": "03:07:23,146",
    "end": "03:07:24,906",
    "start_sec": 11243.146,
    "end_sec": 11244.906,
    "zh": "就算使用鬼面窗能解决",
    "vi": "Dù có dùng Cửa Sổ Mặt Quỷ để giải quyết."
  },
  {
    "idx": 6719,
    "start": "03:07:24,906",
    "end": "03:07:26,746",
    "start_sec": 11244.906,
    "end_sec": 11246.746,
    "zh": "到时候鬼面窗也不俗",
    "vi": "Thì lúc đó Cửa Sổ Mặt Quỷ cũng sẽ chịu thiệt hại."
  },
  {
    "idx": 6720,
    "start": "03:07:26,746",
    "end": "03:07:27,586",
    "start_sec": 11246.746,
    "end_sec": 11247.586,
    "zh": "我真是",
    "vi": "Ta thật là."
  },
  {
    "idx": 6721,
    "start": "03:07:27,586",
    "end": "03:07:28,406",
    "start_sec": 11247.586,
    "end_sec": 11248.406,
    "zh": "想着",
    "vi": "Nghĩ"
  },
  {
    "idx": 6722,
    "start": "03:07:28,406",
    "end": "03:07:30,506",
    "start_sec": 11248.406,
    "end_sec": 11250.506,
    "zh": "橙子皮立即给过去的自己",
    "vi": "Trần Tử Bì lập tức gửi cho bản thân lúc trước"
  },
  {
    "idx": 6723,
    "start": "03:07:30,506",
    "end": "03:07:31,426",
    "start_sec": 11250.506,
    "end_sec": 11251.426,
    "zh": "发了条小姐",
    "vi": "một tin nhắn"
  },
  {
    "idx": 6724,
    "start": "03:07:31,426",
    "end": "03:07:32,866",
    "start_sec": 11251.426,
    "end_sec": 11252.866,
    "zh": "如果你看到这条消息",
    "vi": "Nếu bạn thấy tin nhắn này"
  },
  {
    "idx": 6725,
    "start": "03:07:32,866",
    "end": "03:07:34,306",
    "start_sec": 11252.866,
    "end_sec": 11254.306,
    "zh": "说明我已经死了",
    "vi": "thì có nghĩa là tôi đã chết"
  },
  {
    "idx": 6726,
    "start": "03:07:34,306",
    "end": "03:07:35,186",
    "start_sec": 11254.306,
    "end_sec": 11255.186,
    "zh": "请切记",
    "vi": "Hãy nhớ kỹ"
  },
  {
    "idx": 6727,
    "start": "03:07:35,186",
    "end": "03:07:36,766",
    "start_sec": 11255.186,
    "end_sec": 11256.766,
    "zh": "在通过深山资料前",
    "vi": "trước khi xem tài liệu núi sâu"
  },
  {
    "idx": 6728,
    "start": "03:07:36,766",
    "end": "03:07:38,066",
    "start_sec": 11256.766,
    "end_sec": 11258.066,
    "zh": "严查徐东来身上",
    "vi": "hãy kiểm tra kỹ xem Từ Đông Lai"
  },
  {
    "idx": 6729,
    "start": "03:07:38,066",
    "end": "03:07:39,926",
    "start_sec": 11258.066,
    "end_sec": 11259.926,
    "zh": "是否藏有法器一类的东西",
    "vi": "có giấu pháp khí gì không"
  },
  {
    "idx": 6730,
    "start": "03:07:39,926",
    "end": "03:07:41,146",
    "start_sec": 11259.926,
    "end_sec": 11261.146,
    "zh": "自入公交车上",
    "vi": "Từ khi lên xe buýt"
  },
  {
    "idx": 6731,
    "start": "03:07:41,146",
    "end": "03:07:42,526",
    "start_sec": 11261.146,
    "end_sec": 11262.526,
    "zh": "可能存在一定规则",
    "vi": "có thể có một số quy tắc nhất định"
  },
  {
    "idx": 6732,
    "start": "03:07:42,526",
    "end": "03:07:44,386",
    "start_sec": 11262.526,
    "end_sec": 11264.386,
    "zh": "请小心觉的后再上车",
    "vi": "Hãy cẩn thận trước khi lên xe"
  },
  {
    "idx": 6733,
    "start": "03:07:44,386",
    "end": "03:07:45,126",
    "start_sec": 11264.386,
    "end_sec": 11265.126,
    "zh": "说着",
    "vi": "Nói rồi"
  },
  {
    "idx": 6734,
    "start": "03:07:45,126",
    "end": "03:07:47,486",
    "start_sec": 11265.126,
    "end_sec": 11267.486,
    "zh": "两个大爷已经来到橙子皮身边",
    "vi": "hai ông chú đã đến bên Trần Tử Bì"
  },
  {
    "idx": 6735,
    "start": "03:07:47,486",
    "end": "03:07:49,566",
    "start_sec": 11267.486,
    "end_sec": 11269.566,
    "zh": "小莫姐拦的橙子皮生前",
    "vi": "Chị Tiểu Mạc ngăn lại Trần Tử Bì lúc còn sống"
  },
  {
    "idx": 6736,
    "start": "03:07:49,566",
    "end": "03:07:50,766",
    "start_sec": 11269.566,
    "end_sec": 11270.766,
    "zh": "凶狠的吼叫",
    "vi": "hét lên hung dữ"
  },
  {
    "idx": 6737,
    "start": "03:07:50,766",
    "end": "03:07:52,806",
    "start_sec": 11270.766,
    "end_sec": 11272.806,
    "zh": "带狗上车",
    "vi": "Mang chó lên xe"
  },
  {
    "idx": 6738,
    "start": "03:07:52,806",
    "end": "03:07:53,726",
    "start_sec": 11272.806,
    "end_sec": 11273.726,
    "zh": "你也管不住它",
    "vi": "bạn cũng không quản được nó"
  },
  {
    "idx": 6739,
    "start": "03:07:53,726",
    "end": "03:07:54,826",
    "start_sec": 11273.726,
    "end_sec": 11274.826,
    "zh": "你这种烂人",
    "vi": "Loại người tồi tệ như bạn"
  },
  {
    "idx": 6740,
    "start": "03:07:54,826",
    "end": "03:07:56,126",
    "start_sec": 11274.826,
    "end_sec": 11276.126,
    "zh": "就不配养狗",
    "vi": "không xứng nuôi chó"
  },
  {
    "idx": 6741,
    "start": "03:07:56,126",
    "end": "03:08:00,726",
    "start_sec": 11276.126,
    "end_sec": 11280.726,
    "zh": "悬崖咬穿了它的大腿",
    "vi": "Vách đá cắn thủng đùi nó"
  },
  {
    "idx": 6742,
    "start": "03:08:00,726",
    "end": "03:08:02,546",
    "start_sec": 11280.726,
    "end_sec": 11282.546,
    "zh": "它喷溅出来的不是鲜血",
    "vi": "thứ phun ra không phải máu tươi"
  },
  {
    "idx": 6743,
    "start": "03:08:02,546",
    "end": "03:08:04,026",
    "start_sec": 11282.546,
    "end_sec": 11284.026,
    "zh": "而是哗啦啦的流水",
    "vi": "mà là nước chảy ào ào"
  },
  {
    "idx": 6744,
    "start": "03:08:04,026",
    "end": "03:08:04,746",
    "start_sec": 11284.026,
    "end_sec": 11284.746,
    "zh": "走东西",
    "vi": "Đi thôi"
  },
  {
    "idx": 6745,
    "start": "03:08:04,746",
    "end": "03:08:05,766",
    "start_sec": 11284.746,
    "end_sec": 11285.766,
    "zh": "你还咬人",
    "vi": "Bạn còn cắn người"
  },
  {
    "idx": 6746,
    "start": "03:08:05,766",
    "end": "03:08:12,686",
    "start_sec": 11285.766,
    "end_sec": 11292.686,
    "zh": "鬼运窗",
    "vi": "Xe ma quỷ"
  },
  {
    "idx": 6747,
    "start": "03:08:12,686",
    "end": "03:08:14,526",
    "start_sec": 11292.686,
    "end_sec": 11294.526,
    "zh": "小的",
    "vi": "Nhỏ bé"
  },
  {
    "idx": 6748,
    "start": "03:08:14,526",
    "end": "03:08:16,326",
    "start_sec": 11294.526,
    "end_sec": 11296.326,
    "zh": "这一次你是跑不掉的",
    "vi": "Lần này bạn không chạy thoát được đâu"
  },
  {
    "idx": 6749,
    "start": "03:08:16,326",
    "end": "03:08:17,886",
    "start_sec": 11296.326,
    "end_sec": 11297.886,
    "zh": "我告诉你生路在哪里",
    "vi": "Tôi nói cho bạn biết đường sống ở đâu"
  },
  {
    "idx": 6750,
    "start": "03:08:17,886",
    "end": "03:08:19,026",
    "start_sec": 11297.886,
    "end_sec": 11299.026,
    "zh": "你让我来当主体",
    "vi": "Bạn để tôi làm chủ thể"
  },
  {
    "idx": 6751,
    "start": "03:08:19,026",
    "end": "03:08:21,626",
    "start_sec": 11299.026,
    "end_sec": 11301.626,
    "zh": "这一车的废物我全给你做了",
    "vi": "Tôi sẽ xử lý hết đám rác rưởi trên xe này cho bạn."
  },
  {
    "idx": 6752,
    "start": "03:08:21,626",
    "end": "03:08:26,146",
    "start_sec": 11301.626,
    "end_sec": 11306.146,
    "zh": "让我当主体怎么样",
    "vi": "Sao bạn không để tôi làm chủ thể nhỉ."
  },
  {
    "idx": 6753,
    "start": "03:08:26,146",
    "end": "03:08:27,866",
    "start_sec": 11306.146,
    "end_sec": 11307.866,
    "zh": "小伙子",
    "vi": "Cậu bé."
  },
  {
    "idx": 6754,
    "start": "03:08:27,866",
    "end": "03:08:29,926",
    "start_sec": 11307.866,
    "end_sec": 11309.926,
    "zh": "草单可是要负责的",
    "vi": "Người lập danh sách phải chịu trách nhiệm đấy."
  },
  {
    "idx": 6755,
    "start": "03:08:29,926",
    "end": "03:08:33,646",
    "start_sec": 11309.926,
    "end_sec": 11313.646,
    "zh": "你不是拿我喂鬼吗",
    "vi": "Chẳng phải bạn định dùng tôi để cho quỷ ăn sao."
  },
  {
    "idx": 6756,
    "start": "03:08:33,646",
    "end": "03:08:36,726",
    "start_sec": 11313.646,
    "end_sec": 11316.726,
    "zh": "马上你就能体会到被鬼吃的感觉了",
    "vi": "Chẳng mấy chốc bạn sẽ được trải nghiệm cảm giác bị quỷ ăn đâu."
  },
  {
    "idx": 6757,
    "start": "03:08:36,726",
    "end": "03:08:42,246",
    "start_sec": 11316.726,
    "end_sec": 11322.246,
    "zh": "看来这种情况只有再次一次了",
    "vi": "Xem ra tình huống này chỉ có thể làm lại một lần nữa thôi."
  },
  {
    "idx": 6758,
    "start": "03:08:42,246",
    "end": "03:08:43,666",
    "start_sec": 11322.246,
    "end_sec": 11323.666,
    "zh": "如果动了鬼面窗",
    "vi": "Nếu động vào mặt nạ quỷ."
  },
  {
    "idx": 6759,
    "start": "03:08:43,666",
    "end": "03:08:44,826",
    "start_sec": 11323.666,
    "end_sec": 11324.826,
    "zh": "虽然可以退皮",
    "vi": "Tuy có thể lột da."
  },
  {
    "idx": 6760,
    "start": "03:08:44,826",
    "end": "03:08:47,506",
    "start_sec": 11324.826,
    "end_sec": 11327.506,
    "zh": "但是自己一定会被鬼面窗逐速控制",
    "vi": "Nhưng bản thân chắc chắn sẽ bị mặt nạ quỷ kiểm soát."
  },
  {
    "idx": 6761,
    "start": "03:08:47,506",
    "end": "03:08:49,686",
    "start_sec": 11327.506,
    "end_sec": 11329.686,
    "zh": "那样已经没死命了",
    "vi": "Khi đó sẽ không còn mạng để sống nữa."
  },
  {
    "idx": 6762,
    "start": "03:08:49,686",
    "end": "03:08:50,806",
    "start_sec": 11329.686,
    "end_sec": 11330.806,
    "zh": "不守规矩的程康",
    "vi": "Thằng nhóc không tuân thủ quy tắc tên Trình Khang."
  },
  {
    "idx": 6763,
    "start": "03:08:50,806",
    "end": "03:08:52,406",
    "start_sec": 11330.806,
    "end_sec": 11332.406,
    "zh": "我亲自出发",
    "vi": "Tôi sẽ đích thân ra tay."
  },
  {
    "idx": 6764,
    "start": "03:08:52,406",
    "end": "03:09:05,406",
    "start_sec": 11332.406,
    "end_sec": 11345.406,
    "zh": "你的脑子好像很美味啊",
    "vi": "Bộ não của bạn trông thật ngon miệng."
  },
  {
    "idx": 6765,
    "start": "03:09:05,406",
    "end": "03:09:07,606",
    "start_sec": 11345.406,
    "end_sec": 11347.606,
    "zh": "正好我的脑子被冲乱了",
    "vi": "Vừa hay bộ não của tôi cũng đang bị rối loạn."
  },
  {
    "idx": 6766,
    "start": "03:09:07,606",
    "end": "03:09:08,926",
    "start_sec": 11347.606,
    "end_sec": 11348.926,
    "zh": "那你可不可以不怕",
    "vi": "Vậy bạn có thể không sợ được không."
  },
  {
    "idx": 6767,
    "start": "03:09:08,926",
    "end": "03:09:17,906",
    "start_sec": 11348.926,
    "end_sec": 11357.906,
    "zh": "真是操蛋的死法",
    "vi": "Thật là một cái chết tồi tệ."
  },
  {
    "idx": 6768,
    "start": "03:09:17,906",
    "end": "03:09:19,606",
    "start_sec": 11357.906,
    "end_sec": 11359.606,
    "zh": "僵尸没吃到我的脑子",
    "vi": "Xác sống không ăn được não tôi."
  },
  {
    "idx": 6769,
    "start": "03:09:19,606",
    "end": "03:09:21,006",
    "start_sec": 11359.606,
    "end_sec": 11361.006,
    "zh": "被司机吃了",
    "vi": "Lại bị tài xế ăn mất."
  },
  {
    "idx": 6770,
    "start": "03:09:21,006",
    "end": "03:09:23,066",
    "start_sec": 11361.006,
    "end_sec": 11363.066,
    "zh": "长者皮踏了远周围环境",
    "vi": "Lão già trượt chân ngã xung quanh."
  },
  {
    "idx": 6771,
    "start": "03:09:23,066",
    "end": "03:09:25,706",
    "start_sec": 11363.066,
    "end_sec": 11365.706,
    "zh": "发现自己已经睡到深山睡着",
    "vi": "Phát hiện mình đã ngủ quên giữa núi sâu."
  },
  {
    "idx": 6772,
    "start": "03:09:25,706",
    "end": "03:09:27,986",
    "start_sec": 11365.706,
    "end_sec": 11367.986,
    "zh": "启动来",
    "vi": "Khởi động đi."
  },
  {
    "idx": 6773,
    "start": "03:09:27,986",
    "end": "03:09:28,906",
    "start_sec": 11367.986,
    "end_sec": 11368.906,
    "zh": "我倒要看看",
    "vi": "Tôi muốn xem."
  },
  {
    "idx": 6774,
    "start": "03:09:28,906",
    "end": "03:09:30,726",
    "start_sec": 11368.906,
    "end_sec": 11370.726,
    "zh": "你身上到底藏了什么东西",
    "vi": "Bạn giấu thứ gì trong người vậy."
  },
  {
    "idx": 6775,
    "start": "03:09:30,726",
    "end": "03:09:33,086",
    "start_sec": 11370.726,
    "end_sec": 11373.086,
    "zh": "长者皮将他浑身都发了不便",
    "vi": "Lão già trượt chân ngã cảm thấy khó chịu khắp người."
  },
  {
    "idx": 6776,
    "start": "03:09:33,086",
    "end": "03:09:34,866",
    "start_sec": 11373.086,
    "end_sec": 11374.866,
    "zh": "最终在他裤子口袋里",
    "vi": "Cuối cùng trong túi quần của ông ta."
  },
  {
    "idx": 6777,
    "start": "03:09:34,866",
    "end": "03:09:37,026",
    "start_sec": 11374.866,
    "end_sec": 11377.026,
    "zh": "打到了三叠黄纸折起来的纸人",
    "vi": "Tìm thấy một con người giấy gấp từ ba tờ giấy vàng."
  },
  {
    "idx": 6778,
    "start": "03:09:37,026",
    "end": "03:09:39,246",
    "start_sec": 11377.026,
    "end_sec": 11379.246,
    "zh": "这是什么玩意",
    "vi": "Đây là cái quái gì vậy."
  },
  {
    "idx": 6779,
    "start": "03:09:39,246",
    "end": "03:09:40,646",
    "start_sec": 11379.246,
    "end_sec": 11380.646,
    "zh": "阴天指人",
    "vi": "Người giấy âm ty."
  },
  {
    "idx": 6780,
    "start": "03:09:40,646",
    "end": "03:09:42,546",
    "start_sec": 11380.646,
    "end_sec": 11382.546,
    "zh": "可以替死的小玩意",
    "vi": "Một vật nhỏ có thể thay thế cái chết."
  },
  {
    "idx": 6781,
    "start": "03:09:42,546",
    "end": "03:09:43,286",
    "start_sec": 11382.546,
    "end_sec": 11383.286,
    "zh": "是否献祭",
    "vi": "Có hiến tế không."
  },
  {
    "idx": 6782,
    "start": "03:09:43,286",
    "end": "03:09:45,246",
    "start_sec": 11383.286,
    "end_sec": 11385.246,
    "zh": "脑海中传来香炉的声音",
    "vi": "Tiếng của lư hương vang lên trong đầu."
  },
  {
    "idx": 6783,
    "start": "03:09:45,246",
    "end": "03:09:46,706",
    "start_sec": 11385.246,
    "end_sec": 11386.706,
    "zh": "橙子皮嘴角一撇",
    "vi": "Trần Tử Bì bĩu môi."
  },
  {
    "idx": 6784,
    "start": "03:09:46,706",
    "end": "03:09:47,886",
    "start_sec": 11386.706,
    "end_sec": 11387.886,
    "zh": "这也献祭",
    "vi": "Cái này cũng hiến tế."
  },
  {
    "idx": 6785,
    "start": "03:09:47,886",
    "end": "03:09:48,686",
    "start_sec": 11387.886,
    "end_sec": 11388.686,
    "zh": "那也献祭",
    "vi": "Cái kia cũng hiến tế."
  },
  {
    "idx": 6786,
    "start": "03:09:48,686",
    "end": "03:09:50,286",
    "start_sec": 11388.686,
    "end_sec": 11390.286,
    "zh": "你怎么不去抢啊",
    "vi": "Sao ngươi không đi cướp luôn đi."
  },
  {
    "idx": 6787,
    "start": "03:09:50,286",
    "end": "03:09:51,186",
    "start_sec": 11390.286,
    "end_sec": 11391.186,
    "zh": "献祭此物",
    "vi": "Hiến tế vật này."
  },
  {
    "idx": 6788,
    "start": "03:09:51,186",
    "end": "03:09:52,826",
    "start_sec": 11391.186,
    "end_sec": 11392.826,
    "zh": "可以得到三道鬼纹",
    "vi": "Có thể nhận được ba đạo quỷ văn."
  },
  {
    "idx": 6789,
    "start": "03:09:52,826",
    "end": "03:09:54,846",
    "start_sec": 11392.826,
    "end_sec": 11394.846,
    "zh": "鬼纹可以压制鬼面窗",
    "vi": "Quỷ văn có thể áp chế quỷ diện sang."
  },
  {
    "idx": 6790,
    "start": "03:09:54,846",
    "end": "03:09:58,156",
    "start_sec": 11394.846,
    "end_sec": 11398.156,
    "zh": "献祭我要献祭请摆放贡品将三张指人放进香炉内一道黑烟自炉中升成而起随后橙子皮脖梗上的鬼面窗附近多了三道黑烟",
    "vi": "Hiến tế ta muốn hiến tế hãy đặt vật phẩm cúng vào trong lư"
  },
  {
    "idx": 6790,
    "start": "03:09:58,156",
    "end": "03:10:01,465",
    "start_sec": 11398.156,
    "end_sec": 11401.465,
    "zh": "献祭我要献祭请摆放贡品将三张指人放进香炉内一道黑烟自炉中升成而起随后橙子皮脖梗上的鬼面窗附近多了三道黑烟",
    "vi": "hương ba tờ giấy hình người được đặt vào trong lư hương một làn"
  },
  {
    "idx": 6790,
    "start": "03:10:01,465",
    "end": "03:10:04,539",
    "start_sec": 11401.465,
    "end_sec": 11404.539,
    "zh": "献祭我要献祭请摆放贡品将三张指人放进香炉内一道黑烟自炉中升成而起随后橙子皮脖梗上的鬼面窗附近多了三道黑烟",
    "vi": "khói đen từ trong lư bốc lên sau đó gần chỗ quỷ diện"
  },
  {
    "idx": 6790,
    "start": "03:10:04,539",
    "end": "03:10:07,612",
    "start_sec": 11404.539,
    "end_sec": 11407.612,
    "zh": "献祭我要献祭请摆放贡品将三张指人放进香炉内一道黑烟自炉中升成而起随后橙子皮脖梗上的鬼面窗附近多了三道黑烟",
    "vi": "sang trên cổ Trần Tử Bì xuất hiện thêm ba đạo khói đen."
  },
  {
    "idx": 6791,
    "start": "03:10:07,612",
    "end": "03:10:09,192",
    "start_sec": 11407.612,
    "end_sec": 11409.192,
    "zh": "这就是鬼闻啊",
    "vi": "Đây chính là quỷ văn sao."
  },
  {
    "idx": 6792,
    "start": "03:10:09,192",
    "end": "03:10:10,332",
    "start_sec": 11409.192,
    "end_sec": 11410.332,
    "zh": "徐东来",
    "vi": "Từ Đông Lai."
  },
  {
    "idx": 6793,
    "start": "03:10:10,332",
    "end": "03:10:11,692",
    "start_sec": 11410.332,
    "end_sec": 11411.692,
    "zh": "这次总死透了吧",
    "vi": "Lần này chắc chắn chết hẳn rồi chứ."
  },
  {
    "idx": 6794,
    "start": "03:10:11,692",
    "end": "03:10:14,212",
    "start_sec": 11411.692,
    "end_sec": 11414.212,
    "zh": "默默走出深山隧道",
    "vi": "Lặng lẽ bước ra khỏi đường hầm sâu trong núi."
  },
  {
    "idx": 6795,
    "start": "03:10:14,212",
    "end": "03:10:15,832",
    "start_sec": 11414.212,
    "end_sec": 11415.832,
    "zh": "橙子皮没再往前走",
    "vi": "Trần Tử Bì không đi tiếp nữa."
  },
  {
    "idx": 6796,
    "start": "03:10:15,832",
    "end": "03:10:17,112",
    "start_sec": 11415.832,
    "end_sec": 11417.112,
    "zh": "而是坐在桥头站",
    "vi": "Mà ngồi xuống trạm đầu cầu."
  },
  {
    "idx": 6797,
    "start": "03:10:17,112",
    "end": "03:10:18,972",
    "start_sec": 11417.112,
    "end_sec": 11418.972,
    "zh": "橙子皮掏出手机",
    "vi": "Trần Tử Bì lấy điện thoại ra."
  },
  {
    "idx": 6798,
    "start": "03:10:18,972",
    "end": "03:10:22,412",
    "start_sec": 11418.972,
    "end_sec": 11422.412,
    "zh": "他想到一个给恶鬼发掷正确乘车费的办法",
    "vi": "Cậu nghĩ ra một cách để trả tiền xe cho ác quỷ."
  },
  {
    "idx": 6799,
    "start": "03:10:22,412",
    "end": "03:10:23,092",
    "start_sec": 11422.412,
    "end_sec": 11423.092,
    "zh": "在吗",
    "vi": "Có đó không."
  },
  {
    "idx": 6800,
    "start": "03:10:23,092",
    "end": "03:10:24,932",
    "start_sec": 11423.092,
    "end_sec": 11424.932,
    "zh": "有点事需要你帮忙",
    "vi": "Có chút việc cần ngươi giúp."
  },
  {
    "idx": 6801,
    "start": "03:10:24,932",
    "end": "03:10:26,152",
    "start_sec": 11424.932,
    "end_sec": 11426.152,
    "zh": "怎么了",
    "vi": "Có chuyện gì vậy."
  },
  {
    "idx": 6802,
    "start": "03:10:26,152",
    "end": "03:10:27,672",
    "start_sec": 11426.152,
    "end_sec": 11427.672,
    "zh": "我需要你去坐",
    "vi": "Ta cần ngươi đi lên."
  },
  {
    "idx": 6803,
    "start": "03:10:27,672",
    "end": "03:10:29,632",
    "start_sec": 11427.672,
    "end_sec": 11429.632,
    "zh": "城间第一辆四路公交车",
    "vi": "Chuyến xe buýt số bốn đầu tiên trong thành phố."
  },
  {
    "idx": 6804,
    "start": "03:10:29,632",
    "end": "03:10:30,232",
    "start_sec": 11429.632,
    "end_sec": 11430.232,
    "zh": "上车后",
    "vi": "Sau khi lên xe."
  },
  {
    "idx": 6805,
    "start": "03:10:30,232",
    "end": "03:10:31,252",
    "start_sec": 11430.232,
    "end_sec": 11431.252,
    "zh": "你将几枚硬币",
    "vi": "Ngươi hãy giấu vài đồng xu."
  },
  {
    "idx": 6806,
    "start": "03:10:31,252",
    "end": "03:10:33,012",
    "start_sec": 11431.252,
    "end_sec": 11433.012,
    "zh": "藏在车前排的第一个座位下",
    "vi": "Dưới ghế ngồi đầu tiên ở hàng ghế trước."
  },
  {
    "idx": 6807,
    "start": "03:10:33,012",
    "end": "03:10:34,812",
    "start_sec": 11433.012,
    "end_sec": 11434.812,
    "zh": "然后马上下车",
    "vi": "Rồi lập tức xuống xe ngay."
  },
  {
    "idx": 6808,
    "start": "03:10:34,812",
    "end": "03:10:35,292",
    "start_sec": 11434.812,
    "end_sec": 11435.292,
    "zh": "我藏",
    "vi": "Ta giấu."
  },
  {
    "idx": 6809,
    "start": "03:10:35,292",
    "end": "03:10:36,172",
    "start_sec": 11435.292,
    "end_sec": 11436.172,
    "zh": "藏硬币",
    "vi": "Giấu đồng xu."
  },
  {
    "idx": 6810,
    "start": "03:10:36,172",
    "end": "03:10:38,112",
    "start_sec": 11436.172,
    "end_sec": 11438.112,
    "zh": "莫非你还能找到接着吗",
    "vi": "Chẳng lẽ ngươi còn tìm được tiếp sao."
  },
  {
    "idx": 6811,
    "start": "03:10:38,112",
    "end": "03:10:39,432",
    "start_sec": 11438.112,
    "end_sec": 11439.432,
    "zh": "没错",
    "vi": "Đúng vậy"
  },
  {
    "idx": 6812,
    "start": "03:10:39,432",
    "end": "03:10:40,512",
    "start_sec": 11439.432,
    "end_sec": 11440.512,
    "zh": "切记",
    "vi": "Hãy nhớ kỹ"
  },
  {
    "idx": 6813,
    "start": "03:10:40,512",
    "end": "03:10:42,192",
    "start_sec": 11440.512,
    "end_sec": 11442.192,
    "zh": "你藏完硬币立马下车",
    "vi": "Bạn giấu đồng xu xong thì xuống xe ngay lập tức"
  },
  {
    "idx": 6814,
    "start": "03:10:42,192",
    "end": "03:10:43,892",
    "start_sec": 11442.192,
    "end_sec": 11443.892,
    "zh": "千万别坐车到南河桥",
    "vi": "Tuyệt đối đừng đi xe đến cầu Nam Hà"
  },
  {
    "idx": 6815,
    "start": "03:10:43,892",
    "end": "03:10:44,632",
    "start_sec": 11443.892,
    "end_sec": 11444.632,
    "zh": "那里",
    "vi": "Nơi đó"
  },
  {
    "idx": 6816,
    "start": "03:10:44,632",
    "end": "03:10:45,252",
    "start_sec": 11444.632,
    "end_sec": 11445.252,
    "zh": "回他",
    "vi": "Trả lời cậu ta"
  },
  {
    "idx": 6817,
    "start": "03:10:45,252",
    "end": "03:10:45,972",
    "start_sec": 11445.252,
    "end_sec": 11445.972,
    "zh": "行",
    "vi": "Được"
  },
  {
    "idx": 6818,
    "start": "03:10:45,972",
    "end": "03:10:46,792",
    "start_sec": 11445.972,
    "end_sec": 11446.792,
    "zh": "我这就去",
    "vi": "Tôi đi ngay đây"
  },
  {
    "idx": 6819,
    "start": "03:10:46,792",
    "end": "03:10:47,392",
    "start_sec": 11446.792,
    "end_sec": 11447.392,
    "zh": "对了",
    "vi": "Đúng rồi"
  },
  {
    "idx": 6820,
    "start": "03:10:47,392",
    "end": "03:10:48,452",
    "start_sec": 11447.392,
    "end_sec": 11448.452,
    "zh": "罗剑剑怎么样了",
    "vi": "La Kiếm Kiếm thế nào rồi."
  },
  {
    "idx": 6821,
    "start": "03:10:48,452",
    "end": "03:10:49,612",
    "start_sec": 11448.452,
    "end_sec": 11449.612,
    "zh": "他最近都没理我了",
    "vi": "Dạo này cậu ấy không thèm để ý đến tôi nữa"
  },
  {
    "idx": 6822,
    "start": "03:10:49,612",
    "end": "03:10:50,692",
    "start_sec": 11449.612,
    "end_sec": 11450.692,
    "zh": "你多帮帮他",
    "vi": "Bạn hãy giúp đỡ cậu ấy nhiều vào"
  },
  {
    "idx": 6823,
    "start": "03:10:50,692",
    "end": "03:10:52,532",
    "start_sec": 11450.692,
    "end_sec": 11452.532,
    "zh": "看到罗剑剑三个字",
    "vi": "Nhìn thấy ba chữ La Kiếm Kiếm"
  },
  {
    "idx": 6824,
    "start": "03:10:52,532",
    "end": "03:10:53,992",
    "start_sec": 11452.532,
    "end_sec": 11453.992,
    "zh": "橙子皮关上手机",
    "vi": "Trần Tử Bì tắt điện thoại"
  },
  {
    "idx": 6825,
    "start": "03:10:53,992",
    "end": "03:10:55,132",
    "start_sec": 11453.992,
    "end_sec": 11455.132,
    "zh": "没再回复",
    "vi": "Không trả lời lại nữa"
  },
  {
    "idx": 6826,
    "start": "03:10:55,132",
    "end": "03:10:56,072",
    "start_sec": 11455.132,
    "end_sec": 11456.072,
    "zh": "对不起了",
    "vi": "Xin lỗi nhé"
  },
  {
    "idx": 6827,
    "start": "03:10:56,072",
    "end": "03:10:56,892",
    "start_sec": 11456.072,
    "end_sec": 11456.892,
    "zh": "过去的我",
    "vi": "Tôi của quá khứ"
  },
  {
    "idx": 6828,
    "start": "03:10:56,892",
    "end": "03:10:58,252",
    "start_sec": 11456.892,
    "end_sec": 11458.252,
    "zh": "关于罗倩倩的悲剧",
    "vi": "Về bi kịch của La Thiến Thiến"
  },
  {
    "idx": 6829,
    "start": "03:10:58,252",
    "end": "03:10:59,692",
    "start_sec": 11458.252,
    "end_sec": 11459.692,
    "zh": "还是不告诉你了",
    "vi": "Tôi vẫn là không nên nói cho bạn biết"
  },
  {
    "idx": 6830,
    "start": "03:10:59,692",
    "end": "03:11:01,772",
    "start_sec": 11459.692,
    "end_sec": 11461.772,
    "zh": "静静坐在隧道口桥头公交站",
    "vi": "Lặng lẽ ngồi ở trạm xe buýt đầu cầu cửa đường hầm"
  },
  {
    "idx": 6831,
    "start": "03:11:01,772",
    "end": "03:11:03,112",
    "start_sec": 11461.772,
    "end_sec": 11463.112,
    "zh": "橙子皮吹着冷风",
    "vi": "Trần Tử Bì hứng chịu những cơn gió lạnh"
  },
  {
    "idx": 6832,
    "start": "03:11:03,112",
    "end": "03:11:03,932",
    "start_sec": 11463.112,
    "end_sec": 11463.932,
    "zh": "隧道内",
    "vi": "Bên trong đường hầm"
  },
  {
    "idx": 6833,
    "start": "03:11:03,932",
    "end": "03:11:05,492",
    "start_sec": 11463.932,
    "end_sec": 11465.492,
    "zh": "响起徐东来的响声",
    "vi": "Vang lên tiếng hét của Từ Đông Lai"
  },
  {
    "idx": 6834,
    "start": "03:11:05,492",
    "end": "03:11:06,112",
    "start_sec": 11465.492,
    "end_sec": 11466.112,
    "zh": "可恶",
    "vi": "Đáng ghét"
  },
  {
    "idx": 6835,
    "start": "03:11:06,112",
    "end": "03:11:06,712",
    "start_sec": 11466.112,
    "end_sec": 11466.712,
    "zh": "可恶",
    "vi": "Đáng ghét"
  },
  {
    "idx": 6836,
    "start": "03:11:06,712",
    "end": "03:11:07,492",
    "start_sec": 11466.712,
    "end_sec": 11467.492,
    "zh": "橙子皮",
    "vi": "Trần Tử Bì"
  },
  {
    "idx": 6837,
    "start": "03:11:07,492",
    "end": "03:11:09,132",
    "start_sec": 11467.492,
    "end_sec": 11469.132,
    "zh": "你居然敢拿我的东西",
    "vi": "Bạn dám lấy đồ của tôi"
  },
  {
    "idx": 6838,
    "start": "03:11:09,132",
    "end": "03:11:10,892",
    "start_sec": 11469.132,
    "end_sec": 11470.892,
    "zh": "我爸绝对不会放过你的",
    "vi": "Bố tôi tuyệt đối sẽ không tha cho bạn đâu"
  },
  {
    "idx": 6839,
    "start": "03:11:10,892",
    "end": "03:11:12,272",
    "start_sec": 11470.892,
    "end_sec": 11472.272,
    "zh": "牛的替死指人",
    "vi": "Hình nhân thế mạng thật lợi hại"
  },
  {
    "idx": 6840,
    "start": "03:11:12,272",
    "end": "03:11:14,552",
    "start_sec": 11472.272,
    "end_sec": 11474.552,
    "zh": "徐东来这次算是死操了",
    "vi": "Từ Đông Lai lần này coi như tiêu đời rồi"
  },
  {
    "idx": 6841,
    "start": "03:11:14,552",
    "end": "03:11:15,732",
    "start_sec": 11474.552,
    "end_sec": 11475.732,
    "zh": "他当时上公交车",
    "vi": "Lúc đó anh ta lên xe buýt"
  },
  {
    "idx": 6842,
    "start": "03:11:15,732",
    "end": "03:11:16,872",
    "start_sec": 11475.732,
    "end_sec": 11476.872,
    "zh": "肯定也没逃避",
    "vi": "Chắc chắn cũng không trốn vé"
  },
  {
    "idx": 6843,
    "start": "03:11:16,872",
    "end": "03:11:18,972",
    "start_sec": 11476.872,
    "end_sec": 11478.972,
    "zh": "应该是使用了两次指人抵命",
    "vi": "Chắc là đã dùng hình nhân thế mạng hai lần"
  },
  {
    "idx": 6844,
    "start": "03:11:18,972",
    "end": "03:11:20,772",
    "start_sec": 11478.972,
    "end_sec": 11480.772,
    "zh": "我没必要效仿他的做法",
    "vi": "Tôi không cần phải bắt chước cách làm của anh ta"
  },
  {
    "idx": 6845,
    "start": "03:11:20,772",
    "end": "03:11:22,112",
    "start_sec": 11480.772,
    "end_sec": 11482.112,
    "zh": "抵命和鬼闻",
    "vi": "Thế mạng và mùi quỷ"
  },
  {
    "idx": 6846,
    "start": "03:11:22,112",
    "end": "03:11:22,692",
    "start_sec": 11482.112,
    "end_sec": 11482.692,
    "zh": "于我而言",
    "vi": "Đối với tôi"
  },
  {
    "idx": 6847,
    "start": "03:11:22,692",
    "end": "03:11:23,732",
    "start_sec": 11482.692,
    "end_sec": 11483.732,
    "zh": "后者作用更大",
    "vi": "Cái sau có tác dụng lớn hơn"
  },
  {
    "idx": 6848,
    "start": "03:11:23,732",
    "end": "03:11:25,172",
    "start_sec": 11483.732,
    "end_sec": 11485.172,
    "zh": "至于四路公交车",
    "vi": "Còn về xe buýt tuyến số bốn"
  },
  {
    "idx": 6849,
    "start": "03:11:25,172",
    "end": "03:11:27,212",
    "start_sec": 11485.172,
    "end_sec": 11487.212,
    "zh": "我印象里是没出什么事故的",
    "vi": "Trong ấn tượng của tôi thì không xảy ra tai nạn gì"
  },
  {
    "idx": 6850,
    "start": "03:11:27,212",
    "end": "03:11:28,632",
    "start_sec": 11487.212,
    "end_sec": 11488.632,
    "zh": "应该是鬼影向你前后",
    "vi": "Chắc là bóng quỷ đã tác động đến quá khứ và tương lai của bạn"
  },
  {
    "idx": 6851,
    "start": "03:11:28,632",
    "end": "03:11:30,332",
    "start_sec": 11488.632,
    "end_sec": 11490.332,
    "zh": "难怪想象现在这个事故",
    "vi": "Thảo nào lại nghĩ đến tai nạn hiện tại"
  },
  {
    "idx": 6852,
    "start": "03:11:30,332",
    "end": "03:11:32,052",
    "start_sec": 11490.332,
    "end_sec": 11492.052,
    "zh": "那么过去的我藏下的印记",
    "vi": "Vậy thì ký hiệu mà tôi trong quá khứ cất giấu"
  },
  {
    "idx": 6853,
    "start": "03:11:32,052",
    "end": "03:11:33,072",
    "start_sec": 11492.052,
    "end_sec": 11493.072,
    "zh": "对现在来说",
    "vi": "Đối với hiện tại"
  },
  {
    "idx": 6854,
    "start": "03:11:33,072",
    "end": "03:11:36,012",
    "start_sec": 11493.072,
    "end_sec": 11496.012,
    "zh": "是有八九能符合恶鬼巴士的投币认可",
    "vi": "Tám chín phần mười là có thể đáp ứng yêu cầu bỏ xu của xe buýt ác quỷ"
  },
  {
    "idx": 6855,
    "start": "03:11:36,012",
    "end": "03:11:37,372",
    "start_sec": 11496.012,
    "end_sec": 11497.372,
    "zh": "鲜血急断着",
    "vi": "Trong làn sương máu dày đặc"
  },
  {
    "idx": 6856,
    "start": "03:11:37,372",
    "end": "03:11:38,992",
    "start_sec": 11497.372,
    "end_sec": 11498.992,
    "zh": "一辆崭新的四路公交车",
    "vi": "Một chiếc xe buýt tuyến số bốn mới toanh"
  },
  {
    "idx": 6857,
    "start": "03:11:38,992",
    "end": "03:11:41,572",
    "start_sec": 11498.992,
    "end_sec": 11501.572,
    "zh": "自深山系道路开到城子一个身体",
    "vi": "Chạy từ con đường trong núi sâu đến trước mặt Trường Tử"
  },
  {
    "idx": 6858,
    "start": "03:11:41,572",
    "end": "03:11:49,812",
    "start_sec": 11501.572,
    "end_sec": 11509.812,
    "zh": "小伙子",
    "vi": "Này chàng trai"
  },
  {
    "idx": 6859,
    "start": "03:11:49,812",
    "end": "03:11:51,392",
    "start_sec": 11509.812,
    "end_sec": 11511.392,
    "zh": "你坐车不投币的",
    "vi": "Cậu đi xe mà không bỏ xu à."
  },
  {
    "idx": 6860,
    "start": "03:11:51,392",
    "end": "03:11:52,852",
    "start_sec": 11511.392,
    "end_sec": 11512.852,
    "zh": "等会 马上",
    "vi": "Chờ chút, có ngay đây"
  },
  {
    "idx": 6861,
    "start": "03:11:52,852",
    "end": "03:11:56,032",
    "start_sec": 11512.852,
    "end_sec": 11516.032,
    "zh": "慌张工作一下掏出两枚秀气单单的硬币",
    "vi": "Trường Tử vội vàng lục lọi rồi lấy ra hai đồng xu rỉ sét loang lổ"
  },
  {
    "idx": 6862,
    "start": "03:11:56,032",
    "end": "03:11:57,792",
    "start_sec": 11516.032,
    "end_sec": 11517.792,
    "zh": "似乎被水浸泡腐蚀过",
    "vi": "Dường như đã bị ngâm nước và ăn mòn"
  },
  {
    "idx": 6863,
    "start": "03:11:57,792",
    "end": "03:11:59,172",
    "start_sec": 11517.792,
    "end_sec": 11519.172,
    "zh": "结合失误的车厢",
    "vi": "Kết hợp với khoang xe ẩm ướt"
  },
  {
    "idx": 6864,
    "start": "03:11:59,172",
    "end": "03:12:01,052",
    "start_sec": 11519.172,
    "end_sec": 11521.052,
    "zh": "以及车里诡异的模样和特性",
    "vi": "Cùng với vẻ ngoài và đặc tính kỳ dị trong xe"
  },
  {
    "idx": 6865,
    "start": "03:12:01,052",
    "end": "03:12:02,492",
    "start_sec": 11521.052,
    "end_sec": 11522.492,
    "zh": "现在基本可以站定",
    "vi": "Bây giờ cơ bản có thể khẳng định"
  },
  {
    "idx": 6866,
    "start": "03:12:02,492",
    "end": "03:12:04,592",
    "start_sec": 11522.492,
    "end_sec": 11524.592,
    "zh": "这辆巴士是在南河桥塌陷后",
    "vi": "Chiếc xe buýt này sau khi cầu Nam Hà bị sập"
  },
  {
    "idx": 6867,
    "start": "03:12:04,592",
    "end": "03:12:05,512",
    "start_sec": 11524.592,
    "end_sec": 11525.512,
    "zh": "坠入了河里",
    "vi": "Đã lao xuống sông"
  },
  {
    "idx": 6868,
    "start": "03:12:05,512",
    "end": "03:12:08,112",
    "start_sec": 11525.512,
    "end_sec": 11528.112,
    "zh": "将两枚生锈的硬币投入巴士",
    "vi": "Bỏ hai đồng xu rỉ sét vào xe buýt"
  },
  {
    "idx": 6869,
    "start": "03:12:08,112",
    "end": "03:12:10,152",
    "start_sec": 11528.112,
    "end_sec": 11530.152,
    "zh": "司机没再多看长子平眼",
    "vi": "Tài xế không thèm nhìn Trường Tử thêm một cái nào nữa"
  },
  {
    "idx": 6870,
    "start": "03:12:10,152",
    "end": "03:12:11,372",
    "start_sec": 11530.152,
    "end_sec": 11531.372,
    "zh": "他抱着小诺记",
    "vi": "Anh ta ôm lấy chiếc Nokia nhỏ"
  },
  {
    "idx": 6871,
    "start": "03:12:11,372",
    "end": "03:12:13,292",
    "start_sec": 11531.372,
    "end_sec": 11533.292,
    "zh": "走向巴士的最后台中",
    "vi": "Đi về phía hàng ghế cuối cùng của xe buýt."
  },
  {
    "idx": 6872,
    "start": "03:12:13,292",
    "end": "03:12:14,512",
    "start_sec": 11533.292,
    "end_sec": 11534.512,
    "zh": "自觉投笔",
    "vi": "Tự giác bỏ tiền vé."
  },
  {
    "idx": 6873,
    "start": "03:12:14,512",
    "end": "03:12:15,512",
    "start_sec": 11534.512,
    "end_sec": 11535.512,
    "zh": "主脑阿耀",
    "vi": "Chủ động quẹt thẻ."
  },
  {
    "idx": 6874,
    "start": "03:12:15,512",
    "end": "03:12:16,612",
    "start_sec": 11535.512,
    "end_sec": 11536.612,
    "zh": "前上后下",
    "vi": "Lên cửa trước xuống cửa sau."
  },
  {
    "idx": 6875,
    "start": "03:12:16,612",
    "end": "03:12:17,732",
    "start_sec": 11536.612,
    "end_sec": 11537.732,
    "zh": "这些应该都是",
    "vi": "Những điều này chắc đều là"
  },
  {
    "idx": 6876,
    "start": "03:12:17,732",
    "end": "03:12:19,212",
    "start_sec": 11537.732,
    "end_sec": 11539.212,
    "zh": "恶鬼巴士里的规则",
    "vi": "quy tắc trên chuyến xe buýt ma."
  },
  {
    "idx": 6877,
    "start": "03:12:19,212",
    "end": "03:12:21,152",
    "start_sec": 11539.212,
    "end_sec": 11541.152,
    "zh": "最后排没有老肉并红装作",
    "vi": "Hàng ghế cuối không có người già và người mặc đồ đỏ."
  },
  {
    "idx": 6878,
    "start": "03:12:21,152",
    "end": "03:12:22,632",
    "start_sec": 11541.152,
    "end_sec": 11542.632,
    "zh": "应该不会有什么问题吧",
    "vi": "Chắc là sẽ không có vấn đề gì đâu."
  },
  {
    "idx": 6879,
    "start": "03:12:22,632",
    "end": "03:12:24,432",
    "start_sec": 11542.632,
    "end_sec": 11544.432,
    "zh": "南河桥中到了",
    "vi": "Đã đến trạm giữa cầu Nam Hà."
  },
  {
    "idx": 6880,
    "start": "03:12:24,432",
    "end": "03:12:27,472",
    "start_sec": 11544.432,
    "end_sec": 11547.472,
    "zh": "下车的乘客请往车厢后门走",
    "vi": "Hành khách xuống xe xin vui lòng đi ra cửa sau."
  },
  {
    "idx": 6881,
    "start": "03:12:27,472",
    "end": "03:12:28,452",
    "start_sec": 11547.472,
    "end_sec": 11548.452,
    "zh": "不知不觉间",
    "vi": "Không biết từ lúc nào"
  },
  {
    "idx": 6882,
    "start": "03:12:28,452",
    "end": "03:12:30,572",
    "start_sec": 11548.452,
    "end_sec": 11550.572,
    "zh": "已经开到南河桥中的站点",
    "vi": "xe đã chạy đến trạm giữa cầu Nam Hà."
  },
  {
    "idx": 6883,
    "start": "03:12:30,572",
    "end": "03:12:32,892",
    "start_sec": 11550.572,
    "end_sec": 11552.892,
    "zh": "明明这个站点前面是坍塌的",
    "vi": "Rõ ràng là đoạn đường phía trước trạm này đã bị sập"
  },
  {
    "idx": 6884,
    "start": "03:12:32,892",
    "end": "03:12:33,712",
    "start_sec": 11552.892,
    "end_sec": 11553.712,
    "zh": "但是在车内",
    "vi": "nhưng ở trong xe"
  },
  {
    "idx": 6885,
    "start": "03:12:33,712",
    "end": "03:12:36,212",
    "start_sec": 11553.712,
    "end_sec": 11556.212,
    "zh": "眼前的南河桥却一点异样都没有",
    "vi": "cầu Nam Hà trước mắt lại không có chút bất thường nào."
  },
  {
    "idx": 6886,
    "start": "03:12:36,212",
    "end": "03:12:37,452",
    "start_sec": 11556.212,
    "end_sec": 11557.452,
    "zh": "不知为何",
    "vi": "Không biết tại sao"
  },
  {
    "idx": 6887,
    "start": "03:12:37,452",
    "end": "03:12:40,472",
    "start_sec": 11557.452,
    "end_sec": 11560.472,
    "zh": "车顶上的水渍好像越滴越快了",
    "vi": "vết nước trên trần xe dường như nhỏ giọt ngày càng nhanh."
  },
  {
    "idx": 6888,
    "start": "03:12:40,472",
    "end": "03:12:42,772",
    "start_sec": 11560.472,
    "end_sec": 11562.772,
    "zh": "橙子皮脚下也有水不断溢出蔓延",
    "vi": "Dưới chân Trần Tử Bì cũng có nước liên tục tràn ra."
  },
  {
    "idx": 6889,
    "start": "03:12:42,772",
    "end": "03:12:45,152",
    "start_sec": 11562.772,
    "end_sec": 11565.152,
    "zh": "所有鬼巴士要是一直坐上去",
    "vi": "Nếu cứ tiếp tục ngồi trên chuyến xe buýt ma này"
  },
  {
    "idx": 6890,
    "start": "03:12:45,152",
    "end": "03:12:47,152",
    "start_sec": 11565.152,
    "end_sec": 11567.152,
    "zh": "估计车厢里的水都能溢满吧",
    "vi": "có lẽ nước trong xe sẽ ngập đầy mất."
  },
  {
    "idx": 6891,
    "start": "03:12:47,152",
    "end": "03:12:49,932",
    "start_sec": 11567.152,
    "end_sec": 11569.932,
    "zh": "好在我只要坐到南河桥尾就下车",
    "vi": "May mà tôi chỉ cần đi đến cuối cầu Nam Hà là xuống xe rồi."
  },
  {
    "idx": 6892,
    "start": "03:12:49,932",
    "end": "03:12:54,392",
    "start_sec": 11569.932,
    "end_sec": 11574.392,
    "zh": "心子这般想着突然前方的门边急匆匆走上来一个老户",
    "vi": "Đang nghĩ thầm như vậy, bỗng nhiên từ phía cửa trước có một ông lão vội vã bước lên."
  },
  {
    "idx": 6893,
    "start": "03:12:54,392",
    "end": "03:12:56,652",
    "start_sec": 11574.392,
    "end_sec": 11576.652,
    "zh": "这老户上车后连钱也不给",
    "vi": "Ông lão này lên xe còn không thèm trả tiền"
  },
  {
    "idx": 6894,
    "start": "03:12:56,652",
    "end": "03:12:58,192",
    "start_sec": 11576.652,
    "end_sec": 11578.192,
    "zh": "就急匆匆走向床上",
    "vi": "đã vội vã đi thẳng vào trong xe."
  },
  {
    "idx": 6895,
    "start": "03:12:58,192",
    "end": "03:13:00,132",
    "start_sec": 11578.192,
    "end_sec": 11580.132,
    "zh": "是不是你",
    "vi": "Có phải mày không."
  },
  {
    "idx": 6896,
    "start": "03:13:00,132",
    "end": "03:13:04,612",
    "start_sec": 11580.132,
    "end_sec": 11584.612,
    "zh": "刚刚是不是你在站点偷了我的钱包",
    "vi": "Vừa nãy có phải mày đã ăn cắp ví tiền của tao ở trạm xe không."
  },
  {
    "idx": 6897,
    "start": "03:13:04,612",
    "end": "03:13:05,652",
    "start_sec": 11584.612,
    "end_sec": 11585.652,
    "zh": "什么玩意儿",
    "vi": "Cái gì cơ."
  },
  {
    "idx": 6898,
    "start": "03:13:05,652",
    "end": "03:13:06,952",
    "start_sec": 11585.652,
    "end_sec": 11586.952,
    "zh": "我给你钱包偷了",
    "vi": "Tôi ăn cắp ví của ông á."
  },
  {
    "idx": 6899,
    "start": "03:13:06,952",
    "end": "03:13:08,732",
    "start_sec": 11586.952,
    "end_sec": 11588.732,
    "zh": "臭小子",
    "vi": "Thằng ranh con."
  },
  {
    "idx": 6900,
    "start": "03:13:08,732",
    "end": "03:13:12,172",
    "start_sec": 11588.732,
    "end_sec": 11592.172,
    "zh": "你以为我老糊涂好忽悠吗",
    "vi": "Mày tưởng tao già lẩm cẩm nên dễ bị lừa à."
  },
  {
    "idx": 6901,
    "start": "03:13:12,172",
    "end": "03:13:14,012",
    "start_sec": 11592.172,
    "end_sec": 11594.012,
    "zh": "小伙子",
    "vi": "Này cậu thanh niên."
  },
  {
    "idx": 6902,
    "start": "03:13:14,012",
    "end": "03:13:15,192",
    "start_sec": 11594.012,
    "end_sec": 11595.192,
    "zh": "你疯了",
    "vi": "Cậu điên rồi sao."
  },
  {
    "idx": 6903,
    "start": "03:13:15,192",
    "end": "03:13:18,332",
    "start_sec": 11595.192,
    "end_sec": 11598.332,
    "zh": "这一辆车上全都是鬼",
    "vi": "Trên chiếc xe này toàn là ma quỷ cả đấy."
  },
  {
    "idx": 6904,
    "start": "03:13:18,332",
    "end": "03:13:19,672",
    "start_sec": 11598.332,
    "end_sec": 11599.672,
    "zh": "你还敢坐",
    "vi": "Mà cậu vẫn dám ngồi lên."
  },
  {
    "idx": 6905,
    "start": "03:13:19,672",
    "end": "03:13:22,832",
    "start_sec": 11599.672,
    "end_sec": 11602.832,
    "zh": "快点",
    "vi": "Nhanh lên nào."
  },
  {
    "idx": 6906,
    "start": "03:13:22,832",
    "end": "03:13:24,872",
    "start_sec": 11602.832,
    "end_sec": 11604.872,
    "zh": "你和我下车",
    "vi": "Cậu xuống xe cùng tôi ngay."
  },
  {
    "idx": 6907,
    "start": "03:13:24,872",
    "end": "03:13:26,512",
    "start_sec": 11604.872,
    "end_sec": 11606.512,
    "zh": "江城子提拉起来后",
    "vi": "Sau khi Giang Thành Tử bị kéo đứng dậy."
  },
  {
    "idx": 6908,
    "start": "03:13:26,512",
    "end": "03:13:27,732",
    "start_sec": 11606.512,
    "end_sec": 11607.732,
    "zh": "老父一脸的愤然",
    "vi": "Lão Phó lộ vẻ mặt đầy phẫn nộ."
  },
  {
    "idx": 6909,
    "start": "03:13:27,732",
    "end": "03:13:28,372",
    "start_sec": 11607.732,
    "end_sec": 11608.372,
    "zh": "走",
    "vi": "Đi thôi."
  },
  {
    "idx": 6910,
    "start": "03:13:28,372",
    "end": "03:13:29,752",
    "start_sec": 11608.372,
    "end_sec": 11609.752,
    "zh": "你个骗子",
    "vi": "Đồ lừa đảo."
  },
  {
    "idx": 6911,
    "start": "03:13:29,752",
    "end": "03:13:30,872",
    "start_sec": 11609.752,
    "end_sec": 11610.872,
    "zh": "和我走",
    "vi": "Đi theo tôi."
  },
  {
    "idx": 6912,
    "start": "03:13:30,872",
    "end": "03:13:33,132",
    "start_sec": 11610.872,
    "end_sec": 11613.132,
    "zh": "跟我去警局自首",
    "vi": "Cùng tôi đến đồn cảnh sát tự thú đi."
  },
  {
    "idx": 6913,
    "start": "03:13:33,132",
    "end": "03:13:34,412",
    "start_sec": 11613.132,
    "end_sec": 11614.412,
    "zh": "他骂骂咧咧的",
    "vi": "Ông ta vừa chửi bới om sòm."
  },
  {
    "idx": 6914,
    "start": "03:13:34,412",
    "end": "03:13:36,112",
    "start_sec": 11614.412,
    "end_sec": 11616.112,
    "zh": "引起车上其他乘客注意",
    "vi": "Vừa thu hút sự chú ý của hành khách trên xe."
  },
  {
    "idx": 6915,
    "start": "03:13:36,112",
    "end": "03:13:37,972",
    "start_sec": 11616.112,
    "end_sec": 11617.972,
    "zh": "就连司机也压护的看过来",
    "vi": "Ngay cả tài xế cũng quay lại nhìn đầy đe dọa."
  },
  {
    "idx": 6916,
    "start": "03:13:37,972",
    "end": "03:13:39,432",
    "start_sec": 11617.972,
    "end_sec": 11619.432,
    "zh": "上次乘车的时候",
    "vi": "Lần trước khi đi chuyến xe này."
  },
  {
    "idx": 6917,
    "start": "03:13:39,432",
    "end": "03:13:40,892",
    "start_sec": 11619.432,
    "end_sec": 11620.892,
    "zh": "肯定是没这个老人的",
    "vi": "Chắc chắn là không có ông lão này."
  },
  {
    "idx": 6918,
    "start": "03:13:40,892",
    "end": "03:13:41,312",
    "start_sec": 11620.892,
    "end_sec": 11621.312,
    "zh": "而且",
    "vi": "Hơn nữa."
  },
  {
    "idx": 6919,
    "start": "03:13:41,312",
    "end": "03:13:43,372",
    "start_sec": 11621.312,
    "end_sec": 11623.372,
    "zh": "当时南河桥中前的桥面塌陷",
    "vi": "Lúc đó mặt cầu trước Nam Hà Kiều đã sập."
  },
  {
    "idx": 6920,
    "start": "03:13:43,372",
    "end": "03:13:44,152",
    "start_sec": 11623.372,
    "end_sec": 11624.152,
    "zh": "后面的路",
    "vi": "Đoạn đường phía sau."
  },
  {
    "idx": 6921,
    "start": "03:13:44,152",
    "end": "03:13:45,392",
    "start_sec": 11624.152,
    "end_sec": 11625.392,
    "zh": "自己又亲自走过",
    "vi": "Cậu đã đích thân đi qua rồi."
  },
  {
    "idx": 6922,
    "start": "03:13:45,392",
    "end": "03:13:47,972",
    "start_sec": 11625.392,
    "end_sec": 11627.972,
    "zh": "这老人根本不可能凭空从站点出现",
    "vi": "Ông lão này không thể nào tự dưng xuất hiện ở trạm được."
  },
  {
    "idx": 6923,
    "start": "03:13:47,972",
    "end": "03:13:48,792",
    "start_sec": 11627.972,
    "end_sec": 11628.792,
    "zh": "也就是说",
    "vi": "Nói cách khác."
  },
  {
    "idx": 6924,
    "start": "03:13:48,792",
    "end": "03:13:50,432",
    "start_sec": 11628.792,
    "end_sec": 11630.432,
    "zh": "这个老傅也是诡异",
    "vi": "Lão Phó này cũng là một thực thể quỷ dị."
  },
  {
    "idx": 6925,
    "start": "03:13:50,432",
    "end": "03:13:52,312",
    "start_sec": 11630.432,
    "end_sec": 11632.312,
    "zh": "冷眼看着老傅的表演",
    "vi": "Lạnh lùng nhìn màn kịch của lão Phó."
  },
  {
    "idx": 6926,
    "start": "03:13:52,312",
    "end": "03:13:54,452",
    "start_sec": 11632.312,
    "end_sec": 11634.452,
    "zh": "橙子皮就那么站在他身后",
    "vi": "Thành Tử cứ đứng yên lặng phía sau ông ta."
  },
  {
    "idx": 6927,
    "start": "03:13:54,452",
    "end": "03:13:55,612",
    "start_sec": 11634.452,
    "end_sec": 11635.612,
    "zh": "瞅瞅瞅",
    "vi": "Cứ nhìn chằm chằm."
  },
  {
    "idx": 6928,
    "start": "03:13:55,612",
    "end": "03:13:56,372",
    "start_sec": 11635.612,
    "end_sec": 11636.372,
    "zh": "瞅直到瞅",
    "vi": "Nhìn mãi không thôi."
  },
  {
    "idx": 6929,
    "start": "03:13:56,372",
    "end": "03:13:57,892",
    "start_sec": 11636.372,
    "end_sec": 11637.892,
    "zh": "我请自己下车进去",
    "vi": "Cậu muốn tự mình xuống xe xem sao."
  },
  {
    "idx": 6930,
    "start": "03:13:57,892",
    "end": "03:13:59,172",
    "start_sec": 11637.892,
    "end_sec": 11639.172,
    "zh": "车门弹开后",
    "vi": "Sau khi cửa xe bật mở."
  },
  {
    "idx": 6931,
    "start": "03:13:59,172",
    "end": "03:14:00,852",
    "start_sec": 11639.172,
    "end_sec": 11640.852,
    "zh": "老傅朝橙子皮一下",
    "vi": "Lão Phó trêu Thành Tử một chút."
  },
  {
    "idx": 6932,
    "start": "03:14:00,852",
    "end": "03:14:02,432",
    "start_sec": 11640.852,
    "end_sec": 11642.432,
    "zh": "就要拉着他的胳膊下车",
    "vi": "Định kéo tay cậu ấy xuống xe."
  },
  {
    "idx": 6933,
    "start": "03:14:02,432",
    "end": "03:14:04,692",
    "start_sec": 11642.432,
    "end_sec": 11644.692,
    "zh": "然而橙子皮并没下车",
    "vi": "Thế nhưng Thành Tử lại không xuống xe."
  },
  {
    "idx": 6934,
    "start": "03:14:04,692",
    "end": "03:14:05,612",
    "start_sec": 11644.692,
    "end_sec": 11645.612,
    "zh": "小伙子",
    "vi": "Cậu trẻ kia."
  },
  {
    "idx": 6935,
    "start": "03:14:05,612",
    "end": "03:14:07,152",
    "start_sec": 11645.612,
    "end_sec": 11647.152,
    "zh": "你不要命了",
    "vi": "Cậu không cần mạng nữa à."
  },
  {
    "idx": 6936,
    "start": "03:14:07,152",
    "end": "03:14:08,612",
    "start_sec": 11647.152,
    "end_sec": 11648.612,
    "zh": "赶紧下来",
    "vi": "Mau xuống đây đi."
  },
  {
    "idx": 6937,
    "start": "03:14:08,612",
    "end": "03:14:09,612",
    "start_sec": 11648.612,
    "end_sec": 11649.612,
    "zh": "老傅催促着",
    "vi": "Lão Phó thúc giục."
  },
  {
    "idx": 6938,
    "start": "03:14:09,612",
    "end": "03:14:11,152",
    "start_sec": 11649.612,
    "end_sec": 11651.152,
    "zh": "眼神忌惮地看着车内",
    "vi": "Ánh mắt e dè nhìn vào trong xe."
  },
  {
    "idx": 6939,
    "start": "03:14:11,152",
    "end": "03:14:11,732",
    "start_sec": 11651.152,
    "end_sec": 11651.732,
    "zh": "那模样",
    "vi": "Dáng vẻ đó."
  },
  {
    "idx": 6940,
    "start": "03:14:11,732",
    "end": "03:14:13,892",
    "start_sec": 11651.732,
    "end_sec": 11653.892,
    "zh": "似乎真的是个惊慌的平凡人",
    "vi": "Trông cứ như một người bình thường đang hoảng sợ."
  },
  {
    "idx": 6941,
    "start": "03:14:13,892",
    "end": "03:14:15,932",
    "start_sec": 11653.892,
    "end_sec": 11655.932,
    "zh": "我要是真下车了",
    "vi": "Nếu tôi thực sự xuống xe."
  },
  {
    "idx": 6942,
    "start": "03:14:15,932",
    "end": "03:14:16,932",
    "start_sec": 11655.932,
    "end_sec": 11656.932,
    "zh": "是不是会死",
    "vi": "Có phải sẽ chết không."
  },
  {
    "idx": 6943,
    "start": "03:14:16,932",
    "end": "03:14:18,372",
    "start_sec": 11656.932,
    "end_sec": 11658.372,
    "zh": "快跟我下车",
    "vi": "Mau xuống xe với tôi."
  },
  {
    "idx": 6944,
    "start": "03:14:18,372",
    "end": "03:14:20,252",
    "start_sec": 11658.372,
    "end_sec": 11660.252,
    "zh": "回面窗开上老妇",
    "vi": "Quay đầu nhìn Lão Phó."
  },
  {
    "idx": 6945,
    "start": "03:14:20,252",
    "end": "03:14:21,972",
    "start_sec": 11660.252,
    "end_sec": 11661.972,
    "zh": "她立马颤抖着松开手",
    "vi": "Ông ta lập tức run rẩy buông tay ra."
  },
  {
    "idx": 6946,
    "start": "03:14:21,972",
    "end": "03:14:23,952",
    "start_sec": 11661.972,
    "end_sec": 11663.952,
    "zh": "南河桥上根本没有活人",
    "vi": "Trên cầu Nam Hà vốn dĩ không có người sống."
  },
  {
    "idx": 6947,
    "start": "03:14:23,952",
    "end": "03:14:24,932",
    "start_sec": 11663.952,
    "end_sec": 11664.932,
    "zh": "你又是什么",
    "vi": "Ông rốt cuộc là thứ gì."
  },
  {
    "idx": 6948,
    "start": "03:14:24,932",
    "end": "03:14:26,592",
    "start_sec": 11664.932,
    "end_sec": 11666.592,
    "zh": "长者皮退回车内",
    "vi": "Thành Tử lùi lại vào trong xe."
  },
  {
    "idx": 6949,
    "start": "03:14:26,592",
    "end": "03:14:27,612",
    "start_sec": 11666.592,
    "end_sec": 11667.612,
    "zh": "车门扑死鬼",
    "vi": "Cửa xe đóng sầm lại."
  },
  {
    "idx": 6950,
    "start": "03:14:27,612",
    "end": "03:14:30,232",
    "start_sec": 11667.612,
    "end_sec": 11670.232,
    "zh": "接着老妇原本还关心的神经",
    "vi": "Tiếp đó, nét mặt lo lắng của Lão Phó."
  },
  {
    "idx": 6951,
    "start": "03:14:30,232",
    "end": "03:14:31,332",
    "start_sec": 11670.232,
    "end_sec": 11671.332,
    "zh": "便被阴晕起来",
    "vi": "Bỗng trở nên u ám."
  },
  {
    "idx": 6952,
    "start": "03:14:31,332",
    "end": "03:14:32,772",
    "start_sec": 11671.332,
    "end_sec": 11672.772,
    "zh": "则狠狠瞪向长者皮",
    "vi": "Trừng mắt dữ tợn nhìn Thành Tử."
  },
  {
    "idx": 6953,
    "start": "03:14:32,772",
    "end": "03:14:34,852",
    "start_sec": 11672.772,
    "end_sec": 11674.852,
    "zh": "长者皮这才惊恶的发现",
    "vi": "Thành Tử lúc này mới kinh ngạc phát hiện."
  },
  {
    "idx": 6954,
    "start": "03:14:34,852",
    "end": "03:14:36,072",
    "start_sec": 11674.852,
    "end_sec": 11676.072,
    "zh": "老妇大地的地方",
    "vi": "Nơi Lão Phó đang đứng."
  },
  {
    "idx": 6955,
    "start": "03:14:36,072",
    "end": "03:14:37,112",
    "start_sec": 11676.072,
    "end_sec": 11677.112,
    "zh": "根本不是路面",
    "vi": "Vốn dĩ không phải mặt đường."
  },
  {
    "idx": 6956,
    "start": "03:14:37,112",
    "end": "03:14:38,452",
    "start_sec": 11677.112,
    "end_sec": 11678.452,
    "zh": "而是一片河面",
    "vi": "Mà là một mặt sông."
  },
  {
    "idx": 6957,
    "start": "03:14:38,452",
    "end": "03:14:39,132",
    "start_sec": 11678.452,
    "end_sec": 11679.132,
    "zh": "别吵",
    "vi": "Đừng ồn."
  },
  {
    "idx": 6958,
    "start": "03:14:39,132",
    "end": "03:14:40,652",
    "start_sec": 11679.132,
    "end_sec": 11680.652,
    "zh": "原来这就是个逆死鬼",
    "vi": "Thì ra đây là một con quỷ chết đuối."
  },
  {
    "idx": 6959,
    "start": "03:14:40,652",
    "end": "03:14:42,312",
    "start_sec": 11680.652,
    "end_sec": 11682.312,
    "zh": "要拉人下水做提升",
    "vi": "Muốn kéo người xuống nước làm kẻ thế mạng."
  },
  {
    "idx": 6960,
    "start": "03:14:42,312",
    "end": "03:14:44,352",
    "start_sec": 11682.312,
    "end_sec": 11684.352,
    "zh": "好在我已经死过一次",
    "vi": "May mà tôi đã chết một lần rồi."
  },
  {
    "idx": 6961,
    "start": "03:14:44,352",
    "end": "03:14:46,552",
    "start_sec": 11684.352,
    "end_sec": 11686.552,
    "zh": "不然还真有可能跟他下车",
    "vi": "Nếu không thì thực sự có khả năng đã xuống xe cùng hắn rồi."
  },
  {
    "idx": 6962,
    "start": "03:14:46,552",
    "end": "03:14:48,552",
    "start_sec": 11686.552,
    "end_sec": 11688.552,
    "zh": "这巴士太邪乎了",
    "vi": "Chiếc xe buýt này quá kỳ quái rồi."
  },
  {
    "idx": 6963,
    "start": "03:14:48,552",
    "end": "03:14:50,892",
    "start_sec": 11688.552,
    "end_sec": 11690.892,
    "zh": "竟然像船一样飘在河面上",
    "vi": "Nó lại có thể nổi trên mặt sông như một chiếc thuyền."
  },
  {
    "idx": 6964,
    "start": "03:14:50,892",
    "end": "03:14:52,572",
    "start_sec": 11690.892,
    "end_sec": 11692.572,
    "zh": "长子皮也没回座位上",
    "vi": "Trần Tử Bì cũng không quay lại chỗ ngồi."
  },
  {
    "idx": 6965,
    "start": "03:14:52,572",
    "end": "03:14:54,092",
    "start_sec": 11692.572,
    "end_sec": 11694.092,
    "zh": "守着公交车后门",
    "vi": "Anh canh giữ ở cửa sau xe buýt."
  },
  {
    "idx": 6966,
    "start": "03:14:54,092",
    "end": "03:14:55,997",
    "start_sec": 11694.092,
    "end_sec": 11695.997,
    "zh": "以便第一时间下车仰看着巴士车驱离河面上方小伟的汽车站点点轮廓渐渐醒目,突然怀着一个小木屐身体颤抖起来。",
    "vi": "Để có thể xuống xe ngay lập tức"
  },
  {
    "idx": 6966,
    "start": "03:14:55,997",
    "end": "03:14:59,568",
    "start_sec": 11695.997,
    "end_sec": 11699.568,
    "zh": "以便第一时间下车仰看着巴士车驱离河面上方小伟的汽车站点点轮廓渐渐醒目,突然怀着一个小木屐身体颤抖起来。",
    "vi": "Nhìn chiếc xe buýt rời khỏi mặt sông, đường nét của trạm xe buýt phía"
  },
  {
    "idx": 6966,
    "start": "03:14:59,568",
    "end": "03:15:03,378",
    "start_sec": 11699.568,
    "end_sec": 11703.378,
    "zh": "以便第一时间下车仰看着巴士车驱离河面上方小伟的汽车站点点轮廓渐渐醒目,突然怀着一个小木屐身体颤抖起来。",
    "vi": "trước dần hiện rõ, đột nhiên đứa nhỏ đi guốc gỗ trong lòng run rẩy lên"
  },
  {
    "idx": 6967,
    "start": "03:15:05,198",
    "end": "03:15:06,538",
    "start_sec": 11705.198,
    "end_sec": 11706.538,
    "zh": "小木屐,怎么了?",
    "vi": "Tiểu Mộc Kê, có chuyện gì thế."
  },
  {
    "idx": 6968,
    "start": "03:15:07,218",
    "end": "03:15:09,714",
    "start_sec": 11707.218,
    "end_sec": 11709.714,
    "zh": "话刚说到一半,车顶水低加速渗漏,原本崭新的巴士开始长出灰黄色的锈迹,小叫的潜水莫过橙子皮的角落朝着膝盖延来。",
    "vi": "Lời vừa nói được một nửa, nước từ trần xe bắt đầu rò"
  },
  {
    "idx": 6968,
    "start": "03:15:09,714",
    "end": "03:15:12,210",
    "start_sec": 11709.714,
    "end_sec": 11712.21,
    "zh": "话刚说到一半,车顶水低加速渗漏,原本崭新的巴士开始长出灰黄色的锈迹,小叫的潜水莫过橙子皮的角落朝着膝盖延来。",
    "vi": "rỉ nhanh hơn, chiếc xe buýt vốn còn mới tinh bắt đầu xuất"
  },
  {
    "idx": 6968,
    "start": "03:15:12,210",
    "end": "03:15:16,818",
    "start_sec": 11712.21,
    "end_sec": 11716.818,
    "zh": "话刚说到一半,车顶水低加速渗漏,原本崭新的巴士开始长出灰黄色的锈迹,小叫的潜水莫过橙子皮的角落朝着膝盖延来。",
    "vi": "hiện những vết gỉ sét màu vàng xám, nước ngập qua mắt cá chân của Trần Tử Bì và dâng lên đến đầu gối."
  },
  {
    "idx": 6969,
    "start": "03:15:17,158",
    "end": "03:15:20,968",
    "start_sec": 11717.158,
    "end_sec": 11720.968,
    "zh": "这车好像越接近南河桥尾,车内就越发的崩溃,越是离开南河,车就越会变成它原本的样子。",
    "vi": "Chiếc xe này dường như càng đến gần cuối cầu Nam Hà thì bên trong xe càng đổ nát,"
  },
  {
    "idx": 6969,
    "start": "03:15:20,968",
    "end": "03:15:24,578",
    "start_sec": 11720.968,
    "end_sec": 11724.578,
    "zh": "这车好像越接近南河桥尾,车内就越发的崩溃,越是离开南河,车就越会变成它原本的样子。",
    "vi": "càng rời xa sông Nam Hà thì chiếc xe càng trở về hình dáng ban đầu của nó."
  },
  {
    "idx": 6970,
    "start": "03:15:25,018",
    "end": "03:15:26,858",
    "start_sec": 11725.018,
    "end_sec": 11726.858,
    "zh": "长子提扫射一辆车内",
    "vi": "Trần Tử Bì quét mắt nhìn quanh xe."
  },
  {
    "idx": 6971,
    "start": "03:15:26,858",
    "end": "03:15:29,578",
    "start_sec": 11726.858,
    "end_sec": 11729.578,
    "zh": "作为让前生浑身贵烂的无人知情",
    "vi": "Những cái xác thối rữa trên ghế ngồi không một tiếng động."
  },
  {
    "idx": 6972,
    "start": "03:15:29,578",
    "end": "03:15:30,538",
    "start_sec": 11729.578,
    "end_sec": 11730.538,
    "zh": "可恶",
    "vi": "Khốn kiếp."
  },
  {
    "idx": 6973,
    "start": "03:15:30,538",
    "end": "03:15:32,558",
    "start_sec": 11730.538,
    "end_sec": 11732.558,
    "zh": "难道这车根本开不出南河桥吗",
    "vi": "Chẳng lẽ chiếc xe này vốn dĩ không thể chạy ra khỏi cầu Nam Hà sao."
  },
  {
    "idx": 6974,
    "start": "03:15:32,558",
    "end": "03:15:35,638",
    "start_sec": 11732.558,
    "end_sec": 11735.638,
    "zh": "长子提昂着脑袋将小磨叽举过头顶",
    "vi": "Trần Tử Bì ngẩng đầu lên và nâng Tiểu Mộc Kê lên quá đầu."
  },
  {
    "idx": 6975,
    "start": "03:15:35,638",
    "end": "03:15:38,738",
    "start_sec": 11735.638,
    "end_sec": 11738.738,
    "zh": "四路公交车已经彻底变为秀气斑斑的车子",
    "vi": "Chiếc xe buýt số bốn đã hoàn toàn biến thành một chiếc xe gỉ sét loang lổ."
  },
  {
    "idx": 6976,
    "start": "03:15:38,738",
    "end": "03:15:41,158",
    "start_sec": 11738.738,
    "end_sec": 11741.158,
    "zh": "南河桥尾站点到了",
    "vi": "Đã đến trạm cuối cầu Nam Hà."
  },
  {
    "idx": 6977,
    "start": "03:15:41,158",
    "end": "03:15:42,278",
    "start_sec": 11741.158,
    "end_sec": 11742.278,
    "zh": "终于到了",
    "vi": "Cuối cùng cũng đến rồi."
  },
  {
    "idx": 6978,
    "start": "03:15:42,278",
    "end": "03:15:43,258",
    "start_sec": 11742.278,
    "end_sec": 11743.258,
    "zh": "请开车门",
    "vi": "Xin hãy mở cửa xe."
  },
  {
    "idx": 6979,
    "start": "03:15:43,258",
    "end": "03:15:44,578",
    "start_sec": 11743.258,
    "end_sec": 11744.578,
    "zh": "我要下车",
    "vi": "Tôi muốn xuống xe."
  },
  {
    "idx": 6980,
    "start": "03:15:44,578",
    "end": "03:15:54,098",
    "start_sec": 11744.578,
    "end_sec": 11754.098,
    "zh": "那辆本该泡烂的四路公交车又变成崭新的模样",
    "vi": "Chiếc xe buýt số bốn đáng lẽ phải bị ngâm mục nát kia lại biến thành hình dáng mới tinh."
  },
  {
    "idx": 6981,
    "start": "03:15:54,098",
    "end": "03:15:56,558",
    "start_sec": 11754.098,
    "end_sec": 11756.558,
    "zh": "这,恶鬼八世只能在车内杀人吗?",
    "vi": "Chuyện này, xe buýt ác quỷ chỉ có thể giết người ở trong xe thôi sao."
  },
  {
    "idx": 6982,
    "start": "03:15:57,098",
    "end": "03:15:59,138",
    "start_sec": 11757.098,
    "end_sec": 11759.138,
    "zh": "然而,公交车却并没有开走。",
    "vi": "Tuy nhiên, chiếc xe buýt lại không hề rời đi."
  },
  {
    "idx": 6983,
    "start": "03:15:59,978",
    "end": "03:16:01,178",
    "start_sec": 11759.978,
    "end_sec": 11761.178,
    "zh": "没有素质的东西。",
    "vi": "Đồ vô ý thức."
  },
  {
    "idx": 6984,
    "start": "03:16:01,578",
    "end": "03:16:02,358",
    "start_sec": 11761.578,
    "end_sec": 11762.358,
    "zh": "什么玩意儿?",
    "vi": "Cái quái gì thế."
  },
  {
    "idx": 6985,
    "start": "03:16:02,578",
    "end": "03:16:03,578",
    "start_sec": 11762.578,
    "end_sec": 11763.578,
    "zh": "我不是付过车钱,",
    "vi": "Không phải tôi đã trả tiền xe rồi sao,"
  },
  {
    "idx": 6986,
    "start": "03:16:03,858",
    "end": "03:16:05,338",
    "start_sec": 11763.858,
    "end_sec": 11765.338,
    "zh": "我不是什么规则也没出发吗?",
    "vi": "Không phải tôi cũng không vi phạm quy tắc nào sao."
  },
  {
    "idx": 6987,
    "start": "03:16:05,798",
    "end": "03:16:06,978",
    "start_sec": 11765.798,
    "end_sec": 11766.978,
    "zh": "没有素质的东西,",
    "vi": "Đồ vô ý thức,"
  },
  {
    "idx": 6988,
    "start": "03:16:07,258",
    "end": "03:16:08,418",
    "start_sec": 11767.258,
    "end_sec": 11768.418,
    "zh": "小孩子都知道的是,",
    "vi": "Đến đứa trẻ con cũng biết điều đó,"
  },
  {
    "idx": 6989,
    "start": "03:16:08,638",
    "end": "03:16:09,998",
    "start_sec": 11768.638,
    "end_sec": 11769.998,
    "zh": "这种人就该死。",
    "vi": "Loại người này đáng chết."
  },
  {
    "idx": 6990,
    "start": "03:16:10,478",
    "end": "03:16:12,778",
    "start_sec": 11770.478,
    "end_sec": 11772.778,
    "zh": "四楼公交车再次响起秦朝怒吼,",
    "vi": "Trên chiếc xe buýt số bốn lại vang lên tiếng gầm giận dữ của Tần Triều."
  },
  {
    "idx": 6991,
    "start": "03:16:13,038",
    "end": "03:16:14,378",
    "start_sec": 11773.038,
    "end_sec": 11774.378,
    "zh": "王子皮抱起小墨迹,",
    "vi": "Vương Tử Bì ôm Tiểu Mặc Tích,"
  },
  {
    "idx": 6992,
    "start": "03:16:14,658",
    "end": "03:16:15,938",
    "start_sec": 11774.658,
    "end_sec": 11775.938,
    "zh": "靠着南河桥外绑奔。",
    "vi": "dựa vào bờ Nam Hà."
  },
  {
    "idx": 6993,
    "start": "03:16:16,278",
    "end": "03:16:17,898",
    "start_sec": 11776.278,
    "end_sec": 11777.898,
    "zh": "难道是因为秦老爱用?",
    "vi": "Chẳng lẽ vì lão Tần thích dùng nó."
  },
  {
    "idx": 6994,
    "start": "03:16:18,218",
    "end": "03:16:19,478",
    "start_sec": 11778.218,
    "end_sec": 11779.478,
    "zh": "我没有和那个老夫下车,",
    "vi": "Tôi không xuống xe với lão già đó,"
  },
  {
    "idx": 6995,
    "start": "03:16:19,838",
    "end": "03:16:21,378",
    "start_sec": 11779.838,
    "end_sec": 11781.378,
    "zh": "我操,这也算了。",
    "vi": "Đệt, cái này cũng tính."
  },
  {
    "idx": 6996,
    "start": "03:16:24,098",
    "end": "03:16:26,718",
    "start_sec": 11784.098,
    "end_sec": 11786.718,
    "zh": "坏了",
    "vi": "Hỏng rồi."
  },
  {
    "idx": 6997,
    "start": "03:16:26,718",
    "end": "03:16:27,458",
    "start_sec": 11786.718,
    "end_sec": 11787.458,
    "zh": "躲不掉",
    "vi": "Không trốn được."
  },
  {
    "idx": 6998,
    "start": "03:16:27,458",
    "end": "03:16:31,118",
    "start_sec": 11787.458,
    "end_sec": 11791.118,
    "zh": "鬼面窗",
    "vi": "Cửa sổ mặt quỷ."
  },
  {
    "idx": 6999,
    "start": "03:16:31,118",
    "end": "03:16:34,098",
    "start_sec": 11791.118,
    "end_sec": 11794.098,
    "zh": "在鬼面窗的无效化之下",
    "vi": "Dưới sự vô hiệu hóa của cửa sổ mặt quỷ,"
  },
  {
    "idx": 7000,
    "start": "03:16:34,098",
    "end": "03:16:35,818",
    "start_sec": 11794.098,
    "end_sec": 11795.818,
    "zh": "测诡巴士僵持在空中",
    "vi": "xe buýt quỷ bị kẹt giữa không trung,"
  },
  {
    "idx": 7001,
    "start": "03:16:35,818",
    "end": "03:16:36,798",
    "start_sec": 11795.818,
    "end_sec": 11796.798,
    "zh": "无法下落",
    "vi": "không thể hạ xuống."
  },
  {
    "idx": 7002,
    "start": "03:16:36,798",
    "end": "03:16:41,478",
    "start_sec": 11796.798,
    "end_sec": 11801.478,
    "zh": "程子提不顾一切的朝着南河桥尽头靠近",
    "vi": "Thành Tử Đề liều mạng lao về phía cuối cầu Nam Hà."
  },
  {
    "idx": 7003,
    "start": "03:16:41,478",
    "end": "03:16:42,418",
    "start_sec": 11801.478,
    "end_sec": 11802.418,
    "zh": "桥路尽头",
    "vi": "Cuối đường cầu"
  },
  {
    "idx": 7004,
    "start": "03:16:42,418",
    "end": "03:16:44,598",
    "start_sec": 11802.418,
    "end_sec": 11804.598,
    "zh": "赫然有一个停放船只的码头",
    "vi": "là một bến tàu để thuyền bè neo đậu."
  },
  {
    "idx": 7005,
    "start": "03:16:44,598",
    "end": "03:16:45,878",
    "start_sec": 11804.598,
    "end_sec": 11805.878,
    "zh": "应该是了",
    "vi": "Chắc là ở đây rồi."
  },
  {
    "idx": 7006,
    "start": "03:16:45,878",
    "end": "03:16:47,238",
    "start_sec": 11805.878,
    "end_sec": 11807.238,
    "zh": "游轮会经过的地方",
    "vi": "Nơi du thuyền sẽ đi qua."
  },
  {
    "idx": 7007,
    "start": "03:16:47,238",
    "end": "03:16:50,158",
    "start_sec": 11807.238,
    "end_sec": 11810.158,
    "zh": "远方似乎也传来游轮的鸣鼓声",
    "vi": "Từ xa dường như cũng vọng lại tiếng còi du thuyền."
  },
  {
    "idx": 7008,
    "start": "03:16:50,158",
    "end": "03:16:50,978",
    "start_sec": 11810.158,
    "end_sec": 11810.978,
    "zh": "有救",
    "vi": "Có hy vọng rồi."
  },
  {
    "idx": 7009,
    "start": "03:16:50,978",
    "end": "03:16:52,358",
    "start_sec": 11810.978,
    "end_sec": 11812.358,
    "zh": "只要撑到游轮来",
    "vi": "Chỉ cần đợi được du thuyền tới."
  },
  {
    "idx": 7010,
    "start": "03:16:52,358",
    "end": "03:16:53,558",
    "start_sec": 11812.358,
    "end_sec": 11813.558,
    "zh": "想办法上游轮",
    "vi": "Tìm cách lên du thuyền."
  },
  {
    "idx": 7011,
    "start": "03:16:53,558",
    "end": "03:16:55,818",
    "start_sec": 11813.558,
    "end_sec": 11815.818,
    "zh": "船上的遇鬼者说不定会出手",
    "vi": "Những người gặp ma trên thuyền có lẽ sẽ ra tay."
  },
  {
    "idx": 7012,
    "start": "03:16:55,818",
    "end": "03:16:57,478",
    "start_sec": 11815.818,
    "end_sec": 11817.478,
    "zh": "小子",
    "vi": "Nhóc con,"
  },
  {
    "idx": 7013,
    "start": "03:16:57,478",
    "end": "03:16:59,218",
    "start_sec": 11817.478,
    "end_sec": 11819.218,
    "zh": "你是不是想冲到游轮过来",
    "vi": "cậu định lao tới du thuyền kia"
  },
  {
    "idx": 7014,
    "start": "03:16:59,218",
    "end": "03:17:00,218",
    "start_sec": 11819.218,
    "end_sec": 11820.218,
    "zh": "然后破水中",
    "vi": "rồi lao xuống nước"
  },
  {
    "idx": 7015,
    "start": "03:17:00,218",
    "end": "03:17:01,378",
    "start_sec": 11820.218,
    "end_sec": 11821.378,
    "zh": "跑到游轮上",
    "vi": "chạy lên du thuyền sao."
  },
  {
    "idx": 7016,
    "start": "03:17:01,378",
    "end": "03:17:03,918",
    "start_sec": 11821.378,
    "end_sec": 11823.918,
    "zh": "这样就能逼得上面的遇鬼者动手",
    "vi": "Làm vậy sẽ ép những người gặp ma trên đó phải ra tay."
  },
  {
    "idx": 7017,
    "start": "03:17:03,918",
    "end": "03:17:05,878",
    "start_sec": 11823.918,
    "end_sec": 11825.878,
    "zh": "鬼面窗在耳边嘲讽",
    "vi": "Cửa sổ mặt quỷ chế giễu bên tai."
  },
  {
    "idx": 7018,
    "start": "03:17:05,878",
    "end": "03:17:07,318",
    "start_sec": 11825.878,
    "end_sec": 11827.318,
    "zh": "橙子皮没有理会",
    "vi": "Thành Tử Đề không để ý."
  },
  {
    "idx": 7019,
    "start": "03:17:07,318",
    "end": "03:17:08,958",
    "start_sec": 11827.318,
    "end_sec": 11828.958,
    "zh": "跑到码头边时",
    "vi": "Khi chạy đến bờ bến tàu,"
  },
  {
    "idx": 7020,
    "start": "03:17:08,958",
    "end": "03:17:10,578",
    "start_sec": 11828.958,
    "end_sec": 11830.578,
    "zh": "脖子上的鬼纹削碎一大",
    "vi": "hình xăm quỷ trên cổ anh ta bị xóa đi một mảng lớn."
  },
  {
    "idx": 7021,
    "start": "03:17:10,578",
    "end": "03:17:12,378",
    "start_sec": 11830.578,
    "end_sec": 11832.378,
    "zh": "失去鬼面窗的控制",
    "vi": "Mất đi sự kiểm soát của cửa sổ mặt quỷ."
  },
  {
    "idx": 7022,
    "start": "03:17:12,378",
    "end": "03:17:14,658",
    "start_sec": 11832.378,
    "end_sec": 11834.658,
    "zh": "巴士再度朝橙子皮飞上来",
    "vi": "Chiếc xe buýt lại lao về phía Thành Tử Đề."
  },
  {
    "idx": 7023,
    "start": "03:17:14,658",
    "end": "03:17:16,298",
    "start_sec": 11834.658,
    "end_sec": 11836.298,
    "zh": "该死的恶鬼发誓",
    "vi": "Con quỷ đáng chết thề rằng."
  },
  {
    "idx": 7024,
    "start": "03:17:16,298",
    "end": "03:17:17,878",
    "start_sec": 11836.298,
    "end_sec": 11837.878,
    "zh": "这是要追杀到底吗",
    "vi": "Nó muốn truy sát đến cùng sao."
  },
  {
    "idx": 7025,
    "start": "03:17:17,878",
    "end": "03:17:18,658",
    "start_sec": 11837.878,
    "end_sec": 11838.658,
    "zh": "说话间",
    "vi": "Trong lúc nói."
  },
  {
    "idx": 7026,
    "start": "03:17:18,658",
    "end": "03:17:20,138",
    "start_sec": 11838.658,
    "end_sec": 11840.138,
    "zh": "鬼面窗再度阻挡",
    "vi": "Cửa sổ mặt quỷ lại ngăn cản."
  },
  {
    "idx": 7027,
    "start": "03:17:20,138",
    "end": "03:17:21,318",
    "start_sec": 11840.138,
    "end_sec": 11841.318,
    "zh": "巴士再度行攻",
    "vi": "Xe buýt lại tấn công."
  },
  {
    "idx": 7028,
    "start": "03:17:21,318",
    "end": "03:17:23,338",
    "start_sec": 11841.318,
    "end_sec": 11843.338,
    "zh": "橙子皮看向远处的条纹",
    "vi": "Thành Tử Đề nhìn về phía vạch kẻ đường xa xa."
  },
  {
    "idx": 7029,
    "start": "03:17:23,338",
    "end": "03:17:25,838",
    "start_sec": 11843.338,
    "end_sec": 11845.838,
    "zh": "这一次他直接跳进河水里",
    "vi": "Lần này anh ta nhảy thẳng xuống dòng sông."
  },
  {
    "idx": 7030,
    "start": "03:17:25,838",
    "end": "03:17:26,758",
    "start_sec": 11845.838,
    "end_sec": 11846.758,
    "zh": "好有灵感",
    "vi": "Thật là có linh cảm."
  },
  {
    "idx": 7031,
    "start": "03:17:26,758",
    "end": "03:17:32,318",
    "start_sec": 11846.758,
    "end_sec": 11852.318,
    "zh": "徐叔",
    "vi": "Chú Từ."
  },
  {
    "idx": 7032,
    "start": "03:17:32,318",
    "end": "03:17:33,318",
    "start_sec": 11852.318,
    "end_sec": 11853.318,
    "zh": "东岸没出现",
    "vi": "Bờ đông không xuất hiện."
  },
  {
    "idx": 7033,
    "start": "03:17:33,318",
    "end": "03:17:34,118",
    "start_sec": 11853.318,
    "end_sec": 11854.118,
    "zh": "哎",
    "vi": "Này."
  },
  {
    "idx": 7034,
    "start": "03:17:34,118",
    "end": "03:17:35,258",
    "start_sec": 11854.118,
    "end_sec": 11855.258,
    "zh": "不知道为什么",
    "vi": "Không biết tại sao."
  },
  {
    "idx": 7035,
    "start": "03:17:35,258",
    "end": "03:17:37,018",
    "start_sec": 11855.258,
    "end_sec": 11857.018,
    "zh": "刚刚电话就打不通",
    "vi": "Vừa rồi điện thoại không gọi được."
  },
  {
    "idx": 7036,
    "start": "03:17:37,018",
    "end": "03:17:38,598",
    "start_sec": 11857.018,
    "end_sec": 11858.598,
    "zh": "心里沉甸甸的",
    "vi": "Trong lòng thấy nặng trĩu."
  },
  {
    "idx": 7037,
    "start": "03:17:38,598",
    "end": "03:17:39,398",
    "start_sec": 11858.598,
    "end_sec": 11859.398,
    "zh": "这家伙",
    "vi": "Thằng nhóc này."
  },
  {
    "idx": 7038,
    "start": "03:17:39,398",
    "end": "03:17:41,998",
    "start_sec": 11859.398,
    "end_sec": 11861.998,
    "zh": "说什么自己也有办法当遇鬼者",
    "vi": "Nói cái gì mà mình cũng có cách để trở thành người gặp ma."
  },
  {
    "idx": 7039,
    "start": "03:17:41,998",
    "end": "03:17:43,578",
    "start_sec": 11861.998,
    "end_sec": 11863.578,
    "zh": "不会搞砸了吧",
    "vi": "Không phải là làm hỏng chuyện rồi chứ."
  },
  {
    "idx": 7040,
    "start": "03:17:43,578",
    "end": "03:17:44,278",
    "start_sec": 11863.578,
    "end_sec": 11864.278,
    "zh": "哎",
    "vi": "Này."
  },
  {
    "idx": 7041,
    "start": "03:17:44,278",
    "end": "03:17:44,598",
    "start_sec": 11864.278,
    "end_sec": 11864.598,
    "zh": "这",
    "vi": "Cái này."
  },
  {
    "idx": 7042,
    "start": "03:17:44,598",
    "end": "03:17:45,458",
    "start_sec": 11864.598,
    "end_sec": 11865.458,
    "zh": "徐叔",
    "vi": "Chú Từ."
  },
  {
    "idx": 7043,
    "start": "03:17:45,458",
    "end": "03:17:46,598",
    "start_sec": 11865.458,
    "end_sec": 11866.598,
    "zh": "你看到的是什么",
    "vi": "Chú nhìn thấy cái gì vậy."
  },
  {
    "idx": 7044,
    "start": "03:17:46,598",
    "end": "03:17:48,298",
    "start_sec": 11866.598,
    "end_sec": 11868.298,
    "zh": "是",
    "vi": "Là."
  },
  {
    "idx": 7045,
    "start": "03:17:48,298",
    "end": "03:17:49,298",
    "start_sec": 11868.298,
    "end_sec": 11869.298,
    "zh": "是鬼异",
    "vi": "Là quỷ dị."
  },
  {
    "idx": 7046,
    "start": "03:17:49,298",
    "end": "03:17:50,798",
    "start_sec": 11869.298,
    "end_sec": 11870.798,
    "zh": "那辆车是鬼异",
    "vi": "Chiếc xe đó là quỷ dị."
  },
  {
    "idx": 7047,
    "start": "03:17:50,798",
    "end": "03:17:52,278",
    "start_sec": 11870.798,
    "end_sec": 11872.278,
    "zh": "在追杀那个小子",
    "vi": "Đang truy sát thằng nhóc đó."
  },
  {
    "idx": 7048,
    "start": "03:17:52,278",
    "end": "03:17:53,638",
    "start_sec": 11872.278,
    "end_sec": 11873.638,
    "zh": "但是有点奇怪",
    "vi": "Nhưng có chút kỳ lạ."
  },
  {
    "idx": 7049,
    "start": "03:17:53,638",
    "end": "03:17:56,938",
    "start_sec": 11873.638,
    "end_sec": 11876.938,
    "zh": "为什么那辆鬼车停在空中迟迟下不去",
    "vi": "Tại sao chiếc xe ma đó lại dừng trên không trung mãi không xuống được."
  },
  {
    "idx": 7050,
    "start": "03:17:56,938",
    "end": "03:17:58,278",
    "start_sec": 11876.938,
    "end_sec": 11878.278,
    "zh": "那小子",
    "vi": "Thằng nhóc đó."
  },
  {
    "idx": 7051,
    "start": "03:17:58,278",
    "end": "03:17:58,738",
    "start_sec": 11878.278,
    "end_sec": 11878.738,
    "zh": "不对",
    "vi": "Không đúng."
  },
  {
    "idx": 7052,
    "start": "03:17:58,738",
    "end": "03:18:00,158",
    "start_sec": 11878.738,
    "end_sec": 11880.158,
    "zh": "他是御鬼者",
    "vi": "Hắn là Ngự Quỷ Giả."
  },
  {
    "idx": 7053,
    "start": "03:18:00,158",
    "end": "03:18:02,658",
    "start_sec": 11880.158,
    "end_sec": 11882.658,
    "zh": "难怪在这地方他还能活下来",
    "vi": "Thảo nào hắn vẫn có thể sống sót ở nơi này."
  },
  {
    "idx": 7054,
    "start": "03:18:02,658",
    "end": "03:18:04,318",
    "start_sec": 11882.658,
    "end_sec": 11884.318,
    "zh": "野生的御鬼者吗",
    "vi": "Là Ngự Quỷ Giả tự do sao."
  },
  {
    "idx": 7055,
    "start": "03:18:04,318",
    "end": "03:18:05,578",
    "start_sec": 11884.318,
    "end_sec": 11885.578,
    "zh": "有点意思",
    "vi": "Thú vị đấy."
  },
  {
    "idx": 7056,
    "start": "03:18:05,578",
    "end": "03:18:08,598",
    "start_sec": 11885.578,
    "end_sec": 11888.598,
    "zh": "这家伙或许知道东来的行踪",
    "vi": "Tên này có lẽ biết tung tích của Đông Lai."
  },
  {
    "idx": 7057,
    "start": "03:18:08,598",
    "end": "03:18:09,398",
    "start_sec": 11888.598,
    "end_sec": 11889.398,
    "zh": "小海",
    "vi": "Tiểu Hải."
  },
  {
    "idx": 7058,
    "start": "03:18:09,398",
    "end": "03:18:10,758",
    "start_sec": 11889.398,
    "end_sec": 11890.758,
    "zh": "你能救下他吗",
    "vi": "Cháu có thể cứu hắn không."
  },
  {
    "idx": 7059,
    "start": "03:18:10,758",
    "end": "03:18:11,998",
    "start_sec": 11890.758,
    "end_sec": 11891.998,
    "zh": "放心吧徐库",
    "vi": "Chú Từ cứ yên tâm đi."
  },
  {
    "idx": 7060,
    "start": "03:18:11,998",
    "end": "03:18:12,738",
    "start_sec": 11891.998,
    "end_sec": 11892.738,
    "zh": "在水里",
    "vi": "Ở dưới nước."
  },
  {
    "idx": 7061,
    "start": "03:18:12,738",
    "end": "03:18:13,938",
    "start_sec": 11892.738,
    "end_sec": 11893.938,
    "zh": "我怎么可能回处",
    "vi": "Làm sao cháu có thể sơ suất được."
  },
  {
    "idx": 7062,
    "start": "03:18:13,938",
    "end": "03:18:14,838",
    "start_sec": 11893.938,
    "end_sec": 11894.838,
    "zh": "说完",
    "vi": "Nói xong."
  },
  {
    "idx": 7063,
    "start": "03:18:14,838",
    "end": "03:18:16,478",
    "start_sec": 11894.838,
    "end_sec": 11896.478,
    "zh": "年轻男子大手一挥",
    "vi": "chàng trai trẻ vung mạnh tay."
  },
  {
    "idx": 7064,
    "start": "03:18:16,478",
    "end": "03:18:17,778",
    "start_sec": 11896.478,
    "end_sec": 11897.778,
    "zh": "远处的水面上",
    "vi": "Trên mặt nước phía xa."
  },
  {
    "idx": 7065,
    "start": "03:18:17,778",
    "end": "03:18:19,138",
    "start_sec": 11897.778,
    "end_sec": 11899.138,
    "zh": "卷起了恐怖的气氛",
    "vi": "cuộn lên một luồng khí đáng sợ."
  },
  {
    "idx": 7066,
    "start": "03:18:19,138",
    "end": "03:18:21,198",
    "start_sec": 11899.138,
    "end_sec": 11901.198,
    "zh": "朝着半圈子的恶鬼巴之勇气",
    "vi": "lao về phía chiếc xe buýt đang bị ác quỷ bao vây."
  },
  {
    "idx": 7067,
    "start": "03:18:21,198",
    "end": "03:18:24,918",
    "start_sec": 11901.198,
    "end_sec": 11904.918,
    "zh": "那么即使巴士被水浪拍打到变形",
    "vi": "Nhưng dù chiếc xe buýt có bị sóng nước đánh cho biến dạng."
  },
  {
    "idx": 7068,
    "start": "03:18:24,918",
    "end": "03:18:26,858",
    "start_sec": 11904.918,
    "end_sec": 11906.858,
    "zh": "它依旧处死飞着长子皮",
    "vi": "Nó vẫn nhìn chằm chằm vào Trương Tử Bì."
  },
  {
    "idx": 7069,
    "start": "03:18:26,858",
    "end": "03:18:29,338",
    "start_sec": 11906.858,
    "end_sec": 11909.338,
    "zh": "仿佛不杀死长子皮就不会离开",
    "vi": "Giống như không giết được Trương Tử Bì thì sẽ không rời đi."
  },
  {
    "idx": 7070,
    "start": "03:18:29,338",
    "end": "03:18:30,278",
    "start_sec": 11909.338,
    "end_sec": 11910.278,
    "zh": "不对劲",
    "vi": "Không đúng lắm."
  },
  {
    "idx": 7071,
    "start": "03:18:30,278",
    "end": "03:18:31,798",
    "start_sec": 11910.278,
    "end_sec": 11911.798,
    "zh": "这玩意是龟子类鬼迷",
    "vi": "Thứ này là lệ quỷ hệ quy tắc."
  },
  {
    "idx": 7072,
    "start": "03:18:31,798",
    "end": "03:18:33,258",
    "start_sec": 11911.798,
    "end_sec": 11913.258,
    "zh": "即使受伤了也不打",
    "vi": "Dù có bị thương cũng không lùi bước."
  },
  {
    "idx": 7073,
    "start": "03:18:33,258",
    "end": "03:18:35,058",
    "start_sec": 11913.258,
    "end_sec": 11915.058,
    "zh": "徐叔不是我不想救他",
    "vi": "Chú Từ không phải cháu không muốn cứu hắn."
  },
  {
    "idx": 7074,
    "start": "03:18:35,058",
    "end": "03:18:36,018",
    "start_sec": 11915.058,
    "end_sec": 11916.018,
    "zh": "你也看到了",
    "vi": "Chú cũng thấy rồi đó."
  },
  {
    "idx": 7075,
    "start": "03:18:36,018",
    "end": "03:18:37,238",
    "start_sec": 11916.018,
    "end_sec": 11917.238,
    "zh": "这玩意只要驱逐走",
    "vi": "Thứ này nếu muốn đuổi đi."
  },
  {
    "idx": 7076,
    "start": "03:18:37,238",
    "end": "03:18:39,578",
    "start_sec": 11917.238,
    "end_sec": 11919.578,
    "zh": "估计我得拼上鬼迷复苏的代价",
    "vi": "Có lẽ cháu phải trả giá bằng việc lệ quỷ thức tỉnh."
  },
  {
    "idx": 7077,
    "start": "03:18:39,578",
    "end": "03:18:41,238",
    "start_sec": 11919.578,
    "end_sec": 11921.238,
    "zh": "行我知道了",
    "vi": "Được rồi chú biết rồi."
  },
  {
    "idx": 7078,
    "start": "03:18:41,238",
    "end": "03:18:44,098",
    "start_sec": 11921.238,
    "end_sec": 11924.098,
    "zh": "看来这家伙是命里该折在这里",
    "vi": "Xem ra số mạng tên này phải bỏ mạng ở đây rồi."
  },
  {
    "idx": 7079,
    "start": "03:18:44,098",
    "end": "03:18:45,538",
    "start_sec": 11924.098,
    "end_sec": 11925.538,
    "zh": "喂",
    "vi": "Này."
  },
  {
    "idx": 7080,
    "start": "03:18:45,538",
    "end": "03:18:46,698",
    "start_sec": 11925.538,
    "end_sec": 11926.698,
    "zh": "我说026",
    "vi": "Tôi nói này 026."
  },
  {
    "idx": 7081,
    "start": "03:18:46,698",
    "end": "03:18:48,558",
    "start_sec": 11926.698,
    "end_sec": 11928.558,
    "zh": "你刚刚用能力了吧",
    "vi": "Bạn vừa dùng năng lực đúng không."
  },
  {
    "idx": 7082,
    "start": "03:18:48,558",
    "end": "03:18:50,758",
    "start_sec": 11928.558,
    "end_sec": 11930.758,
    "zh": "怎么没事喜欢显摆啊",
    "vi": "Sao lúc nào cũng thích thể hiện thế."
  },
  {
    "idx": 7083,
    "start": "03:18:50,758",
    "end": "03:18:52,538",
    "start_sec": 11930.758,
    "end_sec": 11932.538,
    "zh": "023说你可能不信",
    "vi": "Số 023 này, nói ra có thể bạn không tin đâu."
  },
  {
    "idx": 7084,
    "start": "03:18:52,538",
    "end": "03:18:53,518",
    "start_sec": 11932.538,
    "end_sec": 11933.518,
    "zh": "前面的水域里",
    "vi": "Ở vùng nước phía trước."
  },
  {
    "idx": 7085,
    "start": "03:18:53,518",
    "end": "03:18:55,358",
    "start_sec": 11933.518,
    "end_sec": 11935.358,
    "zh": "有个家伙正顶着一辆巴士",
    "vi": "Có một tên đang đẩy một chiếc xe buýt."
  },
  {
    "idx": 7086,
    "start": "03:18:55,358",
    "end": "03:18:56,518",
    "start_sec": 11935.358,
    "end_sec": 11936.518,
    "zh": "朝我们这边来",
    "vi": "Đi về phía chúng ta."
  },
  {
    "idx": 7087,
    "start": "03:18:56,518",
    "end": "03:18:58,398",
    "start_sec": 11936.518,
    "end_sec": 11938.398,
    "zh": "你在逗我",
    "vi": "Bạn đang đùa tôi đấy à."
  },
  {
    "idx": 7088,
    "start": "03:18:58,398",
    "end": "03:19:01,598",
    "start_sec": 11938.398,
    "end_sec": 11941.598,
    "zh": "这家伙有点意思啊",
    "vi": "Tên này thú vị đấy chứ."
  },
  {
    "idx": 7089,
    "start": "03:19:01,598",
    "end": "03:19:03,038",
    "start_sec": 11941.598,
    "end_sec": 11943.038,
    "zh": "他应该也是遇鬼者",
    "vi": "Hắn chắc cũng là ngự quỷ giả."
  },
  {
    "idx": 7090,
    "start": "03:19:03,038",
    "end": "03:19:06,198",
    "start_sec": 11943.038,
    "end_sec": 11946.198,
    "zh": "只不过他也只能控制住那辆鬼巴士而已",
    "vi": "Chỉ là hắn cũng chỉ khống chế được chiếc xe buýt quỷ đó thôi."
  },
  {
    "idx": 7091,
    "start": "03:19:06,198",
    "end": "03:19:07,838",
    "start_sec": 11946.198,
    "end_sec": 11947.838,
    "zh": "能控制鬼域的遇鬼者",
    "vi": "Ngự quỷ giả có thể khống chế quỷ vực."
  },
  {
    "idx": 7092,
    "start": "03:19:07,838",
    "end": "03:19:08,698",
    "start_sec": 11947.838,
    "end_sec": 11948.698,
    "zh": "有点用心",
    "vi": "Cũng có chút bản lĩnh đấy."
  },
  {
    "idx": 7093,
    "start": "03:19:08,698",
    "end": "03:19:09,298",
    "start_sec": 11948.698,
    "end_sec": 11949.298,
    "zh": "怎么样",
    "vi": "Thế nào đây."
  },
  {
    "idx": 7094,
    "start": "03:19:09,298",
    "end": "03:19:10,858",
    "start_sec": 11949.298,
    "end_sec": 11950.858,
    "zh": "023救不救",
    "vi": "Số 023 này, có cứu không."
  },
  {
    "idx": 7095,
    "start": "03:19:10,858",
    "end": "03:19:12,158",
    "start_sec": 11950.858,
    "end_sec": 11952.158,
    "zh": "救个屁的救",
    "vi": "Cứu cái nỗi gì."
  },
  {
    "idx": 7096,
    "start": "03:19:12,158",
    "end": "03:19:14,538",
    "start_sec": 11952.158,
    "end_sec": 11954.538,
    "zh": "救他就意味着我们承担风险",
    "vi": "Cứu hắn đồng nghĩa với việc chúng ta phải chịu rủi ro."
  },
  {
    "idx": 7097,
    "start": "03:19:14,538",
    "end": "03:19:15,638",
    "start_sec": 11954.538,
    "end_sec": 11955.638,
    "zh": "给他推远点",
    "vi": "Đẩy hắn ra xa một chút đi."
  },
  {
    "idx": 7098,
    "start": "03:19:15,638",
    "end": "03:19:17,198",
    "start_sec": 11955.638,
    "end_sec": 11957.198,
    "zh": "带着我们的航线来",
    "vi": "Tránh xa đường đi của chúng ta ra."
  },
  {
    "idx": 7099,
    "start": "03:19:17,198",
    "end": "03:19:18,118",
    "start_sec": 11957.198,
    "end_sec": 11958.118,
    "zh": "不愧是你",
    "vi": "Đúng là phong cách của bạn."
  },
  {
    "idx": 7100,
    "start": "03:19:18,118",
    "end": "03:19:20,078",
    "start_sec": 11958.118,
    "end_sec": 11960.078,
    "zh": "023一切以认为的",
    "vi": "Số 023 luôn đặt lợi ích lên hàng đầu."
  },
  {
    "idx": 7101,
    "start": "03:19:20,078",
    "end": "03:19:21,198",
    "start_sec": 11960.078,
    "end_sec": 11961.198,
    "zh": "好好好",
    "vi": "Được rồi được rồi."
  },
  {
    "idx": 7102,
    "start": "03:19:21,198",
    "end": "03:19:21,798",
    "start_sec": 11961.198,
    "end_sec": 11961.798,
    "zh": "小子",
    "vi": "Này nhóc con."
  },
  {
    "idx": 7103,
    "start": "03:19:21,798",
    "end": "03:19:23,058",
    "start_sec": 11961.798,
    "end_sec": 11963.058,
    "zh": "滚原理",
    "vi": "Cút ra xa một chút đi."
  },
  {
    "idx": 7104,
    "start": "03:19:23,058",
    "end": "03:19:29,198",
    "start_sec": 11963.058,
    "end_sec": 11969.198,
    "zh": "草",
    "vi": "Khốn kiếp."
  },
  {
    "idx": 7105,
    "start": "03:19:29,198",
    "end": "03:19:30,018",
    "start_sec": 11969.198,
    "end_sec": 11970.018,
    "zh": "游轮上",
    "vi": "Trên du thuyền."
  },
  {
    "idx": 7106,
    "start": "03:19:30,018",
    "end": "03:19:31,778",
    "start_sec": 11970.018,
    "end_sec": 11971.778,
    "zh": "既然有能操控水的御鬼者",
    "vi": "Đã có ngự quỷ giả có thể điều khiển nước."
  },
  {
    "idx": 7107,
    "start": "03:19:31,778",
    "end": "03:19:32,958",
    "start_sec": 11971.778,
    "end_sec": 11972.958,
    "zh": "难怪要走水路",
    "vi": "Thảo nào họ lại chọn đi đường thủy."
  },
  {
    "idx": 7108,
    "start": "03:19:32,958",
    "end": "03:19:34,778",
    "start_sec": 11972.958,
    "end_sec": 11974.778,
    "zh": "小子",
    "vi": "Này nhóc con."
  },
  {
    "idx": 7109,
    "start": "03:19:34,778",
    "end": "03:19:35,778",
    "start_sec": 11974.778,
    "end_sec": 11975.778,
    "zh": "我就说嘛",
    "vi": "Tôi đã nói rồi mà."
  },
  {
    "idx": 7110,
    "start": "03:19:35,778",
    "end": "03:19:36,678",
    "start_sec": 11975.778,
    "end_sec": 11976.678,
    "zh": "你会死的",
    "vi": "Bạn sẽ chết đấy."
  },
  {
    "idx": 7111,
    "start": "03:19:36,678",
    "end": "03:19:39,538",
    "start_sec": 11976.678,
    "end_sec": 11979.538,
    "zh": "如果你能把那船上的那个御鬼者能力免疫",
    "vi": "Nếu bạn có thể miễn nhiễm với năng lực của người điều khiển quỷ trên thuyền đó"
  },
  {
    "idx": 7112,
    "start": "03:19:39,538",
    "end": "03:19:40,618",
    "start_sec": 11979.538,
    "end_sec": 11980.618,
    "zh": "成功上船",
    "vi": "thì lên thuyền thành công"
  },
  {
    "idx": 7113,
    "start": "03:19:40,618",
    "end": "03:19:41,178",
    "start_sec": 11980.618,
    "end_sec": 11981.178,
    "zh": "或许",
    "vi": "có lẽ"
  },
  {
    "idx": 7114,
    "start": "03:19:41,178",
    "end": "03:19:42,478",
    "start_sec": 11981.178,
    "end_sec": 11982.478,
    "zh": "你还有点生机",
    "vi": "bạn còn chút hy vọng sống"
  },
  {
    "idx": 7115,
    "start": "03:19:42,478",
    "end": "03:19:44,338",
    "start_sec": 11982.478,
    "end_sec": 11984.338,
    "zh": "游轮还有白明远",
    "vi": "Du thuyền còn có Bạch Minh Viễn"
  },
  {
    "idx": 7116,
    "start": "03:19:44,338",
    "end": "03:19:45,378",
    "start_sec": 11984.338,
    "end_sec": 11985.378,
    "zh": "我的鬼面窗",
    "vi": "Mặt nạ quỷ của tôi"
  },
  {
    "idx": 7117,
    "start": "03:19:45,378",
    "end": "03:19:46,738",
    "start_sec": 11985.378,
    "end_sec": 11986.738,
    "zh": "一次鬼疫都没吃过",
    "vi": "chưa từng bị dịch bệnh quỷ nào ảnh hưởng"
  },
  {
    "idx": 7118,
    "start": "03:19:46,738",
    "end": "03:19:47,478",
    "start_sec": 11986.738,
    "end_sec": 11987.478,
    "zh": "能力有限",
    "vi": "Năng lực có hạn"
  },
  {
    "idx": 7119,
    "start": "03:19:47,478",
    "end": "03:19:48,718",
    "start_sec": 11987.478,
    "end_sec": 11988.718,
    "zh": "想要无效化水浪",
    "vi": "Muốn vô hiệu hóa những đợt sóng nước"
  },
  {
    "idx": 7120,
    "start": "03:19:48,718",
    "end": "03:19:49,838",
    "start_sec": 11988.718,
    "end_sec": 11989.838,
    "zh": "简直吃人说梦",
    "vi": "thật là chuyện viển vông"
  },
  {
    "idx": 7121,
    "start": "03:19:49,838",
    "end": "03:19:52,138",
    "start_sec": 11989.838,
    "end_sec": 11992.138,
    "zh": "恶鬼巴士还在穷极不舍",
    "vi": "Xe buýt quỷ vẫn đang truy đuổi không ngừng"
  },
  {
    "idx": 7122,
    "start": "03:19:52,138",
    "end": "03:19:54,398",
    "start_sec": 11992.138,
    "end_sec": 11994.398,
    "zh": "脖子上的第二道鬼纹也消失了",
    "vi": "Vòng quỷ thứ hai trên cổ cũng biến mất rồi"
  },
  {
    "idx": 7123,
    "start": "03:19:54,398",
    "end": "03:19:55,878",
    "start_sec": 11994.398,
    "end_sec": 11995.878,
    "zh": "看来这次又是必死局",
    "vi": "Xem ra lần này lại là tình thế chắc chắn phải chết"
  },
  {
    "idx": 7124,
    "start": "03:19:55,878",
    "end": "03:19:58,398",
    "start_sec": 11995.878,
    "end_sec": 11998.398,
    "zh": "长子皮毫不犹豫的掏出手机",
    "vi": "Trưởng nam không chút do dự lấy điện thoại ra"
  },
  {
    "idx": 7125,
    "start": "03:19:58,398",
    "end": "03:19:59,898",
    "start_sec": 11998.398,
    "end_sec": 11999.898,
    "zh": "撕掉包裹手机的塑料袋",
    "vi": "Xé lớp ni lông bọc điện thoại"
  },
  {
    "idx": 7126,
    "start": "03:20:00,080",
    "end": "03:20:03,284",
    "start_sec": 12000.08,
    "end_sec": 12003.284,
    "zh": "过去的我,记住,在上恶鬼巴士后,除了投币之外,或许还有别的因素导致触发它的进行。",
    "vi": "Bản thân tôi trong quá khứ, hãy nhớ, sau khi lên xe buýt quỷ, ngoài việc trả"
  },
  {
    "idx": 7126,
    "start": "03:20:03,284",
    "end": "03:20:06,300",
    "start_sec": 12003.284,
    "end_sec": 12006.3,
    "zh": "过去的我,记住,在上恶鬼巴士后,除了投币之外,或许还有别的因素导致触发它的进行。",
    "vi": "tiền xu, có lẽ còn có những yếu tố khác dẫn đến việc kích hoạt nó."
  },
  {
    "idx": 7127,
    "start": "03:20:06,600",
    "end": "03:20:10,240",
    "start_sec": 12006.6,
    "end_sec": 12010.24,
    "zh": "我个人感觉,应该不是尊老爱友,请谨慎珍贝各种可能。",
    "vi": "Cá nhân tôi cảm thấy, hẳn không phải là tôn trọng người già yêu quý người trẻ, hãy cẩn thận xem xét mọi khả năng."
  },
  {
    "idx": 7128,
    "start": "03:20:10,760",
    "end": "03:20:16,300",
    "start_sec": 12010.76,
    "end_sec": 12016.3,
    "zh": "信息发送,板空中的巴士摇摇晃晃砸向城轨,它并没有攻击三个轨运车。",
    "vi": "Thông tin đã gửi, chiếc xe buýt trên không lắc lư lao về phía đường ray, nó không tấn công ba chiếc xe chở khách."
  },
  {
    "idx": 7129,
    "start": "03:20:16,640",
    "end": "03:20:19,560",
    "start_sec": 12016.64,
    "end_sec": 12019.56,
    "zh": "恶鬼巴士游轮续续,异大的轻轻的在压制。",
    "vi": "Xe buýt quỷ tiếp tục lao đi, áp lực rất lớn."
  },
  {
    "idx": 7130,
    "start": "03:20:21,000",
    "end": "03:20:25,240",
    "start_sec": 12021.0,
    "end_sec": 12025.24,
    "zh": "呵呵,一个御鬼者,连诡异复苏都还没开始,就这么死了。",
    "vi": "Hehe, một người điều khiển quỷ, còn chưa bắt đầu phục hồi kỳ dị mà đã chết như vậy rồi."
  },
  {
    "idx": 7131,
    "start": "03:20:25,540",
    "end": "03:20:27,380",
    "start_sec": 12025.54,
    "end_sec": 12027.38,
    "zh": "终究是不入流的野生御鬼者。",
    "vi": "Rốt cuộc cũng chỉ là một người điều khiển quỷ hoang dã tầm thường."
  },
  {
    "idx": 7132,
    "start": "03:20:30,000",
    "end": "03:20:33,200",
    "start_sec": 12030.0,
    "end_sec": 12033.2,
    "zh": "南河桥头站点回来了",
    "vi": "Trạm đầu cầu sông Nam đã quay trở lại"
  },
  {
    "idx": 7133,
    "start": "03:20:33,200",
    "end": "03:20:36,580",
    "start_sec": 12033.2,
    "end_sec": 12036.58,
    "zh": "七点还有两个小时",
    "vi": "Còn hai tiếng nữa mới đến bảy giờ"
  },
  {
    "idx": 7134,
    "start": "03:20:36,580",
    "end": "03:20:37,600",
    "start_sec": 12036.58,
    "end_sec": 12037.6,
    "zh": "自觉头闭",
    "vi": "Tự giác nhắm mắt lại"
  },
  {
    "idx": 7135,
    "start": "03:20:37,600",
    "end": "03:20:40,800",
    "start_sec": 12037.6,
    "end_sec": 12040.8,
    "zh": "尊老阿佑前上后下到底哪里出错了",
    "vi": "Tôn trọng người già yêu quý người trẻ, rốt cuộc đã sai ở đâu"
  },
  {
    "idx": 7136,
    "start": "03:20:40,800",
    "end": "03:20:42,080",
    "start_sec": 12040.8,
    "end_sec": 12042.08,
    "zh": "不管怎么样",
    "vi": "Dù sao đi nữa"
  },
  {
    "idx": 7137,
    "start": "03:20:42,080",
    "end": "03:20:44,260",
    "start_sec": 12042.08,
    "end_sec": 12044.26,
    "zh": "那个逆死鬼老父绝对有问题",
    "vi": "Ông già chết tiệt đó chắc chắn có vấn đề"
  },
  {
    "idx": 7138,
    "start": "03:20:44,260",
    "end": "03:20:45,480",
    "start_sec": 12044.26,
    "end_sec": 12045.48,
    "zh": "还是离开的好",
    "vi": "Tốt nhất là nên rời đi"
  },
  {
    "idx": 7139,
    "start": "03:20:45,480",
    "end": "03:20:48,420",
    "start_sec": 12045.48,
    "end_sec": 12048.42,
    "zh": "第一次我在桥中站点上的车就没遇到他",
    "vi": "Lần đầu tôi lên xe ở trạm giữa cầu đã không gặp ông ta"
  },
  {
    "idx": 7140,
    "start": "03:20:48,420",
    "end": "03:20:51,040",
    "start_sec": 12048.42,
    "end_sec": 12051.04,
    "zh": "反倒是第二次我在桥头站点上车",
    "vi": "Ngược lại, lần thứ hai tôi lên xe ở trạm đầu cầu"
  },
  {
    "idx": 7141,
    "start": "03:20:51,040",
    "end": "03:20:52,860",
    "start_sec": 12051.04,
    "end_sec": 12052.86,
    "zh": "车开到桥中的时候遇到了他",
    "vi": "Khi xe chạy đến giữa cầu thì gặp anh ta."
  },
  {
    "idx": 7142,
    "start": "03:20:52,860",
    "end": "03:20:55,620",
    "start_sec": 12052.86,
    "end_sec": 12055.62,
    "zh": "想着乘着提往桥中站点走去",
    "vi": "Tôi nghĩ bụng tranh thủ đi bộ về phía trạm dừng giữa cầu."
  },
  {
    "idx": 7143,
    "start": "03:20:55,620",
    "end": "03:20:57,220",
    "start_sec": 12055.62,
    "end_sec": 12057.22,
    "zh": "一直到九点",
    "vi": "Cho đến tận chín giờ."
  },
  {
    "idx": 7144,
    "start": "03:20:57,220",
    "end": "03:20:59,440",
    "start_sec": 12057.22,
    "end_sec": 12059.44,
    "zh": "恶鬼巴士再次从深山隧道",
    "vi": "Chiếc xe buýt ác quỷ lại từ đường hầm trong núi sâu."
  },
  {
    "idx": 7145,
    "start": "03:20:59,440",
    "end": "03:21:00,780",
    "start_sec": 12059.44,
    "end_sec": 12060.78,
    "zh": "开到长子皮身前",
    "vi": "Chạy đến trước mặt Trương Tử Bì."
  },
  {
    "idx": 7146,
    "start": "03:21:00,780",
    "end": "03:21:01,620",
    "start_sec": 12060.78,
    "end_sec": 12061.62,
    "zh": "上车",
    "vi": "Lên xe."
  },
  {
    "idx": 7147,
    "start": "03:21:01,620",
    "end": "03:21:02,460",
    "start_sec": 12061.62,
    "end_sec": 12062.46,
    "zh": "找硬币",
    "vi": "Tìm tiền xu."
  },
  {
    "idx": 7148,
    "start": "03:21:02,460",
    "end": "03:21:03,140",
    "start_sec": 12062.46,
    "end_sec": 12063.14,
    "zh": "投币",
    "vi": "Bỏ tiền vào khe."
  },
  {
    "idx": 7149,
    "start": "03:21:03,140",
    "end": "03:21:04,040",
    "start_sec": 12063.14,
    "end_sec": 12064.04,
    "zh": "一起合成",
    "vi": "Mọi việc diễn ra liền mạch."
  },
  {
    "idx": 7150,
    "start": "03:21:04,040",
    "end": "03:21:06,180",
    "start_sec": 12064.04,
    "end_sec": 12066.18,
    "zh": "长子皮走向后排座位",
    "vi": "Trương Tử Bì đi về phía hàng ghế sau."
  },
  {
    "idx": 7151,
    "start": "03:21:06,180",
    "end": "03:21:07,900",
    "start_sec": 12066.18,
    "end_sec": 12067.9,
    "zh": "路过老弱并残砖座后",
    "vi": "Sau khi đi qua hàng ghế ưu tiên."
  },
  {
    "idx": 7152,
    "start": "03:21:07,900",
    "end": "03:21:09,020",
    "start_sec": 12067.9,
    "end_sec": 12069.02,
    "zh": "眼角猛烈地说",
    "vi": "Khóe mắt anh ta giật mạnh."
  },
  {
    "idx": 7153,
    "start": "03:21:09,020",
    "end": "03:21:10,400",
    "start_sec": 12069.02,
    "end_sec": 12070.4,
    "zh": "这个逆子鬼",
    "vi": "Con quỷ nghịch tử này."
  },
  {
    "idx": 7154,
    "start": "03:21:10,400",
    "end": "03:21:11,740",
    "start_sec": 12070.4,
    "end_sec": 12071.74,
    "zh": "怎么已经上车了",
    "vi": "Sao đã lên xe rồi."
  },
  {
    "idx": 7155,
    "start": "03:21:11,740",
    "end": "03:21:14,240",
    "start_sec": 12071.74,
    "end_sec": 12074.24,
    "zh": "长子皮又谨慎走回后车门前",
    "vi": "Trương Tử Bì lại cẩn thận đi ngược về phía cửa sau."
  },
  {
    "idx": 7156,
    "start": "03:21:14,240",
    "end": "03:21:17,920",
    "start_sec": 12074.24,
    "end_sec": 12077.92,
    "zh": "好像他这次完全没有理会我",
    "vi": "Hình như lần này nó hoàn toàn không để ý đến tôi."
  },
  {
    "idx": 7157,
    "start": "03:21:17,920",
    "end": "03:21:19,920",
    "start_sec": 12077.92,
    "end_sec": 12079.92,
    "zh": "下一站",
    "vi": "Trạm tiếp theo."
  },
  {
    "idx": 7158,
    "start": "03:21:19,920",
    "end": "03:21:21,080",
    "start_sec": 12079.92,
    "end_sec": 12081.08,
    "zh": "南河桥尾",
    "vi": "Cuối cầu Nam Hà."
  },
  {
    "idx": 7159,
    "start": "03:21:21,080",
    "end": "03:21:22,980",
    "start_sec": 12081.08,
    "end_sec": 12082.98,
    "zh": "上车请自觉投币",
    "vi": "Lên xe xin tự giác bỏ tiền."
  },
  {
    "idx": 7160,
    "start": "03:21:22,980",
    "end": "03:21:24,020",
    "start_sec": 12082.98,
    "end_sec": 12084.02,
    "zh": "尊老爱幼",
    "vi": "Kính già yêu trẻ."
  },
  {
    "idx": 7161,
    "start": "03:21:24,020",
    "end": "03:21:25,240",
    "start_sec": 12084.02,
    "end_sec": 12085.24,
    "zh": "前上后下",
    "vi": "Lên cửa trước xuống cửa sau."
  },
  {
    "idx": 7162,
    "start": "03:21:25,240",
    "end": "03:21:26,260",
    "start_sec": 12085.24,
    "end_sec": 12086.26,
    "zh": "左文明人",
    "vi": "Làm người văn minh."
  },
  {
    "idx": 7163,
    "start": "03:21:26,260",
    "end": "03:21:28,080",
    "start_sec": 12086.26,
    "end_sec": 12088.08,
    "zh": "自觉投币肯定没问题",
    "vi": "Tự giác bỏ tiền chắc chắn không có vấn đề gì."
  },
  {
    "idx": 7164,
    "start": "03:21:28,080",
    "end": "03:21:28,900",
    "start_sec": 12088.08,
    "end_sec": 12088.9,
    "zh": "就老哎哟",
    "vi": "Còn kính già yêu trẻ."
  },
  {
    "idx": 7165,
    "start": "03:21:28,900",
    "end": "03:21:30,320",
    "start_sec": 12088.9,
    "end_sec": 12090.32,
    "zh": "那个老父没来找我了",
    "vi": "Ông lão đó không đến tìm tôi nữa."
  },
  {
    "idx": 7166,
    "start": "03:21:30,320",
    "end": "03:21:31,220",
    "start_sec": 12090.32,
    "end_sec": 12091.22,
    "zh": "应该也放不着",
    "vi": "Chắc là cũng không sao."
  },
  {
    "idx": 7167,
    "start": "03:21:31,220",
    "end": "03:21:33,080",
    "start_sec": 12091.22,
    "end_sec": 12093.08,
    "zh": "还有前上后下",
    "vi": "Còn có lên cửa trước xuống cửa sau."
  },
  {
    "idx": 7168,
    "start": "03:21:33,080",
    "end": "03:21:34,300",
    "start_sec": 12093.08,
    "end_sec": 12094.3,
    "zh": "前上后下",
    "vi": "Lên cửa trước xuống cửa sau."
  },
  {
    "idx": 7169,
    "start": "03:21:34,300",
    "end": "03:21:36,580",
    "start_sec": 12094.3,
    "end_sec": 12096.58,
    "zh": "我确实是从前门上的车",
    "vi": "Tôi đúng là đã lên xe từ cửa trước."
  },
  {
    "idx": 7170,
    "start": "03:21:36,580",
    "end": "03:21:38,680",
    "start_sec": 12096.58,
    "end_sec": 12098.68,
    "zh": "司机和投币处都在前门",
    "vi": "Tài xế và hộp bỏ tiền đều ở cửa trước."
  },
  {
    "idx": 7171,
    "start": "03:21:38,680",
    "end": "03:21:40,220",
    "start_sec": 12098.68,
    "end_sec": 12100.22,
    "zh": "但我似乎忽略了一个问题",
    "vi": "Nhưng dường như tôi đã bỏ qua một vấn đề."
  },
  {
    "idx": 7172,
    "start": "03:21:40,220",
    "end": "03:21:41,520",
    "start_sec": 12100.22,
    "end_sec": 12101.52,
    "zh": "这毕竟是辆鬼车",
    "vi": "Dù sao đây cũng là một chiếc xe ma."
  },
  {
    "idx": 7173,
    "start": "03:21:41,520",
    "end": "03:21:43,860",
    "start_sec": 12101.52,
    "end_sec": 12103.86,
    "zh": "鬼车的常理就是违背常理",
    "vi": "Lẽ thường của xe ma chính là đi ngược lại lẽ thường."
  },
  {
    "idx": 7174,
    "start": "03:21:43,860",
    "end": "03:21:44,1000",
    "start_sec": 12103.86,
    "end_sec": 12105.0,
    "zh": "就好比正常的硬币",
    "vi": "Giống như một đồng xu bình thường."
  },
  {
    "idx": 7175,
    "start": "03:21:44,1000",
    "end": "03:21:46,280",
    "start_sec": 12105.0,
    "end_sec": 12106.28,
    "zh": "不符合投币标准",
    "vi": "不符合投币标准"
  },
  {
    "idx": 7176,
    "start": "03:21:46,280",
    "end": "03:21:46,960",
    "start_sec": 12106.28,
    "end_sec": 12106.96,
    "zh": "就好比",
    "vi": "Cũng giống như việc."
  },
  {
    "idx": 7177,
    "start": "03:21:46,960",
    "end": "03:21:49,760",
    "start_sec": 12106.96,
    "end_sec": 12109.76,
    "zh": "我此时从车窗外看外面的路面是平整的",
    "vi": "Lúc này tôi nhìn qua cửa sổ thấy mặt đường bên ngoài rất bằng phẳng."
  },
  {
    "idx": 7178,
    "start": "03:21:49,760",
    "end": "03:21:51,200",
    "start_sec": 12109.76,
    "end_sec": 12111.2,
    "zh": "但从外面往车里看",
    "vi": "Nhưng nếu nhìn từ bên ngoài vào trong xe."
  },
  {
    "idx": 7179,
    "start": "03:21:51,200",
    "end": "03:21:51,980",
    "start_sec": 12111.2,
    "end_sec": 12111.98,
    "zh": "还是如此",
    "vi": "Thì vẫn như vậy."
  },
  {
    "idx": 7180,
    "start": "03:21:51,980",
    "end": "03:21:53,680",
    "start_sec": 12111.98,
    "end_sec": 12113.68,
    "zh": "长者提死过两次",
    "vi": "Trưởng Giả Đề từng chết hai lần."
  },
  {
    "idx": 7181,
    "start": "03:21:53,680",
    "end": "03:21:54,500",
    "start_sec": 12113.68,
    "end_sec": 12114.5,
    "zh": "但很清楚",
    "vi": "Nhưng rất rõ ràng."
  },
  {
    "idx": 7182,
    "start": "03:21:54,500",
    "end": "03:21:55,940",
    "start_sec": 12114.5,
    "end_sec": 12115.94,
    "zh": "每次巴士撞向的人",
    "vi": "Mỗi lần người bị xe buýt tông trúng."
  },
  {
    "idx": 7183,
    "start": "03:21:55,940",
    "end": "03:21:57,920",
    "start_sec": 12115.94,
    "end_sec": 12117.92,
    "zh": "从外面看都是飞转着的",
    "vi": "Nhìn từ bên ngoài đều bị văng xoay tròn."
  },
  {
    "idx": 7184,
    "start": "03:21:57,920",
    "end": "03:21:59,300",
    "start_sec": 12117.92,
    "end_sec": 12119.3,
    "zh": "车内却平静一场",
    "vi": "Nhưng bên trong xe lại vô cùng bình yên."
  },
  {
    "idx": 7185,
    "start": "03:21:59,300",
    "end": "03:22:00,240",
    "start_sec": 12119.3,
    "end_sec": 12120.24,
    "zh": "也就是说",
    "vi": "Nói cách cách khác."
  },
  {
    "idx": 7186,
    "start": "03:22:00,240",
    "end": "03:22:01,180",
    "start_sec": 12120.24,
    "end_sec": 12121.18,
    "zh": "车内车外",
    "vi": "Bên trong và bên ngoài xe."
  },
  {
    "idx": 7187,
    "start": "03:22:01,180",
    "end": "03:22:02,520",
    "start_sec": 12121.18,
    "end_sec": 12122.52,
    "zh": "所见一虚一实",
    "vi": "Những gì nhìn thấy là một ảo một thực."
  },
  {
    "idx": 7188,
    "start": "03:22:02,520",
    "end": "03:22:04,040",
    "start_sec": 12122.52,
    "end_sec": 12124.04,
    "zh": "车外看到的才是真",
    "vi": "Những gì nhìn thấy từ bên ngoài xe mới là thật."
  },
  {
    "idx": 7189,
    "start": "03:22:04,040",
    "end": "03:22:05,440",
    "start_sec": 12124.04,
    "end_sec": 12125.44,
    "zh": "那么我面前这道后门",
    "vi": "Vậy thì cánh cửa sau trước mặt tôi."
  },
  {
    "idx": 7190,
    "start": "03:22:05,440",
    "end": "03:22:06,880",
    "start_sec": 12125.44,
    "end_sec": 12126.88,
    "zh": "根本就不是真正的后门",
    "vi": "Hoàn toàn không phải là cánh cửa sau thực sự."
  },
  {
    "idx": 7191,
    "start": "03:22:06,880",
    "end": "03:22:08,060",
    "start_sec": 12126.88,
    "end_sec": 12128.06,
    "zh": "原来如此",
    "vi": "Hóa ra là như vậy."
  },
  {
    "idx": 7192,
    "start": "03:22:08,060",
    "end": "03:22:10,680",
    "start_sec": 12128.06,
    "end_sec": 12130.68,
    "zh": "眼看着车子即将开到南河桥尾",
    "vi": "Nhìn thấy chiếc xe sắp chạy đến cuối cầu Nam Hà."
  },
  {
    "idx": 7193,
    "start": "03:22:10,680",
    "end": "03:22:12,260",
    "start_sec": 12130.68,
    "end_sec": 12132.26,
    "zh": "车内又涌现出积水",
    "vi": "Nước tích tụ lại tràn ra trong xe."
  },
  {
    "idx": 7194,
    "start": "03:22:12,260",
    "end": "03:22:14,060",
    "start_sec": 12132.26,
    "end_sec": 12134.06,
    "zh": "程子皮赶紧取出手机",
    "vi": "Trình Tử Bì vội vàng lấy điện thoại ra."
  },
  {
    "idx": 7195,
    "start": "03:22:14,060",
    "end": "03:22:15,180",
    "start_sec": 12134.06,
    "end_sec": 12135.18,
    "zh": "联系过去的自己",
    "vi": "Liên lạc với chính mình trong quá khứ."
  },
  {
    "idx": 7196,
    "start": "03:22:15,180",
    "end": "03:22:16,120",
    "start_sec": 12135.18,
    "end_sec": 12136.12,
    "zh": "喂喂喂",
    "vi": "Alo alo alo."
  },
  {
    "idx": 7197,
    "start": "03:22:16,120",
    "end": "03:22:17,000",
    "start_sec": 12136.12,
    "end_sec": 12137.0,
    "zh": "江湖救急",
    "vi": "Cứu nguy khẩn cấp đây."
  },
  {
    "idx": 7198,
    "start": "03:22:17,000",
    "end": "03:22:19,340",
    "start_sec": 12137.0,
    "end_sec": 12139.34,
    "zh": "你在城间第一辆四路公交车里",
    "vi": "Bạn đang ở trong chiếc xe buýt số bốn đầu tiên của thành phố."
  },
  {
    "idx": 7199,
    "start": "03:22:19,340",
    "end": "03:22:20,200",
    "start_sec": 12139.34,
    "end_sec": 12140.2,
    "zh": "藏完硬币后",
    "vi": "Sau khi giấu xong đồng xu."
  },
  {
    "idx": 7200,
    "start": "03:22:20,200",
    "end": "03:22:20,880",
    "start_sec": 12140.2,
    "end_sec": 12140.88,
    "zh": "先别走",
    "vi": "Đừng đi vội."
  },
  {
    "idx": 7201,
    "start": "03:22:20,880",
    "end": "03:22:21,840",
    "start_sec": 12140.88,
    "end_sec": 12141.84,
    "zh": "你在车后门",
    "vi": "Bạn đang ở cửa sau xe buýt."
  },
  {
    "idx": 7202,
    "start": "03:22:21,840",
    "end": "03:22:23,700",
    "start_sec": 12141.84,
    "end_sec": 12143.7,
    "zh": "用玻璃胶贴一个三角符号",
    "vi": "Hãy dùng keo dán một ký hiệu hình tam giác."
  },
  {
    "idx": 7203,
    "start": "03:22:23,700",
    "end": "03:22:25,020",
    "start_sec": 12143.7,
    "end_sec": 12145.02,
    "zh": "一定要使车后门",
    "vi": "Phải dán ngay vào cửa sau xe."
  },
  {
    "idx": 7204,
    "start": "03:22:25,020",
    "end": "03:22:25,680",
    "start_sec": 12145.02,
    "end_sec": 12145.68,
    "zh": "速度",
    "vi": "Nhanh lên."
  },
  {
    "idx": 7205,
    "start": "03:22:25,680",
    "end": "03:22:26,760",
    "start_sec": 12145.68,
    "end_sec": 12146.76,
    "zh": "我操",
    "vi": "Chết tiệt thật."
  },
  {
    "idx": 7206,
    "start": "03:22:26,760",
    "end": "03:22:27,740",
    "start_sec": 12146.76,
    "end_sec": 12147.74,
    "zh": "刚扛完硬币",
    "vi": "Vừa giấu xong đồng xu."
  },
  {
    "idx": 7207,
    "start": "03:22:27,740",
    "end": "03:22:29,280",
    "start_sec": 12147.74,
    "end_sec": 12149.28,
    "zh": "就让我贴什么三角符号",
    "vi": "Đã bắt tôi dán cái ký hiệu tam giác gì chứ."
  },
  {
    "idx": 7208,
    "start": "03:22:29,280",
    "end": "03:22:31,400",
    "start_sec": 12149.28,
    "end_sec": 12151.4,
    "zh": "也没理会过去的自己说什么",
    "vi": "Cậu ta chẳng thèm nghe lời bản thân mình trước đó nói gì."
  },
  {
    "idx": 7209,
    "start": "03:22:31,400",
    "end": "03:22:33,740",
    "start_sec": 12151.4,
    "end_sec": 12153.74,
    "zh": "橙子皮在公交车后门摸索着",
    "vi": "Trần Tử Bì đang mò mẫm ở cửa sau xe buýt."
  },
  {
    "idx": 7210,
    "start": "03:22:33,740",
    "end": "03:22:35,860",
    "start_sec": 12153.74,
    "end_sec": 12155.86,
    "zh": "没有三角符号",
    "vi": "Chẳng có ký hiệu tam giác nào cả."
  },
  {
    "idx": 7211,
    "start": "03:22:35,860",
    "end": "03:22:36,420",
    "start_sec": 12155.86,
    "end_sec": 12156.42,
    "zh": "果然",
    "vi": "Quả nhiên là vậy."
  },
  {
    "idx": 7212,
    "start": "03:22:36,420",
    "end": "03:22:37,640",
    "start_sec": 12156.42,
    "end_sec": 12157.64,
    "zh": "这里不是后门",
    "vi": "Đây không phải là cửa sau."
  },
  {
    "idx": 7213,
    "start": "03:22:37,640",
    "end": "03:22:39,620",
    "start_sec": 12157.64,
    "end_sec": 12159.62,
    "zh": "我触犯了前上后下这个规则",
    "vi": "Tôi đã phạm quy tắc lên cửa trước xuống cửa sau rồi."
  },
  {
    "idx": 7214,
    "start": "03:22:39,620",
    "end": "03:22:41,100",
    "start_sec": 12159.62,
    "end_sec": 12161.1,
    "zh": "你贴了没有",
    "vi": "Bạn đã dán chưa đấy."
  },
  {
    "idx": 7215,
    "start": "03:22:41,100",
    "end": "03:22:42,860",
    "start_sec": 12161.1,
    "end_sec": 12162.86,
    "zh": "早贴完下车啊",
    "vi": "Dán xong thì mau xuống xe đi."
  },
  {
    "idx": 7216,
    "start": "03:22:42,860",
    "end": "03:22:44,500",
    "start_sec": 12162.86,
    "end_sec": 12164.5,
    "zh": "将手机放回口袋里",
    "vi": "Cất điện thoại vào túi."
  },
  {
    "idx": 7217,
    "start": "03:22:44,500",
    "end": "03:22:46,500",
    "start_sec": 12164.5,
    "end_sec": 12166.5,
    "zh": "橙子皮顺着后门开始摸索",
    "vi": "Trần Tử Bì bắt đầu mò mẫm dọc theo cửa sau."
  },
  {
    "idx": 7218,
    "start": "03:22:46,500",
    "end": "03:22:48,320",
    "start_sec": 12166.5,
    "end_sec": 12168.32,
    "zh": "寻找有三角符号的地方",
    "vi": "Tìm kiếm nơi có ký hiệu hình tam giác."
  },
  {
    "idx": 7219,
    "start": "03:22:48,320",
    "end": "03:22:50,300",
    "start_sec": 12168.32,
    "end_sec": 12170.3,
    "zh": "车内水滴声越来越密集",
    "vi": "Tiếng nước nhỏ giọt trong xe ngày càng dày đặc."
  },
  {
    "idx": 7220,
    "start": "03:22:50,300",
    "end": "03:22:52,440",
    "start_sec": 12170.3,
    "end_sec": 12172.44,
    "zh": "积水已经没过小磨剂的膜子",
    "vi": "Nước đọng đã ngập qua cả mắt cá chân."
  },
  {
    "idx": 7221,
    "start": "03:22:52,440",
    "end": "03:22:55,000",
    "start_sec": 12172.44,
    "end_sec": 12175.0,
    "zh": "橙子皮几乎将整个车厢摸了一遍",
    "vi": "Trần Tử Bì gần như đã sờ khắp cả toa xe."
  },
  {
    "idx": 7222,
    "start": "03:22:55,000",
    "end": "03:22:55,740",
    "start_sec": 12175.0,
    "end_sec": 12175.74,
    "zh": "也没找到",
    "vi": "Mà vẫn không tìm thấy."
  },
  {
    "idx": 7223,
    "start": "03:22:55,740",
    "end": "03:22:56,800",
    "start_sec": 12175.74,
    "end_sec": 12176.8,
    "zh": "不可能啊",
    "vi": "Không thể nào."
  },
  {
    "idx": 7224,
    "start": "03:22:56,800",
    "end": "03:22:58,140",
    "start_sec": 12176.8,
    "end_sec": 12178.14,
    "zh": "哪怕巴士被水泡过",
    "vi": "Dù xe buýt có bị ngâm trong nước."
  },
  {
    "idx": 7225,
    "start": "03:22:58,140",
    "end": "03:23:00,020",
    "start_sec": 12178.14,
    "end_sec": 12180.02,
    "zh": "交易也不会这么早就脱落呀",
    "vi": "Thì ký hiệu cũng không thể bong ra sớm thế được."
  },
  {
    "idx": 7226,
    "start": "03:23:00,020",
    "end": "03:23:02,280",
    "start_sec": 12180.02,
    "end_sec": 12182.28,
    "zh": "长子皮望着不断滴水的车顶",
    "vi": "Trần Tử Bì nhìn lên trần xe đang nhỏ nước không ngừng."
  },
  {
    "idx": 7227,
    "start": "03:23:02,280",
    "end": "03:23:03,320",
    "start_sec": 12182.28,
    "end_sec": 12183.32,
    "zh": "突然凝在过来",
    "vi": "Đột nhiên sững người lại."
  },
  {
    "idx": 7228,
    "start": "03:23:03,320",
    "end": "03:23:03,820",
    "start_sec": 12183.32,
    "end_sec": 12183.82,
    "zh": "是啊",
    "vi": "Đúng rồi."
  },
  {
    "idx": 7229,
    "start": "03:23:03,820",
    "end": "03:23:05,480",
    "start_sec": 12183.82,
    "end_sec": 12185.48,
    "zh": "车顶怎么会深水呢",
    "vi": "Tại sao trần xe lại có nước chảy xuống."
  },
  {
    "idx": 7230,
    "start": "03:23:05,480",
    "end": "03:23:06,560",
    "start_sec": 12185.48,
    "end_sec": 12186.56,
    "zh": "车子落水后",
    "vi": "Sau khi xe rơi xuống nước."
  },
  {
    "idx": 7231,
    "start": "03:23:06,560",
    "end": "03:23:08,700",
    "start_sec": 12186.56,
    "end_sec": 12188.7,
    "zh": "最先深水的肯定是车窗啊",
    "vi": "Nơi nước tràn vào đầu tiên chắc chắn là cửa sổ xe."
  },
  {
    "idx": 7232,
    "start": "03:23:08,700",
    "end": "03:23:10,360",
    "start_sec": 12188.7,
    "end_sec": 12190.36,
    "zh": "车窗和车门是连在一起的",
    "vi": "Cửa sổ và cửa xe được kết nối với nhau."
  },
  {
    "idx": 7233,
    "start": "03:23:10,360",
    "end": "03:23:10,980",
    "start_sec": 12190.36,
    "end_sec": 12190.98,
    "zh": "这么说",
    "vi": "Nói như vậy."
  },
  {
    "idx": 7234,
    "start": "03:23:10,980",
    "end": "03:23:13,320",
    "start_sec": 12190.98,
    "end_sec": 12193.32,
    "zh": "后门应该是在我现在的头顶开始",
    "vi": "Cửa sau đáng lẽ phải bắt đầu từ ngay trên đầu tôi lúc này."
  },
  {
    "idx": 7235,
    "start": "03:23:13,320",
    "end": "03:23:15,880",
    "start_sec": 12193.32,
    "end_sec": 12195.88,
    "zh": "长子皮神经似的在车顶上",
    "vi": "Trần Tử Bì như phát điên sờ soạng trên trần xe."
  },
  {
    "idx": 7236,
    "start": "03:23:15,880",
    "end": "03:23:17,940",
    "start_sec": 12195.88,
    "end_sec": 12197.94,
    "zh": "但没触犯恶鬼巴士的规则",
    "vi": "Nhưng không vi phạm quy tắc của xe buýt ác quỷ."
  },
  {
    "idx": 7237,
    "start": "03:23:17,940",
    "end": "03:23:18,960",
    "start_sec": 12197.94,
    "end_sec": 12198.96,
    "zh": "也没人理会",
    "vi": "Cũng không có ai để ý."
  },
  {
    "idx": 7238,
    "start": "03:23:18,960",
    "end": "03:23:21,140",
    "start_sec": 12198.96,
    "end_sec": 12201.14,
    "zh": "南河桥尾到了",
    "vi": "Đã đến đuôi cầu Nam Hà."
  },
  {
    "idx": 7239,
    "start": "03:23:21,140",
    "end": "03:23:22,800",
    "start_sec": 12201.14,
    "end_sec": 12202.8,
    "zh": "南河桥尾到了",
    "vi": "Đã đến đuôi cầu Nam Hà."
  },
  {
    "idx": 7240,
    "start": "03:23:22,800",
    "end": "03:23:24,340",
    "start_sec": 12202.8,
    "end_sec": 12204.34,
    "zh": "语音播报声响起",
    "vi": "Tiếng loa thông báo vang lên."
  },
  {
    "idx": 7241,
    "start": "03:23:24,340",
    "end": "03:23:25,720",
    "start_sec": 12204.34,
    "end_sec": 12205.72,
    "zh": "橙子皮越来越急",
    "vi": "Trần Tử Bì ngày càng vội vã."
  },
  {
    "idx": 7242,
    "start": "03:23:25,720",
    "end": "03:23:28,820",
    "start_sec": 12205.72,
    "end_sec": 12208.82,
    "zh": "终于在车后座位顶上摸到三角小椅",
    "vi": "Cuối cùng cũng sờ thấy tay nắm hình tam giác trên trần ghế sau."
  },
  {
    "idx": 7243,
    "start": "03:23:28,820",
    "end": "03:23:29,840",
    "start_sec": 12208.82,
    "end_sec": 12209.84,
    "zh": "就是这里",
    "vi": "Chính là chỗ này."
  },
  {
    "idx": 7244,
    "start": "03:23:29,840",
    "end": "03:23:31,080",
    "start_sec": 12209.84,
    "end_sec": 12211.08,
    "zh": "司机下车",
    "vi": "Bác tài cho xuống xe."
  },
  {
    "idx": 7245,
    "start": "03:23:31,080",
    "end": "03:23:32,040",
    "start_sec": 12211.08,
    "end_sec": 12212.04,
    "zh": "我要下车",
    "vi": "Tôi muốn xuống xe."
  },
  {
    "idx": 7246,
    "start": "03:23:32,040",
    "end": "03:23:33,720",
    "start_sec": 12212.04,
    "end_sec": 12213.72,
    "zh": "明明是速发的车顶",
    "vi": "Rõ ràng là trần xe dựng đứng."
  },
  {
    "idx": 7247,
    "start": "03:23:33,720",
    "end": "03:23:35,100",
    "start_sec": 12213.72,
    "end_sec": 12215.1,
    "zh": "竟诡异的折叠下",
    "vi": "Lại gập xuống một cách kỳ dị."
  },
  {
    "idx": 7248,
    "start": "03:23:35,100",
    "end": "03:23:36,300",
    "start_sec": 12215.1,
    "end_sec": 12216.3,
    "zh": "橙子皮过不来",
    "vi": "Trần Tử Bì không màng đến chuyện khác."
  },
  {
    "idx": 7249,
    "start": "03:23:36,300",
    "end": "03:23:39,180",
    "start_sec": 12216.3,
    "end_sec": 12219.18,
    "zh": "而且座位上还坐着一个三十来岁的姑娘",
    "vi": "Hơn nữa trên ghế vẫn còn một cô gái tầm ba mươi tuổi đang ngồi."
  },
  {
    "idx": 7250,
    "start": "03:23:39,180",
    "end": "03:23:40,900",
    "start_sec": 12219.18,
    "end_sec": 12220.9,
    "zh": "仰着既定的三条规矩",
    "vi": "Bất chấp ba quy tắc đã định."
  },
  {
    "idx": 7251,
    "start": "03:23:40,900",
    "end": "03:23:42,240",
    "start_sec": 12220.9,
    "end_sec": 12222.24,
    "zh": "橙子皮踩着门",
    "vi": "Trần Tử Bì giẫm lên cửa."
  },
  {
    "idx": 7252,
    "start": "03:23:42,240",
    "end": "03:23:43,340",
    "start_sec": 12222.24,
    "end_sec": 12223.34,
    "zh": "纵身掐开",
    "vi": "Nhảy vọt ra ngoài."
  },
  {
    "idx": 7253,
    "start": "03:23:43,340",
    "end": "03:23:45,240",
    "start_sec": 12223.34,
    "end_sec": 12225.24,
    "zh": "如橙子皮推断力量",
    "vi": "Đúng như Trần Tử Bì suy đoán."
  },
  {
    "idx": 7254,
    "start": "03:23:45,240",
    "end": "03:23:46,420",
    "start_sec": 12225.24,
    "end_sec": 12226.42,
    "zh": "车顶就是后门",
    "vi": "Trần xe chính là cửa sau."
  },
  {
    "idx": 7255,
    "start": "03:23:46,420",
    "end": "03:23:47,960",
    "start_sec": 12226.42,
    "end_sec": 12227.96,
    "zh": "巴士也是旋转的情况",
    "vi": "Chiếc xe buýt cũng đang trong tình trạng bị lật xoay."
  },
  {
    "idx": 7256,
    "start": "03:23:47,960",
    "end": "03:23:48,980",
    "start_sec": 12227.96,
    "end_sec": 12228.98,
    "zh": "好",
    "vi": "Tốt rồi."
  },
  {
    "idx": 7257,
    "start": "03:23:48,980",
    "end": "03:23:50,880",
    "start_sec": 12228.98,
    "end_sec": 12230.88,
    "zh": "至此总算结束了吧",
    "vi": "Đến đây thì mọi chuyện cuối cùng cũng kết thúc rồi."
  },
  {
    "idx": 7258,
    "start": "03:23:50,880",
    "end": "03:23:51,660",
    "start_sec": 12230.88,
    "end_sec": 12231.66,
    "zh": "然而",
    "vi": "Thế nhưng."
  },
  {
    "idx": 7259,
    "start": "03:23:51,660",
    "end": "03:23:53,420",
    "start_sec": 12231.66,
    "end_sec": 12233.42,
    "zh": "让橙子皮没想到的是",
    "vi": "Điều Trần Tử Bì không ngờ tới là."
  },
  {
    "idx": 7260,
    "start": "03:23:53,420",
    "end": "03:23:55,320",
    "start_sec": 12233.42,
    "end_sec": 12235.32,
    "zh": "司机一剪一片的看过来",
    "vi": "Tài xế quay lại nhìn một cách lạnh lẽo."
  },
  {
    "idx": 7261,
    "start": "03:23:55,320",
    "end": "03:23:56,460",
    "start_sec": 12235.32,
    "end_sec": 12236.46,
    "zh": "你这个烂人",
    "vi": "Đồ tồi tệ"
  },
  {
    "idx": 7262,
    "start": "03:23:56,460",
    "end": "03:23:58,400",
    "start_sec": 12236.46,
    "end_sec": 12238.4,
    "zh": "毫无素质",
    "vi": "Vô văn hóa"
  },
  {
    "idx": 7263,
    "start": "03:23:58,400",
    "end": "03:24:00,100",
    "start_sec": 12238.4,
    "end_sec": 12240.1,
    "zh": "你这个烂人",
    "vi": "Đồ tồi tệ"
  },
  {
    "idx": 7264,
    "start": "03:24:00,100",
    "end": "03:24:01,220",
    "start_sec": 12240.1,
    "end_sec": 12241.22,
    "zh": "毫无素质",
    "vi": "Vô văn hóa"
  },
  {
    "idx": 7265,
    "start": "03:24:01,220",
    "end": "03:24:02,360",
    "start_sec": 12241.22,
    "end_sec": 12242.36,
    "zh": "怎么回事",
    "vi": "Có chuyện gì vậy"
  },
  {
    "idx": 7266,
    "start": "03:24:02,360",
    "end": "03:24:04,080",
    "start_sec": 12242.36,
    "end_sec": 12244.08,
    "zh": "为什么司机这次更生气了",
    "vi": "Sao tài xế lần này lại tức giận hơn"
  },
  {
    "idx": 7267,
    "start": "03:24:04,080",
    "end": "03:24:05,180",
    "start_sec": 12244.08,
    "end_sec": 12245.18,
    "zh": "到底犯了什么忌讳",
    "vi": "Đã phạm phải điều cấm kỵ gì vậy"
  },
  {
    "idx": 7268,
    "start": "03:24:05,180",
    "end": "03:24:06,060",
    "start_sec": 12245.18,
    "end_sec": 12246.06,
    "zh": "烂人",
    "vi": "Đồ tồi"
  },
  {
    "idx": 7269,
    "start": "03:24:06,060",
    "end": "03:24:07,520",
    "start_sec": 12246.06,
    "end_sec": 12247.52,
    "zh": "这种人就该死",
    "vi": "Những kẻ như vậy đáng chết"
  },
  {
    "idx": 7270,
    "start": "03:24:07,520",
    "end": "03:24:08,740",
    "start_sec": 12247.52,
    "end_sec": 12248.74,
    "zh": "撞死看",
    "vi": "Chết dưới bánh xe"
  },
  {
    "idx": 7271,
    "start": "03:24:08,740",
    "end": "03:24:09,640",
    "start_sec": 12248.74,
    "end_sec": 12249.64,
    "zh": "撞死看",
    "vi": "Chết dưới bánh xe"
  },
  {
    "idx": 7272,
    "start": "03:24:09,640",
    "end": "03:24:11,740",
    "start_sec": 12249.64,
    "end_sec": 12251.74,
    "zh": "巨大的车身撞向橙子皮",
    "vi": "Thân xe khổng lồ lao về phía Trần Tử Bì"
  },
  {
    "idx": 7273,
    "start": "03:24:11,740",
    "end": "03:24:12,960",
    "start_sec": 12251.74,
    "end_sec": 12252.96,
    "zh": "这次他没有躲避",
    "vi": "Lần này anh ta không né"
  },
  {
    "idx": 7274,
    "start": "03:24:12,960",
    "end": "03:24:14,120",
    "start_sec": 12252.96,
    "end_sec": 12254.12,
    "zh": "重开",
    "vi": "Chơi lại"
  },
  {
    "idx": 7275,
    "start": "03:24:14,120",
    "end": "03:24:16,180",
    "start_sec": 12254.12,
    "end_sec": 12256.18,
    "zh": "看着迎面撞来的六回八式",
    "vi": "Nhìn chiếc xe lao tới"
  },
  {
    "idx": 7276,
    "start": "03:24:16,180",
    "end": "03:24:17,420",
    "start_sec": 12256.18,
    "end_sec": 12257.42,
    "zh": "橙子皮闭上眼",
    "vi": "Trần Tử Bì nhắm mắt lại"
  },
  {
    "idx": 7277,
    "start": "03:24:17,420",
    "end": "03:24:18,620",
    "start_sec": 12257.42,
    "end_sec": 12258.62,
    "zh": "说不出的平静",
    "vi": "Bình tĩnh đến lạ"
  },
  {
    "idx": 7278,
    "start": "03:24:21,620",
    "end": "03:24:23,180",
    "start_sec": 12261.62,
    "end_sec": 12263.18,
    "zh": "到底哪个环节出问题了",
    "vi": "Rốt cuộc là sai ở khâu nào"
  },
  {
    "idx": 7279,
    "start": "03:24:23,180",
    "end": "03:24:24,440",
    "start_sec": 12263.18,
    "end_sec": 12264.44,
    "zh": "三个规则",
    "vi": "Ba quy tắc"
  },
  {
    "idx": 7280,
    "start": "03:24:24,440",
    "end": "03:24:25,940",
    "start_sec": 12264.44,
    "end_sec": 12265.94,
    "zh": "我已经完全遵守",
    "vi": "Tôi đã tuân thủ hoàn toàn"
  },
  {
    "idx": 7281,
    "start": "03:24:25,940",
    "end": "03:24:27,560",
    "start_sec": 12265.94,
    "end_sec": 12267.56,
    "zh": "要说最可能出错的地方",
    "vi": "Nếu nói nơi dễ sai nhất"
  },
  {
    "idx": 7282,
    "start": "03:24:27,560",
    "end": "03:24:29,160",
    "start_sec": 12267.56,
    "end_sec": 12269.16,
    "zh": "就是后面踩的那个妇女",
    "vi": "Chắc là người phụ nữ đạp lên lúc nãy"
  },
  {
    "idx": 7283,
    "start": "03:24:29,160",
    "end": "03:24:30,480",
    "start_sec": 12269.16,
    "end_sec": 12270.48,
    "zh": "但妇女不是老人",
    "vi": "Nhưng người phụ nữ không phải người già"
  },
  {
    "idx": 7284,
    "start": "03:24:30,480",
    "end": "03:24:31,400",
    "start_sec": 12270.48,
    "end_sec": 12271.4,
    "zh": "也不是小孩",
    "vi": "Cũng không phải trẻ con"
  },
  {
    "idx": 7285,
    "start": "03:24:31,400",
    "end": "03:24:33,140",
    "start_sec": 12271.4,
    "end_sec": 12273.14,
    "zh": "并不违反尊老爱幼吧",
    "vi": "Không vi phạm tôn trọng người già yêu trẻ em chứ"
  },
  {
    "idx": 7286,
    "start": "03:24:33,140",
    "end": "03:24:33,540",
    "start_sec": 12273.14,
    "end_sec": 12273.54,
    "zh": "而且",
    "vi": "Hơn nữa"
  },
  {
    "idx": 7287,
    "start": "03:24:33,540",
    "end": "03:24:34,700",
    "start_sec": 12273.54,
    "end_sec": 12274.7,
    "zh": "不踩那个座位",
    "vi": "Nếu không đạp lên ghế đó"
  },
  {
    "idx": 7288,
    "start": "03:24:34,700",
    "end": "03:24:36,180",
    "start_sec": 12274.7,
    "end_sec": 12276.18,
    "zh": "我也爬不出去啊",
    "vi": "Tôi cũng không leo ra ngoài được"
  },
  {
    "idx": 7289,
    "start": "03:24:36,180",
    "end": "03:24:36,800",
    "start_sec": 12276.18,
    "end_sec": 12276.8,
    "zh": "难不成我",
    "vi": "Chẳng lẽ tôi"
  },
  {
    "idx": 7290,
    "start": "03:24:36,800",
    "end": "03:24:37,960",
    "start_sec": 12276.8,
    "end_sec": 12277.96,
    "zh": "还能跟鬼打个商量",
    "vi": "Còn có thể thương lượng với ma"
  },
  {
    "idx": 7291,
    "start": "03:24:37,960",
    "end": "03:24:39,340",
    "start_sec": 12277.96,
    "end_sec": 12279.34,
    "zh": "让她换个座位",
    "vi": "Bảo cô ta đổi chỗ đi"
  },
  {
    "idx": 7292,
    "start": "03:24:39,340",
    "end": "03:24:40,360",
    "start_sec": 12279.34,
    "end_sec": 12280.36,
    "zh": "上车后",
    "vi": "Sau khi lên xe"
  },
  {
    "idx": 7293,
    "start": "03:24:40,360",
    "end": "03:24:42,880",
    "start_sec": 12280.36,
    "end_sec": 12282.88,
    "zh": "橙子皮竟直走向三角标记的后门",
    "vi": "Trái Cam lại đi thẳng đến cửa sau có ký hiệu hình tam giác"
  },
  {
    "idx": 7294,
    "start": "03:24:42,880",
    "end": "03:24:44,320",
    "start_sec": 12282.88,
    "end_sec": 12284.32,
    "zh": "她盯着后排那个妇女",
    "vi": "Cô ta nhìn chằm chằm người phụ nữ ở hàng ghế sau"
  },
  {
    "idx": 7295,
    "start": "03:24:44,320",
    "end": "03:24:45,360",
    "start_sec": 12284.32,
    "end_sec": 12285.36,
    "zh": "眼睛都打了一样",
    "vi": "Mắt cô ta như muốn lồi ra"
  },
  {
    "idx": 7296,
    "start": "03:24:45,360",
    "end": "03:24:46,600",
    "start_sec": 12285.36,
    "end_sec": 12286.6,
    "zh": "原来如此",
    "vi": "Thì ra là vậy"
  },
  {
    "idx": 7297,
    "start": "03:24:46,600",
    "end": "03:24:47,740",
    "start_sec": 12286.6,
    "end_sec": 12287.74,
    "zh": "这妇女",
    "vi": "Người phụ nữ này"
  },
  {
    "idx": 7298,
    "start": "03:24:47,740",
    "end": "03:24:48,780",
    "start_sec": 12287.74,
    "end_sec": 12288.78,
    "zh": "是个孕妇",
    "vi": "Là một bà bầu"
  },
  {
    "idx": 7299,
    "start": "03:24:48,780",
    "end": "03:24:49,780",
    "start_sec": 12288.78,
    "end_sec": 12289.78,
    "zh": "该死",
    "vi": "Chết tiệt"
  },
  {
    "idx": 7300,
    "start": "03:24:49,780",
    "end": "03:24:50,920",
    "start_sec": 12289.78,
    "end_sec": 12290.92,
    "zh": "这个恶鬼八世",
    "vi": "Con quỷ cái tám đời này"
  },
  {
    "idx": 7301,
    "start": "03:24:50,920",
    "end": "03:24:51,980",
    "start_sec": 12290.92,
    "end_sec": 12291.98,
    "zh": "居然将车后门",
    "vi": "Lại đặt cửa sau xe"
  },
  {
    "idx": 7302,
    "start": "03:24:51,980",
    "end": "03:24:53,360",
    "start_sec": 12291.98,
    "end_sec": 12293.36,
    "zh": "放在孕妇座的顶上",
    "vi": "Ngay trên chỗ của bà bầu"
  },
  {
    "idx": 7303,
    "start": "03:24:53,360",
    "end": "03:24:54,780",
    "start_sec": 12293.36,
    "end_sec": 12294.78,
    "zh": "即使我做到滴水不漏",
    "vi": "Dù tôi có cẩn thận đến đâu"
  },
  {
    "idx": 7304,
    "start": "03:24:54,780",
    "end": "03:24:59,085",
    "start_sec": 12294.78,
    "end_sec": 12299.085,
    "zh": "最后还是避免不了处方规则从一开始就是个死局我总不可能让一个孕妇给我让座吧默默看着怀孕的妇女长子皮想着到底该如何破局",
    "vi": "Cuối cùng vẫn không tránh khỏi quy tắc của đơn thuốc, ngay từ đầu đã là một thế cờ chết"
  },
  {
    "idx": 7304,
    "start": "03:24:59,085",
    "end": "03:25:01,883",
    "start_sec": 12299.085,
    "end_sec": 12301.883,
    "zh": "最后还是避免不了处方规则从一开始就是个死局我总不可能让一个孕妇给我让座吧默默看着怀孕的妇女长子皮想着到底该如何破局",
    "vi": "Tôi không thể nào bắt một bà bầu nhường chỗ cho tôi được"
  },
  {
    "idx": 7304,
    "start": "03:25:01,883",
    "end": "03:25:05,757",
    "start_sec": 12301.883,
    "end_sec": 12305.757,
    "zh": "最后还是避免不了处方规则从一开始就是个死局我总不可能让一个孕妇给我让座吧默默看着怀孕的妇女长子皮想着到底该如何破局",
    "vi": "Trái Cam nhìn bà bầu đang mang thai, suy nghĩ làm sao để phá vỡ thế cờ này"
  },
  {
    "idx": 7305,
    "start": "03:25:05,757",
    "end": "03:25:08,557",
    "start_sec": 12305.757,
    "end_sec": 12308.557,
    "zh": "突然她看向了爱心座上的逆死鬼老妇",
    "vi": "Đột nhiên cô ta nhìn về phía bà lão đang ngồi ở ghế ưu tiên"
  },
  {
    "idx": 7306,
    "start": "03:25:08,557",
    "end": "03:25:10,237",
    "start_sec": 12308.557,
    "end_sec": 12310.237,
    "zh": "如果是这个逆死鬼下车",
    "vi": "Nếu như bà lão này xuống xe"
  },
  {
    "idx": 7307,
    "start": "03:25:10,237",
    "end": "03:25:12,737",
    "start_sec": 12310.237,
    "end_sec": 12312.737,
    "zh": "是不是也要遵循恶鬼巴士的规则呢",
    "vi": "Có phải cũng phải tuân theo quy tắc của xe buýt quỷ không nhỉ"
  },
  {
    "idx": 7308,
    "start": "03:25:12,737",
    "end": "03:25:13,457",
    "start_sec": 12312.737,
    "end_sec": 12313.457,
    "zh": "这样的话",
    "vi": "Nếu vậy thì"
  },
  {
    "idx": 7309,
    "start": "03:25:13,457",
    "end": "03:25:15,257",
    "start_sec": 12313.457,
    "end_sec": 12315.257,
    "zh": "让她去和那个孕妇换位置",
    "vi": "Bảo bà ta đổi chỗ với bà bầu kia"
  },
  {
    "idx": 7310,
    "start": "03:25:15,257",
    "end": "03:25:16,857",
    "start_sec": 12315.257,
    "end_sec": 12316.857,
    "zh": "让我从正确的后门下车",
    "vi": "Để tôi xuống xe từ cửa sau đúng quy định"
  },
  {
    "idx": 7311,
    "start": "03:25:16,857",
    "end": "03:25:18,037",
    "start_sec": 12316.857,
    "end_sec": 12318.037,
    "zh": "可行性很高",
    "vi": "Khả năng thành công rất cao"
  },
  {
    "idx": 7312,
    "start": "03:25:18,037",
    "end": "03:25:19,737",
    "start_sec": 12318.037,
    "end_sec": 12319.737,
    "zh": "长子皮看着老妇",
    "vi": "Trái Cam nhìn bà lão"
  },
  {
    "idx": 7313,
    "start": "03:25:19,737",
    "end": "03:25:21,237",
    "start_sec": 12319.737,
    "end_sec": 12321.237,
    "zh": "给一脚过自己的羊皮",
    "vi": "Đá một cái vào người bà ta"
  },
  {
    "idx": 7314,
    "start": "03:25:21,237",
    "end": "03:25:25,017",
    "start_sec": 12321.237,
    "end_sec": 12325.017,
    "zh": "你跟我下车",
    "vi": "Bà ơi, bà đi xuống xe với tôi"
  },
  {
    "idx": 7315,
    "start": "03:25:25,017",
    "end": "03:25:26,677",
    "start_sec": 12325.017,
    "end_sec": 12326.677,
    "zh": "干嘛",
    "vi": "Đi làm gì vậy"
  },
  {
    "idx": 7316,
    "start": "03:25:26,677",
    "end": "03:25:28,997",
    "start_sec": 12326.677,
    "end_sec": 12328.997,
    "zh": "你刚刚在站点偷了我的钱包",
    "vi": "Lúc nãy bà đã ăn cắp ví của tôi ở trạm xe"
  },
  {
    "idx": 7317,
    "start": "03:25:28,997",
    "end": "03:25:30,057",
    "start_sec": 12328.997,
    "end_sec": 12330.057,
    "zh": "你以为我不知道",
    "vi": "Bà tưởng tôi không biết sao"
  },
  {
    "idx": 7318,
    "start": "03:25:30,057",
    "end": "03:25:32,957",
    "start_sec": 12330.057,
    "end_sec": 12332.957,
    "zh": "我特意跑到这个站点来提前拦住你",
    "vi": "Tôi cố tình chạy đến trạm này để chặn bà lại trước"
  },
  {
    "idx": 7319,
    "start": "03:25:32,957",
    "end": "03:25:34,297",
    "start_sec": 12332.957,
    "end_sec": 12334.297,
    "zh": "老夫人闻声一声",
    "vi": "Bà lão nghe vậy thì sững người"
  },
  {
    "idx": 7320,
    "start": "03:25:34,297",
    "end": "03:25:36,097",
    "start_sec": 12334.297,
    "end_sec": 12336.097,
    "zh": "一脸错愕的看向橙子皮",
    "vi": "Ngơ ngác nhìn Trái Cam"
  },
  {
    "idx": 7321,
    "start": "03:25:36,097",
    "end": "03:25:37,037",
    "start_sec": 12336.097,
    "end_sec": 12337.037,
    "zh": "怕什么呀",
    "vi": "Sợ cái gì chứ."
  },
  {
    "idx": 7322,
    "start": "03:25:37,037",
    "end": "03:25:38,617",
    "start_sec": 12337.037,
    "end_sec": 12338.617,
    "zh": "看你一副老太隆重的模样",
    "vi": "Trông ông có vẻ đạo mạo thế kia."
  },
  {
    "idx": 7323,
    "start": "03:25:38,617",
    "end": "03:25:39,897",
    "start_sec": 12338.617,
    "end_sec": 12339.897,
    "zh": "还以为你是个好人",
    "vi": "Cứ tưởng ông là người tốt."
  },
  {
    "idx": 7324,
    "start": "03:25:39,897",
    "end": "03:25:42,217",
    "start_sec": 12339.897,
    "end_sec": 12342.217,
    "zh": "没想到老的手脚也不干净",
    "vi": "Không ngờ già rồi mà tay chân cũng không sạch sẽ."
  },
  {
    "idx": 7325,
    "start": "03:25:42,217",
    "end": "03:25:44,077",
    "start_sec": 12342.217,
    "end_sec": 12344.077,
    "zh": "你跟我下车",
    "vi": "Ông xuống xe với tôi."
  },
  {
    "idx": 7326,
    "start": "03:25:44,077",
    "end": "03:25:45,817",
    "start_sec": 12344.077,
    "end_sec": 12345.817,
    "zh": "这辆车上全都是鬼",
    "vi": "Trên chiếc xe này toàn là ma quỷ."
  },
  {
    "idx": 7327,
    "start": "03:25:45,817",
    "end": "03:25:46,917",
    "start_sec": 12345.817,
    "end_sec": 12346.917,
    "zh": "你还敢坐呀",
    "vi": "Mà ông vẫn dám ngồi sao."
  },
  {
    "idx": 7328,
    "start": "03:25:46,917",
    "end": "03:25:49,537",
    "start_sec": 12346.917,
    "end_sec": 12349.537,
    "zh": "橙子皮将老夫拽起来",
    "vi": "Trần Tử Bì kéo lão đứng dậy."
  },
  {
    "idx": 7329,
    "start": "03:25:49,537",
    "end": "03:25:50,817",
    "start_sec": 12349.537,
    "end_sec": 12350.817,
    "zh": "老夫勾搂着身子",
    "vi": "Lão khom người lại."
  },
  {
    "idx": 7330,
    "start": "03:25:50,817",
    "end": "03:25:51,657",
    "start_sec": 12350.817,
    "end_sec": 12351.657,
    "zh": "也没说话",
    "vi": "Cũng không nói lời nào."
  },
  {
    "idx": 7331,
    "start": "03:25:51,657",
    "end": "03:25:54,517",
    "start_sec": 12351.657,
    "end_sec": 12354.517,
    "zh": "车厢内其他乘客也没有想起任何反应",
    "vi": "Các hành khách khác trong xe cũng không có bất kỳ phản ứng nào."
  },
  {
    "idx": 7332,
    "start": "03:25:54,517",
    "end": "03:25:57,437",
    "start_sec": 12354.517,
    "end_sec": 12357.437,
    "zh": "果然以偷窃为理由将这老铺拉起来",
    "vi": "Quả nhiên lấy lý do trộm cắp để kéo lão già này dậy."
  },
  {
    "idx": 7333,
    "start": "03:25:57,437",
    "end": "03:25:59,577",
    "start_sec": 12357.437,
    "end_sec": 12359.577,
    "zh": "就不算违反尊老爱佑的规则了",
    "vi": "Thì không tính là vi phạm quy tắc kính già yêu trẻ."
  },
  {
    "idx": 7334,
    "start": "03:25:59,577",
    "end": "03:26:00,077",
    "start_sec": 12359.577,
    "end_sec": 12360.077,
    "zh": "走",
    "vi": "Đi."
  },
  {
    "idx": 7335,
    "start": "03:26:00,077",
    "end": "03:26:00,857",
    "start_sec": 12360.077,
    "end_sec": 12360.857,
    "zh": "和我走",
    "vi": "Đi với tôi."
  },
  {
    "idx": 7336,
    "start": "03:26:00,857",
    "end": "03:26:01,417",
    "start_sec": 12360.857,
    "end_sec": 12361.417,
    "zh": "下车",
    "vi": "Xuống xe."
  },
  {
    "idx": 7337,
    "start": "03:26:01,417",
    "end": "03:26:02,737",
    "start_sec": 12361.417,
    "end_sec": 12362.737,
    "zh": "我报警让你去警局",
    "vi": "Tôi sẽ báo cảnh sát đưa ông lên đồn."
  },
  {
    "idx": 7338,
    "start": "03:26:02,737",
    "end": "03:26:04,077",
    "start_sec": 12362.737,
    "end_sec": 12364.077,
    "zh": "我看你还狡辩什么",
    "vi": "Để xem ông còn chối cãi thế nào."
  },
  {
    "idx": 7339,
    "start": "03:26:04,077",
    "end": "03:26:05,117",
    "start_sec": 12364.077,
    "end_sec": 12365.117,
    "zh": "拖拽着老铺",
    "vi": "Vừa lôi kéo lão già."
  },
  {
    "idx": 7340,
    "start": "03:26:05,117",
    "end": "03:26:07,417",
    "start_sec": 12365.117,
    "end_sec": 12367.417,
    "zh": "橙子皮直接来到那名孕妇身边",
    "vi": "Trần Tử Bì đi thẳng đến bên cạnh người phụ nữ mang thai kia."
  },
  {
    "idx": 7341,
    "start": "03:26:07,417",
    "end": "03:26:08,717",
    "start_sec": 12367.417,
    "end_sec": 12368.717,
    "zh": "我带你下车",
    "vi": "Tôi đưa cô xuống xe."
  },
  {
    "idx": 7342,
    "start": "03:26:08,717",
    "end": "03:26:09,937",
    "start_sec": 12368.717,
    "end_sec": 12369.937,
    "zh": "你帮我记个座位",
    "vi": "Cô giữ chỗ giúp tôi nhé."
  },
  {
    "idx": 7343,
    "start": "03:26:09,937",
    "end": "03:26:10,517",
    "start_sec": 12369.937,
    "end_sec": 12370.517,
    "zh": "呵呵",
    "vi": "Hừm."
  },
  {
    "idx": 7344,
    "start": "03:26:10,517",
    "end": "03:26:11,137",
    "start_sec": 12370.517,
    "end_sec": 12371.137,
    "zh": "小子",
    "vi": "Thằng nhóc này."
  },
  {
    "idx": 7345,
    "start": "03:26:11,137",
    "end": "03:26:13,697",
    "start_sec": 12371.137,
    "end_sec": 12373.697,
    "zh": "你居然知道这里是后车门",
    "vi": "Ngươi lại biết đây là cửa sau xe sao."
  },
  {
    "idx": 7346,
    "start": "03:26:13,697",
    "end": "03:26:15,517",
    "start_sec": 12373.697,
    "end_sec": 12375.517,
    "zh": "我又为什么要帮你",
    "vi": "Mà tại sao ta phải giúp ngươi chứ."
  },
  {
    "idx": 7347,
    "start": "03:26:15,517",
    "end": "03:26:16,897",
    "start_sec": 12375.517,
    "end_sec": 12376.897,
    "zh": "我自己下车",
    "vi": "Tự ta xuống xe."
  },
  {
    "idx": 7348,
    "start": "03:26:16,897",
    "end": "03:26:20,037",
    "start_sec": 12376.897,
    "end_sec": 12380.037,
    "zh": "到时候再让这孕妇让开就是了",
    "vi": "Đến lúc đó cứ bắt người phụ nữ mang thai này tránh ra là được."
  },
  {
    "idx": 7349,
    "start": "03:26:20,037",
    "end": "03:26:21,477",
    "start_sec": 12380.037,
    "end_sec": 12381.477,
    "zh": "你不是想拉我下水吗",
    "vi": "Không phải ngươi muốn kéo ta xuống nước sao."
  },
  {
    "idx": 7350,
    "start": "03:26:21,477",
    "end": "03:26:23,717",
    "start_sec": 12381.477,
    "end_sec": 12383.717,
    "zh": "下了车你还有机会单独算计我",
    "vi": "Xuống xe rồi ngươi mới có cơ hội tính kế ta một mình chứ."
  },
  {
    "idx": 7351,
    "start": "03:26:23,717",
    "end": "03:26:26,037",
    "start_sec": 12383.717,
    "end_sec": 12386.037,
    "zh": "不下车我就是赌属于恶鬼巴士",
    "vi": "Không xuống xe là tôi đang đánh cược với xe buýt ác quỷ."
  },
  {
    "idx": 7352,
    "start": "03:26:26,037",
    "end": "03:26:28,557",
    "start_sec": 12386.037,
    "end_sec": 12388.557,
    "zh": "你居然威胁我",
    "vi": "Ông dám đe dọa tôi sao."
  },
  {
    "idx": 7353,
    "start": "03:26:28,557",
    "end": "03:26:29,437",
    "start_sec": 12388.557,
    "end_sec": 12389.437,
    "zh": "算不上威胁",
    "vi": "Không tính là đe dọa."
  },
  {
    "idx": 7354,
    "start": "03:26:29,437",
    "end": "03:26:30,577",
    "start_sec": 12389.437,
    "end_sec": 12390.577,
    "zh": "不过是我需要你",
    "vi": "Chỉ là tôi cần ông."
  },
  {
    "idx": 7355,
    "start": "03:26:30,577",
    "end": "03:26:31,717",
    "start_sec": 12390.577,
    "end_sec": 12391.717,
    "zh": "你需要我罢了",
    "vi": "Và ông cũng cần tôi mà thôi."
  },
  {
    "idx": 7356,
    "start": "03:26:31,717",
    "end": "03:26:32,817",
    "start_sec": 12391.717,
    "end_sec": 12392.817,
    "zh": "橙子皮在赌",
    "vi": "Trần Tử Bì đang đánh cược."
  },
  {
    "idx": 7357,
    "start": "03:26:32,817",
    "end": "03:26:35,017",
    "start_sec": 12392.817,
    "end_sec": 12395.017,
    "zh": "诡异之间也会相互夺取利益",
    "vi": "Giữa các thế lực quỷ dị cũng sẽ tranh giành lợi ích với nhau."
  },
  {
    "idx": 7358,
    "start": "03:26:35,017",
    "end": "03:26:36,137",
    "start_sec": 12395.017,
    "end_sec": 12396.137,
    "zh": "就像在小区之",
    "vi": "Giống như ở trong khu chung cư."
  },
  {
    "idx": 7359,
    "start": "03:26:36,137",
    "end": "03:26:38,897",
    "start_sec": 12396.137,
    "end_sec": 12398.897,
    "zh": "敲门鬼与爬行女鬼争夺周见",
    "vi": "Quỷ gõ cửa và nữ quỷ bò tranh giành Chu Kiến."
  },
  {
    "idx": 7360,
    "start": "03:26:38,897",
    "end": "03:26:40,197",
    "start_sec": 12398.897,
    "end_sec": 12400.197,
    "zh": "他在赌逆死回老父",
    "vi": "Anh ta đang cược rằng ông lão chết đuối."
  },
  {
    "idx": 7361,
    "start": "03:26:40,197",
    "end": "03:26:41,797",
    "start_sec": 12400.197,
    "end_sec": 12401.797,
    "zh": "会为了单独得到自己",
    "vi": "Sẽ vì muốn độc chiếm anh ta."
  },
  {
    "idx": 7362,
    "start": "03:26:41,797",
    "end": "03:26:44,297",
    "start_sec": 12401.797,
    "end_sec": 12404.297,
    "zh": "从而帮助自己去向运货索要作为",
    "vi": "Mà giúp anh ta đi đòi chỗ ngồi từ Vận Quỷ."
  },
  {
    "idx": 7363,
    "start": "03:26:44,297",
    "end": "03:26:45,697",
    "start_sec": 12404.297,
    "end_sec": 12405.697,
    "zh": "当然如果赌错了",
    "vi": "Dĩ nhiên nếu cược sai."
  },
  {
    "idx": 7364,
    "start": "03:26:45,697",
    "end": "03:26:46,957",
    "start_sec": 12405.697,
    "end_sec": 12406.957,
    "zh": "他也只能再重开了",
    "vi": "Anh ta cũng chỉ đành phải chơi lại từ đầu."
  },
  {
    "idx": 7365,
    "start": "03:26:46,957",
    "end": "03:26:48,577",
    "start_sec": 12406.957,
    "end_sec": 12408.577,
    "zh": "老父神情犹豫一会儿后",
    "vi": "Ông lão vẻ mặt do dự một lát."
  },
  {
    "idx": 7366,
    "start": "03:26:48,577",
    "end": "03:26:49,557",
    "start_sec": 12408.577,
    "end_sec": 12409.557,
    "zh": "看了看橙子皮",
    "vi": "Rồi nhìn Trần Tử Bì."
  },
  {
    "idx": 7367,
    "start": "03:26:49,557",
    "end": "03:26:51,157",
    "start_sec": 12409.557,
    "end_sec": 12411.157,
    "zh": "居然真的向岳父靠近",
    "vi": "Không ngờ lại thực sự tiến về phía Vận Quỷ."
  },
  {
    "idx": 7368,
    "start": "03:26:51,157",
    "end": "03:26:51,777",
    "start_sec": 12411.157,
    "end_sec": 12411.777,
    "zh": "你好",
    "vi": "Xin chào."
  },
  {
    "idx": 7369,
    "start": "03:26:51,777",
    "end": "03:26:53,437",
    "start_sec": 12411.777,
    "end_sec": 12413.437,
    "zh": "能换个座吗",
    "vi": "Có thể đổi chỗ không."
  },
  {
    "idx": 7370,
    "start": "03:26:53,437",
    "end": "03:26:54,137",
    "start_sec": 12413.437,
    "end_sec": 12414.137,
    "zh": "老了",
    "vi": "Già rồi."
  },
  {
    "idx": 7371,
    "start": "03:26:54,137",
    "end": "03:26:56,137",
    "start_sec": 12414.137,
    "end_sec": 12416.137,
    "zh": "腿脚不方便下车",
    "vi": "Chân tay không tiện xuống xe."
  },
  {
    "idx": 7372,
    "start": "03:26:56,137",
    "end": "03:26:57,197",
    "start_sec": 12416.137,
    "end_sec": 12417.197,
    "zh": "岳父看见时他",
    "vi": "Vận Quỷ nhìn thấy ông ta."
  },
  {
    "idx": 7373,
    "start": "03:26:57,197",
    "end": "03:26:57,797",
    "start_sec": 12417.197,
    "end_sec": 12417.797,
    "zh": "点点头",
    "vi": "Gật gật đầu."
  },
  {
    "idx": 7374,
    "start": "03:26:57,797",
    "end": "03:26:58,577",
    "start_sec": 12417.797,
    "end_sec": 12418.577,
    "zh": "躺着肚子",
    "vi": "Ưỡn bụng."
  },
  {
    "idx": 7375,
    "start": "03:26:58,577",
    "end": "03:26:59,777",
    "start_sec": 12418.577,
    "end_sec": 12419.777,
    "zh": "走向旁边的同桌",
    "vi": "Đi về phía chỗ ngồi bên cạnh."
  },
  {
    "idx": 7376,
    "start": "03:26:59,777",
    "end": "03:27:00,377",
    "start_sec": 12419.777,
    "end_sec": 12420.377,
    "zh": "天壮",
    "vi": "Thấy vậy."
  },
  {
    "idx": 7377,
    "start": "03:27:00,377",
    "end": "03:27:02,317",
    "start_sec": 12420.377,
    "end_sec": 12422.317,
    "zh": "长子皮当即敲打着车顶",
    "vi": "Trần Tử Bì lập tức gõ vào trần xe."
  },
  {
    "idx": 7378,
    "start": "03:27:02,317",
    "end": "03:27:02,997",
    "start_sec": 12422.317,
    "end_sec": 12422.997,
    "zh": "司机",
    "vi": "Tài xế."
  },
  {
    "idx": 7379,
    "start": "03:27:02,997",
    "end": "03:27:03,617",
    "start_sec": 12422.997,
    "end_sec": 12423.617,
    "zh": "停车",
    "vi": "Dừng xe."
  },
  {
    "idx": 7380,
    "start": "03:27:03,617",
    "end": "03:27:04,257",
    "start_sec": 12423.617,
    "end_sec": 12424.257,
    "zh": "停车",
    "vi": "Dừng xe."
  },
  {
    "idx": 7381,
    "start": "03:27:04,257",
    "end": "03:27:04,957",
    "start_sec": 12424.257,
    "end_sec": 12424.957,
    "zh": "这个骗子",
    "vi": "Kẻ lừa đảo này."
  },
  {
    "idx": 7382,
    "start": "03:27:04,957",
    "end": "03:27:05,937",
    "start_sec": 12424.957,
    "end_sec": 12425.937,
    "zh": "我要拉他进警局",
    "vi": "Tôi phải lôi hắn đến đồn cảnh sát."
  },
  {
    "idx": 7383,
    "start": "03:27:05,937",
    "end": "03:27:07,217",
    "start_sec": 12425.937,
    "end_sec": 12427.217,
    "zh": "吵吵吵",
    "vi": "Ồn ào quá."
  },
  {
    "idx": 7384,
    "start": "03:27:07,217",
    "end": "03:27:07,997",
    "start_sec": 12427.217,
    "end_sec": 12427.997,
    "zh": "吵死了",
    "vi": "Ồn chết đi được."
  },
  {
    "idx": 7385,
    "start": "03:27:07,997",
    "end": "03:27:08,457",
    "start_sec": 12427.997,
    "end_sec": 12428.457,
    "zh": "闹着",
    "vi": "Cứ làm loạn lên."
  },
  {
    "idx": 7386,
    "start": "03:27:08,457",
    "end": "03:27:09,637",
    "start_sec": 12428.457,
    "end_sec": 12429.637,
    "zh": "赶紧快下车去",
    "vi": "Mau cút xuống xe đi."
  },
  {
    "idx": 7387,
    "start": "03:27:09,637",
    "end": "03:27:16,177",
    "start_sec": 12429.637,
    "end_sec": 12436.177,
    "zh": "车子虽然没到南河桥尾站",
    "vi": "Chiếc xe tuy chưa đến trạm cuối cầu Nam Hà."
  },
  {
    "idx": 7388,
    "start": "03:27:16,177",
    "end": "03:27:17,757",
    "start_sec": 12436.177,
    "end_sec": 12437.757,
    "zh": "但也已经越过坍塌路的",
    "vi": "Nhưng cũng đã vượt qua đoạn đường bị sạt lở."
  },
  {
    "idx": 7389,
    "start": "03:27:17,757",
    "end": "03:27:19,657",
    "start_sec": 12437.757,
    "end_sec": 12439.657,
    "zh": "看着逐渐远去的恶鬼巴士",
    "vi": "Nhìn chiếc xe buýt ác quỷ dần đi xa."
  },
  {
    "idx": 7390,
    "start": "03:27:19,657",
    "end": "03:27:21,057",
    "start_sec": 12439.657,
    "end_sec": 12441.057,
    "zh": "橙子皮神算一心",
    "vi": "Trần Tử Bì thở phào nhẹ nhõm."
  },
  {
    "idx": 7391,
    "start": "03:27:21,057",
    "end": "03:27:23,457",
    "start_sec": 12441.057,
    "end_sec": 12443.457,
    "zh": "终于终于没被这玩意惦记了",
    "vi": "Cuối cùng cũng không bị cái thứ này bám theo nữa rồi."
  },
  {
    "idx": 7392,
    "start": "03:27:23,457",
    "end": "03:27:25,497",
    "start_sec": 12443.457,
    "end_sec": 12445.497,
    "zh": "小子乐什么呢",
    "vi": "Nhóc con, cười cái gì thế."
  },
  {
    "idx": 7393,
    "start": "03:27:25,497",
    "end": "03:27:28,477",
    "start_sec": 12445.497,
    "end_sec": 12448.477,
    "zh": "现在你该陪奶奶下水了",
    "vi": "Giờ thì ngươi phải xuống nước với bà đây rồi."
  },
  {
    "idx": 7394,
    "start": "03:27:28,477",
    "end": "03:27:31,277",
    "start_sec": 12448.477,
    "end_sec": 12451.277,
    "zh": "你就那么确定能把我拉下水吗",
    "vi": "Bà chắc chắn là có thể kéo tôi xuống nước sao."
  },
  {
    "idx": 7395,
    "start": "03:27:31,277",
    "end": "03:27:33,617",
    "start_sec": 12451.277,
    "end_sec": 12453.617,
    "zh": "比起撞死自己三次的恶鬼巴士",
    "vi": "So với chiếc xe buýt ác quỷ đã đâm chết mình ba lần."
  },
  {
    "idx": 7396,
    "start": "03:27:33,617",
    "end": "03:27:35,077",
    "start_sec": 12453.617,
    "end_sec": 12455.077,
    "zh": "橙子皮看着一丝鬼",
    "vi": "Trần Tử Bì nhìn con quỷ chết đuối."
  },
  {
    "idx": 7397,
    "start": "03:27:35,077",
    "end": "03:27:37,397",
    "start_sec": 12455.077,
    "end_sec": 12457.397,
    "zh": "突然觉得他还挺能处无害的",
    "vi": "Bỗng cảm thấy nó cũng khá là vô hại."
  },
  {
    "idx": 7398,
    "start": "03:27:37,397",
    "end": "03:27:39,177",
    "start_sec": 12457.397,
    "end_sec": 12459.177,
    "zh": "你你不怕我",
    "vi": "Ngươi, ngươi không sợ ta sao."
  },
  {
    "idx": 7399,
    "start": "03:27:39,177",
    "end": "03:27:39,577",
    "start_sec": 12459.177,
    "end_sec": 12459.577,
    "zh": "不怕",
    "vi": "Không sợ."
  },
  {
    "idx": 7400,
    "start": "03:27:39,577",
    "end": "03:27:42,377",
    "start_sec": 12459.577,
    "end_sec": 12462.377,
    "zh": "或许我早已经习惯和你们这些鬼一打交道",
    "vi": "Có lẽ tôi đã sớm quen với việc giao thiệp với lũ quỷ các người rồi."
  },
  {
    "idx": 7401,
    "start": "03:27:42,377",
    "end": "03:27:43,817",
    "start_sec": 12462.377,
    "end_sec": 12463.817,
    "zh": "小子",
    "vi": "Nhóc con."
  },
  {
    "idx": 7402,
    "start": "03:27:43,817",
    "end": "03:27:45,937",
    "start_sec": 12463.817,
    "end_sec": 12465.937,
    "zh": "你真是我见过最绝顶聪明的人类",
    "vi": "Ngươi thực sự là con người thông minh nhất mà ta từng gặp."
  },
  {
    "idx": 7403,
    "start": "03:27:45,937",
    "end": "03:27:48,037",
    "start_sec": 12465.937,
    "end_sec": 12468.037,
    "zh": "像恶鬼八世那样规则类诡异",
    "vi": "Một thực thể quỷ dị theo quy tắc như xe buýt ác quỷ."
  },
  {
    "idx": 7404,
    "start": "03:27:48,037",
    "end": "03:27:49,937",
    "start_sec": 12468.037,
    "end_sec": 12469.937,
    "zh": "你居然能算无一策的跑出来",
    "vi": "Mà ngươi lại có thể tính toán không sai một li để thoát ra ngoài."
  },
  {
    "idx": 7405,
    "start": "03:27:49,937",
    "end": "03:27:50,697",
    "start_sec": 12469.937,
    "end_sec": 12470.697,
    "zh": "不得不说",
    "vi": "Phải thừa nhận rằng."
  },
  {
    "idx": 7406,
    "start": "03:27:50,697",
    "end": "03:27:52,257",
    "start_sec": 12470.697,
    "end_sec": 12472.257,
    "zh": "我都有点欣赏你了",
    "vi": "Ta cũng có chút ngưỡng mộ ngươi rồi đấy."
  },
  {
    "idx": 7407,
    "start": "03:27:52,257",
    "end": "03:27:53,217",
    "start_sec": 12472.257,
    "end_sec": 12473.217,
    "zh": "少废话",
    "vi": "Bớt nói nhảm đi."
  },
  {
    "idx": 7408,
    "start": "03:27:53,217",
    "end": "03:27:54,617",
    "start_sec": 12473.217,
    "end_sec": 12474.617,
    "zh": "你不是想吃诡异吗",
    "vi": "Không phải bà muốn ăn thực thể quỷ dị sao."
  },
  {
    "idx": 7409,
    "start": "03:27:54,617",
    "end": "03:27:55,377",
    "start_sec": 12474.617,
    "end_sec": 12475.377,
    "zh": "做个啥",
    "vi": "Con này thì sao."
  },
  {
    "idx": 7410,
    "start": "03:27:55,377",
    "end": "03:27:56,157",
    "start_sec": 12475.377,
    "end_sec": 12476.157,
    "zh": "你吃",
    "vi": "Bà ăn đi."
  },
  {
    "idx": 7411,
    "start": "03:27:56,157",
    "end": "03:27:57,637",
    "start_sec": 12476.157,
    "end_sec": 12477.637,
    "zh": "随面方参向老虎",
    "vi": "Hướng về phía Lão Hổ."
  },
  {
    "idx": 7412,
    "start": "03:27:57,637",
    "end": "03:27:59,017",
    "start_sec": 12477.637,
    "end_sec": 12479.017,
    "zh": "什么阿猫阿虎",
    "vi": "Mèo mả gà đồng gì chứ."
  },
  {
    "idx": 7413,
    "start": "03:27:59,017",
    "end": "03:28:00,457",
    "start_sec": 12479.017,
    "end_sec": 12480.457,
    "zh": "别敢和我叫嚣",
    "vi": "Mà dám gào thét với ta."
  },
  {
    "idx": 7414,
    "start": "03:28:00,457",
    "end": "03:28:01,157",
    "start_sec": 12480.457,
    "end_sec": 12481.157,
    "zh": "你",
    "vi": "Ngươi."
  },
  {
    "idx": 7415,
    "start": "03:28:01,157",
    "end": "03:28:02,777",
    "start_sec": 12481.157,
    "end_sec": 12482.777,
    "zh": "你是御诡者",
    "vi": "Ngươi là Ngự Quỷ Giả."
  },
  {
    "idx": 7416,
    "start": "03:28:02,777",
    "end": "03:28:05,157",
    "start_sec": 12482.777,
    "end_sec": 12485.157,
    "zh": "你的依仗就是这个吗",
    "vi": "Chỗ dựa của ngươi chính là thứ này sao."
  },
  {
    "idx": 7417,
    "start": "03:28:05,157",
    "end": "03:28:05,657",
    "start_sec": 12485.157,
    "end_sec": 12485.657,
    "zh": "喂",
    "vi": "Này."
  },
  {
    "idx": 7418,
    "start": "03:28:05,657",
    "end": "03:28:06,597",
    "start_sec": 12485.657,
    "end_sec": 12486.597,
    "zh": "程子提",
    "vi": "Trình Tử Đề."
  },
  {
    "idx": 7419,
    "start": "03:28:06,597",
    "end": "03:28:07,417",
    "start_sec": 12486.597,
    "end_sec": 12487.417,
    "zh": "近身",
    "vi": "Đến gần đi."
  },
  {
    "idx": 7420,
    "start": "03:28:07,417",
    "end": "03:28:08,757",
    "start_sec": 12487.417,
    "end_sec": 12488.757,
    "zh": "让我吃了它",
    "vi": "Để ta ăn nó."
  },
  {
    "idx": 7421,
    "start": "03:28:08,757",
    "end": "03:28:09,377",
    "start_sec": 12488.757,
    "end_sec": 12489.377,
    "zh": "闭嘴",
    "vi": "Câm miệng."
  },
  {
    "idx": 7422,
    "start": "03:28:09,377",
    "end": "03:28:10,317",
    "start_sec": 12489.377,
    "end_sec": 12490.317,
    "zh": "你是主人",
    "vi": "Ngươi là chủ nhân."
  },
  {
    "idx": 7423,
    "start": "03:28:10,317",
    "end": "03:28:11,257",
    "start_sec": 12490.317,
    "end_sec": 12491.257,
    "zh": "还是不是主人",
    "vi": "Hay ta mới là chủ nhân."
  },
  {
    "idx": 7424,
    "start": "03:28:11,257",
    "end": "03:28:12,817",
    "start_sec": 12491.257,
    "end_sec": 12492.817,
    "zh": "程子提没有上前",
    "vi": "Trình Tử Đề không tiến lên."
  },
  {
    "idx": 7425,
    "start": "03:28:12,817",
    "end": "03:28:14,497",
    "start_sec": 12492.817,
    "end_sec": 12494.497,
    "zh": "而是一把抓住老虎的胳膊",
    "vi": "Mà chộp lấy cánh tay của Lão Hổ."
  },
  {
    "idx": 7426,
    "start": "03:28:14,497",
    "end": "03:28:15,837",
    "start_sec": 12494.497,
    "end_sec": 12495.837,
    "zh": "鬼运床张开大嘴",
    "vi": "Cửa sổ vận quỷ mở to cái miệng rộng."
  },
  {
    "idx": 7427,
    "start": "03:28:15,837",
    "end": "03:28:17,277",
    "start_sec": 12495.837,
    "end_sec": 12497.277,
    "zh": "朝老夫的脸咬紧",
    "vi": "Cắn chặt vào mặt lão phu."
  },
  {
    "idx": 7428,
    "start": "03:28:17,277",
    "end": "03:28:18,597",
    "start_sec": 12497.277,
    "end_sec": 12498.597,
    "zh": "并没有血肉横飞",
    "vi": "Không hề có máu thịt văng tung tóe."
  },
  {
    "idx": 7429,
    "start": "03:28:18,597",
    "end": "03:28:21,337",
    "start_sec": 12498.597,
    "end_sec": 12501.337,
    "zh": "老夫的脸在一瞬间被咬成水珠崩溃",
    "vi": "Khuôn mặt của lão phu trong nháy mắt bị cắn vỡ thành những giọt nước."
  },
  {
    "idx": 7430,
    "start": "03:28:21,337",
    "end": "03:28:24,497",
    "start_sec": 12501.337,
    "end_sec": 12504.497,
    "zh": "随即身体也顷刻间变成碎落满地的水迹",
    "vi": "Ngay sau đó cơ thể cũng lập tức biến thành những vệt nước vỡ vụn đầy đất."
  },
  {
    "idx": 7431,
    "start": "03:28:24,497",
    "end": "03:28:26,697",
    "start_sec": 12504.497,
    "end_sec": 12506.697,
    "zh": "我知道你是遇鬼者",
    "vi": "Ta biết ngươi là Ngự Quỷ Giả."
  },
  {
    "idx": 7432,
    "start": "03:28:26,697",
    "end": "03:28:30,177",
    "start_sec": 12506.697,
    "end_sec": 12510.177,
    "zh": "但是没想到你身上的鬼力会这么强",
    "vi": "Nhưng không ngờ quỷ lực trên người ngươi lại mạnh như vậy."
  },
  {
    "idx": 7433,
    "start": "03:28:30,177",
    "end": "03:28:32,117",
    "start_sec": 12510.177,
    "end_sec": 12512.117,
    "zh": "小子算我栽了",
    "vi": "Thằng nhóc, coi như ta xui xẻo."
  },
  {
    "idx": 7434,
    "start": "03:28:32,117",
    "end": "03:28:33,537",
    "start_sec": 12512.117,
    "end_sec": 12513.537,
    "zh": "你敢利用我",
    "vi": "Ngươi dám lợi dụng ta."
  },
  {
    "idx": 7435,
    "start": "03:28:33,537",
    "end": "03:28:35,337",
    "start_sec": 12513.537,
    "end_sec": 12515.337,
    "zh": "下次再经过这里",
    "vi": "Lần sau còn đi qua đây."
  },
  {
    "idx": 7436,
    "start": "03:28:35,337",
    "end": "03:28:37,957",
    "start_sec": 12515.337,
    "end_sec": 12517.957,
    "zh": "我必定要你尸尘难和",
    "vi": "Ta nhất định sẽ khiến ngươi xương thịt nát tan."
  },
  {
    "idx": 7437,
    "start": "03:28:37,957",
    "end": "03:28:39,257",
    "start_sec": 12517.957,
    "end_sec": 12519.257,
    "zh": "好",
    "vi": "Được."
  },
  {
    "idx": 7438,
    "start": "03:28:39,257",
    "end": "03:28:40,277",
    "start_sec": 12519.257,
    "end_sec": 12520.277,
    "zh": "你跑得掉吗",
    "vi": "Ngươi chạy thoát được sao."
  },
  {
    "idx": 7439,
    "start": "03:28:40,277",
    "end": "03:28:41,457",
    "start_sec": 12520.277,
    "end_sec": 12521.457,
    "zh": "鬼运窗",
    "vi": "Cửa sổ vận quỷ."
  },
  {
    "idx": 7440,
    "start": "03:28:41,457",
    "end": "03:28:42,517",
    "start_sec": 12521.457,
    "end_sec": 12522.517,
    "zh": "话音落下",
    "vi": "Giọng nói vừa dứt."
  },
  {
    "idx": 7441,
    "start": "03:28:42,517",
    "end": "03:28:45,177",
    "start_sec": 12522.517,
    "end_sec": 12525.177,
    "zh": "地上的水迹重新凝结成老末的美",
    "vi": "Vết nước trên mặt đất ngưng tụ lại thành khuôn mặt của Lão Mạt."
  },
  {
    "idx": 7442,
    "start": "03:28:45,177",
    "end": "03:28:47,217",
    "start_sec": 12525.177,
    "end_sec": 12527.217,
    "zh": "你 你的能力是",
    "vi": "Ngươi, năng lực của ngươi là gì."
  },
  {
    "idx": 7443,
    "start": "03:28:47,217",
    "end": "03:28:48,497",
    "start_sec": 12527.217,
    "end_sec": 12528.497,
    "zh": "无笑话",
    "vi": "Vô hiệu hóa."
  },
  {
    "idx": 7444,
    "start": "03:28:48,497",
    "end": "03:28:49,597",
    "start_sec": 12528.497,
    "end_sec": 12529.597,
    "zh": "我看你怎么跑",
    "vi": "Ta xem ngươi chạy đường nào."
  },
  {
    "idx": 7445,
    "start": "03:28:49,597",
    "end": "03:28:50,897",
    "start_sec": 12529.597,
    "end_sec": 12530.897,
    "zh": "随着能力发动",
    "vi": "Theo đà kích hoạt năng lực."
  },
  {
    "idx": 7446,
    "start": "03:28:50,897",
    "end": "03:28:52,257",
    "start_sec": 12530.897,
    "end_sec": 12532.257,
    "zh": "鬼面窗越肿越好",
    "vi": "Mặt quỷ càng lúc càng sưng to."
  },
  {
    "idx": 7447,
    "start": "03:28:52,257",
    "end": "03:28:53,897",
    "start_sec": 12532.257,
    "end_sec": 12533.897,
    "zh": "小子 你疯了吧",
    "vi": "Nhóc con, ngươi điên rồi sao."
  },
  {
    "idx": 7448,
    "start": "03:28:53,897",
    "end": "03:28:55,277",
    "start_sec": 12533.897,
    "end_sec": 12535.277,
    "zh": "就为了杀我",
    "vi": "Chỉ để giết ta."
  },
  {
    "idx": 7449,
    "start": "03:28:55,277",
    "end": "03:28:58,057",
    "start_sec": 12535.277,
    "end_sec": 12538.057,
    "zh": "你脖子上的鬼印就要复苏了",
    "vi": "Ấn quỷ trên cổ ngươi sắp thức tỉnh rồi."
  },
  {
    "idx": 7450,
    "start": "03:28:58,057",
    "end": "03:28:59,757",
    "start_sec": 12538.057,
    "end_sec": 12539.757,
    "zh": "你不想活命的吗",
    "vi": "Ngươi không muốn sống nữa à."
  },
  {
    "idx": 7451,
    "start": "03:29:06,577",
    "end": "03:29:08,457",
    "start_sec": 12546.577,
    "end_sec": 12548.457,
    "zh": "真是愉悦的美味啊",
    "vi": "Đúng là một món ngon tuyệt vời."
  },
  {
    "idx": 7452,
    "start": "03:29:08,457",
    "end": "03:29:09,317",
    "start_sec": 12548.457,
    "end_sec": 12549.317,
    "zh": "吃完没有",
    "vi": "Ăn xong chưa."
  },
  {
    "idx": 7453,
    "start": "03:29:09,317",
    "end": "03:29:11,817",
    "start_sec": 12549.317,
    "end_sec": 12551.817,
    "zh": "小子 我虽然不喜欢人类",
    "vi": "Nhóc con, ta tuy không thích loài người."
  },
  {
    "idx": 7454,
    "start": "03:29:11,817",
    "end": "03:29:14,917",
    "start_sec": 12551.817,
    "end_sec": 12554.917,
    "zh": "但是我喜欢和贪婪有智慧的生物美舞",
    "vi": "Nhưng ta thích đồng hành cùng những sinh vật tham lam và có trí tuệ."
  },
  {
    "idx": 7455,
    "start": "03:29:14,917",
    "end": "03:29:15,937",
    "start_sec": 12554.917,
    "end_sec": 12555.937,
    "zh": "你很不错",
    "vi": "Ngươi rất khá."
  },
  {
    "idx": 7456,
    "start": "03:29:15,937",
    "end": "03:29:18,297",
    "start_sec": 12555.937,
    "end_sec": 12558.297,
    "zh": "我承认之前有点小瞧你了",
    "vi": "Ta thừa nhận lúc trước đã hơi coi thường ngươi."
  },
  {
    "idx": 7457,
    "start": "03:29:18,297",
    "end": "03:29:19,497",
    "start_sec": 12558.297,
    "end_sec": 12559.497,
    "zh": "逃出恶鬼巴士",
    "vi": "Trốn thoát khỏi xe buýt ác quỷ."
  },
  {
    "idx": 7458,
    "start": "03:29:19,497",
    "end": "03:29:21,097",
    "start_sec": 12559.497,
    "end_sec": 12561.097,
    "zh": "设计吞杀逆死鬼",
    "vi": "Lập mưu nuốt chửng quỷ chết đuối."
  },
  {
    "idx": 7459,
    "start": "03:29:21,097",
    "end": "03:29:22,317",
    "start_sec": 12561.097,
    "end_sec": 12562.317,
    "zh": "明知我会复苏",
    "vi": "Biết rõ ta sẽ thức tỉnh."
  },
  {
    "idx": 7460,
    "start": "03:29:22,317",
    "end": "03:29:23,837",
    "start_sec": 12562.317,
    "end_sec": 12563.837,
    "zh": "你还是要我吞噬",
    "vi": "Ngươi vẫn muốn ta nuốt chửng."
  },
  {
    "idx": 7461,
    "start": "03:29:23,837",
    "end": "03:29:25,197",
    "start_sec": 12563.837,
    "end_sec": 12565.197,
    "zh": "你想获得力量",
    "vi": "Ngươi muốn có được sức mạnh."
  },
  {
    "idx": 7462,
    "start": "03:29:25,197",
    "end": "03:29:25,777",
    "start_sec": 12565.197,
    "end_sec": 12565.777,
    "zh": "对吗",
    "vi": "Đúng không."
  },
  {
    "idx": 7463,
    "start": "03:29:25,777",
    "end": "03:29:26,457",
    "start_sec": 12565.777,
    "end_sec": 12566.457,
    "zh": "废话",
    "vi": "Nói nhảm."
  },
  {
    "idx": 7464,
    "start": "03:29:26,457",
    "end": "03:29:27,157",
    "start_sec": 12566.457,
    "end_sec": 12567.157,
    "zh": "不要力量",
    "vi": "Không cần sức mạnh."
  },
  {
    "idx": 7465,
    "start": "03:29:27,157",
    "end": "03:29:28,297",
    "start_sec": 12567.157,
    "end_sec": 12568.297,
    "zh": "我要你干嘛",
    "vi": "Thì ta cần ngươi làm gì."
  },
  {
    "idx": 7466,
    "start": "03:29:28,297",
    "end": "03:29:29,157",
    "start_sec": 12568.297,
    "end_sec": 12569.157,
    "zh": "好好好",
    "vi": "Tốt tốt tốt."
  },
  {
    "idx": 7467,
    "start": "03:29:29,157",
    "end": "03:29:31,177",
    "start_sec": 12569.157,
    "end_sec": 12571.177,
    "zh": "贪婪才是人进步的根本",
    "vi": "Tham lam mới là gốc rễ giúp con người tiến bộ."
  },
  {
    "idx": 7468,
    "start": "03:29:31,177",
    "end": "03:29:32,997",
    "start_sec": 12571.177,
    "end_sec": 12572.997,
    "zh": "这次我就大发慈悲",
    "vi": "Lần này ta sẽ đại phát từ bi."
  },
  {
    "idx": 7469,
    "start": "03:29:32,997",
    "end": "03:29:34,297",
    "start_sec": 12572.997,
    "end_sec": 12574.297,
    "zh": "不与你作对了",
    "vi": "Không đối đầu với ngươi nữa."
  },
  {
    "idx": 7470,
    "start": "03:29:34,297",
    "end": "03:29:34,737",
    "start_sec": 12574.297,
    "end_sec": 12574.737,
    "zh": "记住",
    "vi": "Hãy nhớ kỹ."
  },
  {
    "idx": 7471,
    "start": "03:29:34,737",
    "end": "03:29:35,617",
    "start_sec": 12574.737,
    "end_sec": 12575.617,
    "zh": "不断吞噬",
    "vi": "Hãy không ngừng nuốt chửng."
  },
  {
    "idx": 7472,
    "start": "03:29:35,617",
    "end": "03:29:37,817",
    "start_sec": 12575.617,
    "end_sec": 12577.817,
    "zh": "直到把你自己也献给我",
    "vi": "Cho đến khi ngươi dâng hiến cả bản thân cho ta."
  },
  {
    "idx": 7473,
    "start": "03:29:37,817",
    "end": "03:29:41,397",
    "start_sec": 12577.817,
    "end_sec": 12581.397,
    "zh": "这鬼面窗竟然真的没复苏",
    "vi": "Cửa sổ mặt quỷ này thực sự không hề hồi sinh."
  },
  {
    "idx": 7474,
    "start": "03:29:41,397",
    "end": "03:29:42,717",
    "start_sec": 12581.397,
    "end_sec": 12582.717,
    "zh": "不仅如此",
    "vi": "Không chỉ vậy."
  },
  {
    "idx": 7475,
    "start": "03:29:42,717",
    "end": "03:29:43,557",
    "start_sec": 12582.717,
    "end_sec": 12583.557,
    "zh": "我的身体",
    "vi": "Cơ thể của ta."
  },
  {
    "idx": 7476,
    "start": "03:29:43,557",
    "end": "03:29:45,437",
    "start_sec": 12583.557,
    "end_sec": 12585.437,
    "zh": "好像也有一种莫名的力量拥住",
    "vi": "Hình như cũng được một nguồn sức mạnh vô hình bao bọc."
  },
  {
    "idx": 7477,
    "start": "03:29:45,437",
    "end": "03:29:46,357",
    "start_sec": 12585.437,
    "end_sec": 12586.357,
    "zh": "供养它",
    "vi": "Nuôi dưỡng nó."
  },
  {
    "idx": 7478,
    "start": "03:29:46,357",
    "end": "03:29:47,817",
    "start_sec": 12586.357,
    "end_sec": 12587.817,
    "zh": "就能得到一定的反哭吗",
    "vi": "Thì sẽ nhận lại được phản hồi nhất định sao."
  },
  {
    "idx": 7479,
    "start": "03:29:47,817",
    "end": "03:29:49,017",
    "start_sec": 12587.817,
    "end_sec": 12589.017,
    "zh": "如果一直供养下去",
    "vi": "Nếu cứ tiếp tục nuôi dưỡng nó."
  },
  {
    "idx": 7480,
    "start": "03:29:49,017",
    "end": "03:29:49,877",
    "start_sec": 12589.017,
    "end_sec": 12589.877,
    "zh": "那我到底",
    "vi": "Thì rốt cuộc ta."
  },
  {
    "idx": 7481,
    "start": "03:29:49,877",
    "end": "03:29:51,357",
    "start_sec": 12589.877,
    "end_sec": 12591.357,
    "zh": "算是人类还是鬼异",
    "vi": "Là con người hay là quỷ dị."
  },
  {
    "idx": 7482,
    "start": "03:29:51,357",
    "end": "03:29:52,957",
    "start_sec": 12591.357,
    "end_sec": 12592.957,
    "zh": "长者皮摸了摸鬼面",
    "vi": "Trần Tử Bì sờ lên mặt quỷ."
  },
  {
    "idx": 7483,
    "start": "03:29:52,957",
    "end": "03:29:53,777",
    "start_sec": 12592.957,
    "end_sec": 12593.777,
    "zh": "说来",
    "vi": "Nói ra thì."
  },
  {
    "idx": 7484,
    "start": "03:29:53,777",
    "end": "03:29:56,175",
    "start_sec": 12593.777,
    "end_sec": 12596.175,
    "zh": "这还是他第一次向我示好是看中了我的持续发展能力吗还是说只要我越吞噬他也就他也就越厉害到最后,他可以不想骑乘的成为大鬼异在吞噬,南河小码头一道悠扬的鸣笛声响起",
    "vi": "Đây là lần đầu tiên nó tỏ ý tốt với ta"
  },
  {
    "idx": 7484,
    "start": "03:29:56,175",
    "end": "03:29:59,009",
    "start_sec": 12596.175,
    "end_sec": 12599.009,
    "zh": "这还是他第一次向我示好是看中了我的持续发展能力吗还是说只要我越吞噬他也就他也就越厉害到最后,他可以不想骑乘的成为大鬼异在吞噬,南河小码头一道悠扬的鸣笛声响起",
    "vi": "Là vì nhìn trúng khả năng phát triển lâu dài của ta sao"
  },
  {
    "idx": 7484,
    "start": "03:29:59,009",
    "end": "03:30:01,625",
    "start_sec": 12599.009,
    "end_sec": 12601.625,
    "zh": "这还是他第一次向我示好是看中了我的持续发展能力吗还是说只要我越吞噬他也就他也就越厉害到最后,他可以不想骑乘的成为大鬼异在吞噬,南河小码头一道悠扬的鸣笛声响起",
    "vi": "Hay là ta càng nuốt chửng thì nó cũng càng mạnh lên"
  },
  {
    "idx": 7484,
    "start": "03:30:01,625",
    "end": "03:30:04,023",
    "start_sec": 12601.625,
    "end_sec": 12604.023,
    "zh": "这还是他第一次向我示好是看中了我的持续发展能力吗还是说只要我越吞噬他也就他也就越厉害到最后,他可以不想骑乘的成为大鬼异在吞噬,南河小码头一道悠扬的鸣笛声响起",
    "vi": "Đến cuối cùng nó có thể trở thành đại quỷ dị"
  },
  {
    "idx": 7484,
    "start": "03:30:04,023",
    "end": "03:30:07,074",
    "start_sec": 12604.023,
    "end_sec": 12607.074,
    "zh": "这还是他第一次向我示好是看中了我的持续发展能力吗还是说只要我越吞噬他也就他也就越厉害到最后,他可以不想骑乘的成为大鬼异在吞噬,南河小码头一道悠扬的鸣笛声响起",
    "vi": "Tại bến tàu nhỏ Nam Hà, một tiếng còi tàu vang lên ngân vang"
  },
  {
    "idx": 7485,
    "start": "03:30:07,074",
    "end": "03:30:09,994",
    "start_sec": 12607.074,
    "end_sec": 12609.994,
    "zh": "橙子皮当即抱起小磨叽,狂奔而行",
    "vi": "Trần Tử Bì lập tức bế Tiểu Ma Kỷ lên rồi chạy như điên."
  },
  {
    "idx": 7486,
    "start": "03:30:09,994",
    "end": "03:30:13,314",
    "start_sec": 12609.994,
    "end_sec": 12613.314,
    "zh": "一口气跑这么远,竟然大气都没喘一口",
    "vi": "Chạy một mạch xa như vậy mà không hề thở dốc một hơi."
  },
  {
    "idx": 7487,
    "start": "03:30:13,314",
    "end": "03:30:15,354",
    "start_sec": 12613.314,
    "end_sec": 12615.354,
    "zh": "这就是鬼面窗带给我的力量吗?",
    "vi": "Đây chính là sức mạnh mà cửa sổ mặt quỷ mang lại cho ta sao."
  },
  {
    "idx": 7488,
    "start": "03:30:15,694",
    "end": "03:30:18,914",
    "start_sec": 12615.694,
    "end_sec": 12618.914,
    "zh": "看着眼前的邮轮,橙子皮终于十足地喊了一句",
    "vi": "Nhìn chiếc du thuyền trước mắt, Trần Tử Bì cuối cùng cũng hét lớn một tiếng."
  },
  {
    "idx": 7489,
    "start": "03:30:18,914",
    "end": "03:30:23,274",
    "start_sec": 12618.914,
    "end_sec": 12623.274,
    "zh": "手帮号上,一个握着望远镜的老头朝他看了过来",
    "vi": "Trên tàu Thủ Bang, một ông lão cầm kính viễn vọng nhìn về phía cậu."
  },
  {
    "idx": 7490,
    "start": "03:30:23,274",
    "end": "03:30:26,894",
    "start_sec": 12623.274,
    "end_sec": 12626.894,
    "zh": "取出这里除了东南竟然还有活人",
    "vi": "Kỳ lạ thật, ngoài Đông Nam ra ở đây vẫn còn người sống sao."
  },
  {
    "idx": 7491,
    "start": "03:30:26,894",
    "end": "03:30:29,954",
    "start_sec": 12626.894,
    "end_sec": 12629.954,
    "zh": "那小家伙手里还抱着一只黑狗",
    "vi": "Cậu nhóc kia còn ôm một con chó đen trong tay."
  },
  {
    "idx": 7492,
    "start": "03:30:29,954",
    "end": "03:30:32,134",
    "start_sec": 12629.954,
    "end_sec": 12632.134,
    "zh": "难不成是黑狗保护了他吗",
    "vi": "Không lẽ là con chó đen đã bảo vệ cậu ta sao."
  },
  {
    "idx": 7493,
    "start": "03:30:32,134",
    "end": "03:30:37,234",
    "start_sec": 12632.134,
    "end_sec": 12637.234,
    "zh": "据说周市长的公子就是因为一条黑狗避开了不少诡异呢",
    "vi": "Nghe nói con trai của thị trưởng Chu cũng nhờ một con chó đen mà tránh được không ít quỷ dị."
  },
  {
    "idx": 7494,
    "start": "03:30:37,234",
    "end": "03:30:38,794",
    "start_sec": 12637.234,
    "end_sec": 12638.794,
    "zh": "那是诡异降临初期",
    "vi": "Đó là thời kỳ đầu khi quỷ dị giáng thế."
  },
  {
    "idx": 7495,
    "start": "03:30:38,794",
    "end": "03:30:41,594",
    "start_sec": 12638.794,
    "end_sec": 12641.594,
    "zh": "现在这个时候黑狗肯定起不了太大作用",
    "vi": "Còn bây giờ thì chó đen chắc chắn không có tác dụng lớn như vậy nữa."
  },
  {
    "idx": 7496,
    "start": "03:30:41,594",
    "end": "03:30:43,494",
    "start_sec": 12641.594,
    "end_sec": 12643.494,
    "zh": "算了东南也没出现",
    "vi": "Bỏ đi, Đông Nam cũng không xuất hiện."
  },
  {
    "idx": 7497,
    "start": "03:30:43,494",
    "end": "03:30:45,754",
    "start_sec": 12643.494,
    "end_sec": 12645.754,
    "zh": "先把这小子接过来看看吧",
    "vi": "Cứ đón thằng nhóc này lên xem sao đã."
  },
  {
    "idx": 7498,
    "start": "03:30:45,754",
    "end": "03:30:46,414",
    "start_sec": 12645.754,
    "end_sec": 12646.414,
    "zh": "问问话",
    "vi": "Để hỏi chuyện xem sao."
  },
  {
    "idx": 7499,
    "start": "03:30:46,414",
    "end": "03:30:48,614",
    "start_sec": 12646.414,
    "end_sec": 12648.614,
    "zh": "026点点头也是一回事",
    "vi": "Số 026 gật đầu đồng ý."
  },
  {
    "idx": 7500,
    "start": "03:30:48,614",
    "end": "03:30:50,374",
    "start_sec": 12648.614,
    "end_sec": 12650.374,
    "zh": "河面上现在凝聚出一种",
    "vi": "Trên mặt sông lúc này đang ngưng tụ ra một loại."
  },
  {
    "idx": 7501,
    "start": "03:30:50,374",
    "end": "03:30:54,014",
    "start_sec": 12650.374,
    "end_sec": 12654.014,
    "zh": "小猪小活命就踩着水桥过来",
    "vi": "Trần Tử Bì vì muốn giữ mạng nên đã đi qua cây cầu nước."
  },
  {
    "idx": 7502,
    "start": "03:30:54,014",
    "end": "03:30:55,894",
    "start_sec": 12654.014,
    "end_sec": 12655.894,
    "zh": "长者鞋试探着踩上去",
    "vi": "Trần Tử Bì thử dò dẫm bước lên."
  },
  {
    "idx": 7503,
    "start": "03:30:55,894",
    "end": "03:30:57,194",
    "start_sec": 12655.894,
    "end_sec": 12657.194,
    "zh": "竟然真的能走",
    "vi": "Không ngờ lại thực sự đi được."
  },
  {
    "idx": 7504,
    "start": "03:30:57,194",
    "end": "03:31:00,494",
    "start_sec": 12657.194,
    "end_sec": 12660.494,
    "zh": "看来他就是那个能操控水的御鬼者吧",
    "vi": "Xem ra ông ta chính là Ngự Quỷ Giả có thể điều khiển nước."
  },
  {
    "idx": 7505,
    "start": "03:31:00,494",
    "end": "03:31:02,114",
    "start_sec": 12660.494,
    "end_sec": 12662.114,
    "zh": "长者鞋踩着水桥",
    "vi": "Trần Tử Bì bước đi trên cây cầu nước."
  },
  {
    "idx": 7506,
    "start": "03:31:02,114",
    "end": "03:31:03,514",
    "start_sec": 12662.114,
    "end_sec": 12663.514,
    "zh": "注放于零二流对峙",
    "vi": "đối đầu với số 026."
  },
  {
    "idx": 7507,
    "start": "03:31:03,514",
    "end": "03:31:05,254",
    "start_sec": 12663.514,
    "end_sec": 12665.254,
    "zh": "眼神里并没有多大反击",
    "vi": "Trong ánh mắt không có nhiều sự phản kháng."
  },
  {
    "idx": 7508,
    "start": "03:31:05,254",
    "end": "03:31:06,994",
    "start_sec": 12665.254,
    "end_sec": 12666.994,
    "zh": "上上次死在水里的时候",
    "vi": "Lần trước nữa khi tôi chết dưới nước."
  },
  {
    "idx": 7509,
    "start": "03:31:06,994",
    "end": "03:31:08,194",
    "start_sec": 12666.994,
    "end_sec": 12668.194,
    "zh": "你可是出了不少力",
    "vi": "ông đã góp không ít sức lực đấy."
  },
  {
    "idx": 7510,
    "start": "03:31:08,194",
    "end": "03:31:08,974",
    "start_sec": 12668.194,
    "end_sec": 12668.974,
    "zh": "我可不信",
    "vi": "Tôi không tin."
  },
  {
    "idx": 7511,
    "start": "03:31:08,974",
    "end": "03:31:10,394",
    "start_sec": 12668.974,
    "end_sec": 12670.394,
    "zh": "这不就是单纯的帮我",
    "vi": "đây chỉ đơn thuần là giúp tôi."
  },
  {
    "idx": 7512,
    "start": "03:31:19,194",
    "end": "03:31:19,894",
    "start_sec": 12679.194,
    "end_sec": 12679.894,
    "zh": "这个老者",
    "vi": "Ông lão này."
  },
  {
    "idx": 7513,
    "start": "03:31:19,894",
    "end": "03:31:21,714",
    "start_sec": 12679.894,
    "end_sec": 12681.714,
    "zh": "面貌和徐东来有些相似",
    "vi": "diện mạo có phần giống với Từ Đông Lai."
  },
  {
    "idx": 7514,
    "start": "03:31:21,714",
    "end": "03:31:22,294",
    "start_sec": 12681.714,
    "end_sec": 12682.294,
    "zh": "应该",
    "vi": "Chắc là."
  },
  {
    "idx": 7515,
    "start": "03:31:22,294",
    "end": "03:31:24,254",
    "start_sec": 12682.294,
    "end_sec": 12684.254,
    "zh": "橙子皮当即明白过来什么",
    "vi": "Trần Tử Bì ngay lập tức hiểu ra điều gì đó."
  },
  {
    "idx": 7516,
    "start": "03:31:24,254",
    "end": "03:31:26,214",
    "start_sec": 12684.254,
    "end_sec": 12686.214,
    "zh": "转身朝026报了个见面",
    "vi": "Quay người lại chào hỏi số 026."
  },
  {
    "idx": 7517,
    "start": "03:31:26,214",
    "end": "03:31:27,234",
    "start_sec": 12686.214,
    "end_sec": 12687.234,
    "zh": "多谢领导帮忙",
    "vi": "Đa tạ lãnh đạo đã giúp đỡ."
  },
  {
    "idx": 7518,
    "start": "03:31:27,234",
    "end": "03:31:28,094",
    "start_sec": 12687.234,
    "end_sec": 12688.094,
    "zh": "领导",
    "vi": "Lãnh đạo sao."
  },
  {
    "idx": 7519,
    "start": "03:31:28,094",
    "end": "03:31:28,794",
    "start_sec": 12688.094,
    "end_sec": 12688.794,
    "zh": "小子",
    "vi": "Nhóc con."
  },
  {
    "idx": 7520,
    "start": "03:31:28,794",
    "end": "03:31:30,754",
    "start_sec": 12688.794,
    "end_sec": 12690.754,
    "zh": "你怎么就知道我是领导呢",
    "vi": "sao cậu biết tôi là lãnh đạo."
  },
  {
    "idx": 7521,
    "start": "03:31:30,754",
    "end": "03:31:32,314",
    "start_sec": 12690.754,
    "end_sec": 12692.314,
    "zh": "026看了看橙子皮",
    "vi": "Số 026 nhìn Trần Tử Bì."
  },
  {
    "idx": 7522,
    "start": "03:31:32,314",
    "end": "03:31:34,054",
    "start_sec": 12692.314,
    "end_sec": 12694.054,
    "zh": "眼神停留在他脖子上",
    "vi": "ánh mắt dừng lại trên cổ của cậu ta."
  },
  {
    "idx": 7523,
    "start": "03:31:34,054",
    "end": "03:31:35,014",
    "start_sec": 12694.054,
    "end_sec": 12695.014,
    "zh": "在成语的时候",
    "vi": "Khi ở thành phố."
  },
  {
    "idx": 7524,
    "start": "03:31:35,014",
    "end": "03:31:36,874",
    "start_sec": 12695.014,
    "end_sec": 12696.874,
    "zh": "我有幸遇见037前辈",
    "vi": "tôi có may mắn gặp được tiền bối 037."
  },
  {
    "idx": 7525,
    "start": "03:31:36,874",
    "end": "03:31:38,234",
    "start_sec": 12696.874,
    "end_sec": 12698.234,
    "zh": "得知玉鬼者的存在",
    "vi": "biết được sự tồn tại của Ngự Quỷ Giả."
  },
  {
    "idx": 7526,
    "start": "03:31:38,234",
    "end": "03:31:39,514",
    "start_sec": 12698.234,
    "end_sec": 12699.514,
    "zh": "并且在他的帮助下",
    "vi": "Và dưới sự giúp đỡ của ông ấy."
  },
  {
    "idx": 7527,
    "start": "03:31:39,514",
    "end": "03:31:40,854",
    "start_sec": 12699.514,
    "end_sec": 12700.854,
    "zh": "我融合了一只鬼力",
    "vi": "tôi đã dung hợp được một phần sức mạnh của quỷ."
  },
  {
    "idx": 7528,
    "start": "03:31:40,854",
    "end": "03:31:42,334",
    "start_sec": 12700.854,
    "end_sec": 12702.334,
    "zh": "橙子皮低着头",
    "vi": "Trần Tử Bì cúi đầu."
  },
  {
    "idx": 7529,
    "start": "03:31:42,334",
    "end": "03:31:43,134",
    "start_sec": 12702.334,
    "end_sec": 12703.134,
    "zh": "自取阵作",
    "vi": "tự trấn tĩnh lại."
  },
  {
    "idx": 7530,
    "start": "03:31:43,134",
    "end": "03:31:44,574",
    "start_sec": 12703.134,
    "end_sec": 12704.574,
    "zh": "虽然他已经是玉鬼者",
    "vi": "Mặc dù cậu ta đã là Ngự Quỷ Giả."
  },
  {
    "idx": 7531,
    "start": "03:31:44,574",
    "end": "03:31:46,274",
    "start_sec": 12704.574,
    "end_sec": 12706.274,
    "zh": "但不代表他能横着走呢",
    "vi": "Nhưng không có nghĩa là anh ta có thể lộng hành."
  },
  {
    "idx": 7532,
    "start": "03:31:46,274",
    "end": "03:31:47,874",
    "start_sec": 12706.274,
    "end_sec": 12707.874,
    "zh": "他需要普露自己的优势",
    "vi": "Anh ta cần phải bộc lộ ưu thế của mình."
  },
  {
    "idx": 7533,
    "start": "03:31:47,874",
    "end": "03:31:49,254",
    "start_sec": 12707.874,
    "end_sec": 12709.254,
    "zh": "又不能全盘拖住",
    "vi": "Mà lại không thể để lộ hết bài tẩy."
  },
  {
    "idx": 7534,
    "start": "03:31:49,254",
    "end": "03:31:51,094",
    "start_sec": 12709.254,
    "end_sec": 12711.094,
    "zh": "小子你不是逗我欢",
    "vi": "Nhóc con, cậu không đùa tôi đấy chứ."
  },
  {
    "idx": 7535,
    "start": "03:31:51,094",
    "end": "03:31:53,294",
    "start_sec": 12711.094,
    "end_sec": 12713.294,
    "zh": "037那种人能好心帮你",
    "vi": "Loại người như 037 mà lại tốt bụng giúp cậu sao."
  },
  {
    "idx": 7536,
    "start": "03:31:53,294",
    "end": "03:31:54,794",
    "start_sec": 12713.294,
    "end_sec": 12714.794,
    "zh": "这个我在医院工作",
    "vi": "Chuyện là tôi làm việc ở bệnh viện."
  },
  {
    "idx": 7537,
    "start": "03:31:54,794",
    "end": "03:31:56,354",
    "start_sec": 12714.794,
    "end_sec": 12716.354,
    "zh": "刚好遇到037前辈",
    "vi": "Tình cờ gặp tiền bối 037."
  },
  {
    "idx": 7538,
    "start": "03:31:56,354",
    "end": "03:31:57,494",
    "start_sec": 12716.354,
    "end_sec": 12717.494,
    "zh": "来医院找高层数",
    "vi": "Đến bệnh viện tìm cấp cao."
  },
  {
    "idx": 7539,
    "start": "03:31:57,494",
    "end": "03:31:59,354",
    "start_sec": 12717.494,
    "end_sec": 12719.354,
    "zh": "026你眼看着橙子皮",
    "vi": "026, anh đang nhìn chằm chằm vào Trần Tử Bì."
  },
  {
    "idx": 7540,
    "start": "03:31:59,354",
    "end": "03:32:01,394",
    "start_sec": 12719.354,
    "end_sec": 12721.394,
    "zh": "所以你现在也是遇鬼者了",
    "vi": "Vậy bây giờ cậu cũng là người ngự quỷ rồi."
  },
  {
    "idx": 7541,
    "start": "03:32:01,394",
    "end": "03:32:02,634",
    "start_sec": 12721.394,
    "end_sec": 12722.634,
    "zh": "驾驭的是什么鬼",
    "vi": "Đang ngự con quỷ nào."
  },
  {
    "idx": 7542,
    "start": "03:32:02,634",
    "end": "03:32:03,334",
    "start_sec": 12722.634,
    "end_sec": 12723.334,
    "zh": "什么能力",
    "vi": "Năng lực gì."
  },
  {
    "idx": 7543,
    "start": "03:32:03,334",
    "end": "03:32:03,934",
    "start_sec": 12723.334,
    "end_sec": 12723.934,
    "zh": "我看看",
    "vi": "Để tôi xem."
  },
  {
    "idx": 7544,
    "start": "03:32:03,934",
    "end": "03:32:05,914",
    "start_sec": 12723.934,
    "end_sec": 12725.914,
    "zh": "面对026命令般的语气",
    "vi": "Đối mặt với giọng điệu ra lệnh của 026."
  },
  {
    "idx": 7545,
    "start": "03:32:05,914",
    "end": "03:32:07,334",
    "start_sec": 12725.914,
    "end_sec": 12727.334,
    "zh": "橙子皮没有回避",
    "vi": "Trần Tử Bì không hề né tránh."
  },
  {
    "idx": 7546,
    "start": "03:32:07,334",
    "end": "03:32:09,394",
    "start_sec": 12727.334,
    "end_sec": 12729.394,
    "zh": "领导我的诡异是蚕丝鬼",
    "vi": "Lãnh đạo, con quỷ của tôi là Quỷ Tơ Tằm."
  },
  {
    "idx": 7547,
    "start": "03:32:09,394",
    "end": "03:32:11,334",
    "start_sec": 12729.394,
    "end_sec": 12731.334,
    "zh": "你看到我脖子上这张鬼脸",
    "vi": "Anh nhìn thấy khuôn mặt quỷ trên cổ tôi."
  },
  {
    "idx": 7548,
    "start": "03:32:11,334",
    "end": "03:32:12,674",
    "start_sec": 12731.334,
    "end_sec": 12732.674,
    "zh": "这么痛苦就知道了",
    "vi": "Đang đau đớn thế này là biết rồi."
  },
  {
    "idx": 7549,
    "start": "03:32:12,674",
    "end": "03:32:15,114",
    "start_sec": 12732.674,
    "end_sec": 12735.114,
    "zh": "他的能力是一定程度上的无效化",
    "vi": "Năng lực của nó là vô hiệu hóa ở một mức độ nhất định."
  },
  {
    "idx": 7550,
    "start": "03:32:15,114",
    "end": "03:32:16,814",
    "start_sec": 12735.114,
    "end_sec": 12736.814,
    "zh": "无效化有点意思",
    "vi": "Vô hiệu hóa, cũng thú vị đấy."
  },
  {
    "idx": 7551,
    "start": "03:32:16,814",
    "end": "03:32:18,614",
    "start_sec": 12736.814,
    "end_sec": 12738.614,
    "zh": "你说你得到了037的帮助",
    "vi": "Cậu nói cậu nhận được sự giúp đỡ của 037."
  },
  {
    "idx": 7552,
    "start": "03:32:18,614",
    "end": "03:32:19,534",
    "start_sec": 12738.614,
    "end_sec": 12739.534,
    "zh": "那037",
    "vi": "Vậy còn 037."
  },
  {
    "idx": 7553,
    "start": "03:32:19,534",
    "end": "03:32:21,014",
    "start_sec": 12739.534,
    "end_sec": 12741.014,
    "zh": "037前辈他",
    "vi": "Tiền bối 037 anh ấy."
  },
  {
    "idx": 7554,
    "start": "03:32:21,014",
    "end": "03:32:22,474",
    "start_sec": 12741.014,
    "end_sec": 12742.474,
    "zh": "好像去见一个庙主了",
    "vi": "Hình như đi gặp một vị Miếu Chủ rồi."
  },
  {
    "idx": 7555,
    "start": "03:32:22,474",
    "end": "03:32:23,614",
    "start_sec": 12742.474,
    "end_sec": 12743.614,
    "zh": "如果收到朋友消息",
    "vi": "Vì nhận được tin nhắn của bạn."
  },
  {
    "idx": 7556,
    "start": "03:32:23,614",
    "end": "03:32:25,174",
    "start_sec": 12743.614,
    "end_sec": 12745.174,
    "zh": "说游轮会经过南河桥",
    "vi": "Nói du thuyền sẽ đi qua cầu Nam Hà."
  },
  {
    "idx": 7557,
    "start": "03:32:25,174",
    "end": "03:32:27,034",
    "start_sec": 12745.174,
    "end_sec": 12747.034,
    "zh": "于是与037前辈分开了",
    "vi": "Thế nên tôi đã tách khỏi tiền bối 037."
  },
  {
    "idx": 7558,
    "start": "03:32:27,034",
    "end": "03:32:27,834",
    "start_sec": 12747.034,
    "end_sec": 12747.834,
    "zh": "就来到了这里",
    "vi": "Rồi đến đây."
  },
  {
    "idx": 7559,
    "start": "03:32:27,834",
    "end": "03:32:29,454",
    "start_sec": 12747.834,
    "end_sec": 12749.454,
    "zh": "庙主应该是03",
    "vi": "Miếu Chủ chắc là 03."
  },
  {
    "idx": 7560,
    "start": "03:32:29,454",
    "end": "03:32:31,334",
    "start_sec": 12749.454,
    "end_sec": 12751.334,
    "zh": "02699没在盘问",
    "vi": "026 không hỏi thêm nữa."
  },
  {
    "idx": 7561,
    "start": "03:32:31,334",
    "end": "03:32:32,254",
    "start_sec": 12751.334,
    "end_sec": 12752.254,
    "zh": "似乎在分析",
    "vi": "Dường như đang phân tích."
  },
  {
    "idx": 7562,
    "start": "03:32:32,254",
    "end": "03:32:33,674",
    "start_sec": 12752.254,
    "end_sec": 12753.674,
    "zh": "橙子皮话语里的稀释",
    "vi": "sự thật giả trong lời nói của Trần Tử Bì."
  },
  {
    "idx": 7563,
    "start": "03:32:33,674",
    "end": "03:32:35,234",
    "start_sec": 12753.674,
    "end_sec": 12755.234,
    "zh": "而橙子皮从始至终",
    "vi": "Còn Trần Tử Bì từ đầu đến cuối."
  },
  {
    "idx": 7564,
    "start": "03:32:35,234",
    "end": "03:32:36,634",
    "start_sec": 12755.234,
    "end_sec": 12756.634,
    "zh": "表现的都很合理",
    "vi": "đều thể hiện rất hợp lý."
  },
  {
    "idx": 7565,
    "start": "03:32:36,634",
    "end": "03:32:37,234",
    "start_sec": 12756.634,
    "end_sec": 12757.234,
    "zh": "他很清楚",
    "vi": "Cậu ta biết rất rõ."
  },
  {
    "idx": 7566,
    "start": "03:32:37,234",
    "end": "03:32:38,234",
    "start_sec": 12757.234,
    "end_sec": 12758.234,
    "zh": "如果自己漏见",
    "vi": "nếu bản thân để lộ sơ hở."
  },
  {
    "idx": 7567,
    "start": "03:32:38,234",
    "end": "03:32:39,574",
    "start_sec": 12758.234,
    "end_sec": 12759.574,
    "zh": "将会面临什么下场",
    "vi": "sẽ phải đối mặt với kết cục thế nào."
  },
  {
    "idx": 7568,
    "start": "03:32:39,574",
    "end": "03:32:41,614",
    "start_sec": 12759.574,
    "end_sec": 12761.614,
    "zh": "你说你从朋友那里",
    "vi": "Cậu nói cậu biết từ bạn của mình."
  },
  {
    "idx": 7569,
    "start": "03:32:41,614",
    "end": "03:32:43,554",
    "start_sec": 12761.614,
    "end_sec": 12763.554,
    "zh": "得知游轮要经过南河桥",
    "vi": "rằng du thuyền sẽ đi qua cầu Nam Hà."
  },
  {
    "idx": 7570,
    "start": "03:32:43,554",
    "end": "03:32:44,874",
    "start_sec": 12763.554,
    "end_sec": 12764.874,
    "zh": "你朋友是谁",
    "vi": "Bạn của cậu là ai."
  },
  {
    "idx": 7571,
    "start": "03:32:44,874",
    "end": "03:32:45,674",
    "start_sec": 12764.874,
    "end_sec": 12765.674,
    "zh": "朱洋",
    "vi": "Chu Dương."
  },
  {
    "idx": 7572,
    "start": "03:32:45,674",
    "end": "03:32:47,174",
    "start_sec": 12765.674,
    "end_sec": 12767.174,
    "zh": "你认识周公子",
    "vi": "Cậu quen Chu công tử sao."
  },
  {
    "idx": 7573,
    "start": "03:32:47,174",
    "end": "03:32:48,494",
    "start_sec": 12767.174,
    "end_sec": 12768.494,
    "zh": "以前接触过",
    "vi": "Trước đây từng tiếp xúc qua."
  },
  {
    "idx": 7574,
    "start": "03:32:48,494",
    "end": "03:32:49,294",
    "start_sec": 12768.494,
    "end_sec": 12769.294,
    "zh": "那好",
    "vi": "Được rồi."
  },
  {
    "idx": 7575,
    "start": "03:32:49,294",
    "end": "03:32:50,154",
    "start_sec": 12769.294,
    "end_sec": 12770.154,
    "zh": "我再问你",
    "vi": "Tôi hỏi cậu câu nữa."
  },
  {
    "idx": 7576,
    "start": "03:32:50,154",
    "end": "03:32:53,134",
    "start_sec": 12770.154,
    "end_sec": 12773.134,
    "zh": "你在深山隧道有没有见过一群大学生",
    "vi": "Cậu có từng gặp một nhóm sinh viên ở đường hầm trong núi sâu không."
  },
  {
    "idx": 7577,
    "start": "03:32:53,134",
    "end": "03:32:54,394",
    "start_sec": 12773.134,
    "end_sec": 12774.394,
    "zh": "徐工来也知道",
    "vi": "Từ Công Lai cũng biết."
  },
  {
    "idx": 7578,
    "start": "03:32:54,394",
    "end": "03:32:55,994",
    "start_sec": 12774.394,
    "end_sec": 12775.994,
    "zh": "游轮会经过南河桥",
    "vi": "du thuyền sẽ đi qua cầu Nam Hà."
  },
  {
    "idx": 7579,
    "start": "03:32:55,994",
    "end": "03:32:57,654",
    "start_sec": 12775.994,
    "end_sec": 12777.654,
    "zh": "说明他与船上有联系",
    "vi": "Chứng tỏ ông ta có liên lạc với người trên tàu."
  },
  {
    "idx": 7580,
    "start": "03:32:57,654",
    "end": "03:32:59,854",
    "start_sec": 12777.654,
    "end_sec": 12779.854,
    "zh": "唯一通向南河桥的深山隧道他县",
    "vi": "Đường hầm duy nhất dẫn đến cầu Nam Hà bị sập."
  },
  {
    "idx": 7581,
    "start": "03:32:59,854",
    "end": "03:33:01,274",
    "start_sec": 12779.854,
    "end_sec": 12781.274,
    "zh": "必定会经过加油站",
    "vi": "chắc chắn phải đi qua trạm xăng."
  },
  {
    "idx": 7582,
    "start": "03:33:01,274",
    "end": "03:33:02,394",
    "start_sec": 12781.274,
    "end_sec": 12782.394,
    "zh": "要是说没见过",
    "vi": "Nếu nói chưa từng gặp."
  },
  {
    "idx": 7583,
    "start": "03:33:02,394",
    "end": "03:33:03,674",
    "start_sec": 12782.394,
    "end_sec": 12783.674,
    "zh": "那相当于不打自招",
    "vi": "thì chẳng khác nào tự khai."
  },
  {
    "idx": 7584,
    "start": "03:33:03,674",
    "end": "03:33:06,594",
    "start_sec": 12783.674,
    "end_sec": 12786.594,
    "zh": "现在我的回答也只能真假参半了",
    "vi": "Bây giờ câu trả lời của tôi chỉ có thể nửa thật nửa giả."
  },
  {
    "idx": 7585,
    "start": "03:33:06,594",
    "end": "03:33:07,034",
    "start_sec": 12786.594,
    "end_sec": 12787.034,
    "zh": "见过",
    "vi": "Tôi từng gặp rồi."
  },
  {
    "idx": 7586,
    "start": "03:33:07,034",
    "end": "03:33:08,334",
    "start_sec": 12787.034,
    "end_sec": 12788.334,
    "zh": "那我问你",
    "vi": "Vậy tôi hỏi cậu."
  },
  {
    "idx": 7587,
    "start": "03:33:08,334",
    "end": "03:33:11,754",
    "start_sec": 12788.334,
    "end_sec": 12791.754,
    "zh": "有个高高瘦瘦白色头发的学生现在在哪里",
    "vi": "Có một sinh viên cao gầy tóc trắng hiện đang ở đâu."
  },
  {
    "idx": 7588,
    "start": "03:33:11,754",
    "end": "03:33:13,474",
    "start_sec": 12791.754,
    "end_sec": 12793.474,
    "zh": "您是说徐会长吧",
    "vi": "Ngài đang nói đến Hội trưởng Từ phải không."
  },
  {
    "idx": 7589,
    "start": "03:33:13,474",
    "end": "03:33:14,574",
    "start_sec": 12793.474,
    "end_sec": 12794.574,
    "zh": "你见过他",
    "vi": "Cậu gặp nó rồi sao."
  },
  {
    "idx": 7590,
    "start": "03:33:14,574",
    "end": "03:33:15,634",
    "start_sec": 12794.574,
    "end_sec": 12795.634,
    "zh": "他是我儿子",
    "vi": "Nó là con trai tôi."
  },
  {
    "idx": 7591,
    "start": "03:33:15,634",
    "end": "03:33:17,854",
    "start_sec": 12795.634,
    "end_sec": 12797.854,
    "zh": "我是临江大学校长徐天志",
    "vi": "Tôi là Hiệu trưởng Đại học Lâm Giang, Từ Thiên Chí."
  },
  {
    "idx": 7592,
    "start": "03:33:17,854",
    "end": "03:33:19,934",
    "start_sec": 12797.854,
    "end_sec": 12799.934,
    "zh": "那个徐会长",
    "vi": "Chính là Chủ tịch Từ đó."
  },
  {
    "idx": 7593,
    "start": "03:33:19,934",
    "end": "03:33:22,054",
    "start_sec": 12799.934,
    "end_sec": 12802.054,
    "zh": "徐会长他死了",
    "vi": "Chủ tịch Từ đã chết rồi."
  },
  {
    "idx": 7594,
    "start": "03:33:22,054",
    "end": "03:33:22,974",
    "start_sec": 12802.054,
    "end_sec": 12802.974,
    "zh": "什么",
    "vi": "Cái gì."
  },
  {
    "idx": 7595,
    "start": "03:33:22,974",
    "end": "03:33:23,714",
    "start_sec": 12802.974,
    "end_sec": 12803.714,
    "zh": "小子",
    "vi": "Cậu nhóc."
  },
  {
    "idx": 7596,
    "start": "03:33:23,714",
    "end": "03:33:24,514",
    "start_sec": 12803.714,
    "end_sec": 12804.514,
    "zh": "你说什么",
    "vi": "Cậu nói gì vậy."
  },
  {
    "idx": 7597,
    "start": "03:33:24,514",
    "end": "03:33:26,014",
    "start_sec": 12804.514,
    "end_sec": 12806.014,
    "zh": "东来怎么可能会死",
    "vi": "Đông Lai sao có thể chết được."
  },
  {
    "idx": 7598,
    "start": "03:33:26,014",
    "end": "03:33:26,994",
    "start_sec": 12806.014,
    "end_sec": 12806.994,
    "zh": "一个糟糕",
    "vi": "Thật là tệ."
  },
  {
    "idx": 7599,
    "start": "03:33:26,994",
    "end": "03:33:27,914",
    "start_sec": 12806.994,
    "end_sec": 12807.914,
    "zh": "徐会长",
    "vi": "Chủ tịch Từ."
  },
  {
    "idx": 7600,
    "start": "03:33:27,914",
    "end": "03:33:28,834",
    "start_sec": 12807.914,
    "end_sec": 12808.834,
    "zh": "徐会长",
    "vi": "Chủ tịch Từ."
  },
  {
    "idx": 7601,
    "start": "03:33:28,834",
    "end": "03:33:30,434",
    "start_sec": 12808.834,
    "end_sec": 12810.434,
    "zh": "他是被鬼一害死的呀",
    "vi": "Ông ấy bị Quỷ Nhất hại chết đó."
  },
  {
    "idx": 7602,
    "start": "03:33:30,434",
    "end": "03:33:30,954",
    "start_sec": 12810.434,
    "end_sec": 12810.954,
    "zh": "鬼一",
    "vi": "Quỷ Nhất."
  },
  {
    "idx": 7603,
    "start": "03:33:30,954",
    "end": "03:33:31,414",
    "start_sec": 12810.954,
    "end_sec": 12811.414,
    "zh": "小子",
    "vi": "Cậu nhóc."
  },
  {
    "idx": 7604,
    "start": "03:33:31,414",
    "end": "03:33:33,094",
    "start_sec": 12811.414,
    "end_sec": 12813.094,
    "zh": "你要是不出出个所以然来",
    "vi": "Nếu cậu không nói rõ ràng ra."
  },
  {
    "idx": 7605,
    "start": "03:33:33,094",
    "end": "03:33:33,974",
    "start_sec": 12813.094,
    "end_sec": 12813.974,
    "zh": "我必杀你",
    "vi": "Tôi nhất định sẽ giết cậu."
  },
  {
    "idx": 7606,
    "start": "03:33:33,974",
    "end": "03:33:35,514",
    "start_sec": 12813.974,
    "end_sec": 12815.514,
    "zh": "我与徐会长一见如故",
    "vi": "Tôi và Chủ tịch Từ gặp nhau đã rất thân thiết."
  },
  {
    "idx": 7607,
    "start": "03:33:35,514",
    "end": "03:33:37,414",
    "start_sec": 12815.514,
    "end_sec": 12817.414,
    "zh": "在深山隧道徐会长坦言",
    "vi": "Trong đường hầm núi sâu, Chủ tịch Từ đã thổ lộ."
  },
  {
    "idx": 7608,
    "start": "03:33:37,414",
    "end": "03:33:38,494",
    "start_sec": 12817.414,
    "end_sec": 12818.494,
    "zh": "给我自拍成为",
    "vi": "Hãy chụp ảnh tự sướng cho tôi."
  },
  {
    "idx": 7609,
    "start": "03:33:38,494",
    "end": "03:33:40,874",
    "start_sec": 12818.494,
    "end_sec": 12820.874,
    "zh": "长子提说的会生会走",
    "vi": "Con trai cả nói rằng sẽ sinh ra và đi lại."
  },
  {
    "idx": 7610,
    "start": "03:33:40,874",
    "end": "03:33:42,634",
    "start_sec": 12820.874,
    "end_sec": 12822.634,
    "zh": "似乎就是在叙述真实",
    "vi": "Dường như đang kể lại sự thật."
  },
  {
    "idx": 7611,
    "start": "03:33:42,634",
    "end": "03:33:46,054",
    "start_sec": 12822.634,
    "end_sec": 12826.054,
    "zh": "难道东来真的拜托这小子帮他了",
    "vi": "Chẳng lẽ Đông Lai thực sự nhờ cậu nhóc này giúp đỡ sao."
  },
  {
    "idx": 7612,
    "start": "03:33:46,054",
    "end": "03:33:46,874",
    "start_sec": 12826.054,
    "end_sec": 12826.874,
    "zh": "接着说",
    "vi": "Nói tiếp đi."
  },
  {
    "idx": 7613,
    "start": "03:33:46,874",
    "end": "03:33:48,114",
    "start_sec": 12826.874,
    "end_sec": 12828.114,
    "zh": "徐会长请问我",
    "vi": "Chủ tịch Từ đã hỏi tôi."
  },
  {
    "idx": 7614,
    "start": "03:33:48,114",
    "end": "03:33:48,954",
    "start_sec": 12828.114,
    "end_sec": 12828.954,
    "zh": "要是帮了他",
    "vi": "Nếu tôi giúp ông ấy."
  },
  {
    "idx": 7615,
    "start": "03:33:48,954",
    "end": "03:33:50,494",
    "start_sec": 12828.954,
    "end_sec": 12830.494,
    "zh": "后面上船就能得庇护",
    "vi": "Sau khi lên thuyền sẽ được che chở."
  },
  {
    "idx": 7616,
    "start": "03:33:50,494",
    "end": "03:33:52,914",
    "start_sec": 12830.494,
    "end_sec": 12832.914,
    "zh": "想来应该就是二位的庇护",
    "vi": "Nghĩ mà xem, chắc hẳn là sự che chở của hai người."
  },
  {
    "idx": 7617,
    "start": "03:33:52,914",
    "end": "03:33:53,874",
    "start_sec": 12832.914,
    "end_sec": 12833.874,
    "zh": "说来惭愧",
    "vi": "Thật đáng xấu hổ."
  },
  {
    "idx": 7618,
    "start": "03:33:53,874",
    "end": "03:33:55,554",
    "start_sec": 12833.874,
    "end_sec": 12835.554,
    "zh": "隧道里五炷香早已设计好",
    "vi": "Trong đường hầm, năm nén hương đã được sắp xếp sẵn."
  },
  {
    "idx": 7619,
    "start": "03:33:55,554",
    "end": "03:33:56,634",
    "start_sec": 12835.554,
    "end_sec": 12836.634,
    "zh": "哪里需要我帮忙",
    "vi": "Cần gì tôi phải giúp đỡ chứ."
  },
  {
    "idx": 7620,
    "start": "03:33:56,634",
    "end": "03:33:58,394",
    "start_sec": 12836.634,
    "end_sec": 12838.394,
    "zh": "只是让我们没想到的是",
    "vi": "Chỉ là điều khiến chúng tôi không ngờ tới là."
  },
  {
    "idx": 7621,
    "start": "03:33:58,394",
    "end": "03:33:59,654",
    "start_sec": 12838.394,
    "end_sec": 12839.654,
    "zh": "罗剑前临时变卦",
    "vi": "La Kiếm Tiền đã thay đổi ý định vào phút chót."
  },
  {
    "idx": 7622,
    "start": "03:33:59,654",
    "end": "03:34:02,234",
    "start_sec": 12839.654,
    "end_sec": 12842.234,
    "zh": "并没有说出让徐会长成为遇鬼者的愿望",
    "vi": "Cậu ta không hề ước cho Hội trưởng Từ trở thành người ngự quỷ."
  },
  {
    "idx": 7623,
    "start": "03:34:02,234",
    "end": "03:34:03,234",
    "start_sec": 12842.234,
    "end_sec": 12843.234,
    "zh": "而是突然改口",
    "vi": "Mà đột nhiên thay đổi lời ước."
  },
  {
    "idx": 7624,
    "start": "03:34:03,234",
    "end": "03:34:05,334",
    "start_sec": 12843.234,
    "end_sec": 12845.334,
    "zh": "不希望挖了一辈子隧道的爷爷死了",
    "vi": "Cậu ta không muốn người ông cả đời đào đường hầm của mình sau khi chết."
  },
  {
    "idx": 7625,
    "start": "03:34:05,334",
    "end": "03:34:06,334",
    "start_sec": 12845.334,
    "end_sec": 12846.334,
    "zh": "还堵在隧道里",
    "vi": "Vẫn bị mắc kẹt lại trong đường hầm đó."
  },
  {
    "idx": 7626,
    "start": "03:34:06,334",
    "end": "03:34:08,694",
    "start_sec": 12846.334,
    "end_sec": 12848.694,
    "zh": "于是便让石香鬼打通深山隧道",
    "vi": "Thế là cậu ta đã ước Thạch Hương Quỷ thông suốt đường hầm trong núi sâu."
  },
  {
    "idx": 7627,
    "start": "03:34:08,694",
    "end": "03:34:10,094",
    "start_sec": 12848.694,
    "end_sec": 12850.094,
    "zh": "我这才跑出来的",
    "vi": "Nhờ vậy tôi mới chạy thoát ra ngoài được."
  },
  {
    "idx": 7628,
    "start": "03:34:10,094",
    "end": "03:34:11,434",
    "start_sec": 12850.094,
    "end_sec": 12851.434,
    "zh": "说的倒是像龙像",
    "vi": "Nghe kể thì có vẻ rất hợp lý đấy."
  },
  {
    "idx": 7629,
    "start": "03:34:11,434",
    "end": "03:34:12,774",
    "start_sec": 12851.434,
    "end_sec": 12852.774,
    "zh": "要是你杀了宗岚",
    "vi": "Nếu cậu đã giết Tông Lam."
  },
  {
    "idx": 7630,
    "start": "03:34:12,774",
    "end": "03:34:14,294",
    "start_sec": 12852.774,
    "end_sec": 12854.294,
    "zh": "自己许愿吗",
    "vi": "Thì cậu sẽ tự mình ước đúng không."
  },
  {
    "idx": 7631,
    "start": "03:34:14,294",
    "end": "03:34:14,654",
    "start_sec": 12854.294,
    "end_sec": 12854.654,
    "zh": "愿望",
    "vi": "Ước nguyện sao."
  },
  {
    "idx": 7632,
    "start": "03:34:14,654",
    "end": "03:34:18,209",
    "start_sec": 12854.654,
    "end_sec": 12858.209,
    "zh": "领导,要是我真的进于石山鬼,完全可以用御鬼者的力量,令那些大学生博取愿望,驾驭两只鬼异。",
    "vi": "Thưa sếp, nếu tôi thực sự điều khiển được Thạch Hương Quỷ, tôi hoàn toàn có thể dùng sức mạnh của"
  },
  {
    "idx": 7632,
    "start": "03:34:18,209",
    "end": "03:34:21,594",
    "start_sec": 12858.209,
    "end_sec": 12861.594,
    "zh": "领导,要是我真的进于石山鬼,完全可以用御鬼者的力量,令那些大学生博取愿望,驾驭两只鬼异。",
    "vi": "người ngự quỷ để ép đám sinh viên kia thực hiện điều ước, giúp tôi chế ngự hai con quỷ."
  },
  {
    "idx": 7633,
    "start": "03:34:21,814",
    "end": "03:34:24,534",
    "start_sec": 12861.814,
    "end_sec": 12864.534,
    "zh": "可是您看,我现在像是有两只鬼异的人吗?既然我都不需要鬼异了,我又何必杀徐会长呢?帮助他换取船上的安稳生活,不是更好。",
    "vi": "Nhưng sếp xem, tôi bây giờ trông có giống người sở hữu hai con quỷ không"
  },
  {
    "idx": 7633,
    "start": "03:34:24,534",
    "end": "03:34:27,594",
    "start_sec": 12864.534,
    "end_sec": 12867.594,
    "zh": "可是您看,我现在像是有两只鬼异的人吗?既然我都不需要鬼异了,我又何必杀徐会长呢?帮助他换取船上的安稳生活,不是更好。",
    "vi": "Một khi tôi đã không cần quỷ nữa, thì tôi việc gì phải giết Hội trưởng Từ chứ"
  },
  {
    "idx": 7633,
    "start": "03:34:27,594",
    "end": "03:34:30,654",
    "start_sec": 12867.594,
    "end_sec": 12870.654,
    "zh": "可是您看,我现在像是有两只鬼异的人吗?既然我都不需要鬼异了,我又何必杀徐会长呢?帮助他换取船上的安稳生活,不是更好。",
    "vi": "Giúp ông ấy để đổi lấy một cuộc sống yên ổn trên thuyền không phải tốt hơn sao"
  },
  {
    "idx": 7634,
    "start": "03:34:31,014",
    "end": "03:34:33,994",
    "start_sec": 12871.014,
    "end_sec": 12873.994,
    "zh": "再说,若是我杀了徐会长,我也没胆子上船啊。",
    "vi": "Hơn nữa, nếu tôi giết Hội trưởng Từ, tôi cũng chẳng dám lên thuyền đâu."
  },
  {
    "idx": 7635,
    "start": "03:34:34,274",
    "end": "03:34:36,454",
    "start_sec": 12874.274,
    "end_sec": 12876.454,
    "zh": "接着说,东来是怎么死的?",
    "vi": "Nói tiếp đi, Đông Lai đã chết thế nào."
  },
  {
    "idx": 7636,
    "start": "03:34:36,454",
    "end": "03:34:38,094",
    "start_sec": 12876.454,
    "end_sec": 12878.094,
    "zh": "这个隧道开启后",
    "vi": "Sau khi đường hầm này được mở ra."
  },
  {
    "idx": 7637,
    "start": "03:34:38,094",
    "end": "03:34:39,354",
    "start_sec": 12878.094,
    "end_sec": 12879.354,
    "zh": "十张鬼袭击了我们",
    "vi": "Thạch Hương Quỷ đã tấn công chúng tôi."
  },
  {
    "idx": 7638,
    "start": "03:34:39,354",
    "end": "03:34:41,474",
    "start_sec": 12879.354,
    "end_sec": 12881.474,
    "zh": "徐会长取出一张黄纸避开一截",
    "vi": "Hội trưởng Từ đã lấy ra một tờ giấy vàng để tránh đòn tấn công đó."
  },
  {
    "idx": 7639,
    "start": "03:34:41,474",
    "end": "03:34:42,874",
    "start_sec": 12881.474,
    "end_sec": 12882.874,
    "zh": "而我动用诡异的能力",
    "vi": "Còn tôi thì sử dụng năng lực của quỷ."
  },
  {
    "idx": 7640,
    "start": "03:34:42,874",
    "end": "03:34:44,734",
    "start_sec": 12882.874,
    "end_sec": 12884.734,
    "zh": "跟着跑出隧道来到南河桥",
    "vi": "Rồi chạy thoát khỏi đường hầm để đến cầu Nam Hà."
  },
  {
    "idx": 7641,
    "start": "03:34:44,734",
    "end": "03:34:46,094",
    "start_sec": 12884.734,
    "end_sec": 12886.094,
    "zh": "没想到桥面塌陷",
    "vi": "Không ngờ mặt cầu lại bị sụp đổ."
  },
  {
    "idx": 7642,
    "start": "03:34:46,094",
    "end": "03:34:46,954",
    "start_sec": 12886.094,
    "end_sec": 12886.954,
    "zh": "绝望之际",
    "vi": "Trong lúc tuyệt vọng nhất."
  },
  {
    "idx": 7643,
    "start": "03:34:46,954",
    "end": "03:34:48,454",
    "start_sec": 12886.954,
    "end_sec": 12888.454,
    "zh": "一辆巴士驾驶了过来",
    "vi": "Thì có một chiếc xe buýt chạy đến."
  },
  {
    "idx": 7644,
    "start": "03:34:48,454",
    "end": "03:34:50,594",
    "start_sec": 12888.454,
    "end_sec": 12890.594,
    "zh": "我们推车要坐巴士才能过桥",
    "vi": "Chúng tôi đoán rằng phải đi chiếc xe buýt đó mới qua được cầu."
  },
  {
    "idx": 7645,
    "start": "03:34:50,594",
    "end": "03:34:52,034",
    "start_sec": 12890.594,
    "end_sec": 12892.034,
    "zh": "最后还是冒险上了车",
    "vi": "Cuối cùng chúng tôi vẫn mạo hiểm bước lên xe."
  },
  {
    "idx": 7646,
    "start": "03:34:52,034",
    "end": "03:34:54,614",
    "start_sec": 12892.034,
    "end_sec": 12894.614,
    "zh": "没想到刚一上车就被群鬼围攻",
    "vi": "Không ngờ vừa lên xe đã bị một đàn quỷ vây quanh tấn công."
  },
  {
    "idx": 7647,
    "start": "03:34:54,614",
    "end": "03:34:57,020",
    "start_sec": 12894.614,
    "end_sec": 12897.02,
    "zh": "徐会长又用了一张黄纸逼退诡异到了下车的时候那群鬼再次发作徐会长第三次使用黄纸而我也借着鬼迷的样子想起脑脱我俩本以为这样就能跑到码头",
    "vi": "Hội trưởng Từ lại dùng một tờ giấy vàng để đẩy lùi lũ quỷ"
  },
  {
    "idx": 7647,
    "start": "03:34:57,020",
    "end": "03:35:00,113",
    "start_sec": 12897.02,
    "end_sec": 12900.113,
    "zh": "徐会长又用了一张黄纸逼退诡异到了下车的时候那群鬼再次发作徐会长第三次使用黄纸而我也借着鬼迷的样子想起脑脱我俩本以为这样就能跑到码头",
    "vi": "Đến lúc xuống xe, lũ quỷ đó lại tấn công tiếp, Hội trưởng Từ lần thứ ba dùng"
  },
  {
    "idx": 7647,
    "start": "03:35:00,113",
    "end": "03:35:03,206",
    "start_sec": 12900.113,
    "end_sec": 12903.206,
    "zh": "徐会长又用了一张黄纸逼退诡异到了下车的时候那群鬼再次发作徐会长第三次使用黄纸而我也借着鬼迷的样子想起脑脱我俩本以为这样就能跑到码头",
    "vi": "giấy vàng, còn tôi thì lợi dụng lúc lũ quỷ bị che mắt để tìm cách thoát thân"
  },
  {
    "idx": 7647,
    "start": "03:35:03,206",
    "end": "03:35:05,611",
    "start_sec": 12903.206,
    "end_sec": 12905.611,
    "zh": "徐会长又用了一张黄纸逼退诡异到了下车的时候那群鬼再次发作徐会长第三次使用黄纸而我也借着鬼迷的样子想起脑脱我俩本以为这样就能跑到码头",
    "vi": "Hai chúng tôi vốn tưởng làm vậy là có thể chạy đến bến tàu"
  },
  {
    "idx": 7648,
    "start": "03:35:05,611",
    "end": "03:35:08,031",
    "start_sec": 12905.611,
    "end_sec": 12908.031,
    "zh": "没想到巴士车竟然对我们穷乖不舍",
    "vi": "Không ngờ chiếc xe buýt đó lại đuổi theo chúng tôi không buông."
  },
  {
    "idx": 7649,
    "start": "03:35:08,031",
    "end": "03:35:09,311",
    "start_sec": 12908.031,
    "end_sec": 12909.311,
    "zh": "或许是因为我有黑狗",
    "vi": "Có lẽ là vì tôi có con chó đen bên mình."
  },
  {
    "idx": 7650,
    "start": "03:35:09,311",
    "end": "03:35:10,691",
    "start_sec": 12909.311,
    "end_sec": 12910.691,
    "zh": "又或许我是遇鬼者",
    "vi": "Hoặc cũng có thể là vì tôi là người ngự quỷ."
  },
  {
    "idx": 7651,
    "start": "03:35:10,691",
    "end": "03:35:12,311",
    "start_sec": 12910.691,
    "end_sec": 12912.311,
    "zh": "巴士率先去追徐会长",
    "vi": "Chiếc xe buýt đó đuổi theo Hội trưởng Từ trước."
  },
  {
    "idx": 7652,
    "start": "03:35:12,311",
    "end": "03:35:12,791",
    "start_sec": 12912.311,
    "end_sec": 12912.791,
    "zh": "最后",
    "vi": "Cuối cùng."
  },
  {
    "idx": 7653,
    "start": "03:35:12,791",
    "end": "03:35:13,431",
    "start_sec": 12912.791,
    "end_sec": 12913.431,
    "zh": "小子",
    "vi": "Nhóc con."
  },
  {
    "idx": 7654,
    "start": "03:35:13,431",
    "end": "03:35:15,091",
    "start_sec": 12913.431,
    "end_sec": 12915.091,
    "zh": "我传了你故事编的不错",
    "vi": "Câu chuyện cậu bịa ra cũng khá đấy."
  },
  {
    "idx": 7655,
    "start": "03:35:15,091",
    "end": "03:35:17,071",
    "start_sec": 12915.091,
    "end_sec": 12917.071,
    "zh": "但你的序故里有好几个漏洞",
    "vi": "Nhưng trong lời kể của cậu có vài lỗ hổng."
  },
  {
    "idx": 7656,
    "start": "03:35:17,071",
    "end": "03:35:17,531",
    "start_sec": 12917.071,
    "end_sec": 12917.531,
    "zh": "第一",
    "vi": "Thứ nhất."
  },
  {
    "idx": 7657,
    "start": "03:35:17,531",
    "end": "03:35:19,511",
    "start_sec": 12917.531,
    "end_sec": 12919.511,
    "zh": "如果你看到了东来的主人有用",
    "vi": "Nếu cậu thấy chủ nhân của Đông Lai có ích."
  },
  {
    "idx": 7658,
    "start": "03:35:19,511",
    "end": "03:35:22,231",
    "start_sec": 12919.511,
    "end_sec": 12922.231,
    "zh": "谁能保证你会不会动机于军心杀了他",
    "vi": "Ai dám đảm bảo cậu không nảy sinh ý đồ giết người diệt khẩu."
  },
  {
    "idx": 7659,
    "start": "03:35:22,231",
    "end": "03:35:22,711",
    "start_sec": 12922.231,
    "end_sec": 12922.711,
    "zh": "第二",
    "vi": "Thứ hai."
  },
  {
    "idx": 7660,
    "start": "03:35:22,711",
    "end": "03:35:23,951",
    "start_sec": 12922.711,
    "end_sec": 12923.951,
    "zh": "花是杀了东南省",
    "vi": "Nếu cậu đã giết Đông Lai."
  },
  {
    "idx": 7661,
    "start": "03:35:23,951",
    "end": "03:35:24,751",
    "start_sec": 12923.951,
    "end_sec": 12924.751,
    "zh": "为什么不杀",
    "vi": "Tại sao lại không giết."
  },
  {
    "idx": 7662,
    "start": "03:35:24,751",
    "end": "03:35:26,451",
    "start_sec": 12924.751,
    "end_sec": 12926.451,
    "zh": "你的话洗不清你的嫌疑",
    "vi": "Lời nói của cậu không xóa sạch được nghi ngờ."
  },
  {
    "idx": 7663,
    "start": "03:35:26,451",
    "end": "03:35:28,351",
    "start_sec": 12926.451,
    "end_sec": 12928.351,
    "zh": "你后续曙光号的囚禁室",
    "vi": "Cậu sẽ bị nhốt vào phòng giam trên tàu Thự Quang."
  },
  {
    "idx": 7664,
    "start": "03:35:28,351",
    "end": "03:35:29,071",
    "start_sec": 12928.351,
    "end_sec": 12929.071,
    "zh": "到了京市",
    "vi": "Khi đến Kinh Thị."
  },
  {
    "idx": 7665,
    "start": "03:35:29,071",
    "end": "03:35:30,871",
    "start_sec": 12929.071,
    "end_sec": 12930.871,
    "zh": "自然有专门的精神内翼回復",
    "vi": "Tự nhiên sẽ có chuyên gia tâm lý đến thẩm vấn."
  },
  {
    "idx": 7666,
    "start": "03:35:30,871",
    "end": "03:35:32,411",
    "start_sec": 12930.871,
    "end_sec": 12932.411,
    "zh": "所以你讲的太多了",
    "vi": "Cho nên cậu đã nói quá nhiều rồi."
  },
  {
    "idx": 7667,
    "start": "03:35:32,411",
    "end": "03:35:33,891",
    "start_sec": 12932.411,
    "end_sec": 12933.891,
    "zh": "囚禁室肯定不能去",
    "vi": "Chắc chắn không thể vào phòng giam đó."
  },
  {
    "idx": 7668,
    "start": "03:35:33,891",
    "end": "03:35:35,311",
    "start_sec": 12933.891,
    "end_sec": 12935.311,
    "zh": "等到了京市被审讯",
    "vi": "Đợi đến Kinh Thị bị thẩm vấn."
  },
  {
    "idx": 7669,
    "start": "03:35:35,311",
    "end": "03:35:36,731",
    "start_sec": 12935.311,
    "end_sec": 12936.731,
    "zh": "最后还是玩独自",
    "vi": "Cuối cùng vẫn là tự mình chịu khổ."
  },
  {
    "idx": 7670,
    "start": "03:35:36,731",
    "end": "03:35:38,151",
    "start_sec": 12936.731,
    "end_sec": 12938.151,
    "zh": "看来又要重开了",
    "vi": "Xem ra lại phải bắt đầu lại từ đầu rồi."
  },
  {
    "idx": 7671,
    "start": "03:35:38,151",
    "end": "03:35:39,971",
    "start_sec": 12938.151,
    "end_sec": 12939.971,
    "zh": "长者提退到船舷地上",
    "vi": "Tôi lùi lại phía mạn tàu."
  },
  {
    "idx": 7672,
    "start": "03:35:39,971",
    "end": "03:35:41,531",
    "start_sec": 12939.971,
    "end_sec": 12941.531,
    "zh": "正准备跳船跑路时",
    "vi": "Đang chuẩn bị nhảy tàu bỏ trốn."
  },
  {
    "idx": 7673,
    "start": "03:35:41,531",
    "end": "03:35:43,631",
    "start_sec": 12941.531,
    "end_sec": 12943.631,
    "zh": "一道中气十足的话音传来",
    "vi": "Thì một giọng nói đầy uy lực vang lên."
  },
  {
    "idx": 7674,
    "start": "03:35:43,631",
    "end": "03:35:44,471",
    "start_sec": 12943.631,
    "end_sec": 12944.471,
    "zh": "够了",
    "vi": "Đủ rồi."
  },
  {
    "idx": 7675,
    "start": "03:35:44,471",
    "end": "03:35:45,091",
    "start_sec": 12944.471,
    "end_sec": 12945.091,
    "zh": "026",
    "vi": "Không hai sáu."
  },
  {
    "idx": 7676,
    "start": "03:35:45,091",
    "end": "03:35:46,711",
    "start_sec": 12945.091,
    "end_sec": 12946.711,
    "zh": "你以为你是谁啊",
    "vi": "Cậu nghĩ cậu là ai chứ."
  },
  {
    "idx": 7677,
    "start": "03:35:46,711",
    "end": "03:35:47,411",
    "start_sec": 12946.711,
    "end_sec": 12947.411,
    "zh": "023",
    "vi": "Không hai ba."
  },
  {
    "idx": 7678,
    "start": "03:35:47,411",
    "end": "03:35:48,731",
    "start_sec": 12947.411,
    "end_sec": 12948.731,
    "zh": "你来管什么闲事",
    "vi": "Cậu xen vào chuyện này làm gì."
  },
  {
    "idx": 7679,
    "start": "03:35:48,731",
    "end": "03:35:49,711",
    "start_sec": 12948.731,
    "end_sec": 12949.711,
    "zh": "这里没你的事",
    "vi": "Ở đây không có việc của cậu."
  },
  {
    "idx": 7680,
    "start": "03:35:49,711",
    "end": "03:35:50,831",
    "start_sec": 12949.711,
    "end_sec": 12950.831,
    "zh": "没我的事",
    "vi": "Không có việc của tôi sao."
  },
  {
    "idx": 7681,
    "start": "03:35:50,831",
    "end": "03:35:53,091",
    "start_sec": 12950.831,
    "end_sec": 12953.091,
    "zh": "这上船的人是归上级管",
    "vi": "Những người lên tàu này thuộc quyền quản lý của cấp trên"
  },
  {
    "idx": 7682,
    "start": "03:35:53,091",
    "end": "03:35:54,911",
    "start_sec": 12953.091,
    "end_sec": 12954.911,
    "zh": "而不是你026单独管",
    "vi": "chứ không phải chỉ mình anh 026 quản lý"
  },
  {
    "idx": 7683,
    "start": "03:35:54,911",
    "end": "03:35:55,471",
    "start_sec": 12954.911,
    "end_sec": 12955.471,
    "zh": "好",
    "vi": "Được"
  },
  {
    "idx": 7684,
    "start": "03:35:55,471",
    "end": "03:35:56,511",
    "start_sec": 12955.471,
    "end_sec": 12956.511,
    "zh": "你不知道吗",
    "vi": "Anh không biết sao"
  },
  {
    "idx": 7685,
    "start": "03:35:56,511",
    "end": "03:35:58,271",
    "start_sec": 12956.511,
    "end_sec": 12958.271,
    "zh": "这家伙可能杀了我唐太太",
    "vi": "Tên này có thể đã giết bà Đường rồi"
  },
  {
    "idx": 7686,
    "start": "03:35:58,271",
    "end": "03:35:58,951",
    "start_sec": 12958.271,
    "end_sec": 12958.951,
    "zh": "哦",
    "vi": "Ồ"
  },
  {
    "idx": 7687,
    "start": "03:35:58,951",
    "end": "03:36:00,831",
    "start_sec": 12958.951,
    "end_sec": 12960.831,
    "zh": "你这不是挺清醒的吗",
    "vi": "Anh không tỉnh táo lắm sao"
  },
  {
    "idx": 7688,
    "start": "03:36:00,831",
    "end": "03:36:02,071",
    "start_sec": 12960.831,
    "end_sec": 12962.071,
    "zh": "只是可能而已",
    "vi": "Chỉ là có thể thôi"
  },
  {
    "idx": 7689,
    "start": "03:36:02,071",
    "end": "03:36:03,251",
    "start_sec": 12962.071,
    "end_sec": 12963.251,
    "zh": "023你",
    "vi": "Anh 023 này"
  },
  {
    "idx": 7690,
    "start": "03:36:03,251",
    "end": "03:36:04,351",
    "start_sec": 12963.251,
    "end_sec": 12964.351,
    "zh": "多大点事",
    "vi": "Có chuyện gì to tát đâu"
  },
  {
    "idx": 7691,
    "start": "03:36:04,351",
    "end": "03:36:06,631",
    "start_sec": 12964.351,
    "end_sec": 12966.631,
    "zh": "你不是怀疑这小子说谎吗",
    "vi": "Anh không nghi ngờ tên này nói dối sao"
  },
  {
    "idx": 7692,
    "start": "03:36:06,631",
    "end": "03:36:07,831",
    "start_sec": 12966.631,
    "end_sec": 12967.831,
    "zh": "我有办法查",
    "vi": "Tôi có cách để điều tra"
  },
  {
    "idx": 7693,
    "start": "03:36:07,831",
    "end": "03:36:10,071",
    "start_sec": 12967.831,
    "end_sec": 12970.071,
    "zh": "小子",
    "vi": "Này nhóc"
  },
  {
    "idx": 7694,
    "start": "03:36:10,071",
    "end": "03:36:11,071",
    "start_sec": 12970.071,
    "end_sec": 12971.071,
    "zh": "必行检查",
    "vi": "Sẽ kiểm tra ngay thôi"
  },
  {
    "idx": 7695,
    "start": "03:36:11,071",
    "end": "03:36:12,351",
    "start_sec": 12971.071,
    "end_sec": 12972.351,
    "zh": "心里没鬼的话",
    "vi": "Nếu không có gì mờ ám"
  },
  {
    "idx": 7696,
    "start": "03:36:12,351",
    "end": "03:36:13,351",
    "start_sec": 12972.351,
    "end_sec": 12973.351,
    "zh": "就别抗拒",
    "vi": "Thì đừng chống cự"
  },
  {
    "idx": 7697,
    "start": "03:36:13,351",
    "end": "03:36:15,371",
    "start_sec": 12973.351,
    "end_sec": 12975.371,
    "zh": "直接023吐出一口香烟",
    "vi": "Anh 023 nhả ra một ngụm khói"
  },
  {
    "idx": 7698,
    "start": "03:36:15,371",
    "end": "03:36:17,411",
    "start_sec": 12975.371,
    "end_sec": 12977.411,
    "zh": "烟雾将长嘴皮浑身包裹",
    "vi": "Khói bao phủ lấy anh ta"
  },
  {
    "idx": 7699,
    "start": "03:36:17,411",
    "end": "03:36:19,191",
    "start_sec": 12977.411,
    "end_sec": 12979.191,
    "zh": "在他体表游走一圈后台",
    "vi": "Lượn một vòng trên cơ thể rồi"
  },
  {
    "idx": 7700,
    "start": "03:36:19,191",
    "end": "03:36:20,051",
    "start_sec": 12979.191,
    "end_sec": 12980.051,
    "zh": "缓缓站起",
    "vi": "Từ từ đứng dậy"
  },
  {
    "idx": 7701,
    "start": "03:36:20,051",
    "end": "03:36:23,491",
    "start_sec": 12980.051,
    "end_sec": 12983.491,
    "zh": "他身上没有任何替身指人存留的痕迹",
    "vi": "Trên người anh ta không có dấu vết nào của người đại diện hay dấu hiệu của sự tồn tại"
  },
  {
    "idx": 7702,
    "start": "03:36:23,491",
    "end": "03:36:25,391",
    "start_sec": 12983.491,
    "end_sec": 12985.391,
    "zh": "也没有石香鬼的香味",
    "vi": "Cũng không có mùi hương của quỷ đá"
  },
  {
    "idx": 7703,
    "start": "03:36:25,391",
    "end": "03:36:26,231",
    "start_sec": 12985.391,
    "end_sec": 12986.231,
    "zh": "也就是说",
    "vi": "Nói cách khác"
  },
  {
    "idx": 7704,
    "start": "03:36:26,231",
    "end": "03:36:27,851",
    "start_sec": 12986.231,
    "end_sec": 12987.851,
    "zh": "他一没有得到石香鬼",
    "vi": "Anh ta không có quỷ đá"
  },
  {
    "idx": 7705,
    "start": "03:36:27,851",
    "end": "03:36:29,471",
    "start_sec": 12987.851,
    "end_sec": 12989.471,
    "zh": "二没有得到替身指人",
    "vi": "Cũng không có người đại diện"
  },
  {
    "idx": 7706,
    "start": "03:36:29,471",
    "end": "03:36:29,991",
    "start_sec": 12989.471,
    "end_sec": 12989.991,
    "zh": "你说",
    "vi": "Anh nói xem"
  },
  {
    "idx": 7707,
    "start": "03:36:29,991",
    "end": "03:36:33,131",
    "start_sec": 12989.991,
    "end_sec": 12993.131,
    "zh": "他为什么要好端端的去杀徐东来呢",
    "vi": "Tại sao anh ta lại đi giết Từ Đông Lai chứ"
  },
  {
    "idx": 7708,
    "start": "03:36:33,131",
    "end": "03:36:34,251",
    "start_sec": 12993.131,
    "end_sec": 12994.251,
    "zh": "还有一种可能",
    "vi": "Còn một khả năng nữa"
  },
  {
    "idx": 7709,
    "start": "03:36:34,251",
    "end": "03:36:35,631",
    "start_sec": 12994.251,
    "end_sec": 12995.631,
    "zh": "他用掉了替身指人",
    "vi": "Anh ta đã dùng hết người đại diện"
  },
  {
    "idx": 7710,
    "start": "03:36:35,631",
    "end": "03:36:36,451",
    "start_sec": 12995.631,
    "end_sec": 12996.451,
    "zh": "够了",
    "vi": "Đủ rồi"
  },
  {
    "idx": 7711,
    "start": "03:36:36,451",
    "end": "03:36:37,831",
    "start_sec": 12996.451,
    "end_sec": 12997.831,
    "zh": "那指人没有咒语",
    "vi": "Người giấy đó không có thần chú."
  },
  {
    "idx": 7712,
    "start": "03:36:37,831",
    "end": "03:36:39,091",
    "start_sec": 12997.831,
    "end_sec": 12999.091,
    "zh": "你觉得他能用",
    "vi": "Anh nghĩ cậu ta có thể dùng được sao."
  },
  {
    "idx": 7713,
    "start": "03:36:39,091",
    "end": "03:36:40,671",
    "start_sec": 12999.091,
    "end_sec": 13000.671,
    "zh": "你觉得这小子",
    "vi": "Anh nghĩ thằng nhóc này."
  },
  {
    "idx": 7714,
    "start": "03:36:40,671",
    "end": "03:36:41,611",
    "start_sec": 13000.671,
    "end_sec": 13001.611,
    "zh": "不好说",
    "vi": "Khó nói lắm."
  },
  {
    "idx": 7715,
    "start": "03:36:41,611",
    "end": "03:36:43,491",
    "start_sec": 13001.611,
    "end_sec": 13003.491,
    "zh": "他知道的东西太多了",
    "vi": "Cậu ta biết quá nhiều thứ."
  },
  {
    "idx": 7716,
    "start": "03:36:43,491",
    "end": "03:36:45,911",
    "start_sec": 13003.491,
    "end_sec": 13005.911,
    "zh": "短短几天确实不可能知道这些",
    "vi": "Chỉ trong vài ngày ngắn ngủi quả thực không thể biết được những điều này."
  },
  {
    "idx": 7717,
    "start": "03:36:45,911",
    "end": "03:36:47,791",
    "start_sec": 13005.911,
    "end_sec": 13007.791,
    "zh": "除非是东来和他说的",
    "vi": "Trừ khi là Đông Lai đã nói với cậu ta."
  },
  {
    "idx": 7718,
    "start": "03:36:47,791",
    "end": "03:36:48,191",
    "start_sec": 13007.791,
    "end_sec": 13008.191,
    "zh": "还有",
    "vi": "Hơn nữa."
  },
  {
    "idx": 7719,
    "start": "03:36:48,191",
    "end": "03:36:49,531",
    "start_sec": 13008.191,
    "end_sec": 13009.531,
    "zh": "他也没有指人",
    "vi": "Cậu ta cũng không có người giấy."
  },
  {
    "idx": 7720,
    "start": "03:36:49,531",
    "end": "03:36:51,831",
    "start_sec": 13009.531,
    "end_sec": 13011.831,
    "zh": "我总觉得这小子不对劲",
    "vi": "Tôi cứ cảm thấy thằng nhóc này có gì đó không ổn."
  },
  {
    "idx": 7721,
    "start": "03:36:51,831",
    "end": "03:36:52,531",
    "start_sec": 13011.831,
    "end_sec": 13012.531,
    "zh": "够了",
    "vi": "Đủ rồi."
  },
  {
    "idx": 7722,
    "start": "03:36:52,531",
    "end": "03:36:53,691",
    "start_sec": 13012.531,
    "end_sec": 13013.691,
    "zh": "没有任何证据",
    "vi": "Không có bất kỳ bằng chứng nào."
  },
  {
    "idx": 7723,
    "start": "03:36:53,691",
    "end": "03:36:54,931",
    "start_sec": 13013.691,
    "end_sec": 13014.931,
    "zh": "没有任何线索",
    "vi": "Cũng không có bất kỳ manh mối nào."
  },
  {
    "idx": 7724,
    "start": "03:36:54,931",
    "end": "03:36:56,871",
    "start_sec": 13014.931,
    "end_sec": 13016.871,
    "zh": "你们就没有资格怀疑他",
    "vi": "Các anh không có tư cách để nghi ngờ cậu ta."
  },
  {
    "idx": 7725,
    "start": "03:36:56,871",
    "end": "03:36:57,351",
    "start_sec": 13016.871,
    "end_sec": 13017.351,
    "zh": "喂",
    "vi": "Này."
  },
  {
    "idx": 7726,
    "start": "03:36:57,351",
    "end": "03:36:58,111",
    "start_sec": 13017.351,
    "end_sec": 13018.111,
    "zh": "我说023",
    "vi": "Tôi nói này 023."
  },
  {
    "idx": 7727,
    "start": "03:36:58,111",
    "end": "03:36:59,991",
    "start_sec": 13018.111,
    "end_sec": 13019.991,
    "zh": "你是不是故意偏袒他",
    "vi": "Có phải anh đang cố ý thiên vị cậu ta không."
  },
  {
    "idx": 7728,
    "start": "03:36:59,991",
    "end": "03:37:01,371",
    "start_sec": 13019.991,
    "end_sec": 13021.371,
    "zh": "你就当是吧",
    "vi": "Anh cứ coi là vậy đi."
  },
  {
    "idx": 7729,
    "start": "03:37:01,371",
    "end": "03:37:02,611",
    "start_sec": 13021.371,
    "end_sec": 13022.611,
    "zh": "刚刚我也听到了",
    "vi": "Vừa rồi tôi cũng nghe thấy rồi."
  },
  {
    "idx": 7730,
    "start": "03:37:02,611",
    "end": "03:37:04,571",
    "start_sec": 13022.611,
    "end_sec": 13024.571,
    "zh": "这小子的能力有点特殊",
    "vi": "Năng lực của thằng nhóc này hơi đặc biệt."
  },
  {
    "idx": 7731,
    "start": "03:37:04,571",
    "end": "03:37:05,451",
    "start_sec": 13024.571,
    "end_sec": 13025.451,
    "zh": "你知道的",
    "vi": "Anh biết đấy."
  },
  {
    "idx": 7732,
    "start": "03:37:05,451",
    "end": "03:37:06,751",
    "start_sec": 13025.451,
    "end_sec": 13026.751,
    "zh": "如果探索鬼域",
    "vi": "Nếu muốn khám phá lãnh địa quỷ."
  },
  {
    "idx": 7733,
    "start": "03:37:06,751",
    "end": "03:37:08,131",
    "start_sec": 13026.751,
    "end_sec": 13028.131,
    "zh": "它可是有大作用",
    "vi": "Cậu ta sẽ giúp ích rất nhiều."
  },
  {
    "idx": 7734,
    "start": "03:37:08,131",
    "end": "03:37:09,871",
    "start_sec": 13028.131,
    "end_sec": 13029.871,
    "zh": "026能两咖的重点",
    "vi": "026 bị nói trúng tim đen."
  },
  {
    "idx": 7735,
    "start": "03:37:09,871",
    "end": "03:37:11,311",
    "start_sec": 13029.871,
    "end_sec": 13031.311,
    "zh": "彻底没了脾气",
    "vi": "Hoàn toàn không còn phản kháng."
  },
  {
    "idx": 7736,
    "start": "03:37:11,311",
    "end": "03:37:13,091",
    "start_sec": 13031.311,
    "end_sec": 13033.091,
    "zh": "带着颓废的徐春这种事",
    "vi": "Đối với một Từ Xuân đang suy sụp."
  },
  {
    "idx": 7737,
    "start": "03:37:13,091",
    "end": "03:37:13,871",
    "start_sec": 13033.091,
    "end_sec": 13033.871,
    "zh": "我操",
    "vi": "Mẹ kiếp."
  },
  {
    "idx": 7738,
    "start": "03:37:13,871",
    "end": "03:37:15,671",
    "start_sec": 13033.871,
    "end_sec": 13035.671,
    "zh": "还好我把指人都献计了",
    "vi": "May mà tôi đã đem hiến tế người giấy rồi."
  },
  {
    "idx": 7739,
    "start": "03:37:15,671",
    "end": "03:37:16,871",
    "start_sec": 13035.671,
    "end_sec": 13036.871,
    "zh": "不然刚刚被抓包",
    "vi": "Nếu không vừa rồi mà bị bắt quả tang."
  },
  {
    "idx": 7740,
    "start": "03:37:16,871",
    "end": "03:37:18,051",
    "start_sec": 13036.871,
    "end_sec": 13038.051,
    "zh": "就必死无疑了",
    "vi": "Thì chắc chắn sẽ chết."
  },
  {
    "idx": 7741,
    "start": "03:37:18,051",
    "end": "03:37:19,891",
    "start_sec": 13038.051,
    "end_sec": 13039.891,
    "zh": "不谢领导帮忙",
    "vi": "Không cần cảm ơn tôi đã giúp đỡ."
  },
  {
    "idx": 7742,
    "start": "03:37:19,891",
    "end": "03:37:20,491",
    "start_sec": 13039.891,
    "end_sec": 13040.491,
    "zh": "小事",
    "vi": "Chuyện nhỏ thôi."
  },
  {
    "idx": 7743,
    "start": "03:37:20,491",
    "end": "03:37:21,151",
    "start_sec": 13040.491,
    "end_sec": 13041.151,
    "zh": "对了",
    "vi": "Đúng rồi."
  },
  {
    "idx": 7744,
    "start": "03:37:21,151",
    "end": "03:37:22,031",
    "start_sec": 13041.151,
    "end_sec": 13042.031,
    "zh": "跟我来吧",
    "vi": "Đi theo tôi."
  },
  {
    "idx": 7745,
    "start": "03:37:22,031",
    "end": "03:37:23,211",
    "start_sec": 13042.031,
    "end_sec": 13043.211,
    "zh": "有人要见你",
    "vi": "Có người muốn gặp cậu."
  },
  {
    "idx": 7746,
    "start": "03:37:23,211",
    "end": "03:37:23,811",
    "start_sec": 13043.211,
    "end_sec": 13043.811,
    "zh": "谁",
    "vi": "Ai thế."
  },
  {
    "idx": 7747,
    "start": "03:37:23,811",
    "end": "03:37:24,811",
    "start_sec": 13043.811,
    "end_sec": 13044.811,
    "zh": "周扬",
    "vi": "Chu Dương."
  },
  {
    "idx": 7748,
    "start": "03:37:24,811",
    "end": "03:37:29,151",
    "start_sec": 13044.811,
    "end_sec": 13049.151,
    "zh": "周扬",
    "vi": "Chu Dương."
  },
  {
    "idx": 7749,
    "start": "03:37:29,151",
    "end": "03:37:30,591",
    "start_sec": 13049.151,
    "end_sec": 13050.591,
    "zh": "领导",
    "vi": "Lãnh đạo."
  },
  {
    "idx": 7750,
    "start": "03:37:30,591",
    "end": "03:37:32,351",
    "start_sec": 13050.591,
    "end_sec": 13052.351,
    "zh": "您是周市长的人",
    "vi": "Ngài là người của Thị trưởng Chu sao."
  },
  {
    "idx": 7751,
    "start": "03:37:32,351",
    "end": "03:37:33,691",
    "start_sec": 13052.351,
    "end_sec": 13053.691,
    "zh": "什么谁的人",
    "vi": "Người của ai cái gì chứ."
  },
  {
    "idx": 7752,
    "start": "03:37:33,691",
    "end": "03:37:35,091",
    "start_sec": 13053.691,
    "end_sec": 13055.091,
    "zh": "只不过是你重要",
    "vi": "Chỉ là vì cậu quan trọng."
  },
  {
    "idx": 7753,
    "start": "03:37:35,091",
    "end": "03:37:36,951",
    "start_sec": 13055.091,
    "end_sec": 13056.951,
    "zh": "顺带做个人情罢了",
    "vi": "Nên tiện thể bán cho ông ta một ân tình thôi."
  },
  {
    "idx": 7754,
    "start": "03:37:36,951",
    "end": "03:37:37,491",
    "start_sec": 13056.951,
    "end_sec": 13057.491,
    "zh": "恰好",
    "vi": "Vừa hay."
  },
  {
    "idx": 7755,
    "start": "03:37:37,491",
    "end": "03:37:38,931",
    "start_sec": 13057.491,
    "end_sec": 13058.931,
    "zh": "刚刚周公子也过来",
    "vi": "Vừa rồi công tử nhà họ Chu cũng qua đây."
  },
  {
    "idx": 7756,
    "start": "03:37:38,931",
    "end": "03:37:39,611",
    "start_sec": 13058.931,
    "end_sec": 13059.611,
    "zh": "喊我捞你",
    "vi": "Bảo tôi cứu cậu ra."
  },
  {
    "idx": 7757,
    "start": "03:37:39,611",
    "end": "03:37:40,191",
    "start_sec": 13059.611,
    "end_sec": 13060.191,
    "zh": "哦",
    "vi": "Ồ."
  },
  {
    "idx": 7758,
    "start": "03:37:40,191",
    "end": "03:37:41,191",
    "start_sec": 13060.191,
    "end_sec": 13061.191,
    "zh": "是这样啊",
    "vi": "Hóa ra là vậy."
  },
  {
    "idx": 7759,
    "start": "03:37:41,191",
    "end": "03:37:42,311",
    "start_sec": 13061.191,
    "end_sec": 13062.311,
    "zh": "长子提默默跟在",
    "vi": "Chử Tử Bì lẳng lặng đi theo."
  },
  {
    "idx": 7760,
    "start": "03:37:42,311",
    "end": "03:37:43,131",
    "start_sec": 13062.311,
    "end_sec": 13063.131,
    "zh": "零二三身后",
    "vi": "Phía sau số 023."
  },
  {
    "idx": 7761,
    "start": "03:37:43,131",
    "end": "03:37:43,911",
    "start_sec": 13063.131,
    "end_sec": 13063.911,
    "zh": "经过一个",
    "vi": "Đi qua một."
  },
  {
    "idx": 7762,
    "start": "03:37:43,911",
    "end": "03:37:45,291",
    "start_sec": 13063.911,
    "end_sec": 13065.291,
    "zh": "可以左右通行的大厅",
    "vi": "Sảnh lớn có lối đi hai bên."
  },
  {
    "idx": 7763,
    "start": "03:37:45,291",
    "end": "03:37:46,151",
    "start_sec": 13065.291,
    "end_sec": 13066.151,
    "zh": "大厅里",
    "vi": "Trong sảnh."
  },
  {
    "idx": 7764,
    "start": "03:37:46,151",
    "end": "03:37:47,591",
    "start_sec": 13066.151,
    "end_sec": 13067.591,
    "zh": "零零散散坐着一些人",
    "vi": "Có vài người ngồi rải rác."
  },
  {
    "idx": 7765,
    "start": "03:37:47,591",
    "end": "03:37:49,031",
    "start_sec": 13067.591,
    "end_sec": 13069.031,
    "zh": "惊恐的谈论些什么",
    "vi": "Đang hoảng sợ bàn tán điều gì đó."
  },
  {
    "idx": 7766,
    "start": "03:37:49,031",
    "end": "03:37:50,471",
    "start_sec": 13069.031,
    "end_sec": 13070.471,
    "zh": "一见橙子皮进来",
    "vi": "Vừa thấy Chử Tử Bì đi vào."
  },
  {
    "idx": 7767,
    "start": "03:37:50,471",
    "end": "03:37:51,851",
    "start_sec": 13070.471,
    "end_sec": 13071.851,
    "zh": "都投来好奇的目光",
    "vi": "Đều đổ dồn ánh mắt tò mò về phía anh."
  },
  {
    "idx": 7768,
    "start": "03:37:51,851",
    "end": "03:37:52,831",
    "start_sec": 13071.851,
    "end_sec": 13072.831,
    "zh": "掠过大厅",
    "vi": "Băng qua sảnh lớn."
  },
  {
    "idx": 7769,
    "start": "03:37:52,831",
    "end": "03:37:55,331",
    "start_sec": 13072.831,
    "end_sec": 13075.331,
    "zh": "023带着橙子皮来到电池间",
    "vi": "023 dẫn Chử Tử Bì đến phòng pin."
  },
  {
    "idx": 7770,
    "start": "03:37:55,331",
    "end": "03:37:57,391",
    "start_sec": 13075.331,
    "end_sec": 13077.391,
    "zh": "一楼出去吃饭",
    "vi": "Đi ra ngoài ăn cơm ở tầng một."
  },
  {
    "idx": 7771,
    "start": "03:37:57,391",
    "end": "03:37:59,171",
    "start_sec": 13077.391,
    "end_sec": 13079.171,
    "zh": "就是些普通人住的地方",
    "vi": "Chỉ là nơi ở của những người bình thường."
  },
  {
    "idx": 7772,
    "start": "03:37:59,171",
    "end": "03:38:00,691",
    "start_sec": 13079.171,
    "end_sec": 13080.691,
    "zh": "二楼是重要人员",
    "vi": "Tầng hai là nơi ở của những nhân sự quan trọng."
  },
  {
    "idx": 7773,
    "start": "03:38:00,691",
    "end": "03:38:02,211",
    "start_sec": 13080.691,
    "end_sec": 13082.211,
    "zh": "以及遇鬼者的居住地",
    "vi": "Và cũng là nơi ở của những người từng gặp ma."
  },
  {
    "idx": 7774,
    "start": "03:38:02,211",
    "end": "03:38:03,671",
    "start_sec": 13082.211,
    "end_sec": 13083.671,
    "zh": "你以后就住二楼吧",
    "vi": "Sau này cậu cứ ở tầng hai đi."
  },
  {
    "idx": 7775,
    "start": "03:38:03,671",
    "end": "03:38:04,831",
    "start_sec": 13083.671,
    "end_sec": 13084.831,
    "zh": "我给你安排地方",
    "vi": "Tôi sẽ sắp xếp chỗ cho cậu."
  },
  {
    "idx": 7776,
    "start": "03:38:04,831",
    "end": "03:38:05,991",
    "start_sec": 13084.831,
    "end_sec": 13085.991,
    "zh": "麻烦您了",
    "vi": "Làm phiền anh rồi."
  },
  {
    "idx": 7777,
    "start": "03:38:05,991",
    "end": "03:38:06,511",
    "start_sec": 13085.991,
    "end_sec": 13086.511,
    "zh": "领导",
    "vi": "Thưa lãnh đạo."
  },
  {
    "idx": 7778,
    "start": "03:38:06,511",
    "end": "03:38:08,051",
    "start_sec": 13086.511,
    "end_sec": 13088.051,
    "zh": "看来周扬的身份",
    "vi": "Xem ra thân phận của Chu Dương."
  },
  {
    "idx": 7779,
    "start": "03:38:08,051",
    "end": "03:38:09,631",
    "start_sec": 13088.051,
    "end_sec": 13089.631,
    "zh": "远不止关二代那么简单",
    "vi": "Không chỉ đơn giản là con ông cháu cha."
  },
  {
    "idx": 7780,
    "start": "03:38:09,631",
    "end": "03:38:10,731",
    "start_sec": 13089.631,
    "end_sec": 13090.731,
    "zh": "一楼那些用餐的人",
    "vi": "Những người đang dùng bữa ở tầng một."
  },
  {
    "idx": 7781,
    "start": "03:38:10,731",
    "end": "03:38:11,691",
    "start_sec": 13090.731,
    "end_sec": 13091.691,
    "zh": "都不像普通人",
    "vi": "Trông đều không giống người bình thường."
  },
  {
    "idx": 7782,
    "start": "03:38:11,691",
    "end": "03:38:12,511",
    "start_sec": 13091.691,
    "end_sec": 13092.511,
    "zh": "何况二楼",
    "vi": "Huống chi là tầng hai."
  },
  {
    "idx": 7783,
    "start": "03:38:12,511",
    "end": "03:38:13,971",
    "start_sec": 13092.511,
    "end_sec": 13093.971,
    "zh": "还是和遇鬼者住在一起",
    "vi": "Lại còn sống chung với những người từng gặp ma."
  },
  {
    "idx": 7784,
    "start": "03:38:13,971",
    "end": "03:38:19,651",
    "start_sec": 13093.971,
    "end_sec": 13099.651,
    "zh": "红色铁门这个就是",
    "vi": "Căn phòng có cửa sắt màu đỏ này chính là nó."
  },
  {
    "idx": 7785,
    "start": "03:38:19,651",
    "end": "03:38:20,391",
    "start_sec": 13099.651,
    "end_sec": 13100.391,
    "zh": "进去吧",
    "vi": "Vào đi."
  },
  {
    "idx": 7786,
    "start": "03:38:20,391",
    "end": "03:38:20,871",
    "start_sec": 13100.391,
    "end_sec": 13100.871,
    "zh": "对了",
    "vi": "Đúng rồi."
  },
  {
    "idx": 7787,
    "start": "03:38:20,871",
    "end": "03:38:23,531",
    "start_sec": 13100.871,
    "end_sec": 13103.531,
    "zh": "晚上来白色铁门的房间来找我",
    "vi": "Tối nay hãy đến phòng có cửa sắt màu trắng tìm tôi."
  },
  {
    "idx": 7788,
    "start": "03:38:23,531",
    "end": "03:38:29,671",
    "start_sec": 13103.531,
    "end_sec": 13109.671,
    "zh": "橙子皮",
    "vi": "Trần Tử Bì."
  },
  {
    "idx": 7789,
    "start": "03:38:29,671",
    "end": "03:38:30,831",
    "start_sec": 13109.671,
    "end_sec": 13110.831,
    "zh": "你小子行啊",
    "vi": "Cậu khá đấy chứ."
  },
  {
    "idx": 7790,
    "start": "03:38:30,831",
    "end": "03:38:32,631",
    "start_sec": 13110.831,
    "end_sec": 13112.631,
    "zh": "居然真能自己找到这里来",
    "vi": "Không ngờ cậu lại tự mình tìm được đến đây."
  },
  {
    "idx": 7791,
    "start": "03:38:32,631",
    "end": "03:38:34,891",
    "start_sec": 13112.631,
    "end_sec": 13114.891,
    "zh": "周扬打趣的看了橙子皮一眼",
    "vi": "Chu Dương nhìn Trần Tử Bì đầy trêu chọc."
  },
  {
    "idx": 7792,
    "start": "03:38:34,891",
    "end": "03:38:36,571",
    "start_sec": 13114.891,
    "end_sec": 13116.571,
    "zh": "随后目光落在他的脖子上",
    "vi": "Sau đó ánh mắt dừng lại trên cổ của cậu ta."
  },
  {
    "idx": 7793,
    "start": "03:38:36,571",
    "end": "03:38:38,251",
    "start_sec": 13116.571,
    "end_sec": 13118.251,
    "zh": "你现在是遇鬼者了吧",
    "vi": "Bây giờ cậu là người từng gặp ma rồi phải không."
  },
  {
    "idx": 7794,
    "start": "03:38:38,251",
    "end": "03:38:40,151",
    "start_sec": 13118.251,
    "end_sec": 13120.151,
    "zh": "你小子可真是厉害啊",
    "vi": "Cậu thật sự rất lợi hại đấy."
  },
  {
    "idx": 7795,
    "start": "03:38:40,151",
    "end": "03:38:41,311",
    "start_sec": 13120.151,
    "end_sec": 13121.311,
    "zh": "先是买了黑狗转开",
    "vi": "Đầu tiên là mua chó đen để tránh nạn."
  },
  {
    "idx": 7796,
    "start": "03:38:41,311",
    "end": "03:38:42,531",
    "start_sec": 13121.311,
    "end_sec": 13122.531,
    "zh": "又是一路逃到这",
    "vi": "Sau đó lại chạy trốn suốt chặng đường đến đây."
  },
  {
    "idx": 7797,
    "start": "03:38:42,531",
    "end": "03:38:43,591",
    "start_sec": 13122.531,
    "end_sec": 13123.591,
    "zh": "还成为了遇鬼者",
    "vi": "Lại còn trở thành người từng gặp ma."
  },
  {
    "idx": 7798,
    "start": "03:38:43,591",
    "end": "03:38:45,911",
    "start_sec": 13123.591,
    "end_sec": 13125.911,
    "zh": "我说你不会是什么小说主角吧",
    "vi": "Tôi nói này, không lẽ cậu là nhân vật chính trong tiểu thuyết sao."
  },
  {
    "idx": 7799,
    "start": "03:38:45,911",
    "end": "03:38:46,831",
    "start_sec": 13125.911,
    "end_sec": 13126.831,
    "zh": "你想多了",
    "vi": "Anh nghĩ nhiều rồi."
  },
  {
    "idx": 7800,
    "start": "03:38:46,831",
    "end": "03:38:47,871",
    "start_sec": 13126.831,
    "end_sec": 13127.871,
    "zh": "能走到这一步",
    "vi": "Để đi được đến bước này."
  },
  {
    "idx": 7801,
    "start": "03:38:47,871",
    "end": "03:38:49,351",
    "start_sec": 13127.871,
    "end_sec": 13129.351,
    "zh": "纯属我个人努力",
    "vi": "Hoàn toàn là do nỗ lực cá nhân của tôi."
  },
  {
    "idx": 7802,
    "start": "03:38:49,351",
    "end": "03:38:50,051",
    "start_sec": 13129.351,
    "end_sec": 13130.051,
    "zh": "得了",
    "vi": "Thôi đi."
  },
  {
    "idx": 7803,
    "start": "03:38:50,051",
    "end": "03:38:50,851",
    "start_sec": 13130.051,
    "end_sec": 13130.851,
    "zh": "不说这些",
    "vi": "Không nói chuyện đó nữa."
  },
  {
    "idx": 7804,
    "start": "03:38:50,851",
    "end": "03:38:52,131",
    "start_sec": 13130.851,
    "end_sec": 13132.131,
    "zh": "事情我听说了",
    "vi": "Tôi nghe nói về chuyện đó rồi."
  },
  {
    "idx": 7805,
    "start": "03:38:52,131",
    "end": "03:38:53,331",
    "start_sec": 13132.131,
    "end_sec": 13133.331,
    "zh": "你真没杀徐东来吗",
    "vi": "Cậu thực sự không giết Từ Đông Lai sao."
  },
  {
    "idx": 7806,
    "start": "03:38:53,331",
    "end": "03:38:54,751",
    "start_sec": 13133.331,
    "end_sec": 13134.751,
    "zh": "你觉得呢",
    "vi": "Cậu nghĩ thế nào."
  },
  {
    "idx": 7807,
    "start": "03:38:54,751",
    "end": "03:38:59,871",
    "start_sec": 13134.751,
    "end_sec": 13139.871,
    "zh": "你杀不杀他",
    "vi": "Cậu có giết hắn hay không."
  },
  {
    "idx": 7808,
    "start": "03:38:59,871",
    "end": "03:39:00,891",
    "start_sec": 13139.871,
    "end_sec": 13140.891,
    "zh": "我都觉得没关系",
    "vi": "Tôi đều thấy không quan trọng."
  },
  {
    "idx": 7809,
    "start": "03:39:00,891",
    "end": "03:39:02,431",
    "start_sec": 13140.891,
    "end_sec": 13142.431,
    "zh": "徐东来那家伙怪虚伪",
    "vi": "Tên Từ Đông Lai đó khá là giả tạo."
  },
  {
    "idx": 7810,
    "start": "03:39:02,431",
    "end": "03:39:03,431",
    "start_sec": 13142.431,
    "end_sec": 13143.431,
    "zh": "我也不喜欢他",
    "vi": "Tôi cũng không thích hắn."
  },
  {
    "idx": 7811,
    "start": "03:39:03,431",
    "end": "03:39:05,251",
    "start_sec": 13143.431,
    "end_sec": 13145.251,
    "zh": "是你叫023帮我的吗",
    "vi": "Có phải cậu bảo 023 giúp tôi không."
  },
  {
    "idx": 7812,
    "start": "03:39:05,251",
    "end": "03:39:06,051",
    "start_sec": 13145.251,
    "end_sec": 13146.051,
    "zh": "也没有吧",
    "vi": "Cũng không hẳn."
  },
  {
    "idx": 7813,
    "start": "03:39:06,051",
    "end": "03:39:06,931",
    "start_sec": 13146.051,
    "end_sec": 13146.931,
    "zh": "我就提了一嘴",
    "vi": "Tôi chỉ nhắc qua một câu thôi."
  },
  {
    "idx": 7814,
    "start": "03:39:06,931",
    "end": "03:39:08,311",
    "start_sec": 13146.931,
    "end_sec": 13148.311,
    "zh": "别让026难为你",
    "vi": "Bảo đừng để 026 làm khó cậu."
  },
  {
    "idx": 7815,
    "start": "03:39:08,311",
    "end": "03:39:10,491",
    "start_sec": 13148.311,
    "end_sec": 13150.491,
    "zh": "没想到023居然直接把你带过来了",
    "vi": "Không ngờ 023 lại trực tiếp đưa cậu đến đây luôn."
  },
  {
    "idx": 7816,
    "start": "03:39:10,491",
    "end": "03:39:12,071",
    "start_sec": 13150.491,
    "end_sec": 13152.071,
    "zh": "我还以为你要被关起来了",
    "vi": "Tôi cứ nghĩ cậu sắp bị nhốt lại rồi chứ."
  },
  {
    "idx": 7817,
    "start": "03:39:12,071",
    "end": "03:39:13,291",
    "start_sec": 13152.071,
    "end_sec": 13153.291,
    "zh": "这么说",
    "vi": "Nói như vậy."
  },
  {
    "idx": 7818,
    "start": "03:39:13,291",
    "end": "03:39:15,051",
    "start_sec": 13153.291,
    "end_sec": 13155.051,
    "zh": "是023在主动帮我",
    "vi": "Là 023 đang chủ động giúp tôi sao."
  },
  {
    "idx": 7819,
    "start": "03:39:15,051",
    "end": "03:39:15,811",
    "start_sec": 13155.051,
    "end_sec": 13155.811,
    "zh": "差不多",
    "vi": "Đại khái là thế."
  },
  {
    "idx": 7820,
    "start": "03:39:15,811",
    "end": "03:39:16,851",
    "start_sec": 13155.811,
    "end_sec": 13156.851,
    "zh": "这公子",
    "vi": "Này công tử."
  },
  {
    "idx": 7821,
    "start": "03:39:16,851",
    "end": "03:39:18,191",
    "start_sec": 13156.851,
    "end_sec": 13158.191,
    "zh": "我问你的事啊",
    "vi": "Chuyện tôi hỏi cậu ấy."
  },
  {
    "idx": 7822,
    "start": "03:39:18,191",
    "end": "03:39:18,551",
    "start_sec": 13158.191,
    "end_sec": 13158.551,
    "zh": "问呗",
    "vi": "Cứ hỏi đi."
  },
  {
    "idx": 7823,
    "start": "03:39:18,551",
    "end": "03:39:20,431",
    "start_sec": 13158.551,
    "end_sec": 13160.431,
    "zh": "咱哥俩还有啥不能说的",
    "vi": "Anh em chúng ta còn gì mà không thể nói chứ."
  },
  {
    "idx": 7824,
    "start": "03:39:20,431",
    "end": "03:39:22,091",
    "start_sec": 13160.431,
    "end_sec": 13162.091,
    "zh": "你到底什么身份",
    "vi": "Rốt cuộc cậu có thân phận gì thế."
  },
  {
    "idx": 7825,
    "start": "03:39:22,091",
    "end": "03:39:22,791",
    "start_sec": 13162.091,
    "end_sec": 13162.791,
    "zh": "或者说",
    "vi": "Hoặc là nói."
  },
  {
    "idx": 7826,
    "start": "03:39:22,791",
    "end": "03:39:24,231",
    "start_sec": 13162.791,
    "end_sec": 13164.231,
    "zh": "你家老爷子什么身份",
    "vi": "Bố của cậu có thân phận gì."
  },
  {
    "idx": 7827,
    "start": "03:39:24,231",
    "end": "03:39:25,591",
    "start_sec": 13164.231,
    "end_sec": 13165.591,
    "zh": "我就知道你要问这个",
    "vi": "Tôi biết ngay là cậu sẽ hỏi chuyện này mà."
  },
  {
    "idx": 7828,
    "start": "03:39:25,591",
    "end": "03:39:26,771",
    "start_sec": 13165.591,
    "end_sec": 13166.771,
    "zh": "跟你说了也无所谓",
    "vi": "Nói cho cậu biết cũng không sao."
  },
  {
    "idx": 7829,
    "start": "03:39:26,771",
    "end": "03:39:27,631",
    "start_sec": 13166.771,
    "end_sec": 13167.631,
    "zh": "估计到时候",
    "vi": "Tôi đoán là đến lúc đó."
  },
  {
    "idx": 7830,
    "start": "03:39:27,631",
    "end": "03:39:29,471",
    "start_sec": 13167.631,
    "end_sec": 13169.471,
    "zh": "023也是要和你说的",
    "vi": "Kiểu gì 023 cũng sẽ nói với cậu thôi."
  },
  {
    "idx": 7831,
    "start": "03:39:29,471",
    "end": "03:39:29,831",
    "start_sec": 13169.471,
    "end_sec": 13169.831,
    "zh": "周家",
    "vi": "Nhà họ Chu."
  },
  {
    "idx": 7832,
    "start": "03:39:29,831",
    "end": "03:39:32,171",
    "start_sec": 13169.831,
    "end_sec": 13172.171,
    "zh": "不单单是林江市的历代市场家族",
    "vi": "Không chỉ là gia tộc thị trưởng qua các đời ở thành phố Lâm Giang."
  },
  {
    "idx": 7833,
    "start": "03:39:32,171",
    "end": "03:39:34,171",
    "start_sec": 13172.171,
    "end_sec": 13174.171,
    "zh": "其实周家还有一面古境",
    "vi": "Thực ra nhà họ Chu còn có một tấm gương cổ."
  },
  {
    "idx": 7834,
    "start": "03:39:34,171",
    "end": "03:39:35,431",
    "start_sec": 13174.171,
    "end_sec": 13175.431,
    "zh": "是历代传下来的",
    "vi": "Được truyền lại qua nhiều đời."
  },
  {
    "idx": 7835,
    "start": "03:39:35,431",
    "end": "03:39:35,931",
    "start_sec": 13175.431,
    "end_sec": 13175.931,
    "zh": "古境",
    "vi": "Gương cổ."
  },
  {
    "idx": 7836,
    "start": "03:39:35,931",
    "end": "03:39:37,151",
    "start_sec": 13175.931,
    "end_sec": 13177.151,
    "zh": "有什么说法吗",
    "vi": "Có gì đặc biệt sao."
  },
  {
    "idx": 7837,
    "start": "03:39:37,151",
    "end": "03:39:39,231",
    "start_sec": 13177.151,
    "end_sec": 13179.231,
    "zh": "一般古境当然没什么说法",
    "vi": "Gương cổ bình thường thì tất nhiên chẳng có gì đặc biệt."
  },
  {
    "idx": 7838,
    "start": "03:39:39,231",
    "end": "03:39:41,271",
    "start_sec": 13179.231,
    "end_sec": 13181.271,
    "zh": "可全国52名国家罪遇鬼者",
    "vi": "Nhưng năm mươi hai người ngự quỷ cấp quốc gia."
  },
  {
    "idx": 7839,
    "start": "03:39:41,271",
    "end": "03:39:43,131",
    "start_sec": 13181.271,
    "end_sec": 13183.131,
    "zh": "稀缺的跟外星人一样的组织",
    "vi": "Một tổ chức hiếm hoi như người ngoài hành tinh."
  },
  {
    "idx": 7840,
    "start": "03:39:43,131",
    "end": "03:39:44,971",
    "start_sec": 13183.131,
    "end_sec": 13184.971,
    "zh": "派了足足四名来临江市",
    "vi": "Lại phái tận bốn người đến thành phố Lâm Giang."
  },
  {
    "idx": 7841,
    "start": "03:39:44,971",
    "end": "03:39:45,511",
    "start_sec": 13184.971,
    "end_sec": 13185.511,
    "zh": "你说",
    "vi": "Cậu nói xem."
  },
  {
    "idx": 7842,
    "start": "03:39:45,511",
    "end": "03:39:47,451",
    "start_sec": 13185.511,
    "end_sec": 13187.451,
    "zh": "真的只是来救人这么简单吗",
    "vi": "Thực sự chỉ đơn giản là đến cứu người thôi sao."
  },
  {
    "idx": 7843,
    "start": "03:39:47,451",
    "end": "03:39:48,491",
    "start_sec": 13187.451,
    "end_sec": 13188.491,
    "zh": "你的意思是",
    "vi": "Ý của cậu là."
  },
  {
    "idx": 7844,
    "start": "03:39:48,491",
    "end": "03:39:49,271",
    "start_sec": 13188.491,
    "end_sec": 13189.271,
    "zh": "人不重要",
    "vi": "Người không quan trọng."
  },
  {
    "idx": 7845,
    "start": "03:39:49,271",
    "end": "03:39:50,931",
    "start_sec": 13189.271,
    "end_sec": 13190.931,
    "zh": "重要的是那面镜子",
    "vi": "Quan trọng là tấm gương đó."
  },
  {
    "idx": 7846,
    "start": "03:39:50,931",
    "end": "03:39:51,691",
    "start_sec": 13190.931,
    "end_sec": 13191.691,
    "zh": "没错",
    "vi": "Đúng vậy."
  },
  {
    "idx": 7847,
    "start": "03:39:51,691",
    "end": "03:39:52,911",
    "start_sec": 13191.691,
    "end_sec": 13192.911,
    "zh": "我们只是附带的",
    "vi": "Chúng ta chỉ là vật kèm theo thôi."
  },
  {
    "idx": 7848,
    "start": "03:39:52,911",
    "end": "03:39:54,371",
    "start_sec": 13192.911,
    "end_sec": 13194.371,
    "zh": "那镜子之处可以连接一戒",
    "vi": "Tấm gương đó có thể kết nối với một thế giới khác."
  },
  {
    "idx": 7849,
    "start": "03:39:54,371",
    "end": "03:39:55,571",
    "start_sec": 13194.371,
    "end_sec": 13195.571,
    "zh": "现在由我爸掌控",
    "vi": "Hiện tại đang do bố tôi nắm giữ."
  },
  {
    "idx": 7850,
    "start": "03:39:55,571",
    "end": "03:39:56,031",
    "start_sec": 13195.571,
    "end_sec": 13196.031,
    "zh": "所以",
    "vi": "Cho nên."
  },
  {
    "idx": 7851,
    "start": "03:39:56,031",
    "end": "03:39:57,291",
    "start_sec": 13196.031,
    "end_sec": 13197.291,
    "zh": "我的身份这么高",
    "vi": "Thân phận của tôi cao như vậy."
  },
  {
    "idx": 7852,
    "start": "03:39:57,291",
    "end": "03:39:59,191",
    "start_sec": 13197.291,
    "end_sec": 13199.191,
    "zh": "可不单纯是因为我是市长的孩子",
    "vi": "Không đơn thuần chỉ vì tôi là con của thị trưởng."
  },
  {
    "idx": 7853,
    "start": "03:39:59,191",
    "end": "03:39:59,891",
    "start_sec": 13199.191,
    "end_sec": 13199.891,
    "zh": "挺可爱的",
    "vi": "Thật đáng yêu."
  },
  {
    "idx": 7854,
    "start": "03:40:00,000",
    "end": "03:40:02,460",
    "start_sec": 13200.0,
    "end_sec": 13202.46,
    "zh": "这一团的人都没那镜子宝贵",
    "vi": "Cả nhóm người này còn chẳng quý giá bằng tấm gương đó."
  },
  {
    "idx": 7855,
    "start": "03:40:02,460",
    "end": "03:40:04,300",
    "start_sec": 13202.46,
    "end_sec": 13204.3,
    "zh": "周扬的语气充满抱怨",
    "vi": "Giọng điệu của Chu Dương đầy vẻ oán trách."
  },
  {
    "idx": 7856,
    "start": "03:40:04,300",
    "end": "03:40:05,760",
    "start_sec": 13204.3,
    "end_sec": 13205.76,
    "zh": "彭子平也没接话",
    "vi": "Bành Tử Bình cũng không đáp lời."
  },
  {
    "idx": 7857,
    "start": "03:40:05,760",
    "end": "03:40:07,740",
    "start_sec": 13205.76,
    "end_sec": 13207.74,
    "zh": "两久周扬才抬头笑了笑",
    "vi": "Một lúc lâu sau Chu Dương mới ngẩng đầu cười."
  },
  {
    "idx": 7858,
    "start": "03:40:07,740",
    "end": "03:40:08,720",
    "start_sec": 13207.74,
    "end_sec": 13208.72,
    "zh": "不好意思",
    "vi": "Xin lỗi cậu."
  },
  {
    "idx": 7859,
    "start": "03:40:08,720",
    "end": "03:40:10,800",
    "start_sec": 13208.72,
    "end_sec": 13210.8,
    "zh": "本来是该气死你节后余生的",
    "vi": "Đáng lẽ phải chúc mừng cậu tai qua nạn khỏi."
  },
  {
    "idx": 7860,
    "start": "03:40:10,800",
    "end": "03:40:12,200",
    "start_sec": 13210.8,
    "end_sec": 13212.2,
    "zh": "反倒是变成了我的劳导",
    "vi": "Vậy mà lại thành ra tôi than vãn với cậu."
  },
  {
    "idx": 7861,
    "start": "03:40:12,200",
    "end": "03:40:12,900",
    "start_sec": 13212.2,
    "end_sec": 13212.9,
    "zh": "没关系",
    "vi": "Không sao đâu"
  },
  {
    "idx": 7862,
    "start": "03:40:12,900",
    "end": "03:40:14,640",
    "start_sec": 13212.9,
    "end_sec": 13214.64,
    "zh": "对了你今晚要住我家吗",
    "vi": "À đúng rồi, tối nay bạn có ở nhà tôi không"
  },
  {
    "idx": 7863,
    "start": "03:40:14,640",
    "end": "03:40:17,440",
    "start_sec": 13214.64,
    "end_sec": 13217.44,
    "zh": "这个零二三他好像找我有点事",
    "vi": "Cái tên 023 đó có vẻ có việc tìm tôi"
  },
  {
    "idx": 7864,
    "start": "03:40:17,440",
    "end": "03:40:19,560",
    "start_sec": 13217.44,
    "end_sec": 13219.56,
    "zh": "行那能把小墨鸡先借给我吗",
    "vi": "Được, vậy bạn có thể cho tôi mượn Tiểu Mặc Ký trước được không"
  },
  {
    "idx": 7865,
    "start": "03:40:19,560",
    "end": "03:40:21,320",
    "start_sec": 13219.56,
    "end_sec": 13221.32,
    "zh": "我家小黑子估计挺想他的",
    "vi": "Tiểu Hắc Tử nhà tôi chắc nhớ nó lắm"
  },
  {
    "idx": 7866,
    "start": "03:40:21,320",
    "end": "03:40:23,360",
    "start_sec": 13221.32,
    "end_sec": 13223.36,
    "zh": "你这么一说我这才想起来",
    "vi": "Bạn nói vậy tôi mới nhớ ra"
  },
  {
    "idx": 7867,
    "start": "03:40:23,360",
    "end": "03:40:24,720",
    "start_sec": 13223.36,
    "end_sec": 13224.72,
    "zh": "对了小黑子呢",
    "vi": "À Tiểu Hắc Tử đâu rồi"
  },
  {
    "idx": 7868,
    "start": "03:40:24,720",
    "end": "03:40:26,680",
    "start_sec": 13224.72,
    "end_sec": 13226.68,
    "zh": "在我爸那他挺喜欢狗的",
    "vi": "Nó đang ở chỗ bố tôi, ông ấy thích chó lắm"
  },
  {
    "idx": 7869,
    "start": "03:40:26,680",
    "end": "03:40:27,680",
    "start_sec": 13226.68,
    "end_sec": 13227.68,
    "zh": "晚上就送回来了",
    "vi": "Tối nay sẽ mang về"
  },
  {
    "idx": 7870,
    "start": "03:40:27,680",
    "end": "03:40:28,440",
    "start_sec": 13227.68,
    "end_sec": 13228.44,
    "zh": "行吧",
    "vi": "Được rồi"
  },
  {
    "idx": 7871,
    "start": "03:40:28,440",
    "end": "03:40:29,300",
    "start_sec": 13228.44,
    "end_sec": 13229.3,
    "zh": "小墨记",
    "vi": "Tiểu Mặc Ký"
  },
  {
    "idx": 7872,
    "start": "03:40:29,300",
    "end": "03:40:30,180",
    "start_sec": 13229.3,
    "end_sec": 13230.18,
    "zh": "你在这待着",
    "vi": "Bạn ở đây nhé"
  },
  {
    "idx": 7873,
    "start": "03:40:30,180",
    "end": "03:40:31,000",
    "start_sec": 13230.18,
    "end_sec": 13231.0,
    "zh": "我不会回来",
    "vi": "Tôi sẽ không quay lại"
  },
  {
    "idx": 7874,
    "start": "03:40:31,000",
    "end": "03:40:32,840",
    "start_sec": 13231.0,
    "end_sec": 13232.84,
    "zh": "橙子皮快步走出房间",
    "vi": "Trần Tử Bì nhanh chóng rời khỏi phòng"
  },
  {
    "idx": 7875,
    "start": "03:40:32,840",
    "end": "03:40:34,600",
    "start_sec": 13232.84,
    "end_sec": 13234.6,
    "zh": "小墨记和周扬也认识",
    "vi": "Tiểu Mặc Ký cũng quen Chu Dương"
  },
  {
    "idx": 7876,
    "start": "03:40:34,600",
    "end": "03:40:36,180",
    "start_sec": 13234.6,
    "end_sec": 13236.18,
    "zh": "趴在他腿边也没动的",
    "vi": "Nằm cạnh chân anh ta cũng không nhúc nhích"
  },
  {
    "idx": 7877,
    "start": "03:40:36,180",
    "end": "03:40:38,040",
    "start_sec": 13236.18,
    "end_sec": 13238.04,
    "zh": "怎么感觉有点不对劲",
    "vi": "Sao cảm giác có gì đó không ổn"
  },
  {
    "idx": 7878,
    "start": "03:40:38,040",
    "end": "03:40:39,280",
    "start_sec": 13238.04,
    "end_sec": 13239.28,
    "zh": "过去的我和周扬",
    "vi": "Tôi và Chu Dương trước đây"
  },
  {
    "idx": 7879,
    "start": "03:40:39,280",
    "end": "03:40:41,700",
    "start_sec": 13239.28,
    "end_sec": 13241.7,
    "zh": "偶尔会带着小墨记和小黑子一起玩",
    "vi": "Thỉnh thoảng cũng dắt Tiểu Mặc Ký và Tiểu Hắc Tử đi chơi cùng nhau"
  },
  {
    "idx": 7880,
    "start": "03:40:41,700",
    "end": "03:40:43,100",
    "start_sec": 13241.7,
    "end_sec": 13243.1,
    "zh": "应该不会出什么问题吧",
    "vi": "Chắc sẽ không có vấn đề gì đâu nhỉ"
  },
  {
    "idx": 7881,
    "start": "03:40:43,100",
    "end": "03:40:44,000",
    "start_sec": 13243.1,
    "end_sec": 13244.0,
    "zh": "说是为何",
    "vi": "Nói vậy là sao"
  },
  {
    "idx": 7882,
    "start": "03:40:44,000",
    "end": "03:40:46,160",
    "start_sec": 13244.0,
    "end_sec": 13246.16,
    "zh": "橙子皮心头总觉得有些不安",
    "vi": "Trần Tử Bì cảm thấy trong lòng có chút bất an"
  },
  {
    "idx": 7883,
    "start": "03:40:46,160",
    "end": "03:40:47,300",
    "start_sec": 13246.16,
    "end_sec": 13247.3,
    "zh": "他脚步不由的加快",
    "vi": "Anh ta không khỏi bước nhanh hơn"
  },
  {
    "idx": 7884,
    "start": "03:40:47,300",
    "end": "03:40:48,620",
    "start_sec": 13247.3,
    "end_sec": 13248.62,
    "zh": "白色房门",
    "vi": "Cánh cửa phòng màu trắng"
  },
  {
    "idx": 7885,
    "start": "03:40:48,620",
    "end": "03:40:50,380",
    "start_sec": 13248.62,
    "end_sec": 13250.38,
    "zh": "这应该就是023的房间吧",
    "vi": "Đây chắc là phòng của 023 rồi"
  },
  {
    "idx": 7886,
    "start": "03:40:50,380",
    "end": "03:40:51,560",
    "start_sec": 13250.38,
    "end_sec": 13251.56,
    "zh": "023前辈",
    "vi": "Tiền bối 023"
  },
  {
    "idx": 7887,
    "start": "03:40:51,560",
    "end": "03:40:52,340",
    "start_sec": 13251.56,
    "end_sec": 13252.34,
    "zh": "你在吗",
    "vi": "Anh có ở đó không"
  },
  {
    "idx": 7888,
    "start": "03:40:52,340",
    "end": "03:40:53,540",
    "start_sec": 13252.34,
    "end_sec": 13253.54,
    "zh": "是您喊我来的",
    "vi": "Là anh gọi tôi đến mà"
  },
  {
    "idx": 7889,
    "start": "03:40:53,540",
    "end": "03:40:54,860",
    "start_sec": 13253.54,
    "end_sec": 13254.86,
    "zh": "敲了好一会儿没回应",
    "vi": "Gõ mãi không thấy ai trả lời"
  },
  {
    "idx": 7890,
    "start": "03:40:54,860",
    "end": "03:40:57,140",
    "start_sec": 13254.86,
    "end_sec": 13257.14,
    "zh": "橙子皮只好尝试着推冷下门",
    "vi": "Trần Tử Bì đành thử đẩy cửa ra"
  },
  {
    "idx": 7891,
    "start": "03:40:57,140",
    "end": "03:40:58,580",
    "start_sec": 13257.14,
    "end_sec": 13258.58,
    "zh": "结果只是稍作用力",
    "vi": "Kết quả là chỉ cần dùng một chút lực"
  },
  {
    "idx": 7892,
    "start": "03:40:58,580",
    "end": "03:41:00,180",
    "start_sec": 13258.58,
    "end_sec": 13260.18,
    "zh": "帮能点拉给一条缝隙",
    "vi": "Đã có thể kéo ra một khe hở"
  },
  {
    "idx": 7893,
    "start": "03:41:00,180",
    "end": "03:41:00,820",
    "start_sec": 13260.18,
    "end_sec": 13260.82,
    "zh": "卧槽",
    "vi": "Chết tiệt"
  },
  {
    "idx": 7894,
    "start": "03:41:00,820",
    "end": "03:41:02,680",
    "start_sec": 13260.82,
    "end_sec": 13262.68,
    "zh": "这里面怎么全是烟雾",
    "vi": "Sao bên trong này toàn là khói thế này"
  },
  {
    "idx": 7895,
    "start": "03:41:02,680",
    "end": "03:41:03,680",
    "start_sec": 13262.68,
    "end_sec": 13263.68,
    "zh": "由于片刻",
    "vi": "Do dự một lát"
  },
  {
    "idx": 7896,
    "start": "03:41:03,680",
    "end": "03:41:05,480",
    "start_sec": 13263.68,
    "end_sec": 13265.48,
    "zh": "橙子皮朝我里迈出一步",
    "vi": "Trần Tử Bì bước một bước vào trong phòng"
  },
  {
    "idx": 7897,
    "start": "03:41:05,480",
    "end": "03:41:07,800",
    "start_sec": 13265.48,
    "end_sec": 13267.8,
    "zh": "突然",
    "vi": "Bỗng nhiên"
  },
  {
    "idx": 7898,
    "start": "03:41:07,800",
    "end": "03:41:09,620",
    "start_sec": 13267.8,
    "end_sec": 13269.62,
    "zh": "屋内的烟雾发挥无形打手",
    "vi": "Khói sương trong phòng hóa thành một bàn tay vô hình"
  },
  {
    "idx": 7899,
    "start": "03:41:09,620",
    "end": "03:41:10,880",
    "start_sec": 13269.62,
    "end_sec": 13270.88,
    "zh": "向橙子皮抓紧",
    "vi": "Lao đến tóm lấy Trần Tử Bì"
  },
  {
    "idx": 7900,
    "start": "03:41:10,880",
    "end": "03:41:11,720",
    "start_sec": 13270.88,
    "end_sec": 13271.72,
    "zh": "鬼面窗",
    "vi": "Quỷ Diện Sang"
  },
  {
    "idx": 7901,
    "start": "03:41:11,720",
    "end": "03:41:13,400",
    "start_sec": 13271.72,
    "end_sec": 13273.4,
    "zh": "023前辈",
    "vi": "Tiền bối 023"
  },
  {
    "idx": 7902,
    "start": "03:41:13,400",
    "end": "03:41:15,120",
    "start_sec": 13273.4,
    "end_sec": 13275.12,
    "zh": "你这是什么意思啊",
    "vi": "Ý của tiền bối là gì thế"
  },
  {
    "idx": 7903,
    "start": "03:41:15,120",
    "end": "03:41:15,600",
    "start_sec": 13275.12,
    "end_sec": 13275.6,
    "zh": "呵呵",
    "vi": "Ha ha"
  },
  {
    "idx": 7904,
    "start": "03:41:15,600",
    "end": "03:41:16,340",
    "start_sec": 13275.6,
    "end_sec": 13276.34,
    "zh": "小兄弟",
    "vi": "Cậu em à"
  },
  {
    "idx": 7905,
    "start": "03:41:16,340",
    "end": "03:41:17,380",
    "start_sec": 13276.34,
    "end_sec": 13277.38,
    "zh": "我知道你很急",
    "vi": "Tôi biết cậu đang rất vội"
  },
  {
    "idx": 7906,
    "start": "03:41:17,380",
    "end": "03:41:18,520",
    "start_sec": 13277.38,
    "end_sec": 13278.52,
    "zh": "但是你先别急",
    "vi": "Nhưng cậu cứ bình tĩnh đã"
  },
  {
    "idx": 7907,
    "start": "03:41:18,520",
    "end": "03:41:19,800",
    "start_sec": 13278.52,
    "end_sec": 13279.8,
    "zh": "你叫橙子皮",
    "vi": "Cậu tên là Trần Tử Bì"
  },
  {
    "idx": 7908,
    "start": "03:41:19,800",
    "end": "03:41:21,140",
    "start_sec": 13279.8,
    "end_sec": 13281.14,
    "zh": "今年24岁",
    "vi": "Năm nay 24 tuổi"
  },
  {
    "idx": 7909,
    "start": "03:41:21,140",
    "end": "03:41:21,740",
    "start_sec": 13281.14,
    "end_sec": 13281.74,
    "zh": "单身",
    "vi": "Độc thân"
  },
  {
    "idx": 7910,
    "start": "03:41:21,740",
    "end": "03:41:22,500",
    "start_sec": 13281.74,
    "end_sec": 13282.5,
    "zh": "前辈",
    "vi": "Tiền bối"
  },
  {
    "idx": 7911,
    "start": "03:41:22,500",
    "end": "03:41:24,040",
    "start_sec": 13282.5,
    "end_sec": 13284.04,
    "zh": "你的话到底什么意思啊",
    "vi": "Rốt cuộc lời của tiền bối có ý gì thế"
  },
  {
    "idx": 7912,
    "start": "03:41:24,040",
    "end": "03:41:25,260",
    "start_sec": 13284.04,
    "end_sec": 13285.26,
    "zh": "我在看你的档案",
    "vi": "Tôi đang xem hồ sơ của cậu"
  },
  {
    "idx": 7913,
    "start": "03:41:25,260",
    "end": "03:41:26,020",
    "start_sec": 13285.26,
    "end_sec": 13286.02,
    "zh": "很干净",
    "vi": "Rất sạch sẽ"
  },
  {
    "idx": 7914,
    "start": "03:41:26,020",
    "end": "03:41:26,560",
    "start_sec": 13286.02,
    "end_sec": 13286.56,
    "zh": "不错",
    "vi": "Tốt lắm"
  },
  {
    "idx": 7915,
    "start": "03:41:26,560",
    "end": "03:41:28,700",
    "start_sec": 13286.56,
    "end_sec": 13288.7,
    "zh": "你有兴趣成为国家队的人吗",
    "vi": "Cậu có hứng thú gia nhập đội tuyển quốc gia không"
  },
  {
    "idx": 7916,
    "start": "03:41:28,700",
    "end": "03:41:29,360",
    "start_sec": 13288.7,
    "end_sec": 13289.36,
    "zh": "前辈",
    "vi": "Tiền bối"
  },
  {
    "idx": 7917,
    "start": "03:41:29,360",
    "end": "03:41:30,700",
    "start_sec": 13289.36,
    "end_sec": 13290.7,
    "zh": "在成为国家队之前",
    "vi": "Trước khi gia nhập đội tuyển quốc gia"
  },
  {
    "idx": 7918,
    "start": "03:41:30,700",
    "end": "03:41:32,220",
    "start_sec": 13290.7,
    "end_sec": 13292.22,
    "zh": "你能否别绕弯子",
    "vi": "Tiền bối có thể đừng nói vòng vo nữa được không"
  },
  {
    "idx": 7919,
    "start": "03:41:32,220",
    "end": "03:41:33,920",
    "start_sec": 13292.22,
    "end_sec": 13293.92,
    "zh": "莫名其妙受到攻击",
    "vi": "Bị tấn công một cách vô cớ"
  },
  {
    "idx": 7920,
    "start": "03:41:33,920",
    "end": "03:41:35,340",
    "start_sec": 13293.92,
    "end_sec": 13295.34,
    "zh": "橙子皮有些脑裤",
    "vi": "Trần Tử Bì có chút tức giận"
  },
  {
    "idx": 7921,
    "start": "03:41:35,340",
    "end": "03:41:36,620",
    "start_sec": 13295.34,
    "end_sec": 13296.62,
    "zh": "转身就准备你的",
    "vi": "Quay người chuẩn bị việc của cậu đi."
  },
  {
    "idx": 7922,
    "start": "03:41:36,620",
    "end": "03:41:37,120",
    "start_sec": 13296.62,
    "end_sec": 13297.12,
    "zh": "哎",
    "vi": "Này."
  },
  {
    "idx": 7923,
    "start": "03:41:37,120",
    "end": "03:41:37,820",
    "start_sec": 13297.12,
    "end_sec": 13297.82,
    "zh": "小子",
    "vi": "Nhóc con."
  },
  {
    "idx": 7924,
    "start": "03:41:37,820",
    "end": "03:41:39,000",
    "start_sec": 13297.82,
    "end_sec": 13299.0,
    "zh": "你这人真没意思",
    "vi": "Cậu thật là nhạt nhẽo."
  },
  {
    "idx": 7925,
    "start": "03:41:39,000",
    "end": "03:41:40,420",
    "start_sec": 13299.0,
    "end_sec": 13300.42,
    "zh": "那就说正事吧",
    "vi": "Vậy thì nói chuyện chính đi."
  },
  {
    "idx": 7926,
    "start": "03:41:40,420",
    "end": "03:41:41,480",
    "start_sec": 13300.42,
    "end_sec": 13301.48,
    "zh": "你觉得",
    "vi": "Cậu có thấy."
  },
  {
    "idx": 7927,
    "start": "03:41:41,480",
    "end": "03:41:43,360",
    "start_sec": 13301.48,
    "end_sec": 13303.36,
    "zh": "你刚刚见的那个周扬",
    "vi": "Chu Dương mà cậu vừa gặp."
  },
  {
    "idx": 7928,
    "start": "03:41:43,360",
    "end": "03:41:44,560",
    "start_sec": 13303.36,
    "end_sec": 13304.56,
    "zh": "还是周扬吗",
    "vi": "Vẫn là Chu Dương đó không."
  },
  {
    "idx": 7929,
    "start": "03:41:44,560",
    "end": "03:41:45,200",
    "start_sec": 13304.56,
    "end_sec": 13305.2,
    "zh": "怎么说",
    "vi": "Ý tiền bối là sao."
  },
  {
    "idx": 7930,
    "start": "03:41:45,200",
    "end": "03:41:45,980",
    "start_sec": 13305.2,
    "end_sec": 13305.98,
    "zh": "你觉得",
    "vi": "Cậu có thấy."
  },
  {
    "idx": 7931,
    "start": "03:41:45,980",
    "end": "03:41:47,480",
    "start_sec": 13305.98,
    "end_sec": 13307.48,
    "zh": "那个周扬陌生吗",
    "vi": "Chu Dương đó xa lạ không."
  },
  {
    "idx": 7932,
    "start": "03:41:47,480",
    "end": "03:41:48,220",
    "start_sec": 13307.48,
    "end_sec": 13308.22,
    "zh": "或者说",
    "vi": "Hay nói cách khác."
  },
  {
    "idx": 7933,
    "start": "03:41:48,220",
    "end": "03:41:49,400",
    "start_sec": 13308.22,
    "end_sec": 13309.4,
    "zh": "有异样感吗",
    "vi": "Có cảm giác khác lạ không."
  },
  {
    "idx": 7934,
    "start": "03:41:49,400",
    "end": "03:41:50,140",
    "start_sec": 13309.4,
    "end_sec": 13310.14,
    "zh": "你是说",
    "vi": "Ý tiền bối là."
  },
  {
    "idx": 7935,
    "start": "03:41:50,140",
    "end": "03:41:51,460",
    "start_sec": 13310.14,
    "end_sec": 13311.46,
    "zh": "周扬不是本人吗",
    "vi": "Chu Dương không phải là người thật sao."
  },
  {
    "idx": 7936,
    "start": "03:41:51,460",
    "end": "03:41:52,820",
    "start_sec": 13311.46,
    "end_sec": 13312.82,
    "zh": "周扬没问题",
    "vi": "Chu Dương không có vấn đề gì."
  },
  {
    "idx": 7937,
    "start": "03:41:52,820",
    "end": "03:41:53,620",
    "start_sec": 13312.82,
    "end_sec": 13313.62,
    "zh": "我的狗",
    "vi": "Con chó của tôi."
  },
  {
    "idx": 7938,
    "start": "03:41:53,620",
    "end": "03:41:54,580",
    "start_sec": 13313.62,
    "end_sec": 13314.58,
    "zh": "也觉得他没问题",
    "vi": "Cũng thấy cậu ta không có vấn đề."
  },
  {
    "idx": 7939,
    "start": "03:41:54,580",
    "end": "03:41:55,840",
    "start_sec": 13314.58,
    "end_sec": 13315.84,
    "zh": "那这样的话",
    "vi": "Nếu vậy thì."
  },
  {
    "idx": 7940,
    "start": "03:41:55,840",
    "end": "03:41:57,680",
    "start_sec": 13315.84,
    "end_sec": 13317.68,
    "zh": "能排除周扬的嫌疑了",
    "vi": "Có thể loại bỏ nghi ngờ về Chu Dương rồi."
  },
  {
    "idx": 7941,
    "start": "03:41:57,680",
    "end": "03:41:58,840",
    "start_sec": 13317.68,
    "end_sec": 13318.84,
    "zh": "不过保险起见",
    "vi": "Nhưng để cho chắc chắn."
  },
  {
    "idx": 7942,
    "start": "03:41:58,840",
    "end": "03:42:00,520",
    "start_sec": 13318.84,
    "end_sec": 13320.52,
    "zh": "最好是你再去试试",
    "vi": "Tốt nhất là cậu hãy đi thử lại lần nữa."
  },
  {
    "idx": 7943,
    "start": "03:42:00,520",
    "end": "03:42:01,760",
    "start_sec": 13320.52,
    "end_sec": 13321.76,
    "zh": "你刚刚说的我",
    "vi": "Việc tiền bối vừa nói tôi."
  },
  {
    "idx": 7944,
    "start": "03:42:01,760",
    "end": "03:42:02,620",
    "start_sec": 13321.76,
    "end_sec": 13322.62,
    "zh": "又是什么意思",
    "vi": "Có ý nghĩa gì vậy."
  },
  {
    "idx": 7945,
    "start": "03:42:02,620",
    "end": "03:42:03,300",
    "start_sec": 13322.62,
    "end_sec": 13323.3,
    "zh": "首先",
    "vi": "Trước hết."
  },
  {
    "idx": 7946,
    "start": "03:42:03,300",
    "end": "03:42:04,500",
    "start_sec": 13323.3,
    "end_sec": 13324.5,
    "zh": "我跟你道个歉",
    "vi": "Tôi xin lỗi cậu."
  },
  {
    "idx": 7947,
    "start": "03:42:04,500",
    "end": "03:42:05,380",
    "start_sec": 13324.5,
    "end_sec": 13325.38,
    "zh": "我试探你",
    "vi": "Tôi thăm dò cậu."
  },
  {
    "idx": 7948,
    "start": "03:42:05,380",
    "end": "03:42:06,820",
    "start_sec": 13325.38,
    "end_sec": 13326.82,
    "zh": "不是为了给你下马威",
    "vi": "Không phải để dằn mặt cậu."
  },
  {
    "idx": 7949,
    "start": "03:42:06,820",
    "end": "03:42:08,000",
    "start_sec": 13326.82,
    "end_sec": 13328.0,
    "zh": "而是我在验证",
    "vi": "Mà là tôi đang xác minh."
  },
  {
    "idx": 7950,
    "start": "03:42:08,000",
    "end": "03:42:09,240",
    "start_sec": 13328.0,
    "end_sec": 13329.24,
    "zh": "你是不是蠢子皮",
    "vi": "Cậu có phải là Trần Tử Bì không."
  },
  {
    "idx": 7951,
    "start": "03:42:09,240",
    "end": "03:42:09,880",
    "start_sec": 13329.24,
    "end_sec": 13329.88,
    "zh": "因为",
    "vi": "Bởi vì"
  },
  {
    "idx": 7952,
    "start": "03:42:09,880",
    "end": "03:42:11,080",
    "start_sec": 13329.88,
    "end_sec": 13331.08,
    "zh": "这船里藏了",
    "vi": "trên con tàu này có giấu"
  },
  {
    "idx": 7953,
    "start": "03:42:11,080",
    "end": "03:42:12,320",
    "start_sec": 13331.08,
    "end_sec": 13332.32,
    "zh": "能变成人的诡异",
    "vi": "thứ quỷ dị có thể biến thành người."
  },
  {
    "idx": 7954,
    "start": "03:42:12,320",
    "end": "03:42:13,360",
    "start_sec": 13332.32,
    "end_sec": 13333.36,
    "zh": "变成人",
    "vi": "Biến thành người"
  },
  {
    "idx": 7955,
    "start": "03:42:13,360",
    "end": "03:42:14,100",
    "start_sec": 13333.36,
    "end_sec": 13334.1,
    "zh": "的诡异",
    "vi": "thứ quỷ dị đó."
  },
  {
    "idx": 7956,
    "start": "03:42:14,100",
    "end": "03:42:15,900",
    "start_sec": 13334.1,
    "end_sec": 13335.9,
    "zh": "这件事还得从曙光",
    "vi": "Chuyện này phải kể từ khi tàu Bình Minh"
  },
  {
    "idx": 7957,
    "start": "03:42:15,900",
    "end": "03:42:17,740",
    "start_sec": 13335.9,
    "end_sec": 13337.74,
    "zh": "好离开林江市那天说起",
    "vi": "rời khỏi thành phố Lâm Giang."
  },
  {
    "idx": 7958,
    "start": "03:42:17,740",
    "end": "03:42:19,840",
    "start_sec": 13337.74,
    "end_sec": 13339.84,
    "zh": "周扬应该已经告诉你了",
    "vi": "Chu Dương chắc đã nói với bạn rồi."
  },
  {
    "idx": 7959,
    "start": "03:42:19,840",
    "end": "03:42:20,880",
    "start_sec": 13339.84,
    "end_sec": 13340.88,
    "zh": "诡境能控诡域",
    "vi": "Quỷ cảnh có thể khống chế quỷ vực."
  },
  {
    "idx": 7960,
    "start": "03:42:20,880",
    "end": "03:42:22,900",
    "start_sec": 13340.88,
    "end_sec": 13342.9,
    "zh": "据预规者资料库显示",
    "vi": "Theo cơ sở dữ liệu của Ngự Quỷ Giả"
  },
  {
    "idx": 7961,
    "start": "03:42:22,900",
    "end": "03:42:24,560",
    "start_sec": 13342.9,
    "end_sec": 13344.56,
    "zh": "诡境所抵达的诡域里",
    "vi": "trong quỷ vực mà quỷ cảnh tiếp cận"
  },
  {
    "idx": 7962,
    "start": "03:42:24,560",
    "end": "03:42:25,440",
    "start_sec": 13344.56,
    "end_sec": 13345.44,
    "zh": "藏着无尽可能",
    "vi": "ẩn chứa vô vàn khả năng."
  },
  {
    "idx": 7963,
    "start": "03:42:25,440",
    "end": "03:42:27,500",
    "start_sec": 13345.44,
    "end_sec": 13347.5,
    "zh": "如果可以研究透南面古镜",
    "vi": "Nếu có thể nghiên cứu kỹ tấm gương cổ phía nam"
  },
  {
    "idx": 7964,
    "start": "03:42:27,500",
    "end": "03:42:29,140",
    "start_sec": 13347.5,
    "end_sec": 13349.14,
    "zh": "那么从中窥取鬼物",
    "vi": "thì việc tìm kiếm quỷ vật từ đó"
  },
  {
    "idx": 7965,
    "start": "03:42:29,140",
    "end": "03:42:30,460",
    "start_sec": 13349.14,
    "end_sec": 13350.46,
    "zh": "找寻新生鬼异",
    "vi": "phát hiện ra quỷ dị mới"
  },
  {
    "idx": 7966,
    "start": "03:42:30,460",
    "end": "03:42:33,280",
    "start_sec": 13350.46,
    "end_sec": 13353.28,
    "zh": "培养御鬼者的计划将会大大提升进步",
    "vi": "và kế hoạch nuôi dưỡng Ngự Quỷ Giả sẽ tiến triển vượt bậc."
  },
  {
    "idx": 7967,
    "start": "03:42:33,280",
    "end": "03:42:36,060",
    "start_sec": 13353.28,
    "end_sec": 13356.06,
    "zh": "总部为这次行动取名附近行动",
    "vi": "Tổng bộ đặt tên cho chiến dịch này là chiến dịch Phụ Cận."
  },
  {
    "idx": 7968,
    "start": "03:42:36,060",
    "end": "03:42:38,960",
    "start_sec": 13356.06,
    "end_sec": 13358.96,
    "zh": "这次行动一共从总部派遣了四人",
    "vi": "Tổng cộng có bốn người được tổng bộ phái đi"
  },
  {
    "idx": 7969,
    "start": "03:42:38,960",
    "end": "03:42:41,560",
    "start_sec": 13358.96,
    "end_sec": 13361.56,
    "zh": "我 026 037 032",
    "vi": "gồm tôi, 026, 037 và 032."
  },
  {
    "idx": 7970,
    "start": "03:42:41,560",
    "end": "03:42:43,660",
    "start_sec": 13361.56,
    "end_sec": 13363.66,
    "zh": "其中032作为先遣人员",
    "vi": "Trong đó, 032 là người đi tiên phong"
  },
  {
    "idx": 7971,
    "start": "03:42:43,660",
    "end": "03:42:45,220",
    "start_sec": 13363.66,
    "end_sec": 13365.22,
    "zh": "早一个月来临江市",
    "vi": "đã đến thành phố Lâm Giang trước một tháng"
  },
  {
    "idx": 7972,
    "start": "03:42:45,220",
    "end": "03:42:46,940",
    "start_sec": 13365.22,
    "end_sec": 13366.94,
    "zh": "是为了保护周家的安全",
    "vi": "để bảo vệ sự an toàn của nhà họ Chu"
  },
  {
    "idx": 7973,
    "start": "03:42:46,940",
    "end": "03:42:47,880",
    "start_sec": 13366.94,
    "end_sec": 13367.88,
    "zh": "保护古镜",
    "vi": "và bảo vệ gương cổ."
  },
  {
    "idx": 7974,
    "start": "03:42:47,880",
    "end": "03:42:50,060",
    "start_sec": 13367.88,
    "end_sec": 13370.06,
    "zh": "难怪周扬和老庙主熟悉",
    "vi": "Thảo nào Chu Dương lại quen thuộc với lão miếu chủ."
  },
  {
    "idx": 7975,
    "start": "03:42:50,060",
    "end": "03:42:51,860",
    "start_sec": 13370.06,
    "end_sec": 13371.86,
    "zh": "原来是有这层关系啊",
    "vi": "Hóa ra là có mối quan hệ này."
  },
  {
    "idx": 7976,
    "start": "03:42:51,860",
    "end": "03:42:52,280",
    "start_sec": 13371.86,
    "end_sec": 13372.28,
    "zh": "小三",
    "vi": "Tiểu Tam."
  },
  {
    "idx": 7977,
    "start": "03:42:52,280",
    "end": "03:42:54,720",
    "start_sec": 13372.28,
    "end_sec": 13374.72,
    "zh": "很多时候人比鬼还会说鬼话",
    "vi": "Nhiều lúc con người còn nói lời ma quỷ hơn cả quỷ."
  },
  {
    "idx": 7978,
    "start": "03:42:54,720",
    "end": "03:42:56,420",
    "start_sec": 13374.72,
    "end_sec": 13376.42,
    "zh": "你要是人话都听信了",
    "vi": "Nếu bạn tin sái cổ lời người nói"
  },
  {
    "idx": 7979,
    "start": "03:42:56,420",
    "end": "03:42:58,320",
    "start_sec": 13376.42,
    "end_sec": 13378.32,
    "zh": "你也就离变成鬼不远了",
    "vi": "thì bạn cũng sắp biến thành quỷ rồi đấy."
  },
  {
    "idx": 7980,
    "start": "03:42:58,320",
    "end": "03:43:01,040",
    "start_sec": 13378.32,
    "end_sec": 13381.04,
    "zh": "鬼一爆发后",
    "vi": "Sau khi quỷ bùng phát"
  },
  {
    "idx": 7981,
    "start": "03:43:01,040",
    "end": "03:43:02,340",
    "start_sec": 13381.04,
    "end_sec": 13382.34,
    "zh": "上头接到信息",
    "vi": "Cấp trên nhận được tin"
  },
  {
    "idx": 7982,
    "start": "03:43:02,340",
    "end": "03:43:03,820",
    "start_sec": 13382.34,
    "end_sec": 13383.82,
    "zh": "周家的古镜复苏了",
    "vi": "Cổ kính nhà họ Chu đã hồi sinh"
  },
  {
    "idx": 7983,
    "start": "03:43:03,820",
    "end": "03:43:05,340",
    "start_sec": 13383.82,
    "end_sec": 13385.34,
    "zh": "周鹤山能掌握古镜",
    "vi": "Chu Hạc Sơn có thể nắm giữ cổ kính"
  },
  {
    "idx": 7984,
    "start": "03:43:05,340",
    "end": "03:43:07,460",
    "start_sec": 13385.34,
    "end_sec": 13387.46,
    "zh": "开启古镜与鬼域的隧道",
    "vi": "Mở ra đường hầm giữa cổ kính và cõi âm"
  },
  {
    "idx": 7985,
    "start": "03:43:07,460",
    "end": "03:43:08,120",
    "start_sec": 13387.46,
    "end_sec": 13388.12,
    "zh": "对此",
    "vi": "Vì vậy"
  },
  {
    "idx": 7986,
    "start": "03:43:08,120",
    "end": "03:43:11,100",
    "start_sec": 13388.12,
    "end_sec": 13391.1,
    "zh": "曙光号第一时间出发进行古镜转移",
    "vi": "Tàu Tinh Minh lập tức xuất phát để chuyển cổ kính"
  },
  {
    "idx": 7987,
    "start": "03:43:11,100",
    "end": "03:43:13,280",
    "start_sec": 13391.1,
    "end_sec": 13393.28,
    "zh": "我是本次行动主要负责人",
    "vi": "Tôi là người phụ trách chính của nhiệm vụ này"
  },
  {
    "idx": 7988,
    "start": "03:43:13,280",
    "end": "03:43:14,520",
    "start_sec": 13393.28,
    "end_sec": 13394.52,
    "zh": "026为辅助",
    "vi": "026 phụ trách hỗ trợ"
  },
  {
    "idx": 7989,
    "start": "03:43:14,520",
    "end": "03:43:15,860",
    "start_sec": 13394.52,
    "end_sec": 13395.86,
    "zh": "037为前锋",
    "vi": "037 phụ trách tiền phong"
  },
  {
    "idx": 7990,
    "start": "03:43:15,860",
    "end": "03:43:17,020",
    "start_sec": 13395.86,
    "end_sec": 13397.02,
    "zh": "至于032",
    "vi": "Còn về 032"
  },
  {
    "idx": 7991,
    "start": "03:43:17,020",
    "end": "03:43:18,360",
    "start_sec": 13397.02,
    "end_sec": 13398.36,
    "zh": "上头看他人老",
    "vi": "Cấp trên thấy anh ta già rồi"
  },
  {
    "idx": 7992,
    "start": "03:43:18,360",
    "end": "03:43:19,840",
    "start_sec": 13398.36,
    "end_sec": 13399.84,
    "zh": "是让他先一步回去",
    "vi": "Nên cho anh ta về trước"
  },
  {
    "idx": 7993,
    "start": "03:43:19,840",
    "end": "03:43:22,280",
    "start_sec": 13399.84,
    "end_sec": 13402.28,
    "zh": "后面我们三人到达了临江市",
    "vi": "Sau đó ba người chúng tôi đến thành phố Lâm Giang"
  },
  {
    "idx": 7994,
    "start": "03:43:22,280",
    "end": "03:43:24,680",
    "start_sec": 13402.28,
    "end_sec": 13404.68,
    "zh": "为了保护周家人和古镜撤退",
    "vi": "Để bảo vệ người nhà họ Chu và rút lui cùng cổ kính"
  },
  {
    "idx": 7995,
    "start": "03:43:24,680",
    "end": "03:43:27,200",
    "start_sec": 13404.68,
    "end_sec": 13407.2,
    "zh": "037过度使用体内肠化鬼",
    "vi": "037 đã sử dụng quá nhiều năng lực quỷ trong người"
  },
  {
    "idx": 7996,
    "start": "03:43:27,200",
    "end": "03:43:30,380",
    "start_sec": 13407.2,
    "end_sec": 13410.38,
    "zh": "以防他的诡异复苏对计划产生危险",
    "vi": "Để đề phòng việc quỷ dị của anh ta hồi sinh gây nguy hiểm cho kế hoạch"
  },
  {
    "idx": 7997,
    "start": "03:43:30,380",
    "end": "03:43:33,020",
    "start_sec": 13410.38,
    "end_sec": 13413.02,
    "zh": "我和026决定让他自行撤离",
    "vi": "Tôi và 026 quyết định để anh ta tự rút lui"
  },
  {
    "idx": 7998,
    "start": "03:43:33,020",
    "end": "03:43:34,040",
    "start_sec": 13413.02,
    "end_sec": 13414.04,
    "zh": "这一分开",
    "vi": "Chia tay nhau từ đó"
  },
  {
    "idx": 7999,
    "start": "03:43:34,040",
    "end": "03:43:36,300",
    "start_sec": 13414.04,
    "end_sec": 13416.3,
    "zh": "我是没想到你能遇到037",
    "vi": "Tôi không ngờ bạn lại gặp được 037"
  },
  {
    "idx": 8000,
    "start": "03:43:36,300",
    "end": "03:43:37,180",
    "start_sec": 13416.3,
    "end_sec": 13417.18,
    "zh": "还真是",
    "vi": "Thật là"
  },
  {
    "idx": 8001,
    "start": "03:43:37,180",
    "end": "03:43:38,080",
    "start_sec": 13417.18,
    "end_sec": 13418.08,
    "zh": "缘分啊",
    "vi": "Duyên phận"
  },
  {
    "idx": 8002,
    "start": "03:43:38,080",
    "end": "03:43:38,980",
    "start_sec": 13418.08,
    "end_sec": 13418.98,
    "zh": "原来如此",
    "vi": "Thì ra là vậy"
  },
  {
    "idx": 8003,
    "start": "03:43:38,980",
    "end": "03:43:40,580",
    "start_sec": 13418.98,
    "end_sec": 13420.58,
    "zh": "我就说037这么去",
    "vi": "Tôi đã nói 037 đi như vậy"
  },
  {
    "idx": 8004,
    "start": "03:43:40,580",
    "end": "03:43:41,940",
    "start_sec": 13420.58,
    "end_sec": 13421.94,
    "zh": "动不动就诡异复苏",
    "vi": "Lúc nào cũng hồi sinh quỷ dị"
  },
  {
    "idx": 8005,
    "start": "03:43:41,940",
    "end": "03:43:43,880",
    "start_sec": 13421.94,
    "end_sec": 13423.88,
    "zh": "原来是在互进行动中",
    "vi": "Hóa ra là trong nhiệm vụ hỗ trợ lẫn nhau"
  },
  {
    "idx": 8006,
    "start": "03:43:43,880",
    "end": "03:43:45,100",
    "start_sec": 13423.88,
    "end_sec": 13425.1,
    "zh": "已经消耗了太多",
    "vi": "Đã tiêu hao quá nhiều"
  },
  {
    "idx": 8007,
    "start": "03:43:45,100",
    "end": "03:43:47,500",
    "start_sec": 13425.1,
    "end_sec": 13427.5,
    "zh": "估计那所谓的上头",
    "vi": "Ước chừng cái gọi là cấp trên kia"
  },
  {
    "idx": 8008,
    "start": "03:43:47,500",
    "end": "03:43:48,360",
    "start_sec": 13427.5,
    "end_sec": 13428.36,
    "zh": "现在还不知道",
    "vi": "Bây giờ vẫn chưa biết"
  },
  {
    "idx": 8009,
    "start": "03:43:48,360",
    "end": "03:43:50,680",
    "start_sec": 13428.36,
    "end_sec": 13430.68,
    "zh": "037和032因为抢龟果",
    "vi": "037 và 032 vì tranh giành Quả Rùa"
  },
  {
    "idx": 8010,
    "start": "03:43:50,680",
    "end": "03:43:51,740",
    "start_sec": 13430.68,
    "end_sec": 13431.74,
    "zh": "互相玩死了吧",
    "vi": "Đã giết chết lẫn nhau rồi"
  },
  {
    "idx": 8011,
    "start": "03:43:51,740",
    "end": "03:43:53,520",
    "start_sec": 13431.74,
    "end_sec": 13433.52,
    "zh": "话说回来",
    "vi": "Nói đi cũng phải nói lại."
  },
  {
    "idx": 8012,
    "start": "03:43:53,520",
    "end": "03:43:57,040",
    "start_sec": 13433.52,
    "end_sec": 13437.04,
    "zh": "变故就出现在将周家人接到曙光号的那天",
    "vi": "Biến cố xảy ra đúng vào ngày đón người nhà họ Chu lên tàu Bình Minh."
  },
  {
    "idx": 8013,
    "start": "03:43:57,040",
    "end": "03:43:59,780",
    "start_sec": 13437.04,
    "end_sec": 13439.78,
    "zh": "曙光号原定是计划停留五天",
    "vi": "Tàu Bình Minh dự kiến sẽ dừng lại năm ngày."
  },
  {
    "idx": 8014,
    "start": "03:43:59,780",
    "end": "03:44:01,920",
    "start_sec": 13439.78,
    "end_sec": 13441.92,
    "zh": "顺带多救些临江市市民",
    "vi": "Tiện thể cứu thêm nhiều người dân thành phố Lâm Giang."
  },
  {
    "idx": 8015,
    "start": "03:44:01,920",
    "end": "03:44:03,880",
    "start_sec": 13441.92,
    "end_sec": 13443.88,
    "zh": "可邮轮停泊三日后",
    "vi": "Nhưng sau khi tàu cập bến được ba ngày."
  },
  {
    "idx": 8016,
    "start": "03:44:03,880",
    "end": "03:44:05,820",
    "start_sec": 13443.88,
    "end_sec": 13445.82,
    "zh": "就在周家人上船的晚上",
    "vi": "Đúng vào đêm người nhà họ Chu lên tàu."
  },
  {
    "idx": 8017,
    "start": "03:44:05,820",
    "end": "03:44:07,200",
    "start_sec": 13445.82,
    "end_sec": 13447.2,
    "zh": "船上起了大雾",
    "vi": "Trên tàu xuất hiện sương mù dày đặc."
  },
  {
    "idx": 8018,
    "start": "03:44:07,200",
    "end": "03:44:10,620",
    "start_sec": 13447.2,
    "end_sec": 13450.62,
    "zh": "接着就有几名船员开始变得不对劲",
    "vi": "Sau đó có vài thuyền viên bắt đầu có biểu hiện bất thường."
  },
  {
    "idx": 8019,
    "start": "03:44:10,620",
    "end": "03:44:12,220",
    "start_sec": 13450.62,
    "end_sec": 13452.22,
    "zh": "长子提缓缓地下头",
    "vi": "Trưởng tử cúi đầu chậm rãi."
  },
  {
    "idx": 8020,
    "start": "03:44:12,220",
    "end": "03:44:14,180",
    "start_sec": 13452.22,
    "end_sec": 13454.18,
    "zh": "是指那些人不是本人吗",
    "vi": "Ý bạn là những người đó không phải là chính họ sao."
  },
  {
    "idx": 8021,
    "start": "03:44:14,180",
    "end": "03:44:14,880",
    "start_sec": 13454.18,
    "end_sec": 13454.88,
    "zh": "没错",
    "vi": "Đúng vậy."
  },
  {
    "idx": 8022,
    "start": "03:44:14,880",
    "end": "03:44:17,640",
    "start_sec": 13454.88,
    "end_sec": 13457.64,
    "zh": "他们声音体型各种特征都没变",
    "vi": "Giọng nói hình dáng và mọi đặc điểm của họ đều không thay đổi."
  },
  {
    "idx": 8023,
    "start": "03:44:17,640",
    "end": "03:44:19,700",
    "start_sec": 13457.64,
    "end_sec": 13459.7,
    "zh": "但却都变得沉默不爱说话",
    "vi": "Nhưng họ trở nên trầm lặng và ít nói hơn."
  },
  {
    "idx": 8024,
    "start": "03:44:19,700",
    "end": "03:44:21,360",
    "start_sec": 13459.7,
    "end_sec": 13461.36,
    "zh": "晚上也会莫名消失",
    "vi": "Đêm đến còn biến mất một cách khó hiểu."
  },
  {
    "idx": 8025,
    "start": "03:44:21,360",
    "end": "03:44:23,260",
    "start_sec": 13461.36,
    "end_sec": 13463.26,
    "zh": "事情会报到我这里的时候",
    "vi": "Khi sự việc được báo cáo lên tôi."
  },
  {
    "idx": 8026,
    "start": "03:44:23,260",
    "end": "03:44:24,980",
    "start_sec": 13463.26,
    "end_sec": 13464.98,
    "zh": "我和026都很动视",
    "vi": "Tôi và 026 đều rất cảnh giác."
  },
  {
    "idx": 8027,
    "start": "03:44:24,980",
    "end": "03:44:26,740",
    "start_sec": 13464.98,
    "end_sec": 13466.74,
    "zh": "因为电话的人",
    "vi": "Bởi vì những người đó."
  },
  {
    "idx": 8028,
    "start": "03:44:26,740",
    "end": "03:44:27,980",
    "start_sec": 13466.74,
    "end_sec": 13467.98,
    "zh": "其中包括船长",
    "vi": "Trong đó có cả thuyền trưởng."
  },
  {
    "idx": 8029,
    "start": "03:44:27,980",
    "end": "03:44:30,200",
    "start_sec": 13467.98,
    "end_sec": 13470.2,
    "zh": "如果船长都被诡异代替了",
    "vi": "Nếu thuyền trưởng cũng bị thực thể quỷ dị thay thế."
  },
  {
    "idx": 8030,
    "start": "03:44:30,200",
    "end": "03:44:31,460",
    "start_sec": 13470.2,
    "end_sec": 13471.46,
    "zh": "那么开船的",
    "vi": "Vậy thì người lái tàu."
  },
  {
    "idx": 8031,
    "start": "03:44:31,460",
    "end": "03:44:33,960",
    "start_sec": 13471.46,
    "end_sec": 13473.96,
    "zh": "船开不了了",
    "vi": "Tàu sẽ không thể vận hành được nữa."
  },
  {
    "idx": 8032,
    "start": "03:44:33,960",
    "end": "03:44:35,440",
    "start_sec": 13473.96,
    "end_sec": 13475.44,
    "zh": "不过有026在",
    "vi": "Nhưng vì có 026 ở đây."
  },
  {
    "idx": 8033,
    "start": "03:44:35,440",
    "end": "03:44:36,420",
    "start_sec": 13475.44,
    "end_sec": 13476.42,
    "zh": "问题也不大",
    "vi": "Nên vấn đề cũng không quá lớn."
  },
  {
    "idx": 8034,
    "start": "03:44:36,420",
    "end": "03:44:38,560",
    "start_sec": 13476.42,
    "end_sec": 13478.56,
    "zh": "这就是为什么这次行动走水路",
    "vi": "Đây chính là lý do tại sao chuyến đi này chọn đường thủy."
  },
  {
    "idx": 8035,
    "start": "03:44:38,560",
    "end": "03:44:40,220",
    "start_sec": 13478.56,
    "end_sec": 13480.22,
    "zh": "要带上026的原因",
    "vi": "Và phải mang theo 026."
  },
  {
    "idx": 8036,
    "start": "03:44:40,220",
    "end": "03:44:43,320",
    "start_sec": 13480.22,
    "end_sec": 13483.32,
    "zh": "它的诡异水轨能控制一定范围的水流",
    "vi": "Khả năng quỷ dị của nó có thể kiểm soát dòng nước trong phạm vi nhất định."
  },
  {
    "idx": 8037,
    "start": "03:44:43,320",
    "end": "03:44:44,440",
    "start_sec": 13483.32,
    "end_sec": 13484.44,
    "zh": "我们一度怀疑",
    "vi": "Chúng tôi từng nghi ngờ."
  },
  {
    "idx": 8038,
    "start": "03:44:44,440",
    "end": "03:44:47,500",
    "start_sec": 13484.44,
    "end_sec": 13487.5,
    "zh": "是不是有外来诡异通过假扮人群混上了船",
    "vi": "Liệu có thực thể quỷ dị nào giả dạng người để trà trộn lên tàu hay không."
  },
  {
    "idx": 8039,
    "start": "03:44:47,500",
    "end": "03:44:50,540",
    "start_sec": 13487.5,
    "end_sec": 13490.54,
    "zh": "在逐步有目标的要吞噬控船人员",
    "vi": "Đang từng bước nhắm vào mục tiêu là nuốt chửng nhân viên điều khiển tàu."
  },
  {
    "idx": 8040,
    "start": "03:44:50,540",
    "end": "03:44:51,520",
    "start_sec": 13490.54,
    "end_sec": 13491.52,
    "zh": "这么说的话",
    "vi": "Nếu nói như vậy."
  },
  {
    "idx": 8041,
    "start": "03:44:51,520",
    "end": "03:44:54,120",
    "start_sec": 13491.52,
    "end_sec": 13494.12,
    "zh": "这好像是一场有组织有预谋的行动",
    "vi": "Đây có vẻ là một hành động có tổ chức và được lên kế hoạch từ trước."
  },
  {
    "idx": 8042,
    "start": "03:44:54,120",
    "end": "03:44:56,335",
    "start_sec": 13494.12,
    "end_sec": 13496.335,
    "zh": "目的是要让曙光号平行所以在诡异降临的第三天的晚上我就更改了计划让026直接去高南河岸的水推动曙光号开始远航去高南河岸的水",
    "vi": "Mục đích là để tàu Bình Minh đi song song"
  },
  {
    "idx": 8042,
    "start": "03:44:56,335",
    "end": "03:45:00,985",
    "start_sec": 13496.335,
    "end_sec": 13500.985,
    "zh": "目的是要让曙光号平行所以在诡异降临的第三天的晚上我就更改了计划让026直接去高南河岸的水推动曙光号开始远航去高南河岸的水",
    "vi": "Vì vậy vào đêm thứ ba khi sự kiện kỳ dị ập đến, tôi đã thay đổi kế hoạch, để số"
  },
  {
    "idx": 8042,
    "start": "03:45:00,985",
    "end": "03:45:05,857",
    "start_sec": 13500.985,
    "end_sec": 13505.857,
    "zh": "目的是要让曙光号平行所以在诡异降临的第三天的晚上我就更改了计划让026直接去高南河岸的水推动曙光号开始远航去高南河岸的水",
    "vi": "026 trực tiếp đi đến vùng nước bờ sông Cao Nam để đẩy tàu Bình Minh bắt đầu chuyến hải trình dài"
  },
  {
    "idx": 8043,
    "start": "03:45:05,857",
    "end": "03:45:06,857",
    "start_sec": 13505.857,
    "end_sec": 13506.857,
    "zh": "原来如此",
    "vi": "Hóa ra là vậy."
  },
  {
    "idx": 8044,
    "start": "03:45:06,857",
    "end": "03:45:08,937",
    "start_sec": 13506.857,
    "end_sec": 13508.937,
    "zh": "难怪诡异降临第四天的早晨",
    "vi": "Thảo nào vào buổi sáng ngày thứ tư khi sự kiện kỳ dị ập đến."
  },
  {
    "idx": 8045,
    "start": "03:45:08,937",
    "end": "03:45:10,917",
    "start_sec": 13508.937,
    "end_sec": 13510.917,
    "zh": "我开着面包车去南河岸边",
    "vi": "Tôi lái chiếc xe van đến bờ sông Nam."
  },
  {
    "idx": 8046,
    "start": "03:45:10,917",
    "end": "03:45:13,077",
    "start_sec": 13510.917,
    "end_sec": 13513.077,
    "zh": "城外全是堆积的高水走不通",
    "vi": "Bên ngoài thành phố toàn là nước dâng cao tích tụ, không thể đi qua được."
  },
  {
    "idx": 8047,
    "start": "03:45:13,077",
    "end": "03:45:15,477",
    "start_sec": 13513.077,
    "end_sec": 13515.477,
    "zh": "那能开船啊",
    "vi": "Nhưng lại có thể đi thuyền."
  },
  {
    "idx": 8048,
    "start": "03:45:15,477",
    "end": "03:45:17,697",
    "start_sec": 13515.477,
    "end_sec": 13517.697,
    "zh": "怎么解决那些有异常的船员的",
    "vi": "Anh đã giải quyết những thuyền viên có biểu hiện bất thường đó thế nào."
  },
  {
    "idx": 8049,
    "start": "03:45:17,697",
    "end": "03:45:18,757",
    "start_sec": 13517.697,
    "end_sec": 13518.757,
    "zh": "你觉得呢",
    "vi": "Anh nghĩ sao."
  },
  {
    "idx": 8050,
    "start": "03:45:18,757",
    "end": "03:45:20,357",
    "start_sec": 13518.757,
    "end_sec": 13520.357,
    "zh": "不会是一个一个找到",
    "vi": "Không lẽ là tìm từng người một."
  },
  {
    "idx": 8051,
    "start": "03:45:20,357",
    "end": "03:45:21,217",
    "start_sec": 13520.357,
    "end_sec": 13521.217,
    "zh": "偷偷杀掉",
    "vi": "rồi âm thầm giết chết."
  },
  {
    "idx": 8052,
    "start": "03:45:21,217",
    "end": "03:45:22,317",
    "start_sec": 13521.217,
    "end_sec": 13522.317,
    "zh": "全给扔水里了吧",
    "vi": "và ném hết xuống nước sao."
  },
  {
    "idx": 8053,
    "start": "03:45:22,317",
    "end": "03:45:22,997",
    "start_sec": 13522.317,
    "end_sec": 13522.997,
    "zh": "没错",
    "vi": "Đúng vậy."
  },
  {
    "idx": 8054,
    "start": "03:45:22,997",
    "end": "03:45:24,037",
    "start_sec": 13522.997,
    "end_sec": 13524.037,
    "zh": "找到他们时",
    "vi": "Khi tìm thấy họ."
  },
  {
    "idx": 8055,
    "start": "03:45:24,037",
    "end": "03:45:25,857",
    "start_sec": 13524.037,
    "end_sec": 13525.857,
    "zh": "他们甚至会出言反抗",
    "vi": "họ thậm chí còn lên tiếng chống cự."
  },
  {
    "idx": 8056,
    "start": "03:45:25,857",
    "end": "03:45:27,397",
    "start_sec": 13525.857,
    "end_sec": 13527.397,
    "zh": "但杀掉丢水里后",
    "vi": "Nhưng sau khi bị giết và ném xuống nước."
  },
  {
    "idx": 8057,
    "start": "03:45:27,397",
    "end": "03:45:29,397",
    "start_sec": 13527.397,
    "end_sec": 13529.397,
    "zh": "一个个又变成了水雾消散",
    "vi": "từng người một lại biến thành sương nước rồi tan biến."
  },
  {
    "idx": 8058,
    "start": "03:45:29,397",
    "end": "03:45:30,257",
    "start_sec": 13529.397,
    "end_sec": 13530.257,
    "zh": "着实怪异",
    "vi": "Thật là kỳ quái."
  },
  {
    "idx": 8059,
    "start": "03:45:30,257",
    "end": "03:45:32,657",
    "start_sec": 13530.257,
    "end_sec": 13532.657,
    "zh": "那既然把所有异常的人都解决了",
    "vi": "Vậy nếu đã giải quyết hết những người bất thường đó rồi."
  },
  {
    "idx": 8060,
    "start": "03:45:32,657",
    "end": "03:45:34,417",
    "start_sec": 13532.657,
    "end_sec": 13534.417,
    "zh": "现在船上应该是安全的吧",
    "vi": "Hiện tại trên tàu chắc là an toàn rồi chứ."
  },
  {
    "idx": 8061,
    "start": "03:45:34,417",
    "end": "03:45:36,457",
    "start_sec": 13534.417,
    "end_sec": 13536.457,
    "zh": "如果诡异是从船外来的",
    "vi": "Nếu sự kỳ dị đến từ bên ngoài tàu."
  },
  {
    "idx": 8062,
    "start": "03:45:36,457",
    "end": "03:45:38,357",
    "start_sec": 13536.457,
    "end_sec": 13538.357,
    "zh": "我们当然全部铲除了内祸",
    "vi": "thì chúng ta đương nhiên đã dẹp sạch mối họa bên trong."
  },
  {
    "idx": 8063,
    "start": "03:45:38,357",
    "end": "03:45:41,157",
    "start_sec": 13538.357,
    "end_sec": 13541.157,
    "zh": "而且走水路不存在再有诡异堆积",
    "vi": "Hơn nữa đi đường thủy sẽ không còn sự kỳ dị tích tụ nữa."
  },
  {
    "idx": 8064,
    "start": "03:45:41,157",
    "end": "03:45:42,077",
    "start_sec": 13541.157,
    "end_sec": 13542.077,
    "zh": "绝对的安全",
    "vi": "Tuyệt đối an toàn."
  },
  {
    "idx": 8065,
    "start": "03:45:42,077",
    "end": "03:45:44,377",
    "start_sec": 13542.077,
    "end_sec": 13544.377,
    "zh": "但是让人没想到的是",
    "vi": "Nhưng điều không ai ngờ tới là."
  },
  {
    "idx": 8066,
    "start": "03:45:44,377",
    "end": "03:45:45,157",
    "start_sec": 13544.377,
    "end_sec": 13545.157,
    "zh": "隔了几天",
    "vi": "vài ngày sau."
  },
  {
    "idx": 8067,
    "start": "03:45:45,157",
    "end": "03:45:46,957",
    "start_sec": 13545.157,
    "end_sec": 13546.957,
    "zh": "又有人开始变得不对劲",
    "vi": "lại có người bắt đầu trở nên bất thường."
  },
  {
    "idx": 8068,
    "start": "03:45:46,957",
    "end": "03:45:48,237",
    "start_sec": 13546.957,
    "end_sec": 13548.237,
    "zh": "啊 不是吧",
    "vi": "Hả, không thể nào."
  },
  {
    "idx": 8069,
    "start": "03:45:48,237",
    "end": "03:45:49,797",
    "start_sec": 13548.237,
    "end_sec": 13549.797,
    "zh": "王子皮有点猛逼",
    "vi": "Vương Tử Bì hơi hoang mang."
  },
  {
    "idx": 8070,
    "start": "03:45:49,797",
    "end": "03:45:51,797",
    "start_sec": 13549.797,
    "end_sec": 13551.797,
    "zh": "他千辛万苦财上的曙光号",
    "vi": "Con tàu Bình Minh mà anh ta đã phải trải qua muôn vàn khó khăn mới lên được."
  },
  {
    "idx": 8071,
    "start": "03:45:51,797",
    "end": "03:45:53,177",
    "start_sec": 13551.797,
    "end_sec": 13553.177,
    "zh": "里面竟然还有诡异",
    "vi": "Bên trong hóa ra vẫn còn thứ quỷ dị."
  },
  {
    "idx": 8072,
    "start": "03:45:53,177",
    "end": "03:45:55,177",
    "start_sec": 13553.177,
    "end_sec": 13555.177,
    "zh": "这件事情很棘手",
    "vi": "Chuyện này rất rắc rối."
  },
  {
    "idx": 8073,
    "start": "03:45:55,177",
    "end": "03:45:57,017",
    "start_sec": 13555.177,
    "end_sec": 13557.017,
    "zh": "要是人群里有些许落单的",
    "vi": "Nếu trong đám đông có vài người đi lẻ."
  },
  {
    "idx": 8074,
    "start": "03:45:57,017",
    "end": "03:45:58,617",
    "start_sec": 13557.017,
    "end_sec": 13558.617,
    "zh": "或者不熟悉的小团体",
    "vi": "Hoặc những nhóm nhỏ không quen biết."
  },
  {
    "idx": 8075,
    "start": "03:45:58,617",
    "end": "03:45:59,777",
    "start_sec": 13558.617,
    "end_sec": 13559.777,
    "zh": "没人了解他们",
    "vi": "Không ai hiểu rõ họ."
  },
  {
    "idx": 8076,
    "start": "03:45:59,777",
    "end": "03:46:02,157",
    "start_sec": 13559.777,
    "end_sec": 13562.157,
    "zh": "就算他们被替换了也没人知道",
    "vi": "Dù họ có bị tráo đổi cũng không ai biết."
  },
  {
    "idx": 8077,
    "start": "03:46:02,157",
    "end": "03:46:02,737",
    "start_sec": 13562.157,
    "end_sec": 13562.737,
    "zh": "再者",
    "vi": "Hơn nữa."
  },
  {
    "idx": 8078,
    "start": "03:46:02,737",
    "end": "03:46:05,877",
    "start_sec": 13562.737,
    "end_sec": 13565.877,
    "zh": "如果被替换的人反过来造谣正常人有问题",
    "vi": "Nếu người bị tráo đổi quay lại vu khống người bình thường có vấn đề."
  },
  {
    "idx": 8079,
    "start": "03:46:05,877",
    "end": "03:46:08,037",
    "start_sec": 13565.877,
    "end_sec": 13568.037,
    "zh": "也无法第一时间判断对错",
    "vi": "Thì cũng không thể phân biệt đúng sai ngay lập tức."
  },
  {
    "idx": 8080,
    "start": "03:46:08,037",
    "end": "03:46:09,637",
    "start_sec": 13568.037,
    "end_sec": 13569.637,
    "zh": "因为你无法确定",
    "vi": "Bởi vì bạn không thể chắc chắn."
  },
  {
    "idx": 8081,
    "start": "03:46:09,637",
    "end": "03:46:11,497",
    "start_sec": 13569.637,
    "end_sec": 13571.497,
    "zh": "你面对的每一个人都是人",
    "vi": "Mỗi người bạn đối mặt đều là con người."
  },
  {
    "idx": 8082,
    "start": "03:46:11,497",
    "end": "03:46:13,217",
    "start_sec": 13571.497,
    "end_sec": 13573.217,
    "zh": "这确实如此",
    "vi": "Đúng là như vậy."
  },
  {
    "idx": 8083,
    "start": "03:46:13,217",
    "end": "03:46:15,517",
    "start_sec": 13573.217,
    "end_sec": 13575.517,
    "zh": "总不能把所有活人都丢谁里",
    "vi": "Đâu thể ném tất cả người sống xuống nước được."
  },
  {
    "idx": 8084,
    "start": "03:46:15,517",
    "end": "03:46:16,797",
    "start_sec": 13575.517,
    "end_sec": 13576.797,
    "zh": "023的话说完",
    "vi": "Sau khi Không Hai Ba nói xong."
  },
  {
    "idx": 8085,
    "start": "03:46:16,797",
    "end": "03:46:18,197",
    "start_sec": 13576.797,
    "end_sec": 13578.197,
    "zh": "房间内好一阵寂静",
    "vi": "Trong phòng chìm vào im lặng một hồi."
  },
  {
    "idx": 8086,
    "start": "03:46:18,197",
    "end": "03:46:19,737",
    "start_sec": 13578.197,
    "end_sec": 13579.737,
    "zh": "毕竟可以化为人的诡异",
    "vi": "Dù sao thì quỷ dị có thể hóa thành người."
  },
  {
    "idx": 8087,
    "start": "03:46:19,737",
    "end": "03:46:20,657",
    "start_sec": 13579.737,
    "end_sec": 13580.657,
    "zh": "除了遇鬼者",
    "vi": "Ngoại trừ những người từng gặp quỷ."
  },
  {
    "idx": 8088,
    "start": "03:46:20,657",
    "end": "03:46:22,617",
    "start_sec": 13580.657,
    "end_sec": 13582.617,
    "zh": "普通人是无法分辨出来的",
    "vi": "Người bình thường không thể phân biệt được."
  },
  {
    "idx": 8089,
    "start": "03:46:22,617",
    "end": "03:46:24,737",
    "start_sec": 13582.617,
    "end_sec": 13584.737,
    "zh": "所以前辈刚刚试探我",
    "vi": "Cho nên tiền bối vừa rồi thử tôi."
  },
  {
    "idx": 8090,
    "start": "03:46:24,737",
    "end": "03:46:26,077",
    "start_sec": 13584.737,
    "end_sec": 13586.077,
    "zh": "是怕我是鬼一变的",
    "vi": "Là sợ tôi do quỷ biến thành."
  },
  {
    "idx": 8091,
    "start": "03:46:26,077",
    "end": "03:46:27,117",
    "start_sec": 13586.077,
    "end_sec": 13587.117,
    "zh": "鬼一能变成我",
    "vi": "Quỷ có thể biến thành tôi."
  },
  {
    "idx": 8092,
    "start": "03:46:27,117",
    "end": "03:46:28,417",
    "start_sec": 13587.117,
    "end_sec": 13588.417,
    "zh": "但不会拥有我的能力",
    "vi": "Nhưng không thể có được năng lực của tôi."
  },
  {
    "idx": 8093,
    "start": "03:46:28,417",
    "end": "03:46:29,537",
    "start_sec": 13588.417,
    "end_sec": 13589.537,
    "zh": "如果我动用能力",
    "vi": "Nếu tôi dùng năng lực."
  },
  {
    "idx": 8094,
    "start": "03:46:29,537",
    "end": "03:46:30,617",
    "start_sec": 13589.537,
    "end_sec": 13590.617,
    "zh": "就证明我还是我",
    "vi": "Sẽ chứng minh tôi vẫn là tôi."
  },
  {
    "idx": 8095,
    "start": "03:46:30,617",
    "end": "03:46:31,877",
    "start_sec": 13590.617,
    "end_sec": 13591.877,
    "zh": "照前辈这么说",
    "vi": "Theo như tiền bối nói."
  },
  {
    "idx": 8096,
    "start": "03:46:31,877",
    "end": "03:46:33,737",
    "start_sec": 13591.877,
    "end_sec": 13593.737,
    "zh": "其实曙光号看起来平静",
    "vi": "Thực ra tàu Bình Minh trông thì bình yên."
  },
  {
    "idx": 8097,
    "start": "03:46:33,737",
    "end": "03:46:35,077",
    "start_sec": 13593.737,
    "end_sec": 13595.077,
    "zh": "实则草木皆兵了",
    "vi": "Nhưng thực chất ai cũng hoang mang lo sợ."
  },
  {
    "idx": 8098,
    "start": "03:46:35,077",
    "end": "03:46:36,517",
    "start_sec": 13595.077,
    "end_sec": 13596.517,
    "zh": "所以你才问我",
    "vi": "Cho nên bạn mới hỏi tôi."
  },
  {
    "idx": 8099,
    "start": "03:46:36,517",
    "end": "03:46:37,537",
    "start_sec": 13596.517,
    "end_sec": 13597.537,
    "zh": "周扬还是不是周扬",
    "vi": "Chu Dương có còn là Chu Dương không."
  },
  {
    "idx": 8100,
    "start": "03:46:37,537",
    "end": "03:46:38,337",
    "start_sec": 13597.537,
    "end_sec": 13598.337,
    "zh": "没错",
    "vi": "Đúng vậy."
  },
  {
    "idx": 8101,
    "start": "03:46:38,337",
    "end": "03:46:40,097",
    "start_sec": 13598.337,
    "end_sec": 13600.097,
    "zh": "因为和周扬熟悉的人",
    "vi": "Bởi vì người quen thuộc với Chu Dương."
  },
  {
    "idx": 8102,
    "start": "03:46:40,097",
    "end": "03:46:41,057",
    "start_sec": 13600.097,
    "end_sec": 13601.057,
    "zh": "只有他老爹",
    "vi": "Chỉ có bố của anh ta."
  },
  {
    "idx": 8103,
    "start": "03:46:41,057",
    "end": "03:46:43,037",
    "start_sec": 13601.057,
    "end_sec": 13603.037,
    "zh": "这件事出现的第一时间",
    "vi": "Ngay khi sự việc này xảy ra."
  },
  {
    "idx": 8104,
    "start": "03:46:43,037",
    "end": "03:46:45,297",
    "start_sec": 13603.037,
    "end_sec": 13605.297,
    "zh": "我们就将周赫山保护了起来",
    "vi": "Chúng tôi đã bảo vệ Chu Hách Sơn."
  },
  {
    "idx": 8105,
    "start": "03:46:45,297",
    "end": "03:46:46,877",
    "start_sec": 13605.297,
    "end_sec": 13606.877,
    "zh": "关在了三楼船长室",
    "vi": "Nhốt ở trong phòng thuyền trưởng tầng ba."
  },
  {
    "idx": 8106,
    "start": "03:46:46,877",
    "end": "03:46:49,217",
    "start_sec": 13606.877,
    "end_sec": 13609.217,
    "zh": "你们就不怕周市长也被调包了",
    "vi": "Các bạn không sợ Thị trưởng Chu cũng bị tráo đổi sao."
  },
  {
    "idx": 8107,
    "start": "03:46:49,217",
    "end": "03:46:50,357",
    "start_sec": 13609.217,
    "end_sec": 13610.357,
    "zh": "这个不存在",
    "vi": "Điều này không thể xảy ra."
  },
  {
    "idx": 8108,
    "start": "03:46:50,357",
    "end": "03:46:51,497",
    "start_sec": 13610.357,
    "end_sec": 13611.497,
    "zh": "因为在事发后",
    "vi": "Bởi vì sau khi sự việc xảy ra."
  },
  {
    "idx": 8109,
    "start": "03:46:51,497",
    "end": "03:46:53,737",
    "start_sec": 13611.497,
    "end_sec": 13613.737,
    "zh": "我们让他当面开启了一些古镜",
    "vi": "Chúng tôi đã để ông ấy trực tiếp mở một số gương cổ."
  },
  {
    "idx": 8110,
    "start": "03:46:53,737",
    "end": "03:46:56,877",
    "start_sec": 13613.737,
    "end_sec": 13616.877,
    "zh": "这才敢将他和古镜同时关进船长室",
    "vi": "Nên mới dám nhốt ông ấy và gương cổ vào phòng thuyền trưởng cùng lúc."
  },
  {
    "idx": 8111,
    "start": "03:46:56,877",
    "end": "03:46:59,697",
    "start_sec": 13616.877,
    "end_sec": 13619.697,
    "zh": "诡异应该没有开启古镜的能力吧",
    "vi": "Quái dị chắc là không có khả năng mở gương cổ đâu nhỉ."
  },
  {
    "idx": 8112,
    "start": "03:46:59,697",
    "end": "03:47:00,337",
    "start_sec": 13619.697,
    "end_sec": 13620.337,
    "zh": "这样的话",
    "vi": "Nếu vậy thì."
  },
  {
    "idx": 8113,
    "start": "03:47:00,337",
    "end": "03:47:03,277",
    "start_sec": 13620.337,
    "end_sec": 13623.277,
    "zh": "如果诡异没有能复刻原体记忆情绪能力的话",
    "vi": "Nếu quái dị không có khả năng sao chép ký ức và cảm xúc của bản thể."
  },
  {
    "idx": 8114,
    "start": "03:47:03,277",
    "end": "03:47:04,637",
    "start_sec": 13623.277,
    "end_sec": 13624.637,
    "zh": "我倒是可以保证",
    "vi": "Tôi lại có thể đảm bảo."
  },
  {
    "idx": 8115,
    "start": "03:47:04,637",
    "end": "03:47:06,237",
    "start_sec": 13624.637,
    "end_sec": 13626.237,
    "zh": "那个周扬肯定还是周扬",
    "vi": "Chu Dương đó chắc chắn vẫn là Chu Dương."
  },
  {
    "idx": 8116,
    "start": "03:47:06,237",
    "end": "03:47:07,797",
    "start_sec": 13626.237,
    "end_sec": 13627.797,
    "zh": "他是不是本人",
    "vi": "Anh ta có phải là chính mình hay không."
  },
  {
    "idx": 8117,
    "start": "03:47:07,797",
    "end": "03:47:09,017",
    "start_sec": 13627.797,
    "end_sec": 13629.017,
    "zh": "其实无关大雅",
    "vi": "Thực ra không quan trọng lắm."
  },
  {
    "idx": 8118,
    "start": "03:47:09,017",
    "end": "03:47:12,417",
    "start_sec": 13629.017,
    "end_sec": 13632.417,
    "zh": "现在最重要的是古镜能否顺利运输到总部",
    "vi": "Bây giờ điều quan trọng nhất là gương cổ có thể vận chuyển thuận lợi đến trụ sở hay không."
  },
  {
    "idx": 8119,
    "start": "03:47:12,417",
    "end": "03:47:14,757",
    "start_sec": 13632.417,
    "end_sec": 13634.757,
    "zh": "就算这船上现在全是诡异",
    "vi": "Cho dù trên tàu bây giờ toàn là quái dị."
  },
  {
    "idx": 8120,
    "start": "03:47:14,757",
    "end": "03:47:16,617",
    "start_sec": 13634.757,
    "end_sec": 13636.617,
    "zh": "到了总部只要镜子还在",
    "vi": "Đến trụ sở chỉ cần gương vẫn còn."
  },
  {
    "idx": 8121,
    "start": "03:47:16,617",
    "end": "03:47:17,717",
    "start_sec": 13636.617,
    "end_sec": 13637.717,
    "zh": "周家人还在",
    "vi": "Người nhà họ Chu vẫn còn."
  },
  {
    "idx": 8122,
    "start": "03:47:17,717",
    "end": "03:47:19,217",
    "start_sec": 13637.717,
    "end_sec": 13639.217,
    "zh": "满船的诡异都得死",
    "vi": "Thì cả tàu quái dị đều phải chết."
  },
  {
    "idx": 8123,
    "start": "03:47:19,217",
    "end": "03:47:21,297",
    "start_sec": 13639.217,
    "end_sec": 13641.297,
    "zh": "怕就怕在路上出问题",
    "vi": "Chỉ sợ trên đường đi xảy ra vấn đề."
  },
  {
    "idx": 8124,
    "start": "03:47:21,297",
    "end": "03:47:22,597",
    "start_sec": 13641.297,
    "end_sec": 13642.597,
    "zh": "023说话间",
    "vi": "Trong lúc 023 nói chuyện."
  },
  {
    "idx": 8125,
    "start": "03:47:22,597",
    "end": "03:47:24,497",
    "start_sec": 13642.597,
    "end_sec": 13644.497,
    "zh": "目光渐渐就看向橙子皮",
    "vi": "Ánh mắt dần nhìn về phía Trần Tử Bì."
  },
  {
    "idx": 8126,
    "start": "03:47:24,497",
    "end": "03:47:24,817",
    "start_sec": 13644.497,
    "end_sec": 13644.817,
    "zh": "喂",
    "vi": "Này."
  },
  {
    "idx": 8127,
    "start": "03:47:24,817",
    "end": "03:47:25,517",
    "start_sec": 13644.817,
    "end_sec": 13645.517,
    "zh": "小子",
    "vi": "Nhóc con."
  },
  {
    "idx": 8128,
    "start": "03:47:25,517",
    "end": "03:47:26,597",
    "start_sec": 13645.517,
    "end_sec": 13646.597,
    "zh": "加入国家队吧",
    "vi": "Gia nhập đội quốc gia đi."
  },
  {
    "idx": 8129,
    "start": "03:47:26,597",
    "end": "03:47:27,597",
    "start_sec": 13646.597,
    "end_sec": 13647.597,
    "zh": "用你的能力",
    "vi": "Dùng năng lực của bạn."
  },
  {
    "idx": 8130,
    "start": "03:47:27,597",
    "end": "03:47:29,297",
    "start_sec": 13647.597,
    "end_sec": 13649.297,
    "zh": "保证这次的运输安全",
    "vi": "Đảm bảo an toàn cho chuyến vận chuyển lần này."
  },
  {
    "idx": 8131,
    "start": "03:47:29,297",
    "end": "03:47:31,137",
    "start_sec": 13649.297,
    "end_sec": 13651.137,
    "zh": "我可以帮你申请任何福利",
    "vi": "Tôi có thể giúp anh xin bất kỳ phúc lợi nào."
  },
  {
    "idx": 8132,
    "start": "03:47:31,137",
    "end": "03:47:32,937",
    "start_sec": 13651.137,
    "end_sec": 13652.937,
    "zh": "你的能力尤为特殊",
    "vi": "Năng lực của anh vô cùng đặc biệt."
  },
  {
    "idx": 8133,
    "start": "03:47:32,937",
    "end": "03:47:33,657",
    "start_sec": 13652.937,
    "end_sec": 13653.657,
    "zh": "领导",
    "vi": "Lãnh đạo."
  },
  {
    "idx": 8134,
    "start": "03:47:33,657",
    "end": "03:47:35,277",
    "start_sec": 13653.657,
    "end_sec": 13655.277,
    "zh": "你不会是想让我用能力",
    "vi": "Anh không phải là muốn tôi dùng năng lực."
  },
  {
    "idx": 8135,
    "start": "03:47:35,277",
    "end": "03:47:37,297",
    "start_sec": 13655.277,
    "end_sec": 13657.297,
    "zh": "一个一个治病别诡异和真人吧",
    "vi": "Để phân biệt từng người một là quỷ dị hay người thật đấy chứ."
  },
  {
    "idx": 8136,
    "start": "03:47:37,297",
    "end": "03:47:39,057",
    "start_sec": 13657.297,
    "end_sec": 13659.057,
    "zh": "那样我估计体内诡异复苏了",
    "vi": "Như vậy tôi e là quỷ dị trong cơ thể sẽ hồi sinh mất."
  },
  {
    "idx": 8137,
    "start": "03:47:39,057",
    "end": "03:47:39,977",
    "start_sec": 13659.057,
    "end_sec": 13659.977,
    "zh": "也识别不完",
    "vi": "Mà vẫn không phân biệt hết được."
  },
  {
    "idx": 8138,
    "start": "03:47:39,977",
    "end": "03:47:40,637",
    "start_sec": 13659.977,
    "end_sec": 13660.637,
    "zh": "不用",
    "vi": "Không cần."
  },
  {
    "idx": 8139,
    "start": "03:47:40,637",
    "end": "03:47:41,897",
    "start_sec": 13660.637,
    "end_sec": 13661.897,
    "zh": "你只要保证",
    "vi": "Anh chỉ cần bảo đảm."
  },
  {
    "idx": 8140,
    "start": "03:47:41,897",
    "end": "03:47:43,897",
    "start_sec": 13661.897,
    "end_sec": 13663.897,
    "zh": "周家两人始终是本人就行",
    "vi": "Hai người nhà họ Chu luôn là chính họ là được."
  },
  {
    "idx": 8141,
    "start": "03:47:43,897",
    "end": "03:47:45,417",
    "start_sec": 13663.897,
    "end_sec": 13665.417,
    "zh": "其余人哪怕是我",
    "vi": "Những người còn lại ngay cả tôi."
  },
  {
    "idx": 8142,
    "start": "03:47:45,417",
    "end": "03:47:46,737",
    "start_sec": 13665.417,
    "end_sec": 13666.737,
    "zh": "都可以不用管",
    "vi": "Đều có thể không cần quan tâm."
  },
  {
    "idx": 8143,
    "start": "03:47:46,737",
    "end": "03:47:48,457",
    "start_sec": 13666.737,
    "end_sec": 13668.457,
    "zh": "橙子皮看了他好一会",
    "vi": "Trần Tử Bì nhìn anh ta một lúc lâu."
  },
  {
    "idx": 8144,
    "start": "03:47:48,457",
    "end": "03:47:49,697",
    "start_sec": 13668.457,
    "end_sec": 13669.697,
    "zh": "没有说什么客气话",
    "vi": "Không nói lời khách sáo nào."
  },
  {
    "idx": 8145,
    "start": "03:47:49,697",
    "end": "03:47:50,517",
    "start_sec": 13669.697,
    "end_sec": 13670.517,
    "zh": "是他去的问题",
    "vi": "Mà hỏi thẳng vào vấn đề."
  },
  {
    "idx": 8146,
    "start": "03:47:50,517",
    "end": "03:47:52,377",
    "start_sec": 13670.517,
    "end_sec": 13672.377,
    "zh": "加入你们给什么好处",
    "vi": "Gia nhập các anh thì có lợi ích gì."
  },
  {
    "idx": 8147,
    "start": "03:47:52,377",
    "end": "03:47:53,617",
    "start_sec": 13672.377,
    "end_sec": 13673.617,
    "zh": "你想要什么",
    "vi": "Anh muốn cái gì."
  },
  {
    "idx": 8148,
    "start": "03:47:53,617",
    "end": "03:47:55,097",
    "start_sec": 13673.617,
    "end_sec": 13675.097,
    "zh": "我要是想要诡异呢",
    "vi": "Nếu tôi muốn quỷ dị thì sao."
  },
  {
    "idx": 8149,
    "start": "03:47:55,097",
    "end": "03:47:55,657",
    "start_sec": 13675.097,
    "end_sec": 13675.657,
    "zh": "可以",
    "vi": "Được chứ."
  },
  {
    "idx": 8150,
    "start": "03:47:55,657",
    "end": "03:47:57,437",
    "start_sec": 13675.657,
    "end_sec": 13677.437,
    "zh": "只要你的贡献足够大",
    "vi": "Chỉ cần cống hiến của anh đủ lớn."
  },
  {
    "idx": 8151,
    "start": "03:47:57,437",
    "end": "03:47:59,037",
    "start_sec": 13677.437,
    "end_sec": 13679.037,
    "zh": "那保护这次周家古镜",
    "vi": "Vậy việc bảo vệ gương cổ nhà họ Chu lần này."
  },
  {
    "idx": 8152,
    "start": "03:47:59,037",
    "end": "03:48:00,557",
    "start_sec": 13679.037,
    "end_sec": 13680.557,
    "zh": "要换到新生诡异吗",
    "vi": "Có đổi được một quỷ dị mới không."
  },
  {
    "idx": 8153,
    "start": "03:48:00,557",
    "end": "03:48:01,057",
    "start_sec": 13680.557,
    "end_sec": 13681.057,
    "zh": "可以",
    "vi": "Được chứ."
  },
  {
    "idx": 8154,
    "start": "03:48:01,057",
    "end": "03:48:01,857",
    "start_sec": 13681.057,
    "end_sec": 13681.857,
    "zh": "不仅如此",
    "vi": "Không chỉ có vậy."
  },
  {
    "idx": 8155,
    "start": "03:48:01,857",
    "end": "03:48:03,837",
    "start_sec": 13681.857,
    "end_sec": 13683.837,
    "zh": "加入我们预规者组之后",
    "vi": "Sau khi gia nhập nhóm ngự quỷ giả của chúng tôi."
  },
  {
    "idx": 8156,
    "start": "03:48:03,837",
    "end": "03:48:05,637",
    "start_sec": 13683.837,
    "end_sec": 13685.637,
    "zh": "你可以进入我们独有的网页",
    "vi": "Anh có thể truy cập vào trang web riêng của chúng tôi."
  },
  {
    "idx": 8157,
    "start": "03:48:05,637",
    "end": "03:48:07,257",
    "start_sec": 13685.637,
    "end_sec": 13687.257,
    "zh": "了解任何诡异信息",
    "vi": "Để tìm hiểu bất kỳ thông tin quỷ dị nào."
  },
  {
    "idx": 8158,
    "start": "03:48:07,257",
    "end": "03:48:08,517",
    "start_sec": 13687.257,
    "end_sec": 13688.517,
    "zh": "完成每一次任务",
    "vi": "Hoàn thành mỗi một nhiệm vụ."
  },
  {
    "idx": 8159,
    "start": "03:48:08,517",
    "end": "03:48:10,077",
    "start_sec": 13688.517,
    "end_sec": 13690.077,
    "zh": "你都可以积累功绪点",
    "vi": "Anh đều có thể tích lũy điểm công trạng."
  },
  {
    "idx": 8160,
    "start": "03:48:10,077",
    "end": "03:48:11,757",
    "start_sec": 13690.077,
    "end_sec": 13691.757,
    "zh": "在网页兑换各种奖励",
    "vi": "Để đổi các phần thưởng khác nhau trên trang web."
  },
  {
    "idx": 8161,
    "start": "03:48:11,757",
    "end": "03:48:13,937",
    "start_sec": 13691.757,
    "end_sec": 13693.937,
    "zh": "023不停多起各种福利待遇",
    "vi": "Tổ chức có rất nhiều phúc lợi và đãi ngộ khác nhau."
  },
  {
    "idx": 8162,
    "start": "03:48:13,937",
    "end": "03:48:15,197",
    "start_sec": 13693.937,
    "end_sec": 13695.197,
    "zh": "生发长子皮游艺",
    "vi": "Tên của người lớn tuổi là Pi Youyi."
  },
  {
    "idx": 8163,
    "start": "03:48:15,197",
    "end": "03:48:16,417",
    "start_sec": 13695.197,
    "end_sec": 13696.417,
    "zh": "待遇挺不错的",
    "vi": "Đãi ngộ khá tốt."
  },
  {
    "idx": 8164,
    "start": "03:48:16,417",
    "end": "03:48:18,057",
    "start_sec": 13696.417,
    "end_sec": 13698.057,
    "zh": "既然能有完成的体系认知",
    "vi": "Nếu đã có thể có nhận thức hệ thống hoàn chỉnh,"
  },
  {
    "idx": 8165,
    "start": "03:48:18,057",
    "end": "03:48:20,317",
    "start_sec": 13698.057,
    "end_sec": 13700.317,
    "zh": "总好比在外面一点一点的琢磨要好",
    "vi": "thà rằng ở đây còn hơn là tự mình mò mẫm bên ngoài."
  },
  {
    "idx": 8166,
    "start": "03:48:20,317",
    "end": "03:48:22,037",
    "start_sec": 13700.317,
    "end_sec": 13702.037,
    "zh": "可以 我答应了",
    "vi": "Được, tôi đồng ý."
  },
  {
    "idx": 8167,
    "start": "03:48:22,037",
    "end": "03:48:25,417",
    "start_sec": 13702.037,
    "end_sec": 13705.417,
    "zh": "欢迎加入御鬼者联盟",
    "vi": "Chào mừng bạn gia nhập Liên minh Ngự Quỷ Giả."
  },
  {
    "idx": 8168,
    "start": "03:48:25,417",
    "end": "03:48:28,497",
    "start_sec": 13705.417,
    "end_sec": 13708.497,
    "zh": "我待会会让组织给你发注册信息",
    "vi": "Lát nữa tôi sẽ cho tổ chức gửi thông tin đăng ký cho bạn."
  },
  {
    "idx": 8169,
    "start": "03:48:28,497",
    "end": "03:48:30,797",
    "start_sec": 13708.497,
    "end_sec": 13710.797,
    "zh": "信息应该会在几分钟内送达",
    "vi": "Thông tin sẽ được gửi đến trong vài phút nữa."
  },
  {
    "idx": 8170,
    "start": "03:48:30,797",
    "end": "03:48:32,637",
    "start_sec": 13710.797,
    "end_sec": 13712.637,
    "zh": "现在你和我来",
    "vi": "Giờ thì đi với tôi."
  },
  {
    "idx": 8171,
    "start": "03:48:32,637",
    "end": "03:48:34,277",
    "start_sec": 13712.637,
    "end_sec": 13714.277,
    "zh": "023领着长者皮",
    "vi": "023 dẫn người lớn tuổi Pi"
  },
  {
    "idx": 8172,
    "start": "03:48:34,277",
    "end": "03:48:37,917",
    "start_sec": 13714.277,
    "end_sec": 13717.917,
    "zh": "来到了三层最内侧的一间被夺死的白色铁门前",
    "vi": "đến trước một cánh cửa sắt màu trắng bị khóa chặt ở sâu bên trong tầng ba."
  },
  {
    "idx": 8173,
    "start": "03:48:37,917",
    "end": "03:48:41,077",
    "start_sec": 13717.917,
    "end_sec": 13721.077,
    "zh": "这里就是保护周和珊和古镜所在的船长是吧",
    "vi": "Đây chính là nơi thuyền trưởng bảo vệ Chu Hà San và cổ kính ở, đúng không?"
  },
  {
    "idx": 8174,
    "start": "03:48:41,077",
    "end": "03:48:43,137",
    "start_sec": 13721.077,
    "end_sec": 13723.137,
    "zh": "没错 你三天来一次吧",
    "vi": "Đúng vậy. Bạn đến ba ngày một lần phải không?"
  },
  {
    "idx": 8175,
    "start": "03:48:43,137",
    "end": "03:48:44,537",
    "start_sec": 13723.137,
    "end_sec": 13724.537,
    "zh": "今天就不用上去了",
    "vi": "Hôm nay thì không cần lên nữa."
  },
  {
    "idx": 8176,
    "start": "03:48:44,537",
    "end": "03:48:46,377",
    "start_sec": 13724.537,
    "end_sec": 13726.377,
    "zh": "我上午刚让他打开轨迹",
    "vi": "Tôi vừa bảo anh ta mở cửa vào buổi sáng."
  },
  {
    "idx": 8177,
    "start": "03:48:46,377",
    "end": "03:48:47,437",
    "start_sec": 13726.377,
    "end_sec": 13727.437,
    "zh": "他好像很累",
    "vi": "Anh ta có vẻ rất mệt."
  },
  {
    "idx": 8178,
    "start": "03:48:47,437",
    "end": "03:48:48,557",
    "start_sec": 13727.437,
    "end_sec": 13728.557,
    "zh": "让他歇会儿",
    "vi": "Để anh ta nghỉ ngơi một chút."
  },
  {
    "idx": 8179,
    "start": "03:48:48,557",
    "end": "03:48:50,644",
    "start_sec": 13728.557,
    "end_sec": 13730.644,
    "zh": "下次你带着周扬和我一起来,保证周家血脉的健在和古镜同样重要,没有他们,性子不过是摆设。",
    "vi": "Lần tới bạn hãy đưa Chu Dương và tôi đi cùng"
  },
  {
    "idx": 8179,
    "start": "03:48:50,644",
    "end": "03:48:53,300",
    "start_sec": 13730.644,
    "end_sec": 13733.3,
    "zh": "下次你带着周扬和我一起来,保证周家血脉的健在和古镜同样重要,没有他们,性子不过是摆设。",
    "vi": "Việc đảm bảo sự tồn tại của huyết mạch nhà họ Chu cũng quan"
  },
  {
    "idx": 8179,
    "start": "03:48:53,300",
    "end": "03:48:55,957",
    "start_sec": 13733.3,
    "end_sec": 13735.957,
    "zh": "下次你带着周扬和我一起来,保证周家血脉的健在和古镜同样重要,没有他们,性子不过是摆设。",
    "vi": "trọng như cổ kính, nếu không có họ, mọi thứ chỉ là hư vô"
  },
  {
    "idx": 8180,
    "start": "03:48:56,257",
    "end": "03:48:56,537",
    "start_sec": 13736.257,
    "end_sec": 13736.537,
    "zh": "明白。",
    "vi": "Rõ."
  },
  {
    "idx": 8181,
    "start": "03:48:57,197",
    "end": "03:48:59,980",
    "start_sec": 13737.197,
    "end_sec": 13739.98,
    "zh": "既然你已经加入了玉鬼者,我也就不跟你客气了,你现在最好是和周扬住一起,保证他的安全。",
    "vi": "Vì bạn đã gia nhập Ngự Quỷ Giả, tôi cũng không khách sáo nữa"
  },
  {
    "idx": 8181,
    "start": "03:48:59,980",
    "end": "03:49:03,757",
    "start_sec": 13739.98,
    "end_sec": 13743.757,
    "zh": "既然你已经加入了玉鬼者,我也就不跟你客气了,你现在最好是和周扬住一起,保证他的安全。",
    "vi": "Tốt nhất là bạn nên ở cùng Chu Dương bây giờ để đảm bảo an toàn cho cậu ấy"
  },
  {
    "idx": 8182,
    "start": "03:49:04,117",
    "end": "03:49:04,397",
    "start_sec": 13744.117,
    "end_sec": 13744.397,
    "zh": "行。",
    "vi": "Được."
  },
  {
    "idx": 8183,
    "start": "03:49:05,377",
    "end": "03:49:09,367",
    "start_sec": 13745.377,
    "end_sec": 13749.367,
    "zh": "彭子提朝着周扬的房间走进,这一看过来,又一次刷新了他的认知,一直以来被他当作是完美避难点的曙光号,竟然适合他。",
    "vi": "Bàng Tử Đề bước vào phòng Chu Dương, nhìn một lượt, nhận thức của anh ta lại bị làm mới"
  },
  {
    "idx": 8183,
    "start": "03:49:09,367",
    "end": "03:49:13,757",
    "start_sec": 13749.367,
    "end_sec": 13753.757,
    "zh": "彭子提朝着周扬的房间走进,这一看过来,又一次刷新了他的认知,一直以来被他当作是完美避难点的曙光号,竟然适合他。",
    "vi": "Con tàu Ánh Sáng, nơi anh ta luôn coi là điểm trú ẩn hoàn hảo, lại không phù hợp với anh ta"
  },
  {
    "idx": 8184,
    "start": "03:49:14,017",
    "end": "03:49:17,377",
    "start_sec": 13754.017,
    "end_sec": 13757.377,
    "zh": "现在,也就所谓的玉鬼者总部比较能让人信服了。",
    "vi": "Bây giờ, chỉ có trụ sở của Ngự Quỷ Giả mới có thể khiến người ta tin tưởng."
  },

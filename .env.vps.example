# Tên miền đã trỏ A record về IPv4 VPS, ví dụ api.example.com
DOMAIN=api.example.com

# Neon PostgreSQL. Không commit file .env.vps thật.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Sinh bằng: openssl rand -hex 32
AUTH_SECRET_KEY=REPLACE_WITH_A_RANDOM_64_CHARACTER_HEX_VALUE
AUTH_ADMIN_KEY=REPLACE_WITH_ANOTHER_RANDOM_SECRET

# Thông tin CapCut TTS của riêng bạn
CAPCUT_DEVICE_ID=REPLACE_ME
CAPCUT_IID=REPLACE_ME

REQUIRE_TTS_AUTH=1
DB_POOL_MAX=5
TTS_REQUESTS_PER_MINUTE=30
TTS_CHARS_PER_MINUTE=30000
TTS_DAILY_CHAR_QUOTA=100000
TTS_MAX_CHARS=5000
TTS_BATCH_MAX_CHARS=20000
TTS_FILE_TTL_SECONDS=3600
AUTH_LOGIN_IP_PER_15_MIN=30
AUTH_LOGIN_ACCOUNT_PER_15_MIN=10
AUTH_REGISTER_PER_HOUR=10
ENABLE_LEGACY_TOOLS=0

# Neon/Postgres cũ — account_api v2 tự tạo thêm bảng, không xoá users cũ.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
AUTH_SECRET_KEY=replace-with-at-least-32-random-bytes
AUTH_ADMIN_KEY=replace-with-a-separate-admin-key

# Auth/session
AUTH_ACCESS_MINUTES=30
AUTH_REFRESH_DAYS=30
AUTH_SIGNUP_CREDITS=0
DB_POOL_MAX=8

# Credit/export
EXPORT_CREDIT_COST=1
EXPORT_RESERVATION_MINUTES=30

# TTS production
CAPCUT_DEVICE_ID=7000000000000000000
REQUIRE_TTS_AUTH=1
TTS_REQUESTS_PER_MINUTE=30
TTS_MAX_CHARS=5000
TTS_BATCH_MAX_CHARS=20000
# MP3 trên server chỉ là file chuyển tiếp; app desktop tải ngay về máy user.
TTS_FILE_TTL_SECONDS=3600

# Runtime
API_HOST=0.0.0.0
API_PORT=8007

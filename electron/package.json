{
  "name": "threads-video-maker-desktop",
  "version": "1.1.1",
  "author": "NemCua",
  "engines": { "node": ">=22.12.0" },
  "private": true,
  "description": "Threads Short Video Maker for macOS and Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "39.8.10",
    "electron-builder": "26.15.2",
    "ffmpeg-static": "5.2.0"
  },
  "build": {
    "appId": "com.threadsvideomaker.desktop",
    "productName": "Threads Video Maker",
    "asar": true,
    "files": [
      "main.js",
      "exporter.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../threads",
        "to": "threads",
        "filter": [
          "**/*",
          "!exports/**/*",
          "!media/**/*",
          "!tts_audio/**/*",
          "!compress_output/**/*",
          "!compress_uploads/**/*",
          "!threads-project-*.json"
        ]
      },
      {
        "from": "node_modules/ffmpeg-static",
        "to": "ffmpeg",
        "filter": ["ffmpeg", "ffmpeg.exe"]
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": ["dmg", "zip"],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    }
  }
}
